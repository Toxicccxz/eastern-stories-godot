		{
			"id": "sanyen.npc.monk",
			"legacy_source": "d/sanyen/npc/monk.c",
			"name": "独眼头陀",
			"aliases": ["one-eyed monk", "monk"],
			"class": "bonze",
			"gender": "男性",
			"age": 46,
			"long": "瞧这个头陀的模样与服色，似乎不是山烟寺的僧人，但是他大喇喇地站在\n这里，一副不可一世的样子。\n",
			"attributes": { "str": 26, "cor": 24, "cps": 12, "int": 20 },
			"resources": { "max_force": 1700, "force": 1700 },
			"combat_exp": 60000,
			"force_factor": 3,
			"attitude": "heroism",
			"skills": { "force": 90, "unarmed": 80, "dodge": 80, "blade": 80, "lotusforce": 90, "move": 60 },
			"skill_map": { "force": "lotusforce" },
			"carry": [
				{ "item": "es2:d/sanyen/obj/blade", "source": "d/sanyen/npc/obj/blade.c", "equip": "wield" },
				{ "item": "es2:d/sanyen/obj/monk_cloth", "source": "d/sanyen/npc/obj/monk_cloth.c", "equip": "wear" },
				{ "item": "es2:d/sanyen/obj/eye_patch", "source": "d/sanyen/npc/obj/eye_patch.c", "equip": "wear" },
				{ "item": "es2:d/sanyen/obj/shoe", "source": "d/sanyen/npc/obj/shoe.c", "equip": "wear" }
			],
			"apply": { "attack": 60, "dodge": 70 },
			"chat_chance_combat": 30,
			"chat_msg_combat": [
				{ "action": "random_move" },
				{ "action": "emote", "verb": "hehe" }
			],
			"follows_every_way": true,
			"kept_when": {
				"all": [
					{ "quest": "faction.sanyen#started" },
					{ "not": { "quest": "faction.sanyen#lapsed" } },
					{ "not": { "quest": "faction.sanyen#done" } }
				]
			},
			"moods": {
				"going": {
					"flags": ["follows_player"],
					"lasting": true,
					"chat_chance": 8,
					"chat_msg": ["独眼头陀跟在你身后，大步流星，那只独眼盯着前头的路。\n"]
				},
				"back": { "lasting": true, "chat_chance": 4, "chat_msg": ["独眼头陀抱着刀站着，那只独眼半闭着，像是睡着了。\n"] }
			},
			"inquiry": {
				"病人": {
					"listed_marks": ["喂了樵夫药"],
					"rules": [
						{ "asker_marks": ["山烟寺的线断了"], "emote": "大喇喇地站着，不理你。" },
						{ "asker_marks": ["守了寺规"], "emote": "转过身去，不理你。" },
						{ "asker_marks": ["头陀进了流云轩"], "say": "那樵夫的寒，赶干净了。" },
						{ "asker_marks": ["头陀跟你去了流云轩"], "say": "走啊。流云轩在哪，你比我熟。" },
						{ "asker_marks": ["喂了樵夫药"], "mark_asker": "头陀说了病人", "lines": [{ "emote": "那只独眼转过来，盯着你看了很久。" }, { "say": "流云轩那个樵夫。寒气退不下去，是不是？" }, { "say": "那是鬼卒的阴寒，钻进骨头了。玄智的药是凉性的底子，赶不出来。" }, { "say": "我能。" }, { "say": "我的内功是火性的。可他们的寺规不许外人进流云轩——十年了，我连金门都没进过。" }, { "say": "你领我进去（问我「领路」），或者照他们的寺规来。" }] },
						{ "say": "……" }
					]
				},
				"领路": {
					"confirm": "领独眼头陀进流云轩，让他给老葛治伤。\n寺规不许外人进流云轩：老葛当场好，玄智记你不守寺规（山烟寺的弟子，这一回没有晋阶）；头陀从此肯跟你说话。\n这是山烟寺这条线上的一个选择，选了不能改，照寺规那条路就没了。要领他去吗？",
					"confirm_marks": ["头陀说了病人"],
					"confirm_lacks": ["守了寺规", "头陀进了流云轩", "头陀跟你去了流云轩", "山烟寺的线断了"],
					"listed_marks": ["头陀说了病人"],
					"rules": [
						{ "asker_marks": ["山烟寺的线断了"], "emote": "大喇喇地站着，不理你。" },
						{ "asker_marks": ["守了寺规"], "emote": "转过身去，不理你。" },
						{ "asker_marks": ["头陀进了流云轩"], "say": "治完了。" },
						{ "asker_marks": ["头陀跟你去了流云轩"], "mood": "going", "say": "走。" },
						{ "asker_marks": ["头陀说了病人"], "mood": "going", "mark_asker": "头陀跟你去了流云轩", "lines": [{ "emote": "把刀往背后一插，跟在你身后。" }, { "say": "走。" }] },
						{ "say": "……" }
					]
				},
				"番坊": {
					"listed_marks": ["头陀进了流云轩"],
					"rules": [
						{ "lines": [{ "say": "我是从番坊来的。日陀罗寺。" }, { "emote": "摸了摸那只瞎眼上的眼罩。" }, { "say": "我练的经，玄智的寺里不认。三十年前不认，今天也不认。……别的，去问我师父。" }] }
					]
				}
			}
		},
