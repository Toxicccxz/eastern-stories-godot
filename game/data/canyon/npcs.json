						{ "asker_marks": ["赫造基认了盖印"], "asker_lacks": ["庾子建下狱", "私了了庾子建", "皇叔的通缉解了"], "mark_asker": "跟李信揭发", "lines": [{ "emote": "把那本账合上，用一块油布包了。" }, { "say": "好。账抄两份：一份我留着，一份今夜就走，八百里，送进宫里。" }, { "say": "将军的印丢了三天，这个罪他担。召回令下来，天驼关我守；军师一并押上京。" }, { "say": "往后过关的，不收钱——先帝调我来是守关，不是收钱的。" }, { "say": "你要在朝上揭发庾子建的，这本账算一样。" }] },
