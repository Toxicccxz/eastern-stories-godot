	"landmarks": [
		{ "id": "village.road3.landmark.tablet", "zone": "village.road3", "name": "小牌子", "policy": "look", "long": "你勉强分辨出那上面模糊的字迹：傅家坡\n", "legacy_source": "d/village/road3.c" },
		{ "id": "village.lakeside.landmark.boat", "zone": "village.lakeside", "name": "木船", "policy": "look", "long": "关内能经常见到的渔船，你可以划着(paddle)它到湖中心。\n", "legacy_source": "d/village/lakeside.c" },
		{ "id": "village.road6.landmark.grass", "zone": "village.road6", "name": "茅草", "action": "拨开", "policy": "hidden_passage", "portals": ["village.road6.west"], "pushes": 1, "every_push": 1, "open_seconds": 5, "long": "高高的茅草，可以拨开(pushaside)。\n", "messages": {"open": "你拨开茅草，发现了一条向西的路。", "close": "茅草晃了晃，又遮住了向西的路。"}, "legacy_source": "d/village/road6.c" },
		{ "id": "village.lakebottom1.landmark.ice", "zone": "village.lakebottom1", "name": "玄冰", "action": "放弃", "portals": ["village.lakebottom1.give_up"], "long": "身后的入口已经冻上了，冰层坚硬无比，再也砸不开。往上走只能穿过冰龙盘踞的冰厅；过不去的话，就只能在这里等下去了。\n", "messages": {"use": "你在冰洞里苦等良久，冻得昏昏沉沉地睡了过去……醒来时，你已经躺在雪亭镇的饮风客栈里。"}, "legacy_source": "d/village/lakebottom1.c" }
	],
	"services": [
		{ "id": "village.lakeside.paddle", "kind": "act", "zone": "village.lakeside", "name": "木船", "reach": 96, "legacy_source": "d/village/lakeside.c", "act": {"verb": "划向湖心", "acts": [{"steps": [{"line": "你跳上渔船，奋力向湖心划去。\n"}, {"line": "你终于划到湖中心了。\n"}, {"move": "village.lake", "point": "village.lake.boat_arrival"}]}]} },
		{ "id": "village.lake.paddle", "kind": "act", "zone": "village.lake", "name": "小船", "reach": 96, "legacy_source": "d/village/lake.c", "act": {"verb": "划回岸边", "acts": [{"steps": [{"line": "你划动双桨，小船慢慢向岸边漂去。\n"}, {"line": "你终于划到湖岸边。\n"}, {"move": "village.lakeside", "point": "village.lakeside.boat_return"}]}]} },
		{ "id": "village.lake.dive", "kind": "act", "zone": "village.lake", "name": "湖水", "reach": 96, "legacy_source": "d/village/lake.c", "act": {"verb": "潜入湖中", "acts": [{"ask": "这一潜下去就回不到船上了：湖底的出路只有一条，要穿过白鳞冰龙盘踞的冰厅；过不去的话，只能在冰洞里放弃（醒来时在雪亭镇的客栈）。\n确定要潜入湖中吗？", "choice": "确定潜入", "steps": [{"line": "你深深吸了一口气，一个猛子潜入水中！\n"}, {"line": "你越潜越深，突然眼前一亮，一处湖底发出光亮。你用拳一砸，那湖底竟然碎了，原来是一层冰！你随着水流被冲进一个岩洞中。\n"}, {"move": "village.lakebottom1", "point": "village.lakebottom1.dive_arrival"}]}]} },
		{ "id": "village.melonfarm.pick", "kind": "act", "zone": "village.melonfarm", "name": "瓜地", "reach": 96, "legacy_source": "d/village/melonfarm.c", "act": {"verb": "摘西瓜", "stronger": {"npc": "village.npc.meloner", "zone": "village.melonguard", "ask": "瓜棚里的瓜农比你强得多。摘瓜要是被他发现，他会冲过来跟你拼命；不还瓜钱，就别想离开瓜地。\n确定要摘西瓜吗？", "choice": "确定摘瓜"}, "acts": [{"kar_above": [30, 10], "present_in": {"npc": "village.npc.meloner", "zone": "village.melonguard"}, "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "糟糕，瓜农发现了你偷瓜，向这边冲过来！\n"}, {"comes": "village.npc.meloner", "from": "village.melonguard"}, {"npc_flag": "melon/catch_thief"}, {"set_temp": "melon/catch_thief"}, {"kill": true}]}, {"kar_above": [30], "present_in": {"npc": "village.npc.meloner", "zone": "village.melonguard"}, "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "瓜农似乎正在打瞌睡，没有发现你的小动作。\n"}]}, {"kar_above": [30], "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "你真幸运，瓜农没有在瓜棚看瓜。\n"}]}, {"steps": [{"line": "你找来找去，终于还是没找到熟透的西瓜。\n"}]}]} }
	]
}
