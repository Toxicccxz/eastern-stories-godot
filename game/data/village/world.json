	"landmarks": [
		{ "id": "village.road3.landmark.tablet", "zone": "village.road3", "name": "小牌子", "policy": "look", "long": "你勉强分辨出那上面模糊的字迹：傅家坡\n", "legacy_source": "d/village/road3.c" },
		{ "id": "village.lakeside.landmark.boat", "zone": "village.lakeside", "name": "木船", "policy": "look", "long": "关内能经常见到的渔船，你可以划着(paddle)它到湖中心。\n", "legacy_source": "d/village/lakeside.c" },
		{ "id": "village.road6.landmark.grass", "zone": "village.road6", "name": "茅草", "action": "拨开", "policy": "hidden_passage", "portals": ["village.road6.west"], "pushes": 1, "every_push": 1, "open_seconds": 5, "long": "高高的茅草，可以拨开(pushaside)。\n", "messages": {"open": "你拨开茅草，发现了一条向西的路。", "close": "茅草晃了晃，又遮住了向西的路。"}, "legacy_source": "d/village/road6.c" },
		{ "id": "village.lakebottom1.landmark.ice", "zone": "village.lakebottom1", "name": "玄冰", "action": "放弃", "portals": ["village.lakebottom1.give_up"], "long": "身后的入口已经冻上了，冰层坚硬无比，再也砸不开。往上走只能穿过冰龙盘踞的冰厅；过不去的话，就只能在这里等下去了。\n", "messages": {"use": "你在冰洞里苦等良久，冻得昏昏沉沉地睡了过去……醒来时，你已经躺在雪亭镇的饮风客栈里。"}, "legacy_source": "d/village/lakebottom1.c" },
		{ "id": "village.lakebottom1.landmark.carving", "zone": "village.lakebottom1", "name": "冰壁刻字", "policy": "look", "long": "入口对面的冰壁上刻着一行字，刻得很深，三百年的冰长过去也没有把它长平。字是中原字，笔画生硬，像是用剑尖一下一下凿出来的：「吾见钉之。」\n", "looks": [{"marks": ["读过铜牒"], "long": "入口对面的冰壁上刻着一行字，刻得很深，三百年的冰长过去也没有把它长平。字是中原字，笔画生硬，像是用剑尖一下一下凿出来的：「吾见钉之。」\n你认得这笔迹——和铜牒上的一样，几个笔画反了。刻字的人就是那个老兵，他站在这里看见了那把剑钉下去。「钉」字刻得最深。\n"}], "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」)" },
		{ "id": "village.seal_altar.landmark.altar", "zone": "village.seal_altar", "name": "封坛", "policy": "look", "long": "一座黑石砌的圆坛，齐腰高，坛面磨得发亮。坛心嵌着一块透明的冰，冰里一颗头——闭着眼，眉骨很高，嘴角像在笑。一把剑从头顶直钉下去，钉进坛心的石头里，只有剑柄露在冰外，柄上结着霜。坛边的冰柱里有人。\n", "looks": [{"marks": ["拔了穿灵"], "long": "坛心的冰裂成了几块。头还在冰里，眼睛睁着了，看着顶上的水潭。钉着它的剑没有了，坛心的石头上只剩一个剑孔，孔里往外冒着一丝黑气。坛边的冰柱空了。\n"}], "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」)" },
		{ "id": "village.seal_altar.landmark.walls", "zone": "village.seal_altar", "name": "冰壁", "policy": "look", "long": "四壁是整块的冰，冰里有金线一样的纹路，一直盘到顶上。顶是一整块半透明的冰，上面就是冰龙厅的水潭——有影子游过去，很长。壁上刻着一圈金乌的字，和岩洞冰壁上那一行是一个人的笔迹，只是刻得更密，你一个字也不认得。\n", "looks": [{"marks": ["璃虹说了封法"], "long": "四壁是整块的冰，冰里有金线一样的纹路，一直盘到顶上。顶是一整块半透明的冰，上面就是冰龙厅的水潭——有影子游过去，很长。壁上刻着一圈金乌的字，和岩洞冰壁上那一行是一个人的笔迹，只是刻得更密。璃虹说，那是她哥哥钉剑那天刻的，刻的是她的名字，刻了三百遍。\n"}], "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」)" }
	],
	"hazards": [
