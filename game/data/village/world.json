		{ "id": "village.lakeside.paddle", "kind": "act", "zone": "village.lakeside", "name": "木船", "reach": 96, "legacy_source": "d/village/lakeside.c", "act": {"verb": "划向湖心", "acts": [{"steps": [{"line": "你跳上渔船，奋力向湖心划去。\n"}, {"line": "你终于划到湖中心了。\n"}, {"move": "village.lake", "point": "village.lake.boat_arrival"}]}]} },
		{ "id": "village.lakeside.wait", "kind": "act", "zone": "village.lakeside", "name": "湖畔", "reach": 120, "legacy_source": "native: 第八章 B (剧情总纲 §1 底线一「渔夫口中的水怪是鬼卒」, §3 第八章 拔剑的当夜; 计划 build/plans/第八章_计划.md B 包, owner 2026-11-06「按推荐，开工 A」Q1 烧一半看得见, Q3 卢卡不下湖; DECISIONS「第八章 B」「舞台道具」) (等到天黑 as 关北 C's 篝火, DECISIONS「等到天黑」: the night the 鬼卒 come, and the dawn after)", "act": {"verb": "等到天黑", "acts": [{"not_mark": "拔了穿灵", "steps": [{"line": "没什么要等的。湖上静得很。\n"}]}, {"marks": ["湖畔的鬼卒退了", "村口的鬼卒退了", "稻田的鬼卒退了"], "phase": ["night", "midnight"], "ask": "在岸上坐到天亮。等的工夫里，世上的事照样走。", "choice": "等到天亮", "steps": [{"line": "你在岸边坐下。湖面上一点声音都没有了。\n"}, {"until_phase": ["dawn"]}, {"line": "天亮了。农妇家的草顶烧去了半边，岸边的两条船只剩黑壳，路口的柳树成了两根黑桩。渔夫倒在泥里，网还攥在手里。\n", "color": "HIW"}, {"line": "钉没了。它每一夜都在长。\n", "color": "HIR"}]}, {"marks": ["湖畔的鬼卒退了", "村口的鬼卒退了", "稻田的鬼卒退了"], "steps": [{"line": "鬼卒退了。村子烧了一半。\n"}]}, {"phase": ["night", "midnight"], "steps": [{"line": "天已经黑了。湖里有东西在动。\n", "color": "HIR"}]}, {"ask": "在岸上坐下等到天黑。等的工夫里，世上的事照样走：别处的人该走的走、该好的好。", "choice": "等到天黑", "steps": [{"line": "你在岸边坐下。船都拴着，渔夫不在。湖面平得像一块铁。\n"}, {"until_phase": ["night"]}, {"line": "天黑了。湖面上先是一声水响，然后是第二声、第三声——鬼卒从湖里爬上来了！\n", "color": "HIR"}, {"line": "湖畔、村口、稻田边，三处都有。守住村子。\n", "color": "HIW"}]}]} },
		{ "id": "village.lake.paddle", "kind": "act", "zone": "village.lake", "name": "小船", "reach": 96, "legacy_source": "d/village/lake.c", "act": {"verb": "划回岸边", "acts": [{"steps": [{"line": "你划动双桨，小船慢慢向岸边漂去。\n"}, {"line": "你终于划到湖岸边。\n"}, {"move": "village.lakeside", "point": "village.lakeside.boat_return"}]}]} },
		{ "id": "village.lake.dive", "kind": "act", "zone": "village.lake", "name": "湖水", "reach": 96, "legacy_source": "d/village/lake.c", "act": {"verb": "潜入湖中", "acts": [{"ask": "这一潜下去就回不到船上了：湖底的出路只有一条，要穿过白鳞冰龙盘踞的冰厅；过不去的话，只能在冰洞里放弃（醒来时在雪亭镇的客栈）。\n确定要潜入湖中吗？", "choice": "确定潜入", "steps": [{"line": "你深深吸了一口气，一个猛子潜入水中！\n"}, {"line": "你越潜越深，突然眼前一亮，一处湖底发出光亮。你用拳一砸，那湖底竟然碎了，原来是一层冰！你随着水流被冲进一个岩洞中。\n"}, {"mark": "下了湖底"}, {"move": "village.lakebottom1", "point": "village.lakebottom1.dive_arrival"}]}]} },
		{ "id": "village.melonfarm.pick", "kind": "act", "zone": "village.melonfarm", "name": "瓜地", "reach": 96, "legacy_source": "d/village/melonfarm.c", "act": {"verb": "摘西瓜", "stronger": {"npc": "village.npc.meloner", "zone": "village.melonguard", "ask": "瓜棚里的瓜农比你强得多。摘瓜要是被他发现，他会冲过来跟你拼命；不还瓜钱，就别想离开瓜地。\n确定要摘西瓜吗？", "choice": "确定摘瓜"}, "acts": [{"kar_above": [30, 10], "present_in": {"npc": "village.npc.meloner", "zone": "village.melonguard"}, "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "糟糕，瓜农发现了你偷瓜，向这边冲过来！\n"}, {"comes": "village.npc.meloner", "from": "village.melonguard"}, {"npc_flag": "melon/catch_thief"}, {"set_temp": "melon/catch_thief"}, {"kill": true}]}, {"kar_above": [30], "present_in": {"npc": "village.npc.meloner", "zone": "village.melonguard"}, "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "瓜农似乎正在打瞌睡，没有发现你的小动作。\n"}]}, {"kar_above": [30], "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "你真幸运，瓜农没有在瓜棚看瓜。\n"}]}, {"steps": [{"line": "你找来找去，终于还是没找到熟透的西瓜。\n"}]}]} },
		{ "id": "village.lakebottom2.pool", "kind": "act", "zone": "village.lakebottom2", "name": "水潭", "reach": 96, "legacy_source": "d/village/lakebottom2.c (洞里的水潭; native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」): the 封坛 lies under it — 总纲 §6: 冰阶尽头加一张冰下封坛; the lake's white light is 璃虹's)", "act": {"verb": "潜下去", "acts": [{"ask": "水潭底下透着白光——不是鱼。下去了，封坛前的事就得自己担。\n确定要潜下去吗？", "choice": "潜下去", "steps": [{"line": "你吸足一口气，扎进水潭。水冷得像刀，白光在底下越来越亮。\n"}, {"line": "潭底是一个洞口，你顺着光钻了过去，脚踩到了黑石的台阶。\n"}, {"mark": "看过封坛"}, {"move": "village.seal_altar", "point": "village.seal_altar.pool_arrival"}]}]} },
		{ "id": "village.seal_altar.pool", "kind": "act", "zone": "village.seal_altar", "name": "潭口", "reach": 96, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」)", "act": {"verb": "游上去", "acts": [{"present": "native.npc.lihong_weak", "steps": [{"line": "璃虹扶着坛沿站起来：「带我上去。」你扶着她钻进潭口，冰水灌进领子。头顶亮了——冰龙厅。她趴在潭边喘了半天，说：「上岸。到人家里去。」\n"}, {"leave": "native.npc.lihong_weak"}, {"move": "village.lakebottom2", "point": "village.lakebottom2.pool_return"}]}, {"steps": [{"line": "你从潭口钻上去，冰水灌进领子。头顶亮了——冰龙厅。\n"}, {"move": "village.lakebottom2", "point": "village.lakebottom2.pool_return"}]}]} },
		{ "id": "village.seal_altar.recite", "kind": "act", "zone": "village.seal_altar", "name": "冰柱", "reach": 120, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」) (璃虹's three questions on the 铜牒, the 火前问话 mechanism of 番坊 B reused: the true answers are the tablet's own words, the false ones 商玦's telling)", "act": {"verb": "把铜牒念给她听", "acts": [{"mark": "璃虹说了封法", "steps": [{"by": "native.npc.lihong"}, {"say": "我说过了。要再听，问我「封法」。"}]}, {"present": "native.npc.lihong", "steps": [{"by": "native.npc.lihong"}, {"say": "念。"}, {"questions": [{"text": "头在哪里？", "answers": [{"text": "头在湖底冰下，以穿灵为钉。", "mark": "读过铜牒"}, {"text": "头在逆灵宫的坛上，以黑焰养着。", "mark": "信了商玦"}]}, {"text": "钉拔了，怎样？", "answers": [{"text": "钉拔，鬼成形。", "mark": "读过铜牒"}, {"text": "钉拔，鬼就散了。", "mark": "信了商玦"}]}, {"text": "要再封，须有什么？", "answers": [{"text": "要再封，须有人留下。", "mark": "读过铜牒"}, {"text": "要再封，须有人祭。", "mark": "信了商玦"}]}], "true": [{"line": "冰里的光稳住了。\n", "color": "HIW"}, {"say": "一字不差。那片铜上刻的是实话。我再给你三句，铜上没有的。"}, {"say": "钉拔，它成形，先回它自己的家——这附近的村子，它记得路。"}, {"say": "要灭它，三器齐：穿灵钉它的头，宝衣挡它的焰，原令——皇城里那道寻剑令的原本——念它的名。少一件，灭不掉，只能再封。"}, {"say": "要再封，须有人留下。三百年前我哥哥钉了它，没有人肯留，我留下了。这一回，还得有人。"}, {"mark": "璃虹说了封法"}, {"say": "剑就在你眼前。拔不拔，你自己定。我守了三百年，不替你定。"}], "false": [{"line": "冰里的光暗了一暗。\n"}, {"say": "不对。那不是铜上的话。再念。"}]}]}, {"steps": [{"line": "冰柱里没有人应你。\n"}]}]} },
		{ "id": "village.seal_altar.pull", "kind": "act", "zone": "village.seal_altar", "name": "穿灵", "reach": 120, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」) (the chapter's choice, pull: 总纲 §3 第八章)", "act": {"verb": "拔出来", "acts": [{"mark": "拔了穿灵", "steps": [{"line": "剑已经在你手里了。\n"}]}, {"mark": "查清了封物", "steps": [{"line": "你已经记下了封物，没有动它。这把剑，等三器齐了再拔。\n"}]}, {"not_mark": "璃虹说了封法", "steps": [{"line": "你握住剑柄。冰柱里传出一声：「先把铜上的话念给我听。」\n"}]}, {"ask": "剑一拔，钉就没了。鬼会成形，先回它自己的家——这附近的村子。璃虹会从冰里出来，可她守了三百年，出来就剩半条命。拔了就回不去。\n要拔吗？", "choice": "拔出来", "steps": [{"line": "你握住剑柄。霜化在手心里，一股凉意顺着胳膊直透到肩。\n"}, {"line": "你往上一拔——冰「喀」地一声裂开，剑出来了。\n", "color": "HIW"}, {"give": "native:village/soul_impaler"}, {"mark": "拔了穿灵"}, {"line": "冰里那颗头睁开了眼。它看着你，嘴角的笑更深了些。坛心的剑孔里冒出一丝黑气，顶上的水潭里，龙的影子乱了一乱。\n", "color": "HIR"}, {"by": "native.npc.shang_jue_lake"}, {"emote": "大笑起来，笑声在冰室里撞来撞去。"}, {"say": "三百年。它记得路。"}, {"line": "商玦化作一股黑烟，从潭口散了出去。\n"}, {"leave": true}, {"by": "native.npc.lihong"}, {"line": "冰柱从头到脚裂开，光灭了。璃虹从冰里跌了出来，跪在坛边。\n", "color": "HIW"}, {"leave": true}, {"summon": "native.seal_altar.lihong_weak"}, {"by": "native.npc.lihong_weak"}, {"say": "……三百年。我站了三百年，站不住了。"}, {"say": "剑在你手里，钉没了。它每一夜都在长。带我上岸——我还有话，在冰里说不出来的话。"}]}]} },
		{ "id": "village.seal_altar.keep", "kind": "act", "zone": "village.seal_altar", "name": "封坛", "reach": 120, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」) (the chapter's choice, keep: 总纲 §3 第八章)", "act": {"verb": "看清了", "acts": [{"mark": "查清了封物", "steps": [{"line": "你已经记下了。\n"}]}, {"mark": "拔了穿灵", "steps": [{"line": "来不及了。剑在你手里。\n"}]}, {"not_mark": "璃虹说了封法", "steps": [{"line": "先把铜上的话念给冰柱里的人听。\n"}]}, {"steps": [{"line": "你围着封坛走了一圈，把每一样都看清了：坛心的冰、冰里的头、钉着它的剑、剑柄上的霜、坛边柱里的人。你没有碰那把剑。\n"}, {"mark": "查清了封物"}, {"by": "native.npc.lihong"}, {"say": "好。"}, {"line": "冰柱里的光亮了一下，一片羽毛从光里落下来，落在坛沿上——浅金的，不化，不湿。\n", "color": "HIW"}, {"give": "native:village/lihong_feather"}, {"say": "我的羽。再封的时候，把它放回坛上，我认得它。去京师，去岚城，把三器凑齐了再回来。"}, {"by": "native.npc.shang_jue_lake"}, {"emote": "冷笑了一声。"}, {"say": "不拔？那就等它自己出来。"}, {"line": "商玦化作一股黑烟，从潭口散了出去。\n"}, {"leave": true}]}]} }
	]
}
