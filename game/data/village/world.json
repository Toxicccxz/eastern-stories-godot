		{ "id": "village.lake.paddle", "kind": "act", "zone": "village.lake", "name": "小船", "reach": 96, "legacy_source": "d/village/lake.c", "act": {"verb": "划回岸边", "acts": [{"steps": [{"line": "你划动双桨，小船慢慢向岸边漂去。\n"}, {"line": "你终于划到湖岸边。\n"}, {"move": "village.lakeside", "point": "village.lakeside.boat_return"}]}]} },
		{ "id": "village.lake.dive", "kind": "act", "zone": "village.lake", "name": "湖水", "reach": 96, "legacy_source": "d/village/lake.c; native: 终章 A (剧情总纲 §3 终章; 计划 build/plans/终章_计划.md A 包与 §0「下湖前」; owner 2026-11-08「按推荐的做」; DECISIONS「终章 A」「决战前存档」「步骤条件」) (the dive the night of the battle)", "act": {"verb": "潜入湖中", "acts": [{"mark": "下了决战", "ask": "潜下去，就是去找它了。岸上的人替你守着。\n确定潜入湖中？", "choice": "潜下去", "steps": [{"line": "你深深吸了一口气，一个猛子扎进黑冰的裂缝里！\n"}, {"line": "冰下的水黑得像墨。湖底那一点光还亮着，你朝着它潜下去，随着水流被冲进一个岩洞中。\n"}, {"mark": "下了湖底"}, {"mark": "终章下了湖底"}, {"move": "village.lakebottom1", "point": "village.lakebottom1.dive_arrival"}]}, {"ask": "这一潜下去就回不到船上了：湖底的出路只有一条，要穿过白鳞冰龙盘踞的冰厅；过不去的话，只能在冰洞里放弃（醒来时在雪亭镇的客栈）。\n确定要潜入湖中吗？", "choice": "确定潜入", "steps": [{"line": "你深深吸了一口气，一个猛子潜入水中！\n"}, {"line": "你越潜越深，突然眼前一亮，一处湖底发出光亮。你用拳一砸，那湖底竟然碎了，原来是一层冰！你随着水流被冲进一个岩洞中。\n"}, {"mark": "下了湖底"}, {"move": "village.lakebottom1", "point": "village.lakebottom1.dive_arrival"}]}]} },
		{ "id": "village.melonfarm.pick", "kind": "act", "zone": "village.melonfarm", "name": "瓜地", "reach": 96, "legacy_source": "d/village/melonfarm.c", "act": {"verb": "摘西瓜", "stronger": {"npc": "village.npc.meloner", "zone": "village.melonguard", "ask": "瓜棚里的瓜农比你强得多。摘瓜要是被他发现，他会冲过来跟你拼命；不还瓜钱，就别想离开瓜地。\n确定要摘西瓜吗？", "choice": "确定摘瓜"}, "acts": [{"kar_above": [30, 10], "present_in": {"npc": "village.npc.meloner", "zone": "village.melonguard"}, "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "糟糕，瓜农发现了你偷瓜，向这边冲过来！\n"}, {"comes": "village.npc.meloner", "from": "village.melonguard"}, {"npc_flag": "melon/catch_thief"}, {"set_temp": "melon/catch_thief"}, {"kill": true}]}, {"kar_above": [30], "present_in": {"npc": "village.npc.meloner", "zone": "village.melonguard"}, "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "瓜农似乎正在打瞌睡，没有发现你的小动作。\n"}]}, {"kar_above": [30], "steps": [{"line": "你找来找去，终于找到了一个熟透了的大西瓜抱在怀中。\n"}, {"give": "es2:d/village/obj/melon"}, {"line": "你真幸运，瓜农没有在瓜棚看瓜。\n"}]}, {"steps": [{"line": "你找来找去，终于还是没找到熟透的西瓜。\n"}]}]} },
		{ "id": "village.lakebottom2.pool", "kind": "act", "zone": "village.lakebottom2", "name": "水潭", "reach": 96, "legacy_source": "d/village/lakebottom2.c (洞里的水潭; native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」): the 封坛 lies under it — 总纲 §6: 冰阶尽头加一张冰下封坛; the lake's white light is 璃虹's); native: 终章 B (剧情总纲 §3 终章; 计划 build/plans/终章_计划.md B 包与 §0「封坛」; owner 2026-11-08「按推荐的做」; DECISIONS「终章 B」) (the night of the battle: 商玦 first, then down)", "act": {"verb": "潜下去", "acts": [{"when": {"all": [{"mark": "终章下了湖底"}, {"not": {"mark": "商玦倒了"}}]}, "steps": [{"line": "商玦站在水潭边，挡着你的路。\n"}]}, {"when": {"all": [{"mark": "终章下了湖底"}, {"mark": "商玦倒了"}]}, "ask": "潜下去，就是去见它了。\n确定潜下去吗？", "choice": "潜下去", "steps": [{"line": "你吸足一口气，扎进水潭。潭底的光暗得只剩一线，黑气顺着水往上冒。\n"}, {"mark": "回到了湖底"}, {"move": "village.seal_altar", "point": "village.seal_altar.pool_arrival"}]}, {"ask": "水潭底下透着白光——不是鱼。下去了，封坛前的事就得自己担。\n确定要潜下去吗？", "choice": "潜下去", "steps": [{"line": "你吸足一口气，扎进水潭。水冷得像刀，白光在底下越来越亮。\n"}, {"line": "潭底是一个洞口，你顺着光钻了过去，脚踩到了黑石的台阶。\n"}, {"mark": "看过封坛"}, {"move": "village.seal_altar", "point": "village.seal_altar.pool_arrival"}]}]} },
		{ "id": "village.seal_altar.pool", "kind": "act", "zone": "village.seal_altar", "name": "潭口", "reach": 96, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」); native: 终章 B (剧情总纲 §3 终章; 计划 build/plans/终章_计划.md B 包与 §0「封坛」; owner 2026-11-08「按推荐的做」; DECISIONS「终章 B」) (after the end: up at dawn to the lakeside)", "act": {"verb": "游上去", "acts": [{"mark": "你留在了冰里", "steps": [{"line": "你已经是冰了。\n"}]}, {"when": {"any": [{"mark": "侮天鬼灭了"}, {"mark": "瑷伦留在了冰里"}, {"mark": "璃虹留在了冰里"}, {"mark": "南危水留在了冰里"}, {"mark": "萧辟尘留在了冰里"}, {"mark": "你留在了冰里"}]}, "steps": [{"line": "你从潭口钻上去。冰龙厅里静悄悄的，冰洞、湖底，一路往上，水是清的。\n"}, {"when": {"phase": ["night", "midnight"]}, "until_phase": ["dawn"]}, {"line": "你从湖心冒出头来。湖上的黑冰没了。\n", "color": "HIW"}, {"when": {"phase": ["dawn"]}, "line": "东边的天亮了。\n"}, {"mark": "终章上了岸"}, {"move": "village.lakeside", "point": "village.lakeside.boat_return"}]}, {"present": "native.npc.lihong_weak", "steps": [{"line": "璃虹扶着坛沿站起来：「带我上去。」你扶着她钻进潭口，冰水灌进领子。头顶亮了——冰龙厅。她趴在潭边喘了半天，说：「上岸。到人家里去。」\n"}, {"leave": "native.npc.lihong_weak"}, {"move": "village.lakebottom2", "point": "village.lakebottom2.pool_return"}]}, {"steps": [{"line": "你从潭口钻上去，冰水灌进领子。头顶亮了——冰龙厅。\n"}, {"move": "village.lakebottom2", "point": "village.lakebottom2.pool_return"}]}]} },
		{ "id": "village.seal_altar.recite", "kind": "act", "zone": "village.seal_altar", "name": "冰柱", "reach": 120, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」) (璃虹's three questions on the 铜牒, the 火前问话 mechanism of 番坊 B reused: the true answers are the tablet's own words, the false ones 商玦's telling)", "act": {"verb": "把铜牒念给她听", "acts": [{"mark": "璃虹说了封法", "steps": [{"by": "native.npc.lihong"}, {"say": "我说过了。要再听，问我「封法」。"}]}, {"present": "native.npc.lihong", "steps": [{"by": "native.npc.lihong"}, {"say": "念。"}, {"questions": [{"text": "头在哪里？", "answers": [{"text": "头在湖底冰下，以穿灵为钉。", "mark": "读过铜牒"}, {"text": "头在逆灵宫的坛上，以黑焰养着。", "mark": "信了商玦", "note": "有意不写：错的答案，这枚印记没有写入方、永不成立（story_reach_test 的 NEVER_WRITTEN）"}]}, {"text": "钉拔了，怎样？", "answers": [{"text": "钉拔，鬼成形。", "mark": "读过铜牒"}, {"text": "钉拔，鬼就散了。", "mark": "信了商玦", "note": "有意不写：错的答案，这枚印记没有写入方、永不成立（story_reach_test 的 NEVER_WRITTEN）"}]}, {"text": "要再封，须有什么？", "answers": [{"text": "要再封，须有人留下。", "mark": "读过铜牒"}, {"text": "要再封，须有人祭。", "mark": "信了商玦", "note": "有意不写：错的答案，这枚印记没有写入方、永不成立（story_reach_test 的 NEVER_WRITTEN）"}]}], "true": [{"line": "冰里的光稳住了。\n", "color": "HIW"}, {"say": "一字不差。那片铜上刻的是实话。我再给你三句，铜上没有的。"}, {"say": "钉拔，它成形，先回它自己的家——这附近的村子，它记得路。"}, {"say": "要灭它，三器齐：旋芒斩它，宝衣挡它的黑焰，穿灵最后钉它的头。少一件，灭不掉，只能再封。"}, {"say": "要再封，须有人留下。三百年前我哥哥钉了它，没有人肯留，我留下了。这一回，还得有人。"}, {"mark": "璃虹说了封法"}, {"say": "剑就在你眼前。拔不拔，你自己定。我守了三百年，不替你定。"}], "false": [{"line": "冰里的光暗了一暗。\n"}, {"say": "不对。那不是铜上的话。再念。"}]}]}, {"steps": [{"line": "冰柱里没有人应你。\n"}]}]} },
		{ "id": "village.seal_altar.pull", "kind": "act", "zone": "village.seal_altar", "name": "穿灵", "reach": 120, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」) (the chapter's choice, pull: 总纲 §3 第八章); native: 终章 B (剧情总纲 §3 终章; 计划 build/plans/终章_计划.md B 包与 §0「封坛」; owner 2026-11-08「按推荐的做」; DECISIONS「终章 B」) (the finale on the 查清 ledger: the sword drawn now, the thing takes shape)", "act": {"verb": "拔出来", "acts": [{"when": {"any": [{"mark": "侮天鬼灭了"}, {"mark": "瑷伦留在了冰里"}, {"mark": "璃虹留在了冰里"}, {"mark": "南危水留在了冰里"}, {"mark": "萧辟尘留在了冰里"}, {"mark": "你留在了冰里"}]}, "steps": [{"line": "事情已经了结了。\n"}]}, {"when": {"all": [{"mark": "回到了湖底"}, {"mark": "侮天鬼成形"}]}, "steps": [{"line": "剑已经在你手里了。\n"}]}, {"when": {"all": [{"mark": "回到了湖底"}, {"mark": "查清了封物"}]}, "ask": "拔出穿灵，钉就没了，它当场成形。三器、来的人，都在这里了。\n要拔吗？", "choice": "拔出来", "steps": [{"line": "你握住剑柄。冰柱里的光只剩一线。你往上一拔——冰「喀」地一声裂开，剑出来了。\n", "color": "HIW"}, {"give": "native:village/soul_impaler"}, {"mark": "终章拔了穿灵"}, {"line": "黑焰从坛下涌上来，一团没有头的人形站了起来。那颗头悬在它肩上，眼睛睁着。\n", "color": "HIR"}, {"when": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}, "line": "宝衣的下摆一展，黑焰卷到跟前就散了。\n", "color": "HIW"}, {"when": {"not": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}}, "line": "没有宝衣挡着，黑焰烧得人睁不开眼。\n", "color": "HIR"}, {"mark": "侮天鬼成形"}, {"when": {"all": [{"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}, {"not": {"mark": "拔了穿灵"}}]}, "summon": "native.seal_altar.wutian_gui"}, {"when": {"all": [{"not": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}}, {"not": {"mark": "拔了穿灵"}}]}, "summon": "native.seal_altar.wutian_gui_blazing"}, {"when": {"all": [{"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}, {"mark": "拔了穿灵"}]}, "summon": "native.seal_altar.wutian_gui_grown"}, {"when": {"all": [{"not": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}}, {"mark": "拔了穿灵"}]}, "summon": "native.seal_altar.wutian_gui_grown_blazing"}]}, {"mark": "拔了穿灵", "steps": [{"line": "剑已经在你手里了。\n"}]}, {"mark": "查清了封物", "steps": [{"line": "你已经记下了封物，没有动它。这把剑，等三器齐了再拔。\n"}]}, {"not_mark": "璃虹说了封法", "steps": [{"line": "你握住剑柄。冰柱里传出一声：「先把铜上的话念给我听。」\n"}]}, {"ask": "剑一拔，钉就没了。鬼会成形，先回它自己的家——这附近的村子。璃虹会从冰里出来，可她守了三百年，出来就剩半条命。拔了就回不去。\n要拔吗？", "choice": "拔出来", "steps": [{"line": "你握住剑柄。霜化在手心里，一股凉意顺着胳膊直透到肩。\n"}, {"line": "你往上一拔——冰「喀」地一声裂开，剑出来了。\n", "color": "HIW"}, {"give": "native:village/soul_impaler"}, {"mark": "拔了穿灵"}, {"line": "冰里那颗头睁开了眼。它看着你，嘴角的笑更深了些。坛心的剑孔里冒出一丝黑气，顶上的水潭里，龙的影子乱了一乱。\n", "color": "HIR"}, {"by": "native.npc.shang_jue_lake"}, {"emote": "大笑起来，笑声在冰室里撞来撞去。"}, {"say": "三百年。它记得路。"}, {"line": "商玦化作一股黑烟，从潭口散了出去。\n"}, {"leave": true}, {"by": "native.npc.lihong"}, {"line": "冰柱从头到脚裂开，光灭了。璃虹从冰里跌了出来，跪在坛边。\n", "color": "HIW"}, {"leave": true}, {"summon": "native.seal_altar.lihong_weak"}, {"by": "native.npc.lihong_weak"}, {"say": "……三百年。我站了三百年，站不住了。"}, {"say": "剑在你手里，钉没了。它每一夜都在长。带我上岸——我还有话，在冰里说不出来的话。"}]}]} },
		{ "id": "village.seal_altar.keep", "kind": "act", "zone": "village.seal_altar", "name": "封坛", "reach": 120, "legacy_source": "native: 第八章 A (剧情总纲 §1 底线一·二, §3 第八章, §6 两处小改; 计划 build/plans/第八章_计划.md, owner 2026-11-06「按推荐，开工 A」: Q2 没宝衣能下但冷, Q3 卢卡不下湖; DECISIONS「第八章 A」) (the chapter's choice, keep: 总纲 §3 第八章)", "act": {"verb": "看清了", "acts": [{"mark": "查清了封物", "steps": [{"line": "你已经记下了。\n"}]}, {"mark": "拔了穿灵", "steps": [{"line": "来不及了。剑在你手里。\n"}]}, {"not_mark": "璃虹说了封法", "steps": [{"line": "先把铜上的话念给冰柱里的人听。\n"}]}, {"steps": [{"line": "你围着封坛走了一圈，把每一样都看清了：坛心的冰、冰里的头、钉着它的剑、剑柄上的霜、坛边柱里的人。你没有碰那把剑。\n"}, {"mark": "查清了封物"}, {"by": "native.npc.lihong"}, {"say": "好。"}, {"line": "冰柱里的光亮了一下，一片羽毛从光里落下来，落在坛沿上——浅金的，不化，不湿。\n", "color": "HIW"}, {"give": "native:village/lihong_feather"}, {"say": "我的羽。再封的时候，把它放回坛上，我认得它。去京师，去岚城，把三器凑齐了再回来。"}, {"by": "native.npc.shang_jue_lake"}, {"emote": "冷笑了一声。"}, {"say": "不拔？那就等它自己出来。"}, {"line": "商玦化作一股黑烟，从潭口散了出去。\n"}, {"leave": true}]}]} },
		{ "id": "village.seal_altar.face", "kind": "act", "zone": "village.seal_altar", "name": "坛心", "reach": 120, "legacy_source": "native: 终章 B (剧情总纲 §3 终章; 计划 build/plans/终章_计划.md B 包与 §0「封坛」; owner 2026-11-08「按推荐的做」; DECISIONS「终章 B」) (the finale on the 拔剑 ledger: it has grown three hundred years, and comes up when one goes to meet it)", "act": {"verb": "迎上去", "acts": [{"when": {"any": [{"any": [{"mark": "侮天鬼灭了"}, {"mark": "瑷伦留在了冰里"}, {"mark": "璃虹留在了冰里"}, {"mark": "南危水留在了冰里"}, {"mark": "萧辟尘留在了冰里"}, {"mark": "你留在了冰里"}]}, {"mark": "侮天鬼倒了"}]}, "steps": [{"line": "焰退回了那颗头底下，一下一下地跳。\n"}]}, {"mark": "侮天鬼成形", "steps": [{"line": "它就在你面前。\n", "color": "HIR"}]}, {"when": {"all": [{"mark": "回到了湖底"}, {"mark": "拔了穿灵"}]}, "ask": "迎上去？它长了一整个三百年。来的人、三器，都在这里了。", "choice": "迎上去", "steps": [{"line": "你走上封坛。坛心的剑孔里，黑气一股一股往上冒。\n"}, {"line": "黑焰从坛下涌上来，一团没有头的人形站了起来。那颗头悬在它肩上，眼睛睁着。\n", "color": "HIR"}, {"when": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}, "line": "宝衣的下摆一展，黑焰卷到跟前就散了。\n", "color": "HIW"}, {"when": {"not": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}}, "line": "没有宝衣挡着，黑焰烧得人睁不开眼。\n", "color": "HIR"}, {"mark": "侮天鬼成形"}, {"when": {"all": [{"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}, {"not": {"mark": "拔了穿灵"}}]}, "summon": "native.seal_altar.wutian_gui"}, {"when": {"all": [{"not": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}}, {"not": {"mark": "拔了穿灵"}}]}, "summon": "native.seal_altar.wutian_gui_blazing"}, {"when": {"all": [{"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}, {"mark": "拔了穿灵"}]}, "summon": "native.seal_altar.wutian_gui_grown"}, {"when": {"all": [{"not": {"any": [{"wearing": "native:latemoon/cold_robe"}, {"mark": "叫来了瑷伦"}, {"mark": "宝衣给了安妮儿"}]}}, {"mark": "拔了穿灵"}]}, "summon": "native.seal_altar.wutian_gui_grown_blazing"}]}, {"when": {"all": [{"mark": "回到了湖底"}, {"mark": "查清了封物"}]}, "steps": [{"line": "钉还钉着。先拔出穿灵，它才成形。\n"}]}, {"steps": [{"line": "坛心的冰里，那颗头闭着眼。\n"}]}]} },
		{"id": "village.seal_altar.nail", "kind": "act", "zone": "village.seal_altar", "name": "那颗头", "reach": 120, "legacy_source": "native: 终章 B (剧情总纲 §3 终章; 计划 build/plans/终章_计划.md B 包与 §0「封坛」; owner 2026-11-08「按推荐的做」; DECISIONS「终章 B」) (灭: 旋芒斩它，宝衣挡它的黑焰，穿灵最后钉它的头; 再封: the sword given to one who stays)", "act": {"verb": "钉下去", "acts": [{"when": {"any": [{"mark": "侮天鬼灭了"}, {"mark": "瑷伦留在了冰里"}, {"mark": "璃虹留在了冰里"}, {"mark": "南危水留在了冰里"}, {"mark": "萧辟尘留在了冰里"}, {"mark": "你留在了冰里"}]}, "steps": [{"line": "事情已经了结了。\n"}]}, {"when": {"all": [{"mark": "侮天鬼成形"}, {"not": {"mark": "侮天鬼倒了"}}]}, "steps": [{"line": "它还站着。先把它打倒。\n"}]}, {"marks": ["能灭它", "侮天鬼倒了"], "ask": "钉下去？\n旋芒斩它，宝衣挡它最后一口黑焰，穿灵钉它的头——灭了它。宝衣挡完那一口，就烧成灰了。\n不钉，就问一个肯留下的人「留下」：它还在冰下封着，宝衣还在，那人留在冰里。", "choice": "钉下去", "steps": [{"line": "焰又聚了起来，最后一次。\n", "color": "HIR"}, {"when": {"mark": "旋芒在你手里"}, "line": "你拔出旋芒，一剑——焰从中间分开。\n", "color": "HIW"}, {"when": {"mark": "旋芒在皇叔手里"}, "by": "native.npc.yulan_tianwu_altar"}, {"when": {"mark": "旋芒在皇叔手里"}, "emote": "举起旋芒，一剑劈下去。焰从中间分开。"}, {"when": {"mark": "旋芒在皇叔手里"}, "say": "三百年前於兰家拔错了一把。这一把，劈对了。"}, {"when": {"mark": "旋芒在萧辟尘手里"}, "by": "native.npc.xiao_pichen_altar"}, {"when": {"mark": "旋芒在萧辟尘手里"}, "emote": "举起旋芒，一剑劈下去。焰从中间分开。"}, {"when": {"mark": "旋芒在萧辟尘手里"}, "say": "城里的风送我来，就是为了这一下。"}, {"when": {"wearing": "native:latemoon/cold_robe"}, "line": "最后一口黑焰扑上来，宝衣挡住了。\n", "color": "HIW"}, {"when": {"mark": "叫来了瑷伦"}, "by": "native.npc.elon_altar"}, {"when": {"mark": "叫来了瑷伦"}, "emote": "把宝衣的下摆一展，挡在你前头。最后一口黑焰散了。"}, {"when": {"all": [{"mark": "宝衣给了安妮儿"}, {"not": {"mark": "叫来了瑷伦"}}]}, "by": "native.npc.annie_altar"}, {"when": {"all": [{"mark": "宝衣给了安妮儿"}, {"not": {"mark": "叫来了瑷伦"}}]}, "emote": "把宝衣的下摆一展，挡在你前头。最后一口黑焰散了。"}, {"line": "挡完这一口，宝衣的下摆烧没了。火一寸一寸往上走，整件衣裳化成了灰。寒於留它三百年，就为挡这一下。\n", "color": "HIY"}, {"take": "native:latemoon/cold_robe"}, {"mark": "宝衣烧了"}, {"line": "你握着穿灵，钉进那颗头里。\n", "color": "HIW"}, {"line": "头裂开了。焰灭了。冰穹上的龙影一齐抬起头。\n", "color": "HIW"}, {"when": {"mark": "查清了封物"}, "by": "native.npc.lihong"}, {"when": {"mark": "查清了封物"}, "line": "冰柱里的光灭了。璃虹从冰里走出来，倒在你脚边，笑了一下。\n", "color": "HIW"}, {"when": {"mark": "查清了封物"}, "leave": true}, {"mark": "侮天鬼灭了"}]}, {"mark": "侮天鬼倒了", "steps": [{"line": "三器不齐，或者守的人不够——灭不了它，只能再封。\n", "color": "HIY"}, {"line": "把穿灵交给一个肯留下的人，他把剑钉回去，自己留在冰里。\n"}, {"when": {"any": [{"mark": "叫来了瑷伦"}, {"mark": "替南危水保密"}, {"mark": "旋芒在萧辟尘手里"}]}, "line": "（问他们「留下」。）\n"}, {"when": {"mark": "查清了封物"}, "line": "（璃虹的光不多了。那片羽在你手里的话，她还能再守一回。）\n"}]}, {"steps": [{"line": "坛心的冰里，那颗头闭着眼。\n"}]}]}}
	]
