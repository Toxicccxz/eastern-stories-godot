		{
			"id": "village.npc.woman1",
			"legacy_source": "d/village/npc/woman1.c",
			"name": "农妇",
			"aliases": ["woman"],
			"gender": "女性",
			"age": 30,
			"combat_exp": { "base": 20, "plus_random": 40 },
			"carry": [
				{ "item": "es2:obj/money/coin", "source": "obj/money/coin.c", "amount": 90 },
