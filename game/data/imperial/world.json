	"landmarks": [
		{
			"id": "imperial.bridges.landmark.lions",
			"zone": "imperial.bridges",
			"name": "铜狮",
			"policy": "look",
			"long": "太和门前一对铜狮子，蹲在汉白玉的座上。狮头被摸了几百年，亮得发黄；身上别处都生了一层暗绿的锈。东边那只脚下踩着一只绣球，西边那只脚下按着一只小狮子。\n",
			"legacy_source": "native: 第九章 A (剧情总纲 §6 皇城卡; DECISIONS「第九章 A」) — 续写, the bronze pair as d/city/wumen.c's stone lions outside"
		},
		{
			"id": "imperial.square.landmark.sundial",
			"zone": "imperial.square",
			"name": "日晷",
			"policy": "look",
			"long": "一座汉白玉的日晷，晷面斜斜地朝着南天，铜针的影子落在刻度上。刻度旁有人用指甲刻了一道浅痕——大约是哪个站班的侍卫等下朝等得不耐烦。\n",
			"legacy_source": "native: 第九章 A (剧情总纲 §6 皇城卡; DECISIONS「第九章 A」) — 续写"
		},
		{
			"id": "imperial.throne_hall.landmark.throne",
			"zone": "imperial.throne_hall",
			"name": "龙椅",
			"policy": "look",
			"long": "七层台阶上一把金漆的龙椅，椅背上盘着九条龙，扶手的龙头被手握得发亮。椅子太大了：坐垫上另垫了一块厚褥子，脚下还摆着一只脚踏——坐在这上头的人，脚够不着地。\n",
			"legacy_source": "native: 第九章 A (剧情总纲 §2「少年皇帝 於兰昭」十六岁; DECISIONS「第九章 A」) — 续写"
		},
		{
			"id": "imperial.tunnel.landmark.cord",
			"zone": "imperial.tunnel",
			"name": "黑丝绦",
			"policy": "look",
			"long": "一根黑色的丝绦，一头扯断了，另一头还打着结。是从一顶黑冠上扯下来的——逆灵宫的道士戴的那种。\n",
			"legacy_source": "native: 第九章 B (剧情总纲 §3 第九章 入口「潜入」, §6 皇城卡; 计划 build/plans/第九章_计划.md B 包, owner 2026-11-06「按你的推荐来」Q2 轻潜行; DECISIONS「第九章 B」) — 续写: the 逆灵宫 man who comes this way to 庾子建 (剧情总纲 §3 第九章 ②)"
		},
		{
			"id": "imperial.cold_yard.landmark.well",
			"zone": "imperial.cold_yard",
			"name": "枯井",
			"policy": "look",
			"long": "一口枯井，井沿是青石的，磨出几道深深的绳槽。往下看，黑得看不见底，可是井壁上嵌着一道道铁蹬，最上面那几道擦得发亮。\n",
			"legacy_source": "native: 第九章 B (剧情总纲 §3 第九章 入口「潜入」, §6 皇城卡; 计划 build/plans/第九章_计划.md B 包, owner 2026-11-06「按你的推荐来」Q2 轻潜行; DECISIONS「第九章 B」) — 续写: the 冷宫's dry well the 祭坛's passage comes up into (剧情总纲 §3 第九章 入口「潜入」)"
		},
		{
			"id": "imperial.yangxin_gate.landmark.gate",
			"zone": "imperial.yangxin_gate",
			"name": "养心门",
			"policy": "look",
			"long": "养心门关着，门闩在里头。门缝里透出一点灯光——皇上睡得晚。（养心殿是这一章后面的事。）\n",
			"legacy_source": "native: 第九章 B (剧情总纲 §3 第九章 入口「潜入」, §6 皇城卡; 计划 build/plans/第九章_计划.md B 包, owner 2026-11-06「按你的推荐来」Q2 轻潜行; DECISIONS「第九章 B」) — the 养心殿's gate; the hall itself is the ninth chapter's C package"
		},
		{
			"id": "imperial.west_room.landmark.map",
			"zone": "imperial.west_room",
			"name": "舆图",
			"policy": "look",
			"long": "一幅旧舆图，北到关北，南到玉螺湖，西南角用朱笔圈了一个地方，旁边两个小字：「岚城？」。圈是新描的，墨色比舆图上的字深得多——有人常常对着它看。\n",
			"legacy_source": "native: 第九章 C (剧情总纲 §3 第九章 ②③④, §6 皇城卡; 计划 build/plans/第九章_计划.md C 包, owner 2026-11-06「按你的推荐来」; DECISIONS「第九章 C」) — the boy reading his father's search (剧情总纲 §2: 只想完成父亲的寻剑), 续写"
		}
	],
	"services": [
		{
			"id": "imperial.study.chest",
			"kind": "act",
			"zone": "imperial.study",
			"name": "樟木匣",
			"reach": 96,
			"legacy_source": "native: 第九章 C (剧情总纲 §3 第九章 ②③④, §6 皇城卡; 计划 build/plans/第九章_计划.md C 包, owner 2026-11-06「按你的推荐来」; DECISIONS「第九章 C」) — the late emperor's 寻剑 archive (剧情总纲 §3 第九章 ③: 先帝寻剑的档案), 续写",
			"act": {
				"verb": "翻看",
				"acts": [
					{
						"mark": "翻过樟木匣",
						"steps": [
							{
								"line": "樟木匣里还剩几册先帝的手札，记的都是岚城：哪年派了谁去，回来说了什么。\n"
							}
						]
					},
					{
						"steps": [
							{
								"line": "你揭开封条。匣子里一卷黄绫裹着的诏书，一卷兵部存档的复本，底下压着几册手札。\n"
							},
							{
								"line": "诏书只有一行字，先帝的御笔：「寻剑，不得扰民一户。」后头钤着一方御宝，朱色正红。\n",
								"color": "HIY"
							},
							{
								"line": "兵部的复本同一个日子、同一个开头，「寻剑」之后多出三行：「征民夫，设关卡，拿人。」后头盖着兵部的印。\n"
							},
							{
								"give": "native:imperial/original_decree"
							},
							{
								"give": "native:imperial/war_ministry_copy"
							},
							{
								"mark": "翻过樟木匣"
							}
						]
					}
				]
			}
		},
		{
			"id": "imperial.study.desk",
			"kind": "act",
			"zone": "imperial.study",
			"name": "御案",
			"reach": 96,
			"legacy_source": "native: 第九章 C (剧情总纲 §3 第九章 ②③④, §6 皇城卡; 计划 build/plans/第九章_计划.md C 包, owner 2026-11-06「按你的推荐来」; DECISIONS「第九章 C」) — the two decrees laid side by side (剧情总纲 §3 第九章 ③: 印色对不上（第六章学过）), 续写",
			"act": {
				"verb": "比对",
