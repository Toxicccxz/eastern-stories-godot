		{
			"id": "green.npc.oldman2",
			"legacy_source": "d/green/npc/oldman2.c",
			"name": "村长",
			"aliases": ["elder", "oldman", "man"],
			"gender": "男性",
			"age": 95,
			"long": "",
			"resources": { "max_gin": 100, "max_kee": 200, "max_sen": 100 },
			"combat_exp": 500,
			"attitude": "friendly",
			"carry": [
				{ "item": "es2:obj/cloth", "source": "obj/cloth.c", "equip": "wear" }
			],
			"inquiry": {
				"玉佩": [
					"嗯...... 你是说那个从古墓盗出来的玉佩?\n",
					"应该蛮珍贵的, 可是有点来路不明...\n",
					"我送给一个年轻人了, 不过听说他得此玉佩后性情大变.\n",
					"看来此物不祥... \n",
					"你要找他吗? 有人说他现在以酒度日, 我也不知他的下落.\n",
					{ "mark_asker": "elder_info" },
					"造孽啊........\n"
				],
				"山洞": {
					"rules": [
						{ "asker_marks": ["村长说完了那句话", "绝尘派守了阵"], "lines": [{ "say": "北边那个山洞，寒气没了。洞口不知谁摆了一圈石头，阿牛钻进去转了一圈，又从原路转出来了。" }, { "emote": "望着北边的山。" }, { "say": "村北的狗，夜里也不叫了。" }] },
						{ "asker_marks": ["村长说完了那句话", "了尘下了山"], "lines": [{ "say": "后山下来过一个拿杖的……和尚。在洞口念了一夜的经，第二天一早往南去了。" }, { "say": "国之将亡，必有妖孽。……有妖孽，也有念经的人。" }] },
						{ "asker_marks": ["村长说完了那句话"], "lines": [{ "say": "国之将亡，必有妖孽。" }, { "emote": "望着北边的山，摇了摇头。" }, { "say": "……这回，是真的出来了。" }] },
						{ "asker_marks": ["孩子回了家"], "mark_asker": "村长说完了那句话", "lines": [{ "emote": "听你说孩子回来了，长长地出了一口气。" }, { "say": "回来了就好，回来了就好……" }, { "emote": "拄着拐杖站起来，望着北边的山。" }, { "say": "那洞里的冷，不是人间的冷。我拴那道门的时候就知道。" }, { "say": "国之将亡……" }, { "emote": "顿了很久。" }, { "say": "……必有妖孽。" }, { "say": "我活了九十五年，这句话从来不敢说完。" }] },
						{ "asker_marks": ["阿牛跟着你"], "lines": [{ "emote": "看见你身后的阿牛，拐杖在地上顿了一下。" }, { "say": "快，快带他去北边路口，他娘在那儿喊了一天了。" }] },
						{ "asker_marks": ["村长说了山洞"], "asker_lacks": ["绝尘的线断了"], "say": "阿牛和小翠还在洞里。开了那道木门往里走——洞里有东西，小心。" },
						{ "asker_family": "family.juechen", "asker_marks": ["宝衣一章"], "asker_lacks": ["绝尘的线断了"], "mark_asker": "村长说了山洞", "lines": [{ "emote": "叹了一口气。" }, { "say": "北边那个山洞？那道门是我拴的，拴了好些年了。洞里冷，冷到骨头缝里——绝对不可以打开。" }, { "say": "可妇人家的阿牛，背着他妹妹，又钻进去了。门上那条铁链……早就锈断了。" }, { "say": "这阵子夜里，洞口那边有声音。不是风。" }, { "say": "你要是去，就开了那道木门往里走。把孩子带出来。" }] },
						{ "asker_marks": ["过阵的客", "宝衣一章"], "asker_lacks": ["绝尘的线断了"], "mark_asker": "村长说了山洞", "lines": [{ "emote": "叹了一口气。" }, { "say": "北边那个山洞？那道门是我拴的，拴了好些年了。洞里冷，冷到骨头缝里——绝对不可以打开。" }, { "say": "可妇人家的阿牛，背着他妹妹，又钻进去了。门上那条铁链……早就锈断了。" }, { "say": "这阵子夜里，洞口那边有声音。不是风。" }, { "say": "你要是去，就开了那道木门往里走。把孩子带出来。" }] },
						{ "say": "北边那个山洞？那道门是我拴的。洞里冷，绝对不可以打开。" }
					]
				}
			},
			"chat_chance": 10,
			"chat_msg": [{ "action": "emote", "verb": "sigh" }, "村长说道：国之将亡.....\n"],
			"relay_say": { "必有妖孽": [{ "say": "对呀.. 你就是妖孽... " }] }
		},
