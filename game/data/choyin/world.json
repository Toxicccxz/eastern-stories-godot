	],
	"landmarks": [
		{ "id": "choyin.w_street1.landmark.statue", "zone": "choyin.w_street1", "name": "石狮", "policy": "look", "long": "这尊石狮跟一般寻常人家放在门口镇宅避邪的石狮颇有不同，姿势是立\n著的，而且大小要大得多，只怕有几万斤重，从来没见过谁能举起它。\n你注意到石狮的额头上刻著一个「举」字，不知是何用意？\n", "legacy_source": "d/choyin/w_street1.c" },
		{ "id": "choyin.tree_tomb.landmark.hole", "zone": "choyin.tree_tomb", "name": "大洞", "policy": "look", "long": "一个黑漆漆的大洞，看来像是什么蛀虫蛀出来的，可是天底下哪里\n有这么大的蛀虫？这个洞连人也进得去。\n", "legacy_source": "d/choyin/tree_tomb.c" },
		{ "id": "choyin.tree_tomb.landmark.shrine", "zone": "choyin.tree_tomb", "name": "小庙", "policy": "look", "long": "一间砖砌的小庙，庙里供奉的当然就是「树王公」，你注意到庙里\n树王公的神像左手残缺不全，木刻的神像竟然有一条条白蚁的痕迹，和\n一般庙里金身神像给人的印象不太一样。\n", "legacy_source": "d/choyin/tree_tomb.c" },
		{ "id": "choyin.fence.landmark.fence", "zone": "choyin.fence", "name": "竹篱", "policy": "look", "long": "篱笆依地势而曲折延伸，你注意到柴门里面有一间草堂。\n", "legacy_source": "d/choyin/fence.c" },
		{ "id": "choyin.club.landmark.books", "zone": "choyin.club", "name": "书卷", "policy": "look", "long": "几上的书信手而放，装帧古朴，竟是宋版书，还有几卷汉碑原拓。你按捺不住好奇心想拿\n起来(scratch)仔细研究一番。\n", "legacy_source": "d/choyin/club.c" },
		{ "id": "choyin.guyehill.landmark.vine", "zone": "choyin.guyehill", "name": "藤蔓", "policy": "look", "long": "其中有一根藤蔓距离你比较近，你可以试著抓住(hold)藤蔓\n", "legacy_source": "d/choyin/guyehill.c" },
		{ "id": "choyin.guyehill.landmark.tree", "zone": "choyin.guyehill", "name": "古树", "policy": "look", "long": "这是一株万年古树，寻常人等休想爬得上去.\n", "legacy_source": "d/choyin/guyehill.c" },
		{ "id": "choyin.platform.landmark.platform", "zone": "choyin.platform", "name": "云台", "policy": "look", "long": "一座精雕细琢的玉台,放有一矮几;几上立有玉瓶,几株寒谷幽兰\n绽放其中.台旁置一云幡(flag),可是仙家宝物.\n", "legacy_source": "d/choyin/platform.c" },
		{ "id": "choyin.platform.landmark.flag", "zone": "choyin.platform", "name": "云幡", "policy": "look", "long": "此幡可翻云覆雨,最好不要碰(touch)它.\n", "legacy_source": "d/choyin/platform.c" },
		{ "id": "choyin.hollow3.landmark.vase", "zone": "choyin.hollow3", "name": "空穴", "policy": "look", "long": "石穴呈瓶状,想是用来插(interject)什么东东的.\n", "legacy_source": "d/choyin/hollow3.c" }
	],
