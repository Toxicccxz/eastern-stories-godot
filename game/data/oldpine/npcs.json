			"toll_shout": 0,
			"chat_chance": 1,
			"chat_msg": ["土匪喽罗横刀拦住去路，喝道：站住！要过老松寨，留下十两银子买路钱！\n"],
			"inquiry": {
				"买路钱": ["十两银子，一个子儿不能少。拿来！"],
				"老松寨": ["老松寨是常老大的寨子，泼风刀王常老大，听过没有？想进去，先留下买路钱。"],
				"黑衣道士": ["前些天是来过一个黑衣黑冠的道士，拿一块金牌买了路，往里头去了。你要问，问寨主去——先留下买路钱。"],
				"叫阵": {
					"confirm": "叫阵是跟常老大单打独斗——寨里的人不插手，但常老大的泼风刀下，没几个人站得住。要叫阵吗？",
					"rules": [
						{ "asker_marks": ["叫阵老松寨"], "say": "叫过了还叫？聚义厅在东头，常老大等着你。" },
						{ "mark_asker": "叫阵老松寨", "lines": [{ "say": "好大的口气！" }, { "emote": "朝寨子里扯着嗓子喊：有人叫阵——！" }, { "say": "进去吧，聚义厅在东头。常老大一个人等你，寨里的弟兄不插手。" }] }
					]
				}
			},
			"accept_object": [
				{ "giver_mark": "老松寨的过路钱", "say": "钱已经交过了，进去吧。", "accept": true },
				{ "value_at_least": 1000, "mark_giver": "老松寨的过路钱", "line": "土匪喽罗掂了掂银子，咧嘴一笑：算你识相。进去吧，寨里的弟兄不会难为你。\n", "accept": true },
				{ "line": "土匪喽罗往地上啐了一口：打发叫花子呢？十两银子，少一个子儿都不行！\n", "accept": false }
			]
		},
