	"landmarks": [
		{
			"id": "oldpine.outdoor.landmark.ancient_pine", "zone": "oldpine.outdoor.central_clearing",
			"name": "大松树", "action": "爬树", "portals": ["oldpine.outdoor.climb_pine"],
			"long": "一株又高又大的松树，当你抬头往上看的时候似乎有个人影\n在树梢之间移动，不过也许是风吹动所造成的错觉。\n",
			"messages": { "use": "你手脚并用，敏捷地爬上了空地中央的大松树。" },
			"legacy_source": "d/oldpine/clearing.c"
		},
		{
			"id": "oldpine.tree.landmark.tree1_descent", "zone": "oldpine.tree.canopy",
			"name": "大松树上", "action": "往下爬", "portals": ["oldpine.tree.descend_tree1"],
			"long": "你现在正攀附在一株大松树的树干上，从这里可以很清楚地望见树\n下的一切动静，而不被人发觉，似乎是个干偷鸡摸狗勾当的好地方。\n",
			"messages": { "use": "你顺著粗大的树干，慢慢地爬了下来。" },
			"legacy_source": "d/oldpine/tree1.c"
		},
		{
			"id": "oldpine.outdoor.landmark.epath2_vine", "zone": "oldpine.outdoor.east_bridge",
			"name": "藤蔓", "action": "抓住藤蔓", "policy": "vine",
			"portals": ["oldpine.outdoor.vine_to_waterfall", "oldpine.outdoor.vine_to_passage"],
			"long": "其中有一根藤蔓距离你比较近，你可以试著抓住(hold)藤蔓，看看\n能不能像泰山一样荡过去，看看瀑布后面有什么？\n对了，提醒你一点，这座石桥下面是高约百丈的山涧深谷....。\n",
			"messages": {
				"hold": "你爬上石桥的护栏，伸手往不远处的一根藤蔓抓去....",
				"fall": "只听见一声杀猪般的惨叫，你已经往山涧中坠了下去。",
				"fall_observer": "你听到有人高声惊叫，一条人影从上方掉了下来，「扑通」一声跌进潭中。",
				"climb": "你手脚俐落地攀附著藤蔓，慢慢地爬下山涧....。",
				"climb_observer": "忽然一条人影从南边的帘幕穿了出来。"
			},
			"legacy_source": "d/oldpine/epath2.c"
		},
		{
			"id": "oldpine.gorge.landmark.riverbank1_cliff", "zone": "oldpine.gorge.river",
			"name": "山涧石壁", "action": "攀爬石壁", "portals": ["oldpine.gorge.riverbank1_climb_cliff"], "contact": true,
			"long": "两边的山壁看起来又高又陡，看来要爬上岸边实在很不容易。\n",
			"messages": { "use": "你一付不信邪的表情，开始小心翼翼地攀著石壁爬了上去。" },
			"legacy_source": "d/oldpine/riverbank1.c"
		},
		{
			"id": "oldpine.cliff.landmark.cliff1_down", "zone": "oldpine.cliff.hole",
			"name": "向下的山壁", "action": "往下爬", "portals": ["oldpine.cliff.climb_down"], "contact": true,
			"long": "从这个勉强容身的岩穴往下爬，还有一段不算短的距离。\n",
			"messages": { "use": "你试了试脚边的岩石稳不稳，开始小心翼翼地往山涧中攀了下去。" },
			"legacy_source": "d/oldpine/cliff1.c"
		},
		{
			"id": "oldpine.cliff.landmark.cliff1_up", "zone": "oldpine.cliff.hole",
			"name": "向上的山壁", "action": "往上爬", "portals": ["oldpine.cliff.climb_up"], "contact": true,
			"long": "从这个勉强容身的岩穴往上爬，还有一段不算短的距离。\n",
			"messages": { "use": "你试了试脚边的岩石稳不稳，开始小心翼翼地往上攀爬。" },
			"legacy_source": "d/oldpine/cliff1.c"
		},
		{
			"id": "oldpine.cave.landmark.stone", "zone": "oldpine.cave.inner_path",
			"name": "大青石", "action": "往上爬", "portals": ["oldpine.cave.climb_stone"], "contact": true,
			"long": "一块比人还高的钟乳石, 虽然长满了青苔, 但爬(climb)上去\n应该不会太困难。\n",
			"messages": { "use": "你慢慢地攀上大青石。" },
			"legacy_source": "d/oldpine/path3.c"
		},
		{
			"id": "oldpine.stone.landmark.climb_down", "zone": "oldpine.stone.top",
			"name": "大青石", "action": "往下爬", "portals": ["oldpine.stone.climb_down"],
			"long": "你现在正站在一块突出的大青石上, 虽然有点滑, 你还是能站稳,\n往四周看, 除了长满了青苔的石壁, 好象无路可走了。\n",
			"messages": { "use": "你迅速地爬下大青石。" },
			"legacy_source": "d/oldpine/stone.c"
		},
		{
			"id": "oldpine.caves.landmark.wall", "zone": "oldpine.caves.mouth",
			"name": "石壁", "action": "埋葬骸骨", "policy": "bury", "portals": ["oldpine.caves.bury_fall"], "contact": true,
			"long": "老夫南危水, 乃是昔年水烟阁五长老中第一高手,\n一生醉心武学, 集天邪、封山两派之所长, 为营救盟主遭小人暗算,\n埋骨于此。男子汉大丈夫死不足惜, 只可恨一身武学尚无传人!\n葬(bury)我遗骨者老夫将赠以过招要旨, 唉......\n",
			"items": { "buried": "es2:d/oldpine/npc/skeleton", "reward": "es2:d/oldpine/npc/obj/parrybook" },
			"messages": {
				"bury": "你小心翼翼地埋好了那具骸骨。",
				"book": "你听见山洞顶部的石壁「喀喇」地一声响，一本书坠落下来。",
				"paper": "你只看见山洞顶部纷纷扬扬飘下几张纸片来。",
				"fall": "你听得「轰」的一声响，已经从这摔了下去"
			},
			"legacy_source": "d/oldpine/cave5.c"
		},
		{
			"id": "oldpine.outdoor.landmark.cliffdown_cliff", "zone": "oldpine.outdoor.pine_cliff_edge",
			"name": "悬崖", "action": "往下爬", "portals": ["oldpine.outdoor.climb_cliff2"], "contact": true,
			"long": "你定下心神一看，其实这个悬崖没有想像中那么恐怖，也许还\n可以从这里爬下山涧，只是这世界上大概没有这种白痴愿意干\n这种傻事吧。\n",
			"messages": { "use": "你一付认真的表情，开始小心翼翼地攀著石壁爬了上去。" },
			"legacy_source": "d/oldpine/cliffdown.c"
		},
		{
