			"reach": 96,
			"legacy_source": "native: 逆灵宫 C (剧情总纲 §3 第三章 ⑤–⑦, §6 逆灵宫卡; DECISIONS「逆灵宫 C」) (the back door onto the 后山崖径: the chase, asked first — 救人和追宫主只来得及一件)",
			"act": {
				"verb": "追出去",
				"acts": [
					{
						"mark": "救出了霍铮",
						"steps": [
							{
								"line": "你推开小门，风裹着雾扑进来。崖径上空无一人。\n"
							},
							{
								"move": "niling.cliff_path",
								"point": "niling.cliff_path.door_arrival"
							}
						]
					},
					{
						"mark": "追出了后门",
						"steps": [
							{
								"line": "你推开小门，风裹着雾扑进来。\n"
							},
							{
								"move": "niling.cliff_path",
								"point": "niling.cliff_path.door_arrival"
							}
						]
					},
					{
						"ask": "后门外是后山的崖径，商玦刚从这里出去。追出去，就赶不回地牢了——救人和追宫主，只来得及一件。",
						"choice": "追出去",
						"steps": [
							{
								"line": "你推开小门，风裹着雾扑进来。崖径上有脚步声，往北去了。\n"
