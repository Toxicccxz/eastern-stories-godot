	"landmarks": [
		{
			"id": "niling.winch.landmark.crates",
			"zone": "niling.winch",
			"name": "箱子",
			"policy": "look",
			"long": "吊上来的箱子堆了一人高，每只箱板上都烙着一个「羊」字——野羊寨的记号。箱缝里露出绸缎的一角，另一只箱子底下渗出暗红的水渍，闻着是腌肉的咸味，也许不是。\n",
			"legacy_source": "native: 逆灵宫 A (野羊寨's tribute hoisted up the crack; doc/help/plan:30–31 纳供大量金钱财帛)"
		},
		{
			"id": "niling.yard.landmark.banners",
			"zone": "niling.yard",
			"name": "黑幡",
			"policy": "look",
			"long": "黑布的幡从一丈多高的杆子上垂到地，布面上用暗红的颜色写满了字，笔画横着走、竖着走，像是经文又像是符咒。风一过，字就一闪一闪地动，盯久了眼睛发酸。\n",
			"legacy_source": "native: 逆灵宫 A (黑衣黑冠, doc/help/plan:29; the 逆灵天书 of doc/help/taoist:58 is what the banners quote)"
		},
		{
			"id": "niling.yard.landmark.burner",
			"zone": "niling.yard",
			"name": "香炉",
			"policy": "look",
			"long": "一只齐腰高的黑铁香炉，炉口里烧着的不是香，是一把把黑色的碎末，冒着极淡的青烟，味道苦得呛人。炉身上铸着一圈无头的人形，手拉着手。\n",
			"legacy_source": "native: 逆灵宫 A (the 道观 that prays to 劫, not to a god: 剧情总纲 §6; the headless figures are 侮天鬼's, doc/help/history:51–60)"
		},
		{
			"id": "niling.front.landmark.scripture",
			"zone": "niling.front",
			"name": "经书",
			"policy": "look",
			"long": "乌黑的长案上摊着一卷黑皮的经书，字是暗红的，横着走竖着走，和黑幡上的一样。你盯着看了一会儿，字像是在动，赶紧移开了眼。案角摆着一只木鱼，鱼身上的漆被敲掉了一块。\n",
			"legacy_source": "native: 逆灵宫 B (the 逆灵天书 of doc/help/taoist:58, the forbidden book, open on the hall's table)"
		},
		{
			"id": "niling.alchemy.landmark.furnace",
			"zone": "niling.alchemy",
			"name": "丹炉",
			"policy": "look",
			"long": "一座三足铜丹炉，炉身熏得乌黑。炉口的火苗是青色的，没有一点热气。炉边的托盘上摆着几颗乌黑的丹丸，闻着是一股说不出的腥甜。你不想知道它们是什么炼的。\n",
			"legacy_source": "native: 逆灵宫 B (剧情总纲 §3 第三章 ④: 纳供的不只是金帛，是人; the furnace the ledger's 「入丹房」 means)"
		},
		{
			"id": "niling.alchemy.landmark.jars",
			"zone": "niling.alchemy",
			"name": "药架",
			"policy": "look",
			"long": "药架上的罐子一只只封着口，签子上写的不是药名：「野羊 · 丁未秋」「关北 · 戊申冬」……有一只罐子的签子上写着「傅家坡 · 待」，罐子是空的。\n",
			"legacy_source": "native: 逆灵宫 B (the jars labelled by where the tribute came from; 石头's is still empty)"
		},
		{
			"id": "niling.corridor.landmark.scratches",
			"zone": "niling.corridor",
			"name": "刻痕",
			"policy": "look",
			"long": "西边那扇铁栅门里的墙根上，一排排指甲刻出来的道道，五个一组，刻了一百多组。最后一组只有三道。\n",
			"legacy_source": "native: 逆灵宫 B (霍铮 counting the half year of doc/help/plan:30 on his cell's wall)"
		},
		{
			"id": "niling.altar.landmark.altar",
			"zone": "niling.altar",
			"name": "黑石坛",
			"policy": "look",
			"long": "黑石砌成的坛，齐胸高，坛面磨得发亮。坛上烧着一团黑焰，没有温度，没有声音，凑近了看，焰心里像有东西在动。坛脚的石缝里塞着碎骨。\n",
			"legacy_source": "native: 逆灵宫 C (剧情总纲 §3 第三章 ⑤–⑦, §6 逆灵宫卡; DECISIONS「逆灵宫 C」) (the altar to 劫, not to a god; the shade in its flame is 侮天鬼's, doc/help/history:51–60)"
		},
		{
			"id": "niling.master.landmark.shelf",
			"zone": "niling.master",
			"name": "书架",
			"policy": "look",
			"long": "空书架。灰尘上留着一排书脊的印子，最宽的那一道在正中。架子最底下掉着一页烧了一半的纸，只剩「逆灵」两个字。\n",
			"legacy_source": "native: 逆灵宫 C (剧情总纲 §3 第三章 ⑤–⑦, §6 逆灵宫卡; DECISIONS「逆灵宫 C」) (the 逆灵天书 gone with its master; doc/help/taoist:58)"
		},
		{
			"id": "niling.master.landmark.box",
			"zone": "niling.master",
			"name": "黑匣",
			"policy": "look",
			"long": "一只黑漆木匣，开着。匣里垫着黑绒，绒上压出一个长条形的印子，像是放过一卷书——或者一把剑。\n",
			"legacy_source": "native: 逆灵宫 C (剧情总纲 §3 第三章 ⑤–⑦, §6 逆灵宫卡; DECISIONS「逆灵宫 C」) (what 商玦 took with him)"
		},
		{
			"id": "niling.cliff.landmark.rope",
			"zone": "niling.cliff",
			"name": "绳索",
			"policy": "look",
			"long": "绳索被割断了，一头垂在雾里。断口整齐，是一剑。商玦就是从这里下去的，你没法跟。\n",
			"legacy_source": "native: 逆灵宫 C (剧情总纲 §3 第三章 ⑤–⑦, §6 逆灵宫卡; DECISIONS「逆灵宫 C」) (the way 商玦 went: a dead end for the player, 剧情总纲 §3 第三章 ⑦)"
		}
	]
}
