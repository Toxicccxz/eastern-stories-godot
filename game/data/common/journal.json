{
	"journal_chains": [
		{
			"id": "snow.newcomer",
			"title": "雪亭镇的头几天",
			"region": "雪亭镇",
			"line": "errand",
			"sources": ["native: 前两小时 A (owner, 2026-10-26; DECISIONS「新手链与当前目标」) — a guide chain over ES2's own 雪亭镇"],
			"guide": true,
			"entries": [
				{
					"id": "woke",
					"when": { "seen": "snow.npc.waiter" },
					"text": "你在饮风客栈醒来，店小二笑着招呼了你。",
					"next": "跟店小二打听「楼上」。"
				},
				{
					"id": "errand",
					"when": { "heard": { "npc": "snow.npc.waiter", "topic": "楼上" } },
					"text": "店小二说楼上客房闹老鼠，请你上去收拾。",
					"next": "上楼收拾老鼠。"
				},
				{
					"id": "rats",
					"when": { "mark": "客栈老鼠" },
					"text": "楼上的老鼠都收拾干净了。",
					"next": "下楼找店小二。"
				},
				{
					"id": "thanked",
					"when": { "mark": "店小二谢过" },
					"text": "店小二谢了你一根烤鸡腿。",
					"next": "去淳风武馆拜柳淳风为师。"
				},
				{
					"id": "apprenticed",
					"when": { "family": "family.fonxan" },
					"text": "你拜入了封山剑派。",
					"next": "向柳淳风请教基本剑法。"
				},
				{
					"id": "sword",
					"when": { "skill_at_least": { "skill": "sword", "level": 1 } },
					"text": "你跟柳淳风学了基本剑法。",
					"next": "去武馆和弟子切磋一场，胜了算。"
				},
				{
					"id": "first_spar",
					"when": { "milestone": "spar/snow.npc.trainee" },
					"text": "你第一次在切磋中胜过了武馆弟子。",
					"next": "到武学页打坐，把内力练到 10。"
				},
				{
					"id": "force_10",
					"when": { "force_at_least": 10 },
					"text": "你的内力练到了 10。",
					"next": "再切磋，再打坐：内力练到 25。"
				},
				{
					"id": "force_25",
					"when": { "force_at_least": 25 },
					"text": "你的内力练到了 25。",
					"next": "向李教头讨教一场，然后打坐到内力 50。"
				},
				{
					"id": "force_50",
					"when": { "force_at_least": 50 },
					"text": "你的内力练到了 50，够学封山剑法了。",
					"next": "向柳淳风请教封山剑法；教练场的木人也等着你。"
				},
				{
					"id": "fonxan_sword",
					"when": { "skill_at_least": { "skill": "fonxansword", "level": 1 } },
					"text": "你学会了封山剑法。",
					"next": "去雪亭驿找杜宽，问问「送信」；门外的悬赏榜也看一眼。"
				},
				{
					"id": "bounty",
					"when": { "mark": "a2_bounty_taken" },
					"text": "你揭了雪亭驿门外的一张悬赏。",
					"next": "出镇南行，过卧龙岗，去绮云镇看看。"
				},
				{
					"id": "cloud",
					"final": true,
					"when": { "milestone": "region/cloud" },
					"text": "你第一次来到绮云镇。雪亭镇的头几天到此为止，往后的路自己走。"
				}
			]
		},
		{
			"id": "snow.letter",
			"title": "雪亭驿的信",
			"region": "雪亭镇",
			"line": "errand",
			"sources": ["native: 前两小时 C (owner, 2026-10-26; DECISIONS「雪亭驿的信」) over d/snow/postoffice.c's text (the couriers' detour, the people's letters)"],
			"guide": true,
			"entries": [
				{
					"id": "taken",
					"when": { "mark": "雪亭驿的信" },
					"text": "杜宽托你把一封信送到绮云镇振远镖局陈剑秋手里，回来给一两脚钱。",
					"next": "出镇往南过卧龙岗，到绮云镇的振远镖局把信交给陈剑秋。"
				},
				{
					"id": "delivered",
					"when": { "mark": "信送到了" },
					"text": "你把信交给了陈剑秋。",
					"next": "回雪亭驿找杜宽拿脚钱。"
				},
				{
					"id": "paid",
					"final": true,
					"when": { "mark": "脚钱" },
					"text": "杜宽付了你一两脚钱，说往后有信还找你。"
				}
			]
		},
		{
			"id": "snow.liu_anlu",
			"title": "门房的来历",
			"region": "雪亭镇",
			"sources": ["d/snow/npc/teacher.c", "daemon/class/swordsman/master.c", "d/snow/npc/woodcutter.c", "d/snow/npc/guard.c (native guide chain over ES2's own clues: 前两小时 D, DECISIONS「刘安禄的揭露」)"],
			"guide": true,
			"entries": [
				{
					"id": "wei",
					"when": { "heard": { "npc": "snow.npc.teacher", "topic": "刘安禄" } },
					"text": "魏无极说淳风武馆的门房刘安禄是野羊山寨的二寨主，人称血手刘三。",
					"quote": { "npc": "snow.npc.teacher", "topic": "刘安禄" },
					"next": "去淳风武馆问问柳淳风「刘安禄」。"
				},
				{
					"id": "liu",
					"final": true,
					"when": { "heard": { "npc": "common.npc.swordsman.master", "topic": "刘安禄" } },
					"text": "柳淳风只说刘兄弟在武馆管事五年了，过去之事不须再提。门房的来历，雪亭镇上只有他一个人清楚。",
					"quote": { "npc": "common.npc.swordsman.master", "topic": "刘安禄" }
				},
				{
					"id": "woodcutter",
					"when": { "chat": { "npc": "snow.npc.woodcutter", "contains": "臭道士" } },
					"text": "樵夫骂野羊山那群道士该千刀万剐，说他们施了妖法。"
				},
				{
					"id": "slip",
					"when": { "chat": { "npc": "snow.npc.guard", "contains": "想我堂堂" } },
					"text": "刘安禄动起手来说漏了嘴：「想我堂堂……呃……连我这个小小的门房都可以收拾你！」"
				},
				{
					"id": "revealed",
					"when": { "mark": "血手刘三" },
					"text": "刘安禄亮出了血手刘三的身份：野羊山寨的二寨主，一手快刀判若两人。"
				}
			]
		},
		{
			"id": "snow.wei_wuji",
			"title": "魏无极",
			"region": "雪亭镇",
			"sources": ["d/snow/npc/teacher.c"],
			"entries": [
				{
					"id": "asked_fee",
					"when": { "heard": { "npc": "snow.npc.teacher", "topic": "学费" } },
					"text": "你向雪亭镇书院的魏无极打听学费。",
					"quote": { "npc": "snow.npc.teacher", "topic": "学费" }
				},
				{
					"id": "paid",
					"final": true,
					"when": { "mark": "魏无极" },
					"text": "你交给魏无极学费，他点头说从今天起你随时可以去问他读书识字的学问。"
				}
			]
		},
		{
			"id": "snow.weapon_storage",
			"title": "兵器储藏室",
			"region": "雪亭镇",
			"sources": ["d/snow/weapon_storage.c", "d/snow/secret_storage.c", "d/snow/obj/shield.c"],
			"entries": [
				{
					"id": "shield",
					"final": true,
					"when": { "item": "es2:d/snow/obj/shield" },
					"text": "你在兵器储藏室底下的地下密室里拾到一面牛皮盾。"
				}
			]
		},
		{
			"id": "green.jade",
			"title": "玉佩",
			"region": "青石村",
			"sources": ["d/green/npc/oldman2.c", "d/snow/npc/drunk.c", "d/green/npc/shen.c", "d/green/obj/jade.c", "obj/slumber_drug.c"],
			"entries": [
				{
					"id": "elder",
					"when": { "mark": "elder_info" },
					"text": "你向青石村的村长打听玉佩。",
					"quote": { "npc": "green.npc.oldman2", "topic": "玉佩" }
				},
				{
					"id": "drunk_jade",
					"when": { "mark": "give_alcohol" },
					"text": "你给雪亭镇的醉汉送酒，他悄声说：玉佩他卖给沈老板了，那东西不吉祥。"
				},
				{
					"id": "drunk_drug",
					"when": { "mark": "know_drug" },
					"text": "你又给醉汉送酒，他悄声说：听说沈记商行有在卖蒙汗药。"
				},
				{
					"id": "jade",
					"final": true,
					"when": { "item": "es2:d/green/obj/jade" },
					"text": "你向沈记商行的沈万年问起玉佩，得到了那块刻著行气口诀的玉佩。"
				},
				{
					"id": "drug_price",
					"when": { "mark": "can_buy_drug" },
					"text": "你向沈万年打听蒙汗药，他悄声说一份只要十两银子，保证有效。"
				},
				{
					"id": "drug",
					"when": { "item": "es2:obj/slumber_drug" },
					"text": "你付给沈万年十两银子，他塞给你一包蒙汗药。"
				}
			]
		},
		{
			"id": "green.maze",
			"title": "迷阵",
			"region": "青石村",
			"sources": ["d/green/entrance.c", "d/green/eight7.c", "d/green/closed.c", "d/green/water.c", "d/green/obj/windsword.c"],
			"entries": [
				{
					"id": "through",
					"when": { "mark": "八卦阵" },
					"text": "你依着路牌穿过了山路尽头的迷阵。"
				},
				{
					"id": "windsword",
					"final": true,
					"when": { "item": "es2:d/green/obj/windsword" },
					"text": "你跳入溪水中仔细寻找，竟从水中找出一把追风剑。"
				}
			]
		},
		{
			"id": "oldpine.skeleton",
			"title": "山洞里的骸骨",
			"region": "老松岭",
			"sources": ["d/oldpine/cave5.c", "d/oldpine/npc/skeleton.c", "d/oldpine/npc/obj/parrybook.c"],
			"entries": [
				{
					"id": "buried",
					"final": true,
					"when": { "item": "es2:d/oldpine/npc/obj/parrybook" },
					"text": "你在瀑布旁的山洞里埋好了那具骸骨，洞顶石壁「喀喇」一响，坠下一本过招要旨。"
				}
			]
		},
		{
			"id": "oldpine.knife_marks",
			"title": "树上的刀痕",
			"region": "老松岭",
			"sources": ["native: 老松林可读化 (owner, 2026-10-28; DECISIONS「老松林的林径与藏起来的寨门」) over d/oldpine/epath1.c's knife marks and d/oldpine/keep1.c"],
			"entries": [
				{
					"id": "found",
					"final": true,
					"when": { "mark": "老松寨的小径" },
					"text": "你顺着松树上的刀痕，在崖上林径尽头的灌木后找到了一条小径，通往老松寨。"
				}
			]
		},
		{
			"id": "cloud.toll",
			"title": "买路钱",
			"region": "绮云镇",
			"sources": ["u/cloud/npc/gangster.c", "u/cloud/dragonhill/hummock.c"],
			"entries": [
				{
					"id": "asked",
					"when": { "heard": { "npc": "cloud.npc.gangster", "topic": "买路钱" } },
					"text": "你向卧龙岗的强盗问起买路钱。",
					"quote": { "npc": "cloud.npc.gangster", "topic": "买路钱" }
				},
				{
					"id": "paid",
					"when": { "mark": "强盗" },
					"text": "你交给卧龙岗的强盗十两金子，他收下钱，说今天做个善人，放你一条生路。"
				}
			]
		},
		{
			"id": "cloud.li_shishi",
			"title": "李师师",
			"region": "绮云镇",
			"sources": ["u/cloud/npc/girl.c"],
			"entries": [
				{
					"id": "asked",
					"when": { "heard": { "npc": "cloud.npc.girl", "topic": "学艺" } },
					"text": "你在怡红院二楼向李师师请教学艺。",
					"quote": { "npc": "cloud.npc.girl", "topic": "学艺" }
				},
				{
					"id": "keepsake",
					"final": true,
					"when": { "mark": "李师师" },
					"text": "你留给李师师一件信物，她说：能做相公的老师，真是三生有幸。"
				}
			]
		},
		{
			"id": "cloud.chess",
			"title": "弈者",
			"region": "绮云镇",
			"sources": ["u/cloud/npc/chess_player.c", "u/cloud/obj/npc/chess_player/chess.c"],
			"entries": [
				{
					"id": "played",
					"when": { "heard": { "npc": "cloud.npc.chess_player", "topic": "下棋" } },
					"text": "你在香茗坊二楼和弈者下了一盘棋。"
				},
				{
					"id": "chess",
					"final": true,
					"when": { "item": "es2:u/cloud/obj/npc/chess_player/chess" },
					"text": "你得到了弈者的棋子，一种较轻的暗器。"
				}
			]
		},
		{
			"id": "cloud.wangyou_grass",
			"title": "忘忧草",
			"region": "绮云镇",
			"sources": ["u/cloud/npc/b_header.c", "u/cloud/npc/obj/letter.c", "d/choyin/npc/crone.c", "d/choyin/npc/visitor.c", "d/choyin/w_street1.c", "d/choyin/lionroom.c", "d/choyin/npc/lion.c", "d/choyin/obj/grass.c", "d/city/npc/chen.c"],
			"entries": [
				{
					"id": "uncle",
					"when": { "heard": { "npc": "cloud.npc.b_header", "topic": "陈天星" } },
					"text": "你向振远镖局的陈剑秋问起陈天星。",
					"quote": { "npc": "cloud.npc.b_header", "topic": "陈天星" }
				},
				{
					"id": "lost",
					"when": { "heard": { "npc": "cloud.npc.b_header", "topic": "忘忧草" } },
					"text": "你向陈剑秋问起忘忧草。",
					"quote": { "npc": "cloud.npc.b_header", "topic": "忘忧草" }
				},
				{
					"id": "crone",
					"when": { "heard": { "npc": "choyin.npc.crone", "topic": "忘忧草" } },
					"text": "你向乔阴县城的乾瘪老太婆打听忘忧草。",
					"quote": { "npc": "choyin.npc.crone", "topic": "忘忧草" }
				},
				{
					"id": "visitor",
					"when": { "heard": { "npc": "choyin.npc.visitor", "topic": "忘忧草" } },
					"text": "你向乔阴县城的游客打听忘忧草。",
					"quote": { "npc": "choyin.npc.visitor", "topic": "忘忧草" }
				},
				{
					"id": "grass",
					"when": { "item": "es2:d/choyin/obj/grass" },
					"text": "护草神兽倒下后，你在神秘洞穴里得到一棵发着晶莹光芒的忘忧草。"
				},
				{
					"id": "letter",
					"final": true,
					"when": { "item": "es2:u/cloud/npc/obj/letter" },
					"text": "你把忘忧草交给陈剑秋，他大喜过望，提笔写好一封信交给你，嘱咐你路上小心，把信直接交给陈师叔。"
				},
				{
					"id": "chen",
					"when": { "heard": { "npc": "city.npc.chen", "topic": "拜师" } },
					"text": "你在京师振远总局向陈天星请教拜师。",
					"quote": { "npc": "city.npc.chen", "topic": "拜师" }
				}
			]
		},
		{
			"id": "latemoon.funlin",
			"title": "芳绫",
			"region": "晚月庄",
			"sources": ["d/latemoon/npc/yumay.c", "d/latemoon/npc/shaowei.c", "d/latemoon/bamboo4.c", "d/latemoon/obj/bamboo.c", "d/latemoon/obj/dragonfly.c", "d/latemoon/npc/funlin.c", "d/latemoon/latemoon2.c", "d/latemoon/obj/bracelet.c"],
			"entries": [
				{
					"id": "heard_funlin",
					"when": { "heard": { "npc": "latemoon.npc.yumay", "topic": "芳绫" } },
					"text": "你向傍厅的蓝雨梅问起芳绫。",
					"quote": { "npc": "latemoon.npc.yumay", "topic": "芳绫" }
				},
				{
					"id": "heard_dragonfly",
					"when": { "heard": { "npc": "latemoon.npc.shaowei", "topic": "竹蜻蜓" } },
					"text": "你向蓝筱薇问起竹蜻蜓。",
					"quote": { "npc": "latemoon.npc.shaowei", "topic": "竹蜻蜓" }
				},
				{
					"id": "bamboo",
					"when": { "temp": "moon/竹子" },
					"text": "你把一根竹子交给蓝筱薇，她看了看说是根玉竹，便灵巧地削凿起来。"
				},
				{
					"id": "dragonfly",
					"when": { "item": "es2:d/latemoon/obj/dragonfly" },
					"text": "蓝筱薇把做好的竹蜻蜓递给了你。"
				},
				{
					"id": "gift",
					"when": { "temp": "moon/竹蜻蜓" },
					"text": "你把竹蜻蜓送给禁闭房里的芳绫，她开心地把玩，在你耳边小声说：『庄内前厅某处藏有一宝物手镯哦！』"
				},
				{
					"id": "bracelet",
					"final": true,
					"when": { "temp": "latemoon/手镯" },
					"text": "你从内厅的碧纱橱里取出一串玛瑙手镯。"
				}
			]
		},
		{
			"id": "latemoon.dances",
			"title": "晚月庄的舞步",
			"region": "晚月庄",
			"sources": ["d/latemoon/npc/yumay.c", "d/latemoon/npc/girl.c", "d/latemoon/latebook.c", "d/latemoon/latemoon8.c", "d/latemoon/miroom.c", "d/latemoon/obj/hankie.c", "d/latemoon/upstar/npc/shinfun.c", "d/latemoon/obj/book.c"],
			"entries": [
				{
					"id": "dance_out",
					"when": { "mark": "dance_out" },
					"text": "你记下了一曲舞步『西出阳关』。"
				},
				{
					"id": "dance_yu_fong",
					"when": { "mark": "dance_yu_fong" },
					"text": "你记下了一曲舞步『有凤来仪』。"
				},
				{
					"id": "hankie",
					"when": { "item": "es2:d/latemoon/obj/hankie" },
