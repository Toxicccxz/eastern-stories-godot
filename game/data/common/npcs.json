				{ "item": "native:waterfog/spy_letter", "giver_mark": "庾子建下狱", "accept": true, "mark_giver": "值守回了话", "lines": [{ "emote": "展开信看了一遍，半晌没有说话。" }, { "say": "字是七长老身边账房的笔迹。……颜长老在数人头：哪几派来，椅子空不空，阁里谁跟谁走得近——数到我头上来了。" }, { "say": "数人头不犯门规。可派人扮成外人上山，数到自己阁里来——这件事，我记下了。" }, { "say": "你守过一回山门了——从今日起，你是这一辈的大弟子。" }] },
				{ "item": "native:waterfog/spy_letter", "giver_mark": "私了了庾子建", "accept": true, "mark_giver": "值守回了话", "lines": [{ "emote": "展开信看了一遍，半晌没有说话。" }, { "say": "字是七长老身边账房的笔迹。……颜长老在数人头：哪几派来，椅子空不空，阁里谁跟谁走得近——数到我头上来了。" }, { "say": "数人头不犯门规。可派人扮成外人上山，数到自己阁里来——这件事，我记下了。" }, { "say": "你守过一回山门了——从今日起，你是这一辈的大弟子。" }] },
				{ "item": "native:waterfog/spy_letter", "accept": true, "mark_giver": "值守回了话", "lines": [{ "emote": "展开信看了一遍，脸上的笑没了。" }, { "say": "纸是兵部的公文纸，裁去了抬头。他们想知道两件事：椅子空着没有，卫盟主还在不在。" }, { "say": "兵部的人扮成皮货商上水烟阁打听盟主——二十年来，这是头一回。有人在京师，替盟主的生死记着账。" }, { "say": "你守过一回山门了——从今日起，你是这一辈的大弟子。" }] },
				{ "item": "native:cloud/escort_note", "giver_mark": "镖单给了陈天星", "accept": false, "say": "镖单你已经给了陈总镖头。这一张存根，你自己留着。" },
				{ "item": "native:cloud/escort_note", "giver_mark": "镖单锁进了刑堂", "accept": false, "say": "刑堂里已经锁着一张了。" },
				{ "item": "native:cloud/escort_note", "giver_mark": "潘军禅说了镖单", "unless_giver_mark": "天邪的线断了", "ask": "把镖单交给潘军禅，锁进水烟阁的刑堂。\n振远的脸面保住了，这件事到此为止——陈天星不会再查。\n镖单只有一张。交给他吗？", "accept": true, "mark_giver": "镖单锁进了刑堂", "lines": [{ "emote": "接过镖单看了一遍，折好收进了袖里。" }, { "say": "锁进刑堂。振远的脸面，水烟阁替他们留着。" }, { "say": "陈剑秋那里，我派人去说一声。二十年了，他也该睡个好觉。" }] },
				{ "item": "native:cloud/escort_note", "accept": false, "say": "振远的东西，你自己收好。" }
			]
