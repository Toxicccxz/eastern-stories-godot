			"inquiry": {
				"竹书": {
					"listed_marks": ["柳淳风说过门房"],
					"rules": [
						{ "asker_marks": ["竹书给了柳淳风"], "say": "书在匣里。年轻时的糊涂话，留着给自己看。" },
						{ "asker_marks": ["竹书给了柳绘心"], "say": "书在绘心那里。……她读得比我当年明白。" },
						{ "asker_marks": ["柳淳风说了推法"], "say": "竹林道尽头那块大黄石，照我教你的法子推。书取出来，带回来。" },
						{ "asker_family": "family.fonxan", "asker_marks": ["柳淳风说过门房"], "asker_lacks": ["封山的线断了"], "mark_asker": "柳淳风说了推法", "lines": [{ "emote": "看着窗外的竹影，半晌才开口。" }, { "say": "二十岁那年，我在天驼关的竹林里住过一冬，悟出一点架剑的道理，写成一卷，起名《悟疾风劲竹书》，留在竹林尽头的石室里。" }, { "say": "石室的口子有一块大黄石堵着。硬推，没有几十年的内力推不动——我当年也推不动。" }, { "say": "那块石头不是那样推的。贴着它左下角那道青苔印，肩抵住，脚蹬石根；等风过竹林、石头自己松那一下，再发力。竹子是这么弯的，石头也是这么开的。" }, { "say": "书只有那一本。你替我取出来。" }] },
						{ "say": "一卷旧书罢了。" }
					]
				},
				"本宗": {
					"listed_marks": ["内院撞见了"],
					"confirm": "跟柳淳风守本宗：封山的剑不外传。\n他亲传你「点」字诀，你是掌门传人；柳绘心会离开武馆，带着「北宗」两个字去绮云镇。封山在虹台上的那一票跟着柳淳风——等盟主回来。\n这是封山这条线的大分裂，选了不能改。要跟师父吗？",
					"confirm_marks": ["内院撞见了"],
					"confirm_lacks": ["跟了本宗", "跟了北宗", "封山的线断了"],
					"rules": [
						{ "asker_marks": ["跟了本宗"], "say": "本宗的规矩，从今往后是你我两个人守。" },
						{ "asker_marks": ["跟了北宗"], "say": "你选了。武馆的门不拦你——只是剑，我不能再教了。" },
						{ "asker_family": "family.fonxan", "asker_marks": ["内院撞见了"], "asker_lacks": ["封山的线断了"], "marks_asker": ["跟了本宗", "学了点字诀"], "lines": [{ "emote": "点了点头，像是早知道，又像是松了一口气。" }, { "say": "好。那从今日起，「点」字诀归你。" }, { "say": "平时使剑，内力聚在手臂上；「点」字诀把劲力聚在剑尖，以意使剑。刺出去的那一下，比你现在重得多——内力不够的时候别使，剑会脱手。" }, { "emote": "拔出玄苏剑，剑尖在你面前的青砖上轻轻一点。砖没有裂，砖下的土陷下去一个指头深的坑。" }, { "say": "封山这一辈，掌门的剑往后传给你。" }, { "say": "绘心……她要走，我不拦。" }] },
						{ "say": "封山剑派只有一宗。" }
					]
				},
				"点字诀": {
					"listed_marks": ["内院撞见了"],
					"rules": [
						{ "asker_marks": ["跟了本宗"], "say": "劲在剑尖，意在剑先。内力不够的时候别使。" },
						{ "asker_marks": ["跟了北宗"], "say": "绘心自己悟的那一路，劲发得早了半分。你替我告诉她——不，不必说是我说的。" },
						{ "say": "「点」字诀是掌门一脉单传的。" }
					]
				},
				"武馆的事": {
					"rules": [
						{ "asker_marks": ["守馆办完了"], "say": "镇上清净了。门户的名头不是谁都能借的——这一回，是你替武馆拿回来的。" },
						{ "asker_marks": ["柳淳风说了冒牌"], "say": "镇西官道上那几个人，你去会一会。先看清他们凭的是什么，再动手。" },
						{ "asker_family": "family.fonxan", "asker_lacks": ["封山的线断了"], "mark_asker": "柳淳风说了冒牌", "lines": [{ "emote": "放下手里的茶，看了你一眼。" }, { "say": "既入了门，武馆的事你也该担一件。" }, { "say": "这几日有来投师的人说，在镇西的青石官道上交过「拜师钱」——十两银子，收钱的自称封山弟子。淳风武馆收徒，从来不收这个钱。" }, { "say": "我不便去。掌门出手打几个骗子，传出去是笑话。你是新面孔，他们不认得你——去看看他们凭的是什么。" }] },
						{ "say": "武馆自家的事，不劳外人费心。" }
					]
				},
				"腰牌": {
					"rules": [
						{ "asker_marks": ["守馆办完了"], "say": "牌我收着。逄师弟什么时候自己来取，什么时候还他。" },
						{ "asker_carries": "fonxan tally", "asker_marks": ["逄义认了腰牌"], "say": "他认了就好。牌给我吧。" },
						{ "asker_marks": ["逄义认了腰牌"], "mark_asker": "守馆办完了", "lines": [{ "say": "牌没带回来？……丢了也好，省得再有人拿它骗人。" }, { "say": "门户的名头，不是谁都能借的。这件事你办得干净——从今日起，你是这一辈的大弟子。" }, { "say": "还有一件事，李教头会同你说。" }] },
						{ "asker_carries": "fonxan tally", "lines": [{ "emote": "接过腰牌翻过来，看见背面那个字，半晌没有说话。" }, { "say": "逄……是逄义师弟的牌。同辈里他的剑不比我差，只是好赌。" }, { "say": "牌是真的，人是假的——那就是牌从他手里流出去了。他这些年多半泡在绮云镇的赌场里。" }, { "say": "你去问他一句：牌是怎么到外人手里的。问明白了，再把牌带回来。" }, { "emote": "把腰牌递还给你。" }] },
						{ "say": "封山弟子人人有一块腰牌，正面一座山，背面是自己的姓。你的那块，等你的剑入了门再说。" }
					]
				},
				"逄义": {
					"rules": [
						{ "asker_marks": ["逄义认了腰牌"], "say": "他肯认，就还是封山的人。" },
						{ "say": "逄师弟与我同辈，剑上的天分不在我之下。……好赌，多年不回武馆了。" }
					]
				},
				"淳风武馆": ["淳风武馆是先父所创，在下辱承其名，虽忝掌封山门户，不敢忘了先人遗志。"],
				"先人遗志": ["先父临终之时将这武馆交到在下手中，需得好好照看。"],
				"刘安禄": ["刘兄弟在寒舍管事已经五年了，过去之事不须再提。"],
				"name": ["你既然知道我是柳馆主，怎麽不知道我是柳淳风？"],
				"here": ["这里便是淳风武馆。"],
				"隘口": ["听说大内的人在黄石隘口挖出了东西，又被人抢了去。抢东西的若是往老松岭去了，多半是投老松寨。"],
				"老松寨": ["老松寨的常老大，人称泼风刀王，什么钱都收。要过他的寨门，带够银子；有本事的，就在寨门外叫阵——硬闯的人，没几个回来。"],
				"黑衣道士": ["黑冠黑衣的道士？这一带没有道观。你若在老松岭遇上，小心些，那种人下手没有分寸。"],
				"荐信": {
					"rules": [
						{ "asker_marks": ["柳淳风认了荐信"], "say": "老岑的信，你留着。末一行我不认得——他说过他在山里见过一座城，我只当是饿昏了的话。" },
						{ "asker_marks": ["拿回了荐信"], "mark_asker": "柳淳风认了荐信", "lines": [{ "emote": "接过信，看了很久，又折好还给你。" }, { "say": "老岑……二十多年前我在山里迷了路，三天没吃东西，是个砍柴的老人领我下的山。他不识几个字——这封信，他写了多久啊。" }, { "say": "他托你来，武馆的门你随时进。拜不拜师，你自己定。" }, { "say": "末一行我不认得。他说过他在山里见过一座城，铃声满耳……我只当是饿昏了的话。你收好。" }] },
						{ "say": "什么信？" }
					]
				},
				"水烟阁": {
					"rules": [
						{ "asker_marks": ["柳淳风的引荐信"], "asker_lacks": ["潘军禅说了鱼饵"], "asker_not_carries": "pan letter", "gives": "native:snow/letter_to_pan", "lines": [{ "emote": "看了你一眼。" }, { "say": "信没了？……罢了，我再写一封。" }, { "emote": "提笔又写了一封信，封好了交给你。" }, { "say": "这回收好。潘军禅认信不认人。" }] },
						{ "asker_marks": ["柳淳风的引荐信"], "say": "信已经给你了。去水烟阁找潘军禅，他是我的结拜义弟，见信如见我。" },
						{ "asker_marks": ["查明伪墓", "杀了黑衣道士"], "gives": "native:snow/letter_to_pan", "mark_asker": "柳淳风的引荐信", "lines": [{ "emote": "听你说完山洞里的事，沉默了半晌。" }, { "say": "洞里那个道士，是你杀的？……头一回手上沾血，夜里睡得着就好。睡不着，来武馆找我，我陪你坐一坐。" }, { "say": "二十年前，振远镖局押一趟镖过老松岭，镖师随从一个都没回来。镖局丢了脸，陈剑秋到今天都不肯提。" }, { "say": "那具骸骨若真是水烟阁的人，这事就该问水烟阁。我写一封信，你拿去给执法使潘军禅，他是我的结拜义弟。" }, { "emote": "提笔写了一封信，封好了交给你。" }, { "say": "先去绮云镇问问陈剑秋，把镖单要来。上了山，别带着兵刃进阁。" }, { "say": "还有一件：前夜老松岭上起了火，山下都看得见——是老松寨。那道士的同伙回来了，挨个问寨里的人：匣子在谁手里。夜里睡觉，把门闩上。" }] },
						{ "asker_marks": ["查明伪墓"], "gives": "native:snow/letter_to_pan", "mark_asker": "柳淳风的引荐信", "lines": [{ "emote": "听你说完山洞里的事，沉默了半晌。" }, { "say": "二十年前，振远镖局押一趟镖过老松岭，镖师随从一个都没回来。镖局丢了脸，陈剑秋到今天都不肯提。" }, { "say": "那具骸骨若真是水烟阁的人，这事就该问水烟阁。我写一封信，你拿去给执法使潘军禅，他是我的结拜义弟。" }, { "emote": "提笔写了一封信，封好了交给你。" }, { "say": "先去绮云镇问问陈剑秋，把镖单要来。上了山，别带着兵刃进阁。" }, { "say": "还有一件：前夜老松岭上起了火，山下都看得见——是老松寨。那道士的同伙回来了，挨个问寨里的人：匣子在谁手里。夜里睡觉，把门闩上。" }] },
						{ "say": "水烟阁在青石官道西头的山上，武者同盟的总坛。" }
					]
				}
			},
