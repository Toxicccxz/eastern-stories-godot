				{ "item": "native:snow/fonxan_tally", "giver_mark": "逄义认了腰牌", "accept": true, "mark_giver": "守馆办完了", "lines": [{ "emote": "把腰牌收进袖里。" }, { "say": "牌我替他收着。他什么时候戒了赌，什么时候自己来取。" }, { "say": "门户的名头，不是谁都能借的。这件事你办得干净——从今日起，你是这一辈的大弟子。" }, { "say": "还有一件事，李教头会同你说。" }] },
				{ "item": "native:snow/fonxan_tally", "accept": false, "say": "牌是逄师弟的。你先去绮云镇问他一句，牌是怎么到外人手里的。" }
			],
			"calls": [
				{ "after": 1, "reaction": true, "mark": "跟了北宗", "not_mark": "柳淳风说过分宗", "steps": [{ "say": "你跟了她。……也好。她一个人，我不放心。" }, { "say": "武馆的门不拦你。剑，我不能再教了——规矩是规矩。" }, { "mark": "柳淳风说过分宗" }] },
				{ "after": 1, "reaction": true, "mark": "说破了刘安禄", "not_mark": "柳淳风说过门房", "steps": [{ "say": "刘兄弟的事，李教头回过我了。规矩是先父立的，我不能为他破。" }, { "say": "五年前我留他，是我的事；今天你说破，是你的事。都没有错。" }, { "say": "……说到规矩。我年轻时在天驼关的竹林里留过一卷书，写的也是这两个字。改日同你说。" }, { "mark": "柳淳风说过门房" }] },
				{ "after": 1, "reaction": true, "mark": "替刘安禄瞒了", "not_mark": "柳淳风说过门房", "steps": [{ "say": "李教头说，那伙人认错了人。" }, { "emote": "看了你很久。" }, { "say": "刘兄弟的来历，五年前我就知道。你替他担了这句话——往后，也替武馆担着。" }, { "say": "……说到规矩。我年轻时在天驼关的竹林里留过一卷书，写的也是这两个字。改日同你说。" }, { "mark": "柳淳风说过门房" }] }
			],
