			},
			"outdoors": true
		},
		{
			"id": "es2:d/chuenyu/sunnyroad",
			"short": "山脚乡田",
			"long": "你的两侧是茂盛的稻田，还有一条清澈见底的小溪。许多乡民在田里\n辛苦的忙碌着。再北面是黑松山。眺望山顶，你似乎可以看到一个颇具规\n模的城堡。城堡的最顶端插着一面大旗，大旗上绣着两个斗大的金字：淳于。\n",
			"exits": {
				"north": "es2:d/chuenyu/base_b_m",
				"southwest": "es2:d/chuenyu/croad2"
			},
			"no_fight": true,
			"no_magic": true,
			"outdoors": true
		},
		{
			"id": "es2:d/chuenyu/base_b_m",
			"short": "黑松山脚",
			"long": "一座高而险的山峰耸立在你面前。北面是一条上山的羊肠小路，盘旋曲折。\n黑湮湮的松林给你不祥的感觉。\n",
			"exits": {
				"south": "es2:d/chuenyu/sunnyroad",
