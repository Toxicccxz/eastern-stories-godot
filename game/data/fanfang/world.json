	"doors": [],
	"landmarks": [
		{ "id": "fanfang.cliff_top.landmark.shrine", "zone": "fanfang.cliff_top", "name": "海神龛", "policy": "look", "long": "一座齐腰高的石龛，石头让海风蚀出了一个个小洞。龛里供的不是神像，是一块磨得溜圆的黑石头。石前摆着贝壳、一枚铜钱、半块干饼——都是出海的人放的。龛边刻着两个字：「平安」，字口里长了青苔。\n", "legacy_source": "native: 番坊 A (剧情总纲 §6 番坊卡; 计划 build/plans/番坊_计划.md §1 海崖道「海神小龛」; DECISIONS「番坊 A」) — 续写" },
		{ "id": "fanfang.cliff_path.landmark.sea", "zone": "fanfang.cliff_path", "name": "海", "policy": "look", "long": "海是灰蓝的，近处发绿，远处发黑，一直铺到天边，看不见对岸。海上一条船也没有——番坊的船都拴在码头上。浪一排一排地过来，在崖脚撞碎，退下去，又来。\n", "legacy_source": "native: 番坊 A (剧情总纲 §6 番坊卡「世界从此有海」; DECISIONS「番坊 A」) — 续写" },
		{ "id": "fanfang.dock.landmark.boats", "zone": "fanfang.dock", "name": "平底船", "policy": "look", "long": "三条平底船，船底平，船头方，帆是竹篾一片一片编的。船身刷的桐油黑得发亮，船头画着一只眼睛。船工说，船不是番坊的，是南边来的商人的；番坊人只管装卸、守船，拿一份工钱。\n", "legacy_source": "native: 番坊 A (doc/help/theme:4「航海技术并不受重视」— the port is small and the ships are others'; 剧情总纲 §6 番坊卡; DECISIONS「番坊 A」) — 续写" },
		{ "id": "fanfang.bazaar_north.landmark.shields", "zone": "fanfang.bazaar_north", "name": "大盾", "policy": "look", "long": "两面大盾，比人还高一头，长方的，盾面弯成半个筒。木胎外头蒙着牛皮，边上包着铁，铆钉一圈一圈。盾面上漆着一只展翅的鹰，金漆掉了一半，露出底下的红。盾脚插在土里，插得很深，像是从来没拔出来过。\n", "legacy_source": "native: 番坊 A (剧情总纲 §6 番坊卡「大秦剑会『铁盾会』」, 计划 §1「两面大盾」; DECISIONS「番坊 A」) — 续写" },
		{ "id": "fanfang.office.landmark.notice", "zone": "fanfang.office", "name": "布告", "policy": "look", "long": "墙上贴着一张布告，纸是京师的纸，字是抄的：\n布告上写著：辑拿要犯----於兰天武。\n布告的一角盖着市舶司的小印，旁边一行小字：「京师东二门原告，番坊照抄」。\n", "legacy_source": "d/city/eastdoor2.c (look_notice, word for word) — a copy hung in the 市舶司 (剧情总纲 §3 第七章「京师东二门通缉布告可作市舶吏的由头」; DECISIONS「番坊 A」)" },
		{ "id": "fanfang.fire_hall.landmark.fire", "zone": "fanfang.fire_hall", "name": "火坛", "policy": "look", "long": "一座黑石砌的火坛，齐胸高，石头让三百年的烟熏得乌黑发亮。坛顶一团火，不高不低，不红不白，烧得很静，看不见柴，也看不见油。火前的石头上磨出一块白印子，是一代一代跪出来的。坛身上刻着一行弯弯曲曲的字，没有人认得；祭司说那是祠规——火前不说谎。\n", "legacy_source": "native: 番坊 B (剧情总纲 §3 第七章「拜火祠的火三百年没灭」「祠规火前不说谎」, §6 番坊卡; 计划 build/plans/番坊_计划.md §1 拜火祠; DECISIONS「番坊 B」) — 续写" },
		{ "id": "fanfang.hall.landmark.tablet", "zone": "fanfang.hall", "name": "木牌", "policy": "look", "long": "一块巴掌大的木牌钉在墙上，木头发黑，上面刻着一行弯弯曲曲的字——大秦人自己的字。安敦说，那是剑会的第一条规矩，三百年前第一代会首刻的：盾在前，剑在后。盾不倒，人不倒。\n", "legacy_source": "native: 番坊 B (计划 build/plans/番坊_计划.md §1 铁盾会「会首的屋」; DECISIONS「番坊 B」) — 续写" },
		{ "id": "fanfang.temple_yard.landmark.banyan", "zone": "fanfang.temple_yard", "name": "榕树", "policy": "look", "long": "一棵大榕树，树冠罩住了半个院子。气根从枝上一根根垂下来，细的像绳，粗的已经扎进地里成了树干，一棵树看着像一片林子。树下的地让人坐得光溜溜的。天竺僧说，这树是第一代僧人从天竺带来的一根枝条，插在这儿，活了。\n", "legacy_source": "native: 番坊 B (计划 build/plans/番坊_计划.md §1 日陀罗寺「榕树」; DECISIONS「番坊 B」) — 续写" },
		{ "id": "fanfang.shrine.landmark.buddha", "zone": "fanfang.shrine", "name": "佛像", "policy": "look", "long": "一尊天竺样子的佛像：高鼻、细眼、卷发，嘴角带一点笑，衣褶一道一道贴在身上，像是湿的。像是石头雕的，上过金，金掉了大半，露出底下的灰石。佛前几盏酥油灯，灯火一跳一跳，佛的脸也跟着一明一暗。\n", "legacy_source": "native: 番坊 B (daemon/class/lama/master.c 龙若法王 (lama) — a 天竺 temple; 计划 build/plans/番坊_计划.md §1 日陀罗寺「佛殿」; DECISIONS「番坊 B」) — 续写" },
		{ "id": "fanfang.gate_yard.landmark.rule", "zone": "fanfang.gate_yard", "name": "门规木牌", "policy": "look", "long": "一块白木牌，立在墙根，墨写着一行字：「一击之内定生死」。字写得又瘦又硬，像刀刻的。牌子底下的土让人跪过，陷下去两个坑。\n", "legacy_source": "native: 番坊 C (剧情总纲 §3 第七章 ④⑤, §6 番坊卡「鬼笠馆」; 计划 build/plans/番坊_计划.md §0「争地」「读铜牒与钩子」 §3, owner 2026-11-04 Q3 站浪人代价重; DECISIONS「番坊 C」) — 续写" }
	],
	"services": [
		{ "id": "fanfang.bazaar_west.coach", "kind": "coach", "zone": "fanfang.bazaar_west", "name": "车马行", "reach": 96, "arrival": "fanfang.bazaar_west.coach_arrival", "legacy_source": "native: 车马行 (DECISIONS「车马行」)" },
		{
			"id": "fanfang.office.papers",
			"kind": "act",
			"zone": "fanfang.office",
			"name": "兵部文书",
			"reach": 96,
			"legacy_source": "native: 番坊 A (剧情总纲 §3 第七章 ④「市舶吏奉兵部令要清走大秦人」; 计划 build/plans/番坊_计划.md §0「印色暗红发黑——第六章学过印色的人一眼看得出」; DECISIONS「关北 A」 学过印色, DECISIONS「番坊 A」) — 续写",
			"act": {
				"verb": "看",
				"acts": [
					{
						"mark": "学过印色",
						"steps": [
							{ "line": "书案上压着一纸兵部文书，字写得端端正正：\n" },
							{ "line": "「番坊大秦人等，聚众持械，着市舶司即日清出，不得延误。——兵部」\n", "color": "HIW" },
							{ "line": "底下兵部的印旁边，还压着一方「镇国大将军」印，印色暗红发黑。你见过这个颜色：逆灵宫那叠文书上的印就是这样。印模上的真印是正红的，泛黄光。\n" },
							{ "line": "这一纸文书的印是假的。\n", "color": "HIY" },
							{ "mark": "看过清人文书" },
							{ "mark": "看出文书是假的" }
						]
					},
					{
						"steps": [
							{ "line": "书案上压着一纸兵部文书，字写得端端正正：\n" },
							{ "line": "「番坊大秦人等，聚众持械，着市舶司即日清出，不得延误。——兵部」\n", "color": "HIW" },
							{ "line": "底下兵部的大印旁边，还压着一方「镇国大将军」印，印色暗红。冯禄说这是京师来的令，谁也不敢不认。落款的日子，是关北工地出事后的第三天。\n" },
							{ "mark": "看过清人文书" }
						]
					}
				]
			}
		},
		{
			"id": "fanfang.fire_hall.questions",
			"kind": "act",
			"zone": "fanfang.fire_hall",
			"name": "火前问话",
			"reach": 96,
			"legacy_source": "native: 番坊 B (剧情总纲 §3 第七章 ③「祠规火前不说谎」; 计划 build/plans/番坊_计划.md §0「拜火祠的问话」 §4 questions, owner 2026-11-04 Q2: 问玩家自己做过的三件事; DECISIONS「番坊 B」「火前问话」) — 续写",
			"act": {
				"verb": "问话",
				"acts": [
					{
						"phase": ["night", "midnight"],
						"steps": [
							{ "line": "火坛前没有人。穆护的净室里亮着灯，门关着。\n" }
						]
					},
					{
						"present": "native.npc.fire_priest",
						"temp": "火不肯",
						"phase": ["dawn"],
						"steps": [
							{ "by": "native.npc.fire_priest" },
							{ "say": "天刚亮，火还没静。今天火不肯——明天再来。" }
						]
					},
					{
						"present": "native.npc.fire_priest",
						"temp": "火不肯",
						"ask": "火今天不肯。要在祠里等到明天黎明，再问一次吗？（世界的时间会过去，别的地方照旧过它们的日子。）",
						"choice": "等到明天",
						"steps": [
							{ "by": "native.npc.fire_priest" },
							{ "say": "等。火自己会静。" },
							{ "until_phase": ["dawn"] },
							{ "clear_temp": "火不肯" },
							{ "line": "天亮了。坛顶的火又矮了下去，不红不白，烧得很静。\n" },
							{ "say": "火静了。——再来一次。" }
						]
					},
					{
						"present": "native.npc.fire_priest",
						"mark": "铜牒到手",
						"steps": [
							{ "by": "native.npc.fire_priest" },
							{ "say": "牒在你手里了。火前没有你的事了。" }
						]
					},
					{
						"present": "native.npc.fire_priest",
						"mark": "站了大秦人",
						"steps": [
							{ "by": "native.npc.fire_priest" },
							{ "emote": "走到火坛前，掌心向火。" },
							{ "say": "三句。我问，你答。火听着。" },
							{
								"questions": [
									{
										"text": "在水烟阁，南危水装死二十年的事——你替他守了口，还是告了？",
										"answers": [
											{ "text": "守了口。", "mark": "替南危水保密" },
											{ "text": "告了。", "mark": "告发了南危水" }
										]
									},
									{
										"text": "在关北，兵部的工地——你借了王府的兵踏平了它，还是夜里潜进去救了一半？",
										"answers": [
											{ "text": "踏平了。", "mark": "踏平了工地" },
											{ "text": "夜里救了一半。", "mark": "救了一半" }
										]
									},
									{
										"text": "晚月庄的宝衣——你带走了，留给守衣的人守着，还是给了别人？",
										"answers": [
