	"landmarks": [
		{ "id": "city.northdoor.landmark.sign", "zone": "city.northdoor", "name": "告示", "policy": "look", "long": "告示上隐约写著几个人名，但都模糊不可分辨了。\n", "legacy_source": "d/city/northdoor.c" },
		{ "id": "city.eastdoor1.landmark.notice", "zone": "city.eastdoor1", "name": "布告", "policy": "look", "long": "布告经风吹日晒，字迹已经不可分辨了。\n", "legacy_source": "d/city/eastdoor1.c" },
		{ "id": "city.eastdoor2.landmark.notice", "zone": "city.eastdoor2", "name": "布告", "policy": "look", "long": "布告上写著：辑拿要犯----於兰天武。\n", "legacy_source": "d/city/eastdoor2.c" },
		{ "id": "city.westdoor1.landmark.notice", "zone": "city.westdoor1", "name": "布告", "policy": "look", "long": "布告上写著：近来有土匪出没，望行人小心。\n", "legacy_source": "d/city/westdoor1.c" },
		{ "id": "city.westdoor2.landmark.notice", "zone": "city.westdoor2", "name": "布告", "policy": "look", "long": "布告上写著：行人出入需缴纳一两黄金。\n", "legacy_source": "d/city/westdoor2.c" },
		{ "id": "city.southdoor.landmark.notice", "zone": "city.southdoor", "name": "告示", "policy": "look", "long": "告示上写著：今年文武大选。\n", "legacy_source": "d/city/southdoor.c" },
		{ "id": "city.bank.landmark.sign", "zone": "city.bank", "name": "牌子", "policy": "look", "long": "我们提供的服务有：\nconvert     兑换钱币，自点数目，出门后发现少钱概不负责。\n", "legacy_source": "d/city/bank.c" },
		{ "id": "city.boots.landmark.sign", "zone": "city.boots", "name": "招牌", "policy": "look", "long": "专卖各式鞋。\n", "legacy_source": "d/city/boots.c" },
		{ "id": "city.cloth.landmark.sign", "zone": "city.cloth", "name": "招牌", "policy": "look", "long": "匾上三个大字：闯名堂\n", "legacy_source": "d/city/cloth.c" },
		{ "id": "city.weapon.landmark.sign", "zone": "city.weapon", "name": "招牌", "policy": "look", "long": "招牌写著：京师武器店专营各式武器。\n", "legacy_source": "d/city/weapon.c" },
		{ "id": "city.street3.landmark.wall", "zone": "city.street3", "name": "院墙", "action": "爬上去", "portals": ["city.street3.climb"], "long": "一段高高的院墙，但对轻功好的人爬上(climb)似非难事。\n", "legacy_source": "d/city/street3.c" },
		{ "id": "city.jitan.landmark.altar", "zone": "city.jitan", "name": "祭坛", "policy": "look", "long": "园祭坛的栏杆是用汉白玉作成的，坛面由精细磨过的花岗岩铺成，中\n间有个台子(platform)。\n", "legacy_source": "d/city/jitan.c" },
		{ "id": "city.jitan.landmark.platform", "zone": "city.jitan", "name": "台子", "policy": "look", "long": "只有皇帝能站在这个汉白玉台子上面，隐约地你好象看到台子的下面\n有个凸起(sth)。\n", "legacy_source": "d/city/jitan.c" },
		{
			"id": "city.jitan.landmark.button", "zone": "city.jitan", "name": "凸起", "action": "按下", "policy": "dial",
			"portals": ["city.jitan.down", "city.midao1.up"], "open_seconds": 3,
			"turns": [
				{ "action": "顺时针转", "count": "forward", "line": "你将按钮沿顺时针转了一圈，什么事情也没发生。" },
				{ "action": "逆时针转", "count": "backward", "line": "你将按钮沿逆时针转了一圈，什么事情也没发生。\n你忽然打了个冷颤，可能是心里害怕了。" }
			],
			"combination": { "forward": 1, "backward": 3 },
			"long": "这很象一个按钮(button)，上面长着细细的青苔，你突然一阵莫名其\n妙的紧张，好奇心却驱使你摸摸这个按钮，你发现它可以按(press)，\n也可以旋转(turn)。\n",
			"messages": {
				"open": "地板忽然发出轧轧的声音，一块地面缓缓移动著，露出一个向下的阶梯。",
				"close": "地板忽然发出轧轧的声音，一块地面缓缓移动著，将向下的通道盖住了。",
				"open_below": "天花板忽然发出轧轧的声音，露出一个向上的阶梯。",
				"close_below": "天花板忽然发出轧轧的声音，向上的阶梯又缓缓地收了回去。"
			},
			"legacy_source": "d/city/jitan.c"
		},
		{ "id": "city.midao1.landmark.ceiling", "zone": "city.midao1", "name": "天花板", "action": "推开", "policy": "dial_below", "opens": "city.jitan.landmark.button", "long": "天花板上有一块石板，似乎可以推开。\n", "legacy_source": "d/city/midao1.c" },
		{ "id": "city.shangshu.kefang.landmark.book", "zone": "city.shangshu.kefang", "name": "书", "policy": "look", "long": "一本诗词集，上面圈圈点点了一些句子.\n", "legacy_source": "d/city/shangshu/kefang.c" }
	],
