		{ "id": "city.wumen.wait", "kind": "act", "zone": "city.wumen", "name": "午门", "reach": 120, "legacy_source": "native: 第九章 A (剧情总纲 §3 第九章 入口, §6 皇城卡; 计划 build/plans/第九章_计划.md A 包, owner 2026-11-06「按你的推荐来」; DECISIONS「第九章 A」) — waiting at the 午门 till dawn: the 武状元 for his 殿试 (葛升's 午门候旨), the 相国's man for the 早朝; the clock put forward as the 篝火's 等到天黑 (DECISIONS「关北 C」); 续写", "act": {"verb": "候旨", "acts": [{"mark": "宫门放行", "steps": [{"line": "铁门开着。守门的禁军认得你，侧身让开了。\n"}]}, {"mark": "葛升说了殿试", "not_mark": "殿试过", "ask": "在午门外候到天亮殿试。等的工夫里，世上的事照样走：别处的人该走的走、该好的好。", "choice": "候到天亮", "steps": [{"line": "你在午门外的石狮子旁边站定。守门的禁军看了你一眼，没有赶你。\n"}, {"until_phase": ["dawn"]}, {"line": "东方的天空中开始出现一丝微曦。午门外渐渐有了人：坐轿的、骑马的、走路的官，一个个在铁门外排好了班。\n"}, {"line": "铁门「轧轧」地开了。一个太监站在门里尖着嗓子喊：「宣——武状元觐见！」\n", "color": "HIY"}, {"mark": "宫门放行"}, {"mark": "候了殿试"}]}, {"mark": "相国写了奏本", "not_mark": "早朝过", "ask": "在午门外候到天亮，随相国上早朝。等的工夫里，世上的事照样走：别处的人该走的走、该好的好。", "choice": "候到天亮", "steps": [{"line": "你在午门外的石狮子旁边站定。夜里风凉，守门的禁军换了一班。\n"}, {"until_phase": ["dawn"]}, {"line": "天蒙蒙亮，一顶旧轿子停在午门外，韦相国下了轿，朝你点了点头：「跟着我，别说话。」\n"}, {"line": "铁门「轧轧」地开了。百官鱼贯而入，你跟在相国身后。\n", "color": "HIY"}, {"mark": "宫门放行"}, {"mark": "随相国上朝"}]}, {"steps": [{"line": "午门的铁门关着。守门的禁军说道：宫门重地，闲人止步。要进去，要么是皇上宣的，要么是跟着上朝的官。\n"}]}]} },
		{ "id": "city.xiangguo_gate.knock", "kind": "act", "zone": "city.xiangguo_gate", "name": "相国府大门", "reach": 96, "legacy_source": "native: 第九章 A (剧情总纲 §3 第九章 入口, §6 皇城卡; 计划 build/plans/第九章_计划.md A 包, owner 2026-11-06「按你的推荐来」; DECISIONS「第九章 A」) — d/city/xiangguo/gate.c's gate opened to one who brings 骆云舟's card, as the 王府's (DECISIONS「关北 B」); 续写", "act": {"verb": "叩门", "acts": [{"mark": "相国府开了门", "steps": [{"line": "大门虚掩着。老仆在院里扫地，看见你点了点头。\n"}]}, {"carries": "名帖", "steps": [{"line": "你叩了叩门。一个老仆开了半扇门，接过名帖看了看，又看了看你。\n"}, {"line": "老仆说道：骆家的人。相国在正厅，请。\n"}, {"line": "门开了。\n"}, {"mark": "相国府开了门"}]}, {"steps": [{"line": "你叩了叩门。半天，一个老仆隔着门说：相国不见生客。有名帖么？\n"}]}]} }
