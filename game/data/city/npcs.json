						{ "asker_marks": ["振远旧账到此为止"], "say": "剑秋说了到此为止。……生意上的事，好说。" },
						{ "asker_marks": ["陈剑秋说了抚恤银"], "asker_lacks": ["镖路查清了", "入了虹台的席"], "marks_asker": ["振远旧账查到底", "镖路查清了", "振远的票随了查到底"], "lines": [{ "emote": "把总账合上，用一块蓝布包了。" }, { "say": "好。查到底。" }, { "say": "底账我也一并翻了：那趟镖改走老松岭，是兵部来人点名要的。改路的是兵部，给钱的也是兵部——这是封口钱。" }, { "say": "账本我叫人押去乔阴县衙，交程知县。振远告兵部，也告振远自己。" }, { "say": "剑秋那里……他会恨我。由他。" }] },
