		{
			"id": "city.npc.microsof",
			"legacy_source": "d/city/npc/microsof.c",
			"name": "黑你没商量",
			"aliases": ["microsof"],
			"title": "钱庄老板",
			"gender": "男性",
			"age": 30,
			"long": "黑你没商量是个看起来相当精明的中年人，他的本名叫做“魏阮”。\n不知作了什么黑心的生意，一夜之间暴富起来，开了钱庄后，逐渐地\n把其它钱庄全挤倒闭了，京师的居民对他的很多做法都非常不满，于\n是有了这个绰号。大家都知道他小肚鸡肠，所以谁也不去惹他。\n",
			"attributes": { "str": 22, "cor": 25, "cps": 25, "int": 26, "per": 25, "con": 24, "spi": 25, "kar": 25 },
			"resources": {
				"max_atman": 1000,
				"atman": 1000,
				"max_force": 1000,
				"force": 1000,
				"max_mana": 1000,
				"mana": 1000
			},
			"combat_exp": 100000,
			"force_factor": 3,
			"attitude": "friendly",
			"skills": {
				"unarmed": 100,
				"parry": 100,
				"dodge": 100,
				"force": 100,
				"celestrike": 100,
				"celestial": 100,
				"fonxansword": 100,
				"six-chaos-sword": 100,
				"chaos-steps": 100,
				"spells": 100,
				"necromancy": 100
			},
			"skill_map": {
				"force": "celestial",
				"unarmed": "celestrike",
				"dodge": "chaos-steps",
				"sword": "fonxansword",
				"spells": "necromancy"
			},
			"carry": [
				{ "item": "es2:obj/longsword", "source": "obj/longsword.c", "equip": "wield" },
				{ "item": "es2:obj/cloth", "source": "obj/cloth.c", "equip": "wear" },
				{ "item": "es2:obj/money/gold", "source": "obj/money/gold.c", "amount": 10 }
			],
			"chat_chance": 15,
			"chat_msg": [
				{ "say": "黑你没商量压低嗓音对你说道：“我在上面可有人，你知道我每年给上面多少金子吗？”\n", "color": "CYN" },
				{ "say": "黑你没商量恨恨地说：“哼，我要把NT也汉化，看你之星怎么办！”\n", "color": "CYN" },
				{ "action": "exert", "function": "powerfade" }
			],
			"chat_chance_combat": 40,
			"chat_msg_combat": [
				{ "say": "黑你没商量突然三角眼倒立，眉间闪过几道黑气。\n", "color": "CYN" },
				{ "say": "黑你没商量的喉咙发出咕咕两声怪叫。\n", "color": "CYN" },
				{ "say": "黑你没商量神情忽然严肃了起来，不过好像是在想自己的事，与你无关。\n", "color": "CYN" },
				{ "say": "黑你没商量忽然呵呵呵地笑了起来，却不知道在笑些什么....\n", "color": "CYN" },
				{ "action": "perform", "skill": "sword", "function": "counterattack" },
				{ "action": "cast", "function": "drainerbolt" },
				{ "action": "cast", "function": "feeblebolt" },
				{ "action": "exert", "function": "powerup" },
				{ "action": "exert", "function": "recover" }
			],
			"greeting": {
				"one_of": [
					{ "line": "黑你没商量一翻三角眼，不知又想出了什么坏主意。\n" },
					{ "line": "黑你没商量说道：这位$RESPECT，换钱？我要抽点的啊！\n" },
					{ "line": "黑你没商量说道：这位$RESPECT，钱可要自己点清楚啊！\n" }
				]
			},
			"accept_fight": [
				{ "say": "咦... 要打就真打吧，光是较量多没意思？", "accept": true, "kill": true }
			]
		},
