					"listed_marks": ["林忌说了师弟"],
					"rules": [
						{ "asker_marks": ["茅山的线断了"], "say": "师兄的事……你不是茅山的人了，就别管了。" },
						{ "asker_marks": ["茅山烧了符箓"], "say": "师兄说得对，茅山宁可没有那本书。……也许吧。" },
						{ "asker_marks": ["花匠说了来历"], "say": "师兄还好？……他那只金眼睛，二十年前就是那样看人的。" },
						{ "asker_marks": ["林忌说了师弟"], "mark_asker": "花匠说了来历", "lines": [{ "emote": "手里的花剪停了。" }, { "say": "师兄让你来的？……他还记得我。" }, { "say": "老爷那年从北边回来，夜里喊「老松岭」，喊得满府的人睡不着。镇宅？我镇了二十年——镇的不是鬼，是他自己。" }, { "say": "清尘那孩子，是这府里唯一不怕她爹的人。我教她几道符，让她护得住自己。" }, { "say": "这两年，后头的小屋里来了北边道观的人。他们来了就烧东西——我从灰里、从门缝里，一页一页抄了下来，抄在那函书的空白处。" }, { "say": "府里还有一个不姓庾的，客厅里写字的那位。他的字比我的符好看。" }, { "say": "书该还给师兄了。你问我「符箓」。" }] }
					]
				},
				"符箓": {
					"listed_marks": ["花匠说了来历"],
					"rules": [
						{ "asker_marks": ["茅山的线断了"], "say": "师兄的事……你不是茅山的人了，就别管了。" },
						{ "asker_marks": ["茅山烧了符箓"], "say": "烧了。灰是青的。" },
						{ "asker_marks": ["林忌看了符箓"], "say": "书回了山。烧也好，留也好，是师兄的事了。" },
						{ "asker_marks": ["花匠交了符箓"], "asker_not_carries": "符箓", "gives": "native:temple/talisman_book", "lines": [{ "emote": "愣了一下，叹了口气，从花房里又捧出一函蓝布面的书。" }, { "say": "丢了？……抄的时候我留了一份底稿。拿去，这回别再丢了。" }] },
						{ "asker_marks": ["花匠交了符箓"], "say": "书在你那里。替我交给师兄。" },
						{ "asker_marks": ["花匠说了来历"], "mark_asker": "花匠交了符箓", "gives": "native:temple/talisman_book", "lines": [{ "emote": "从花房的瓦盆底下摸出一只油布包，一层一层打开。" }, { "say": "《上清符箓》。前半是茅山的符；后半……你自己看。" }, { "say": "他们烧掉的，都在这里。" }, { "say": "替我交给师兄。烧也好，留也好，是茅山的事。我这儿还有花要浇。" }] }
					]
				},
				"骆建章": {
					"listed_marks": ["骆云舟托了家书"],
					"rules": [
						{ "asker_marks": ["庾子建下狱"], "say": "骆先生？老爷下了狱，相国把他叫去了。那个人，在这府里十年，没说过一句多余的话。" },
						{ "say": "骆先生？客厅里写字的那位。老爷的信，十封有九封是他的笔。" }
					]
				},
				"庾清尘": {
					"rules": [
						{ "asker_marks": ["庾子建下狱"], "say": "老爷下了狱，小姐去了相国府。……我在这儿把花浇完，也该走了。" },
						{ "asker_marks": ["湖底一章"], "lines": [{ "say": "什么？清尘出事了？\n" }, { "emote": "放下花剪，四下看了看，压低了声音。" }, { "say": "……她撞见了不该见的。老爷把她关在内宅，帘子外头有人守着。你要是能见着她，替我问一声。" }] },
						{ "say": "什么？清尘出事了？\n" }
