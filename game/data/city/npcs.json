				{ "after": 1, "reaction": true, "mark": "镖单给了陈天星", "not_mark": "镖路查清了", "steps": [{ "emote": "从案上拿起一本发黄的底账，翻到夹着纸条的那一页。" }, { "say": "镖单的事，我查了。" }, { "say": "二十年前那趟镖，起运关北，本该走官道。底账上写着：改走老松岭——是兵部来人点名要的，说官道上有劫匪。" }, { "say": "关北来的盟主印，兵部点名改的路，老松岭瀑布前的埋伏。振远替人背了二十年的锅。" }, { "when": { "not": { "any": [{ "mark": "庾子建下狱" }, { "mark": "私了了庾子建" }, { "mark": "皇叔的通缉解了" }] } }, "say": "这件事，我陈天星可以当着满朝文武说。用得着的时候，来找我。" }, { "when": { "mark": "庾子建下狱" }, "say": "庾子建已经下了狱。这一笔，我写进状子里，叫他多背一条。" }, { "when": { "any": [{ "mark": "私了了庾子建" }, { "mark": "皇叔的通缉解了" }] }, "say": "朝上的事，你们已经定了，我不添乱。可振远的账，我要记清楚。" }, { "mark": "镖路查清了" }] },
				{ "after": 1, "reaction": true, "present": "native.npc.escort_runner", "when": { "all": [{ "mark": "接了振远的镖" }, { "any": [{ "mark": "劫镖的交了官" }, { "mark": "放走了劫镖的" }] }, { "not": { "mark": "镖交到了总局" } }, { "not": { "quest": "faction.zhenyuan#lapsed" } }] }, "steps": [{ "emote": "看见镖车进了门，放下手里的账本站了起来。" }, { "by": "native.npc.escort_runner" }, { "say": "总镖头，绮云的镖，两箱红货，一路没丢。" }, { "by": "city.npc.chen" }, { "when": { "mark": "劫镖的交了官" }, "say": "碎石小路上有人劫镖？……天驼关来人说了，人交了官。官府的赏金送到了振远，这一份归你。" }, { "when": { "mark": "劫镖的交了官" }, "give": "es2:obj/money/gold" }, { "when": { "mark": "放走了劫镖的" }, "say": "碎石小路上有人劫镖，你放他走了？……镖到了就好。人，你看着办的。" }, { "by": "native.npc.escort_runner" }, { "emote": "推着镖车进了后院。" }, { "leave": true }, { "by": "city.npc.chen" }, { "when": { "family": "family.zhenyuan" }, "say": "你是振远的人。从今天起，你是振远的镖头了。" }, { "emote": "铺开一张大红帖子，提笔写了几行，吹了吹墨，递给你。" }, { "give": "native:city/zhenyuan_card" }, { "when": { "not": { "mark": "皇城一章" } }, "say": "振远的名帖。京师有些门，要帖子才敲得开——相国府的俸银，年年是振远押的，韦相国认得这个字。" }, { "when": { "mark": "皇城一章" }, "say": "振远的名帖。京师的门，你都敲开过了。帖子留着——振远的朋友，到哪儿都是朋友。" }, { "mark": "有振远的名帖" }, { "mark": "镖交到了总局" }] },
				{ "after": 1, "reaction": true, "mark": "振远旧账到此为止", "not_mark": "陈天星烧了账本", "steps": [{ "emote": "看见你进门，把手边那本总账往怀里一收，又放下了。" }, { "say": "剑秋的信到了。" }, { "emote": "把总账丢进了脚边的火盆。" }, { "say": "到此为止。……往后你来，只谈生意。" }, { "mark": "陈天星烧了账本" }] }
			],
			"accept_object": [
				{ "item": "es2:u/cloud/npc/obj/letter", "item_master": true, "ask": "陈天星收下陈剑秋的推荐信，就愿意收你为徒，你再向他拜师，便成为振远镖局的弟子。信交出去就要不回来了。\n确定把信交给陈天星吗？", "say": "果然是剑秋侄儿推荐来的。我收你啦。", "accept": true, "recruit": true },
				{ "item": "es2:u/cloud/npc/obj/letter", "line": "陈天星狐疑地望着你，说\n这是你的嘛？\n", "accept": false },
				{ "item": "native:city/he_letter", "giver_mark": "镖路查清了", "accept": true, "mark_giver": "家信给了陈天星", "lines": [{ "emote": "接过信，看了很久。" }, { "say": "兵部的人在岭上等着，镖头说照走……底账上那一笔，信里也有。" }, { "say": "贺长庚的儿子。他该恨振远。" }] },
				{ "item": "native:city/he_letter", "accept": true, "marks_giver": ["家信给了陈天星", "镖路查清了"], "lines": [{ "emote": "接过信，就着窗口看了很久，手有点抖。" }, { "say": "乙丑年，贺长庚……老松岭那一趟的趟子手。兵部的人在岭上等着，镖头说照走。" }, { "say": "那趟镖本该走官道。改走老松岭，是兵部来人点名要的——兵部的人就等在岭上。振远替人背了二十年的锅。" }, { "say": "这封信，我收着。用得着的时候，来找我。" }] },
				{ "item": "native:cloud/escort_note", "giver_mark": "镖单锁进了刑堂", "accept": false, "say": "潘执法使那里锁着一张？……那这一张存根，你留着吧。" },
				{ "item": "native:cloud/escort_note", "giver_mark": "镖单给了陈天星", "accept": false, "say": "我手里有一张了。" },
				{ "item": "native:cloud/escort_note", "giver_mark": "潘军禅说了镖单", "unless_giver_mark": "天邪的线断了", "ask": "把镖单交给陈天星。\n他要查到底：查出来的，未必只是振远的丑事。镖单不会再回水烟阁。\n镖单只有一张。交给他吗？", "accept": true, "mark_giver": "镖单给了陈天星", "lines": [{ "emote": "接过镖单，就着窗口看了很久，手有点抖。" }, { "say": "乙丑年，老松岭……这一趟是剑秋他爹押的。人没回来，振远的招牌在京师低了二十年。" }, { "say": "当年是谁点的这条路，底账里该有。我翻。" }, { "say": "你出去转一圈再来，我把底账翻一翻。" }] },
				{ "item": "native:cloud/escort_note", "accept": false, "say": "这是剑秋那里的旧账。你从哪儿得来的？……收好吧。" },
				{ "line": "不要戏弄我！\n", "accept": false }
			]
		},
