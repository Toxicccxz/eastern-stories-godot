		{
			"id": "latemoon.npc.yumay",
			"legacy_source": "d/latemoon/npc/yumay.c",
			"name": "蓝雨梅",
			"aliases": ["yu-may", "yumay", "may"],
			"class": "dancer",
			"gender": "女性",
			"age": 18,
			"long": "蓝雨梅是晚月庄主蓝止萍的养女，由于庄主不信任男子，因此\n晚月庄接待外宾的工作向来由她负责。\n",
			"attributes": { "per": 30 },
			"resources": { "force": 2000, "max_force": 500 },
			"combat_exp": 60000,
			"force_factor": 2,
			"family": { "name": "晚月庄", "generation": 3, "title": "大弟子" },
			"skills": { "unarmed": 60, "throwing": 90, "dodge": 70, "stormdance": 30, "force": 50 },
			"skill_map": { "dodge": "stormdance" },
			"carry": [
				{ "item": "es2:d/latemoon/obj/needle", "source": "d/latemoon/npc/obj/needle.c", "amount": 30, "equip": "wield" },
				{ "item": "es2:d/latemoon/obj/deer_boot", "source": "d/latemoon/npc/obj/deer_boot.c", "equip": "wear" },
				{ "item": "es2:d/latemoon/obj/skirt3", "source": "d/latemoon/npc/obj/skirt3.c", "equip": "wear" }
			],
			"chat_chance": 7,
			"chat_msg": [
				"蓝雨梅微笑著说道：我们晚月庄是『 以舞会友，以神换技 』\n",
				"蓝雨梅看你一脸疑惑！笑著说：我教你跳一曲『西出阳关』好吗?\n",
				"蓝雨梅微笑著说道：我跳支舞给您看好不好？\n",
				"蓝雨梅微笑著说道：我的舞跳得不好，待会儿我请芳绫跳舞给您看，别走远喔。\n"
			],
			"inquiry": {
				"西出阳关": ["『西出阳关』是一种幻影式舞步。可以移形换影。\n"],
				"学舞": ["来!我教你...『西出阳关』(dancing out)是 ..... \n经过雨梅指导后你渐渐懂了! \n", { "mark_asker": "dance_out" }],
				"舞": ["我会的舞是属于「幻影式舞步」。\n"],
				"芳绫": ["她是个可爱的女孩。不过有点任性，听说她贪玩被关在 \n禁闭室。听说她爱玩竹蜻蜓哦。\n"],
				"竹蜻蜓": ["庄内有人会用竹子作成不同物品。\n"],
				"沧海龙吟": ["是一种失传以久的「寒谷龙舞」\n"]
			},
			"greeting": {
				"one_of": [
					{ "line": "雨梅对你微笑，和善的对你说：\n  这位$RESPECT，你好！欢迎来到晚月庄。请坐！" },
					{ "steps": [{ "line": "雨梅对你微笑，纤细的双手捧著茶，\n 说道：这位$RESPECT，你好！欢迎来到晚月庄。请用茶！" }, { "give": "es2:d/latemoon/obj/teacup", "unless_temp": "latemoon/茶", "lines": [{ "line": "这是上等金轩茶!您品尝一下。\n" }] }] }
				]
			}
		},
		{
			"id": "latemoon.npc.funlin",
			"legacy_source": "d/latemoon/npc/funlin.c",
			"name": "芳绫",
			"aliases": ["funlin", "fun", "lin"],
			"class": "dancer",
			"gender": "女性",
			"age": 18,
			"long": "她看起来像个小灵精，头上梳两个小包包头。\n她坐在地上，看到你看她便向你作了个鬼脸!\n你想她一定是调皮才会在这受罚!\n",
			"resources": { "force": 500, "max_force": 300 },
			"combat_exp": 2000,
			"force_factor": 2,
			"family": { "name": "晚月庄", "generation": 5, "title": "弟子" },
			"skills": { "unarmed": 20, "whip": 20, "dodge": 30, "move": 30, "stormdance": 20, "force": 15 },
			"skill_map": { "dodge": "stormdance" },
			"carry": [
				{ "item": "es2:d/latemoon/obj/whip", "source": "d/latemoon/npc/obj/whip.c", "equip": "wield" },
				{ "item": "es2:d/latemoon/obj/deer_boot", "source": "d/latemoon/npc/obj/deer_boot.c", "equip": "wear" },
				{ "item": "es2:d/latemoon/obj/skirt5", "source": "d/latemoon/npc/obj/skirt5.c", "equip": "wear" }
			],
			"apply": { "armor": 30 },
			"chat_chance": 7,
			"chat_msg": [
				"顽皮的芳绫向你扮个鬼脸。  *^G^* \n",
				"芳绫走到中央，一个姿势(Pose)。哇!你没想到她跳舞时竟有此深造诣。\n",
				"芳绫说：好不好看！这可是我花好久练成的哦! \n",
				"芳绫缓缓的移动著，手上的动作变化万千，有一种说不出的美妙。\n",
				"芳绫说：你好烦哦! 快走开! \n",
				"芳绫说：你想学可以去问昭仪姐，她会的比我多。嘻! \n",
				"芳绫说：丑八怪! 不要烦我。走开啦! \n",
				"她嘟著嘴。有点生气的翻过头去，不理你！\n"
			]
		},
		{
			"id": "latemoon.npc.girl",
			"legacy_source": "d/latemoon/npc/girl.c",
			"name": "昭仪",
			"aliases": ["zauyi", "joe"],
			"title": "晚月庄第三代弟子",
			"class": "dancer",
			"gender": "女性",
			"age": 17,
			"long": "她看起来非常可爱。身材玲珑有致，曲线苗条。\n第一眼印象，你觉的她舞蹈一定跳的不错，看她的一举一动\n有一种说不出的流畅优雅！\n",
			"resources": { "kee": 270, "force": 450, "max_force": 450 },
			"combat_exp": 4000,
			"force_factor": 2,
			"skills": { "unarmed": 30, "dodge": 30, "blade": 10, "spring-blade": 7, "force": 50 },
			"skill_map": { "blade": "spring-blade" },
			"carry": [
				{ "item": "es2:d/latemoon/obj/yu_blade", "source": "d/latemoon/npc/obj/yu_blade.c", "equip": "wield" },
				{ "item": "es2:d/latemoon/obj/flower_boot", "source": "d/latemoon/npc/obj/flower_boot.c", "equip": "wear" }
			],
			"apply": { "armor": 30 },
			"chat_chance": 8,
			"chat_msg": ["昭仪以轻妙的舞步，在房内跳了起来!你看的入神。\n", "昭仪抬头望著那幅图画，略有所思... \n"],
			"inquiry": {
				"图": ["这是一张非常真贵的湘绣舞曲图，我也在研究中。\n"],
				"沧海龙吟": ["嗯 ...为这舞曲名。似乎雨梅姊知道。\n"],
				"有凤来仪": ["嗯 ...为这舞曲名。(dancing yu-fong)很有名！ \n", { "mark_asker": "dance_yu_fong" }],
				"西出阳关": ["「幻影式舞步」步法与地点都很重要。\n"],
				"芳绫": ["她聪明伶俐，会跳一些自创的舞步。\n"],
				"画": ["沧海龙吟是一幅湘绣舞曲图，记载一些珍贵舞步。\n"],
				"寒谷龙舞": {
					"rules": [
						{ "lines": [{ "line": "昭仪很奇怪的望著你，说道:嘻!你对舞有兴趣呀! " }, { "line": "只见两眼溜来溜去，一种很神秘的表情，嘟著嘴。" }, { "line": "过了一会说：好吧!偷偷跟你说，你可以查看墙上的图。(dragon-dance) " }, { "say": "...." }] }
					]
				},
				"舞": {
					"rules": [
						{ "lines": [{ "line": "昭仪很高兴的看著你，说道:嘻!你对舞有兴趣呀!" }, { "line": "这有一幅图画，我从那悟到好多新舞步哦! " }, { "line": "『 沧海龙吟』是一首失传以久的舞曲。传说...." }, { "say": "......" }] }
					]
				}
			}
		},
