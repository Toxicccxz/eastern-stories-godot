	"landmarks": [
		{ "id": "latemoon.gate.landmark.lantern", "zone": "latemoon.gate", "name": "灯笼", "policy": "look", "long": "灯笼上几个娟秀的字迹写著：\n晚霞西照人影依稀 \n月影高挂和风婉约 \n", "legacy_source": "d/latemoon/gate.c" },
		{ "id": "latemoon.latemoon6.landmark.wall", "zone": "latemoon.latemoon6", "name": "墙", "policy": "look", "long": "    你仔细观看石墙，突然发现原本单调的墙上隐隐约约出现了\n一幅渺渺茫茫，似有似无的景像。彷佛是幻境，但又似真实，你\n清楚的看到一首词：「梦里消魂无说处，觉来惆怅消魂误。」\n", "legacy_source": "d/latemoon/latemoon6.c" },
		{ "id": "latemoon.latemoon2.landmark.closet", "zone": "latemoon.latemoon2", "name": "碧纱橱", "action": "取出衣服", "policy": "take", "limit": 2, "items": { "reward": "es2:d/latemoon/obj/skirt" }, "messages": { "take": "你从橱子内取出布裙。", "empty": "橱子内的衣服好像被拿光了。" }, "long": "这是一个上等木材作成的小橱子，里面放了一些物品。\n你看到一件件的美丽衣饰，真想取出(take cloth)看看。\n", "legacy_source": "d/latemoon/latemoon2.c" },
		{ "id": "latemoon.latebook.landmark.picture", "zone": "latemoon.latebook", "name": "湘绣舞曲图", "policy": "look", "long": "这是一幅湘绣的彩图，上有几名貌美的女子，以不同的姿态\n舞著，其漫妙之处让你著迷。图旁另绣有一曲名『西出阳关』\n(dancing out)与『有凤来仪 』\n", "legacy_source": "d/latemoon/latebook.c", "teaches": ["dance_out", "dance_yu_fong"] },
		{ "id": "latemoon.park.moonc.landmark.flower", "zone": "latemoon.park.moonc", "name": "西府海棠", "action": "摘花蕊", "policy": "take", "limit": 2, "items": { "reward": "es2:d/latemoon/park/npc/obj/flower" }, "messages": { "take": "你从西府海棠中摘下一朵小花蕊。", "empty": "西府海棠上的小花蕊已经被摘光了。" }, "long": "    你仔细看这是一棵形状有些奇特的西府海棠，有一淡淡\n的奇异香气。原来在旁边还有一朵不太起眼，但是略成金黄\n色的小花蕊，你的直觉告诉你它似乎是一种珍贵药材。你想\n把它摘下(pick)。\n", "legacy_source": "d/latemoon/park/moonc.c" },
		{ "id": "latemoon.park.paroad2.landmark.sign", "zone": "latemoon.park.paroad2", "name": "石牌", "policy": "look", "long": "\n 「六神」、「四鬼」、「三灵」 \n\n         旋芒震日月\n         宝剑护河山\n\n", "legacy_source": "d/latemoon/park/paroad2.c" }
