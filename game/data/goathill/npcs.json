{
	"npcs": [
		{
			"id": "goathill.npc.bandit_hwang",
			"legacy_source": "d/goathill/npc/bandit_hwang.c",
			"name": "黄霸",
			"aliases": ["hwang", "bandit"],
			"nickname": "日月槌",
			"title": "野羊山三寨主（代寨主）",
			"gender": "男性",
			"age": 31,
			"long": "黄霸原是关外一个山寨的寨主，后来因为逃避官府追捕而到也羊山\n避祸，他的成名武器是一对各重四十斤的大金槌，内功跟横练功夫\n也都有不错的造诣。\n大寨主、二寨主先后没了下落，如今野羊寨的事都是他说了算——只是每年得往北麓的道观纳供。\n",
			"attributes": { "str": 30, "con": 30, "cps": 25, "cor": 26, "spi": 16, "int": 21, "kar": 19, "per": 13 },
			"resources": { "force": 1000, "max_force": 1000 },
			"combat_exp": 150000,
			"force_factor": 30,
			"attitude": "friendly",
			"skills": { "hammer": 90, "parry": 80, "dodge": 90, "force": 60, "serpentforce": 70 },
			"skill_map": { "force": "serpentforce" },
			"carry": [
				{ "item": "es2:d/goathill/obj/sledge_hammer", "source": "d/goathill/npc/obj/sledge_hammer.c", "equip": "wield" },
				{ "item": "es2:d/goathill/obj/sledge_hammer", "source": "d/goathill/npc/obj/sledge_hammer.c", "equip": "wield" },
				{ "item": "es2:d/goathill/obj/boots", "source": "d/goathill/npc/obj/boots.c", "equip": "wear" },
				{ "item": "es2:obj/cloth", "source": "obj/cloth.c", "equip": "wear" },
				{ "item": "es2:obj/money/silver", "source": "obj/money/silver.c", "amount": 40 }
			],
			"apply": { "attack": 100, "defense": 90, "armor": 100 },
			"inquiry": {
				"纳供": {
					"rules": [
						{ "asker_marks": ["黄霸说了纳供"], "say": "说过的话老子不说第二遍。车在山路转角，去不去随你。" },
						{ "asker_marks": ["潘军禅说了鱼饵"], "mark_asker": "黄霸说了纳供", "lines": [{ "emote": "哼了一声。" }, { "say": "你倒打听得清楚。两年前北麓来了那群黑衣黑冠的道士，一座黑砖道观说起就起，自称逆灵宫。寨里折了一半弟兄。" }, { "say": "半年前大寨主霍铮、二寨主一前一后没了下落，寨子就落到老子手里。老子打不过他们——每年纳供，金帛、牲口，他们要什么给什么，换这山上还有野羊寨。" }, { "emote": "把酒碗往桌上一顿。" }, { "say": "今年的车今天就上去了，这会儿该到了山路转角。你要去，别说是老子说的。" }] },
						{ "say": "寨里的事，外人少打听。" }
					]
				},
				"逆灵宫": ["黄霸脸色一沉：北麓那座黑砖道观？少打听。要问，问纳供。"],
				"大寨主": ["黄霸把酒碗一顿：霍铮？半年前让道观的人带走了。你问这个做什么。"],
				"黑衣": {
					"rules": [
						{ "asker_marks": ["黄霸给了黑冠"], "say": "就那一顶，老子又不开成衣铺。" },
						{ "asker_marks": ["黄霸说了纳供"], "mark_asker": "黄霸给了黑冠", "gives": "native:niling/black_crown", "lines": [{ "emote": "从墙角的箱子里翻出一顶黑冠，往你怀里一扔。" }, { "say": "去年抓过一个落单的道士，衣冠都在这儿，人早喂了岩蛭。黑衣你自己有，戴上这顶冠，那群牛鼻子分不出你是谁。" }, { "say": "见了霍铮——要是他还活着——说一声，黄霸没忘了他。" }] },
						{ "asker_marks": ["刘安禄说了大寨主"], "mark_asker": "黄霸给了黑冠", "gives": "native:niling/black_crown", "lines": [{ "emote": "眯眼看了你一会儿，从墙角的箱子里翻出一顶黑冠，往你怀里一扔。" }, { "say": "刘老三让你来的？去年抓过一个落单的道士，衣冠都在这儿。黑衣你自己有，戴上这顶冠，那群牛鼻子分不出你是谁。" }, { "say": "见了霍铮——要是他还活着——说一声，黄霸没忘了他。" }] },
						{ "say": "黑衣？老子穿的是布衣。少打听。" }
					]
				}
			}
		},
