											"mark": "庾子建下狱"
										}
									},
									{
										"mark": "供状送了乔阴"
									}
								]
							}
						},
						{
							"text": "骆建章那张供状，韦相国一直收在袖子里；庾子建还在兵部。西街骆家的大门，从此没有官家的人来敲。",
							"when": {
								"all": [
									{
										"mark": "骆建章作了证"
									},
									{
										"not": {
											"mark": "庾子建下狱"
										}
									},
									{
										"not": {
											"mark": "供状送了乔阴"
										}
									}
								]
							}
						}
					]
				},
				{
