										"mark": "私了了庾子建"
									},
									{
										"mark": "旋芒交给了庾子建"
									}
								]
							}
						},
						{
							"text": "庾子建还在兵部。他派人去过一回玉螺湖，回来的人说，湖面上什么也没有。",
							"when": {
								"all": [
									{
										"mark": "私了了庾子建"
