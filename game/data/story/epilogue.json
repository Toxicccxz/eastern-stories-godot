							"when": {
								"all": [
									{
										"mark": "振远的票随了到此为止"
									},
									{
										"not": {
											"mark": "振远听你的"
										}
									}
								]
							}
						},
						{
							"text": "虹台上，陈剑秋坐在振远的旗下，没有提那本烧掉的账。",
							"when": {
								"all": [
									{
										"mark": "振远旧账到此为止"
									},
									{
										"not": {
											"all": [
												{
													"mark": "振远的票随了到此为止"
												},
												{
													"not": {
														"mark": "振远听你的"
													}
												}
											]
										}
									}
								]
							}
						},
						{
							"text": "虹台上，陈剑秋替振远要了一个说法。他身后的绮云分局，门还关着。",
							"when": {
								"all": [
									{
										"mark": "振远的票随了查到底"
									},
									{
										"not": {
											"mark": "振远听你的"
										}
									}
								]
							}
						},
						{
							"text": "虹台上，陈剑秋坐在振远的旗下，没有提那本账。他身后的绮云分局，门还关着。",
							"when": {
								"all": [
									{
										"mark": "振远旧账查到底"
									},
									{
										"not": {
											"all": [
												{
													"mark": "振远的票随了查到底"
												},
												{
													"not": {
														"mark": "振远听你的"
													}
												}
											]
										}
									}
								]
							}
						},
						{
							"text": "虹台上，蓝止萍坐在晚月庄的旗下。神教的人在台下转了一圈，没有一个走近晚月庄那一席。",
							"when": {
								"mark": "晚月庄的票随了庄规"
							}
						},
						{
							"text": "虹台上，晚月庄的旗后面站着一个老妇人和她的女儿。九派里有人认得那把细剑，没有人说破。",
							"when": {
								"mark": "晚月庄的票随了她"
							}
						},
						{
							"text": "虹台上，花紫会的旗下坐着一个打二十三个结的老叫花子，一直看着台下官道上的官差。",
							"when": {
								"mark": "认了二十三个结"
							}
						},
						{
							"text": "虹台上，陆得财坐在花紫会的旗下抠着脚。腰里那只皮酒囊，多了一个结。",
							"when": {
								"mark": "认了管事的陆得财"
							}
						}
					]
				},
				{
					"id": "snow",
					"place": "snow.outdoor",
					"title": "雪亭镇",
					"lines": [
						{
							"text": "饮风客栈的店小二逢人便说：新盟主在小店住过，就住楼上那间。",
							"when": {
								"mark": "当了武林盟主"
							}
						},
						{
							"text": "柳淳风说，盟主回来了，封山总算等到了这一天。",
							"when": {
								"all": [
									{
										"mark": "卫沧澜坐回了椅子"
									},
									{
										"not": {
											"mark": "跟了北宗"
										}
									},
									{
										"not": {
											"mark": "封山没上虹台"
										}
									}
								]
							}
						},
						{
							"text": "北宗在虹台上有了一个座。柳淳风关了武馆的门，一天没有出来。",
							"when": {
								"all": [
									{
										"mark": "颜违做了盟主"
									},
									{
										"mark": "跟了北宗"
									},
									{
										"not": {
											"mark": "封山没上虹台"
										}
									}
								]
							}
						},
						{
							"text": "封山的人那天没能上山。柳淳风回来，只说了一句：明年再去。",
							"when": {
								"all": [
									{
										"mark": "封山没上虹台"
									},
									{
										"not": {
											"mark": "跟了北宗"
										}
									}
								]
							}
						},
						{
							"text": "北宗的人那天没能上山。柳淳风在武馆里听说了，一句话也没有说。",
							"when": {
								"all": [
									{
										"mark": "封山没上虹台"
									},
									{
										"mark": "跟了北宗"
									}
								]
							}
						},
						{
							"text": "饮风客栈照旧开门。店小二说，正月十七那天，镇上的人都在等山上的消息。"
						}
					]
				},
				{
					"id": "waterfog",
					"place": "waterfog.mountain",
					"title": "水烟阁",
					"lines": [
						{
							"text": "正厅的太师椅上，坐着颜违。山门的告示上写着：老松岭旧案，到此为止。",
							"when": {
								"mark": "颜违做了盟主"
							}
						},
						{
							"text": "正厅的太师椅上，坐着卫沧澜。二十年的空椅子，有了人。",
							"when": {
								"mark": "卫沧澜坐回了椅子"
							}
						},
						{
							"text": "正厅的太师椅空着。阁里的人说，那是盟主的椅子——盟主就是你，可你很少回来坐。",
							"when": {
								"mark": "当了武林盟主"
							}
						},
						{
							"text": "正厅的太师椅空着。颜违照旧代理，「代」字没能去掉。",
							"when": {
								"all": [
									{
										"mark": "盟主的椅子还空着"
									},
									{
										"mark": "告发了南危水"
									}
								]
							}
						},
						{
							"text": "正厅的太师椅空着，等一个回不来的人。",
							"when": {
								"all": [
									{
										"mark": "盟主的椅子还空着"
									},
									{
										"not": {
											"mark": "告发了南危水"
										}
									}
								]
							}
						},
						{
							"text": "老松岭的旧案重新翻了出来，水烟阁的人往京城去了几回。",
							"when": {
								"any": [
									{
										"mark": "卫沧澜坐回了椅子"
									},
									{
										"mark": "盟主答：旧案查到底"
									}
								]
							}
						},
						{
							"text": "水烟阁同朝廷走近了。兵部来了人，在山门外喝了一回茶。",
							"when": {
								"any": [
									{
										"mark": "颜违做了盟主"
									},
									{
										"mark": "盟主答：旧案到此为止"
									}
								]
							}
						}
					]
				},
				{
					"id": "yard",
					"place": "cloud.yard_house",
					"title": "绮云镇 · 场院",
					"lines": [
						{
							"text": "九派逐了东方神教。棺材铺后面的场院关了门，朱鸿雪不知去向。",
							"when": {
								"any": [
									{
										"mark": "颜违做了盟主"
									},
									{
										"mark": "盟主答：逐神教"
									}
								]
							}
						},
						{
							"text": "神教照旧在棺材铺后面的场院里派差事。九派说，只要不犯到他们头上。",
							"when": {
								"any": [
									{
										"mark": "卫沧澜坐回了椅子"
									},
									{
										"mark": "盟主答：容神教"
									}
								]
							}
						},
						{
							"text": "虹台上没有人提神教的事。朱鸿雪照旧派她的差事。",
							"when": {
								"all": [
									{
										"not": {
											"any": [
												{
													"mark": "颜违做了盟主"
												},
												{
													"mark": "盟主答：逐神教"
												}
											]
										}
									},
									{
										"not": {
											"any": [
												{
													"mark": "卫沧澜坐回了椅子"
												},
												{
													"mark": "盟主答：容神教"
												}
											]
										}
									}
								]
							}
						},
						{
							"text": "安妮儿闭了西厢的门。神教的事，她不再同人说起。",
							"when": {
								"all": [
									{
										"any": [
											{
												"mark": "颜违做了盟主"
											},
											{
												"mark": "盟主答：逐神教"
											}
										]
									},
									{
										"mark": "站了安妮儿"
									}
								]
							}
						},
						{
							"text": "朱鸿雪记住了，那天山道上截住她的人的，是你。",
							"when": {
								"all": [
									{
										"mark": "截住了神教的杀手"
									},
									{
										"mark": "站了朱鸿雪"
									}
								]
							}
						}
					]
				},
				{
					"id": "north_slope",
					"place": "niling.gate",
					"title": "野羊山北麓",
					"lines": [
