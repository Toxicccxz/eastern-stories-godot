{
	"epilogues": [
		{
			"id": "ending",
			"final": {
				"mark": "你留在了冰里"
			},
			"cards": [
				{
					"id": "snow",
					"place": "snow.outdoor",
					"title": "雪亭镇",
					"lines": [
						{
							"text": "淳风武馆的门房换了个年轻人。刘安禄在野羊山上当他的二寨主，逢年过节下山喝一回酒。",
							"when": {
								"mark": "放过了刘安禄"
							}
						},
						{
							"text": "淳风武馆的门房还是那张桌子。刘安禄的事，镇上没人再提。",
							"when": {
								"all": [
									{
										"not": {
											"mark": "放过了刘安禄"
										}
									},
									{
										"not": {
											"mark": "说破了刘安禄"
										}
									},
									{
										"not": {
											"mark": "替刘安禄瞒了"
										}
									}
								]
							}
						},
						{
							"text": "淳风武馆的门房空了一冬。刘安禄走的那天没有人送，柳淳风在门里站了很久。",
							"when": {
								"all": [
									{
										"mark": "说破了刘安禄"
									},
									{
										"not": {
											"mark": "放过了刘安禄"
										}
									}
								]
							}
						},
						{
							"text": "淳风武馆的门房还是那张桌子。刘安禄的来历，武馆里只有三个人知道。",
							"when": {
								"all": [
									{
										"mark": "替刘安禄瞒了"
									},
									{
										"not": {
											"mark": "放过了刘安禄"
										}
									}
								]
							}
						},
						{
							"text": "淳风武馆照旧每天卯时开门，「剑不外传」四个字还挂在正厅。绮云镇口多了一块「北宗」的木牌，柳淳风从没去看过，也从没叫人摘。",
							"when": {
								"mark": "跟了本宗"
							}
						},
						{
							"text": "淳风武馆的内院开了一道侧门，镇上的孩子从那里进出。柳淳风书房朝着内院的那扇窗，一冬天都没有关。",
							"when": {
								"mark": "跟了北宗"
							}
						},
						{
							"text": "开春，你回了一趟山里，在老岑的坟前把信末那一行念给他听：风停处，替我再看一眼。——看过了。",
							"when": {
								"all": [
									{
										"mark": "读懂了荐信"
									},
									{
										"not": {
											"mark": "你留在了冰里"
										}
									}
								]
							}
						},
						{
							"text": "广场上的人散了。卖馄饨的说，那天的官爷，跟三年前来的是同一拨。"
						}
					]
				},
				{
					"id": "cloud",
					"place": "cloud.outdoor",
					"title": "绮云镇",
					"lines": [
						{
							"text": "振远的绮云分局照旧走镖。陈天星那本总账烧了，二十年前那笔抚恤银，振远没有人再提。",
							"when": {
								"mark": "振远旧账到此为止"
							}
						},
						{
							"text": "振远的绮云分局关了门。陈剑秋天天坐在柜台后面，不接镖，也不走。",
							"when": {
								"mark": "振远旧账查到底"
							}
						}
					]
				},
				{
					"id": "oldpine",
					"place": "oldpine.outdoor",
					"title": "老松岭",
					"lines": [
						{
							"text": "瀑布后的山洞里，那座无名的坟前多了一块碑，碑上没有字。",
							"when": {
								"mark": "安葬无名人"
							}
						},
						{
							"text": "瀑布后的山洞空了。那块腰牌后来回到了水烟阁，挂在葬剑亭里。",
							"when": {
								"not": {
									"mark": "安葬无名人"
								}
							}
						},
						{
							"text": "老松寨的寨门还在，买路钱一年比一年收得少。"
						}
					]
				},
				{
					"id": "waterfog",
					"place": "waterfog.mountain",
					"title": "水烟阁",
					"lines": [
						{
							"text": "五长老的椅子空着，说是等一个回不来的人。正月十七还没到，阁里没人提虹台。",
							"when": {
								"mark": "南危水留在了冰里"
							}
						},
						{
							"text": "卫沧澜回来了，坐在正厅侧的矮凳上，不肯坐那把太师椅。没有人再提「代盟主」三个字；正月十七的虹台，九派要上去推选。",
							"when": {
								"all": [
									{
										"mark": "卫沧澜出了尚书府"
									},
									{
										"not": {
											"mark": "南危水留在了冰里"
										}
									}
								]
							}
						},
						{
							"text": "南危水说，正月十七他要上虹台，只说一句：老松岭的那个人，替我死了。",
							"when": {
								"all": [
									{
										"mark": "替南危水保密"
									},
									{
										"not": {
											"mark": "卫沧澜出了尚书府"
										}
									},
									{
										"not": {
											"mark": "南危水留在了冰里"
										}
									}
								]
							}
						},
						{
							"text": "七长老颜违以代盟主自居。他说正月十七一过，「代」字就该去掉了，二十年的旧案，到此为止。",
							"when": {
								"all": [
									{
										"mark": "告发了南危水"
									},
									{
										"not": {
											"mark": "卫沧澜出了尚书府"
										}
									}
								]
							}
						},
						{
							"text": "传功使的位置空着。弟子们说，萧师父回城里去了。",
							"when": {
								"mark": "萧辟尘留在了冰里"
							}
						}
					]
				},
				{
					"id": "latemoon",
					"place": "latemoon.manor",
					"title": "晚月庄",
					"lines": [
						{
							"text": "东厢的门关着。庄里的人说，守衣人去守另一件东西了。",
							"when": {
								"mark": "瑷伦留在了冰里"
							}
						},
						{
							"text": "瑷伦回了东厢，宝衣挂在墙上。她说，几百年了，该歇一歇。",
							"when": {
								"all": [
									{
										"cond": "latemoon.robe_home"
									},
									{
										"not": {
											"mark": "瑷伦留在了冰里"
										}
									},
									{
										"not": {
											"mark": "宝衣烧了"
										}
									}
								]
							}
						},
						{
							"text": "瑷伦回了东厢，墙上挂衣的钉子空着。她说，衣裳烧了，守衣人也该歇了。",
							"when": {
								"all": [
									{
										"cond": "latemoon.robe_home"
									},
									{
										"not": {
											"mark": "瑷伦留在了冰里"
										}
									},
									{
										"mark": "宝衣烧了"
									}
								]
							}
						},
						{
							"text": "安妮儿把宝衣带回了东方神教。神教的香案上，多了一盏长明灯。",
							"when": {
								"all": [
									{
										"mark": "宝衣给了安妮儿"
									},
									{
										"not": {
											"mark": "宝衣烧了"
										}
									},
									{
										"not": {
											"mark": "站了朱鸿雪"
										}
									}
								]
							}
						},
						{
							"text": "安妮儿把宝衣带回了晚月庄的西厢。西厢的门一直关着——神教的事，她不再过问。",
							"when": {
								"all": [
									{
										"mark": "宝衣给了安妮儿"
									},
									{
										"not": {
											"mark": "宝衣烧了"
										}
									},
									{
										"mark": "站了朱鸿雪"
									}
								]
							}
						},
						{
							"text": "安妮儿回了东方神教，带回去的是一捧灰。神教的香案上，多了一只小瓷坛、一盏长明灯。",
							"when": {
								"all": [
									{
										"mark": "宝衣给了安妮儿"
									},
									{
										"mark": "宝衣烧了"
									},
									{
										"not": {
											"mark": "站了朱鸿雪"
										}
									}
								]
							}
						},
						{
							"text": "安妮儿带回西厢的是一捧灰。西厢的门一直关着，窗下多了一只小瓷坛。",
							"when": {
								"all": [
									{
										"mark": "宝衣给了安妮儿"
									},
									{
										"mark": "宝衣烧了"
									},
									{
										"mark": "站了朱鸿雪"
									}
								]
							}
						},
						{
							"text": "安妮儿收回了教主令。西厢的灯从此夜夜亮着，神教的人进进出出；朱鸿雪派出去的差事，只剩该死的人。",
							"when": {
								"all": [
									{
										"mark": "站了安妮儿"
									},
									{
										"not": {
											"mark": "宝衣给了安妮儿"
										}
									}
								]
							}
						},
						{
							"text": "庄里少了一件东西，多了一个故事。池边的人说，护庄的光，那年暗了一暗。",
							"when": {
								"all": [
									{
										"mark": "带走了宝衣"
									},
									{
										"not": {
											"mark": "宝衣回了庄"
										}
									}
								]
							}
						},
						{
							"text": "宝衣出过一回庄，又被人送了回来。池边的人说，护庄的光，那年暗了一暗，又亮了。",
							"when": {
								"mark": "宝衣回了庄"
							}
						},
						{
							"text": "后院书房那幅湘绣图前，又有人在学沧海龙吟了。",
							"when": {
								"mark": "跳成了沧海龙吟"
							}
						},
						{
							"text": "内书房的老妇再没有开过口。蓝止萍说，庄规是庄规；那一年起，晚月庄的门关得比从前早。",
							"when": {
								"mark": "晚月庄依了庄规"
							}
						},
						{
							"text": "内书房里多了一个人，不再蒙面。庄里的人说，每天傍晚，老妇擦她的鞭子，她女儿擦她的剑。",
							"when": {
								"mark": "她回了晚月庄"
							}
						}
					]
				},
				{
					"id": "goathill",
					"place": "goathill.mountain",
					"title": "野羊山",
					"lines": [
						{
							"text": "野羊寨的旗子又插回了山顶。霍铮说，逆灵宫的黑砖，拆下来正好砌寨墙。",
							"when": {
								"mark": "霍铮回了寨"
							}
						},
						{
							"text": "黄霸还在土地庙里收他的供。北麓的黑砖道观，没人敢上去看一眼。",
							"when": {
								"not": {
									"mark": "霍铮回了寨"
								}
							}
						},
						{
							"text": "有人说在北边的雪里见过商玦：一身黑衣结着霜，说话还像念经。",
							"when": {
								"mark": "放过了商玦"
							}
						}
					]
				},
				{
					"id": "temple",
					"place": "temple.grounds",
					"title": "茅山",
					"lines": [
						{
							"text": "灵心观藏经楼的二楼，镇教秘籍还是六函，第七函的位置空着。林忌说，茅山宁可没有那一函。",
							"when": {
								"mark": "茅山烧了符箓"
							}
						},
						{
							"text": "京师尚书府的花园里，那个老花匠又在浇他的花。庾清尘去哪里，他就跟到哪里。",
							"when": {
								"mark": "茅山烧了符箓"
							}
						},
						{
							"text": "藏经楼二楼的第七函回来了。花匠在书架边搭了一张竹床，夜里点着灯，教山上的小道士认北麓的字。",
							"when": {
								"mark": "茅山收了符箓"
							}
						},
						{
							"text": "北麓下来的孩子在灵心观后山开了一片地。花匠一页一页念给他们听：烧了一辈子的香，坛上写的原来是这些。",
							"when": {
								"all": [
									{
										"mark": "茅山收了符箓"
									},
									{
										"mark": "花匠在北麓念了经"
									}
								]
							}
						}
					]
				},
				{
					"id": "sanyen",
					"place": "sanyen.grounds",
					"title": "日照山",
					"lines": [
						{
							"text": "日照山的流云轩里，多了一个独眼的头陀。被鬼卒抓伤的人抬上山来，他一掌按下去，寒气冒成一缕白烟。",
							"when": {
								"mark": "山烟寺收了经"
							}
						},
						{
							"text": "头陀在流云轩教人婆萝蜜多心经。玄智说，西来的经和本寺的经放在一个经柜里，没有打架。",
							"when": {
								"mark": "山烟寺收了经"
							}
						},
						{
							"text": "日照山金门外，那块地方空了。山烟寺还是三百年前的山烟寺：外人不进流云轩，外来的经，也不进。",
							"when": {
								"mark": "山烟寺守了寺"
							}
						},
						{
							"text": "被鬼卒抓伤的人抬上山来，玄智守着，三天三夜。有的救回来了，有的没有。",
							"when": {
								"mark": "山烟寺守了寺"
							}
						},
						{
							"text": "乔阴的老葛每年秋天挑一担柴上日照山，放在金门边上，说是还那一掌的情。",
							"when": {
								"mark": "头陀进了流云轩"
							}
						},
						{
							"text": "乔阴的老葛用左手砍柴，砍得慢。逢人就说：命是山烟寺的方丈守回来的。",
							"when": {
								"mark": "守了寺规"
							}
						}
					]
				},
				{
					"id": "black_robe",
					"place": "niling.gate",
					"title": "黑衣人",
					"lines": [
						{
							"text": "那一夜，茅山的人截在北麓下湖的路上。黑砖道观里再没人提起那个新来的道士——只有门房记得，他戴冠的样子不太像。",
							"when": {
								"mark": "前夜倒戈"
							}
						},
						{
							"text": "冰龙厅里那第一剑，是从商玦背后来的。活着回到北麓的道士说，刺他的人戴着宫里的冠。",
							"when": {"mark": "潜伏那一剑"}
						},
						{
							"text": "北麓的道士还在找一个戴过黑冠的人。他们说他是茅山的眼线；茅山说，没这回事。",
							"when": {
								"mark": "被识破"
							}
						}
					]
				},
				{
					"id": "choyin",
					"place": "choyin.town",
					"title": "乔阴县城",
					"lines": [
						{
							"text": "程不平对着一本黑皮的名册，把上面的押印一个一个对了出来。槐阳城外有几户人家，收到了县衙的一封信。",
							"when": {
								"mark": "名册交给了程不平"
							}
						},
						{
							"text": "程不平的卷宗送上了京城。陈显祖回了乡，桃木箱里只剩一件旧官服。",
							"when": {
								"mark": "陈显祖作了证"
							}
						},
						{
							"text": "陈显祖带着他的箱子走了，没人知道去了哪里。福林酒楼的说书人，把这件事编成了一段新书。",
							"when": {
								"mark": "放走了陈显祖"
							}
						},
						{
							"text": "县衙门口的大皮鼓，又有人敢去敲了。",
							"when": {
								"not": {
									"any": [
										{
											"mark": "陈显祖作了证"
										},
										{
											"mark": "放走了陈显祖"
										}
									]
								}
							}
						},
						{
							"text": "福林大街的巷子口站着一个官差，叫花子从他跟前过，点个头。真龙头坐在街当中，数着酒囊上的结。",
							"when": {
								"mark": "认了二十三个结"
							}
						},
						{
							"text": "乔阴的巷子里还是没有官差。陆得财腰里那只皮酒囊，二十三个结。",
							"when": {
								"mark": "认了管事的陆得财"
							}
						},
						{
							"text": "乔阴县衙的公案上，又摊开了庾子建的卷宗：小屋那封信，天驼关那本账。京城没有回话，程不平也没有收卷。",
							"when": {
								"mark": "李信的账送了乔阴"
							}
						},
						{
							"text": "乔阴县衙的卷宗里，压着骆建章的一张供状：兵部抄本上多出来的三句，是谁口述的。",
							"when": {
								"mark": "供状送了乔阴"
							}
						},
						{
							"text": "曼雩台上多了一张书案。骆建章给弟弟抄谱，骆云舟在台边练剑；兄弟俩还是不怎么说话。",
							"when": {
								"mark": "保住了骆家"
							}
						},
						{
							"text": "曼雩台上还是骆云舟一个人。他说，大哥的字比他的剑直。",
							"when": {
								"mark": "骆建章作了证"
							}
						}
					]
				},
				{
					"id": "canyon",
					"place": "canyon.pass",
					"title": "天驼关",
					"lines": [
						{
							"text": "天驼关的关门照旧，出关留五两。官道上再没有人卖路引；严廷殷换了一个不会茅山术的军师。",
							"when": {
								"mark": "赫造基被拿下了"
							}
						},
						{
							"text": "天驼关的关门抬着，过关不要钱。严廷殷回了京城，再没回来；将军营帐里坐着李信，案上压着一本账的抄本。",
							"when": {
								"mark": "跟李信揭发"
							}
						}
					]
				},
				{
					"id": "guanbei",
					"place": "guanbei.town",
					"title": "关北",
					"lines": [
						{
							"text": "京城的诏书到了槐阳：槐阳王不反。城门上那张「槐阳反」的告示，郭承亲手撕了。",
							"when": {
								"all": [
									{
										"mark": "关北背了反名"
									},
									{
										"mark": "庾子建下狱"
									}
								]
							}
						},
						{
							"text": "槐阳城门上那张告示还贴着：槐阳反。程朔说，随他们说。",
							"when": {
								"all": [
									{
										"mark": "关北背了反名"
									},
									{
										"not": {
											"mark": "庾子建下狱"
										}
									}
								]
							}
						},
						{
							"text": "槐阳王府照旧不问兵部的事。草原上没救出来的四个人，后来有两个自己走了回来。",
							"when": {
								"mark": "王府干净"
							}
						}
					]
				},
				{
					"id": "fanfang",
					"place": "fanfang.bazaar",
					"title": "番坊",
					"lines": [
						{
							"text": "铁盾会的院子里又练起了盾。卢卡说，等他攒够了钱，要回海那边去看一看。",
							"when": {
								"mark": "大秦人留下了"
							}
						},
						{
							"text": "铁盾会的院子空了。鬼笠馆的浪人占了那块地，早川直义从此不再出刀。",
							"when": {
								"mark": "大秦人被清走"
							}
						},
						{
							"text": "拜火祠的火，一年到头没有灭过。"
						}
					]
				},
				{
					"id": "village",
