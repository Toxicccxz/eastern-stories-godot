{
	"epilogues": [
		{
			"id": "ending",
			"final": {
				"mark": "你留在了冰里"
			},
			"cards": [
				{
					"id": "snow",
					"place": "snow.outdoor",
					"title": "雪亭镇",
					"lines": [
						{
							"text": "淳风武馆的门房换了个年轻人。刘安禄在野羊山上当他的二寨主，逢年过节下山喝一回酒。",
							"when": {
								"mark": "放过了刘安禄"
							}
						},
						{
							"text": "淳风武馆的门房还是那张桌子。刘安禄的事，镇上没人再提。",
							"when": {
								"not": {
									"mark": "放过了刘安禄"
								}
							}
						},
						{
							"text": "开春，你回了一趟山里，在老岑的坟前把信末那一行念给他听：风停处，替我再看一眼。——看过了。",
							"when": {
								"mark": "读懂了荐信"
							}
						},
						{
							"text": "广场上的人散了。卖馄饨的说，那天的官爷，跟三年前来的是同一拨。"
						}
					]
				},
				{
					"id": "oldpine",
					"place": "oldpine.outdoor",
					"title": "老松岭",
					"lines": [
						{
							"text": "瀑布后的山洞里，那座无名的坟前多了一块碑，碑上没有字。",
							"when": {
								"mark": "安葬无名人"
							}
						},
						{
							"text": "瀑布后的山洞空了。那块腰牌后来回到了水烟阁，挂在葬剑亭里。",
							"when": {
								"not": {
									"mark": "安葬无名人"
								}
							}
						},
						{
							"text": "老松寨的寨门还在，买路钱一年比一年收得少。"
						}
					]
				},
				{
					"id": "waterfog",
					"place": "waterfog.mountain",
					"title": "水烟阁",
					"lines": [
						{
							"text": "这一年正月十七，虹台上没有推选。五长老的椅子空着，说是等一个回不来的人。",
							"when": {
								"mark": "南危水留在了冰里"
							}
						},
						{
							"text": "这一年正月十七，虹台上推选盟主。卫沧澜回来了，没有人再提「代盟主」三个字。",
							"when": {
								"all": [
									{
										"mark": "卫沧澜出了尚书府"
									},
									{
										"not": {
											"mark": "南危水留在了冰里"
										}
									}
								]
							}
						},
						{
							"text": "这一年正月十七，南危水上了虹台，只说了一句：老松岭的那个人，替我死了。",
							"when": {
								"all": [
									{
										"mark": "替南危水保密"
									},
									{
										"not": {
											"mark": "卫沧澜出了尚书府"
										}
									},
									{
										"not": {
											"mark": "南危水留在了冰里"
										}
									}
								]
							}
						},
						{
							"text": "这一年正月十七，七长老颜违做了盟主。他说二十年的旧案，到此为止。",
							"when": {
								"all": [
									{
										"mark": "告发了南危水"
									},
									{
										"not": {
											"mark": "卫沧澜出了尚书府"
										}
									}
								]
							}
						},
						{
							"text": "传功使的位置空着。弟子们说，萧师父回城里去了。",
							"when": {
								"mark": "萧辟尘留在了冰里"
							}
						}
					]
				},
				{
					"id": "latemoon",
					"place": "latemoon.manor",
					"title": "晚月庄",
					"lines": [
						{
							"text": "东厢的门关着。庄里的人说，守衣人去守另一件东西了。",
							"when": {
								"mark": "瑷伦留在了冰里"
							}
						},
						{
							"text": "瑷伦回了东厢，宝衣挂在墙上。她说，几百年了，该歇一歇。",
							"when": {
								"all": [
									{
										"mark": "瑷伦守到决战"
									},
									{
										"not": {
											"mark": "瑷伦留在了冰里"
										}
									},
									{
										"not": {
											"mark": "宝衣烧了"
										}
									}
								]
							}
						},
						{
							"text": "瑷伦回了东厢，墙上挂衣的钉子空着。她说，衣裳烧了，守衣人也该歇了。",
							"when": {
								"all": [
									{
										"mark": "瑷伦守到决战"
									},
									{
										"not": {
											"mark": "瑷伦留在了冰里"
										}
									},
									{
										"mark": "宝衣烧了"
									}
								]
							}
						},
						{
							"text": "安妮儿把宝衣带回了东方神教。神教的香案上，多了一盏长明灯。",
							"when": {
								"all": [
									{
										"mark": "宝衣给了安妮儿"
									},
									{
										"not": {
											"mark": "宝衣烧了"
										}
									}
								]
							}
						},
						{
							"text": "安妮儿回了东方神教，带回去的是一捧灰。神教的香案上，多了一只小瓷坛、一盏长明灯。",
							"when": {
								"all": [
									{
										"mark": "宝衣给了安妮儿"
									},
									{
										"mark": "宝衣烧了"
									}
								]
							}
						},
						{
							"text": "庄里少了一件东西，多了一个故事。池边的人说，护庄的光，那年暗了一暗。",
							"when": {
								"mark": "带走了宝衣"
							}
						}
					]
				},
				{
					"id": "goathill",
					"place": "goathill.mountain",
					"title": "野羊山",
					"lines": [
						{
							"text": "野羊寨的旗子又插回了山顶。霍铮说，逆灵宫的黑砖，拆下来正好砌寨墙。",
							"when": {
								"mark": "霍铮回了寨"
							}
						},
						{
							"text": "黄霸还在土地庙里收他的供。北麓的黑砖道观，没人敢上去看一眼。",
							"when": {
								"not": {
									"mark": "霍铮回了寨"
								}
							}
						},
						{
							"text": "有人说在北边的雪里见过一个黑衣人，说话像念经。",
							"when": {
								"mark": "放过了商玦"
							}
						}
					]
				},
				{
					"id": "choyin",
					"place": "choyin.town",
					"title": "乔阴县城",
					"lines": [
						{
							"text": "程不平的卷宗送上了京城。陈显祖回了乡，桃木箱里只剩一件旧官服。",
							"when": {
								"mark": "陈显祖作了证"
							}
						},
						{
							"text": "陈显祖带着他的箱子走了，没人知道去了哪里。福林酒楼的说书人，把这件事编成了一段新书。",
							"when": {
								"mark": "放走了陈显祖"
							}
						},
						{
							"text": "县衙门口的大皮鼓，又有人敢去敲了。",
							"when": {
								"not": {
									"any": [
										{
											"mark": "陈显祖作了证"
										},
										{
											"mark": "放走了陈显祖"
										}
									]
								}
							}
						}
					]
				},
				{
					"id": "guanbei",
					"place": "guanbei.town",
					"title": "关北",
					"lines": [
						{
							"text": "京城的诏书到了槐阳：槐阳王不反。城门上那张「槐阳反」的告示，郭承亲手撕了。",
							"when": {
								"all": [
									{
										"mark": "关北背了反名"
									},
									{
										"mark": "庾子建下狱"
									}
								]
							}
						},
						{
							"text": "槐阳城门上那张告示还贴着：槐阳反。程朔说，随他们说。",
							"when": {
								"all": [
									{
										"mark": "关北背了反名"
									},
									{
										"not": {
											"mark": "庾子建下狱"
										}
									}
								]
							}
						},
						{
							"text": "槐阳王府照旧不问兵部的事。草原上没救出来的四个人，后来有两个自己走了回来。",
							"when": {
								"mark": "王府干净"
							}
						}
					]
				},
				{
					"id": "fanfang",
					"place": "fanfang.bazaar",
					"title": "番坊",
					"lines": [
						{
							"text": "铁盾会的院子里又练起了盾。卢卡说，等他攒够了钱，要回海那边去看一看。",
							"when": {
								"mark": "大秦人留下了"
							}
						},
						{
							"text": "铁盾会的院子空了。鬼笠馆的浪人占了那块地，早川直义从此不再出刀。",
							"when": {
								"mark": "大秦人被清走"
							}
						},
						{
							"text": "拜火祠的火，一年到头没有灭过。"
						}
					]
				},
				{
					"id": "village",
					"place": "village.main",
					"title": "玉螺湖村",
					"lines": [
						{
							"text": "傅家坡的草顶重新铺过了。渔夫的网挂在他家门口，没有人去收。",
							"when": {
								"mark": "拔了穿灵"
							}
						},
						{
							"text": "玉螺湖的渔夫照旧撒网。湖底那盏灯，再没有人见过。",
							"when": {
								"mark": "查清了封物"
							}
						},
						{
							"text": "石头长高了一截，天天往湖边跑。",
							"when": {
								"mark": "石头回家了"
							}
						}
					]
				},
				{
					"id": "city",
					"place": "city.main",
					"title": "京师",
					"lines": [
						{
							"text": "庾子建在天牢里过了冬。少年皇帝第一次在早朝上，说了一整句话。",
							"when": {
								"mark": "庾子建下狱"
							}
						},
						{
							"text": "京城里都说，是兵部尚书带回了那把剑。皇帝在早朝上，一句话也没有说。",
							"when": {
								"all": [
									{
										"mark": "私了了庾子建"
									},
									{
										"mark": "旋芒交给了庾子建"
									}
								]
							}
						},
						{
							"text": "庾子建还在兵部。他派人去过一回玉螺湖，回来的人说，湖面上什么也没有。",
							"when": {
								"all": [
									{
										"mark": "私了了庾子建"
									},
									{
										"not": {
											"mark": "旋芒交给了庾子建"
										}
									}
								]
							}
						},
						{
							"text": "於兰天武回了朝，把旋芒挂在养心殿的墙上，对少年皇帝说：剑是用来记事的。",
							"when": {
								"all": [
									{
										"mark": "皇叔入朝"
									},
									{
										"mark": "旋芒在皇叔手里"
									}
								]
							}
						},
						{
							"text": "於兰天武回了朝，站在少年皇帝身后。",
							"when": {
								"all": [
									{
										"mark": "皇叔入朝"
									},
									{
										"not": {
											"mark": "旋芒在皇叔手里"
										}
									}
								]
							}
						}
					]
				},
				{
					"id": "seal",
					"place": "village.main",
					"title": "玉螺湖底",
					"lines": [
						{
							"text": "冰下封坛一片空。三百年的冰化了一半，水是清的。冰龙还在，只是不再抬头。",
							"when": {
								"mark": "侮天鬼灭了"
							}
						},
						{
							"text": "冰下封坛的冰柱里，瑷伦披着宝衣站着，眼睛睁着。三百年后，会有人来叫醒她。",
							"when": {
								"mark": "瑷伦留在了冰里"
							}
						},
						{
							"text": "冰下封坛的冰柱里，璃虹的光又亮了。她说过：第一个带着铜来的，是你。",
							"when": {
								"mark": "璃虹留在了冰里"
							}
						},
						{
							"text": "冰下封坛的冰柱里，南危水手按剑柄，像还在等什么人。",
							"when": {
								"mark": "南危水留在了冰里"
							}
						},
						{
							"text": "冰下封坛的冰柱里，萧辟尘握着旋芒。岚城的风，每年会吹到湖面上一回。",
							"when": {
								"mark": "萧辟尘留在了冰里"
							}
						},
						{
							"text": "冰下封坛的冰柱里，站着一个年轻人。没有人知道他的名字。",
							"when": {
								"mark": "你留在了冰里"
							}
						}
					]
				},
				{
					"id": "inn",
					"place": "snow.inn",
					"title": "饮风客栈",
					"lines": [
						{
							"text": "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖水清得能看见底。我说，那是人家的功劳，那碗茶不收钱。」",
							"when": {
								"mark": "侮天鬼灭了"
							}
						},
						{
							"text": "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖底冰里站着一个人。我说，那是替咱们守着的，逢年过节，要给他留一碗酒。」",
							"when": {
								"all": [
									{
										"any": [
											{
												"mark": "瑷伦留在了冰里"
											},
											{
												"mark": "璃虹留在了冰里"
											},
											{
												"mark": "南危水留在了冰里"
											},
											{
												"mark": "萧辟尘留在了冰里"
											},
											{
												"mark": "你留在了冰里"
											}
										]
									},
									{
										"not": {
											"mark": "你留在了冰里"
										}
									}
								]
							}
						},
						{
							"text": "店小二擦着桌子：「前些日子有个客官从这儿走出去，就再没回来。楼上那间房，我一直给他留着。」",
							"when": {
								"mark": "你留在了冰里"
							}
						}
					]
				},
				{
					"id": "closing",
					"title": "终",
					"lines": [
						{
							"text": "那少年，便是你。",
							"when": {
								"not": {
									"mark": "你留在了冰里"
								}
							}
						},
						{
							"text": "那少年，留在了冰里。",
							"when": {
								"mark": "你留在了冰里"
							}
						}
					]
				},
				{
					"id": "credits",
					"title": "东方故事",
					"lines": [
						{
							"text": "以《东方故事 2》（Eastern Stories 2）为底。"
						},
						{
							"text": "谢谢 ES2 的作者们，和 MUD 年代守着它的巫师们。"
						},
						{
							"text": "也谢谢你，走到了这里。"
						}
					]
				}
			],
			"sources": [
				"native: 终章 C (剧情总纲 §3 终章「回雪亭：广场上还是那队白衣武官，这回是来宣诏的；结局逐区讲述，从事迹记录里长出来；最后一句留给店小二」; 计划 build/plans/终章_计划.md C 包与 §3b, owner 2026-11-08「按推荐的做」: Q3 片尾后接着玩; DECISIONS「终章 C」「结局讲述」)"
			]
		}
	]
}
