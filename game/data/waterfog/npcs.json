				{ "item": "es2:obj/money/silver", "source": "obj/money/silver.c", "amount": 30 }
			],
			"chat_chance_combat": 90,
			"chat_msg_combat": [
				{ "action": "perform", "skill": "sword", "function": "counterattack" },
				{ "action": "exert", "function": "powerup" },
				{ "action": "exert", "function": "recover" }
			],
			"greeting": {
				"rules": [
					{ "mark": "替南危水保密", "steps": [{ "say": "你来了。老夫欠你一个人情，到了关北，老夫替你引见槐阳王。" }] },
					{ "mark": "告发了南危水", "steps": [{ "emote": "看了你一眼，没有说话。" }] }
				]
			},
			"calls": [
				{ "after": 2, "mark": "安葬无名人", "not_mark": "南危水承认了", "steps": [{ "emote": "看着你，忽然开口。" }, { "say": "是你埋了阿岭。" }, { "say": "老松岭瀑布后头那个山洞——骸骨旁边本来有一面腰牌，背面一个「岭」字。你把他葬了，连腰牌也葬了。这二十年，没有人替他做过这件事。" }, { "say": "他是老夫的随从。那年老夫押着盟主印和密件过老松岭，白衣武官在瀑布前伏击，阿岭替老夫挡了刀，盟主卫沧澜被他们带走了。老夫逃进山洞，在石壁上刻了那些字——让人以为南危水死在那里。" }, { "say": "老夫的哥哥是槐阳王。他若知道朝廷伏击了自己的弟弟，关北立刻就反。老夫装死二十年，是为了这个。" }, { "mark": "南危水承认了" }] }
			],
			"inquiry": {
				"五长老": ["老夫便是五长老。你想问什么？"],
				"山洞的骸骨": {
					"rules": [
						{ "asker_marks": ["南危水承认了"], "say": "老夫都说了。阿岭的事，你知道就好。" },
						{ "asker_carries": "guild token", "mark_asker": "南危水承认了", "lines": [{ "emote": "盯着你手里的腰牌，脸色一点点白了。" }, { "say": "背面一个「岭」字……阿岭的腰牌。你从山洞里拿来的。" }, { "say": "他是老夫的随从。那年老夫押着盟主印和密件过老松岭，白衣武官在瀑布前伏击，阿岭替老夫挡了刀，盟主卫沧澜被他们带走了。老夫逃进山洞，在石壁上刻了那些字——让人以为南危水死在那里。" }, { "say": "老夫的哥哥是槐阳王。他若知道朝廷伏击了自己的弟弟，关北立刻就反。老夫装死二十年，是为了这个。" }] },
						{ "asker_marks": ["看过石台碑", "看过葬剑亭碑"], "asker_carries": "escort note", "mark_asker": "南危水承认了", "lines": [{ "emote": "看了看镖单，又看了看你。" }, { "say": "乙丑年，关雨楼立的碑，字是用手指写的——山洞石壁上的字也是。你看出来了。" }, { "say": "死的是老夫的随从阿岭。那年老夫押着盟主印和密件过老松岭，白衣武官在瀑布前伏击，阿岭替老夫挡了刀，盟主卫沧澜被他们带走了。老夫逃进山洞，在石壁上刻了那些字——让人以为南危水死在那里。" }, { "say": "老夫的哥哥是槐阳王。他若知道朝廷伏击了自己的弟弟，关北立刻就反。老夫装死二十年，是为了这个。" }] },
						{ "say": "老夫不知道你在说什么。" }
					]
				},
				"保密": {
					"confirm": "替南危水保密，七长老颜违就永远不会从你这里知道这件事。要答应他吗？",
					"rules": [
						{ "asker_marks": ["替南危水保密"], "say": "多谢。到了关北，老夫替你引见槐阳王。" },
						{ "asker_marks": ["南危水承认了"], "asker_lacks": ["告发了南危水"], "mark_asker": "替南危水保密", "lines": [{ "emote": "沉默了很久，向你抱了抱拳。" }, { "say": "老夫欠你一个人情。到了关北，老夫替你引见槐阳王。" }] },
						{ "say": "保什么密？老夫没有什么要瞒的。" }
					]
				}
			}
