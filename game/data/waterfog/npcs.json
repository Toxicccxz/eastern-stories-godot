			],
			"moods": { "acting": { "title": "水烟阁代盟主", "lasting": true } },
			"inquiry": {
				"五长老": ["五长老？他就在楼上，有什么话你自己问他。"],
				"南危水的事": {
					"confirm": "把南危水装死二十年的事告诉七长老，他就再也瞒不住了。要说吗？",
					"rules": [
						{ "asker_marks": ["告发了南危水"], "say": "五长老的事，本座已经知道了。盟主不在，水烟阁总要有人主事。" },
						{ "asker_marks": ["南危水承认了"], "asker_lacks": ["替南危水保密"], "mood": "acting", "mark_asker": "告发了南危水", "lines": [{ "emote": "听完，半晌没有说话，然后慢慢坐直了。" }, { "say": "盟主二十年前就被朝廷带走了，五长老知情不报。这件事，水烟阁得有人主事。" }, { "say": "从今日起，本座代行盟主之职。你的话，本座记下了。" }] },
						{ "say": "南危水？他是五长老，有什么事？" }
					]
				}
			}
		}
