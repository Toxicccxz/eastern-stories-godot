		{
			"id": "waterfog.npc.elder5",
			"legacy_source": "d/waterfog/npc/elder5.c",
			"name": "南危水",
			"aliases": ["nan weishuey", "nan", "weishuey"],
			"title": "水烟阁五长老",
			"gender": "男性",
			"age": 52,
			"long": "南危水是当世使剑的名家，也是槐阳王的弟弟，一身武学集天邪、封山\n两派之所长，在水烟阁七长老中武功仅次于二长老莫谦容。南危水手中\n的焦殇剑也是一把罕见的利器，传说这把剑是名铸剑师黄炎炎生平六把\n名剑中排名第一的杰作。\n",
			"attributes": { "str": 25, "cor": 30, "cps": 30, "con": 27 },
			"resources": { "force": 1800, "max_force": 1800 },
			"combat_exp": 800000,
			"score": 120000,
			"force_factor": 3,
			"attitude": "peaceful",
			"skills": {
				"force": 100,
				"unarmed": 95,
				"sword": 100,
				"parry": 80,
				"dodge": 95,
				"celestial": 100,
