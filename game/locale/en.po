msgstr "You kneel and knock your head on the ground four times before %s, and call out, \"Shifu!\""

msgid "你决定拜%s为师。"
msgstr "You decide to take %s as your Shifu."

msgid "%s决定收你为弟子。"
msgstr "%s decides to take you as a disciple."

msgid "恭喜您成为{family}的第{generation}代弟子。"
msgstr "Congratulations! You are now a Generation {generation} disciple of {family}."

