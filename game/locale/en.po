msgstr "$N {N:focus|focuses}, {N:close|closes} {N:his} eyes, {N:mutter|mutters} a few words and {N:cast|casts} Ghost Sight."

msgid "你的阴阳眼法术失效了。"
msgstr "Your Ghost Sight wears off."

msgid "你失败了。"
msgstr "You failed."

msgid "你要对谁施展这个法术？"
msgstr "Cast this spell on whom?"

msgid "你的法力不够！"
msgstr "You don't have enough Arcane Power!"

msgid "你的精神没有办法有效集中！"
msgstr "You can't focus your mind!"

