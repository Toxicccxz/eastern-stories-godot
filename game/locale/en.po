msgid "攻：伤害高，闪躲、招架低；有内功时加力到上限的一半。"
msgstr "Attack: high damage, low dodge and parry. With an inner art, Extra Force goes up to half its max."

msgid "守：招架高，伤害低。"
msgstr "Guard: high parry, low damage."

msgid "游走：闪躲高，命中低。"
msgstr "Evade: high dodge, low accuracy."

msgid "稳赢"
msgstr "Sure win"

msgid "占优"
msgstr "Favored"

msgid "五五开"
msgstr "Even"

msgid "吃亏"
msgstr "Outmatched"

msgid "必败"
msgstr "Hopeless"

msgid "稳赢：{pronoun}远不是你的对手。"
msgstr "Sure win: no match for you."

msgid "占优：你比{pronoun}强一些。"
msgstr "Favored: you're a bit stronger."

msgid "五五开：{pronoun}和你不相上下。"
msgstr "Even: you're about equal."

msgid "吃亏：{pronoun}比你强，打起来要吃亏。"
msgstr "Outmatched: stronger than you — this will hurt."

msgid "必败：{pronoun}远比你强，别打。"
msgstr "Hopeless: far stronger than you. Don't fight."

msgid "{pronoun}这边有 {count} 个人一起上。"
msgstr "{count} on that side, all at once."

msgid "{pronoun}的闪躲比你高得多，你很难打中。"
msgstr "Dodges far better than you — you'll struggle to land a hit."

msgid "{pronoun}有兵刃在手，你空手难以近身。"
msgstr "Has a weapon in hand — bare-handed, you'll struggle to get close."

msgid "{pronoun}的经验比你多得多，你的拳脚落不实。"
msgstr "Far more experienced — your blows won't land clean."

msgid "{pronoun}下手太重，你撑不了几回合。"
msgstr "Hits too hard — you won't last many rounds."

msgid "你有兵刃在手，{pronoun}空手挡不住。"
msgstr "You're armed — bare hands won't stop you."

msgid "切磋稳赢：{pronoun}的招式你一眼看穿。"
msgstr "Spar, sure win: you can read every move."

msgid "切磋占优：你多半先打中{pronoun}。"
msgstr "Spar, favored: you'll most likely land first."

msgid "切磋五五开：谁先打中谁赢。"
msgstr "Spar, even: whoever lands first wins."

msgid "切磋吃亏：{pronoun}多半先打中你。"
msgstr "Spar, outmatched: they'll most likely land first."

msgid "切磋必输：{pronoun}的招式你接不住。"
msgstr "Spar, hopeless: you can't handle these moves."

