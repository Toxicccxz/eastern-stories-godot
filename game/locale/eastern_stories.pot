#. sanyen.kitchen.landmark.pot name
#: data/sanyen/world.json
msgid "大锅"
msgstr ""

#. sanyen.kitchen.landmark.pot long
#: data/sanyen/world.json
msgid ""
"一个冒著腾腾的热气的黑色大铁锅, 里头正煮著小米粥。\n"
msgstr ""

#. sanyen.kitchen.landmark.steampot name
#. sanyen.kitchen.steampot name
#: data/sanyen/world.json
msgid "蒸笼"
msgstr ""

#. sanyen.kitchen.landmark.steampot action
#: data/sanyen/world.json
msgid "拿馒头"
msgstr ""

#. sanyen.kitchen.landmark.steampot messages.take
#: data/sanyen/world.json
msgid "你从蒸笼里拿出一粒热乎乎的馒头。"
msgstr ""

#. sanyen.kitchen.landmark.steampot messages.empty
#: data/sanyen/world.json
msgid "突然房间里好像传来梦忆柔的声音说拿太多小心吃到噎著哦!!"
msgstr ""

#. sanyen.kitchen.landmark.steampot long
#: data/sanyen/world.json
msgid ""
"一个竹藤编成的蒸笼, 阵阵的香味使你想打开(open)来瞧一瞧。\n"
msgstr ""

#. sanyen.kitchen.steampot act.acts.steps.line
#: data/sanyen/world.json
msgid ""
"烧饭僧说:阿弥陀佛 !! 施主请勿动手动脚, 妨碍贫僧煮饭。\n"
msgstr ""

#. sanyen.kitchen.steampot act.acts.steps.line
#: data/sanyen/world.json
msgid ""
"你打开蒸笼的盖子, 一股热气冒向你的脸上。\n"
"你仔细一看, 只见蒸笼里排著一粒粒又白又Ｑ的大馒头(maintal)。\n"
msgstr ""

#. choyin.npc.cityguard long
#: data/choyin/npcs.json
msgid ""
"这是个正在这里站岗的守城官兵，虽然和许多武林人物比起来，官兵\n"
"们的武功实在稀松平常，但是他们是有组织、有纪律的战士，谁也不\n"
"轻易地招惹他们。\n"
msgstr ""

#. choyin.npc.cityguard chat_msg_combat
#. city.npc.guard chat_msg_combat
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"守城官兵喝道：还不快放下武器束手就缚？\n"
msgstr ""

#. choyin.npc.cityguard chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"守城官兵喝道：大胆刁民！竟敢杀官造反？\n"
msgstr ""

#. choyin.npc.cake_vendor long
#. city.npc.caker long
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"一个相貌朴实的卖饼大叔，憨厚的脸上挂著和蔼的笑容。\n"
msgstr ""

#. choyin.npc.cake_vendor rank_info.respect
#. city.npc.caker rank_info.respect
#: data/choyin/npcs.json data/city/npcs.json
msgid "大叔"
msgstr ""

#. choyin.npc.cake_vendor chat_msg
#. city.npc.caker chat_msg
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"卖饼大叔吆喝道：卖饼哟！又香又脆的大饼哟！\n"
msgstr ""

#. choyin.npc.cake_vendor chat_msg
#. city.npc.caker chat_msg
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"卖饼大叔掀开蒸笼，伸手探了探温度。\n"
msgstr ""

#. choyin.npc.cake_vendor chat_msg
#. city.npc.caker chat_msg
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"卖饼大叔吆喝道：刚出炉的大饼哟！热呼呼的大饼哟！\n"
msgstr ""

#. choyin.npc.dumpling_seller long
#. city.npc.dumpling_seller long
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"这个卖包子的小贩对你微微一笑，说道：热腾腾的包子，来一笼吧？\n"
msgstr ""

#. choyin.npc.dumpling_seller chat_msg
#. city.npc.dumpling_seller chat_msg
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"卖包子的吆喝道：包子！热腾腾的包子！\n"
msgstr ""

#. choyin.npc.boss name
#: data/choyin/npcs.json
msgid "汤掌柜"
msgstr ""

#. choyin.npc.boss long
#: data/choyin/npcs.json
msgid ""
"汤掌柜是这家大酒楼的主人，别看他只是一个小小的酒楼老板，乔阴\n"
"县境内除了知县老爷以外，恐怕就属他最财大势大。\n"
msgstr ""

#. choyin.npc.boss inquiry.name
#: data/choyin/npcs.json
msgid ""
"在下姓汤单名一个业字。\n"
msgstr ""

#. choyin.npc.boss inquiry.here
#: data/choyin/npcs.json
msgid ""
"此处便是福林酒楼，客倌如要点菜，吩咐店里的小二一声便可。\n"
msgstr ""

#. choyin.npc.boss inquiry topic
#: data/choyin/npcs.json
msgid "汤业"
msgstr ""

#. choyin.npc.boss inquiry.汤业
#: data/choyin/npcs.json
msgid ""
"不敢，在下便是汤业，不知客倌有何吩咐？\n"
msgstr ""

#. choyin.npc.boss inquiry.福林酒楼
#. city.npc.boss inquiry.太白酒楼
#: data/choyin/npcs.json data/city/npcs.json
msgid ""
"这里就是，客倌是第一次来吗？\n"
msgstr ""

#. choyin.npc.boss inquiry.武官.rules.say
#: data/choyin/npcs.json
msgid "陈武官？进了衙门就没再回来。听说在堂上说了什么，县太爷把人留下了。半年的账，他临走前倒是结清了。"
msgstr ""

#. choyin.npc.boss inquiry.武官.rules.say
#: data/choyin/npcs.json
msgid "那位陈武官抱着他的箱子走了，天没亮就走的。半年的账没结——罢了，他那个样子，谁忍心要。"
msgstr ""

#. choyin.npc.boss inquiry.武官.rules.say
#: data/choyin/npcs.json
msgid "陈武官跟你出去了？这半年他没出过这道门。"
msgstr ""

#. choyin.npc.boss inquiry.武官.rules.say
#: data/choyin/npcs.json
msgid "堂下那位武官姓陈，在小店住了半年，天天坐在那儿发呆，丢了个桃木箱子。客倌若见着，他会重谢。"
msgstr ""

#. choyin.npc.sergeant long
#: data/choyin/npcs.json
msgid ""
"一位相貌威武的武官，独自一个人站在这里发呆，似乎正有什么\n"
"事困扰著他。\n"
msgstr ""

#. choyin.npc.sergeant inquiry.name
#: data/choyin/npcs.json
msgid "在下姓陈，名显祖，阁下是？"
msgstr ""

#. choyin.npc.sergeant inquiry.here
#: data/choyin/npcs.json
msgid "真是不巧，我也是外地来的，对这个地方并不熟悉。"
msgstr ""

#. choyin.npc.sergeant inquiry.rumors
#: data/choyin/npcs.json
msgid "在下失落了一件重要物事，是装在一个桃木箱子里，不知你有没有看见？"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#. native.npc.niling_store_taoist inquiry topic
#. niling.winch.landmark.crates name
#. native.npc.chen_witness inquiry topic
#: data/choyin/npcs.json data/niling/npcs.json data/niling/world.json data/native/npcs.json
msgid "箱子"
msgstr ""

#. choyin.npc.sergeant inquiry.箱子
#: data/choyin/npcs.json
msgid "对，是桃木做成的箱子。"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#: data/choyin/npcs.json
msgid "桃木箱子"
msgstr ""

#. choyin.npc.sergeant inquiry.桃木箱子
#: data/choyin/npcs.json
msgid "如果你见著了，麻烦送还给我，在下定当重重报答。"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#. native.npc.chen_witness name
#: data/choyin/npcs.json data/native/npcs.json
msgid "陈显祖"
msgstr ""

#. choyin.npc.sergeant inquiry.陈显祖
#: data/choyin/npcs.json
msgid "不敢，正是在下，不知阁下有何指教？"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#. native.npc.huaiyang_gate_guard inquiry topic
#. native.npc.palace_gate_guard inquiry topic
#. native.npc.cheng_shuo inquiry topic
#. native.npc.guo_cheng inquiry topic
#. native.npc.palace_guard inquiry topic
#. native.npc.lu_sun inquiry topic
#. native.npc.ge_sheng inquiry topic
#. native.npc.wei_zhizhong inquiry topic
#: data/choyin/npcs.json data/guanbei/npcs.json data/imperial/npcs.json
msgid "兵部"
msgstr ""

#. choyin.npc.sergeant inquiry.兵部.rules.say
#: data/choyin/npcs.json
msgid "我认了。抄本在桃木箱的底板里，箱子在树王坟的树洞里——我不敢去取。"
msgstr ""

#. choyin.npc.sergeant inquiry.兵部.rules.lines.emote
#: data/choyin/npcs.json
msgid "看见文书末尾那方朱红的印，脸色一下变了，手按住了桌沿。"
msgstr ""

#. choyin.npc.sergeant inquiry.兵部.rules.lines.say
#: data/choyin/npcs.json
msgid "这印……二十年了，还是这方印。"
msgstr ""

#. choyin.npc.sergeant inquiry.兵部.rules.lines.say
#: data/choyin/npcs.json
msgid "在下不瞒阁下：二十年前老松岭那队白衣武官，我是其中一个——走到半路跑了的那个。原令只一句：寻剑，不得扰民一户。是我念给全队听的。念完第三天，领队拿着另一道令来了：征民夫，拿人。"
msgstr ""

#. choyin.npc.sergeant inquiry.兵部.rules.lines.say
#: data/choyin/npcs.json
msgid "我抄了一份原令，缝在桃木箱的底板里，怕了二十年。箱子……箱子丢在树王坟的树洞里了，洞里不干净，我不敢去取。"
msgstr ""

#. choyin.npc.sergeant inquiry.兵部.rules.say
#: data/choyin/npcs.json
msgid "兵部？在下一个外地人，不懂这些。"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#: data/choyin/npcs.json
msgid "抄本"
msgstr ""

#. choyin.npc.sergeant inquiry.抄本.rules.say
#: data/choyin/npcs.json
msgid "抄本你已经拿了。念给公堂听，还是烧了，都在你。"
msgstr ""

#. choyin.npc.sergeant inquiry.抄本.rules.marks_asker
#. choyin.npc.sergeant inquiry.走吧.rules.marks_asker
#: data/choyin/npcs.json
msgid "看过寻剑令抄本"
msgstr ""

#. choyin.npc.sergeant inquiry.抄本.rules.lines.emote
#: data/choyin/npcs.json
msgid "把桃木箱翻过来，抠开底板，取出一卷发黄的纸。"
msgstr ""

#. choyin.npc.sergeant inquiry.抄本.rules.lines.say
#: data/choyin/npcs.json
msgid "就是它。二十三个名字，我一个一个点过——点到的都不在了。"
msgstr ""

#. choyin.npc.sergeant inquiry.抄本.rules.say
#: data/choyin/npcs.json
msgid "在箱子底板的夹层里。箱子在树王坟的树洞里——洞里那三个影子，我见过一回，再没敢下去。"
msgstr ""

#. choyin.npc.sergeant inquiry.抄本.rules.say
#: data/choyin/npcs.json
msgid "什么抄本？"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#: data/choyin/npcs.json
msgid "作证"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.confirm
#: data/choyin/npcs.json
msgid ""
"护送陈显祖进衙门作证：他会跟着你走，从福林酒楼到县衙。\n"
"路上会有人拦。\n"
"确定吗？"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.rules.say
#: data/choyin/npcs.json
msgid "我跟着你。到了衙门再说。"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.rules.say
#: data/choyin/npcs.json
msgid "我已经在堂上说过了。"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.rules.lines.emote
#: data/choyin/npcs.json
msgid "沉默了很久，手从桌沿上拿了下来。"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.rules.lines.say
#: data/choyin/npcs.json
msgid "二十年，我天天想着这一天会不会来。来了就来了——我跟你去。箱子我带着，抄本你拿着。"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.rules.lines.say
#: data/choyin/npcs.json
msgid "阁下走前头。庾家的人在这条街上有眼睛。"
msgstr ""

#. choyin.npc.sergeant inquiry.作证.rules.say
#: data/choyin/npcs.json
msgid "作什么证？在下只是个丢了箱子的过路人。"
msgstr ""

#. choyin.npc.sergeant inquiry topic
#: data/choyin/npcs.json
msgid "走吧"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.confirm
#: data/choyin/npcs.json
msgid ""
"放陈显祖带着箱子走：他交出抄本，一去不回——公堂上就没有人证了。\n"
"确定吗？"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.say
#: data/choyin/npcs.json
msgid "我已经答应跟你去了。到了衙门再说走不走。"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.say
#: data/choyin/npcs.json
msgid "箱子还没回到我手里——你先把箱子还我。抄本在箱底的夹层里，你要就先翻出来。"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.marks_asker
#: data/choyin/npcs.json
msgid "放走了陈显祖"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.lines.emote
#: data/choyin/npcs.json
msgid "把桃木箱翻过来，抠开底板，取出一卷发黄的纸，递给你。"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.lines.say
#: data/choyin/npcs.json
msgid "多谢。这二十三个名字，往后替我记着。"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.lines.emote
#: data/choyin/npcs.json
msgid "抱起桃木箱，出了福林酒楼的门，再没有回头。"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.lines.say
#: data/choyin/npcs.json
msgid "多谢。抄本在你手上，就不用我这张嘴了。"
msgstr ""

#. choyin.npc.sergeant inquiry.走吧.rules.say
#: data/choyin/npcs.json
msgid "走？在下的箱子还没找回来。"
msgstr ""

#. choyin.npc.sergeant accept_object.lines.say
#: data/choyin/npcs.json
msgid "太好了！就是这个箱子！"
msgstr ""

#. choyin.npc.sergeant accept_object.lines.say
#: data/choyin/npcs.json
msgid "在下出门在外，没有携带太多银两 ... "
msgstr ""

#. choyin.npc.sergeant accept_object.lines.say
#: data/choyin/npcs.json
msgid "如果您不嫌弃的话，这本古书便请笑纳。"
msgstr ""

#. choyin.npc.sergeant accept_object.lines.line
#: data/choyin/npcs.json
msgid "武官给你一本「白杨经」。"
msgstr ""

#. choyin.npc.sergeant moods.going.chat_msg
#: data/choyin/npcs.json
msgid ""
"武官跟在你身后，一只手一直按在剑柄上。\n"
msgstr ""

#. choyin.npc.cucurbit_seller chat_msg
#: data/choyin/npcs.json
msgid ""
"卖糖葫芦的吆喝道：糖葫芦！好甜好香的糖葫芦！\n"
msgstr ""

#. choyin.npc.judge_gu name
#: data/choyin/npcs.json
msgid "衙役"
msgstr ""

#. choyin.npc.judge_gu long
#: data/choyin/npcs.json
msgid ""
"衙役精明强干, 满脸正气. \n"
msgstr ""

#. choyin.npc.judge_gu chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"衙役说道：你当这里是什么地方，敢来这里骚扰？\n"
msgstr ""

#. choyin.npc.judge_gu chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"衙役说道：你要是再无理取闹，当心捕头把你抓去坐牢!\n"
msgstr ""

#. choyin.npc.judge_gu chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"衙役手中的刀越砍越快，让你应接不暇。\n"
msgstr ""

#. choyin.npc.judge_gu chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"衙役说道：衙门岂是你放肆的地方？！\n"
msgstr ""

#. choyin.npc.magistra name
#: data/choyin/npcs.json
msgid "带刀侍卫"
msgstr ""

#. choyin.npc.magistra long
#: data/choyin/npcs.json
msgid ""
"带刀侍卫皆为槐阳王程老王爷麾下骁将,身负绝艺.\n"
msgstr ""

#. choyin.npc.magistra inquiry topic
#: data/choyin/npcs.json
msgid "老王爷"
msgstr ""

#. choyin.npc.magistra inquiry.老王爷
#: data/choyin/npcs.json
msgid "我们都是槐阳王程老王爷麾下的人。老王爷镇关北二十年，兵部的令到了他手里，不合先帝法度的，一概不接。"
msgstr ""

#. choyin.npc.magistra inquiry topic
#: data/choyin/npcs.json
msgid "兵部的令"
msgstr ""

#. choyin.npc.magistra inquiry.兵部的令.rules.say
#: data/choyin/npcs.json
msgid "老王爷拒了。我说过了。"
msgstr ""

#. choyin.npc.magistra inquiry.兵部的令.rules.lines.say
#: data/choyin/npcs.json
msgid "兵部去年也给关北发过一道令：征三千民夫修官道，寻剑。老王爷拒了——先帝的令只说寻剑，没说征人。"
msgstr ""

#. choyin.npc.magistra inquiry.兵部的令.rules.lines.say
#: data/choyin/npcs.json
msgid "拒了之后，关北的民夫还是一批一批地没了。往哪儿去的，老王爷查到今天。"
msgstr ""

#. choyin.npc.crone name
#: data/choyin/npcs.json
msgid "乾瘪老太婆"
msgstr ""

#. choyin.npc.crone long
#: data/choyin/npcs.json
msgid ""
"这个老太婆怀中抱了个竹篓，似乎在卖什么东西，也许你可以跟她问问\n"
"价钱？\n"
msgstr ""

#. choyin.npc.crone inquiry topic
#: data/choyin/npcs.json
msgid "年龄"
msgstr ""

#. choyin.npc.crone inquiry.年龄
#: data/choyin/npcs.json
msgid ""
"老身今年七十有八啦。\n"
msgstr ""

#. choyin.npc.crone inquiry.here
#: data/choyin/npcs.json
msgid ""
"这一带我可熟了。\n"
msgstr ""

#. choyin.npc.crone inquiry.忘忧草
#: data/choyin/npcs.json
msgid ""
"老身隐隐约约地听说过什么‘草’啊，‘狮子’的，具体的也就不知了。\n"
msgstr ""

#. choyin.npc.crone relay_ask.say
#: data/choyin/npcs.json
msgid "对不起，老婆子耳背，$RESPECT您是想买东西吧？这儿有价钱 ...."
msgstr ""

#. choyin.npc.crone relay_ask.line
#: data/choyin/npcs.json
msgid "老太婆打开竹篓，盖子上贴了张纸片。"
msgstr ""

#. choyin.npc.visitor name
#: data/choyin/npcs.json
msgid "游客"
msgstr ""

#. choyin.npc.visitor long
#: data/choyin/npcs.json
msgid ""
"这是一位来乔阴县游玩的游客。\n"
msgstr ""

#. choyin.npc.visitor inquiry.here
#: data/choyin/npcs.json
msgid ""
"我游历过大半个中国，小小的乔阴县对我能有什么秘密？\n"
msgstr ""

#. choyin.npc.visitor inquiry.忘忧草
#: data/choyin/npcs.json
msgid ""
"这个。。好象是给狮子衔去了。\n"
msgstr ""

#. choyin.npc.scholar name
#: data/choyin/npcs.json
msgid "书生"
msgstr ""

#. choyin.npc.scholar long
#: data/choyin/npcs.json
msgid ""
"一个看起来相当斯文的书生，正拿著一本书摇头晃脑地读著。\n"
msgstr ""

#. choyin.npc.girl name
#: data/choyin/npcs.json
msgid "官家小姐"
msgstr ""

#. choyin.npc.girl long
#: data/choyin/npcs.json
msgid ""
"一个看起来像是有钱人家的女子，正在这里游湖。\n"
msgstr ""

#. choyin.npc.girl inquiry.name
#: data/choyin/npcs.json
msgid "我 ... ？ 你们外地人都做兴这么问陌生姑娘的闺名吗？"
msgstr ""

#. choyin.npc.girl inquiry.here
#. choyin.npc.maid inquiry.here
#: data/choyin/npcs.json
msgid "这里啊？这里就是乔阴县有名的翠柳湖啊！"
msgstr ""

#. choyin.npc.girl inquiry topic
#: data/choyin/npcs.json
msgid "闺名"
msgstr ""

#. choyin.npc.girl inquiry.闺名
#: data/choyin/npcs.json
msgid "真是没有礼貌的家伙，我才不告诉你！"
msgstr ""

#. choyin.npc.girl inquiry topic
#. choyin.npc.girl inquiry.游晋.rules.forgets
#: data/choyin/npcs.json
msgid "游晋"
msgstr ""

#. choyin.npc.girl inquiry.游晋.rules.say
#: data/choyin/npcs.json
msgid "小女子有一事相求 ... 请您将这个交给游 ... 游公子。"
msgstr ""

#. choyin.npc.maid name
#. city.npc.shangshu.maid name
#: data/choyin/npcs.json data/city/npcs.json
msgid "丫鬟"
msgstr ""

#. choyin.npc.maid long
#: data/choyin/npcs.json
msgid ""
"一个服侍有钱人家小姐的丫鬟，正无聊地玩弄著衣角。\n"
msgstr ""

#. choyin.npc.judgeman name
#. canyon.npc.general inquiry topic
#. native.npc.cheng_shuo inquiry topic
#: data/choyin/npcs.json data/canyon/npcs.json data/guanbei/npcs.json
msgid "程不平"
msgstr ""

#. choyin.npc.judgeman title
#: data/choyin/npcs.json
msgid "乔阴县县官"
msgstr ""

#. choyin.npc.judgeman long
#: data/choyin/npcs.json
msgid ""
"他虽然出身望族，然攻读刻苦，榜中探花，如今已是才高八斗，满腹\n"
"经纶，还略通佛理。为官数年清贫廉正，人人敬仰。\n"
msgstr ""

#. choyin.npc.judgeman accept_fight.say
#: data/choyin/npcs.json
msgid "这是衙门，快回去吧。"
msgstr ""

#. choyin.npc.judgeman sentence.beat_line
#: data/choyin/npcs.json
msgid "来人哪！把$N拖下去打{boards}大板！"
msgstr ""

#. choyin.npc.judgeman sentence.faint_lines
#: data/choyin/npcs.json
msgid "哎, 早知今日,何必当初?"
msgstr ""

#. choyin.npc.judgeman sentence.faint_lines
#: data/choyin/npcs.json
msgid "来人呀, 把$N给我抬出去!"
msgstr ""

#. choyin.npc.judgeman sentence.faint_lines
#: data/choyin/npcs.json
msgid "...退...堂...!"
msgstr ""

#. choyin.npc.judgeman sentence.warn_line
#: data/choyin/npcs.json
msgid "$N对$n说道: 再敢犯案, 定斩不饶!"
msgstr ""

#. choyin.npc.judgeman sentence.sorry_line
#: data/choyin/npcs.json
msgid "真是对不起, 下人办事不周, 让您受委屈了."
msgstr ""

#. choyin.npc.judgeman inquiry topic
#. native:niling/war_ministry_papers name
#. fanfang.office.papers name
#: data/choyin/npcs.json data/niling/items.json data/fanfang/world.json
msgid "兵部文书"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.marks_asker
#. choyin.npc.judgeman inquiry.供词.rules.marks_asker
#: data/choyin/npcs.json
msgid "陈显祖作了证"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.marks_asker
#. choyin.npc.judgeman inquiry.供词.rules.marks_asker
#: data/choyin/npcs.json
msgid "程不平写了信"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "陈显祖的供词录下了，信也给了你。他留在内厅——庾家的人进不了这道门。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.marks_asker
#. choyin.npc.judgeman inquiry.供词.rules.marks_asker
#: data/choyin/npcs.json
msgid "程不平给了信"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.emote
#. choyin.npc.judgeman inquiry.供词.rules.lines.emote
#: data/choyin/npcs.json
msgid "把录好的供词压在文书底下，另取一张纸写了一封信，封好，压上县印。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "堂没审完，供词本县录下了。这封信给家叔槐阳王——假印和失踪的人都往关北去了，拿着它去天驼关，军营的门会开。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "陈显祖留在衙门里。庾家的人进不了这道门。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.marks_asker
#. choyin.npc.judgeman inquiry.供词.rules.marks_asker
#: data/choyin/npcs.json
msgid "只留了文书"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "信给了你。本县只能照纸写——退堂。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.emote
#. choyin.npc.judgeman inquiry.供词.rules.lines.emote
#: data/choyin/npcs.json
msgid "对着抄本和文书上的印看了半晌，提笔写了一封信，封好，压上县印。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "纸能证纸，不能证人。这封信给家叔槐阳王，本县只能照纸写——假印和失踪的人都往关北去了，拿着它去天驼关。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "信呢？……丢了？"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.emote
#. choyin.npc.judgeman inquiry.供词.rules.lines.emote
#: data/choyin/npcs.json
msgid "叹了口气，另取一张纸，照着底稿又写了一封，封好，压上县印。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#. choyin.npc.judgeman inquiry.供词.rules.lines.say
#: data/choyin/npcs.json
msgid "县印还在本县手里，信就还写得出来。这回收好——拿着它去天驼关。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.say
#: data/choyin/npcs.json
msgid "文书本县看过了，信也写了。拿着信去天驼关——假印和失踪的人都往关北去了。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.say
#: data/choyin/npcs.json
msgid "文书本县看过了。印是真的——所以才要人证。福林酒楼里那位姓陈的武官，去问他。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.emote
#: data/choyin/npcs.json
msgid "接过文书，一张一张看过去，看到末尾的印，看了很久。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#: data/choyin/npcs.json
msgid "印是兵部的，不假。纸是新的，字也是新的——这不是先帝的令。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#: data/choyin/npcs.json
msgid "可要动兵部的人，须有人证：印是谁盖的，人去了哪，得有人站在这堂上说。纸能证纸，不能证人。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.lines.say
#: data/choyin/npcs.json
msgid "本县指你一个人。福林酒楼里有个武官，姓陈，日日坐在堂下发呆，丢了一个箱子——二十年前老松岭那队白衣武官，他在里头。你把这文书拿给他看。"
msgstr ""

#. choyin.npc.judgeman inquiry.兵部文书.rules.say
#: data/choyin/npcs.json
msgid "什么文书？拿来本县看看。"
msgstr ""

#. choyin.npc.judgeman inquiry.人证.rules.say
#: data/choyin/npcs.json
msgid "陈显祖在内厅。他说的本县都录下了——有了他，这案子才是案子。"
msgstr ""

#. choyin.npc.judgeman inquiry.人证.rules.say
#: data/choyin/npcs.json
msgid "你放他走了。纸能证纸，不能证人——本县只能照纸写信。"
msgstr ""

#. choyin.npc.judgeman inquiry.人证.rules.say
#: data/choyin/npcs.json
msgid "福林酒楼里那位姓陈的武官。他知道的比他说的多——看他的脸就知道。"
msgstr ""

#. choyin.npc.judgeman inquiry.人证.rules.say
#: data/choyin/npcs.json
msgid "人证？你先把案子说给本县听。"
msgstr ""

#. choyin.npc.judgeman inquiry topic
#. native.npc.huaiyang_gate_guard inquiry topic
#. native.npc.cheng_shuo title
#. native.npc.cheng_shuo moods.read.title
#. native.npc.cheng_shuo moods.rebel.title
#. native.npc.cheng_shuo moods.clean.title
#. native.npc.nan_weishui_guest inquiry topic
#. native.npc.yu_zijian_court inquiry topic
#. native.npc.yulan_zhao_private inquiry topic
#. native.npc.chen_witness inquiry topic
#: data/choyin/npcs.json data/guanbei/npcs.json data/imperial/npcs.json data/native/npcs.json
msgid "槐阳王"
msgstr ""

#. choyin.npc.judgeman inquiry.槐阳王
#: data/choyin/npcs.json
msgid "家叔。本县这个县官，是叔父保举的——所以乔阴县的衙门，不认兵部的私令。"
msgstr ""

#. choyin.npc.judgeman inquiry topic
#. native.npc.chen_witness inquiry topic
#: data/choyin/npcs.json data/native/npcs.json
msgid "供词"
msgstr ""

#. choyin.npc.judgeman inquiry.供词.rules.say
#: data/choyin/npcs.json
msgid "陈显祖的供词有力：原令只一句，征民夫、拿人的不是先帝的令——人证、物证都在。叔父见了这封信，关北的兵不会再替人修官道。"
msgstr ""

#. choyin.npc.judgeman inquiry.供词.rules.say
#: data/choyin/npcs.json
msgid "没有供词，只有纸。本县写信时迟疑了半晌——叔父信不信纸，本县不敢说。"
msgstr ""

#. choyin.npc.judgeman inquiry.供词.rules.say
#: data/choyin/npcs.json
msgid "还没有供词。"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "拿起惊堂木，没有拍下去，放回了书案上。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "堂下何人？"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "跪下了。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "罪人陈显祖。二十年前老松岭那队白衣武官，罪人在其中。原令只一句——寻剑，不得扰民一户。征民夫、拿人的，不是先帝的令，是后头来的。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "抄本呈上来。"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "接过抄本，对着文书上的印看了半晌，提笔录供。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "印是兵部的，令不是先帝的。录了。"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "另取一张纸，写了一封信，封好，压上县印。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "这封信给家叔槐阳王。假印和失踪的人都往关北去了——拿着它去天驼关，军营的门会开。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "陈显祖，你留在衙门里。庾家的人进不了这道门。"
msgstr ""

#. choyin.npc.judgeman calls.steps.line
#: data/choyin/npcs.json
msgid ""
"两名带刀侍卫领着陈显祖进了内厅。\n"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "看了看堂下——只有你一个人。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "人证呢？"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "接过抄本，对着文书上的印看了半晌。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "纸能证纸，不能证人。你放他走了。"
msgstr ""

#. choyin.npc.judgeman calls.steps.emote
#: data/choyin/npcs.json
msgid "提笔，停了停，还是写了一封信，封好，压上县印。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "这封信给家叔槐阳王。本县只能照纸写——他信不信，本县不敢说。假印和失踪的人都往关北去了，拿着它去天驼关。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "退堂。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "你上过水烟阁？那里有位南五长老——我们程家的人，家里当他死了二十年。……见没见过他，本县不问。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "说吧，你今天来，为的什么事。"
msgstr ""

#. choyin.npc.judgeman calls.steps.say
#: data/choyin/npcs.json
msgid "水烟阁来了消息：南五长老装死二十年，让人告到了长老会。那是我们程家的人。……你来乔阴，是为别的事吧。说。"
msgstr ""

#. choyin.npc.lady long
#: data/choyin/npcs.json
msgid ""
"一个衣饰华丽的妇人正跪在这里虔诚地膜拜著。\n"
msgstr ""

#. choyin.npc.youngman long
#: data/choyin/npcs.json
msgid ""
"一个相貌俊美的年轻贵公子正优雅地欣赏著窗外的景物。\n"
msgstr ""

#. choyin.npc.youngman inquiry.name
#: data/choyin/npcs.json
msgid "在下姓游，单名一个晋字，不知阁下如何称呼？"
msgstr ""

#. choyin.npc.youngman inquiry.here
#: data/choyin/npcs.json
msgid "这里是乔阴县城，您是外地来的吧？"
msgstr ""

#. choyin.npc.youngman inquiry.心事
#: data/choyin/npcs.json
msgid "实不相瞒，在下仰慕前面曲桥上赏莲的姑娘已久 ..."
msgstr ""

#. choyin.npc.youngman inquiry.心事
#: data/choyin/npcs.json
msgid "但是一直不知那位姑娘芳名 ..."
msgstr ""

#. choyin.npc.youngman inquiry.心事
#: data/choyin/npcs.json
msgid "唉 ..."
msgstr ""

#. choyin.npc.youngman inquiry.姑娘
#: data/choyin/npcs.json
msgid "就是那位绿裙黄衫的姑娘 ..."
msgstr ""

#. choyin.npc.youngman accept_object.lines.line
#: data/choyin/npcs.json
msgid "贵公子一眼瞥见荷包上的鸳鸯图案，立刻一把抢了过去。"
msgstr ""

#. choyin.npc.youngman accept_object.lines.line
#: data/choyin/npcs.json
msgid "贵公子随即从怀中掏出一方手帕，上面竟也绣著一幅相同的鸳鸯图。"
msgstr ""

#. choyin.npc.youngman accept_object.lines.say
#: data/choyin/npcs.json
msgid "原来爹爹替我主张的婚事，竟然是 ..."
msgstr ""

#. choyin.npc.servant long
#: data/choyin/npcs.json
msgid ""
"一个穿著家人服色的男子，必恭必敬地垂手站在一旁。\n"
msgstr ""

#. choyin.npc.guard name
#: data/choyin/npcs.json
msgid "酒楼守卫"
msgstr ""

#. choyin.npc.guard long
#: data/choyin/npcs.json
msgid ""
"一个身穿蓝布衣的人，从他锐利的眼神跟神情，显然是个练家子。\n"
msgstr ""

#. choyin.npc.guard accept_fight.say
#: data/choyin/npcs.json
msgid "掌柜的有交代，不准任何人在这里打架！"
msgstr ""

#. choyin.npc.guard accept_kill.fellows.say
#: data/choyin/npcs.json
msgid "干什么？！"
msgstr ""

#. choyin.npc.guard accept_kill.report.say
#: data/choyin/npcs.json
msgid "有强人打劫哪... 快去报官！"
msgstr ""

#. choyin.npc.guard accept_kill.hint
#: data/choyin/npcs.json
msgid "（福林酒楼报了官：从此守城官兵和县城官兵见到你就会动手。）"
msgstr ""

#. choyin.npc.oldman name
#: data/choyin/npcs.json
msgid "老者"
msgstr ""

#. choyin.npc.oldman long
#: data/choyin/npcs.json
msgid ""
"他白发苍苍,老态龙钟.\n"
"他终年采药于深山，当有些不同凡响之处。\n"
"他宽五尺，高三尺.你实在无法理解他怎么这么的胖。\n"
msgstr ""

#. choyin.npc.oldman chat_msg.say
#: data/choyin/npcs.json
msgid "老者说道：哎。。。你这可怜的孩子，饿得面黄肌瘦的。"
msgstr ""

#. choyin.npc.oldman chat_msg.say
#: data/choyin/npcs.json
msgid "老者抚摸着你的头，老泪纵横。"
msgstr ""

#. choyin.npc.oldman chat_msg.say
#: data/choyin/npcs.json
msgid "老者拈起衣角擦了擦眼角的浊泪。"
msgstr ""

#. choyin.npc.oldman greeting.rules.steps.line
#: data/choyin/npcs.json
msgid "我给你的山药蛋好吃吗??"
msgstr ""

#. choyin.npc.oldman greeting.rules.steps.line
#: data/choyin/npcs.json
msgid ""
"老者抚摸着你的头，老泪纵横。\n"
"说道：哎。。。你这可怜的孩子，饿得面黄肌瘦的。\n"
"老者哆哆嗦嗦从怀里拿出个小布包，打开一层又一层，打开一层又一层..最后拿出个小山药蛋塞到你手里。"
msgstr ""

#. choyin.npc.oldman receive_damage.hurt.line
#: data/choyin/npcs.json
msgid "老者捂著受伤的地方，白发散乱，勉强稳住身行。"
msgstr ""

#. choyin.npc.oldman receive_damage.pills.line
#: data/choyin/npcs.json
msgid "老者从口袋摸出一粒象小山药蛋的仙豆吞了下去。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "采药老者眼放异光，说道：你真的不喜欢山药蛋吗??"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "沉吟半响道：既然如此，老头子今天豁出去了，纳命来！"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "山药蛋双手一招，一团黑雾涌起......"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "只听见「砰」地一声，你像一捆稻草般飞了出去！！"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "鬼门关 "
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid ""
"    这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大的\n"
"黑色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关就无法再\n"
"回阳间了。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "    这里明显的出口是北边和南边。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#. death.npc.bgargoyle name
#: data/choyin/npcs.json data/death/npcs.json
msgid "黑无常"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "黑无常发出一阵像呻吟的声音，当他发现你正注视著他的时候，瞪了你一眼。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "黑无常说道：喂！新来的，你叫什么名字？ "
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#. death.npc.bgargoyle calls.steps.line
#: data/choyin/npcs.json data/death/npcs.json
msgid "黑无常「哼」的一声，从袖中掏出一本像帐册的东西翻看著。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#. death.npc.bgargoyle calls.steps.line
#: data/choyin/npcs.json data/death/npcs.json
msgid "黑无常阁上册子，说道：咦？阳寿未尽？怎么可能？"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#. death.npc.bgargoyle calls.steps.line
#: data/choyin/npcs.json data/death/npcs.json
msgid "黑无常搔了搔头，叹道：罢了罢了，你走吧。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#. death.npc.wgargoyle calls.steps.line
#. death.npc.bgargoyle calls.steps.line
#: data/choyin/npcs.json data/death/npcs.json
msgid "一股阴冷的浓雾突然出现，很快地包围了你。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "你觉得有什么地方不对了，使劲掐了一下自己，你惨叫了一声:哇，好痛啊～～～～～～"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "你出窍的真魂绕了一大圈，终于归位了。"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "黑雾慢慢消散了"
msgstr ""

#. choyin.npc.oldman kill_ob.lines.line
#: data/choyin/npcs.json
msgid "山药蛋就地一滚，没入土中不见了......"
msgstr ""

#. choyin.npc.oldman defeated_enemy.line
#: data/choyin/npcs.json
msgid "老者骨碌碌就地打了个滚，说道：我赢了！"
msgstr ""

#. choyin.npc.crane name
#: data/choyin/npcs.json
msgid "仙鹤"
msgstr ""

#. choyin.npc.crane long
#: data/choyin/npcs.json
msgid ""
"白羽如雪，不似凡间之物。 \n"
msgstr ""

#. choyin.npc.crane limbs
#: data/choyin/npcs.json
msgid "翅"
msgstr ""

#. choyin.npc.lboy name
#: data/choyin/npcs.json
msgid "紫衣童子"
msgstr ""

#. choyin.npc.lboy long
#: data/choyin/npcs.json
msgid ""
"紫衣童子是乔阴县的小孩，从小孤苦零丁。仙人怜之，带入云台。\n"
msgstr ""

#. choyin.npc.lboy chat_msg
#: data/choyin/npcs.json
msgid ""
"紫衣童子躬身一揖。 \n"
msgstr ""

#. choyin.npc.lboy chat_msg
#: data/choyin/npcs.json
msgid ""
"童子说道：仙人 ，只在此山中，云深不知处。\n"
msgstr ""

#. choyin.npc.lboy chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"紫衣童子拧眉说道：你欺负我年纪小是吗？\n"
msgstr ""

#. choyin.npc.lboy chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"紫衣童子笑道：你杀不死我的。\n"
msgstr ""

#. choyin.npc.lboy chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"紫衣童子冲你一龇牙, 说道: 您盗过古墓吗?\n"
msgstr ""

#. choyin.npc.lboy inquiry topic
#: data/choyin/npcs.json
msgid "仙人"
msgstr ""

#. choyin.npc.lboy inquiry.仙人
#: data/choyin/npcs.json
msgid "只度有缘人。"
msgstr ""

#. choyin.npc.ghost name
#: data/choyin/npcs.json
msgid "孤魂野鬼"
msgstr ""

#. choyin.npc.shadow name
#: data/choyin/npcs.json
msgid "朦胧鬼影"
msgstr ""

#. choyin.npc.shadow long
#: data/choyin/npcs.json
msgid ""
"一个高大的身影，看起来像是个人，不过 ....\n"
msgstr ""

#. choyin.npc.lion name
#: data/choyin/npcs.json
msgid "护草神兽"
msgstr ""

#. choyin.npc.lion long
#: data/choyin/npcs.json
msgid ""
"看守忘忧草的护草神兽。\n"
msgstr ""

#. choyin.npc.yamen_po long
#: data/choyin/npcs.json
msgid ""
"     巡捕个个身手矫健，强盗、山贼无不闻风丧胆。\n"
msgstr ""

#. choyin.npc.yamen_po chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"巡捕说道：你想干什么? 还不跟我去县衙受审!?\n"
msgstr ""

#. choyin.npc.yamen_po chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"巡捕说道：大胆! 居然敢当街拒捕! 想造反？\n"
msgstr ""

#. choyin.npc.yamen_po chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"巡捕手中的刀越砍越快，让你应接不暇。\n"
msgstr ""

#. choyin.npc.yamen_po chat_msg_combat
#: data/choyin/npcs.json
msgid ""
"巡捕说道：别胡闹了，还是乖乖的跟我走吧。\n"
msgstr ""

#. choyin.npc.yamen_po inquiry topic
#: data/choyin/npcs.json
msgid "贿赂"
msgstr ""

#. choyin.npc.yamen_po inquiry.贿赂
#: data/choyin/npcs.json
msgid ""
"说哪里话来，县太爷清贫廉正，我们作手下的岂能辱没他的名声？\n"
"收起你的钱吧！\n"
msgstr ""

#. choyin.npc.yamen_po inquiry topic
#: data/choyin/npcs.json
msgid "年饷"
msgstr ""

#. choyin.npc.yamen_po inquiry.年饷
#: data/choyin/npcs.json
msgid ""
"哎，老爷俸银微薄，我们的年饷自然更少了......\n"
msgstr ""

#. choyin.npc.yamen_po inquiry.钱
#: data/choyin/npcs.json
msgid ""
"说实在的，我也想要钱。但要是让老爷知道了我收受贿赂，\n"
"不死也得扒层皮\n"
msgstr ""

#. choyin.npc.yamen_po name
#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "慕容巡捕"
msgstr ""

#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "西门巡捕"
msgstr ""

#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "公孙巡捕"
msgstr ""

#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "上官巡捕"
msgstr ""

#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "南宫巡捕"
msgstr ""

#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "欧阳巡捕"
msgstr ""

#. choyin.npc.yamen_po name_pick
#: data/choyin/npcs.json
msgid "司徒巡捕"
msgstr ""

#. choyin.npc.yamen_po patrol.arrest.catch_say
#: data/choyin/npcs.json
msgid "闹了半天原来{name}是个贼啊! 我走一趟吧!"
msgstr ""

#. choyin.npc.yamen_po patrol.arrest.escape_line
#: data/choyin/npcs.json
msgid "嘿嘿, 还想往哪逃?!"
msgstr ""

#. choyin.npc.yamen_po patrol.arrest.deliver_say
#: data/choyin/npcs.json
msgid "老爷，人犯已带到，小人巡街去了。"
msgstr ""

#. choyin.npc.yamen_po patrol.arrest.taken_lines
#: data/choyin/npcs.json
msgid "这怎么好?......要是让老爷知道了......"
msgstr ""

#. choyin.npc.yamen_po patrol.arrest.taken_lines
#: data/choyin/npcs.json
msgid "盛情难却....我就收下了.."
msgstr ""

#. choyin.npc.yamen_po patrol.arrest.refused_line
#: data/choyin/npcs.json
msgid "你这是什么意思?......谁稀罕你的钱?!"
msgstr ""

#. es2:d/choyin/n_gate long
#: data/choyin/rooms.json
msgid ""
"这里乔阴县城的北门，一座高大的石牌楼上面刻著「北门」两个大\n"
"字，一条黄土路往北穿过一片松树林，青郁郁地通往北边的山上，石牌\n"
"楼旁蹲著两只石狮，由于乔阴县城最热闹的火龙将军庙远在城南，因此\n"
"北门这一带反而显得比较冷清，和附近的乡村一般的宁静纯朴。\n"
msgstr ""

#. es2:d/choyin/n_street1 long
#: data/choyin/rooms.json
msgid ""
"你现在正走在一条宽敞的街道上，这里是乔阴县城联通北门与南\n"
"门的福林大街，街道两旁有做生意的，有做粗活的，这里的老百姓大多\n"
"是老老实实的农人与工匠，街上卖的也多半是一些日用品，往东边是一\n"
"条小巷子，南边的街道似乎比较热闹一些，北边则是北门。\n"
msgstr ""

#. es2:d/choyin/n_street2 long
#: data/choyin/rooms.json
msgid ""
"你现在正走在一条宽敞的街道上，这里是乔阴县联通南北城门的福\n"
"林大街，街道从这里向南北延伸，往北远远地可以望见北门的石牌楼，\n"
"南边不远处则是乔阴县城著名的地标「树王坟」，你的东边有一家三层\n"
"楼的酒馆，西边则是远近驰名的老姚布庄，街上不时有贩夫走卒穿梭\n"
"而过，十分热闹。\n"
msgstr ""

#. es2:d/choyin/n_street3 long
#: data/choyin/rooms.json
msgid ""
"你现在正走在一条宽敞的大街上，街道往北边笔直地延伸，南边则\n"
"是一个隆起的石台，你可以看见石台前有块石碑，上书「树王坟」三个\n"
"大字，街道的东边和西边都是石板空地，围绕著树王坟成为一个圆环，\n"
"许多小贩客商都聚集在这里交易买卖。\n"
msgstr ""

#. es2:d/choyin/nw_street long
#: data/choyin/rooms.json
msgid ""
"这里是树王坟西北边的石板空地，因为树王的根范围太广，因此树\n"
"王坟周围十几丈都没有办法盖房子，因此这里铺了石板，平时便当作百\n"
"姓散步休憩的地方。\n"
msgstr ""

#. es2:d/choyin/w_street4 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的西大街.\n"
msgstr ""

#. es2:d/choyin/w_street3 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的西大街，东边不远处的石台便是远近驰名的「树\n"
"王坟」，西大街往西一直通往西城门，街道两边有许多的商店，街上人\n"
"来人往好不热闹。\n"
msgstr ""

#. es2:d/choyin/w_street2 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的西大街，西门就在你的西边几十丈外，望东则是\n"
"通往乔阴县的著名地标「树王坟」，街上有许多商店，北边是一家大酒\n"
"楼，南边则有一间染坊。\n"
msgstr ""

#. es2:d/choyin/w_street1 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的西大街，西边就是县城的西门，一座巨大的牌楼\n"
"上刻著「西门」二字，往北有一条小巷，南边则是一间书肆，街道中央\n"
"立著一尊石狮(statue)，而且是站著的，将来往行人分为左右两道。\n"
msgstr ""

#. es2:d/choyin/tree_tomb long
#: data/choyin/rooms.json
msgid ""
"你现在来到了著名的「树王坟」前，这里是个高台，中央约两丈见方\n"
"的地上有一截巨大的树桩，少说有三、四十人合抱那么粗，树桩中间有一\n"
"个大洞(hole)，望下去黑漆漆地，石台靠南的地方还有一间小庙(shrine)\n"
"，东西南北四个方向都有阶梯通往四面的街道。\n"
msgstr ""

#. es2:d/choyin/e_street1 long
#: data/choyin/rooms.json
msgid ""
"    这里是乔阴县城的东大街，西边不远处的石台便是远近驰名的「树\n"
"王坟」，东大街往东一直通往东城门，街道两边有许多的民宅，街上行\n"
"人渐稀。\n"
msgstr ""

#. es2:d/choyin/e_gate long
#: data/choyin/rooms.json
msgid ""
"    这里乔阴县城的东门，一座高大的石牌楼上面刻著「北门」两个大\n"
"字，一条土路青郁郁地通往南边的山上，石牌楼旁蹲著一只铁狮. 与南\n"
"北两城门相比, 北门这一带显得比较冷清，偶见几个采药, 砍柴之人由\n"
"此出入。\n"
"\n"
msgstr ""

#. es2:d/choyin/s_street3 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的福林大街，往北是一座高台，台上便是著名的「\n"
"树王坟」，打从这里往南就是乔阴县最热闹的街道，接上来往的行商贩\n"
"子也最多，你的东边和西边都是石板空地，平常的市集便在此处，遇到\n"
"赛会节庆这里更是挤得水泄不通，福林大街往南是个路口。\n"
msgstr ""

#. es2:d/choyin/s_street2 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的福林大街，东首一栋雕梁画栋，美仑美奂的华厦\n"
"便是乔阴县最大的酒楼「福林楼」，不但乔阴县城的富商大贾常来此楼\n"
"饮宴，就连方圆百里内的许多豪门巨绅也常常到这里喝酒，西边是一条\n"
"宽敞的青石官道，通往县府衙门，街道往南则是热闹的南门广场。\n"
msgstr ""

#. es2:d/choyin/hotel1 long
#: data/choyin/rooms.json
msgid ""
"这里便是乔阴县驰名远近的福林酒楼，连乔阴县最热闹的一条大街\n"
"都以此命名，福林酒楼是一家近百年老店，传到现在的这位掌柜已经是\n"
"第三代，如果你是初到此地的外地人，不妨和他攀攀交情，酒楼一楼多\n"
"半是县城里熟客人，东北边有一道方梯通往楼上雅座，往西则可以出大\n"
"街。\n"
msgstr ""

#. es2:d/choyin/s_street1 long
#: data/choyin/rooms.json
msgid ""
"这里便是乔阴县城最大的一处广场，往北是贯通县城南北门的福林\n"
"大道，往东则是一个绿柳环绕的湖泊「翠柳湖」，广场上只见卖艺的，\n"
"卖糖葫芦的，捏面人的，各色小贩穿梭来去，广场中央有一口大井，井\n"
"旁用绳索绑著几只杯子供人取水喝(drink)，南门的牌楼因为几年前改建\n"
"翠柳湖的曲桥，因此移到西边的县府衙门所在的昌平街，现在广场的南\n"
"面就是一座曲桥通往湖东岸的雨桥庄，西南边一条宽敞的街道沿著湖岸\n"
"通往城外，广场的西边则一直延伸到昌平街。\n"
msgstr ""

#. es2:d/choyin/s_street4 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城城南的承安街，街道十分宽敞，南北两边都是一些\n"
"贩卖南北货、日用品的商店，这里虽然正当乔阴县人车来往最频繁的要\n"
"冲，可是却没有福林大街热闹，往东走便是南门广场，往西则是和昌平\n"
"街的交叉路口。\n"
msgstr ""

#. es2:d/choyin/s_street5 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城南的承安街，往东可以通往热闹的南门广场，西边\n"
"的路口则是通往县府衙门的昌平街，街道北边是一些贩卖日常用具的商\n"
"店，南边则是一块空地，从这里可以看到南边的城墙。\n"
msgstr ""

#. es2:d/choyin/crossroad long
#: data/choyin/rooms.json
msgid ""
"这里是昌平街跟承安街的交叉路口，往南就是乔阴县城的南门，往\n"
"北不远处则是衙门的所在地，乔阴县到了这里显得格外安静，路人大多\n"
"沈默地走著，不敢大声喧哗，和城东的花花世界相比，这里显得宁静许\n"
"多。\n"
msgstr ""

#. es2:d/choyin/court1 long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县府衙门的大门，就像你印象中的衙门一般，高大的大\n"
"门、两只巨大的石狮、以及一种令人为之肃然的气氛。门口有一面大皮\n"
"鼓(drum)，不用说，这当然是让百姓击鼓申冤用的，乔阴县的知县据说\n"
"是槐阳王的侄子，虽然算不上是包青天，不过倒也没有听说过有什么贪\n"
"赃枉法的劣迹。\n"
msgstr ""

#. es2:d/choyin/s_gate long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城的南门，由于这个南门是十多年前重建的，因此和\n"
"古老斑驳的东、西、北门相比，南门显得漂亮许多，而且南门正对著县\n"
"府衙门，平日的修缮当然也勤快些。乔阴县城南门外住著许多上次羿水\n"
"河鲁公堤溃决之后迁来的农民，因此虽然出了城门，街道依然人来人往\n"
"，往东是一条沿著城墙的街道，可以经过火龙将军庙入城，西边的街道\n"
"沿著城墙通往新建的驿站，往南则是许多房舍与农田。\n"
msgstr ""

#. es2:d/choyin/dragon_temple long
#: data/choyin/rooms.json
msgid ""
"这里是乔阴县城香火最盛的火龙将军庙，火龙将军据说就是两百年\n"
"前率领官兵和杀死树王的骷髅妖怪作战的黎方黎将军，这里就是当年火\n"
"龙将军驻兵扎营之处，如果你想知道火龙将军的事迹，不妨问问附近的\n"
"年长的居民，将军庙的建筑十分奇特，一条道路东西贯通庙的中央，而\n"
"火龙将军的神像立在横跨道路的一个高台上，往来的行人都从火龙将军\n"
"的脚底走过，要上香的信徒必须从南北两边的阶梯爬上高台。\n"
msgstr ""

#. es2:d/choyin/sw_road1 long
#: data/choyin/rooms.json
msgid ""
"这是一条沿著湖岸的街道，往东北可以通到人车来往的南门广场，\n"
"这一带原本是在乔阴县城的旧南门之外，因此仍然保留浓厚的乡村气息\n"
"，往南是一条小路继续沿著湖岸通往翠柳湖南岸，街道往东通往著名的\n"
"火龙将军庙。\n"
msgstr ""

#. es2:d/choyin/bridge1 long
#. es2:d/choyin/bridge2 long
#. es2:d/choyin/bridge3 long
#. es2:d/choyin/bridge4 long
#. es2:d/choyin/bridge5 long
#: data/choyin/rooms.json
msgid ""
"这是一座弯弯曲曲的曲桥，横过翠柳湖连接东岸的雨桥庄跟西岸的\n"
"乔阴县城，从这里可以欣赏翠柳湖的美景，许多睡莲散布在桥墩四周，\n"
"湖面飘著数不尽的浮萍，浮萍底下有不少艳红锦鲤穿梭来去。\n"
msgstr ""

#. es2:d/choyin/entrance long
#: data/choyin/rooms.json
msgid ""
"这里是雨桥庄西边的曼雩台，也是乔阴县城的文人墨客时常聚集谈\n"
"论诗文的地方，台宽约十丈，西边是连接乔阴县城的翠柳曲桥，从翠柳\n"
"湖中的片片睡莲中弯弯曲曲地通往西边的广场，北边和南边各有数十根\n"
"梁柱，常有许多落拓的士人将他们的作品贴在这里希望得到贵人赏识，\n"
"往东是一片桃树林，春天时和翠柳湖畔的柳树相辉映，蔚为乔阴县的第\n"
"一盛景。\n"
msgstr ""

#. es2:d/choyin/taolin long
#: data/choyin/rooms.json
msgid ""
"这是很大的一片桃林。每年花开的季节，这里一片桃花灿烂，总引得\n"
"邻近的镇集的游客来观看，甚至京城的游客也不乏其人。桃林中阡陌纵横\n"
"，不熟悉此地的游客经常迷路。当然啦，一些先行者在桃树枝上挂了些字\n"
"条以指示道路。看。。字条（note）在那儿。。\n"
msgstr ""

#. es2:d/choyin/yamen_yard long
#: data/choyin/rooms.json
msgid ""
"院内草木繁茂,亭榭错落有致,可见这位县太爷也是位雅人.\n"
msgstr ""

#. es2:d/choyin/yamen long
#: data/choyin/rooms.json
msgid ""
"正中高悬一匾(borad),匾下的书案上放着笔,墨,纸,砚,惊堂木等物.两旁各置屏风.堂下摆着各式刑具,你从未见过.\n"
msgstr ""

#. es2:d/choyin/yamen_iner long
#: data/choyin/rooms.json
msgid ""
"内厅是老爷与好友叙话, 品茶, 吟诗, 作画之所; 格外幽静......\n"
msgstr ""

#. es2:d/choyin/altar long
#: data/choyin/rooms.json
msgid ""
"这里就是奉祀火龙将军的大殿，火龙将军高大威武的神像(statue)\n"
"就立在你的面前，旁边还有火龙将军的部属虎豹熊鹰四位将军，你现在\n"
"所站的地方是横过街道而建的一个高台，隔著栏杆可以看见下面的街道\n"
"川流不息的人群，南北各有一道阶梯往下回到街道。\n"
msgstr ""

#. es2:d/choyin/hotel2 long
#: data/choyin/rooms.json
msgid ""
"这里是福林酒楼的二楼雅座，这里的客人大多衣冠鲜明，若不是富\n"
"豪巨绅，便是秀才举人，使你不知不觉跟著斯文起来，从这里可以眺望\n"
"乔阴县城的市景，东边不远处隔著几栋建筑便是县府衙门，南边是碧波\n"
"荡漾的翠柳湖，湖对岸的雨桥庄在柳树间若隐若现，东边许多民房，再\n"
"过去便是一方方的稻田，北边可望见树王坟的石台，以及乔阴县城北的\n"
"建筑。你可以沿角落的方梯回到一楼，或者到三楼的客房。\n"
msgstr ""

#. es2:d/choyin/hotel3 long
#: data/choyin/rooms.json
msgid ""
"这里是福林酒楼的客房，住的都是一些从外地来的富商大贾，为了\n"
"预防宵小盗窃财物，福林酒楼的汤掌柜特别雇请了许多武师担任守卫的\n"
"工作，往下可以回到二楼。\n"
msgstr ""

#. es2:d/choyin/tomb1 long
#: data/choyin/rooms.json
msgid ""
"这里是树王坟内部的树洞，由于这棵大树实在太大，因此你站在树\n"
"洞里，一点也不觉得局促，树洞约有两个人的高度那么深，你可以攀附\n"
"粗糙的洞壁往上离开，东边的树根比较少，露出一些土层，北边跟西边\n"
"则是树洞的另一端。\n"
msgstr ""

#. es2:d/choyin/tomb2 long
#: data/choyin/rooms.json
msgid ""
"这里是树王坟树洞的内部，你的北、西、南三面都是盘根错节的树\n"
"根，地面上铺著一堆乾草，似乎有人睡过的样子，往东的出口通往树洞\n"
"的另一端。\n"
msgstr ""

#. es2:d/choyin/tomb3 long
#: data/choyin/rooms.json
msgid ""
"这里是树王坟树洞的内部，你在这里可以闻到一股浓郁的檀香，奇\n"
"怪的是，这棵大树并不是檀木，却不知这股香味从哪里来？往南的出口\n"
"通往树洞的另一端。\n"
msgstr ""

#. es2:d/choyin/lionroom long
#: data/choyin/rooms.json
msgid ""
"洞内黑漆漆的，几乎什么都看不见，只是在一个角落里\n"
"有两点红光闪烁，凭你多年的经验，那一定是一双野兽的眼\n"
"睛。这个地方最好不要久留。\n"
msgstr ""

#. es2:d/choyin/solidpath1 long
#: data/choyin/rooms.json
msgid ""
"黄土铺就的小路.阴雨天,泥泞难行.往南就上山了.\n"
msgstr ""

#. es2:d/choyin/solidpath2 long
#: data/choyin/rooms.json
msgid ""
"荒野中的小路,依稀可变,蜿蜒曲折,不知通向何方.\n"
msgstr ""

#. es2:d/choyin/cloudpool long
#: data/choyin/rooms.json
msgid ""
"云梦大泽八百里,雾气沼沼,商旅绝行.\n"
msgstr ""

#. es2:d/choyin/rockpath2 long
#: data/choyin/rooms.json
msgid ""
"    铺路的青石采自桐柏山.因行人稀少,已快被茅草遮没.\n"
msgstr ""

#. es2:d/choyin/rockpath1 long
#: data/choyin/rooms.json
msgid ""
"铺路的青石采自桐柏山.因行人稀少,已快被茅草遮没.\n"
msgstr ""

#. es2:d/choyin/rockyu long
#: data/choyin/rooms.json
msgid ""
"此地山势平缓,山坡尽是湘妃竹.南面就是桐柏山了,西面即为隐士结庐修身之所\n"
".往北可见下山的青石小径.\n"
msgstr ""

#. es2:d/choyin/fence long
#: data/choyin/rooms.json
msgid ""
"诺大的一片竹林，密密匝匝，望不道尽头。游目四顾，没有路了。\n"
"微风乍起，竹林深处现出一角竹篱(fence)。\n"
msgstr ""

#. es2:d/choyin/club long
#: data/choyin/rooms.json
msgid ""
"一间由白茅草搭成的草堂，室内仅有一竹榻，一矮几，四把竹椅．堂前一幅拓片装裱精\n"
"致，上书:\n"
"      书有未曾经我读\n"
"      事无不可对人言\n"
"矮几上摊有书卷(books)放着一支朱砂笔，一房歙砚竟题有岳武穆藏，另几张上好生宣． \n"
msgstr ""

#. es2:d/choyin/yard long
#. es2:d/city/house1 long
#: data/choyin/rooms.json data/city/rooms.json
msgid ""
"这是一间什麽也没有的空房间。\n"
msgstr ""

#. es2:d/choyin/tongbhill long
#: data/choyin/rooms.json
msgid ""
"鬼神皆修于桐柏,故而此地人烟稀少,仅山下青石峪的那位隐士结庐在此.东边山\n"
"壁天成一洞,据传是姑射山的仙人炼丹之所,终日烈焰雄雄,烤得此地寸草不生.\n"
"然而,一株老松仍枝繁叶茂,立于巨石(stone)之上.\n"
msgstr ""

#. es2:d/choyin/stove long
#: data/choyin/rooms.json
msgid ""
"雷霆不断击向一粒粒仙丹,仙丹慢慢由黑转为红色.你注意到炉门好象开着.\n"
msgstr ""

#. es2:d/choyin/spath long
#: data/choyin/rooms.json
msgid ""
"这是一条土路，路旁隐约可见房舍，皆已破败。往南是一座高山，\n"
"据说有鬼怪出没。\n"
msgstr ""

#. es2:d/choyin/rockroad long
#: data/choyin/rooms.json
msgid ""
"    这是一条铺著砾石的上路，险峻难行。南面一座高山，云雾\n"
"缭绕险峻异常。山前断碑字迹依稀可辨--「姑射山』。传说中有\n"
"位仙人曾居于此地，不知如今还在不在......\n"
msgstr ""

#. es2:d/choyin/guyehill long
#: data/choyin/rooms.json
msgid ""
"    采药人言曰：有仙人乘鹤飞升，径入此山，不知所终.....\n"
"此地林木(tree)繁茂，藤蔓(vine)错杂。南耸绝壁，下临深谷.\n"
"半山腰处，隐隐可见一洞，流云出岫。\n"
msgstr ""

#. es2:d/choyin/craneroom long
#: data/choyin/rooms.json
msgid ""
"古树果非寻常之物，树冠白雾升腾，上接霄汉，如仙境一般，让人流连忘返...\n"
msgstr ""

#. es2:d/choyin/halfhole long
#: data/choyin/rooms.json
msgid ""
"这里就是半山腰处的山洞。四壁空无一物，极为荒凉......\n"
msgstr ""

#. es2:d/choyin/platform long
#: data/choyin/rooms.json
msgid ""
"姑射之巅，祥云朵朵，瑞彩千条。藐姑射之山，有神人居焉，肌肤若冰雪，绰约如处子..\n"
"仙踪难觅，只觉风声飒然，云开之出，凸现一座云台(platform)\n"
msgstr ""

#. es2:d/choyin/hollow long
#. es2:d/choyin/hollow1 long
#: data/choyin/rooms.json
msgid ""
"两面皆为峭壁，光滑无物。一阵寒谷幽香，沁人心脾，却不知来自何方。。。\n"
msgstr ""

#. es2:d/choyin/hollow2 long
#: data/choyin/rooms.json
msgid ""
"    两面皆为峭壁，光滑无物。一阵寒谷幽香，沁人心脾，却不知来自何方。。。\n"
msgstr ""

#. es2:d/choyin/hollow3 long
#: data/choyin/rooms.json
msgid ""
"两面皆为峭壁，光滑无物。一株寒谷幽兰,暗香浮动，沁人心脾。山壁天然行成\n"
"一空穴(vase),积满寒露.\n"
msgstr ""

#. choyin.club refuses.pray
#: data/choyin/world.json
msgid "也不知道隐士怎么弄的，你的玛瑙手镯不灵验了。"
msgstr ""

#. choyin.club refuses.dancing
#: data/choyin/world.json
msgid "也不知道隐士怎么弄的，你无法跳出专注的舞步。"
msgstr ""

#. choyin.court1.gate name
#: data/choyin/world.json
msgid "衙门大门"
msgstr ""

#. choyin.yamen.door name
#: data/choyin/world.json
msgid "铜钉大门"
msgstr ""

#. choyin.fence.door name
#. choyin.club.door name
#: data/choyin/world.json
msgid "柴门"
msgstr ""

#. choyin.entrance.taolin lines
#: data/choyin/world.json
msgid "东行的道路被骆云舟挡住了."
msgstr ""

#. choyin.club.east_books taken.line
#. choyin.club.west_books taken.line
#: data/choyin/world.json
msgid ""
"你将书放回到矮几。\n"
msgstr ""

#. choyin.club.east_books without
#. choyin.club.west_books without
#: data/choyin/world.json
msgid "你离开草堂!"
msgstr ""

#. choyin.w_street1.landmark.statue action
#: data/choyin/world.json
msgid "举"
msgstr ""

#. choyin.w_street1.landmark.statue messages.lift
#: data/choyin/world.json
msgid "你努力地抬着石狮子，试图抬起一点点。"
msgstr ""

#. choyin.w_street1.landmark.statue messages.open
#: data/choyin/world.json
msgid ""
"石狮子竟然向左移动了尺许，漏出向下的洞穴。\n"
"你从洞口掉了下去。"
msgstr ""

#. choyin.w_street1.landmark.statue messages.closed
#: data/choyin/world.json
msgid "石狮子又缓缓地向右移动了尺许，正好盖住洞口。"
msgstr ""

#. choyin.w_street1.landmark.statue long
#: data/choyin/world.json
msgid ""
"这尊石狮跟一般寻常人家放在门口镇宅避邪的石狮颇有不同，姿势是立\n"
"著的，而且大小要大得多，只怕有几万斤重，从来没见过谁能举起它。\n"
"你注意到石狮的额头上刻著一个「举」字，不知是何用意？\n"
msgstr ""

#. choyin.tree_tomb.landmark.hole name
#: data/choyin/world.json
msgid "大洞"
msgstr ""

#. choyin.tree_tomb.landmark.hole action
#. canyon.road.chain act.verb
#: data/choyin/world.json data/canyon/world.json
msgid "爬下去"
msgstr ""

#. choyin.tree_tomb.landmark.hole messages.use
#: data/choyin/world.json
msgid "你攀著粗糙的洞壁，爬进了树桩中间的大洞。"
msgstr ""

#. choyin.tree_tomb.landmark.hole long
#: data/choyin/world.json
msgid ""
"一个黑漆漆的大洞，看来像是什么蛀虫蛀出来的，可是天底下哪里\n"
"有这么大的蛀虫？这个洞连人也进得去。\n"
msgstr ""

#. choyin.tree_tomb.landmark.shrine name
#: data/choyin/world.json
msgid "小庙"
msgstr ""

#. choyin.tree_tomb.landmark.shrine long
#: data/choyin/world.json
msgid ""
"一间砖砌的小庙，庙里供奉的当然就是「树王公」，你注意到庙里\n"
"树王公的神像左手残缺不全，木刻的神像竟然有一条条白蚁的痕迹，和\n"
"一般庙里金身神像给人的印象不太一样。\n"
msgstr ""

#. choyin.fence.landmark.fence name
#: data/choyin/world.json
msgid "竹篱"
msgstr ""

#. choyin.fence.landmark.fence long
#: data/choyin/world.json
msgid ""
"篱笆依地势而曲折延伸，你注意到柴门里面有一间草堂。\n"
msgstr ""

#. choyin.club.landmark.books name
#. choyin.club.scratch name
#: data/choyin/world.json
msgid "书卷"
msgstr ""

#. choyin.club.landmark.books long
#: data/choyin/world.json
msgid ""
"几上的书信手而放，装帧古朴，竟是宋版书，还有几卷汉碑原拓。你按捺不住好奇心想拿\n"
"起来(scratch)仔细研究一番。\n"
msgstr ""

#. choyin.guyehill.landmark.vine messages.hold
#: data/choyin/world.json
msgid "你伸手往不远处的一根藤蔓抓去...."
msgstr ""

#. choyin.guyehill.landmark.vine messages.fall
#: data/choyin/world.json
msgid "只听见一声杀猪般的惨叫，你已坠落深谷。。"
msgstr ""

#. choyin.guyehill.landmark.vine messages.climb
#: data/choyin/world.json
msgid "你手脚俐落地攀附著藤蔓，慢慢地爬近山洞。"
msgstr ""

#. choyin.guyehill.landmark.vine long
#: data/choyin/world.json
msgid ""
"其中有一根藤蔓距离你比较近，你可以试著抓住(hold)藤蔓\n"
msgstr ""

#. choyin.guyehill.landmark.tree name
#: data/choyin/world.json
msgid "古树"
msgstr ""

#. choyin.guyehill.landmark.tree messages.use
#: data/choyin/world.json
msgid "你七手八脚地爬上了古树。"
msgstr ""

#. choyin.guyehill.landmark.tree long
#: data/choyin/world.json
msgid ""
"这是一株万年古树，寻常人等休想爬得上去.\n"
msgstr ""

#. choyin.platform.landmark.platform long
#: data/choyin/world.json
msgid ""
"一座精雕细琢的玉台,放有一矮几;几上立有玉瓶,几株寒谷幽兰\n"
"绽放其中.台旁置一云幡(flag),可是仙家宝物.\n"
msgstr ""

#. choyin.platform.landmark.flag name
#: data/choyin/world.json
msgid "云幡"
msgstr ""

#. choyin.platform.landmark.flag action
#: data/choyin/world.json
msgid "碰云幡"
msgstr ""

#. choyin.platform.landmark.flag messages.use
#: data/choyin/world.json
msgid ""
"你碰了云幡,云幡动了一下.....\n"
"白光一闪,云台忽地裂开"
msgstr ""

#. choyin.platform.landmark.flag long
#: data/choyin/world.json
msgid ""
"此幡可翻云覆雨,最好不要碰(touch)它.\n"
msgstr ""

#. choyin.hollow3.landmark.vase name
#: data/choyin/world.json
msgid "空穴"
msgstr ""

#. choyin.hollow3.landmark.vase action
#: data/choyin/world.json
msgid "插幽兰"
msgstr ""

#. choyin.hollow3.landmark.vase messages.use
#: data/choyin/world.json
msgid "寒谷幽兰忽地绽放,幻出七色光华.你轻轻地飘起..."
msgstr ""

#. choyin.hollow3.landmark.vase long
#: data/choyin/world.json
msgid ""
"石穴呈瓶状,想是用来插(interject)什么东东的.\n"
msgstr ""

#. choyin.lionroom.landmark.dark name
#. choyin.lionroom.smell name
#: data/choyin/world.json
msgid "洞穴"
msgstr ""

#. choyin.lionroom.landmark.dark messages.use
#: data/choyin/world.json
msgid "你在洞里苦等良久，终于昏昏沉沉地睡了过去……醒来时，你已经躺在雪亭镇的饮风客栈里。"
msgstr ""

#. choyin.lionroom.landmark.dark long
#: data/choyin/world.json
msgid ""
"洞内黑漆漆的，四下摸索，却摸不到任何出口。\n"
msgstr ""

#. choyin.taolin.landmark.note name
#: data/choyin/world.json
msgid "字条"
msgstr ""

#. choyin.taolin.landmark.note action
#. native:fanfang/bronze_tablet act.verb
#. native:lancheng/xuanmang act.verb
#. native:village/soul_impaler act.verb
#: data/choyin/world.json data/fanfang/items.json data/lancheng/items.json data/native/items.json
msgid "读"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "欲将愁心附明月,随君直到夜郎--"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "问君能有几多愁,恰似一江春水向--流"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "自笑堂堂汉使,得似洋洋河水,依旧只流--"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "--朝四百八十寺,多少楼台烟雨中"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "孔雀--飞,五里一徘徊"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "帘卷--风,人比黄花叟"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "醉别--楼醒不记,春梦秋云,聚散真容易"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "春草绿色,春水碧波,送君--埔,伤之如何"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "--望，射天狼"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "--风卷地白草折，胡天八月即飞雪"
msgstr ""

#. choyin.taolin.landmark.note notes.text
#: data/choyin/world.json
msgid "青山横--郭，白水绕东城"
msgstr ""

#. choyin.taolin.landmark.note messages.read
#: data/choyin/world.json
msgid "你看见:{note}"
msgstr ""

#. choyin.taolin.landmark.note messages.out
#: data/choyin/world.json
msgid "你走出了桃林"
msgstr ""

#. choyin.taolin.landmark.note long
#: data/choyin/world.json
msgid ""
"这是一张指示路径的字条.似乎可以读(read)它.\n"
msgstr ""

#. choyin.taolin.landmark.grove messages.use
#: data/choyin/world.json
msgid "你在桃林里苦等良久，终于昏昏沉沉地睡了过去……醒来时，你已经躺在雪亭镇的饮风客栈里。"
msgstr ""

#. choyin.taolin.landmark.grove long
#: data/choyin/world.json
msgid ""
"桃树一株挨着一株，阡陌纵横，每条小路看来都差不多。找不到出路的话，就只能在这里等下去了。\n"
msgstr ""

#. choyin.s_street1.well name
#. choyin.s_street1.drink name
#: data/choyin/world.json
msgid "大井"
msgstr ""

#. choyin.s_street1.drink act.verb
#: data/choyin/world.json
msgid "喝水"
msgstr ""

#. choyin.s_street1.drink act.acts.steps.line
#: data/choyin/world.json
msgid ""
"你在井边用杯子舀起井水喝了几口。\n"
msgstr ""

#. choyin.s_street1.drink act.acts.steps.line
#: data/choyin/world.json
msgid ""
"你已经再也喝不下一滴水了。\n"
msgstr ""

#. choyin.cloudpool.water name
#: data/choyin/world.json
msgid "大泽"
msgstr ""

#. choyin.lionroom.smell act.verb
#: data/choyin/world.json
msgid "闻忘忧草"
msgstr ""

#. choyin.lionroom.smell act.acts.steps.line
#: data/choyin/world.json
msgid ""
"一阵怪风骤然刮起，你仿佛腾云驾雾般。\n"
msgstr ""

#. choyin.lionroom.smell act.acts.steps.line
#: data/choyin/world.json
msgid ""
"你身上没有忘忧草啊。\n"
msgstr ""

#. choyin.court1.drum name
#: data/choyin/world.json
msgid "大皮鼓"
msgstr ""

#. choyin.court1.drum act.verb
#: data/choyin/world.json
msgid "击鼓"
msgstr ""

#. choyin.court1.drum act.acts.steps.line
#: data/choyin/world.json
msgid ""
"鼓已经击过了。衙门的大门开着，直走进去就是。\n"
msgstr ""

#. choyin.court1.drum act.acts.ask
#: data/choyin/world.json
msgid ""
"你抡起鼓槌，「咚——咚——咚——」三声。\n"
"带刀侍卫从衙门内院走了出来，看了看你，说道：是你击鼓申冤吗？"
msgstr ""

#. choyin.court1.drum act.acts.choice
#: data/choyin/world.json
msgid "是"
msgstr ""

#. choyin.court1.drum act.acts.steps.say
#: data/choyin/world.json
msgid "好吧，跟我来...."
msgstr ""

#. choyin.court1.drum act.acts.steps.line
#: data/choyin/world.json
msgid ""
"衙门的大门「吱呀」一声开了。带刀侍卫转身进去，没有回头。\n"
msgstr ""

#. choyin.court1.drum act.acts.steps.line
#: data/choyin/world.json
msgid ""
"你抡起鼓槌，「咚——咚——咚——」三声。\n"
msgstr ""

#. choyin.court1.drum act.acts.steps.emote
#: data/choyin/world.json
msgid "从衙门内院走了出来，看了看你两手空空。"
msgstr ""

#. choyin.court1.drum act.acts.steps.say
#: data/choyin/world.json
msgid "空口无凭，回去吧。"
msgstr ""

#. choyin.club.scratch act.verb
#: data/choyin/world.json
msgid "拿书"
msgstr ""

#. choyin.club.scratch act.acts.steps.line
#: data/choyin/world.json
msgid ""
"你乘人不备，抓起一本书藏入怀中。\n"
msgstr ""

#. canyon.npc.door_guard long
#: data/canyon/npcs.json
msgid ""
"他看起来有点精悍，手中紧握著刀，惊惊颤颤的样子。\n"
msgstr ""

#. canyon.npc.guard1 long
#. canyon.npc.guard2 long
#: data/canyon/npcs.json
msgid ""
"风沙满面，无精打采，毫无生气的样子，真难以想像是这\n"
"里的守军。\n"
msgstr ""

#. canyon.npc.guard2 chat_msg
#: data/canyon/npcs.json
msgid ""
"老兵说道：军师真是神算啊，把那狗贼都吓的不敢再来了。\n"
msgstr ""

#. canyon.npc.guard2 chat_msg
#: data/canyon/npcs.json
msgid ""
"老兵说道：听说那个后备兵捡到了一个黄澄澄的宝物。\n"
msgstr ""

#. canyon.npc.guard2 chat_msg
#: data/canyon/npcs.json
msgid ""
"老兵说道：嘿！有没有钱啊？挡点钱来花花吧！\n"
msgstr ""

#. canyon.npc.guard2 inquiry topic
#. canyon.npc.captain inquiry topic
#. canyon.npc.leader2 inquiry topic
#. canyon.npc.general inquiry topic
#. native.npc.feng_ce inquiry topic
#. native.npc.song_pu inquiry topic
#. native.npc.onlooker inquiry topic
#: data/canyon/npcs.json data/native/npcs.json
msgid "黄石隘口"
msgstr ""

#. canyon.npc.guard2 inquiry.黄石隘口
#: data/canyon/npcs.json
msgid ""
"这个问题问我们大队长比较知道。\n"
msgstr ""

#. canyon.npc.guard2 inquiry topic
#. canyon.npc.leader2 inquiry topic
#. canyon.npc.general inquiry topic
#. canyon.npc.seller name
#: data/canyon/npcs.json
msgid "后备兵"
msgstr ""

#. canyon.npc.guard2 inquiry.后备兵
#: data/canyon/npcs.json
msgid ""
"嘿嘿！你想做啥？\n"
msgstr ""

#. canyon.npc.guard2 inquiry topic
#: data/canyon/npcs.json
msgid "军火库"
msgstr ""

#. canyon.npc.guard2 inquiry.军火库
#: data/canyon/npcs.json
msgid ""
"你问这个喔..........不予回答。\n"
msgstr ""

#. canyon.npc.leader1 long
#. canyon.npc.leader2 long
#: data/canyon/npcs.json
msgid ""
"不苟言笑的样子，带领著小兵驻守隘口的小队长。\n"
msgstr ""

#. canyon.npc.captain long
#: data/canyon/npcs.json
msgid ""
"他不苟言笑的样子，带领著小兵驻守隘口的队长。\n"
msgstr ""

#. canyon.npc.captain chat_msg
#: data/canyon/npcs.json
msgid ""
"大队长说道：有没有问题要问我啊？\n"
msgstr ""

#. canyon.npc.captain chat_msg
#: data/canyon/npcs.json
msgid ""
"大队长说道：我对这里很熟的喔。\n"
msgstr ""

#. canyon.npc.captain inquiry topic
#: data/canyon/npcs.json
msgid "允许"
msgstr ""

#. canyon.npc.captain inquiry.允许
#: data/canyon/npcs.json
msgid ""
"先给钱再说吧。\n"
msgstr ""

#. canyon.npc.captain inquiry.兵器库
#: data/canyon/npcs.json
msgid ""
"喔！那是我们厉害的军师所设的阵法。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"二十多年前，先帝将大将军们调来这里驻守隘口。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"京城的也就因隘口的巩固而获得安全。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"事隔多年，先帝也死了，换上的是位我们不甚认识的小皇帝。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"看来他只忙著找剑，也没什么大作为，大家也不太服他。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"皇帝看到大将军还要敬畏三分ㄌㄟ。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"反正啊，将军和军师是超强的，你可要好好的乌西我们才行。\n"
msgstr ""

#. canyon.npc.captain inquiry.黄石隘口.rules.make.lines.line
#: data/canyon/npcs.json
msgid ""
"知道了，就快缴钱。\n"
msgstr ""

#. canyon.npc.captain accept_object.say
#. canyon.npc.general accept_object.say
#. canyon.npc.adviser accept_object.say
#: data/canyon/npcs.json
msgid "ㄟ....Ｔhank Ｙou!!!"
msgstr ""

#. canyon.npc.captain accept_object.line
#: data/canyon/npcs.json
msgid ""
"大队长说道:哦喔！还真有心啊，真是谢谢你了。\n"
msgstr ""

#. canyon.npc.captain accept_object.line
#: data/canyon/npcs.json
msgid ""
"大队长说道:我已帮你列入名册了，从今天你可自由地出入营区了。\n"
msgstr ""

#. canyon.npc.captain accept_object.line
#: data/canyon/npcs.json
msgid ""
"大队长说道:你的诚意不够喔，再多缴点吧。\n"
msgstr ""

#. canyon.npc.leader2 chat_msg
#: data/canyon/npcs.json
msgid ""
"老队长说道：大队长对这个地方好熟，还常常说些这里的故事给我们听。\n"
msgstr ""

#. canyon.npc.leader2 chat_msg
#: data/canyon/npcs.json
msgid ""
"老队长说道：你有没有搞错啊！来这里不给我们大队长过路费，你找死啊！\n"
msgstr ""

#. canyon.npc.leader2 chat_msg
#: data/canyon/npcs.json
msgid ""
"老队长说道：兵器库入口处的阵法真是厉害，一般人绝对找不到的。\n"
msgstr ""

#. canyon.npc.leader2 inquiry.黄石隘口
#: data/canyon/npcs.json
msgid ""
"你问问大队长吧，我不是很清楚。\n"
msgstr ""

#. canyon.npc.leader2 inquiry.后备兵
#: data/canyon/npcs.json
msgid ""
"后备兵就..........你想做什么？找死啊。\n"
msgstr ""

#. canyon.npc.vice_general title
#: data/canyon/npcs.json
msgid "副将"
msgstr ""

#. canyon.npc.vice_general long
#: data/canyon/npcs.json
msgid ""
"原是禁卫军的队长，也因其强大的声望和实力，被先帝调离京师\n"
"和镇国大将军共同镇守黄石隘口。\n"
msgstr ""

#. canyon.npc.vice_general greeting.rules.steps.say
#: data/canyon/npcs.json
msgid "大胆狂徒，竟私闯此地，给我滚出去"
msgstr ""

#. canyon.npc.general nickname
#: data/canyon/npcs.json
msgid "镇国大将军"
msgstr ""

#. canyon.npc.general title
#: data/canyon/npcs.json
msgid "天邪派第十六代弟子"
msgstr ""

#. canyon.npc.general long
#: data/canyon/npcs.json
msgid ""
"容光焕发，左佩刀，右佩剑，威风凛凛，其高七尺六寸，虎背\n"
"熊腰，年轻时同和大天邪于兰天武同拜一师，武功造诣不在大\n"
"天邪之下，但志向不同，后成了京师武功第一、人人称羡的镇\n"
"国大将军。\n"
msgstr ""

#. canyon.npc.general inquiry.黄石隘口
#: data/canyon/npcs.json
msgid ""
"你眼睛脱窗啊，这里就是黄石隘口。\n"
msgstr ""

#. canyon.npc.general inquiry.后备兵
#: data/canyon/npcs.json
msgid ""
"我不管这种事的，你别来烦我。\n"
msgstr ""

#. canyon.npc.general inquiry.兵器库
#: data/canyon/npcs.json
msgid ""
"你找死啊！问这种问题，你想干麻啊。\n"
msgstr ""

#. canyon.npc.general inquiry.印鉴
#. canyon.npc.general inquiry.印鉴丢过.rules.say
#: data/canyon/npcs.json
msgid ""
"你怎么知道的？帮我找找吧，找到了我送你礼物。\n"
msgstr ""

#. canyon.npc.general inquiry topic
#. native.npc.pass_gate_soldier inquiry topic
#. native.npc.palace_gate_guard inquiry topic
#: data/canyon/npcs.json data/guanbei/npcs.json
msgid "信"
msgstr ""

#. canyon.npc.general inquiry.信.rules.say
#: data/canyon/npcs.json
msgid "信我看过了。关北的事去问老王爷，我守我的关。"
msgstr ""

#. canyon.npc.general inquiry.信.rules.lines.emote
#: data/canyon/npcs.json
msgid "接过信，扫了一眼，眉毛挑了挑。"
msgstr ""

#. canyon.npc.general inquiry.信.rules.lines.say
#: data/canyon/npcs.json
msgid "程不平？老王爷那个读书的侄子。乔阴县的官管到我天驼关来了。"
msgstr ""

#. canyon.npc.general inquiry.信.rules.lines.say
#: data/canyon/npcs.json
msgid "兵部的印是真的，令不是先帝的——这话他敢写，我不敢说。我的印丢过一回，找回来了。这事军师比我清楚，你去问他。"
msgstr ""

#. canyon.npc.general inquiry.信.rules.lines.say
#: data/canyon/npcs.json
msgid "出关往北，谷地东壁有一道关门，我的兵守着。凭这封信，他们放你。关北是槐阳王的地界，到了那边，别提我。"
msgstr ""

#. canyon.npc.general inquiry.信.rules.say
#: data/canyon/npcs.json
msgid "程县令写了信？信呢？……没有信，关上的兵不认。丢了就回乔阴，找程县令再写一封。"
msgstr ""

#. canyon.npc.general inquiry.程不平.rules.say
#: data/canyon/npcs.json
msgid "老王爷的侄子，清贫廉正，榜中探花——书读多了的人才敢写那种信。"
msgstr ""

#. canyon.npc.general inquiry.程不平.rules.say
#: data/canyon/npcs.json
msgid "乔阴的县官？我不认识。"
msgstr ""

#. canyon.npc.general inquiry topic
#: data/canyon/npcs.json
msgid "印鉴丢过"
msgstr ""

#. canyon.npc.general inquiry.印鉴丢过.rules.say
#: data/canyon/npcs.json
msgid "丢过一回，三天，找回来了。丢在谁手里、那三天有人拿它做过什么，我不想知道。军师知道。"
msgstr ""

#. canyon.npc.general inquiry.关北.rules.say
#: data/canyon/npcs.json
msgid "槐阳王的封国。老王爷和我不对付——他嫌我收过路钱，我嫌他不奉诏。可他不是庾子建的人，我也不是。"
msgstr ""

#. canyon.npc.general inquiry.关北.rules.say
#: data/canyon/npcs.json
msgid "关北是槐阳王的地界。问这个干什么。"
msgstr ""

#. canyon.npc.general accept_object.lines.say
#. city.npc.waiter accept_object.say
#: data/canyon/npcs.json data/city/npcs.json
msgid "真是谢谢你了。"
msgstr ""

#. canyon.npc.general accept_object.lines.say
#: data/canyon/npcs.json
msgid "为了答谢你，这把古剑送你，当做报酬吧。"
msgstr ""

#. canyon.npc.general accept_object.lines.say
#: data/canyon/npcs.json
msgid "你拿给我的是什么东西啊!"
msgstr ""

#. canyon.npc.general accept_object.lines.say
#: data/canyon/npcs.json
msgid "别想拿这种东西来骗我"
msgstr ""

#. canyon.npc.general accept_object.lines.say
#: data/canyon/npcs.json
msgid "给我滚出去"
msgstr ""

#. canyon.npc.general accept_object.say
#: data/canyon/npcs.json
msgid "啊，真是谢谢你了。"
msgstr ""

#. canyon.npc.adviser title
#: data/canyon/npcs.json
msgid "军师"
msgstr ""

#. canyon.npc.adviser long
#: data/canyon/npcs.json
msgid ""
"道光满面，睿智不言而现，气象万千，显然是茅山术高手中的高\n"
"手，经纶羽扇，和大将军正是绝配。\n"
msgstr ""

#. canyon.npc.adviser inquiry.兵器库
#: data/canyon/npcs.json
msgid ""
"先看看你的诚意再说罗。\n"
msgstr ""

#. canyon.npc.adviser inquiry.印鉴.rules.say
#: data/canyon/npcs.json
msgid "模子给你了，别的我不知道。将军问起来，你没见过我。"
msgstr ""

#. canyon.npc.adviser inquiry.印鉴.rules.say
#: data/canyon/npcs.json
msgid "将军的印？丢过一回，又找回来了——这事我知道一点。八两银子，我告诉你一桩秘密。先看看你的诚意。"
msgstr ""

#. canyon.npc.adviser inquiry.印鉴.rules.say
#: data/canyon/npcs.json
msgid "将军的印鉴？你去问将军。"
msgstr ""

#. canyon.npc.adviser inquiry topic
#: data/canyon/npcs.json
msgid "拓模"
msgstr ""

#. canyon.npc.adviser inquiry.拓模.rules.say
#: data/canyon/npcs.json
msgid "说过了。模子在你手里，印色也在上面——自己去比。"
msgstr ""

#. canyon.npc.adviser inquiry.拓模.rules.say
#: data/canyon/npcs.json
msgid "什么模子？我不懂你说什么。"
msgstr ""

#. canyon.npc.adviser accept_object.lines.say
#: data/canyon/npcs.json
msgid "好极了，我就告诉你一项秘密吧。"
msgstr ""

#. canyon.npc.adviser accept_object.lines.say
#: data/canyon/npcs.json
msgid "将军的印丢的那几天，在后备兵手里。我借来看了一夜——拓了个模子。兵部来的人出了价，比你多，模子就卖了一份给他们。"
msgstr ""

#. canyon.npc.adviser accept_object.lines.say
#: data/canyon/npcs.json
msgid "这一份留着的你拿去。模子上的朱砂是真印的印色，拿它比一比你那叠文书上的印，就明白了。"
msgstr ""

#. canyon.npc.adviser accept_object.say
#: data/canyon/npcs.json
msgid "即然你那么有心，那我就勉强收起来了。"
msgstr ""

#. canyon.npc.adviser accept_object.lines.say
#: data/canyon/npcs.json
msgid "在那片光滑的山壁前发誓 我爱.....。"
msgstr ""

#. canyon.npc.adviser accept_object.lines.say
#: data/canyon/npcs.json
msgid "或许你可以发现奇特的事喔。"
msgstr ""

#. canyon.npc.adviser accept_object.say
#: data/canyon/npcs.json
msgid "钱太少了吧！没收。"
msgstr ""

#. canyon.npc.seller long
#: data/canyon/npcs.json
msgid ""
"环顾四方，眼神锐利，看来想杀价是不可能的事了。\n"
msgstr ""

#. canyon.npc.seller inquiry topic
#: data/canyon/npcs.json
msgid "印色"
msgstr ""

#. canyon.npc.seller inquiry.印色.rules.say
#: data/canyon/npcs.json
msgid "你也问印色？假的那颗是黄铜浇的，没上过朱砂，盖出来发黑。真的那颗泛黄光，盖出来是正红——印泥一比就知道。军师那几天借过真印，别的你问他。"
msgstr ""

#. canyon.npc.seller inquiry.印色.rules.say
#: data/canyon/npcs.json
msgid "印色？我这儿只有印，没有色。"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "我已经给你了啊。"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "那么多钱，那我就没收了:P"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "不亏是武林中人，一眼就看出端倪了"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "这个印鉴就看在钱的份上和你交换了"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "好吧！即然被你发现了，只好认栽了。"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "这个真的你就拿去吧"
msgstr ""

#. canyon.npc.seller accept_object.say
#: data/canyon/npcs.json
msgid "你给我这个做什么？我不要，你拿回去吧。"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "如果是钱的话，我先没收了。"
msgstr ""

#. canyon.npc.seller accept_object.lines.say
#: data/canyon/npcs.json
msgid "其他的东西我都不要，别再来烦我了。"
msgstr ""

#. es2:d/canyon/road long
#: data/canyon/rooms.json
msgid ""
"你正走在碎石小路上，荒凉的景色，不难想像，这里人烟稀少，很少\n"
"人会走到这里来，在路尾是一半圆形的土堆，其下有一铁索，爬下铁索(\n"
"chain)就可以通达黄石隘口，而东北方是衔接至雪亭镇的青石官道。\n"
msgstr ""

#. es2:d/canyon/canyon1 long
#: data/canyon/rooms.json
msgid ""
"脚下为碎石黄土路，两侧是高耸入云的荒山，向上仰望乃似无边无际\n"
"穹空，北缘为一山壁，壁上有一长达十七、八丈的铁索(chain) ，上面大\n"
"概就是人家所谓的「关外绿洲－雪亭镇」。\n"
msgstr ""

#. es2:d/canyon/canyon2 long
#: data/canyon/rooms.json
msgid ""
"来到这里，脚下的黄土仍是厚厚的一层，可见得来往这条道路的人必\n"
"不多，向北即是隘口尾，往南一直通达天驼关口，两侧依旧是荒冷的山壁\n"
"，但似乎更为严峻。\n"
msgstr ""

#. es2:d/canyon/canyon3 long
#: data/canyon/rooms.json
msgid ""
"黄土、黄石还是平铺于小路上，崎岖的道路来到这里是比北方平缓多\n"
"了，向南二十里就是天驼关口了，东侧为军营，但军营四周为铁栅所包围\n"
"，想从这里进入军营内似乎是不太可能。\n"
msgstr ""

#. es2:d/canyon/canyon4 long
#: data/canyon/rooms.json
msgid ""
"来到这里，风势比其他地方大了许多，或许是因为东边为军营入口通\n"
"风较为良好的原因，南方一十里路的地方就是京城关口－天驼关的入口，\n"
"在西边的山壁似乎过于平滑，不太自然，或许这里有什么秘密也说不定。\n"
msgstr ""

#. es2:d/canyon/canyon5 long
#: data/canyon/rooms.json
msgid ""
"南边即为天驼关的关口，两片诺大的铁门(door)，若非由关内打开恐\n"
"怕难以进入，往东侧看去，铁栅的映满你整双眼眸，转向西侧，看到的还\n"
"是一片光秃秃的山壁，不由得使你想早点离开这个地方。\n"
msgstr ""

#. es2:d/canyon/canyon6 long
#: data/canyon/rooms.json
msgid ""
"高耸的悬崖立在天驼关两侧，中间是并不开阔的谷地，真是易守难\n"
"攻的好地方，这么多年来与异族的关系一直非常缓和，因此大门又重新\n"
"打开。铁门的后面有个很大的机械装置(machine)，向南是通往京城的\n"
"路，往北就出了天驼关。\n"
msgstr ""

#. es2:d/canyon/canyon7 long
#: data/canyon/rooms.json
msgid ""
"天驼关两边是悬崖，中间是谷地，形状很象骆驼的双峰，由此得名。\n"
"这里地势险峻，南下通往京师，北上除了“关外绿洲”雪亭镇外就是异族\n"
"的领地了，历来是兵家必争之地。\n"
msgstr ""

#. es2:d/canyon/camp1 long
#: data/canyon/rooms.json
msgid ""
"此处为黄石隘口驻军的入口，东方为军队饮食的地方，在门口的两侧\n"
"有两位小兵正在值勤。南、北两侧为小兵的营帐。\n"
msgstr ""

#. es2:d/canyon/camp2 long
#: data/canyon/rooms.json
msgid ""
"地上有些食物的残渣，而中央地带则有一营火，在边边则有一个水\n"
"井，想必是官兵们用来汲水用的，南北两侧为小队长的营帐，东方则是\n"
"副将军的营帐，如果没有事情冒然进入是会被斥责。\n"
msgstr ""

#. es2:d/canyon/camp3 long
#: data/canyon/rooms.json
msgid ""
"这是个由粗略的布料所搭成的小营帐，里面只有三二个小兵，其他的\n"
"小兵，大概在另一个小兵营帐里赌博聊天吧，而东边则是小队长的营帐。\n"
msgstr ""

#. es2:d/canyon/camp4 long
#: data/canyon/rooms.json
msgid ""
"这里有一大群的小兵，不知道是在做什么，营帐中央有一张桌子，上\n"
"面堆满了各式各样的赌具，小板凳，和茶水。\n"
msgstr ""

#. es2:d/canyon/camp5 long
#: data/canyon/rooms.json
msgid ""
"这里是小队长的营帐，四周仍旧和小兵营帐一样的空旷，但营帐的布\n"
"料倒是比小兵营帐好多了，北侧有两把凉椅，看来定是小队长偷懒时休息\n"
"的地方。\n"
msgstr ""

#. es2:d/canyon/camp6 long
#: data/canyon/rooms.json
msgid ""
"类似北边的营帐，空空荡荡的，看起来一点也不像是军营，一点威武\n"
"的感觉也没有，在这也有两把简易的凉椅，两位队长，平常小兵没有尢许\n"
"是不能擅自进入这里的，向东北是副将营帐，但没有经过「允许」是不得\n"
"进入的。\n"
msgstr ""

#. es2:d/canyon/camp7 long
#: data/canyon/rooms.json
msgid ""
"来到这里，看了四周的景像真会令人不敢相信，和前面的军营竟大不\n"
"相同，虎皮披于军椅，银器列于黑刚曜石桌上，爵为金缘双虎抱图，北侧\n"
"挂著刀、剑、杖，地面上有羊毛软皮铺陈著，确实有副将营帐的味道。\n"
msgstr ""

#. es2:d/canyon/camp8 long
#: data/canyon/rooms.json
msgid ""
"虎头挂于营顶，虎皮披于帐上，威武无比，帐中龙柱顶天，双龙吐珠\n"
"图挂于前，严然有天子之势，金椅银桌，鼎、簋、爵、角、鉴，样样俱全\n"
"，一磬、一鼓、一笙、一笛、一萧，文墨章笔擎于旁，将军在上，参谋在\n"
"右，由不得令人生畏。\n"
msgstr ""

#. es2:d/canyon/blackmarket long
#: data/canyon/rooms.json
msgid ""
"在这里你可以看到墙上挂满了各式各样的武器，不难明了这里是存放\n"
"武器的地方，而墙上写了个诺大的「武」字。\n"
msgstr ""

#. es2:d/canyon/stone_forest1 long
#: data/canyon/rooms.json
msgid ""
"四周是一大遍的林地，草高于三四十尺，再加上雾盲盲的景象，\n"
"使你不得不沿著黄石铺成的小路快步行走，深恐林草压顶，界时将不\n"
"知所措，向东深入似乎有一奇特的光亮，但距离太远，你看不清楚到\n"
"底是怎么著一回事。\n"
msgstr ""

#. es2:d/canyon/stone_forest2 long
#: data/canyon/rooms.json
msgid ""
"草压天顶的情况依旧，唯西侧亮光逐渐显明，看来西侧的不远处\n"
"有一出口，黄石斑斑，挟杂著白色的圆点，像是白色光束长期照射的\n"
"结果，蒙胧的景色在此总算完全的清淅了，向东侧仍是回到路口的路\n"
"，而西侧的亮光直直吸引你往深处探索。\n"
msgstr ""

#. es2:d/canyon/stone_forest3 long
#: data/canyon/rooms.json
msgid ""
"天光点著，华光亮，大概就是这样的一个情形吧，穿过了黄石穿\n"
"林路，一束极大的光注猛然照射到你的身上，犹如沐于春风，心情爽\n"
"朗极了，但面对北侧奇特的镜子居然有种令人不可抗拒的压力，在这\n"
"尺尺地方，镜面反射日光，强照黄石穿林路，想到这让你有种莫名的\n"
"恐惧，在莫名中被吸引而来的恐惧，进入或离开，生死一瞬间。\n"
msgstr ""

#. es2:d/canyon/fantasy1 long
#: data/canyon/rooms.json
msgid ""
"来到镜内，前面呈现三面通道，各个通道皆有其不同的气氛传出\n"
"，中道有浓厚的竹之气息，上道迷香之味不止，下道呕味不停，不定\n"
"的上空，不停蠢地之幻地，空气被抽丝剥茧，呼吸也愈来愈困难，不\n"
"停变动的景象，快决定吧!!暗中之招唤，心中为之一震，快步踏离此\n"
"一不祥的空间。\n"
msgstr ""

#. es2:d/canyon/bamboo/bamboo1 long
#: data/canyon/rooms.json
msgid ""
"修长的竹子映满眼廉，穹空无边，风拂无形，芬芳的气味随著清\n"
"风而漂流著，真有如如沐春风，生机充满的竹林道，让站立其中的人\n"
"皆受其境界而霍然开朗，忘却了江湖的险恶，行止于此，一直气凝字\n"
"之迹，显出居此主人之内力雄厚，亦使你想找点看到居此八泰之地的\n"
"主人是何等的人物。\n"
msgstr ""

#. es2:d/canyon/bamboo/bamboo2 long
#: data/canyon/rooms.json
msgid ""
"此处的竹林比起入口的竹子更为高大耸直，也有些小动物在这四\n"
"周跳来跳去，跑来跑去的，更是生气盎然，不时有也黄莺唱吟著美妙\n"
"的诗句，清新宛然，人间仙境，只是偶尔有那怪异的强风袭卷而致，\n"
"另人难以忍受，在往入探头，有一似人大的黄石挺立于内，而其四周\n"
"隐隐约约有些许正气溢散而出。\n"
msgstr ""

#. es2:d/canyon/bamboo/bamboo3 long
#: data/canyon/rooms.json
msgid ""
"北方有一个大黄石堵住去路，洋洋洒洒的蓝光从大黄石的四周漫\n"
"漫而出，竹林参天，在此成一半凹型，团团围住了北方的去路，若想\n"
"一窥究竟，看来非得推开这巨大的黄石才行，风势愈来愈强，四周的\n"
"竹子发出了嗡嗡的鸣声，彷佛叫人不要靠近，此地之主人看似不欢迎\n"
"别人来参观。\n"
msgstr ""

#. es2:d/canyon/bamboo/train long
#: data/canyon/rooms.json
msgid ""
"飕飕的风不停地向你身上袭卷而来，石室的四周竟有四个大洞各\n"
"分布东南西北四方，向洞外望去亦是一遍遍的竹林，和之前的竹林只\n"
"差在于风势的大小，强风无情的猛击挺立的竹子，竹子左右摇晃的抵\n"
"抗著，正是一幅柔以破刚之图，壁上有一石制书柜(bookcase)，正散\n"
"出阵阵的蓝光，和之前所遇之正气一脉相连，匣中似有一物，看来才\n"
"是正气的来源。\n"
msgstr ""

#. canyon.camp7.east lines
#: data/canyon/world.json
msgid "你还没被允许进入喔。"
msgstr ""

#. canyon.canyon7.east_gate lines
#: data/canyon/world.json
msgid "关门兵横过长枪，拦住你：出关的，留下过路钱——五两。有凭据的拿凭据来。"
msgstr ""

#. canyon.road.landmark.chain long
#: data/canyon/world.json
msgid ""
"    一长条铁索缘山壁而下，或许你可以试著攀爬(climb)。\n"
msgstr ""

#. canyon.canyon1.landmark.chain long
#: data/canyon/world.json
msgid ""
"    一长条铁索缘山壁而上，若无绝佳的体力就好不要轻意攀爬(climb)。\n"
msgstr ""

#. canyon.canyon5.landmark.door long
#: data/canyon/world.json
msgid ""
"这巨大的铁门锈迹斑斑，它是上下开合的，现在已经高高的抬起，\n"
"若它失控砸下，可能什么东西都会被砸扁。\n"
msgstr ""

#. canyon.canyon6.landmark.machine name
#: data/canyon/world.json
msgid "机械装置"
msgstr ""

#. canyon.canyon6.landmark.machine long
#: data/canyon/world.json
msgid ""
"这是个很大的绞盘，可能是开关铁门用的。\n"
msgstr ""

#. canyon.train.landmark.bookcase name
#. canyon.train.bookcase name
#: data/canyon/world.json
msgid "书柜"
msgstr ""

#. canyon.train.landmark.bookcase long
#: data/canyon/world.json
msgid ""
"看起来是个普普通通的柜子，或许你可以search看看。\n"
msgstr ""

#. canyon.road.chain act.acts.steps.line
#: data/canyon/world.json
msgid ""
"你手脚并用，努力地沿著铁索向下攀爬而去。\n"
msgstr ""

