#. guide.money group
#: data/common/codex.json
msgid "入门"
msgstr ""

#. guide.start title
#: data/common/codex.json
msgid "初入江湖"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "走近一个人、一件东西，脚下会出现「E 交互」。按 E（手柄 A）或点它，能做的事都列在交互窗口里；只有一件事可做的，直接就做了。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "不知道往哪里去，就找人「打听」。镇上的人知道这里的事和附近的传闻，有些话题问出来就是一条路。你见过、听过的事都记在菜单的「任务」页，状态卡上的「目标」一行写着眼下最要紧的那件。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "菜单有八页：角色、武学、背包、任务、地图、声望、百科、系统。地图页是一张沙盘，走过的地方都立着模型；说明卡上列着师父、商店、悬赏榜，点一行就给你指路。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "系统页里有三个存档位。换地图、打完一仗也会自动存一份，死了可以回到那里。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "先做什么"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "先在镇上走一圈，和人说说话。饮风客栈的店小二卖吃喝；想学武，就去淳风武馆看看，那里的人肯指点新人。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "打不过的人别硬碰：交互窗口和动手前的确认页都会写出对方比你强还是弱。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "地理"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "雪亭镇在群山之中。镇北的山坳往北是野羊山，往东通青石村。出镇往西，顺着青石官道上山，是天邪派的水烟阁。镇东的大路通到茅山，茅山派的灵心观就在山上；这条路上有岔路往南进老松岭的松林，传说老松寨就在附近，过往的旅客都要格外小心。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "镇南的大街通到绮云镇；往西南走是天驼关。"
msgstr ""

#. guide.start paragraphs
#: data/common/codex.json
msgid "绮云镇往西是晚月庄，庄里多是女子。往南过了渡口是日照山，山烟寺就在山上；过渡口往东走，就到乔阴县城。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "人身上最要紧的是「精」「气」「神」三样。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "学东西的本钱。请教、自学、修行都耗精。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "身体的力气。挨打掉的是气，练功、打坐也耗气。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "心神。研读、冥思都耗神，迷药和蒙汗药伤的也是神。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "当前、有效、最大"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "角色页上每样有三个数。「当前」是眼下还剩多少，歇一歇就回来；「有效」是受伤压低的上限，当前最多只回到这里；「最大」是你的本钱。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "比如气写着当前 67、有效 82、最大 100：说明你受了些伤，歇着最多回到 82。那 18 点伤要等当前回满了才慢慢长回来，用药或疗伤更快。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "三样里哪一样的当前打光了，人就昏倒；伤到连有效也撑不住，就会送命。"
msgstr ""

#. guide.health paragraphs
#: data/common/codex.json
msgid "「最大」不是一成不变的：内力的上限越高，气的本钱越厚；法力、灵力的上限高了，神和精的本钱也跟着长。"
msgstr ""

#. guide.rest title
#: data/common/codex.json
msgid "受伤与歇息"
msgstr ""

#. guide.rest paragraphs
#: data/common/codex.json
msgid "不打架的时候，精气神会自己慢慢回来：先回当前，当前回满了，伤才慢慢好。战斗中不回。回复要时间走：菜单和交互窗口开着时时间停住，什么都不回。"
msgstr ""

#. guide.rest paragraphs
#: data/common/codex.json
msgid "想歇就歇：请教页和武学页上的「歇到回满」让你坐下来，时间照走（快得多），精气神回满就起身。世界不会等你：歇着时有人来找麻烦，你会被惊起，照常开打；口渴没水的时候歇着也回不来。"
msgstr ""

#. guide.rest paragraphs
#: data/common/codex.json
msgid "想快一点：金疮药敷上能治伤；学了内功的人可以运功恢复精、气、神，有的内功还能运功疗伤，耗的都是内力。战斗中不能疗伤。"
msgstr ""

#. guide.rest paragraphs
#: data/common/codex.json
msgid "昏倒以后过一会儿自己会醒。昏着的时候任人宰割，所以别在仇人眼前耗到最后一口气。"
msgstr ""

#. guide.rest paragraphs
#: data/common/codex.json
msgid "中了毒、喝醉了，身上会一阵阵发作。蛇药解蛇毒，酒要等它自己醒。"
msgstr ""

#. guide.food title
#: data/common/codex.json
msgid "吃喝"
msgstr ""

#. guide.food paragraphs
#: data/common/codex.json
msgid "食物和饮水随时间慢慢消耗，角色页上看得到还剩多少。一开始都是满的。"
msgstr ""

#. guide.food paragraphs
#: data/common/codex.json
msgid "食物吃光了，内力、法力、灵力就不再恢复；水喝光了，什么都不再恢复。"
msgstr ""

#. guide.food paragraphs
#: data/common/codex.json
msgid "客栈、饭馆和集市都卖吃喝。牛皮酒袋能灌清水，路上渴了拿出来喝。酒也能解渴，只是喝多了会醉。"
msgstr ""

#. guide.food paragraphs
#: data/common/codex.json
msgid "肚子能装多少看你的体重。吃剩的肉骨头别扔，喂给狗，它会跟着你走。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "人生来有八项天赋，新入江湖时都是 30。天赋很少变动，勤练武艺偶尔会长一点。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "力气。打得更重，背得更多，拿得动沉重的兵器。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "敢不敢抢攻。自动对打时，胆识高的人出手更勤；不少师父收徒也看它。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "天资。学武功更快、耗精更少，打架时也更容易长进。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "精神方面的体质。冥思、修行长得快，不少法门也看它。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "临危不乱。对手想抢攻要先过你这一关；打空了也不容易露破绽，还压得住杀气。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "长相。有人看脸说话，也有师父看长相收人。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "体质。精气神恢复得快，打坐长内力快，昏倒后醒得早，酒量也大。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "运气。容易遇上一般人碰不到的机缘，好事坏事都有。"
msgstr ""

#. guide.gift paragraphs
#: data/common/codex.json
msgid "药物、装备带来的变化只算眼下；学东西看的是天赋本身。天赋不好也不必灰心：它只在武功还浅的时候看得出来，功夫练深了，差别就小了。"
msgstr ""

#. guide.learn title
#: data/common/codex.json
msgid "学武"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "武功分两层。基本拳脚、基本剑法、基本内功这些「基本功夫」是根基；柳家拳、封山剑法这些「特殊武功」要在武学页「激发」到对应的基本功夫上才用得出来。真打起来，看的是两者合起来的等级。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "向师父或肯教你的人请教，每次耗精和一点潜能，第一次学一门新功夫耗的精加倍。学到的不能超过教你的人，也受实战经验限制：等级越高，要的实战经验越多。请教页写着你能学到几级、卡在哪里。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "激发好的特殊武功可以在武学页练习，耗气。它最多练到和底下的基本功夫一样高，再往上，得先把基本功夫学上去。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "基本拳脚、基本剑法、基本刀法、基本杖法、基本招架、基本轻功、基本内功这七门，到了 40 级就能自己琢磨着往上练，耗精和潜能，不必找人。特殊武功不能自学。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "得了拳谱、刀谱、经书，会读书识字就能研读。研读耗神、不花潜能；读书识字越高，每次读懂的越多。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "实战经验与潜能"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "打架、办差事、走完一段经历，都能得到实战经验和潜能。实战经验决定武功能学多高；潜能是请教和自学的花销，没用掉的有上限，攒满了就该去学了。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "打中比自己强的对手时，偶尔也能长一点功夫。"
msgstr ""

#. guide.learn paragraphs
#: data/common/codex.json
msgid "请教、练习、打坐、冥思、修行都能「连续」做下去，遇到做不下去的一步会先停下，告诉你为什么。"
msgstr ""

#. guide.family title
#: data/common/codex.json
msgid "拜师与门派"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "门派是学武的正路。拜师大致有三种：有的师父看你的天赋和功夫够不够，有的要你立誓，有的要你先过一场考验。交互窗口里还够不上的「拜师」会灰掉，写着还差什么；拜师页列出条件和你自己的数。"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "一个人同时只能有一位师父。师父教本门功夫最用心；别的人肯教，多半要你先替他做点事，或者付些钱。"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "改投别派之前会先问你。背叛师门要扣综合评价，往后的师父也不那么信你，教到一定程度就不肯再教；杀了自己的师父，也算背叛。"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "门派、帮会与山寨"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "门派重师门伦理和辈分，以入门先后排序，大多不许弟子再投别家。帮会、教派不以传授武功为主，帮规偏重要你去做事，进出也比门派容易。山寨、镖局、庄院规模小，入伙不易，入了以后有活干、有报酬。"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "角色页名字前方括号里写的是你的身份。一开始都是普通百姓；入了门派、出了家，身份会跟着变，往后的作为也会改它。"
msgstr ""

#. guide.family paragraphs
#: data/common/codex.json
msgid "见过门人的门派收在百科「门派」里；各家怎么看你，写在声望页。"
msgstr ""

#. guide.force paragraphs
#: data/common/codex.json
msgid "内力是武者的第二条命，打人和挨打都看它。"
msgstr ""

#. guide.force paragraphs
#: data/common/codex.json
msgid "学了基本内功，再把一门特殊内功激发上去，就能在武学页打坐：耗气，把气炼成内力存起来。存过了上限再坐下去，上限就慢慢往上长；能长多高，看基本内功的等级。连续打坐可以定一个数，练到就停。"
msgstr ""

#. guide.force paragraphs
#: data/common/codex.json
msgid "每一击多灌进一些内力，打得更重，内力也耗得更快。战斗里取「攻」的姿态，会顺手把加力开到一半。"
msgstr ""

#. guide.force paragraphs
#: data/common/codex.json
msgid "各门内功的本事不一样：有的能恢复精、气、神，有的能疗伤，有的能压下杀气、提升战斗力。百科「武学」里每门内功都写着它能运哪些。运功耗内力，战斗里也能用。"
msgstr ""

#. guide.mana title
#: data/common/codex.json
msgid "法力与灵力"
msgstr ""

#. guide.mana paragraphs
#: data/common/codex.json
msgid "法门在江湖上分两路。一路念咒施法，茅山道术、奇门遁甲都属这一路，耗的是法力；一路是出自修行者自身的神通，佛门的八识神通属这一路，耗的是灵力。"
msgstr ""

#. guide.mana paragraphs
#: data/common/codex.json
msgid "学了基本咒文才用得上。在武学页冥思，耗神，把法力一点点聚起来；上限看基本咒文。"
msgstr ""

#. guide.mana paragraphs
#: data/common/codex.json
msgid "学了基本法术才用得上。在武学页修行，耗精，把精炼成灵力；上限看基本法术。"
msgstr ""

#. guide.mana paragraphs
#: data/common/codex.json
msgid "两样都和内力一样：存过了上限再练，上限就长。灵性高的人长得快。还没学这一路的时候，角色页和武学页都不显示它们。"
msgstr ""

#. guide.combat title
#: data/common/codex.json
msgid "战斗"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "动手有两种。「切磋」点到为止，谁先实实在在打中对方一下就算赢，事后谁也不记仇；只是拿着兵刃切磋，一样会见血。「攻击」是死斗，打到一方送命为止；乱杀无辜，往后的日子就不好过了。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "动手之前会先问你一句，写明对方比你强还是弱：稳赢、占优、五五开、吃亏、必败。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "出招"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "战斗时世界停住，回合等你出招。一回合你有两手，对手看身手有一到两手；你点一招就结算一手，接着轮到对手。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "招式分快、重、虚、守四种：快克重，重克守，守克虚，虚克快。重招占两手，打实了伤得重，还能打掉对手一手；落空了就露出空门。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "姿态有三种：攻，伤得重、自己也好打；守，招架高、伤得轻；游走，闪躲高、命中低。点「改为自动」就让它自己打下去。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "识招"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "一路招式看熟两回，就认得它是快是重、怕什么；自家门派的招一学就认得。见过的招都记在百科「武学」的见识录里。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "有些门派的功夫能多挣一手：封山剑法等对手打空，柳家拳贴身打实。"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "一伙人"
msgstr ""

#. guide.combat paragraphs
#: data/common/codex.json
msgid "见人就打的一伙，只要有一个够得着你，就会一起上。人多的时候，先想好再进门。"
msgstr ""

#. guide.death title
#: data/common/codex.json
msgid "认输、逃跑与生死"
msgstr ""

#. guide.death paragraphs
#: data/common/codex.json
msgid "逃跑不耗什么，脱离战斗，人还留在原地。"
msgstr ""

#. guide.death paragraphs
#: data/common/codex.json
msgid "认输：要你命的人还站着时，他不让你降；否则就此停手，扣一些综合评价。"
msgstr ""

#. guide.death paragraphs
#: data/common/codex.json
msgid "对手被你打倒时，会停下来问你「了结」还是「放过」，放过的人不记仇。设置里可以改成直接了结。有些人往后还用得着，只能打倒，杀不死。"
msgstr ""

#. guide.death paragraphs
#: data/common/codex.json
msgid "死了以后"
msgstr ""

#. guide.death paragraphs
#: data/common/codex.json
msgid "人死了变成鬼魂，从鬼门关走一趟阴间，回到阳世。死一回只扣一点实战经验，武功和潜能都不动，杀气清零。"
msgstr ""

#. guide.death paragraphs
#: data/common/codex.json
msgid "身上的东西都留在尸体上，尸体不会腐烂，等你回去取。不想走阴间，也可以回到上次的自动存档。"
msgstr ""

#. guide.gear title
#: data/common/codex.json
msgid "兵器与护具"
msgstr ""

#. guide.gear paragraphs
#: data/common/codex.json
msgid "伤人靠的首先是功夫，其次才是兵器。剑用剑法、刀用刀法，空手用拳脚；兵器的种类不同，伤法也不同，割伤、刺伤、砸伤各不一样。"
msgstr ""

#. guide.gear paragraphs
#: data/common/codex.json
msgid "越重的兵器伤得越重，但要称手：拿不拿得动看膂力。锤和杖砸下去，能把对手的兵器打飞，甚至砸断。另一只手也能拿兵器，它的分量一样算数。"
msgstr ""

#. guide.gear paragraphs
#: data/common/codex.json
msgid "护具有衣服、盔甲、帽子、项链、护腕、腰带、鞋、戒指，还有盾。一身衣服连裤子算一件。护得越好越重，重兵器和重盔甲都会拖慢你的轻功，物品说明上写着拖多少。"
msgstr ""

#. guide.gear paragraphs
#: data/common/codex.json
msgid "背包页选中一件，右边就是它的样子和说明。"
msgstr ""

#. guide.standing title
#: data/common/codex.json
msgid "杀气与名声"
msgstr ""

#. guide.standing paragraphs
#: data/common/codex.json
msgid "杀人会长杀气，胆气也跟着壮。杀气太重，学不了佛道两家的心法，还可能失手伤人。运功压制或到庙里捐香火，能把它压下去。"
msgstr ""

#. guide.standing paragraphs
#: data/common/codex.json
msgid "江湖上对你的总评。办成差事会涨，认输会掉，背叛师门扣得最狠。"
msgstr ""

#. guide.standing paragraphs
#: data/common/codex.json
msgid "打过交道的势力，在声望页各有一张卡，写着那一家对你的看法；哪一家都还不认得你时，那里是空的。"
msgstr ""

#. guide.standing paragraphs
#: data/common/codex.json
msgid "角色页还记着你亲手杀过多少人。"
msgstr ""

#. guide.money title
#: data/common/codex.json
msgid "银两与行路"
msgstr ""

#. guide.money paragraphs
#: data/common/codex.json
msgid "钱有黄金、白银、铜钱三种：一两银子是一百文，一两黄金是一百两银子。付钱先用大的；钱庄能兑换。"
msgstr ""

#. guide.money paragraphs
#: data/common/codex.json
msgid "当铺按八折收你的东西，不做典当和赎回。不值钱的东西丢下就没了，丢之前会先问你一句；办事要用的东西丢不掉。"
msgstr ""

#. guide.money paragraphs
#: data/common/codex.json
msgid "城里的悬赏榜上贴着差事，办成了有赏，也算一段历练。"
msgstr ""

#. guide.money paragraphs
#: data/common/codex.json
msgid "七座城镇和五个门派的山门都停着车。在车旁「坐车」，在沙盘上挑一站；只去你走到过、路也走通了的地方。车钱十几到五十几文，路上要花些时辰。"
msgstr ""

#. help.theme group
#. help.history group
#. help.myth group
#. help.magic group
#: data/common/codex.json
msgid "传说"
msgstr ""

#. help.theme title
#: data/common/codex.json
msgid "主题故事"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "这个时代，东方世界已经有了相当高水准的文明。由于东方大陆实在太大，航海技术并不受重视。我们的故事，就从一个山中小镇——雪亭镇说起。"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "时间是天朝佑圣元年，岁次甲子，年仅十六岁的皇帝刚刚登基，雪亭镇上熙来攘往，一队身着白衣的朝廷武官和两名老者在镇前的广场中坐着，四面来来往往的人当中，有不少显然是武林中人，正探头探脑地向着广场张望。"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "正纷扰间，一匹快马冲进了广场，两名老者立即站了起来。"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "马上乘客一跃而下，快步走到老者身前，躬身说道：「禀将军，时辰已到，白道长命下官回禀，方位是在……」，说着压低了声音。"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "不料一名老者忽然说道：「大声点，让众位兄弟都听见了。」"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "那人一怔，随即大声说道：「方位是在西南二十四里，黄石隘口。」"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "只见坐着的白衣武官相互交头接耳，四周围观的人纷纷向外走去，看似杂乱无章，其实倒有一大半正往西南走去，两名老者不动声色，只静静地瞧着众人的动向。"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "过了约一盏茶的时间，其中一名老者做了个手势，所有白衣武官倏地站起，然后跟着两名老者身后缓缓地往西南方向离去。"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "广场西边一家小客栈里，一个年约十四岁的少年问店里的小二道：「这些人神秘得紧，却不知到底在玩什么把戏？」"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "小二抄起脖子上的毛巾，抹了抹脸，说道：「小哥您有所不知，这些个爷儿们可是大内来的高手，这次是奉了咱们皇上的命令，要去岚城找一把叫做什么『旋芒宝剑』的，那骑马的官爷所称的白道长，便是咱们这附近有名的太乙观观主……」"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "少年奇道：「岚城？那是什么地方？怎么我从小到大不曾听过有这个地方？」"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "小二「嘿」的一声，说道：「说起岚城这地方，那你可问对人啦，咱这儿的说书先生可是我的哥儿们，那岚城说穿了只不过是古书上的一处地方，据说这城是仙人住着，一般的凡夫俗眼可瞧不见这座城，只不过古时候一个樵夫不小心撞了进去，这才留下了记载，不过后来好像除了这位砍柴的老兄进去过之外，再也没有人到过这岚城，我说小哥哪，要找这个岚城是他们朝廷大官跟江湖好汉的事儿，您还是来小店听听说书先生的书儿比较轻松。」"
msgstr ""

#. help.theme paragraphs
#: data/common/codex.json
msgid "少年听着出了神，怔怔地望着外面的天空，一朵朵的浮云飘来飘去，他的心思也不由自主地飞了起来。"
msgstr ""

#. help.history title
#: data/common/codex.json
msgid "历史"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "自古以来，人类由茹毛饮血逐渐进步，慢慢有了部落，大约在一千年前，强大的邬赤族领袖商句征服了烟车河流域的游牧民族，建立了一个以「金色乌鸦」为图腾的国家，这金色乌鸦代表的是太阳，商句将一面绣着金色乌鸦的大旗树立在图干山的山顶上，统治着山脚下绵延好几百里的土地。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "第三年冬天，大雪一连下了五个月，牛羊冻死的不计其数，商句召集了所有的父老，对他们说道：「守护我们的金色乌鸦已经离开了这片土地，这场大雪便是告诉我们离开故乡的时间到了，我决定带着子民向南越过大漠，一直到看得到太阳的地方，年老和有病的人可以留下来，我会将一半的牛羊留给他们。」"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "于是他们收拾了帐棚，留下了一半的牛羊给不愿离开家乡的老人，踏上了寻找金色乌鸦的旅程，大漠十分辽阔，即使是商句自己也没有把握能安全地穿越，他在出发后的第四个月甚至亲手写下了遗书，交给自己的儿子。他们在大漠里整整走了一年，然后来到了一座大山之前，商句病倒了，他对他的儿子於兰攸说道：「越过这座大山，北风就吹不到了，在那里一定可以看得到太阳，现在我把这面大旗交给你，希望你记着我们离开故乡的目的，好好带领大家。」说完，商句就闭上眼睛死了。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "於兰攸含泪埋葬了父亲，并且在他的墓旁守候了一年，才开始带着大家翻越那座大山，大山地势非常险峻，他们一共越过了六座高耸的山峰，才来到一片平原，只见绿草如茵，中间散布着几株大树，没有半点冰雪的踪迹，最令人惊异的是，他们的面前耸立着一株高耸入云的大树，树上正栖息着一只巨大的金色乌鸦。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "虽然金色乌鸦在大家的心目中一直是太阳的象徵，但那也只是祖先们流传下来的神话，想不到在经过长途的跋涉之后，竟然真的见到了，那只金色乌鸦见到了於兰攸，忽然变成一个穿着金色长袍的少女缓缓地从树上降了下来，对着於兰攸说道：「你们终于来了，这片土地是我的父亲允诺要赐给你们的，我们是勇士『寒於』的后裔，掌管光明的太阳神族，如果你们能答应永远守护这株圣木，太阳将会永远照耀这片土地。」"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "金色乌鸦变成的少女名字叫做「君违」，后来嫁给了於兰攸做妻子，君违教导众人耕种、纺纱，并且为她的丈夫制定各种典章制度，从此以后於兰攸和他的族人们一直遵守和金色乌鸦的约定，守护着圣木。因为金色乌鸦的守护，过了七百年风调雨顺的时光，人口增加得很快，在向外拓垦的同时，又陆续和西方擅长狩猎与铸造的歧族人、东方擅长音乐与占卜的敖族、南方擅长经商与建筑的娄族互相融合，终于成为这个世界上最大的国家，所有远方的小国都称呼我们为「天朝」，由于於兰氏的帝王具有太阳神族的血统，因此也有「天子」的称号。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "但是就在距今约三百年前，发生了一件可怕的事，当时的皇宫之中，一群武士意外地在一处地窖里发现了一张羊皮，这张羊皮就是当初率领大家穿越大漠的君主商句所写的遗书，这份遗书不但提到了金色乌鸦，而且还提到许多后来发生的大事，简直就是一张神奇预言，发现这张羊皮的武士首领恰好是当时皇帝的叔父於兰淳焉，於兰淳焉是一位伟大的武士，曾经数度打败企图夺取圣木的北方蛮族，他见到遗书上提到，金色乌鸦出现之后每七百年，就会有一个可怕的妖魔出现，大杀苍生，以应金色乌鸦神通所欠的劫数，这个妖魔只有上古的宝剑「穿灵」才能镇住，而这把宝剑所藏的位置正是圣木的核心。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "於兰淳焉和皇帝商量的结果，决定劈开圣木取出宝剑，以防备妖魔出现，那圣木足足有一百个人合抱那么粗，一大群士兵用斧头砍了足足三天才将圣木砍倒，一阵天摇地动之后，穿灵宝剑终于出现在树洞中央，可是当於兰淳焉将宝剑拔起之后，一条黑影迅速地从地面窜了出来，原本明亮的天空一下子变暗了，百姓们都惊慌失措，只听到天空中传来阵阵低沉的吼声，过了足足一个时辰才又恢复光明。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "当天晚上，一只金色乌鸦出现在皇宫之中，说道：「你们今天做了一件大大的错事，将勇士寒於用宝剑镇压了五千年的『侮天鬼』放了出来，我的妹妹『璃虹』正在天上巡行，已经被这侮天鬼捉去了，侮天鬼现在正在四处寻找他的头颅，一旦被他找到，即使是集我全部族人的力量也无法镇服他，现在唯一的办法是找到另一把宝剑『旋芒』以及『寒於宝衣』，唯有这三件神器才能制服得了侮天鬼，寒於宝衣现在归月神族保管，旋芒宝剑却下落不明，侮天鬼的头颅被我的族人用强力法术封住，谅那妖魔两三百年内找不到，但是日子一久只怕终究隐藏不住，因此若你们三百年之内不能出现一个勇士消灭这妖魔，就真的大祸临头了。」"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "金色乌鸦的名字叫做「杞庸」，他化身成一个金袍少年住在皇宫中教武士们各种剑术武功三十年，渐渐地这些武术慢慢流传到了民间，更有许多聪明才智之士加以变化出许多不同的武术，而演变出各种不同的门派，转眼间已过了将近三百年，这期间虽然偶尔有些旱灾水灾，但仍算风调雨顺，想是那侮天鬼只急着找回头颅，却并不多事杀戮，但是人们却渐渐将这件事忘了，不少人还将之斥为无稽之谈，荒谬之说，直到先帝即位，事情才又有了变化。"
msgstr ""

#. help.history paragraphs
#: data/common/codex.json
msgid "先帝秉性聪慧，自幼即博览群书，尤其对先人留下的史籍更是详加考据，先帝曾仔细推敲商句遗书中最后两句话，推断那可能是指引旋芒宝剑所在的关键，虽然对祖先所留下来有关金色乌鸦的传说也是半信半疑，但是仍然陆续派出了许多武士探查，结果意外地发现了古书中「烟霞霓岚」四座仙城中的烟城，根据武士所带回来的消息，旋芒宝剑目前乃是属于岚城中一位仙人所有，只是这岚城「寻风而至，寻风而逝」，烟城百姓也是只闻其名，不知其所，先帝直到病危之中仍念念不忘寻找岚城之事。"
msgstr ""

#. help.myth title
#: data/common/codex.json
msgid "神话"
msgstr ""

#. help.myth paragraphs
#: data/common/codex.json
msgid "早在我们的先人来到这片土地之前，这里曾经是集天地万物浊气所形成的妖魔们盘踞的炼狱，到处都是终年燃烧着的土地与深不见底的沼泽，直到我们的始祖——也就是勇士「寒於氏」来到这里，他有一件水火不侵的宝衣，和两把神异的利剑「穿灵」与「旋芒」，寒於氏和妖魔大战了一十七日，妖魔的鲜血浇熄了燃烧的土地，尸体填平了无底的沼泽，当寒於氏斩下最后一只妖魔「侮天鬼」的头颅之后，他也力尽而死。"
msgstr ""

#. help.myth paragraphs
#: data/common/codex.json
msgid "寒於氏死后，元神却没有消失，他的魂魄化成了十三个精灵，每一个精灵各拥有寒於氏的一种神通，掌管着这个世界的万物，其中的第十三个精灵「区冥氏」就是我们人类最早的祖先。区冥氏不像她其他的十二个姊姊是不死的，但是她所拥有的神通是寒於氏最引以为傲的「再生」能力，区冥氏活到一百七十岁的时候，召集了她所有的姊妹，交代她们好好照顾自己的子女之后，便闭上眼睛死了。"
msgstr ""

#. help.myth paragraphs
#: data/common/codex.json
msgid "区冥氏一共有一百个子女，后来分别成为世界上各个种族的祖先。"
msgstr ""

#. help.myth paragraphs
#: data/common/codex.json
msgid "勇士寒於的魂魄所化成的十三个精灵，分别是太阳神「金乌」、月神「银蟾」、风神「大鹏」、雨神「天龙」、雷神「泽兽」、火神「凤凰」、山鬼「赤魈」、林鬼「青蛛」、川鬼「浊鱼」、原鬼「旱魃」、天灵「穹氤」、地灵「域摩」、人灵「区冥」，共有「六神」、「四鬼」、「三灵」。其中特别值得一提的是最后的三灵，她们所拥有的神通汇集了寒於氏的精、气、神，若是善加利用，威力将远远凌驾其他十位精灵之上。"
msgstr ""

#. help.myth paragraphs
#: data/common/codex.json
msgid "许多人都相信，区冥氏死了之后会不断地经由「转世」而继续复活，但是她的能力却全部分给了所有子女，因此人类能够凌驾于其他的虫鱼鸟兽之上，造就出伟大的成就，人类死亡之后，也会像区冥一样地转世再生，但是只有区冥能够保持每一生每一世的记忆，虽然再生的区冥氏所具有的能力和一般人类没有两样，但是她所累积的智慧是无人可及的。"
msgstr ""

#. help.magic title
#: data/common/codex.json
msgid "法门源流"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "所有的魔法依照能量来源的不同可分为两类：「法术」与「咒文」。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "所谓「法术」是指来自施法者自身的修为，以及自身所操控的能量所造成的魔法效果，这类魔法通常被视为高深的学问，并且是可以研究出「为什么？」的，法术的效果通常显著、直接、而且难以抗拒，尤其是当施术者的能力十分强大的时候。法术最初的起源是来自对于「咒文」力量的怀疑，并且在企图找出其力量根源的过程中逐步经由实验所建立起来的理论系统。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "所谓「咒文」是指根据某种咒语、动作、仪式而与存在于宇宙中某种超然存在的生物或意志沟通，而藉其力量引发的魔法效果，这类魔法的历史比法术更早，而且这些「超然存在」的实体通常被人称为「神」、「魔鬼」、「精灵」等等，咒文宗教上的意义大于学术上的意义，但是又似乎并不完全是宗教上的力量（即：不管你信不信，或多或少都能产生实际的效果，而非单纯心理现象），一般使用咒文者很难探究「为什么」这样的咒文会引发这样的效果，咒文的来源全部都是来自古老的记载或无意中的发现。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "虽然有不少魔法到底是属于「法术」系或「咒文」系仍然存有争议，但是人们已经找到一种简单的方法来区分他们，那就是「法术」消耗的能量是「灵力」、「咒文」消耗能量是「法力」（由于咒文的历史远较法术来得更早，因此在当时普遍使用的「魔法」、「法力」等名词都是指咒文系魔法而言，沿用至今）。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "「神通」，长期钻研佛法的高僧常常会因自己本身的修为，产生具有神奇力量的神通，如天眼通、大力神通等，愈是具有大智慧、大慈悲的高僧其神通愈强，这类的法术通常需要百分之百的精神集中，才能施展，但是所需耗费的灵力较少，而且大多是属于防御或辅助性质的功能。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "「道法」，道家讲究清静无为，法天自然，因此道法修行到了某一个程度，就能够利用天地阴阳生化的道理，吸取天地之精华纳为己用，道法所涵盖的范围极广，但是受到天时、地利、与施法者本身的状态影响很大，但是只要这几个条件能够配合，道法的威力是无可抵御的。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "「仙术」，这是一门相当古老的修行法门，讲究炼气与长生不死之术，修炼仙术的人并不膜拜任何神祇，只集中于修炼自己的肉身，使之达到不朽的境地，进而羽化成仙，仙术除了在炼气方面相当杰出之外，还有许多炼丹的法门，但是一般人想要学习仙术并不容易，因为除了要有慧根之外，要找到愿意传授仙术的仙人也是一项非常艰困的修炼。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "「密法」，佛家的一门分支，以手印与咒文为主，详细情形并不清楚，但是密法是一门攻守兼备，系统精严的法术，使用密法的人通常也擅长使用法器战斗，他们的修行是以降妖伏魔为主，密法修行至高深处时，也能拥有某些类似「罗汉神通」的能力，和佛家是殊途同归的正道。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "「奇门」，又称茅山术，由于偏重治鬼与符箓咒术，往往被道家斥为旁门左道，但是奇门法术入门较易，且于临敌之际有其实用性在，加之不若正统道家那般虚无缥缈，因此一直拥有为数众多的人修习，虽然威力不如道法，但是近世经一位高人整理发扬，已经隐然有与正统道家分庭抗礼之势。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "「魔道」，这类法术的修炼者以精怪居多，人类亦有少数，分为天魔、地魔、人魔三种，由于修炼法门往往必须杀伤生命，被多数人强烈憎恨，但是魔道威力集道法与仙术之所长，又为求利己不择手段，不但进境迅速兼且危险，以致于各家法术之中均有克制魔道的研究与法术，可说是树敌最多的一门。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "道士"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "道士是一群以修炼成仙，而达到「与天地同休，与日月同寿」之境界的修道人，和其他的宗教比较起来，道士对于「人」的地位看得相当崇高，认为天、地、人在宇宙中的地位是相等的，因此，道教的教主是一个「人」，而不是高高在上、和凡人之间有不可跨越之鸿沟的「神」。"
msgstr ""

#. help.magic paragraphs
#: data/common/codex.json
msgid "道士的能力偏重于炼气，武术方面以内功、剑术见长，正统道家除炼气之外并不修习任何法术，但是许多道士往往会涉猎一些除妖降魔用的法术，以作为入山修炼时防身之用，有些支派的道士更发展成专研法术而舍弃修炼成仙的目的。"
msgstr ""

#. main.prologue title
#. city.npc.shangshu.shangshu inquiry topic
#. native.npc.wei_zhizhong inquiry topic
#. native.npc.yulan_zhao inquiry topic
#. native.npc.yu_zijian_court inquiry topic
#. native.npc.zhong_momo inquiry topic
#. native.npc.yulan_zhao_private inquiry topic
#. native.npc.chen_witness inquiry topic
#: data/story/prologue.json data/city/npcs.json data/imperial/npcs.json data/native/npcs.json
msgid "寻剑令"
msgstr ""

#. main.prologue summary
#: data/story/prologue.json
msgid "大内高手在找一把剑。去西南二十四里的黄石隘口，看他们找什么。"
msgstr ""

#. main.prologue reward.deed
#: data/story/prologue.json
msgid "在黄石隘口看着官队挖出石匣、又被黑衣道士抢走"
msgstr ""

#. main.prologue/waiter objective
#: data/story/prologue.json
msgid "跟店小二打听广场上的「官爷」。"
msgstr ""

#. main.prologue/waiter text
#: data/story/prologue.json
msgid "店小二说外头广场上来了大内的官爷，叫你去瞧瞧。"
msgstr ""

#. main.prologue/square objective
#: data/story/prologue.json
msgid "去镇前的广场，看看官爷们在做什么。"
msgstr ""

#. main.prologue/square/official text
#: data/story/prologue.json
msgid "冯策叫信使大声报了方位：西南二十四里，黄石隘口。"
msgstr ""

#. main.prologue/square/official reward.deed
#: data/story/prologue.json
msgid "在广场上当面向大内的总教头问了寻剑的事"
msgstr ""

#. main.prologue/square/crowd text
#: data/story/prologue.json
msgid "围观的江湖客悄悄告诉你：官爷们要去西南二十四里的黄石隘口。"
msgstr ""

#. main.prologue/square/crowd reward.deed
#: data/story/prologue.json
msgid "在广场上向围观的江湖人打听了官队的去处"
msgstr ""

#. main.prologue/pass objective
#: data/story/prologue.json
msgid "去西南二十四里的黄石隘口，看他们找什么。"
msgstr ""

#. main.prologue/pass text
#: data/story/prologue.json
msgid "你到了黄石隘口。官队正在山壁下挖土，白道长守在坑边。"
msgstr ""

#. main.prologue/scene objective
#: data/story/prologue.json
msgid "看官队在山壁下挖什么。"
msgstr ""

#. main.prologue/scene text
#: data/story/prologue.json
msgid "官队挖出一只刻着风纹的石匣；一个黑衣黑冠的道士从崖上掠下，抢了匣子就逃，掉下一块布条。白道长说匣里是岚城的风铃。"
msgstr ""

#. main.prologue/strip objective
#: data/story/prologue.json
msgid "拾起黑衣道士掉下的布条。"
msgstr ""

#. main.prologue/strip text
#: data/story/prologue.json
msgid "布条上刻着老松寨的记号：黑衣道士往老松岭去了。"
msgstr ""

#. main.chapter1 title
#: data/story/chapter1.json
msgid "伪墓"
msgstr ""

#. main.chapter1 summary
#: data/story/chapter1.json
msgid "追到黑衣道士，弄清老松寨和那口墓。"
msgstr ""

#. main.chapter1 reward.deed
#: data/story/chapter1.json
msgid "查明了瀑布山洞里的墓是假的"
msgstr ""

#. main.chapter1/trail objective
#: data/story/chapter1.json
msgid "顺着布条上的记号去老松岭，沿松树上的刀痕找老松寨。"
msgstr ""

#. main.chapter1/trail text
#: data/story/chapter1.json
msgid "松树上的刀痕指向灌木后的一条小径：老松寨藏在林子深处。"
msgstr ""

#. main.chapter1/gate objective
#: data/story/chapter1.json
msgid "过老松寨的寨门：留下买路钱、叫阵，或者打进去。"
msgstr ""

#. main.chapter1/gate/pay text
#: data/story/chapter1.json
msgid "你给了寨门的喽罗十两银子买路钱，寨里的人不再拦你。"
msgstr ""

#. main.chapter1/gate/pay reward.deed
#: data/story/chapter1.json
msgid "给老松寨的喽罗付了买路钱"
msgstr ""

#. main.chapter1/gate/challenge text
#: data/story/chapter1.json
msgid "你在寨门外叫阵，喽罗放你进去：常老大在聚义厅等你。"
msgstr ""

#. main.chapter1/gate/challenge reward.deed
#: data/story/chapter1.json
msgid "在老松寨的寨门外叫阵"
msgstr ""

#. main.chapter1/gate/force text
#: data/story/chapter1.json
msgid "你打倒了寨门的喽罗，硬闯进了老松寨。"
msgstr ""

#. main.chapter1/gate/force reward.deed
#: data/story/chapter1.json
msgid "硬闯了老松寨的寨门"
msgstr ""

#. main.chapter1/boss objective
#: data/story/chapter1.json
msgid "到聚义厅找常老大，问黑衣道士的去向。"
msgstr ""

#. main.chapter1/boss/talk text
#: data/story/chapter1.json
msgid "常老大说那道士拿一块金牌买了路，往东边的瀑布去了。"
msgstr ""

#. main.chapter1/boss/beat text
#: data/story/chapter1.json
msgid "你打倒了常老大。他跌坐在熊皮上骂道：那道士拿金牌买的路，往东边的瀑布去了，找他去！"
msgstr ""

#. main.chapter1/boss/beat reward.deed
#: data/story/chapter1.json
msgid "打倒了老松寨的常老大"
msgstr ""

#. main.chapter1/cave objective
#: data/story/chapter1.json
msgid "从瀑布后面进山洞，找黑衣道士。"
msgstr ""

#. main.chapter1/cave text
#: data/story/chapter1.json
msgid "瀑布后的山洞尽头有一具骸骨和一面刻字的石壁。"
msgstr ""

#. main.chapter1/taoist objective
#: data/story/chapter1.json
msgid "拦住黑衣道士。"
msgstr ""

#. main.chapter1/taoist text
#: data/story/chapter1.json
msgid "黑衣道士落败，石匣还锁着，留在洞里。"
msgstr ""

#. main.chapter1/wall objective
#: data/story/chapter1.json
msgid "看看洞里的石壁和那具骸骨。"
msgstr ""

#. main.chapter1/wall text
#: data/story/chapter1.json
msgid "石壁上的字自称「南危水」，说埋骨于此——可骸骨身量矮小、骨龄不过三十，身边没有剑；字迹深浅如一，是活人慢慢刻的。这不是南危水的墓。"
msgstr ""

#. main.chapter1/bones objective
#: data/story/chapter1.json
msgid "处置那具骸骨：安葬他，或者带走他身边的腰牌。"
msgstr ""

#. main.chapter1/bones/bury text
#: data/story/chapter1.json
msgid "你把无名人安葬了，腰牌随他入土。洞顶落下一本《过招要旨》。"
msgstr ""

#. main.chapter1/bones/bury reward.deed
#: data/story/chapter1.json
msgid "安葬了瀑布山洞里的无名人"
msgstr ""

#. main.chapter1/bones/token text
#: data/story/chapter1.json
msgid "你拿走了骸骨身边的水烟阁腰牌：金乌徽，背面一个「岭」字。"
msgstr ""

#. main.chapter1/bones/token reward.deed
#: data/story/chapter1.json
msgid "拿走了瀑布山洞骸骨身边的腰牌"
msgstr ""

#. main.chapter2 title
#: data/story/chapter2.json
msgid "旧案"
msgstr ""

#. main.chapter2 summary
#: data/story/chapter2.json
msgid "去水烟阁，问清五长老的死。"
msgstr ""

#. main.chapter2 reward.deed
#: data/story/chapter2.json
msgid "查清了二十年前水烟阁五长老的旧案"
msgstr ""

#. main.chapter2/liu objective
#: data/story/chapter2.json
msgid "回雪亭镇淳风武馆，把山洞里的事告诉柳淳风。"
msgstr ""

#. main.chapter2/liu text
#: data/story/chapter2.json
msgid "柳淳风写了一封引荐信，让你去水烟阁找他的结拜义弟、执法使潘军禅；他说二十年前失在老松岭的那趟镖是振远镖局押的。"
msgstr ""

#. main.chapter2/escort objective
#: data/story/chapter2.json
msgid "去绮云镇振远镖局，问陈剑秋二十年前的失镖。"
msgstr ""

#. main.chapter2/escort text
#: data/story/chapter2.json
msgid "陈剑秋拿出二十年前的镖单：押的是水烟阁盟主印一方、密件一匣，失镖于老松岭，无一人生还。振远至今不提这桩丢人事。"
msgstr ""

#. main.chapter2/tomb objective
#: data/story/chapter2.json
msgid "上水烟阁的山，看葬剑亭里的碑。"
msgstr ""

#. main.chapter2/tomb text
#: data/story/chapter2.json
msgid "葬剑亭碑：第四代七长老以奸计害人，被众武者合力击杀，甲辰年立亭为后人殷鉴。"
msgstr ""

#. main.chapter2/stone objective
#: data/story/chapter2.json
msgid "看虹谷石台的碑。"
msgstr ""

#. main.chapter2/stone text
#: data/story/chapter2.json
msgid "虹谷石台碑：乙丑年，第六代阁主关雨楼立——正是失镖那年。字是用手指在岩石上写的，和山洞石壁上的刻字是一个手法。"
msgstr ""

#. main.chapter2/nan objective
#: data/story/chapter2.json
msgid "上楼找五长老南危水，拿证据问他山洞里的骸骨。"
msgstr ""

#. main.chapter2/nan text
#: data/story/chapter2.json
msgid "南危水承认了：山洞里死的是他的随从阿岭，伏击的是白衣武官，盟主卫沧澜被带走。他装死二十年，是怕哥哥槐阳王知道朝廷伏击了自己的弟弟会反。"
msgstr ""

#. main.chapter2/pan objective
#: data/story/chapter2.json
msgid "拿着引荐信到前厅找执法使潘军禅，问「邪剑穿灵」。"
msgstr ""

#. main.chapter2/pan text
#: data/story/chapter2.json
msgid "潘军禅说那把邪剑穿灵是仿剑、是鱼饵：去年一个黑衣道士来试过它，往野羊山北麓去了。"
msgstr ""

#. main.chapter2/choice objective
#: data/story/chapter2.json
msgid "替南危水保密（他欠你一个人情，到了关北替你引见他哥哥槐阳王），还是告诉七长老颜违（颜违借这件事坐稳代盟主，南危水不会再和你同路）？"
msgstr ""

#. main.chapter2/choice/keep text
#: data/story/chapter2.json
msgid "你替南危水保了密。他说，到了关北，他替你引见槐阳王。"
msgstr ""

#. main.chapter2/choice/keep reward.deed
#: data/story/chapter2.json
msgid "替水烟阁五长老南危水保住了二十年的秘密"
msgstr ""

#. main.chapter2/choice/tell text
#: data/story/chapter2.json
msgid "你把南危水的事告诉了七长老颜违。颜违当日便以代盟主自居；南危水闭门不出，水烟阁来信告诉了关北。"
msgstr ""

#. main.chapter2/choice/tell reward.deed
#: data/story/chapter2.json
msgid "把五长老南危水装死二十年的事告诉了七长老颜违"
msgstr ""

#. main.chapter3 title
#. niling name
#. goathill.npc.bandit_hwang inquiry topic
#. native.npc.niling_winch_taoist inquiry topic
#. native.npc.niling_gatekeeper inquiry topic
#. native.npc.niling_gate_guard inquiry topic
