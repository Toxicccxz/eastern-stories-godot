msgstr ""

#. common.npc.dancer.master nickname
#: data/common/npcs.json
msgid "回音仙子"
msgstr ""

#. common.npc.dancer.master title
#: data/common/npcs.json
msgid "晚月庄主"
msgstr ""

#. common.npc.dancer.master long
#: data/common/npcs.json
msgid ""
"蓝止萍是一个十分出色的美女，她弹的一手琵琶更是闻名千里，许多\n"
"王侯子弟，富商豪客都为她天下无双的美貌与琴艺倾倒。\n"
msgstr ""

#. common.npc.dancer.master family.title
#: data/common/npcs.json
msgid "庄主"
msgstr ""

#. common.npc.dancer.master chat_msg_combat
#: data/common/npcs.json
msgid ""
"蓝止萍嫣然一笑，一个转身迳自舞了起来，对眼前这场恶斗似乎全不放在心上。\n"
msgstr ""

#. common.npc.dancer.master chat_msg_combat
#: data/common/npcs.json
msgid ""
"蓝止萍脚步轻移，翩翩地转了几个圈，回眸一笑。\n"
msgstr ""

#. common.npc.dancer.master chat_msg_combat
#: data/common/npcs.json
msgid ""
"蓝止萍用手扶了扶自己的发簪，像是怕被对手碰歪似地。\n"
msgstr ""

#. common.npc.dancer.master chat_msg_combat
#: data/common/npcs.json
msgid ""
"蓝止萍笑嘻嘻地拾起地上一片从魔鞭翩珑上落下的花瓣。\n"
msgstr ""

#. common.npc.dancer.master chat_msg_combat.tell
#: data/common/npcs.json
msgid "你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。"
msgstr ""

#. common.npc.dancer.master apprentice.requires.refuse_say
#: data/common/npcs.json
msgid "男人都不是好东西，滚开！"
msgstr ""

#. common.npc.dancer.master apprentice.accept_say
#: data/common/npcs.json
msgid "很好，只要你对本庄主忠心耿耿，好处是少不了的。"
msgstr ""

#. common.npc.dancer.master apprentice.accept_vision.line
#: data/common/npcs.json
msgid "$N暧昧地抚摸著$n的脸，说道：特别是像你这样的女孩 ...."
msgstr ""

#. common.npc.bonze.master name
#: data/common/npcs.json
msgid "玄智和尚"
msgstr ""

#. common.npc.bonze.master family.title
#. fanfang.npc.lama_master family.title
#: data/common/npcs.json data/fanfang/npcs.json
msgid "住持"
msgstr ""

#. common.npc.bonze.master accept_fight.say
#: data/common/npcs.json
msgid "阿弥陀佛！出家人戒逞强恶斗！老衲不敢违反清规。"
msgstr ""

#. common.npc.bonze.master accept_fight.say
#: data/common/npcs.json
msgid "施主既然身负绝艺，老衲佩服便是，也不必较量了。"
msgstr ""

#. common.npc.bonze.master inquiry topic
#. fanfang.npc.lama_master inquiry topic
#: data/common/npcs.json data/fanfang/npcs.json
msgid "剃度"
msgstr ""

#. common.npc.bonze.master inquiry.剃度.rules.say
#. common.npc.bonze.master inquiry.出家.rules.say
#: data/common/npcs.json
msgid ""
"阿弥陀佛！你我同是出家人，何故跟老衲开这等玩笑？\n"
msgstr ""

#. common.npc.bonze.master inquiry.剃度.rules.say
#. common.npc.bonze.master inquiry.出家.rules.say
#: data/common/npcs.json
msgid ""
"阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n"
msgstr ""

#. common.npc.bonze.master inquiry.剃度.rules.say
#. common.npc.bonze.master inquiry.出家.rules.say
#: data/common/npcs.json
msgid ""
"阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n"
msgstr ""

#. common.npc.bonze.master inquiry topic
#. fanfang.npc.lama_master inquiry topic
#: data/common/npcs.json data/fanfang/npcs.json
msgid "出家"
msgstr ""

