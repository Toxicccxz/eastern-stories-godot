#. city.npc.shangshu.huyuan name_parts
#. city.npc.shangshu.huyuan1 name_parts
#: data/city/npcs.json
msgid "林国"
msgstr ""

#. city.npc.shangshu.huyuan name_parts
#. city.npc.shangshu.huyuan1 name_parts
#: data/city/npcs.json
msgid "林亿"
msgstr ""

#. city.npc.shangshu.huyuan name_parts
#. city.npc.shangshu.huyuan1 name_parts
#: data/city/npcs.json
msgid "林寿"
msgstr ""

#. city.npc.shangshu.huyuan1 inquiry topic
#: data/city/npcs.json
msgid "客人"
msgstr ""

#. city.npc.shangshu.huyuan1 inquiry.客人
#: data/city/npcs.json
msgid ""
"我也不知道，主人吩咐我守着的。\n"
msgstr ""

#. city.npc.shangshu.maid long
#: data/city/npcs.json
msgid ""
"她是尚书府的司职厨务的丫鬟，一年四季呆在厨房中。但粗重的\n"
"杂活也掩不住其天生丽质。\n"
msgstr ""

#. city.npc.shangshu.gardener name
#: data/city/npcs.json
msgid "花匠"
msgstr ""

#. city.npc.shangshu.gardener long
#: data/city/npcs.json
msgid ""
"一个老老实实、本本分分的庄园花匠，多年的风霜刻满\n"
"了他的额头。多年以来从来没有人认真注意过他，他也\n"
"总是默默地在花园里工作。\n"
msgstr ""

#. city.npc.shangshu.gardener inquiry.茅山派
#: data/city/npcs.json
msgid ""
"那是我的师门。\n"
msgstr ""

#. city.npc.shangshu.gardener inquiry.林忌
#: data/city/npcs.json
msgid ""
"林忌？。。你问我师兄，好久没见着他了。\n"
msgstr ""

#. city.npc.shangshu.gardener inquiry topic
#. city.npc.shangshu.qing_chen name
#: data/city/npcs.json
msgid "庾清尘"
msgstr ""

#. city.npc.shangshu.gardener inquiry.庾清尘
#: data/city/npcs.json
msgid ""
"什么？清尘出事了？\n"
msgstr ""

#. city.npc.shangshu.qing_chen title
#: data/city/npcs.json
msgid "尚书府小姐"
msgstr ""

#. city.npc.shangshu.qing_chen long
#: data/city/npcs.json
msgid ""
"她是尚书府的千金。平时一直呆在自己的绣房里，所以虽然外界\n"
"如何盛传她是如何如何的文雅、娴淑，却极少有能见过她的人。\n"
"不知从何时起，她竺信起道教来，所以一切讲究素雅。\n"
msgstr ""

#. es2:d/city/nroad2 long
#: data/city/rooms.json
msgid ""
"这是一条青石铺地的大驿道，地处京师的北郊。北方入京必经\n"
"此地。往南走就可以到京师了。东北是连绵的群山。\n"
msgstr ""

#. es2:d/city/nroad1 long
#: data/city/rooms.json
msgid ""
"你正走在一条青石铺地的大驿道上，四周人来人往。挑担子的\n"
"苦力，赶着大车的马夫，赴京传书的军人，熙熙攘攘，非常热闹。\n"
"不时还有两三骑快马从身边飞驰而过，引起一阵骚动。道路两旁各\n"
"有一片小树林，南边就是京师。\n"
msgstr ""

#. es2:d/city/northdoor long
#: data/city/rooms.json
msgid ""
"这是京师的北门，若干年前曾经遭到异族的攻打，因而显得有\n"
"些陈旧。城门正上方清析可见当朝名家书写的“京师北门”几个金\n"
"字，城墙上贴着几张告示(sign)。这里是罪犯逃往北方的必经之地，\n"
"官兵们戒备森严，动不动就截住行人盘问。一条笔直的青石板大道\n"
"向南北两边延伸。北边是郊外，骑马的、座轿的、走路的，行人匆\n"
"匆涌入京师。南边是城里，隐约传来阵阵的喧闹声。\n"
msgstr ""

#. es2:d/city/street16 long
#: data/city/rooms.json
msgid ""
"从这里再往北走就出了京师的北城门，在与异族交战的时期，为\n"
"方便盘查行人，官兵在这儿放了一道很大的栅栏。后来尽管战争结束\n"
"了，栅栏拿走了，但老人们还是习惯地把这叫做“大栅栏”，用京音\n"
"读起来就变成了“大世烂儿”。西面是护国寺的侧门。\n"
msgstr ""

#. es2:d/city/bank long
#: data/city/rooms.json
msgid ""
"这是一间素来不讲信用的钱庄，钱庄的老板倒是读过几年书，脑筋\n"
"很活络，你可以看到钱庄里里外外都打扫得乾乾净净，一个精瘦精瘦的\n"
"中年人坐在柜台后面，柜台上放著一块牌子(sign)，往南是通往京城街\n"
"道的大门。\n"
msgstr ""

#. es2:d/city/weapon long
#: data/city/rooms.json
msgid ""
"这里是江湖中人人所向往的京师武器店。店铺宽敞，红砖铺地。\n"
"四周的墙壁上挂满了各式的刀剑。东边的武器架上的枪戟的反光令\n"
"你睁不开眼。靠北墙的大柜台一尘不染，几个伙计正在忙碌。\n"
"    靠近店门的地方有一块金字招牌(sign)。\n"
msgstr ""

#. es2:d/city/westdoor1 long
#: data/city/rooms.json
msgid ""
"你来到京师的西一门。城墙上贴着几张官家布告(notice)。东\n"
"北方是大相国寺，不时传来几声钟声。西边是城外，抬头可见远处\n"
"连绵的群山。东边就是京师的街道了。\n"
msgstr ""

#. es2:d/city/street14 long
#: data/city/rooms.json
msgid ""
"这里是京师的大街上。西边是京师的西一门，护国寺的僧人西\n"
"去取经必经此地。福缘好的话还可以看到几个有道高僧路过。\n"
msgstr ""

#. es2:d/city/street15 long
#: data/city/rooms.json
msgid ""
"你来到京师的大街。北边是护国寺的大门，寺内香烟缭绕。\n"
msgstr ""

#. es2:d/city/street7 long
#: data/city/rooms.json
msgid ""
"京师的中轴线和北面的主要街道护国道在这里交叉，东西向的护\n"
"国道上人来人往，热闹非凡，南面的皇家祭坛反倒冷冷清清，往北可\n"
"以望到大红颜色的北城门。\n"
msgstr ""

#. es2:d/city/street8 long
#: data/city/rooms.json
msgid ""
"你现在正走在京师的大街上，往东可以隐约看到城门铜扣上的反\n"
"光，在你的北边是京城唯一的钱庄，往西有熙熙攘攘的人群，偶尔还\n"
"能见到一俩个僧侣。\n"
msgstr ""

#. es2:d/city/street9 long
#: data/city/rooms.json
msgid ""
"你现在正走在京师的大街上。东边就是京师的东一门了，隐约\n"
"传来官兵搜查行人的吆喝声。在你的北边是京城的武器店，据说江\n"
"湖上半数以上的武器精品出于此店。从店中走出的人都是一副心满\n"
"意足的模样。\n"
msgstr ""

#. es2:d/city/eastdoor1 long
#: data/city/rooms.json
msgid ""
"你来到京师的东一门。城门口十来个手持刀枪的士兵正在检查\n"
"过往的行人。经常有一些富丽堂皇的大车缓缓驶入城来，那是京师\n"
"的官宦人家出游归来。城墙上有一张陈旧的布告(notice)。东边是\n"
"城外，风景如画。西边是京师的街道。\n"
msgstr ""

#. es2:d/city/feiyuan long
#: data/city/rooms.json
msgid ""
"你来到一所废园里。据说废园的主人原也是位极人臣的，后来却\n"
"以「莫须有」的罪名被皇上斩了全族，其他的官员怕晦气，都不敢来\n"
"此住，遂形成废园。废园里荒草丛生，往日的辉煌已不再现，仅留下\n"
"几个残垣供人凭吊。\n"
msgstr ""

#. es2:d/city/jitan long
#: data/city/rooms.json
msgid ""
"这是一片宽阔的小广场，广场的中间是皇家的祭坛(altar)，每年\n"
"朝廷庆祝丰收或祈祷的重大典礼都在这里举行，皇上、皇后和文武百\n"
"官能上祭坛，其他人只能从旁边绕过去。除了禁卫军的官兵和宫里的\n"
"杂役偶尔出入外，很少有人来往。往南是紫禁城的神武门，北面是一\n"
"个非常热闹的十字路口。\n"
msgstr ""

#. es2:d/city/biaoju long
#: data/city/rooms.json
msgid ""
"你来到了振远总局里。镖局虽然不大，但在京师这块土地上，已无人\n"
"不知其名。尤其是其总镖头，俨然是以京城武林领袖自居。\n"
msgstr ""

#. es2:d/city/cloth long
#: data/city/rooms.json
msgid ""
"四喜绸缎庄是京师中的一家刚刚开业的专营衣帽的商店。店内\n"
"顾客稀少，显得店铺空荡荡的。柜台上凌乱地摊着几匹绸缎。绸缎\n"
"庄的老板出去进货了，只有老板娘空守店铺。据说这家店铺很有来\n"
"历。一般的地痞也很少到店中闹事。\n"
"    店堂上挂有一块崭新的招牌(sign)。\n"
msgstr ""

#. es2:d/city/street6 long
#: data/city/rooms.json
msgid ""
"你现在正走在京师的街道上。往东走便是紫禁城的后门--神武门\n"
"，南面似乎有一家酒楼，酒肉的香味一阵阵飘来。北边是一个废园，\n"
"据说里面经常闹鬼，所以没人敢去。\n"
msgstr ""

#. es2:d/city/shenwumen long
#: data/city/rooms.json
msgid ""
"你来到紫禁城的北门--神武门。南向的大门通向紫禁城，但这门\n"
"很少开。门上缠着大铁链，还有士兵把守。往北走是皇家祭坛，不是\n"
"一年一度祭天时那总很冷清。东西向的道路分别通向京师东，西路。\n"
msgstr ""

#. es2:d/city/street1 long
#: data/city/rooms.json
msgid ""
"这里是京师东街的北段。往北走有一个大院子，院里立着根老高\n"
"老高的旗杆，上书一个斗大的「镖」字，隔很远就可以看见。镖局的\n"
"生意似乎很好，人络绎不绝。西向是庄严的神武门。向南则去向尚书\n"
"府和午门。\n"
msgstr ""

#. es2:d/city/jiulou long
#: data/city/rooms.json
msgid ""
"你走到了一家大酒楼里。四周的装饰金壁辉煌，令人眼花缭乱，连餐\n"
"具的做工也极讲究，不愧是京城的第一大酒楼。酒楼的菜肴是远近闻名的\n"
"，在这经常可以看到一些达官贵族，据连当今皇上也曾微服来此以一饱口\n"
"福。\n"
msgstr ""

#. es2:d/city/street5 long
#: data/city/rooms.json
msgid ""
"你现在正走在京师的街道上，西边是京师最有名的“太白酒楼”，\n"
"酒楼里三教九流的人物都有，嘈杂声不绝于耳。东边紧邻着紫禁城的\n"
"城墙(wall)。街道向南北方向延伸着。\n"
msgstr ""

#. es2:d/city/street2 long
#: data/city/rooms.json
msgid ""
"你走在京师东街的中段。这里夹在紫禁城城墙与尚书府院墙之间\n"
"，南向的道路通向午门和尚书府的大门，而北方不远处振远总局的旗\n"
"杆依稀可见，令人隐隐约约地感到一种杀气。\n"
msgstr ""

#. es2:d/city/xiangguo/gate long
#: data/city/rooms.json
msgid ""
"你来到相国府的大门处。虽然相国在朝中也是地位显赫，但与对\n"
"面尚书府比起来，相国的府第显的寒酸得多。一切都十分简单，只有\n"
"牌匾上的「相国府」还提醒着人们主人的地位。\n"
msgstr ""

#. es2:d/city/street4 long
#: data/city/rooms.json
msgid ""
"你现在正走在京师的街道上。东边是进出紫禁城的午门，西边则\n"
"是当朝地位显赫的相国的府宅，而北边不远处“太白酒楼”的喧哗声\n"
"依稀可闻。\n"
msgstr ""

#. es2:d/city/wumen long
#: data/city/rooms.json
msgid ""
"这里是京师的午门。午门进出紫禁城的要道，北面那庄严的大门\n"
"(gate)后面便是神秘的紫禁城。大门的两侧放着一对石狮(statue)，\n"
"虎视眈眈地盯着来往的人群。南面是历年选武状元的校武场，也不知\n"
"现在有没有人。东西向的街道围绕着紫禁城。\n"
msgstr ""

#. es2:d/city/street3 long
#: data/city/rooms.json
msgid ""
"这是京师东街的南段。整个东街都被掌管天下兵马印的尚书府占\n"
"据了，东边便是尚书府的大门，南边则是尚书府高耸的围墙(wall)，\n"
"北去的道路一直通向振远总局。\n"
msgstr ""

#. es2:d/city/jiaowu long
#: data/city/rooms.json
msgid ""
"这里是京师的校武场。一些御林军正在这里日夜操练，喊杀声\n"
"此起彼伏。几个骑着高头大马的将领，在场上来回地巡视。每年武\n"
"考也是在此举行的，当年淤兰天武、萧避尘、蓝芷萍就是在此出尽\n"
"了风头，一时间声名传遍长城内外、大江南北。\n"
"    北边是午门，南边是热闹的天桥了。\n"
msgstr ""

#. es2:d/city/boots long
#: data/city/rooms.json
msgid ""
"这里是京师中最大的一家鞋店。店主姓李，历经几代，已是百\n"
"年老店。店铺挺大，弥漫着一种特殊皮革的气味。大柜台后面的架\n"
"子上放满了各式的皮靴。店中几个伙计正在忙碌。\n"
"    店门口有一块金字招牌(sign)。\n"
msgstr ""

#. es2:d/city/westdoor2 long
#: data/city/rooms.json
msgid ""
"你来到京师的西二门，西二门虽不如京师的其他几个城门高大。\n"
"但高高的城墙也非一般人所能攀越，城墙上贴着几张布告(notice)。\n"
"西边是城外，据说一直往西就可到达一个仙境。东边就是京师的街\n"
"道了。\n"
msgstr ""

#. es2:d/city/street13 long
#: data/city/rooms.json
msgid ""
"你来到京师的大街上。西边是京师的西二门，西去的人不时经\n"
"过这里。南边是京师的监狱，关押着一些重要的犯人。站在这里可\n"
"以清楚地听到狱卒拷打犯人的皮鞭声和犯人的惨叫声。\n"
msgstr ""

#. es2:d/city/street12 long
#: data/city/rooms.json
msgid ""
"这里是京师的大街，青石铺道，街面很干净。东边是京师的热\n"
"闹场所天桥，来到京师可不能不去哦。南边是京师的刑场，逢上处\n"
"决一些重要的犯人的时候，那里肯定是人山人海，不过平时人就少\n"
"得多了。\n"
msgstr ""

#. es2:d/city/bridge long
#: data/city/rooms.json
msgid ""
"你来到京师的天桥。这里热闹非凡，人声鼎沸。杂耍的、卖艺\n"
"的、做小买卖的应有尽有。若是仔细寻找，说不定可以买到什么奇\n"
"珍异宝呢。柱子和墙壁上贴满着花花绿绿的广告（post）。\n"
"    北边是校武场。再往北就到京师中心……紫禁城了。\n"
msgstr ""

#. es2:d/city/street11 long
#: data/city/rooms.json
msgid ""
"这里是京师的大街。西边是京师的热闹场所天桥，一些行人匆\n"
"匆往西走去。据说天桥的夜市也不差哦。南边是一片民宅，炊烟缭\n"
"绕。\n"
msgstr ""

#. es2:d/city/street10 long
#: data/city/rooms.json
msgid ""
"这里是京师的大街。东边是京师的东二门，一些刚进城的行人\n"
"坐在路边休息，不时发出一阵哄笑声。往西就可以到京师中心了。\n"
msgstr ""

#. es2:d/city/eastdoor2 long
#: data/city/rooms.json
msgid ""
"这里是京师的东二门。城门上插着几面旗帜，标志了本门的守\n"
"城将领。城楼里坐着几个将军打扮的人，城墙上有一张刚刚粘贴上\n"
"去的布告(notice)，一群人正围着观看。东边是城外，西边是京师\n"
"的街道。\n"
msgstr ""

#. es2:d/city/street17 long
#: data/city/rooms.json
msgid ""
"你来到京师的大街上。南边是京师的南门，出了南门就可去南\n"
"方重镇……南海镇。北边是天桥，人声鼎沸。西边是刑场，一个一\n"
"般人极少去的地方。\n"
msgstr ""

#. es2:d/city/southdoor long
#: data/city/rooms.json
msgid ""
"这是京师的南门。高大的城门正上“京师南门”几个大字格外\n"
"显眼。城墙上贴着几张官家布告(notice)。西北方是京师的监狱，\n"
"关押着一些要犯，因此这里的官兵们也戒备森严。南边是城外，不\n"
"时走来几个赴京赶考的举子。北边就是京师，一个灯红酒绿的地方。\n"
msgstr ""

#. es2:d/city/jiulou_2 long
#: data/city/rooms.json
msgid ""
"你走上了太白酒楼的二楼，酒楼的雅座便设于此。大凡有来头\n"
"的客人都到此饮酒作乐。在此经常可以遇上一些达官贵族，一些为\n"
"做官的富家子弟就来此打进阶的消息。墙边有一道楼梯通往一楼的\n"
"茶座。\n"
msgstr ""

#. es2:d/city/shangshu/gate long
#: data/city/rooms.json
msgid ""
"你来到尚书府大门。门上悬挂着一块很大的黑色牌匾，上面用隶\n"
"书写着三个金字「尚书府」。牌匾上的一行小字表明这是当今皇上所\n"
"题，可以看出其官势显赫。\n"
msgstr ""

#. es2:d/city/shangshu/yuan long
#: data/city/rooms.json
msgid ""
"你走到了尚书府的庭院。院子很大，地面规规整整地用清一色的\n"
"大青石铺就，显示出主人的气派。东边的府门时常关着，不是高官可\n"
"甭想进来。西向是主人会客的客厅。北行的石路通向客房，而向南则\n"
"是去往内院。\n"
msgstr ""

#. es2:d/city/shangshu/keting long
#: data/city/rooms.json
msgid ""
"这里是尚书府的会客厅，平常主人就在此接待客人。客厅的装饰\n"
"倒并不多，但都极其讲究。所有的家具都是用沉香木做的，时时发出\n"
"一股淡淡的香味。家具被擦得一尘不染的，整齐地排列在两旁。当中\n"
"的椅子尤其大，并铺以少见的白虎皮。\n"
msgstr ""

#. es2:d/city/shangshu/road2 long
#: data/city/rooms.json
msgid ""
"这里是尚书府的小径。小径继续向北延伸着，透过树丛隐隐约约\n"
"地看到那儿似乎有一间小屋。从这儿向东走就是一间客房，据说客房\n"
"里住的是一位贵客。不过一般人不允许进。\n"
msgstr ""

#. es2:d/city/shangshu/road1 long
#: data/city/rooms.json
msgid ""
"尚书府的小径走到这似乎到了尽头。小径的东边是一间小屋，平\n"
"时房门总是关的，每天按时由一名又聋又哑的仆役送饭进去，其他人\n"
"一概不让入内。南边不远处就是尚书府庭院了。\n"
msgstr ""

#. es2:d/city/shangshu/kefang long
#: data/city/rooms.json
msgid ""
"你走进了尚书府的客房。客房不大，但布置得比较整洁。靠窗的\n"
"小桌上摞放着几本书(book)，另一侧的墙上则挂了把宝剑，似乎告诉\n"
"来人此地主人竞是文武双全。\n"
msgstr ""

#. es2:d/city/shangshu/xiaowu long
#: data/city/rooms.json
msgid ""
"你步入尚书府内的一间小屋。小屋内很黑，什么也看不见，但莫\n"
"名地感到一股杀气，让人有转身就跑的念头。\n"
msgstr ""

#. es2:d/city/shangshu/road3 long
#: data/city/rooms.json
msgid ""
"这里是尚书府的花园小径。小径的南方就是花园，阵阵花香随风\n"
"飘过来，使人精神大振。厨房在小径的东面，而往南则去往尚书府的\n"
"庭院。\n"
msgstr ""

#. es2:d/city/shangshu/chufang long
#: data/city/rooms.json
msgid ""
"你来到了尚书府的厨房。厨房里各种烹饪用品与设备应有尽有，\n"
"而且用品的做工也都很精细，一眼便知是官家的用品。厨房里的炉火\n"
"烧得旺旺的，一个烧火丫鬟正忙着即将出锅的「西湖醋鱼」。\n"
msgstr ""

#. es2:d/city/shangshu/huayuan long
#: data/city/rooms.json
msgid ""
"尚书府的花园里搜集了许多名贵花卉。从洛阳的牡丹到扬州的琼\n"
"花，你不能不惊诧于这里的全来。四时的花卉竞相开放着，发出沁人\n"
"的香味。从花园东行就是内宅，而西边似乎有一间破屋。\n"
msgstr ""

#. es2:d/city/shangshu/neizhai long
#: data/city/rooms.json
msgid ""
"你轻轻地走进尚书府的内宅，男客一般是不让来此的。内宅的布\n"
"置很素雅，一切的摆设都显得很自然，有「天然去雕饰，清水出芙蓉\n"
"」的意味。西边就是你来时经过的花园。\n"
msgstr ""

#. es2:d/city/shangshu/road4 long
#: data/city/rooms.json
msgid ""
"你走在尚书府的一条僻静的小路上。这条小路连接着花园和一间\n"
"废弃的杂货屋，平常很少有人来此。东面的花园渐渐地远了，西面的\n"
"门都已经脱落的废屋已历历在目。北面是高耸的院墙。\n"
msgstr ""

#. es2:d/city/shangshu/feiwu long
#: data/city/rooms.json
msgid ""
"这是一间已被废弃的小屋。小屋很阴暗，也很潮湿。就着微弱的光线\n"
"，隐约看见小屋里胡乱地堆放着一些杂物。小屋里到处挂着蜘蛛网，显然\n"
"很久没有人来过了。\n"
msgstr ""

#. es2:d/city/wall long
#: data/city/rooms.json
msgid ""
"你爬上了尚书府的院墙，墙里面人来人往的，很是\n"
"热闹。你是跳进去(jump in)，还是回去(jump out)呢？\n"
msgstr ""

