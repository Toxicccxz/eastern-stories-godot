msgstr ""

#. common.npc.juechen.master apprentice.requires.refuse_say
#: data/common/npcs.json
msgid "$RESPECT似乎尚缺江湖历练，不宜投入绝尘门下。"
msgstr ""

#. common.npc.juechen.master apprentice.accept_say
#: data/common/npcs.json
msgid "很好$RESPECT多加努力他日必定有成。"
msgstr ""

