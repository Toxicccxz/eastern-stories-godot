msgstr ""

#. latemoon.latemoon7.door name
#: data/latemoon/world.json
msgid "石门"
msgstr ""

#. latemoon.room.twoc.door name
#: data/latemoon/world.json
msgid "后厅大门"
msgstr ""

#. latemoon.room.eroad1.door name
#. latemoon.room.wroad2.door name
#: data/latemoon/world.json
msgid "雕饰厢门"
msgstr ""

#. latemoon.room.corridor7.door name
#. latemoon.miroom2.door name
#: data/latemoon/world.json
msgid "垂花门"
msgstr ""

#. latemoon.room.flower1.door name
#: data/latemoon/world.json
