msgstr ""

#. es2:u/cloud/bookstore long
#: data/cloud/rooms.json
msgid ""
"你现在正站在书局里\n"
"    靠近门口的地方有一块乌木雕成的招牌(sign)。\n"
msgstr ""

#. es2:u/cloud/wroad0 long
#: data/cloud/rooms.json
msgid ""
