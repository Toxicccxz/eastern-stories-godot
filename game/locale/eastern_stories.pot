#: data/story/chapter3.json data/story/factions.json data/goathill/npcs.json data/niling/npcs.json data/niling/world.json data/guanbei/npcs.json data/imperial/npcs.json data/lancheng/npcs.json data/native/npcs.json
msgid "逆灵宫"
msgstr ""

#. main.chapter3 summary
#: data/story/chapter3.json
msgid "进野羊山北麓的黑道观，找到失踪的大寨主。"
msgstr ""

#. main.chapter3 reward.deed
#: data/story/chapter3.json
msgid "查清了逆灵宫纳供的真相"
msgstr ""

#. main.chapter3/lead objective
#: data/story/chapter3.json
msgid "黑衣道士往野羊山北麓去了。去打听北麓的道观：野羊寨的黄霸在山路边的土地庙里；淳风武馆的门房刘安禄也知道——若他肯说。"
msgstr ""

#. main.chapter3/lead/liu text
#: data/story/chapter3.json
msgid "刘安禄说了：野羊寨的大寨主霍铮是他拜过把子的大哥，半年前被北麓黑砖道观的道士带走，再没回来；那伙人自称逆灵宫。三寨主黄霸接了寨子，每年给道观纳供；他不肯伺候那群道士，才下山做了门房。纳供的车这几天上山，到山路转角，道士从北边山壁的裂口把东西吊上去——道观就在裂口上头。"
msgstr ""

#. main.chapter3/lead/hwang text
#: data/story/chapter3.json
msgid "黄霸说了：两年前北麓起了一座黑砖道观，自称逆灵宫，寨里折了一半弟兄；半年前大寨主霍铮、二寨主一前一后没了下落，寨子落到他手里。他打不过那些道士，每年纳供换野羊寨还在山上。今年的车已经上去了，这会儿该到了山路转角。"
msgstr ""

#. main.chapter3/cart objective
#: data/story/chapter3.json
msgid "去野羊山的山路转角，看黄霸的纳供车。"
msgstr ""

#. main.chapter3/cart text
#: data/story/chapter3.json
msgid "两个黑衣道士守着一辆盖着油布的车。车上的箱子一只只吊进北边山壁的裂口里——他们不走山路。"
msgstr ""

#. main.chapter3/gate objective
#: data/story/chapter3.json
msgid "逆灵宫就在裂口上头。找到失踪的大寨主霍铮。跟着纳供车上去、打倒押车道士攀绳，或者戴上黑衣道士的黑冠——黄霸那里有一顶。"
msgstr ""

#. main.chapter3/gate text
#: data/story/chapter3.json
msgid "你进了逆灵宫。"
msgstr ""

#. main.chapter3/way objective
#: data/story/chapter3.json
msgid "站稳脚跟，看看这是哪里。"
msgstr ""

#. main.chapter3/way/sneak text
#: data/story/chapter3.json
msgid "你缩在供品箱子中间，和纳供一起被吊上了裂口。绞盘旁的道士只当你是箱子。"
msgstr ""

#. main.chapter3/way/sneak reward.deed
#: data/story/chapter3.json
msgid "混在野羊寨的供品里进了逆灵宫"
msgstr ""

#. main.chapter3/way/force text
#: data/story/chapter3.json
msgid "你打倒了押车道士，攀着他们的绳子上了裂口。"
msgstr ""

#. main.chapter3/way/force reward.deed
#: data/story/chapter3.json
msgid "打倒押车道士闯进了逆灵宫"
msgstr ""

#. main.chapter3/way/robe text
#: data/story/chapter3.json
msgid "你戴上黑冠，押车道士只当你是宫里的人，让你自己攀了上去。"
msgstr ""

#. main.chapter3/way/robe reward.deed
#: data/story/chapter3.json
msgid "戴着黑冠走进了逆灵宫"
msgstr ""

#. main.chapter3/yard objective
#: data/story/chapter3.json
msgid "顺着货道往北，进黑砖山门，看看这座道观。戴着黑冠的，道士当你是自己人。"
msgstr ""

#. main.chapter3/yard text
#: data/story/chapter3.json
msgid "黑砖的前院：黑幡垂地，香炉里烧的不是香。前殿的门关着，东边的矮房是货栈。"
msgstr ""

#. main.chapter3/hall objective
#: data/story/chapter3.json
msgid "前殿的门关着。推开殿门进前殿，找到霍铮。"
msgstr ""

#. main.chapter3/hall text
#: data/story/chapter3.json
msgid "前殿里没有神像。五个黑冠道士面壁诵逆灵天书，领诵的敲着木鱼，谁进来都不抬头。殿西有门，殿北的门关着。"
msgstr ""

#. main.chapter3/ledger objective
#: data/story/chapter3.json
msgid "殿西是丹房和账房。账房的案上摊着纳供的账册，翻一翻。"
msgstr ""

#. main.chapter3/ledger text
#: data/story/chapter3.json
msgid "纳供的不只是金帛，是人：野羊寨三名「入丹房」；关北民夫七名，三名入丹房、四名留用；傅家坡七岁的孩童一名，「留用，待子时」。"
msgstr ""

#. main.chapter3/papers objective
#: data/story/chapter3.json
msgid "案上还有一叠盖着朱印的文书。"
msgstr ""

#. main.chapter3/papers text
#: data/story/chapter3.json
msgid "一叠盖着兵部大印的文书：「着逆灵宫代为收管」关北的河工、野羊山的「匪徒」。兵部的印，盖在一座黑道观的账上。"
msgstr ""

#. main.chapter3/dungeon objective
#: data/story/chapter3.json
msgid "丹房西南角有石阶往下。下地牢，找霍铮。"
msgstr ""

#. main.chapter3/dungeon text
#: data/story/chapter3.json
msgid "霍铮锁在西边的牢房里，瘦得脱了形，骂声还在；北边那间是傅家坡的石头，七岁，头上两个小抓揪；东边两个关北来的民夫。三扇铁栅门的钥匙在大弟子玄冥子腰上。"
msgstr ""

#. main.chapter3/altar objective
#: data/story/chapter3.json
msgid "牢门开不了，钥匙在大弟子玄冥子腰上。前殿北门后的后殿有诵经声——钥匙该在那里。"
msgstr ""

#. main.chapter3/altar text
#: data/story/chapter3.json
msgid "后殿没有神像，只有一座黑石坛。商玦行「唤首」：黑焰里现出一个无头的黑影，摸索着找什么。商玦把地牢钥匙丢给了玄冥子——「子时开坛，带祭品上来」——退进黑门，玄冥子跟着走了。坛底爬出两个鬼卒。"
msgstr ""

#. main.chapter3/ghosts objective
#: data/story/chapter3.json
msgid "坛底爬出来的鬼卒拦在你面前。打退它们。"
msgstr ""

#. main.chapter3/ghosts text
#: data/story/chapter3.json
msgid "鬼卒散成黑烟。坛后的黑门开着；地牢的钥匙在狱卒手里了。"
msgstr ""

#. main.chapter3/choice objective
#: data/story/chapter3.json
msgid "两件事只来得及做一件：回地牢，狱卒手里有钥匙了，救霍铮和石头；或者穿过黑门追商玦。"
msgstr ""

#. main.chapter3/choice/rescue text
#: data/story/chapter3.json
msgid "你打开了牢门。霍铮和石头跟你走了，关北的民夫自己逃回关北。商玦带着逆灵天书从后山下了崖，玄冥子跟着走了。"
msgstr ""

#. main.chapter3/choice/rescue reward.deed
#: data/story/chapter3.json
msgid "从逆灵宫的地牢里救出了霍铮和石头"
msgstr ""

#. main.chapter3/choice/chase text
#: data/story/chapter3.json
msgid "你穿过黑门和宫主的居所，追到了后山的崖径。等你再下地牢，狱卒已经动了手。"
msgstr ""

#. main.chapter3/choice/chase reward.deed
#: data/story/chapter3.json
msgid "穿过黑门追到了逆灵宫的后山"
msgstr ""

#. main.chapter3/home objective
#: data/story/chapter3.json
msgid "带霍铮回野羊山的土地庙。"
msgstr ""

#. main.chapter3/home text
#: data/story/chapter3.json
msgid "黄霸跪下让位，霍铮派弟兄送石头回傅家坡。野羊寨欠你一条命。"
msgstr ""

#. main.chapter3/duel objective
#: data/story/chapter3.json
msgid "追上商玦。"
msgstr ""

#. main.chapter3/duel text
#: data/story/chapter3.json
msgid "商玦割断绳索下了崖。玄冥子断后，和你一战，倒在崖径上；逆灵天书的残卷落在他身边。"
msgstr ""

#. main.chapter4 summary
#: data/story/chapter4.json
msgid "寒於宝衣在晚月庄。守它的人不白给。"
msgstr ""

#. main.chapter4 reward.deed
#: data/story/chapter4.json
msgid "找到了寒於宝衣"
msgstr ""

#. main.chapter4/lead objective
#: data/story/chapter4.json
msgid "寒於的宝衣在哪？水烟阁的潘军禅、南危水知道旧事。"
msgstr ""

#. main.chapter4/lead/pan text
#: data/story/chapter4.json
msgid "潘军禅说了：当年三件东西各归一处，宝衣归月神族保管。月神族早没了，只剩晚月庄——她们自称人灵区冥的后人，庄里供着神像，池边立着凤凰护庄。守它的人不白给。"
msgstr ""

#. main.chapter4/lead/nan text
#: data/story/chapter4.json
msgid "南危水说了：寒於的宝衣当年归月神族保管，月神族的后人在晚月庄，供着人灵区冥的神像。守衣的人几百年没换过。"
msgstr ""

#. main.chapter4/manor objective
#: data/story/chapter4.json
msgid "去晚月庄。绮云镇西出镇的石板路尽头。"
msgstr ""

#. main.chapter4/manor text
#: data/story/chapter4.json
msgid "晚月庄的前厅。庄里来的都是找宝衣的人：逍遥派的芙云、天山派的梦玉楼、书房里的老妇和那个蒙面杀手，还有西厢的客人。"
msgstr ""

#. main.chapter4/annie objective
#: data/story/chapter4.json
msgid "西厢的客人安妮儿也在等宝衣。去问她。"
msgstr ""

#. main.chapter4/annie text
#: data/story/chapter4.json
msgid "安妮儿——东方神教的一代教主——在西厢住了三年。她说她等一件东西，也等一个配得上它的人。"
msgstr ""

#. main.chapter4/keeper objective
#: data/story/chapter4.json
msgid "东厢的瑷伦是守衣人。问她宝衣。"
msgstr ""

#. main.chapter4/keeper text
#: data/story/chapter4.json
msgid "瑷伦认了：衣在庄里，她守着，守了几百年——三十七岁的脸。宝衣不白给：接她三鞭，站着不倒，再谈。"
msgstr ""

#. main.chapter4/lashes objective
#: data/story/chapter4.json
msgid "接瑷伦三鞭。倒了可以歇好再来。"
msgstr ""

#. main.chapter4/lashes text
#: data/story/chapter4.json
msgid "你接下了瑷伦的三鞭。她收起鞭子，问你一句：你拿它去做什么。"
msgstr ""

#. main.chapter4/question objective
#: data/story/chapter4.json
msgid "瑷伦问：你拿它去做什么？——为了斩鬼、交给安妮儿，还是不知道。"
msgstr ""

#. main.chapter4/question/slay text
#: data/story/chapter4.json
msgid "你说：为了斩鬼。瑷伦点头：寒於留它，本来就是为这个。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr ""

#. main.chapter4/question/slay reward.deed
#: data/story/chapter4.json
msgid "对守衣人说，要拿寒於宝衣去斩鬼"
msgstr ""

#. main.chapter4/question/for_annie text
#: data/story/chapter4.json
msgid "你说：交给安妮儿。瑷伦的脸冷了下来，却不拦：拿得走就拿。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr ""

#. main.chapter4/question/for_annie reward.deed
#: data/story/chapter4.json
msgid "对守衣人说，要把寒於宝衣交给安妮儿"
msgstr ""

#. main.chapter4/question/unsure text
#: data/story/chapter4.json
msgid "你说：不知道。瑷伦说，不知道比胡说一个好。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr ""

#. main.chapter4/question/unsure reward.deed
#: data/story/chapter4.json
msgid "对守衣人说，还不知道拿寒於宝衣做什么"
msgstr ""

#. main.chapter4/chest objective
#: data/story/chapter4.json
msgid "宝衣在第二密室的冰匣里，匣只认「有凤来仪」：女子自己跳，男子请内厅的筱薇或禁闭房的芳绫替跳。第二密室从内厅穿堂南边的花门进，或在第一密室跳「有凤来仪」。"
msgstr ""

#. main.chapter4/chest text
#: data/story/chapter4.json
msgid "冰匣开了。一件月白的衣落在地上，寒气扑面。"
msgstr ""

#. main.chapter4/choice objective
#: data/story/chapter4.json
msgid "宝衣到手。交回瑷伦守到决战；交给安妮儿，或者带着它走出晚月庄的大门——宝衣一离开瑷伦，庄就没了护佑，当夜会出事。"
msgstr ""

#. main.chapter4/choice/to_annie text
#: data/story/chapter4.json
msgid "你把宝衣交给了安妮儿。她说：月神族守了几百年，守给我的。你配得上——东方神教记得你。"
msgstr ""

#. main.chapter4/choice/to_annie reward.deed
#: data/story/chapter4.json
msgid "把寒於宝衣交给了东方神教的安妮儿"
msgstr ""

#. main.chapter4/choice/keep text
#: data/story/chapter4.json
msgid "你把宝衣交回瑷伦。她披上它：我守到决战那日。到时候你来叫我，我跟你下湖底。"
msgstr ""

#. main.chapter4/choice/keep reward.deed
#: data/story/chapter4.json
msgid "把寒於宝衣留给了守衣人瑷伦"
msgstr ""

#. main.chapter4/choice/take text
#: data/story/chapter4.json
msgid "你带着宝衣走出了晚月庄的大门。庄失去了护佑。"
msgstr ""

#. main.chapter4/choice/take reward.deed
#: data/story/chapter4.json
msgid "带走了寒於宝衣"
msgstr ""

#. main.chapter5 title
#. choyin.npc.judgeman inquiry topic
#. native.npc.chen_witness title
#: data/story/chapter5.json data/choyin/npcs.json data/native/npcs.json
msgid "人证"
msgstr ""

#. main.chapter5 summary
#: data/story/chapter5.json
msgid "兵部的印是真的，令不是先帝的。要动兵部的人，须有人在堂上说。"
msgstr ""

#. main.chapter5 reward.deed
#: data/story/chapter5.json
msgid "把寻剑令的真相递到了乔阴县的公堂上"
msgstr ""

#. main.chapter5/drum objective
#: data/story/chapter5.json
msgid "带着逆灵宫那叠盖兵部印的文书去乔阴县衙，击门口的大皮鼓。没带文书，侍卫不开门——文书还躺在逆灵宫的账房。"
msgstr ""

#. main.chapter5/drum text
#: data/story/chapter5.json
msgid "带刀侍卫从内院出来：是你击鼓申冤吗？——衙门的大门开了。"
msgstr ""

#. main.chapter5/hear objective
#: data/story/chapter5.json
msgid "进大堂，把兵部文书给县官程不平看。"
msgstr ""

#. main.chapter5/hear text
#: data/story/chapter5.json
msgid "程不平看得出文书是真的，可要动兵部的人，须有人证——印是谁盖的，人去了哪，得有人在堂上说。他指了一个人：福林酒楼里日日发呆、丢了箱子的武官，姓陈。"
msgstr ""

#. main.chapter5/chen objective
#: data/story/chapter5.json
msgid "福林酒楼里丢了箱子的武官姓陈。给他看兵部的印。"
msgstr ""

#. main.chapter5/chen text
#: data/story/chapter5.json
msgid "陈显祖见了兵部的印脸色就变：他是二十年前老松岭那队白衣武官里的逃兵。当年念给全队听的寻剑令抄本一直藏在他的桃木箱里——箱子丢在树王坟的树洞里。"
msgstr ""

#. main.chapter5/copy objective
#: data/story/chapter5.json
msgid "寻剑令的抄本在陈显祖的桃木箱里。箱子在树王坟的树洞里——洞里不干净。箱子已经还了他的，问他要抄本。"
msgstr ""

#. main.chapter5/copy text
#: data/story/chapter5.json
msgid "寻剑令的抄本到手：「寻剑，不得扰民一户」，一句。底下是当年全队的名字。"
msgstr ""

#. main.chapter5/guard objective
#: data/story/chapter5.json
msgid "县衙的带刀侍卫是槐阳王的人。问他兵部的令。"
msgstr ""

#. main.chapter5/guard text
#: data/story/chapter5.json
msgid "槐阳王也收到过兵部「征三千民夫修官道寻剑」的令。老王爷拒了。"
msgstr ""

#. main.chapter5/choice objective
#: data/story/chapter5.json
msgid "护送陈显祖进衙门作证（问他「作证」），或放他带箱子走（「走吧」）。"
msgstr ""

#. main.chapter5/choice/escort text
#: data/story/chapter5.json
msgid "你把陈显祖护送进了乔阴县衙。福林大街上庾家的人动了手——他活着站上了公堂。"
msgstr ""

#. main.chapter5/choice/escort reward.deed
#: data/story/chapter5.json
msgid "护送陈显祖上了乔阴县的公堂"
msgstr ""

#. main.chapter5/choice/release text
#: data/story/chapter5.json
msgid "你放陈显祖带着箱子走了。抄本和文书留在你手里。"
msgstr ""

#. main.chapter5/choice/release reward.deed
#: data/story/chapter5.json
msgid "放陈显祖带着箱子走了"
msgstr ""

#. main.chapter5/trial objective
#: data/story/chapter5.json
msgid "堂审。带着抄本和兵部文书回大堂见程不平。"
msgstr ""

#. main.chapter5/trial text
#: data/story/chapter5.json
msgid "程不平录了供，写信给叔父槐阳王：假印和失踪的人都往关北去了。兵部的海捕文书也到了县衙——说你是逆灵宫的同党。程不平压着，压不了几天；文书往雪亭去了，你住的那家客栈。"
msgstr ""

#. main.chapter6 title
#. main.chapter6 region
#. ending cards.title
#. canyon.npc.general inquiry topic
#. village.npc.oldliu inquiry topic
#. native.npc.guanbei_corvee inquiry topic
#. native.npc.xuan_mingzi_cliff inquiry topic
#. native.npc.pass_gate_soldier inquiry topic
#. native.npc.camel_driver inquiry topic
#. native.npc.balang inquiry topic
#. guanbei name
#: data/story/chapter6.json data/story/epilogue.json data/canyon/npcs.json data/village/npcs.json data/niling/npcs.json data/guanbei/npcs.json data/guanbei/world.json
msgid "关北"
msgstr ""

#. main.chapter6 summary
#: data/story/chapter6.json
msgid "假印和失踪的人都往关北去了。先在天驼关把印的事问清楚，再出关去槐阳城，把程不平的信递给槐阳王；然后借兵踏平工地，或者带郭承夜里潜进去。卢卡说他们那边也传说一个找头的鬼。"
msgstr ""

#. main.chapter6 reward.deed
#: data/story/chapter6.json
msgid "在关北救出了兵部工地上的民夫"
msgstr ""

#. main.chapter6/general objective
#: data/story/chapter6.json
msgid "带着程不平的信去天驼关军营，给镇国大将军严廷殷看（军营要大队长的名册）。"
msgstr ""

#. main.chapter6/general text
#: data/story/chapter6.json
msgid "严廷殷看了信：兵部的印是真的，令不是先帝的——这话他不敢说。他的印丢过一回，找回来了；那三天的事，军师比他清楚。"
msgstr ""

#. main.chapter6/general checklist.label
#. main.chapter6/palace checklist.label
#: data/story/chapter6.json
msgid "程不平的信在你身上"
msgstr ""

#. main.chapter6/general checklist.missing
#. main.chapter6/palace checklist.missing
#: data/story/chapter6.json
msgid "信丢了的话，回乔阴县衙问程不平「兵部文书」，他会再写一封"
msgstr ""

#. main.chapter6/adviser objective
#: data/story/chapter6.json
msgid "军师赫造基知道印的事。他卖秘密——八两银子。"
msgstr ""

#. main.chapter6/adviser text
#: data/story/chapter6.json
msgid "赫造基收了八两银子：真印丢的那几天他拓了模子，卖了一份给兵部来的人。留着的那一份印模，他给了你。"
msgstr ""

#. main.chapter6/seal objective
#: data/story/chapter6.json
msgid "拿印模比一比兵部文书上的印（印模的「比印」）。真印泛黄光，假的没上朱。"
msgstr ""

#. main.chapter6/seal text
#: data/story/chapter6.json
msgid "印模上的朱砂正红、泛黄光；兵部文书上那方「镇国大将军」印暗红发黑。字口一笔不差，只差一个颜色：兵部的文书是真的，镇国大将军的印是照模子浇的，令是兵部添的。"
msgstr ""

#. main.chapter6/gate objective
#: data/story/chapter6.json
msgid "出关：天驼关谷地东壁的关门。有信、名册上有你、留五两过路钱，或者打过去。"
msgstr ""

#. main.chapter6/gate text
#: data/story/chapter6.json
msgid "关门兵放了行。门后的军道绕过骆驼东峰往北折。"
msgstr ""

#. main.chapter6/guanbei objective
#: data/story/chapter6.json
msgid "顺着军道往北，出了山就是关北。"
msgstr ""

#. main.chapter6/guanbei text
#: data/story/chapter6.json
msgid "黄土变成了草。路边一方青石界碑：「关北封国界」。往北，一座土黄的城墙横在草地尽头——槐阳城。"
msgstr ""

#. main.chapter6/town objective
#: data/story/chapter6.json
msgid "进槐阳城。城门旁有一张王府的告示，看看。"
msgstr ""

#. main.chapter6/town text
#: data/story/chapter6.json
msgid "王府的告示：「兵部征夫令，本府不奉。有持兵部文书到关北拿人者，以盗论。」告示上的印色正红——和逆灵宫那叠文书上的不一样。"
msgstr ""

#. main.chapter6/palace objective
#: data/story/chapter6.json
msgid "王府在大街北头。门军认程不平的信；把信递给槐阳王程朔。"
msgstr ""

#. main.chapter6/palace text
#: data/story/chapter6.json
msgid "程朔读了信：兵部的印是真的，令不是先帝的——他早说了。失踪的人在草原东边兵部的工地上挖一座古冢，挖不动的让道士的车接走。两条路：借他的兵踏平，或者让郭承带你夜里进去。"
msgstr ""

#. main.chapter6/plan objective
#: data/story/chapter6.json
msgid "借槐阳王的兵踏平工地（问程朔「借兵」：救下所有人，但兵部会说关北反了），或带骁将郭承夜里潜入（在校场问郭承「潜入」：救一半，王府干净）。"
msgstr ""

#. main.chapter6/plan/raid text
#: data/story/chapter6.json
msgid "你借了槐阳王的兵。程朔：「踏平了，兵部的文书第二天就到京师：槐阳王反了。」郭承领六骑听你的。"
msgstr ""

#. main.chapter6/plan/raid reward.deed
#: data/story/chapter6.json
msgid "借了槐阳王的兵，要踏平兵部的工地"
msgstr ""

#. main.chapter6/plan/sneak text
#: data/story/chapter6.json
msgid "你和郭承约好了夜里潜入工地。「救得几个算几个，救不完的别回头。王府不知道这件事。」"
msgstr ""

#. main.chapter6/plan/sneak reward.deed
#: data/story/chapter6.json
msgid "和王府骁将郭承约好夜里潜入工地"
msgstr ""

#. main.chapter6/site objective
#: data/story/chapter6.json
msgid "去草原东边兵部的工地（出马市东门，过帐篷营地和草原）。借了兵的，郭承跟着你，白天就去；约好潜入的，先在营地的篝火边等到天黑。"
msgstr ""

#. main.chapter6/site text
#: data/story/chapter6.json
msgid "草原东边的工地：一道木栅栏，三顶帐篷，两溜民夫棚，土堆得像小山。白衣的武官守着门，监工吕隼拿着名册。"
msgstr ""

#. main.chapter6/raid objective
#: data/story/chapter6.json
msgid "踏平工地：打倒白衣武官、队长裴照和监工吕隼，打开民夫棚前的枷锁。"
msgstr ""

#. main.chapter6/raid text
#: data/story/chapter6.json
msgid "王府的六骑冲进了工地。白衣武官倒了，裴照倒了，吕隼趴在他的名册上。你打开了八副枷锁，八个民夫回营地去了；古冢口的道士丢下车跑了。兵部的文书明天就到京师：槐阳王反了。"
msgstr ""

#. main.chapter6/sneak objective
#: data/story/chapter6.json
msgid "夜里跟着郭承潜进工地，到民夫棚解枷。救得几个算几个，救不完的别回头。"
msgstr ""

#. main.chapter6/sneak text
#: data/story/chapter6.json
msgid "夜里的工地只有两个守夜的。你和郭承解开了四副枷锁——王石头、刘拐子、巴图、胡阿大跑了；第四副铁销响了，守夜的武官扑上来。打完，郭承说：走。另外四个人的名字，你在名册上见过：老魏、周二牛、陈满仓、马三。"
msgstr ""

#. main.chapter6/luca objective
#: data/story/chapter6.json
msgid "回马市问大秦剑手卢卡「会首」——他们那边也传说一个找自己脑袋的鬼。"
msgstr ""

#. main.chapter6/luca text
#: data/story/chapter6.json
msgid "卢卡说他的会首安敦在番坊，番坊的人知道那个鬼的事。番坊在海边：从玉螺湖村出忘情谷，走海崖道。"
msgstr ""

#. main.chapter7 summary
#: data/story/chapter7.json
msgid "卢卡说他的会首安敦在番坊，会首的祖上三百年前见过那个鬼的头是怎么封的。番坊在海边：从玉螺湖村出忘情谷，顺着小路往南，走海崖道下去。"
msgstr ""

#. main.chapter7 reward.deed
#: data/story/chapter7.json
msgid "从拜火祠取回了三百年前老兵刻下封法的铜牒"
msgstr ""

#. main.chapter7/fanfang objective
#: data/story/chapter7.json
msgid "去番坊找大秦人的会首安敦——卢卡说他们知道鬼的头在哪。出忘情谷，顺着小路往南，走海崖道。"
msgstr ""

#. main.chapter7/fanfang text
#: data/story/chapter7.json
msgid "林子到头，崖下第一次看见了海。海崖道顺着崖往南下去，崖脚是番坊的码头。"
msgstr ""

#. main.chapter7/hall objective
#: data/story/chapter7.json
msgid "找大秦人的会首安敦——市集北头，门口立着两面大盾的铁盾会，院子北头会首的屋。"
msgstr ""

#. main.chapter7/hall text
#: data/story/chapter7.json
msgid "铁盾会的会首安敦见了你：他的祖上三百年前替皇叔於兰淳焉打过北方的蛮族，其中一个老兵见过那个鬼的头是怎么封的。"
msgstr ""

#. main.chapter7/tablet_tale objective
#: data/story/chapter7.json
msgid "安敦的祖上把看见的刻在一片铜牒上，传到了他手里——问他「铜牒」。"
msgstr ""

#. main.chapter7/tablet_tale text
#: data/story/chapter7.json
msgid "铜牒存在拜火祠的火前，三十年了。祠规「火前不说谎」：取牒要过一场问话，三句。大秦人自己过不了——三十年前他们为了这块地在火前说过一句谎。"
msgstr ""

#. main.chapter7/side objective
#: data/story/chapter7.json
msgid "市舶司要清走大秦人，鬼笠馆的浪人想要他们的地。站大秦人（问安敦「站大秦人」：拜火祠过问话取牒，再替他们挡住冯禄），还是站浪人（去日陀罗寺南墙小门外的鬼笠馆，问早川「站浪人」，过他一刀，让浪人替你偷牒——浪人会作证，市舶司就把大秦人清出番坊）？"
msgstr ""

#. main.chapter7/side/rome text
#: data/story/chapter7.json
msgid "你站了大秦人。安敦：「三句真话，牒是你的。读了，再还我们一个人情：冯禄来的时候，站在门口。」"
msgstr ""

#. main.chapter7/side/rome reward.deed
#: data/story/chapter7.json
msgid "在番坊站到了大秦人一边"
msgstr ""

#. main.chapter7/side/ronin text
#: data/story/chapter7.json
msgid "你站了浪人。早川只说了一句：「要铜牒？过我一刀。」"
msgstr ""

#. main.chapter7/side/ronin reward.deed
#: data/story/chapter7.json
msgid "在番坊站到了浪人一边"
msgstr ""

#. main.chapter7/rome objective
#: data/story/chapter7.json
msgid "拜火祠（市集东头的黑石房子）：站到火前，答穆护三句真话，取铜牒。问的是你自己做过的事——撒一句谎，火蹿起来，当天不再问。"
msgstr ""

#. main.chapter7/rome text
#: data/story/chapter7.json
msgid "火静了。穆护从火坛底下取出铜牒，放在你手里——还是温的。「火前拿的，谁也不能说你偷。」"
msgstr ""

#. main.chapter7/gate objective
#: data/story/chapter7.json
msgid "回铁盾会：冯禄带着他雇的四个浪人到了院门口。站到门口去，对质那纸文书——有印模的，按在印旁边对一对印色；没有的，只能动手。"
msgstr ""

#. main.chapter7/gate text
#: data/story/chapter7.json
msgid "冯禄退走了。大秦人留下了，安敦说：「你欠我们的人情，我们记着；我们欠你的，也记着。」"
msgstr ""

#. main.chapter7/ronin objective
#: data/story/chapter7.json
msgid "鬼笠馆（日陀罗寺南墙的小门外，坡道底下）：找馆主早川直义，过他一刀——一击之内定生死。"
msgstr ""

#. main.chapter7/ronin text
#: data/story/chapter7.json
msgid "早川收刀入鞘：「过了。今夜，拜火祠——火坛前站着，别出声。」"
msgstr ""

#. main.chapter7/theft objective
#: data/story/chapter7.json
msgid "等到天黑（鬼笠馆的板地能歇到天黑），去拜火祠的火坛前站着，别出声。浪人替你偷牒。"
msgstr ""

#. main.chapter7/theft text
#: data/story/chapter7.json
msgid "黑影把铜牒塞进你手里，走了。祠里传出祭司的骂声。第二天，冯禄的文书有了浪人作证——铁盾会空了，安敦被押上了船，卢卡剩在码头上。"
msgstr ""

#. main.chapter7/read objective
#: data/story/chapter7.json
msgid "读铜牒——三百年前的老兵刻下的，那个鬼的头是怎么封的。"
msgstr ""

#. main.chapter7/read text
#: data/story/chapter7.json
msgid "「头在湖底冰下，以穿灵为钉；钉在，鬼不得全；钉拔，鬼成形；要灭它，三器齐；要再封，须有人留下。」——三百年前的老兵刻的。那把剑是钉子。"
msgstr ""

#. main.chapter8 title
#: data/story/chapter8.json
msgid "湖底封物"
msgstr ""

#. main.chapter8 summary
#: data/story/chapter8.json
msgid "铜牒说：头在湖底冰下，以穿灵为钉。那把剑钉着鬼的头——在玉螺湖底。渔夫说湖里不太平，别碰那把剑。"
msgstr ""

#. main.chapter8 reward.deed
#: data/story/chapter8.json
msgid "下到玉螺湖底，看清了三百年的封物"
msgstr ""

#. main.chapter8/lake objective
#: data/story/chapter8.json
msgid "回玉螺湖村，下湖底，看清封物。别拔那把剑。"
msgstr ""

#. main.chapter8/lake text
#: data/story/chapter8.json
msgid "你到了湖底。从湖心潜下来的，身后的入口结上了冰；从忘情谷下冰阶来的，一下阶就是冰龙的厅。"
msgstr ""

#. main.chapter8/cave objective
#: data/story/chapter8.json
msgid "玄冰上站不住人。顶住寒气，穿过冰龙的厅——它们是守者，不先动手就不打。"
msgstr ""

#. main.chapter8/cave text
#: data/story/chapter8.json
msgid "六条白鳞冰龙抬头看了你一眼，又盘了回去。"
msgstr ""

#. main.chapter8/pool objective
#: data/story/chapter8.json
msgid "冰龙厅的水潭底下透着白光。潜下去。"
msgstr ""

#. main.chapter8/pool text
#: data/story/chapter8.json
msgid "潭底的黑石台阶下是一间冰室：黑石封坛，冰里的头，钉着它的剑，柱里的人。"
msgstr ""

#. main.chapter8/seal objective
#: data/story/chapter8.json
msgid "看清封物：冰里的头、钉着它的剑、冰柱里的人。听她说——把铜牒念给冰柱里的人听。"
msgstr ""

#. main.chapter8/seal text
#: data/story/chapter8.json
msgid "璃虹：钉拔，它成形，先回这附近的村子；要灭它，三器齐——穿灵、旋芒、宝衣；要再封，须有人留下。"
msgstr ""

#. main.chapter8/choice objective
#: data/story/chapter8.json
msgid "商玦劝你拔剑。拔，剑到手、鬼醒；不拔，带着封法去京师和岚城，终章再回来。"
msgstr ""

#. main.chapter8/choice/pull text
#: data/story/chapter8.json
msgid "你拔出了穿灵。冰里的头睁开了眼，璃虹从冰里跌了出来，商玦笑着散成了黑烟。上岸——天黑之前。"
msgstr ""

#. main.chapter8/choice/pull reward.deed
#: data/story/chapter8.json
msgid "在玉螺湖底拔出了穿灵"
msgstr ""

#. main.chapter8/choice/keep text
#: data/story/chapter8.json
msgid "你没有动那把剑。璃虹给了你一片她的羽：再封的时候，放回坛上。"
msgstr ""

#. main.chapter8/choice/keep reward.deed
#: data/story/chapter8.json
msgid "在玉螺湖底看清了封物，没有动它"
msgstr ""

#. main.chapter8/night objective
#: data/story/chapter8.json
msgid "天黑了。鬼卒从湖里上来——守住村子：湖畔、村口、稻田边。（湖畔的木船边能等到天黑。）"
msgstr ""

#. main.chapter8/night text
#: data/story/chapter8.json
msgid "天亮了。村子烧了一半，渔夫死在岸边，璃虹在田老财家的东房里躺着。钉没了，它每一夜都在长。"
msgstr ""

#. main.chapter9 title
#. city.npc.shangshu.shangshu inquiry topic
#: data/story/chapter9.json data/city/npcs.json
msgid "原令"
msgstr ""

#. main.chapter9 summary
#: data/story/chapter9.json
msgid "璃虹说三器齐才灭得了它：穿灵、旋芒、宝衣。旋芒在岚城，岚城寻风而至——先帝找了它一辈子，寻剑的档案和那道寻剑令的原本都在皇城。去京师。"
msgstr ""

#. main.chapter9 reward.deed
#: data/story/chapter9.json
msgid "拿到了寻剑令的原本"
msgstr ""

#. main.chapter9/way objective
#: data/story/chapter9.json
msgid "进皇城。三条路：校武场的武举、相国府的公文，或者尚书府里有人知道的一条暗路。"
msgstr ""

#. main.chapter9/way/exam text
#: data/story/chapter9.json
msgid "校武场三场全胜，殿试授了御前侍卫腰牌。退朝时福安凑过来：皇上说，今夜养心殿。"
msgstr ""

#. main.chapter9/way/exam reward.deed
#: data/story/chapter9.json
msgid "在京师校武场中了武状元"
msgstr ""

#. main.chapter9/way/memorial text
#: data/story/chapter9.json
msgid "你随韦相国上了早朝。庾子建当殿驳了奏本，皇上「容朕想想」。退朝时福安追出来：皇上请相国的随员到养心殿说话。"
msgstr ""

#. main.chapter9/way/memorial reward.deed
#: data/story/chapter9.json
msgid "随韦相国上了早朝"
msgstr ""

#. main.chapter9/way/sneak text
#: data/story/chapter9.json
msgid "你从冷宫的井里爬了上来。"
msgstr ""

#. main.chapter9/way/sneak reward.deed
#: data/story/chapter9.json
msgid "从冷宫的枯井潜进了皇城"
msgstr ""

#. main.chapter9/audience objective
#: data/story/chapter9.json
msgid "见皇帝：福安说，养心殿。"
msgstr ""

#. main.chapter9/audience text
#: data/story/chapter9.json
msgid "养心殿里，十六岁的皇帝说：御书房里有父皇的匣子。"
msgstr ""

#. main.chapter9/decree objective
#: data/story/chapter9.json
msgid "御书房：把先帝的原令和兵部的抄本放在一起。"
msgstr ""

#. main.chapter9/decree text
#: data/story/chapter9.json
msgid "原令只一句：寻剑，不得扰民一户。抄本上多出来的三句，是拿着假印的人加的。皇帝给了你一页樵夫的旧记载：风停处即是城。"
msgstr ""

#. main.chapter9/choice objective
#: data/story/chapter9.json
msgid "怎么办：在养心殿朝上揭发（要原令加两样人证物证，关北踏平了工地的要三样）、去尚书府私了，或请皇上先解皇叔的通缉。"
msgstr ""

#. main.chapter9/choice/expose text
#: data/story/chapter9.json
msgid "太和殿上，原令和抄本并排摊开。庾子建拔了刀，冯策站在你身边。他下了狱。"
msgstr ""

#. main.chapter9/choice/expose reward.deed
#: data/story/chapter9.json
msgid "在太和殿上揭发了兵部尚书庾子建"
msgstr ""

#. main.chapter9/choice/deal text
#: data/story/chapter9.json
msgid "原令进了庾子建的火盆。你换来了先帝推敲遗书的手稿。他留在朝上。"
msgstr ""

#. main.chapter9/choice/deal reward.deed
#: data/story/chapter9.json
msgid "把先帝的原令交给了庾子建"
msgstr ""

#. main.chapter9/choice/uncle text
#: data/story/chapter9.json
msgid "皇帝亲笔写了手诏，东二门的布告撤了。手诏要送到水烟阁。"
msgstr ""

#. main.chapter9/choice/uncle reward.deed
#: data/story/chapter9.json
msgid "请皇帝撤了皇叔於兰天武的通缉"
msgstr ""

#. main.chapter9/uncle_road objective
#: data/story/chapter9.json
msgid "把手诏送到水烟阁，交给皇叔於兰天武。"
msgstr ""

#. main.chapter9/uncle_road text
#: data/story/chapter9.json
msgid "於兰天武读了手诏，把传功使交给萧辟尘，回京了。"
msgstr ""

#. main.chapter10 summary
#: data/story/chapter10.json
msgid "樵夫说：风停处即是城。岚城寻风而至，寻风而逝——天驼关石林里那面镜子后头，有一条原作没修完的路。"
msgstr ""

#. main.chapter10 reward.deed
#: data/story/chapter10.json
msgid "找到了岚城"
msgstr ""

#. main.chapter10/wind objective
#: data/story/chapter10.json
msgid "读懂风，找到岚城。天驼关石林那面镜子里，上道通到哪里？"
msgstr ""

#. main.chapter10/wind text
#: data/story/chapter10.json
msgid "风停了。"
msgstr ""

#. main.chapter10/city objective
#: data/story/chapter10.json
msgid "白石街尽头的风铃阁。"
msgstr ""

#. main.chapter10/city text
#: data/story/chapter10.json
msgid "风铃阁里，十口大铃，有的响，有的不响。"
msgstr ""

#. main.chapter10/elder objective
#: data/story/chapter10.json
msgid "见岚翁，问他旋芒。"
msgstr ""

#. main.chapter10/elder text
#: data/story/chapter10.json
msgid "岚翁：剑在云台。他不卖，不赏，只问谁拔。"
msgstr ""

#. main.chapter10/choice objective
#: data/story/chapter10.json
msgid "云台：谁拔旋芒——你自己（十铃里要响六口，先接岚翁的接风三刃）、皇叔（要他已经入朝）、萧辟尘（要带着他的风铃）。"
msgstr ""

#. main.chapter10/choice/self text
#: data/story/chapter10.json
msgid "风散了，剑落进你手里。岚翁说：十口铃里有人信你，剑就认你。"
msgstr ""

#. main.chapter10/choice/self reward.deed
#: data/story/chapter10.json
msgid "在岚城的云台上拔了旋芒"
msgstr ""

#. main.chapter10/choice/uncle text
#: data/story/chapter10.json
msgid "风把於兰天武送上云台。三百年前於兰家拔错了一把剑，这一把，他拔了。"
msgstr ""

#. main.chapter10/choice/uncle reward.deed
#: data/story/chapter10.json
msgid "在岚城的云台上，看着旋芒落进皇叔於兰天武手里"
msgstr ""

#. main.chapter10/choice/xiao text
#: data/story/chapter10.json
msgid "铃挂回了萧家的钩上，风把萧辟尘送回了家。剑落进他手里。"
msgstr ""

#. main.chapter10/choice/xiao reward.deed
#: data/story/chapter10.json
msgid "在岚城的云台上，看着旋芒落进萧辟尘手里"
msgstr ""

#. main.finale title
#: data/story/finale.json
msgid "回到湖底"
msgstr ""

#. main.finale summary
#: data/story/finale.json
msgid "穿灵、旋芒、宝衣。三器凑没凑齐，湖底那颗头都在等。拔钉，斩鬼，或者再封它。"
msgstr ""

#. main.finale reward.deed
#: data/story/finale.json
msgid "从玉螺湖底回到了雪亭镇，听了宣诏"
msgstr ""

#. main.finale/lake objective
#: data/story/finale.json
msgid "回到湖底。拔钉，斩鬼，或者再封它。"
msgstr ""

#. main.finale/lake text
#: data/story/finale.json
msgid "湖面平得像一块铁，结着一层黑冰。冰底下的光一下一下地暗下去。"
msgstr ""

#. main.finale/gather objective
#: data/story/finale.json
msgid "点将：三器在谁手里，来了几拨人。备好了，在湖畔「等到天黑」。"
msgstr ""

#. main.finale/gather text
#: data/story/finale.json
msgid "你在岸边等到了天黑。"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "穿灵在你手里"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "穿灵钉在封坛上"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "旋芒在你手里"
msgstr ""

#. main.finale/gather checklist.missing
#: data/story/finale.json
msgid "交给了庾子建"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "旋芒在皇叔手里，他在岸边"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "旋芒在萧辟尘手里，他在岸边"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "宝衣在你身上"
msgstr ""

#. main.finale/gather checklist.missing
#: data/story/finale.json
msgid "带上它，下湖前穿上"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "宝衣在瑷伦身上"
msgstr ""

#. main.finale/gather checklist.missing
#: data/story/finale.json
msgid "她在晚月庄东厢等你去叫（问她「湖底」）"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "宝衣在安妮儿身上，她在岸边"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "帮手"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "野羊寨（霍铮）守村口"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "关北的骑兵（郭承）守湖畔"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "铁盾会的盾守稻田边"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "冰龙没有动过，在冰龙厅"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "大内侍卫营（冯策）随你下湖"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "东方神教（安妮儿）守潭口"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "水烟阁（南危水）守潭口"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "水烟阁（卫沧澜）守潭口"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "封山（柳淳风）守渡口"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "北宗（柳绘心）守渡口"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "岸上：庾子建来要剑"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "三器都在，帮手也够：能灭它"
msgstr ""

#. main.finale/gather checklist.label
#: data/story/finale.json
msgid "这一回只能再封"
msgstr ""

#. main.finale/shore objective
#: data/story/finale.json
msgid "天黑了，鬼卒爬上了岸。没人守的地方你自己守；划到湖心，潜下去。"
msgstr ""

#. main.finale/shore text
#: data/story/finale.json
msgid "你潜下了湖。岸上的人替你守着。"
msgstr ""

#. main.finale/hall objective
#: data/story/finale.json
msgid "冰龙厅：商玦在水潭边等你。"
msgstr ""

#. main.finale/hall text
#: data/story/finale.json
msgid "商玦倒在冰龙厅的水潭边。"
msgstr ""

#. main.finale/depths objective
#: data/story/finale.json
msgid "水潭底下就是封坛。潜下去。"
msgstr ""

#. main.finale/depths text
#: data/story/finale.json
msgid "你回到了湖底。坛心的冰里，那颗头睁着眼。"
msgstr ""

#. main.finale/demon objective
#: data/story/finale.json
msgid "封坛：侮天鬼。（钉还钉着的，先拔出穿灵；拔过了的，到坛心「迎上去」。）"
msgstr ""

#. main.finale/demon text
#: data/story/finale.json
msgid "侮天鬼散成一团黑焰，退回了那颗头底下。"
msgstr ""

#. main.finale/end objective
#: data/story/finale.json
msgid "最后一下：三器齐、人够，可以钉下去灭了它——宝衣会烧掉；也可以把穿灵交给一个肯留下的人，再封。"
msgstr ""

#. main.finale/end/slay text
#: data/story/finale.json
msgid "旋芒斩它，宝衣挡它的黑焰，穿灵钉它的头。侮天鬼灭了，宝衣烧成了灰。"
msgstr ""

#. main.finale/end/slay reward.deed
#: data/story/finale.json
msgid "在玉螺湖底灭了侮天鬼"
msgstr ""

#. main.finale/end/seal_elon text
#: data/story/finale.json
msgid "瑷伦把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

#. main.finale/end/seal_elon reward.deed
#: data/story/finale.json
msgid "在玉螺湖底再封了侮天鬼，瑷伦留在了冰里"
msgstr ""

#. main.finale/end/seal_lihong text
#: data/story/finale.json
msgid "璃虹把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

#. main.finale/end/seal_lihong reward.deed
#: data/story/finale.json
msgid "在玉螺湖底再封了侮天鬼，璃虹留在了冰里"
msgstr ""

#. main.finale/end/seal_nan text
#: data/story/finale.json
msgid "南危水把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

#. main.finale/end/seal_nan reward.deed
#: data/story/finale.json
msgid "在玉螺湖底再封了侮天鬼，南危水留在了冰里"
msgstr ""

#. main.finale/end/seal_xiao text
#: data/story/finale.json
msgid "萧辟尘把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

#. main.finale/end/seal_xiao reward.deed
#: data/story/finale.json
msgid "在玉螺湖底再封了侮天鬼，萧辟尘留在了冰里"
msgstr ""

#. main.finale/end/seal_self text
#: data/story/finale.json
msgid "你把穿灵钉回那颗头上，自己留在了冰里。"
msgstr ""

#. main.finale/end/seal_self reward.deed
#: data/story/finale.json
msgid "在玉螺湖底再封了侮天鬼，自己留在了冰里"
msgstr ""

#. main.finale/home objective
#: data/story/finale.json
msgid "回雪亭镇。广场上，那队白衣武官又来了。"
msgstr ""

#. main.finale/home text
#: data/story/finale.json
msgid "雪亭镇的广场上，宣了诏。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "淳风武馆的门房换了个年轻人。刘安禄在野羊山上当他的二寨主，逢年过节下山喝一回酒。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "淳风武馆的门房还是那张桌子。刘安禄的事，镇上没人再提。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "淳风武馆的门房空了一冬。刘安禄走的那天没有人送，柳淳风在门里站了很久。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "淳风武馆的门房还是那张桌子。刘安禄的来历，武馆里只有三个人知道。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "淳风武馆照旧每天卯时开门，「剑不外传」四个字还挂在正厅。绮云镇口多了一块「北宗」的木牌，柳淳风从没去看过，也从没叫人摘。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "淳风武馆的内院开了一道侧门，镇上的孩子从那里进出。柳淳风书房朝着内院的那扇窗，一冬天都没有关。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "开春，你回了一趟山里，在老岑的坟前把信末那一行念给他听：风停处，替我再看一眼。——看过了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "广场上的人散了。卖馄饨的说，那天的官爷，跟三年前来的是同一拨。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "瀑布后的山洞里，那座无名的坟前多了一块碑，碑上没有字。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "瀑布后的山洞空了。那块腰牌后来回到了水烟阁，挂在葬剑亭里。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "老松寨的寨门还在，买路钱一年比一年收得少。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "这一年正月十七，虹台上没有推选。五长老的椅子空着，说是等一个回不来的人。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "这一年正月十七，虹台上推选盟主。卫沧澜回来了，没有人再提「代盟主」三个字。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "这一年正月十七，南危水上了虹台，只说了一句：老松岭的那个人，替我死了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "这一年正月十七，七长老颜违做了盟主。他说二十年的旧案，到此为止。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "传功使的位置空着。弟子们说，萧师父回城里去了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "东厢的门关着。庄里的人说，守衣人去守另一件东西了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "瑷伦回了东厢，宝衣挂在墙上。她说，几百年了，该歇一歇。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "瑷伦回了东厢，墙上挂衣的钉子空着。她说，衣裳烧了，守衣人也该歇了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "安妮儿把宝衣带回了东方神教。神教的香案上，多了一盏长明灯。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "安妮儿回了东方神教，带回去的是一捧灰。神教的香案上，多了一只小瓷坛、一盏长明灯。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "庄里少了一件东西，多了一个故事。池边的人说，护庄的光，那年暗了一暗。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "野羊寨的旗子又插回了山顶。霍铮说，逆灵宫的黑砖，拆下来正好砌寨墙。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "黄霸还在土地庙里收他的供。北麓的黑砖道观，没人敢上去看一眼。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "有人说在北边的雪里见过一个黑衣人，说话像念经。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "程不平的卷宗送上了京城。陈显祖回了乡，桃木箱里只剩一件旧官服。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "陈显祖带着他的箱子走了，没人知道去了哪里。福林酒楼的说书人，把这件事编成了一段新书。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "县衙门口的大皮鼓，又有人敢去敲了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "京城的诏书到了槐阳：槐阳王不反。城门上那张「槐阳反」的告示，郭承亲手撕了。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "槐阳城门上那张告示还贴着：槐阳反。程朔说，随他们说。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "槐阳王府照旧不问兵部的事。草原上没救出来的四个人，后来有两个自己走了回来。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "铁盾会的院子里又练起了盾。卢卡说，等他攒够了钱，要回海那边去看一看。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "铁盾会的院子空了。鬼笠馆的浪人占了那块地，早川直义从此不再出刀。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "拜火祠的火，一年到头没有灭过。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "傅家坡的草顶重新铺过了。渔夫的网挂在他家门口，没有人去收。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "玉螺湖的渔夫照旧撒网。湖底那盏灯，再没有人见过。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "石头长高了一截，天天往湖边跑。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "庾子建在天牢里过了冬。少年皇帝第一次在早朝上，说了一整句话。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "京城里都说，是兵部尚书带回了那把剑。皇帝在早朝上，一句话也没有说。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "庾子建还在兵部。他派人去过一回玉螺湖，回来的人说，湖面上什么也没有。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "於兰天武回了朝，把旋芒挂在养心殿的墙上，对少年皇帝说：剑是用来记事的。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "於兰天武回了朝，站在少年皇帝身后。"
msgstr ""

#. ending cards.title
#: data/story/epilogue.json
msgid "玉螺湖底"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "冰下封坛一片空。三百年的冰化了一半，水是清的。冰龙还在，只是不再抬头。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "冰下封坛的冰柱里，瑷伦披着宝衣站着，眼睛睁着。三百年后，会有人来叫醒她。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "冰下封坛的冰柱里，璃虹的光又亮了。她说过：第一个带着铜来的，是你。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "冰下封坛的冰柱里，南危水手按剑柄，像还在等什么人。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "冰下封坛的冰柱里，萧辟尘握着旋芒。岚城的风，每年会吹到湖面上一回。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "冰下封坛的冰柱里，站着一个年轻人。没有人知道他的名字。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖水清得能看见底。我说，那是人家的功劳，那碗茶不收钱。」"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖底冰里站着一个人。我说，那是替咱们守着的，逢年过节，要给他留一碗酒。」"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "店小二擦着桌子：「前些日子有个客官从这儿走出去，就再没回来。楼上那间房，我一直给他留着。」"
msgstr ""

#. ending cards.title
#: data/story/epilogue.json
msgid "终"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "那少年，便是你。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "那少年，留在了冰里。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "以《东方故事 2》（Eastern Stories 2）为底。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "谢谢 ES2 的作者们，和 MUD 年代守着它的巫师们。"
msgstr ""

#. ending cards.lines.text
#: data/story/epilogue.json
msgid "也谢谢你，走到了这里。"
msgstr ""

#. court place
#: data/story/factions.json
msgid "乔阴 · 天驼关 · 京师"
msgstr ""

#. niling place
#: data/story/factions.json
msgid "野羊山北麓"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "你是封山剑派的弟子，师父是柳淳风。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "你是封山剑派北宗的人，和柳绘心同辈。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "柳淳风认得老岑的信：淳风武馆的门，你随时进。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "柳淳风替你给水烟阁的潘军禅写过一封信。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "雪亭镇上没人再敢借淳风武馆的名头收钱。是你清的。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "逄义认了那块腰牌。他欠武馆一句交代。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "武馆的人都知道，是你说破了门房的来历。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "刘安禄的来历，你替他瞒着。他欠你一句话。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "你和血手刘三动过刀，放了他一条路。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "《悟疾风劲竹书》在柳淳风的匣里。是你从竹林里取回来给他的。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "柳绘心读到了父亲年轻时写的书。是你给她的。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "柳淳风认你是掌门传人，「点」字诀是他亲传的。北宗的牌子挂在绮云镇口。"
msgstr ""

#. fonxan lines.text
#: data/story/factions.json
msgid "你跟柳绘心立了北宗。柳淳风不再教你，武馆的门还开着。"
msgstr ""

#. zhenyuan lines.text
#: data/story/factions.json
msgid "你是振远镖局的人。"
msgstr ""

#. zhenyuan lines.text
#: data/story/factions.json
msgid "陈剑秋把二十年前那张镖单交给了你。这件事，振远至今不提。"
msgstr ""

#. celestial lines.text
#: data/story/factions.json
msgid "你是天邪派的弟子。"
msgstr ""

#. celestial lines.text
#: data/story/factions.json
msgid "潘军禅给你看过那柄「邪剑穿灵」：它是鱼饵。"
msgstr ""

#. celestial lines.text
#: data/story/factions.json
msgid "南危水把二十年的事托给了你。你没有告诉别人。"
msgstr ""

#. celestial lines.text
#: data/story/factions.json
msgid "颜违记得，五长老的事是你告诉他的。他从那天起代行盟主之职。"
msgstr ""

#. celestial lines.text
#: data/story/factions.json
msgid "盟主卫沧澜是你从尚书府带出来的。"
msgstr ""

#. celestial lines.text
#: data/story/factions.json
msgid "於兰天武的通缉是你解的。他回了京。"
msgstr ""

#. juechen lines.text
#: data/story/factions.json
msgid "你是绝尘派的弟子。"
msgstr ""

#. maoshan lines.text
#: data/story/factions.json
msgid "你是茅山派的弟子。"
msgstr ""

#. latemoon lines.text
#: data/story/factions.json
msgid "你是晚月庄的弟子。"
msgstr ""

#. latemoon lines.text
#: data/story/factions.json
msgid "寒於宝衣留在晚月庄。瑷伦替你守到决战。"
msgstr ""

#. latemoon lines.text
#: data/story/factions.json
msgid "宝衣是你带出庄的。那一夜，庄里死了人。"
msgstr ""

#. latemoon lines.text
#: data/story/factions.json
msgid "晚月庄守了几百年的宝衣，你交给了外人。"
msgstr ""

#. sanyen lines.text
#: data/story/factions.json
msgid "你是山烟寺的弟子。"
msgstr ""

#. buxuan lines.text
#: data/story/factions.json
msgid "你是步玄派的弟子。"
msgstr ""

#. buxuan lines.text
#: data/story/factions.json
msgid "骆云舟把骆家的名帖给了你。"
msgstr ""

#. huazi lines.text
#: data/story/factions.json
msgid "你是花紫会的人。"
msgstr ""

#. court name
#: data/story/factions.json
msgid "官府"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "乔阴知县程不平替你写过一封信。"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "陈显祖是你护送进县衙作的证。"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "天驼关的严廷殷看过程不平的信。"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "你是今科的武状元。"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "兵部尚书庾子建是你在朝上揭发的。"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "你和庾子建私了了。兵部记着这份情，也记着这笔账。"
msgstr ""

#. court lines.text
#: data/story/factions.json
msgid "大内侍卫营的冯策说过：算老夫一个。"
msgstr ""

#. dongfang lines.text
#: data/story/factions.json
msgid "安妮儿说，她在等一个配得上宝衣的人。"
msgstr ""

#. dongfang lines.text
#: data/story/factions.json
msgid "安妮儿说你配得上。东方神教记得你。"
msgstr ""

#. dongfang lines.text
#: data/story/factions.json
msgid "宝衣出了庄，没进安妮儿的门。她记下了你的名字。"
msgstr ""

#. dongfang lines.text
#: data/story/factions.json
msgid "你放过了神教的那个杀手。"
msgstr ""

#. niling lines.text
#: data/story/factions.json
msgid "你进过那座黑砖道观。"
msgstr ""

#. niling lines.text
#: data/story/factions.json
msgid "你见过「唤首」。他们知道有生人进过后殿。"
msgstr ""

#. niling lines.text
#: data/story/factions.json
msgid "地牢里的人是你放走的。逆灵宫在找那天闯道观的孩子。"
msgstr ""

#. niling lines.text
#: data/story/factions.json
msgid "玄冥子欠你一条命。他说过：带着残卷来后山找他。"
msgstr ""

#. faction.fonxan summary
#: data/story/faction_fonxan.json
msgid "拜了柳淳风，淳风武馆的事就是你的事。"
msgstr ""

#. faction.fonxan lapses.text
#: data/story/faction_fonxan.json
msgid "你已经不是封山的人了。淳风武馆的事，到此为止。"
msgstr ""

#. faction.fonxan/hear objective
#: data/story/faction_fonxan.json
msgid "问柳淳风「武馆的事」。"
msgstr ""

#. faction.fonxan/hear text
#: data/story/faction_fonxan.json
msgid "柳淳风说，镇西的青石官道上有人打着淳风武馆的旗号，向来投师的人收十两「拜师钱」。"
msgstr ""

#. faction.fonxan/fakes objective
#: data/story/faction_fonxan.json
msgid "去镇西的青石官道，会一会那几个收「拜师钱」的「封山弟子」。"
msgstr ""

#. faction.fonxan/fakes text
#: data/story/faction_fonxan.json
msgid "为首的罗七倒了，两个帮闲一哄而散。他胸前那块腰牌却是真的：背面刻着一个「逄」字，系绳上拴着绮云镇赌场的竹筹。"
msgstr ""

#. faction.fonxan/pang objective
#: data/story/faction_fonxan.json
msgid "腰牌是从绮云镇的赌场流出来的。去赌场找那个姓逄的，问他「腰牌」。"
msgstr ""

#. faction.fonxan/pang text
#: data/story/faction_fonxan.json
msgid "逄义——柳淳风的同辈师弟——认了：牌是他赌输了押给罗七的。"
msgstr ""

#. faction.fonxan/report objective
#: data/story/faction_fonxan.json
msgid "把腰牌带回淳风武馆，交给柳淳风。"
msgstr ""

#. faction.fonxan/report text
#: data/story/faction_fonxan.json
msgid "柳淳风收下了这件事。「门户的名头，不是谁都能借的。」"
msgstr ""

#. faction.fonxan/report reward.deed
#: data/story/faction_fonxan.json
msgid "清了打着淳风武馆旗号收拜师钱的人"
msgstr ""

#. faction.fonxan/report reward.rank.title
#. latemoon.npc.yumay family.title
#. latemoon.npc.shaowei family.title
#: data/story/faction_fonxan.json data/latemoon/npcs.json
msgid "大弟子"
msgstr ""

#. faction.fonxan/gate objective
#: data/story/faction_fonxan.json
msgid "罗七在镇上嚷过：武馆的门房是野羊山的血手刘三。李火狮在等一句话，问他「门房」——说破，武馆从此没有他的位置；替他瞒，这句话从此算在你头上。"
msgstr ""

#. faction.fonxan/gate/reveal text
#: data/story/faction_fonxan.json
msgid "你对李火狮说了实话：门房刘安禄就是野羊山的血手刘三。武馆不留匪。"
msgstr ""

#. faction.fonxan/gate/reveal reward.deed
#: data/story/faction_fonxan.json
msgid "说破了淳风武馆门房的来历"
msgstr ""

#. faction.fonxan/gate/cover text
#: data/story/faction_fonxan.json
msgid "你对李火狮说：那伙骗子认错了人。武馆里没人再提这件事。"
msgstr ""

#. faction.fonxan/gate/cover reward.deed
#: data/story/faction_fonxan.json
msgid "替淳风武馆的门房瞒下了来历"
msgstr ""

#. faction.fonxan/bamboo_hear objective
#: data/story/faction_fonxan.json
msgid "问柳淳风「竹书」。"
msgstr ""

#. faction.fonxan/bamboo_hear text
#: data/story/faction_fonxan.json
msgid "柳淳风二十岁那年在天驼关的竹林里住过一冬，写了一卷《悟疾风劲竹书》，留在竹林尽头、大黄石后面的石室里。"
msgstr ""

#. faction.fonxan/bamboo objective
#: data/story/faction_fonxan.json
msgid "去天驼关的竹林道，照柳淳风教的法子推开尽头的大黄石，从石室的书柜里取出那卷书。"
msgstr ""

#. faction.fonxan/bamboo text
#: data/story/faction_fonxan.json
msgid "《悟疾风劲竹书》到手了。薄薄一卷，末尾署着柳淳风的名字。"
msgstr ""

#. faction.fonxan/book objective
#: data/story/faction_fonxan.json
msgid "书只有一本：交给柳淳风，他会收进匣里；交给柳绘心，她头一回读到父亲年轻时写的字。给出去就读不到了——想读，先读。"
msgstr ""

#. faction.fonxan/book/father text
#: data/story/faction_fonxan.json
msgid "你把书交给了柳淳风。他没有翻开，收进了案头的匣里：年轻时的糊涂话。"
msgstr ""

#. faction.fonxan/book/father reward.deed
#: data/story/faction_fonxan.json
msgid "把《悟疾风劲竹书》带回来交给了柳淳风"
msgstr ""

#. faction.fonxan/book/daughter text
#: data/story/faction_fonxan.json
msgid "你把书交给了柳绘心。她头一回读到父亲二十岁时写的字：直竹贵地生。"
msgstr ""

#. faction.fonxan/book/daughter reward.deed
#: data/story/faction_fonxan.json
msgid "把《悟疾风劲竹书》带回来交给了柳绘心"
msgstr ""

#. faction.fonxan/yard objective
#: data/story/faction_fonxan.json
msgid "柳绘心这些日子常往武馆的内院去。过些时候再回淳风武馆，到内院看看。"
msgstr ""

#. faction.fonxan/yard text
#: data/story/faction_fonxan.json
msgid "内院里，柳绘心在教外人学封山剑——镇上交不起拜师钱的孩子。柳淳风撞见了。"
msgstr ""

#. faction.fonxan/split objective
#: data/story/faction_fonxan.json
msgid "封山要分南北了。跟柳淳风守本宗（问他「本宗」）：剑不外传，他亲传「点」字诀，你是掌门传人，柳绘心离开武馆。跟柳绘心立北宗（问她「北宗」）：剑往外传，她教你「点」字诀，你转入北宗，柳淳风不再教你。"
msgstr ""

#. faction.fonxan/split/orthodox text
#: data/story/faction_fonxan.json
msgid "你跟了柳淳风：封山只有一宗，剑不外传。他把「点」字诀传给了你。柳绘心带着「北宗」两个字去了绮云镇。"
msgstr ""

#. faction.fonxan/split/orthodox reward.deed
#: data/story/faction_fonxan.json
msgid "在封山的南北之争里守了本宗"
msgstr ""

#. faction.fonxan/split/orthodox reward.rank.title
#: data/story/faction_fonxan.json
msgid "掌门传人"
msgstr ""

#. faction.fonxan/split/north text
#: data/story/faction_fonxan.json
msgid "你跟了柳绘心：北宗的剑往外传。她把自己悟的「点」字诀教给了你。柳淳风不再教你。"
msgstr ""

#. faction.fonxan/split/north reward.deed
#: data/story/faction_fonxan.json
msgid "和柳绘心立了封山剑派北宗"
msgstr ""

