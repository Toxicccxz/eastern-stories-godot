#. snow.newcomer title
#: data/common/journal.json
msgid "雪亭镇的头几天"
msgstr ""

#. snow.newcomer/woke text
#: data/common/journal.json
msgid "你在饮风客栈醒来，店小二笑着招呼了你。"
msgstr ""

#. snow.newcomer/woke next
#: data/common/journal.json
msgid "跟店小二打听「楼上」。"
msgstr ""

#. snow.newcomer/errand text
#: data/common/journal.json
msgid "店小二说楼上客房闹老鼠，请你上去收拾。"
msgstr ""

#. snow.newcomer/errand next
#: data/common/journal.json
msgid "上楼收拾老鼠。"
msgstr ""

#. snow.newcomer/rats text
#: data/common/journal.json
msgid "楼上的老鼠都收拾干净了。"
msgstr ""

#. snow.newcomer/rats next
#: data/common/journal.json
msgid "下楼找店小二。"
msgstr ""

#. snow.newcomer/thanked text
#: data/common/journal.json
msgid "店小二谢了你一根烤鸡腿。"
msgstr ""

#. snow.newcomer/thanked next
#: data/common/journal.json
msgid "去淳风武馆拜柳淳风为师。"
msgstr ""

#. snow.newcomer/apprenticed text
#: data/common/journal.json
msgid "你拜入了封山剑派。"
msgstr ""

#. snow.newcomer/apprenticed next
#: data/common/journal.json
msgid "向柳淳风请教基本剑法。"
msgstr ""

#. snow.newcomer/sword text
#: data/common/journal.json
msgid "你跟柳淳风学了基本剑法。"
msgstr ""

#. snow.newcomer/sword next
#: data/common/journal.json
msgid "去武馆和弟子切磋一场，胜了算。"
msgstr ""

#. snow.newcomer/first_spar text
#: data/common/journal.json
msgid "你第一次在切磋中胜过了武馆弟子。"
msgstr ""

#. snow.newcomer/first_spar next
#: data/common/journal.json
msgid "到武学页打坐，把内力练到 10。"
msgstr ""

#. snow.newcomer/force_10 text
#: data/common/journal.json
msgid "你的内力练到了 10。"
msgstr ""

#. snow.newcomer/force_10 next
#: data/common/journal.json
msgid "再切磋，再打坐：内力练到 25。"
msgstr ""

#. snow.newcomer/force_25 text
#: data/common/journal.json
msgid "你的内力练到了 25。"
msgstr ""

#. snow.newcomer/force_25 next
#: data/common/journal.json
msgid "向李教头讨教一场，然后打坐到内力 50。"
msgstr ""

#. snow.newcomer/force_50 text
#: data/common/journal.json
msgid "你的内力练到了 50，够学封山剑法了。"
msgstr ""

#. snow.newcomer/force_50 next
#: data/common/journal.json
msgid "向柳淳风请教封山剑法；教练场的木人也等着你。"
msgstr ""

#. snow.newcomer/fonxan_sword text
#: data/common/journal.json
msgid "你学会了封山剑法。"
msgstr ""

#. snow.newcomer/fonxan_sword next
#: data/common/journal.json
msgid "去雪亭驿找杜宽，问问「送信」；门外的悬赏榜也看一眼。"
msgstr ""

#. snow.newcomer/bounty text
#: data/common/journal.json
msgid "你揭了雪亭驿门外的一张悬赏。"
msgstr ""

#. snow.newcomer/bounty next
#: data/common/journal.json
msgid "出镇南行，过卧龙岗，去绮云镇看看。"
msgstr ""

#. snow.newcomer/cloud text
#: data/common/journal.json
msgid "你第一次来到绮云镇。雪亭镇的头几天到此为止，往后的路自己走。"
msgstr ""

#. snow.letter title
#: data/common/journal.json
msgid "雪亭驿的信"
msgstr ""

#. snow.letter/taken text
#: data/common/journal.json
msgid "杜宽托你把一封信送到绮云镇振远镖局陈剑秋手里，回来给一两脚钱。"
msgstr ""

#. snow.letter/taken next
#: data/common/journal.json
msgid "出镇往南过卧龙岗，到绮云镇的振远镖局把信交给陈剑秋。"
msgstr ""

#. snow.letter/delivered text
#: data/common/journal.json
msgid "你把信交给了陈剑秋。"
msgstr ""

#. snow.letter/delivered next
#: data/common/journal.json
msgid "回雪亭驿找杜宽拿脚钱。"
msgstr ""

#. snow.letter/paid text
#: data/common/journal.json
msgid "杜宽付了你一两脚钱，说往后有信还找你。"
msgstr ""

#. snow.liu_anlu title
#: data/common/journal.json
msgid "门房的来历"
msgstr ""

#. snow.liu_anlu/wei text
#: data/common/journal.json
msgid "魏无极说淳风武馆的门房刘安禄是野羊山寨的二寨主，人称血手刘三。"
msgstr ""

#. snow.liu_anlu/wei next
#: data/common/journal.json
msgid "去淳风武馆问问柳淳风「刘安禄」。"
msgstr ""

#. snow.liu_anlu/liu text
#: data/common/journal.json
msgid "柳淳风只说刘兄弟在武馆管事五年了，过去之事不须再提。门房的来历，雪亭镇上只有他一个人清楚。"
msgstr ""

#. snow.liu_anlu/woodcutter text
#: data/common/journal.json
msgid "樵夫骂野羊山那群道士该千刀万剐，说他们施了妖法。"
msgstr ""

#. snow.liu_anlu/slip text
#: data/common/journal.json
msgid "刘安禄动起手来说漏了嘴：「想我堂堂……呃……连我这个小小的门房都可以收拾你！」"
msgstr ""

#. snow.liu_anlu/revealed text
#: data/common/journal.json
msgid "刘安禄亮出了血手刘三的身份：野羊山寨的二寨主，一手快刀判若两人。"
msgstr ""

#. snow.wei_wuji/asked_fee text
#: data/common/journal.json
msgid "你向雪亭镇书院的魏无极打听学费。"
msgstr ""

#. snow.wei_wuji/paid text
#: data/common/journal.json
msgid "你交给魏无极学费，他点头说从今天起你随时可以去问他读书识字的学问。"
msgstr ""

#. snow.weapon_storage/shield text
#: data/common/journal.json
msgid "你在兵器储藏室底下的地下密室里拾到一面牛皮盾。"
msgstr ""

#. green.jade title
#. es2:d/green/obj/jade name
#. green.npc.shen inquiry topic
#. green.npc.oldman2 inquiry topic
#: data/common/journal.json data/green/items.json data/green/npcs.json
msgid "玉佩"
msgstr ""

#. green.jade region
#. green.maze region
#. green name
#: data/common/journal.json data/green/world.json
msgid "青石村"
msgstr ""

#. green.jade/elder text
#: data/common/journal.json
msgid "你向青石村的村长打听玉佩。"
msgstr ""

#. green.jade/drunk_jade text
#: data/common/journal.json
msgid "你给雪亭镇的醉汉送酒，他悄声说：玉佩他卖给沈老板了，那东西不吉祥。"
msgstr ""

#. green.jade/drunk_drug text
#: data/common/journal.json
msgid "你又给醉汉送酒，他悄声说：听说沈记商行有在卖蒙汗药。"
msgstr ""

#. green.jade/jade text
#: data/common/journal.json
msgid "你向沈记商行的沈万年问起玉佩，得到了那块刻著行气口诀的玉佩。"
msgstr ""

#. green.jade/drug_price text
#: data/common/journal.json
msgid "你向沈万年打听蒙汗药，他悄声说一份只要十两银子，保证有效。"
msgstr ""

#. green.jade/drug text
#: data/common/journal.json
msgid "你付给沈万年十两银子，他塞给你一包蒙汗药。"
msgstr ""

#. green.maze/through text
#: data/common/journal.json
msgid "你依着路牌穿过了山路尽头的迷阵。"
msgstr ""

#. green.maze/windsword text
#: data/common/journal.json
msgid "你跳入溪水中仔细寻找，竟从水中找出一把追风剑。"
msgstr ""

#. oldpine.skeleton title
#: data/common/journal.json
msgid "山洞里的骸骨"
msgstr ""

#. oldpine.skeleton region
#. oldpine.knife_marks region
#. main.chapter1 region
#. oldpine name
#: data/common/journal.json data/story/chapter1.json data/oldpine/world.json
msgid "老松岭"
msgstr ""

#. oldpine.skeleton/buried text
#: data/common/journal.json
msgid "你在瀑布旁的山洞里埋好了那具骸骨，洞顶石壁「喀喇」一响，坠下一本过招要旨。"
msgstr ""

#. oldpine.knife_marks title
#: data/common/journal.json
msgid "树上的刀痕"
msgstr ""

#. oldpine.knife_marks/found text
#: data/common/journal.json
msgid "你顺着松树上的刀痕，在崖上林径尽头的灌木后找到了一条小径，通往老松寨。"
msgstr ""

#. cloud.toll title
#. oldpine.npc.bandit_guard inquiry topic
#. cloud.npc.gangster inquiry topic
#: data/common/journal.json data/oldpine/npcs.json data/cloud/npcs.json
msgid "买路钱"
msgstr ""

#. cloud.toll/asked text
#: data/common/journal.json
msgid "你向卧龙岗的强盗问起买路钱。"
msgstr ""

#. cloud.toll/paid text
#: data/common/journal.json
msgid "你交给卧龙岗的强盗十两金子，他收下钱，说今天做个善人，放你一条生路。"
msgstr ""

#. cloud.li_shishi/asked text
#: data/common/journal.json
msgid "你在怡红院二楼向李师师请教学艺。"
msgstr ""

#. cloud.li_shishi/keepsake text
#: data/common/journal.json
msgid "你留给李师师一件信物，她说：能做相公的老师，真是三生有幸。"
msgstr ""

#. cloud.chess/played text
#: data/common/journal.json
msgid "你在香茗坊二楼和弈者下了一盘棋。"
msgstr ""

#. cloud.chess/chess text
#: data/common/journal.json
msgid "你得到了弈者的棋子，一种较轻的暗器。"
msgstr ""

#. cloud.wangyou_grass title
#. es2:d/choyin/obj/grass name
#. cloud.npc.b_header inquiry topic
#. choyin.npc.crone inquiry topic
#. choyin.npc.visitor inquiry topic
#: data/common/journal.json data/choyin/items.json data/cloud/npcs.json data/choyin/npcs.json
msgid "忘忧草"
msgstr ""

#. cloud.wangyou_grass/uncle text
#: data/common/journal.json
msgid "你向振远镖局的陈剑秋问起陈天星。"
msgstr ""

#. cloud.wangyou_grass/lost text
#: data/common/journal.json
msgid "你向陈剑秋问起忘忧草。"
msgstr ""

#. cloud.wangyou_grass/crone text
#: data/common/journal.json
msgid "你向乔阴县城的乾瘪老太婆打听忘忧草。"
msgstr ""

#. cloud.wangyou_grass/visitor text
#: data/common/journal.json
msgid "你向乔阴县城的游客打听忘忧草。"
msgstr ""

#. cloud.wangyou_grass/grass text
#: data/common/journal.json
msgid "护草神兽倒下后，你在神秘洞穴里得到一棵发着晶莹光芒的忘忧草。"
msgstr ""

#. cloud.wangyou_grass/letter text
#: data/common/journal.json
msgid "你把忘忧草交给陈剑秋，他大喜过望，提笔写好一封信交给你，嘱咐你路上小心，把信直接交给陈师叔。"
msgstr ""

#. cloud.wangyou_grass/chen text
#: data/common/journal.json
msgid "你在京师振远总局向陈天星请教拜师。"
msgstr ""

#. latemoon.funlin/heard_funlin text
#: data/common/journal.json
msgid "你向傍厅的蓝雨梅问起芳绫。"
msgstr ""

#. latemoon.funlin/heard_dragonfly text
#: data/common/journal.json
msgid "你向蓝筱薇问起竹蜻蜓。"
msgstr ""

#. latemoon.funlin/bamboo text
#: data/common/journal.json
msgid "你把一根竹子交给蓝筱薇，她看了看说是根玉竹，便灵巧地削凿起来。"
msgstr ""

#. latemoon.funlin/dragonfly text
#: data/common/journal.json
msgid "蓝筱薇把做好的竹蜻蜓递给了你。"
msgstr ""

#. latemoon.funlin/gift text
#: data/common/journal.json
msgid "你把竹蜻蜓送给禁闭房里的芳绫，她开心地把玩，在你耳边小声说：『庄内前厅某处藏有一宝物手镯哦！』"
msgstr ""

#. latemoon.funlin/bracelet text
#: data/common/journal.json
msgid "你从内厅的碧纱橱里取出一串玛瑙手镯。"
msgstr ""

#. latemoon.dances title
#: data/common/journal.json
msgid "晚月庄的舞步"
msgstr ""

#. latemoon.dances/dance_out text
#: data/common/journal.json
msgid "你记下了一曲舞步『西出阳关』。"
msgstr ""

#. latemoon.dances/dance_yu_fong text
#: data/common/journal.json
msgid "你记下了一曲舞步『有凤来仪』。"
msgstr ""

#. latemoon.dances/hankie text
#: data/common/journal.json
msgid "你在一间密室里拾到一卷丝罗巾，上面绣着一幅幅翩然起舞的美女图。"
msgstr ""

#. latemoon.dances/asked_book text
#: data/common/journal.json
msgid "你在翠湘阁向莫欣芳问起舞曲谱。"
msgstr ""

#. latemoon.dances/book text
#: data/common/journal.json
msgid "你在密室的石床后面找到了一本舞曲谱。"
msgstr ""

#. latemoon.old_woman title
#. latemoon.npc.room.old name
#: data/common/journal.json data/latemoon/npcs.json
msgid "无名老妇"
msgstr ""

#. latemoon.old_woman/trouble text
#: data/common/journal.json
msgid "你向内书房的无名老妇问起她的心事。"
msgstr ""

#. latemoon.old_woman/about_token text
#: data/common/journal.json
msgid "你向无名老妇问起令牌。"
msgstr ""

#. latemoon.old_woman/token text
#: data/common/journal.json
msgid "你得到了一个黑木做的杀手令牌，上面刻著火焰的图腾标志。"
msgstr ""

#. latemoon.old_woman/whip_book text
#: data/common/journal.json
msgid "你把杀手令牌交给无名老妇，她叹了口气，给了你一本寒雪鞭法密笈作为感谢。"
msgstr ""

#. latemoon.secret_letter title
#. es2:d/latemoon/room/npc/obj/letter name
#: data/common/journal.json data/latemoon/items.json
msgid "密函"
msgstr ""

#. latemoon.secret_letter/letter text
#: data/common/journal.json
msgid "你得到了芙云身上的一封密函，信用蜡封著，上面有一个奇怪的图案。"
msgstr ""

#. choyin.yam title
#. es2:d/choyin/npc/obj/tomatoo name
#: data/common/journal.json data/choyin/items.json
msgid "山药蛋"
msgstr ""

#. choyin.yam region
