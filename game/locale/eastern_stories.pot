#. native.npc.bai_daozhang inquiry topic
#. native.npc.black_taoist_pass inquiry topic
#: data/oldpine/npcs.json data/native/npcs.json
msgid "石匣"
msgstr ""

#. oldpine.npc.bandit_commander inquiry.石匣
#: data/oldpine/npcs.json
msgid "石匣？那道士抱着的那个？老子没兴趣，老子只收钱。"
msgstr ""

#. oldpine.npc.bandit_commander inquiry.老松寨
#: data/oldpine/npcs.json
msgid "老松寨是老子的寨子。进寨的规矩只有一条：什么钱都收。"
