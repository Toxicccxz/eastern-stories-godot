#. waterfog.npc.elder5 name
#: data/waterfog/npcs.json
msgid "南危水"
msgstr ""

#. waterfog.npc.elder5 title
#: data/waterfog/npcs.json
msgid "水烟阁五长老"
msgstr ""

#. waterfog.npc.elder5 long
#: data/waterfog/npcs.json
msgid ""
"南危水是当世使剑的名家，也是槐阳王的弟弟，一身武学集天邪、封山\n"
"两派之所长，在水烟阁七长老中武功仅次于二长老莫谦容。南危水手中\n"
"的焦殇剑也是一把罕见的利器，传说这把剑是名铸剑师黄炎炎生平六把\n"
"名剑中排名第一的杰作。\n"
msgstr ""

#. waterfog.npc.elder5 greeting.rules.steps.say
#: data/waterfog/npcs.json
msgid "你来了。老夫欠你一个人情，到了关北，老夫替你引见槐阳王。"
msgstr ""

#. waterfog.npc.elder5 greeting.rules.steps.emote
#: data/waterfog/npcs.json
msgid "看了你一眼，没有说话。"
msgstr ""

#. waterfog.npc.elder5 calls.steps.emote
#: data/waterfog/npcs.json
msgid "看着你，忽然开口。"
msgstr ""

#. waterfog.npc.elder5 calls.steps.say
#: data/waterfog/npcs.json
msgid "是你埋了阿岭。"
msgstr ""

#. waterfog.npc.elder5 calls.steps.say
#: data/waterfog/npcs.json
msgid "老松岭瀑布后头那个山洞——骸骨旁边本来有一面腰牌，背面一个「岭」字。你把他葬了，连腰牌也葬了。这二十年，没有人替他做过这件事。"
msgstr ""

#. waterfog.npc.elder5 calls.steps.say
#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.say
#: data/waterfog/npcs.json
msgid "他是老夫的随从。那年老夫押着盟主印和密件过老松岭，白衣武官在瀑布前伏击，阿岭替老夫挡了刀，盟主卫沧澜被他们带走了。老夫逃进山洞，在石壁上刻了那些字——让人以为南危水死在那里。"
msgstr ""

#. waterfog.npc.elder5 calls.steps.say
#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.say
#: data/waterfog/npcs.json
msgid "老夫的哥哥是槐阳王。他若知道朝廷伏击了自己的弟弟，关北立刻就反。老夫装死二十年，是为了这个。"
msgstr ""

#. waterfog.npc.elder5 inquiry topic
#. waterfog.npc.elder7 inquiry topic
#: data/waterfog/npcs.json
msgid "五长老"
msgstr ""

#. waterfog.npc.elder5 inquiry.五长老
#: data/waterfog/npcs.json
msgid "老夫便是五长老。你想问什么？"
msgstr ""

#. waterfog.npc.elder5 inquiry topic
#: data/waterfog/npcs.json
msgid "山洞的骸骨"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.say
#: data/waterfog/npcs.json
msgid "老夫都说了。阿岭的事，你知道就好。"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.emote
#: data/waterfog/npcs.json
msgid "盯着你手里的腰牌，脸色一点点白了。"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.say
#: data/waterfog/npcs.json
msgid "背面一个「岭」字……阿岭的腰牌。你从山洞里拿来的。"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.emote
#: data/waterfog/npcs.json
msgid "看了看镖单，又看了看你。"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.say
#: data/waterfog/npcs.json
msgid "乙丑年，关雨楼立的碑，字是用手指写的——山洞石壁上的字也是。你看出来了。"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.lines.say
#: data/waterfog/npcs.json
msgid "死的是老夫的随从阿岭。那年老夫押着盟主印和密件过老松岭，白衣武官在瀑布前伏击，阿岭替老夫挡了刀，盟主卫沧澜被他们带走了。老夫逃进山洞，在石壁上刻了那些字——让人以为南危水死在那里。"
msgstr ""

#. waterfog.npc.elder5 inquiry.山洞的骸骨.rules.say
#: data/waterfog/npcs.json
msgid "老夫不知道你在说什么。"
msgstr ""

#. waterfog.npc.elder5 inquiry topic
#: data/waterfog/npcs.json
msgid "保密"
msgstr ""

#. waterfog.npc.elder5 inquiry.保密.rules.say
#: data/waterfog/npcs.json
msgid "多谢。到了关北，老夫替你引见槐阳王。"
msgstr ""

#. waterfog.npc.elder5 inquiry.保密.rules.lines.emote
#: data/waterfog/npcs.json
msgid "沉默了很久，向你抱了抱拳。"
msgstr ""

#. waterfog.npc.elder5 inquiry.保密.rules.lines.say
#: data/waterfog/npcs.json
msgid "老夫欠你一个人情。到了关北，老夫替你引见槐阳王。"
msgstr ""

#. waterfog.npc.elder5 inquiry.保密.rules.say
#: data/waterfog/npcs.json
msgid "保什么密？老夫没有什么要瞒的。"
msgstr ""

#. waterfog.npc.elder5 inquiry.宝衣.rules.say
#: data/waterfog/npcs.json
msgid "晚月庄。老夫只说一遍。"
msgstr ""

#. waterfog.npc.elder5 inquiry.宝衣.rules.lines.emote
#: data/waterfog/npcs.json
msgid "压低了声音。"
msgstr ""

#. waterfog.npc.elder5 inquiry.宝衣.rules.lines.say
#: data/waterfog/npcs.json
msgid "老夫欠你一桩事，这件事告诉你。寒於的宝衣，当年归月神族保管——月神族的后人在晚月庄，供着人灵区冥的神像。"
msgstr ""

#. waterfog.npc.elder5 inquiry.宝衣.rules.lines.say
#: data/waterfog/npcs.json
msgid "守衣的人几百年没换过。你去了，别和她动手。"
msgstr ""

#. waterfog.npc.elder5 inquiry.宝衣.rules.say
#: data/waterfog/npcs.json
msgid "宝衣？归月神族保管——晚月庄。老夫只说这一句。"
msgstr ""

#. waterfog.npc.elder5 inquiry.宝衣.rules.say
#: data/waterfog/npcs.json
msgid "老夫知道的都说了。"
msgstr ""

#. waterfog.npc.elder6 name
#: data/waterfog/npcs.json
msgid "陈坚石"
msgstr ""

#. waterfog.npc.elder6 title
#: data/waterfog/npcs.json
msgid "水烟阁六长老"
msgstr ""

#. waterfog.npc.elder6 long
#: data/waterfog/npcs.json
msgid ""
"陈长老本来的名字已经没有人知道了，但是他的横练功夫「石猿功」成名\n"
"数十年，加上个性有点....那个....顽固，因此水烟阁执法使潘军禅给他\n"
"起了个绰号叫「坚石」，久而久之陈长老倒也挺喜欢这个名字，索性舍弃\n"
"了原来的名字改名叫陈坚石。\n"
msgstr ""

#. waterfog.npc.elder7 name
#: data/waterfog/npcs.json
msgid "颜违"
msgstr ""

#. waterfog.npc.elder7 title
#: data/waterfog/npcs.json
msgid "水烟阁七长老"
msgstr ""

#. waterfog.npc.elder7 long
#: data/waterfog/npcs.json
msgid ""
"颜违是水烟阁七位长老中最年轻的，虽然他的武功跟其他六位长老\n"
"相比仍略逊一筹，但是他办事十分精明干练，因此七长老每年都派\n"
"他出外办理武林大会事宜。\n"
msgstr ""

#. waterfog.npc.elder7 moods.acting.title
#: data/waterfog/npcs.json
msgid "水烟阁代盟主"
msgstr ""

#. waterfog.npc.elder7 inquiry.五长老
#: data/waterfog/npcs.json
msgid "五长老？他就在这边，有什么话你自己问他。"
msgstr ""

#. waterfog.npc.elder7 inquiry topic
#: data/waterfog/npcs.json
msgid "南危水的事"
msgstr ""

#. waterfog.npc.elder7 inquiry.南危水的事.rules.say
#: data/waterfog/npcs.json
msgid "五长老的事，本座已经知道了。盟主不在，水烟阁总要有人主事。"
msgstr ""

#. waterfog.npc.elder7 inquiry.南危水的事.rules.lines.emote
#: data/waterfog/npcs.json
msgid "听完，半晌没有说话，然后慢慢坐直了。"
msgstr ""

#. waterfog.npc.elder7 inquiry.南危水的事.rules.lines.say
#: data/waterfog/npcs.json
msgid "盟主二十年前就被朝廷带走了，五长老知情不报。这件事，水烟阁得有人主事。"
msgstr ""

#. waterfog.npc.elder7 inquiry.南危水的事.rules.lines.say
#: data/waterfog/npcs.json
msgid "从今日起，本座代行盟主之职。你的话，本座记下了。"
msgstr ""

#. waterfog.npc.elder7 inquiry.南危水的事.rules.say
#: data/waterfog/npcs.json
msgid "南危水？他是五长老，有什么事？"
msgstr ""

#. es2:d/waterfog/sroad1 long
#: data/waterfog/rooms.json
msgid ""
"这是一条宽敞坚实的青石板大道，从这里已经可以望见北边山腰上\n"
"水烟阁琉璃色的屋瓦，映著山上茂密的枫树林，显得十分诗情画意，由\n"
"于这条路是禁兵统领亲自督造，因此造得格外平整，从这里开始已经进\n"
"入由历代水烟阁主人所管辖的封地，即使是官府也不能过问这片土地上\n"
"发生的事，因此你最好小心一点。\n"
msgstr ""

#. es2:d/waterfog/sroad2 long
#: data/waterfog/rooms.json
msgid ""
"这是一条宽敞坚实的青石板大道，从这里沿著山势弯向西边与南边\n"
"，往西不远处就是通往水烟阁的石阶。\n"
msgstr ""

#. es2:d/waterfog/sroad3 long
#: data/waterfog/rooms.json
msgid ""
"这是一条宽敞坚实的青石大道，大道沿著山腰往东向山下延伸，一\n"
"道长长的白石阶梯从这里往北边上山，从这里仰望阶梯的尽头有一座雄\n"
"伟的楼阁，那就是著名的「水烟阁」。\n"
msgstr ""

#. es2:d/waterfog/stair1 long
#. es2:d/waterfog/stair2 long
#. es2:d/waterfog/stair3 long
#. es2:d/waterfog/stair4 long
#: data/waterfog/rooms.json
msgid ""
"你现在正走在一条长长的白石阶梯上，这些建造阶梯的白石出产于\n"
"东海滨的裂瓶山，距离此地有近千里之遥，而且虽然年代久远，仍然可\n"
"以看得出所用的全部都是品质最好的「拟玉」石，可见这里的主人必定\n"
"大有来头。\n"
msgstr ""

#. es2:d/waterfog/clifftop long
#: data/waterfog/rooms.json
msgid ""
"这里是一个用白石砌成的亭子，亭子的东面和北面都是深不见底的\n"
"悬崖，从这里望出去只见一片云雾之中突出几座山峰，云雾之中隐隐可\n"
"以看到好似水波的微光，使你一时之间彷佛以为这座亭子是建在一个湖\n"
"中，往西北望去可以看到水烟阁漂浮在云雾之中。\n"
msgstr ""

#. es2:d/waterfog/stair5 long
#: data/waterfog/rooms.json
msgid ""
"你现在正走在一条长长的白石阶梯上，阶梯随著山峰蜿蜒盘旋，宛\n"
"如一条白龙，水烟阁就矗立在北边的山峰顶上，即使是从这么近的距离\n"
"你仍然感觉这座楼阁飘飘渺渺，难以捉摸。\n"
msgstr ""

#. es2:d/waterfog/frontyard long
#: data/waterfog/rooms.json
msgid ""
"你现在正站在一座高大的楼阁，水烟阁前，琉璃色的屋瓦和白玉般\n"
"的白石砖使得水烟阁在崇山峻岭中显得十分抢眼，这座楼阁最早的主人\n"
"据说是有「武术之神」称号的太阳神君「杞庸」，后来被当作历代武林\n"
"盟主的居所，可说是学武之人的朝圣地，一条白石阶梯沿著山腰往南而\n"
"下，水烟阁的大门就在你的北方。\n"
msgstr ""

#. es2:d/waterfog/wpath1 long
#: data/waterfog/rooms.json
msgid ""
"你现在正走在一条山坡上的小径，往南望去只见山下一条白色石阶\n"
"蜿蜒上山，通往东边不远处的一个平台，平台的北边就是赫赫有名的武\n"
"者圣地「水烟阁」，小径的北边整齐地种著一排枫树，往西上了山坡通\n"
"往位于山巅的「虹台」。\n"
msgstr ""

#. es2:d/waterfog/wpath2 long
#: data/waterfog/rooms.json
msgid ""
"你现在正走在一条山坡小径上，东边不远处可以望见水烟阁琉璃色\n"
"的屋瓦，小径东北是一道白石阶梯通往山巅的虹台，往西则是「水烟十\n"
"景」之中最有名的虹谷断崖，小径旁立著一个七、八尺高的石碑(stone\n"
")。\n"
msgstr ""

#. es2:d/waterfog/wpath3 long
#: data/waterfog/rooms.json
msgid ""
"你正走在一道白石阶梯上，这道阶梯依著山壁而建，东边隔著一个\n"
"深不见底的山谷可以望见对面傲立在山巅之上的水烟阁，每当清晨山谷\n"
"中的晨雾慢慢飘起，从这里可以看见水烟阁彷佛飘在云间，这就是水烟\n"
"十景中的「飞天楼阁」，石阶沿著山壁从这里转往北方。\n"
msgstr ""

#. es2:d/waterfog/wpath4 long
#: data/waterfog/rooms.json
msgid ""
"你现在正走在一道依著山壁而建的白石阶梯上，随著阶梯越爬越高\n"
"，从这里已经可以望见西面山顶上竖立在虹台中央的「擎天柱」，阶梯\n"
"从这里转向西北坡度较缓的山腰，你的东边是一个深不见底的深谷，隔\n"
"著深谷可以望见对面不远处的水烟阁。\n"
msgstr ""

#. es2:d/waterfog/wpath5 long
#: data/waterfog/rooms.json
msgid ""
"你现在走在一道依著山壁而建的白石阶梯上，通过西边不远处的葬\n"
"剑亭，就是虹台的入口，东边和北边都是深不见底的深谷，隔著深谷，\n"
"东北边的野羊山连著隐樵山、图云岭、破魔山、虎啸坡、沙牢山一直到\n"
"大漠都是数百丈的高山，虹台地势虽不甚高，但是在三面深谷的环绕下\n"
"，却自有一股群山朝拜的威严气象。\n"
msgstr ""

#. es2:d/waterfog/swordtomb long
#: data/waterfog/rooms.json
msgid ""
"你现在来到一个山腰靠近山顶的亭子，亭子前立著一个两丈多高的\n"
"石碑(monolith)，从亭子里远眺北方连绵不尽的大山，使你不禁感到胸\n"
"臆之间一股英雄情怀油然而生，葬剑亭据说每到夏日夜晚，野风吹过，\n"
"会产生一阵阵呜呜的哭泣声，这也是水烟十景中的「孤亭剑泣」。出了\n"
"亭子，往南便是直通虹台的石阶，一条黄土小路往西通往另一条下山的\n"
"小路。\n"
msgstr ""

#. es2:d/waterfog/entrance long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁的正门，一股沁人心脾的檀香使你精神为之一振，正\n"
"门共分三进，全部都是上等的檀木雕成，最里的门上悬著一块匾额，上\n"
"面龙飞凤舞地写著几个大字，可是你全然看不出到底是什么字。\n"
msgstr ""

#. es2:d/waterfog/guildhall long
#. es2:daemon/class/fighter/guildhall long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁的正厅，简单的陈设中透出一股尊贵不凡的气派，一\n"
"张黝黑的太师椅端坐在大厅中央，这里同时也是「武者」们议事的所在\n"
"，每年的正月十七都要在水烟阁外的「虹台」推选武林盟主，然後在这\n"
"里举行登位大典。你可以看到北边的墙上挂著一樟木匾(sign)，似乎写\n"
"著一些有关成为一名武者的事项。\n"
msgstr ""

#. es2:d/waterfog/westhall long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁入口西侧的花厅，东边是水烟阁的正门，南边和西边\n"
"围著一圈白玉栏杆，栏杆外种著许多茶花，往北是水烟阁的侧门，从这\n"
"里可以看到通往水烟阁二楼的阶梯。\n"
msgstr ""

#. es2:d/waterfog/easthall long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁正门东边的花厅，东边和南边围著一圈白石栏杆，栏\n"
"杆外种著许多茶花，往西是水烟阁的正门，往北则是东侧的侧厅，从这\n"
"里可以看见通往二楼的阶梯。\n"
msgstr ""

#. es2:d/waterfog/weststair long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁西侧的厅院，一道白石梯从这里通往二楼，往北是仆\n"
"役的卧房跟柴房，南边是出水烟阁的侧门，往西则是一个可以眺望山谷\n"
"的阳台。\n"
msgstr ""

#. es2:d/waterfog/eaststair long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁东边的侧厅，东边隔著栏杆就是深不见底的深谷，从\n"
"这里向外眺望，更可以感受到水烟阁孤立于独峰之上，傲视群山的气魄\n"
"，这里有一道阶梯通往二楼，往北是厨房与储存杂物的仓库。\n"
msgstr ""

#. es2:d/waterfog/storage long
#: data/waterfog/rooms.json
msgid ""
"这里是一间柴房，一捆一捆劈好的柴薪都整齐地堆放在柴房北侧，\n"
"留下一条通道通往东边仆役的卧室。往南可以回到水烟阁的西侧厅。\n"
msgstr ""

#. es2:d/waterfog/servroom long
#: data/waterfog/rooms.json
msgid ""
"这里是在水烟阁从事杂役的仆佣所住的卧室，房间相当宽敞，东西\n"
"向一张大通铺最少可以睡二、三十人，东首一张大炕(bed)是冬天才用\n"
"的，因为有不少仆役回家过冬，所以比床铺稍小，北边开了几扇窗子，\n"
"南边则是摆放仆役私物的橱柜。\n"
msgstr ""

#. es2:d/waterfog/kitchen long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁的厨房，东首一座大灶，灶边堆著许多瓦瓮，北边是\n"
"一张方桌，桌上锅碗瓢盆一应俱全，西边则是一个橱柜，往南可以回到\n"
"厅中。\n"
msgstr ""

#. es2:d/waterfog/west_2f long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁西侧厅的二楼，由于侧厅是挑高建筑，因此这里只有\n"
"一条约七、八尺宽的走道连接楼梯与往东的门。\n"
msgstr ""

#. es2:d/waterfog/forehall long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁二楼的聆啸厅，南面是一个大露台，按著西、西南、\n"
"南、东南、东等方向立著五块灰绿色的怪石(stone)，东西各有一个出\n"
"口通往侧厅，往北则是水烟阁主所居的春秋水色斋。\n"
msgstr ""

#. es2:d/waterfog/east_2f long
#: data/waterfog/rooms.json
msgid ""
"这里是水烟阁东侧厅的二楼，由于侧厅是挑高建筑，因此这里只有\n"
"一条约七、八尺宽的走道连接楼梯与往西的门。\n"
msgstr ""

#. waterfog.guildhall.landmark.sign name
#: data/waterfog/world.json
msgid "樟木匾"
msgstr ""

#. waterfog.guildhall.landmark.sign action
#: data/waterfog/world.json
msgid "加入武者同盟"
msgstr ""

#. waterfog.guildhall.landmark.sign messages.joined
#: data/waterfog/world.json
msgid "恭喜，从今天起您已经成为一名武者！"
msgstr ""

#. waterfog.guildhall.landmark.sign messages.refused
#: data/waterfog/world.json
msgid "你已经参加了其他公会。"
msgstr ""

#. waterfog.guildhall.landmark.sign long
#: data/waterfog/world.json
msgid ""
"要成为一名武者并不难，水烟阁随时欢迎任何身家清白之人成为我们的\n"
"一份子，只要你加入武者同盟，就可以向同盟中的各大门派拜师\n"
"学艺。\n"
msgstr ""

#. waterfog.wpath2.landmark.stone name
#. waterfog.swordtomb.landmark.monolith name
#. temple.road2.landmark.slab name
#: data/waterfog/world.json data/temple/world.json
msgid "石碑"
msgstr ""

#. waterfog.wpath2.landmark.stone long
#: data/waterfog/world.json
msgid ""
"石碑上面几个苍劲古朴的字写道：虹谷石台，乙丑年水烟阁第六代\n"
"阁主关雨楼立。\n"
"你仔细一看，这几个字迹丝毫没有斧凿痕迹，竟像是题字的人直接\n"
"用手指在岩石上写出来一般。\n"
msgstr ""

#. waterfog.swordtomb.landmark.monolith long
#: data/waterfog/world.json
msgid ""
"石碑上龙飞凤武地刻著几个大字：\n"
"\n"
"    风波剑神黎红药前辈葬剑于此，水烟阁第四代七长老比武\n"
"    不胜，以奸计害人而自取其辱，武者皆不齿其小人行径，\n"
"    合力击杀于此，甲辰年立此亭书铭其事以为后人殷鉴。\n"
"\n"
"                        第三代水烟阁主 于兰玫音\n"
"                        第四代水烟阁主 聂    言   合立\n"
"                        第五代水烟阁主 段 柏 山\n"
msgstr ""

#. waterfog.entrance.weapons lines
#: data/waterfog/world.json
msgid "水烟阁武士喝道：慢著，进水烟阁，先放下你的兵刃！"
msgstr ""

#. waterfog.entrance.weapons lines
#: data/waterfog/world.json
msgid "水烟阁武士挡住了你的去路。"
msgstr ""

