#: data/common/npcs.json
msgid "玄智和尚"
msgstr ""

#. common.npc.bonze.master family.title
#: data/common/npcs.json
msgid "住持"
msgstr ""

#. common.npc.bonze.master accept_fight.say
#: data/common/npcs.json
msgid "阿弥陀佛！出家人戒逞强恶斗！老衲不敢违反清规。"
msgstr ""

#. common.npc.bonze.master accept_fight.say
#: data/common/npcs.json
msgid "施主既然身负绝艺，老衲佩服便是，也不必较量了。"
msgstr ""

#. common.npc.bonze.master inquiry topic
#: data/common/npcs.json
msgid "剃度"
msgstr ""

#. common.npc.bonze.master inquiry.剃度.rules.say
#. common.npc.bonze.master inquiry.出家.rules.say
#: data/common/npcs.json
msgid ""
"阿弥陀佛！你我同是出家人，何故跟老衲开这等玩笑？\n"
msgstr ""

#. common.npc.bonze.master inquiry.剃度.rules.say
#. common.npc.bonze.master inquiry.出家.rules.say
#: data/common/npcs.json
msgid ""
"阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n"
msgstr ""

#. common.npc.bonze.master inquiry.剃度.rules.say
#. common.npc.bonze.master inquiry.出家.rules.say
#: data/common/npcs.json
msgid ""
"阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n"
msgstr ""

#. common.npc.bonze.master inquiry topic
#: data/common/npcs.json
msgid "出家"
msgstr ""

#. common.npc.bonze.master ordination.lines
#: data/common/npcs.json
msgid "$N双手合十，恭恭敬敬地跪了下来。"
msgstr ""

#. common.npc.bonze.master ordination.lines
#: data/common/npcs.json
