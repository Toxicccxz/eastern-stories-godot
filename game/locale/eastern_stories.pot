msgstr ""

#. latemoon.npc.park.girl_yu name
#: data/latemoon/npcs.json
msgid "上官钰翎"
msgstr ""

#. latemoon.npc.park.girl_yu nickname
#: data/latemoon/npcs.json
msgid "玉涵湘"
msgstr ""

#. latemoon.npc.park.dodo1 name
#: data/latemoon/npcs.json
msgid "小金鼠"
msgstr ""

#. latemoon.npc.park.dodo1 long
#: data/latemoon/npcs.json
msgid ""
"一只可爱的长尾巴的小金鼠。 \n"
msgstr ""

#. latemoon.npc.park.dodo1 chat_msg
#: data/latemoon/npcs.json
msgid ""
"小金鼠摇摇尾巴!全身晃呀晃! \n"
msgstr ""

#. latemoon.npc.park.dodo1 chat_msg
#: data/latemoon/npcs.json
msgid ""
"小金鼠眼睛眨呀眨!好像快睡著了! \n"
msgstr ""

#. latemoon.npc.park.dodo1 chat_msg
#: data/latemoon/npcs.json
msgid ""
"嘟嘟玩太累了!睡著了! \n"
msgstr ""

#. latemoon.npc.park.dodo1 chat_msg
#: data/latemoon/npcs.json
msgid ""
"小金鼠「嘟嘟」它跳啊跳的! \n"
msgstr ""

#. latemoon.npc.park.dodo1 chat_msg
#: data/latemoon/npcs.json
msgid ""
"小金鼠「嘟嘟」眼睛眨呀眨看著你 \n"
msgstr ""

#. latemoon.npc.park.dodo1 chat_msg
#: data/latemoon/npcs.json
msgid ""
"小金鼠发出「  叽! 叽!」」的叫声! \n"
msgstr ""

#. latemoon.npc.park.bird long
#. latemoon.npc.upstar.bird long
#: data/latemoon/npcs.json
msgid ""
"一只羽毛鲜艳的小金丝雀。\n"
msgstr ""

#. latemoon.npc.park.bird chat_msg
#. latemoon.npc.upstar.bird chat_msg
#: data/latemoon/npcs.json
msgid ""
"小金丝雀叽叽的叫! \n"
msgstr ""

#. latemoon.npc.park.bird chat_msg
#. latemoon.npc.upstar.bird chat_msg
#: data/latemoon/npcs.json
msgid ""
"金丝雀用嘴整理羽毛。 \n"
msgstr ""

#. latemoon.npc.park.maysan name
#: data/latemoon/npcs.json
msgid "美珊"
msgstr ""

#. latemoon.npc.park.maysan long
#: data/latemoon/npcs.json
msgid ""
"她看起来成熟中带有一些韵味。飘逸的长发\n"
"十分迷人。\n"
msgstr ""

#. latemoon.npc.park.rabbit name
#: data/latemoon/npcs.json
msgid "小白兔"
msgstr ""

#. latemoon.npc.park.rabbit long
#: data/latemoon/npcs.json
msgid ""
"一只红眼睛的小白兔。\n"
msgstr ""

#. latemoon.npc.park.rabbit chat_msg
#: data/latemoon/npcs.json
msgid ""
"小白兔蹦蹦跳跳的。\n"
msgstr ""

#. latemoon.npc.park.rabbit chat_msg
#: data/latemoon/npcs.json
msgid ""
"小白兔用嘴舔前肢。 \n"
msgstr ""

#. latemoon.npc.upstar.shinfun inquiry.舞曲谱
#: data/latemoon/npcs.json
msgid ""
"舞曲谱啊，师姐她们练习舞步的时候才用的着，\n"
"你也想学吗？ 嘻嘻...\n"
msgstr ""

#. latemoon.npc.upstar.statue name
#: data/latemoon/npcs.json
msgid "人灵「区冥」"
msgstr ""

#. latemoon.npc.upstar.statue title
#: data/latemoon/npcs.json
msgid "神像"
msgstr ""

#. latemoon.npc.upstar.statue long
#: data/latemoon/npcs.json
msgid ""
"人灵「区冥」乃勇士寒于的魂魄所化成的十三个精灵之一。\n"
"晚月庄的开山先辈，传说是其后裔子孙。故其为\n"
"晚月庄的祖先神位。\n"
msgstr ""

#. latemoon.npc.upstar.statue greeting.rules.steps.line
#: data/latemoon/npcs.json
msgid ""
"你有一种奇特的感觉，彷佛有人在盯著你看。\n"
msgstr ""

#. es2:d/latemoon/entrance long
#: data/latemoon/rooms.json
msgid ""
"这是条用鹅卵石铺成的小路，往西可以看到一座用淡青色围墙围住\n"
"的庭院，有两个身着彩衣的女子笑盈盈的站在那里说笑着，她们身后的\n"
"一扇拱门(door)，檐顶下面写着「晚月庄」。院墙那边飘出的阵阵曲声勾\n"
"人魂魄，隐约还可闻到一股香气。\n"
msgstr ""

#. es2:d/latemoon/gate long
#: data/latemoon/rooms.json
msgid ""
"你来到了这个小径的尽头，一个有著朱红漆大门大宅\n"
"院矗立在你的面前，门口挂著两串灯笼(lantern),上面写\n"
"得有字，像这样一间豪华的大宅院出现在这样的乡间野外\n"
"，使你觉得有些突兀，大宅的南边、东边都是茂密的林子\n"
"，看来也没有其他的路。\n"
msgstr ""

#. es2:d/latemoon/front_yard long
#: data/latemoon/rooms.json
msgid ""
"一走入这个庭园，扑鼻而来的便是一股若有似无，但是又沁人心\n"
"脾的花香，庭园甚是宽敞，许多奇花异石错落其间，显是经过高手匠\n"
"人的精心布置，西边花丛间可看到主屋的屋角，一条石板小径沿著假\n"
"山通往主屋。\n"
msgstr ""

#. es2:d/latemoon/latemoon1 long
#: data/latemoon/rooms.json
msgid ""
"走进大厅，抬头迎面看见的是一面紫红绣金挂幔，一面屏风将宽敞的\n"
"大厅隔成两半，东西两面各设著七张紫檀雕案，案上一色白玉羊脂花瓶，\n"
"瓶中插著粉红的处子牡丹，紫檀雕案中间又都挂著七尺来长的画轴，各式\n"
"鸟兽虫鱼，翎毛丹青，栩栩如生，宛如要从画纸上飞出，嬉戏于大厅之中\n"
"，这大厅中的富贵气派之中透著一股秀气，但是却也无一般富豪人家或酒\n"
"店的庸脂俗粉之气。\n"
"    屏风两旁的白石嵌云柱上工整地刻著一幅对联写道：\n"
"\n"
"    「座上珠玑照日月，却掩珠帘，难为芳心;\n"
"      堂前飘香焕云霞，不知岁月，但晓清音。」\n"
"\n"
msgstr ""

#. es2:d/latemoon/latemoon3 long
#: data/latemoon/rooms.json
msgid ""
"这里是晚月庄接待宾客的傍厅，厅中摆了一张桌几，上面摆著\n"
"一块大红镶金桌巾，靠东壁面西设著半旧青缎靠背引枕，两张太师\n"
"椅座。桌几上有一精致的茶壶，旁有盛好的上等茗茶。\n"
msgstr ""

#. es2:d/latemoon/latemoonc long
#: data/latemoon/rooms.json
msgid ""
"这是晚月庄后的小小庭院，面积似乎不大，但花木扶疏，举目四望，\n"
"竟种满了无数梅花，婉约娟秀，别有一番滋味。清风徐来，梅花特有的\n"
"清香弥漫在风中.....\n"
msgstr ""

#. es2:d/latemoon/latemoon5 long
#: data/latemoon/rooms.json
msgid ""
"你走在一条长廊上，两旁都是庭台堂庑，廊上弥漫著一股\n"
"香郁的气息，廊下是由青石砖铺成，一边接后厅内院，一边的\n"
"尽头则是一幅大石壁画，西侧似有一铜门(door)。\n"
"有一间书房。\n"
msgstr ""

#. es2:d/latemoon/latemoon6 long
#: data/latemoon/rooms.json
msgid ""
"这里四面都是单调的墙壁(wall)。通常庄内弟子犯错就是\n"
"关在这儿！反省思过。\n"
msgstr ""

#. es2:d/latemoon/latemoon7 long
#: data/latemoon/rooms.json
msgid ""
"你走在一条长廊上，两旁都是庭台堂庑，廊上弥漫著一股\n"
"香郁的气息，长廊向东西方延伸而去。东边是后厅院子，西边\n"
"有一间书房。\n"
msgstr ""

#. es2:d/latemoon/latebook long
#: data/latemoon/rooms.json
msgid ""
"这是一间小小的书房，窗明几净，朴素典雅，一张古意盎然的红木书桌，\n"
"吸引了你的目光，上面摆著一座小小的香炉，几本善本书整齐的堆放在桌上\n"
"，可见主人相当的爱惜书本。一幅「沧海龙吟」的舞曲图画挂在墙上，似乎\n"
"有一些秘密在里头。\n"
msgstr ""

#. es2:d/latemoon/latemoon8 long
#. es2:d/latemoon/miroom long
#: data/latemoon/rooms.json
msgid ""
"这是一间密室。地上铺著可以合地打坐的大理石床。四周挂了一\n"
"些兵器，正面墙上写了偌大的 『 舞 』字！ 地板上隐约看到一幅先\n"
"天八卦图。中央画著两仪，八个角落分别是：乾坤兑离震巽坎艮、等\n"
"卦相。墙上画著几幅玄天玉女翩然起舞的美妙步法。\n"
msgstr ""

#. es2:d/latemoon/latemoon4 long
#: data/latemoon/rooms.json
msgid ""
"你从后廊往西出了内厅进入穿堂。往北是内院，一条宽过道，西  \n"
"面立著一个粉油大影壁，后有一大半门，小小的一所庭宇。\n"
msgstr ""

#. es2:d/latemoon/latemoon2 long
#: data/latemoon/rooms.json
msgid ""
"走入内厅，你看到袭地铺满红毯。四面相对十二张雕漆椅上，都\n"
"是一色灰鼠椅搭小褥，厅中摆了小屏风，四周挂满山水墨画。一个木\n"
"隔架，旁边还有一碧纱橱(closet)。\n"
msgstr ""

#. es2:d/latemoon/room/twoc long
#: data/latemoon/rooms.json
msgid ""
"你走在后厅内院的仪门，是晚月庄后厅内院长廊走道的相接路\n"
"口。东北方是往膳房的夹道，西面是长廊夹道，南面是到后厅，往北\n"
"则可走出大门前往前院。\n"
msgstr ""

#. es2:d/latemoon/room/two1 long
#. es2:d/latemoon/room/two2 long
#. es2:d/latemoon/room/lroad1 long
#. es2:d/latemoon/room/lroad3 long
#: data/latemoon/rooms.json
msgid ""
"你走在后厅内院的夹道上，庄内像这样的走廊很多，你若没有地\n"
"理概念很容易迷路。长长的走道中, 纯金铸成的长灯架上挂了一排饰\n"
"丽的宫灯! 入夜之后灯火辉煌! 十分美丽!\n"
msgstr ""

#. es2:d/latemoon/room/guest1 long
#: data/latemoon/rooms.json
msgid ""
"这是一间客房，两边摆了一对小茶几。上面的彩绘瓶中插了一束\n"
"琼花，茶几旁两张雕漆椅。整个房间简朴幽静，为晚月庄供外客留宿\n"
"的一间厢房。\n"
msgstr ""

#. es2:d/latemoon/room/guest2 long
#: data/latemoon/rooms.json
msgid ""
"这是一间上等厢房，光线适中。近窗边有一张桌子，旁有书橱!\n"
"还有一个古琴放在平台上! 墙上除了美丽的饰物外，还挂了一些书画\n"
"有一浓郁清新的书香气息! 通常是给远道而来的贵客休憩夜宿的一间\n"
"上等厢房。\n"
msgstr ""

#. es2:d/latemoon/room/eat1 long
#: data/latemoon/rooms.json
msgid ""
"你走进一间装饰华丽的大饭厅，有一种说不出的气派，一张杉木  \n"
"雕饰的大圆桌子在厅子中央，铺著丝绸彩桌巾，上等南湖紫玉盘，湘\n"
"陵的瓷玉碗，银匙金筷。十分奢华。这是晚月庄宴请宾客的地方，平\n"
"常也是庄主及庄内辈份高的前辈用膳的地方。\n"
msgstr ""

#. es2:d/latemoon/room/eat2 long
#: data/latemoon/rooms.json
msgid ""
"这是一间膳房，中央摆了二张大圆桌。周围三十二张雕饰木藤椅。\n"
"平常庄内上下用膳的地方，东边是厨房，西边则是大饭厅，这虽然不\n"
"及饭厅华丽，但所有锅盘匙碗，也都是上等珍品。有大户人家的气派\n"
"与富贵。\n"
msgstr ""

#. es2:d/latemoon/room/kitchen long
#: data/latemoon/rooms.json
msgid ""
"你走进厨房，看到有好多的烹饪用品与设备，小蒸笼、大锅、平  \n"
"炊灶、烧饭炉等，五花八门，式样齐全。旁边的大仓储中，更放满各\n"
"式各样山珍美味，各种材料，调味物品应有尽有。里头的掌厨师姐们\n"
"忙里忙外，在为准备一道道佳肴辛苦著! 闻到那阵阵美味的菜香，你\n"
"的肚子咕噜咕噜叫了起来!\n"
msgstr ""

#. es2:d/latemoon/room/lcenter long
#: data/latemoon/rooms.json
msgid ""
"你进了后厅，这是后院上房五间中，最大的一间厅房。四面墙            \n"
"壁，玲珑剔透，琴剑书画，挂在墙上。锦笼纱罩，金彩珠光，连地上                  \n"
"踏的砖，皆是碧绿凿花，是雕空的紫檀板壁。厅上摆了二十六张桧木\n"
"交椅，庄内对外展示舞步表演，都是在这举行。\n"
msgstr ""

#. es2:d/latemoon/room/lstudio long
#: data/latemoon/rooms.json
msgid ""
"这是一间安静的书房, 光线适中, 近窗边有一张桌子, 旁有书橱\n"
"还有一个古琴放在平台上! 墙上除了美丽的饰物外, 还挂了一些书画                  \n"
"有一股浓郁清新的书香气息!\n"
msgstr ""

#. es2:d/latemoon/room/room4 long
#: data/latemoon/rooms.json
msgid ""
"这是一间安静的书房, 光线适中。近窗边有一张桌子，旁有书橱! \n"
"还有一个古琴放在平台上! 墙上除了美丽的饰物外，还挂了一些书画 \n"
"有一股浓郁清新的书香气息! \n"
msgstr ""

#. es2:d/latemoon/room/eroad2 long
#: data/latemoon/rooms.json
msgid ""
"通过后厅走道，接著你走进东厢房走道。除了长长的走道中，\n"
"一排饰丽的宫灯! 走道两旁摆设了许多奇花异草，各有各的特色与\n"
"形态，空气中弥漫一种淡淡的香气。往南通往东厢房。\n"
msgstr ""

#. es2:d/latemoon/room/eroad1 long
#: data/latemoon/rooms.json
msgid ""
"通过后厅走道，接著你走进东厢房走道。除了长长的走道中，\n"
"一排饰丽的宫灯! 走道两旁摆设了许多奇花异草，各有各的特色与\n"
"形态，空气中弥漫一种淡淡的香气。东面你看到一扇厢门。\n"
msgstr ""

#. es2:d/latemoon/room/eastroom long
#: data/latemoon/rooms.json
msgid ""
"你进入东厢房来，临窗的地上铺著猩红毛毯，正面设著大红金钱\n"
"蟒靠背，石青金钱蟒引枕，秋香色金钱蟒大条褥。两边设一对梅花式\n"
"红漆小几，几上茗琬瓶花俱备。这是一间上等厢房。\n"
msgstr ""

#. es2:d/latemoon/room/wroad1 long
#: data/latemoon/rooms.json
msgid ""
"通过后厅走道，接著你走进西厢房走道。长长的走道中，纯金\n"
"成的长灯架上挂了一排饰丽的宫灯! 走道两旁摆设了许多奇花异草，\n"
"空气中弥漫一种淡淡的香气。在一柱柱雕饰华丽的长柱，刻画许多\n"
"彩绘的图形，美不胜收。\n"
msgstr ""

#. es2:d/latemoon/room/wroad2 long
#: data/latemoon/rooms.json
msgid ""
"你走在西厢房走道上。长长的走道中，纯金成的长灯架上挂了一排\n"
"饰丽的宫灯! 走道两旁摆设了许多奇花异草，空气中弥漫一种淡淡的香\n"
"气。在一柱柱雕饰华丽的长柱，刻画许多彩绘的图形，美不胜收。西面\n"
"你看到一扇门。\n"
msgstr ""

#. es2:d/latemoon/room/westroom long
#: data/latemoon/rooms.json
msgid ""
"你进入西厢房来，地下面西放著四张椅子，都搭著银红撒花椅被\n"
"椅子两边有一对高几，右边几上文王鼎，匙筋香盒；左边几上汝窑美\n"
"人瓶内插著花卉茗琬棰壶等物。隔窗望去，隐约可看见花园景色。.\n"
msgstr ""

#. es2:d/latemoon/room/corridor7 long
#. es2:d/latemoon/miroom2 long
#: data/latemoon/rooms.json
msgid ""
"你进了内厅，迎面挂著葱绿洒花软帘，掀帘进去，抬头一看，\n"
"只见四面墙壁，玲珑剔透，琴剑书画，挂在墙上。锦笼纱罩，金彩\n"
"珠光，连地上踏的砖，皆是碧绿凿花，左一架书，右一架屏。四面\n"
"是雕空的紫檀板壁。\n"
msgstr ""

#. es2:d/latemoon/room/flower1 long
#: data/latemoon/rooms.json
msgid ""
"通过『 垂花门 』便是往后院。垂花门为男女之门限，古来女\n"
"人就有「大门不出，二门不迈」的谚语，于是二门堪称为男女门限\n"
"。后院为庄内女弟子厢房，与湘园。东面一扇小门，为庄内更衣沐\n"
"浴的小花池。更是严禁外人胡乱闯入。\n"
msgstr ""

#. es2:d/latemoon/room/bathroom1 long
#: data/latemoon/rooms.json
msgid ""
"这是一间更衣室，你看到许多柜子，衣架上挂了许多的衣服饰\n"
"品。墙上的架上挂了一些丝巾，你可以闻到淡淡的香气围绕四周。\n"
"东侧一蓝青洒花软帘，隔帘望去，隐约可看到小花池，一团的雾气\n"
"你有点想去冲凉沐浴，让精神好些。当然此处是禁止男性进入!\n"
msgstr ""

#. es2:d/latemoon/room/bathroom long
#: data/latemoon/rooms.json
msgid ""
"这是一个小花池，清澈的池水含著淡淡的幽香。池周围有许多奇花    \n"
"异草，时如至芝兰之室，清香袭脑，温馨荡魄。缤纷的花瓣飘在池上，\n"
"云幢羽葆中，簇拥著许多师姐妹，有的嘻戏玩耍，有的翩然起舞。你也\n"
"想到小花池中沐浴休憩(take bath)。\n"
msgstr ""

#. es2:d/latemoon/park/yard1 long
#: data/latemoon/rooms.json
msgid ""
"你走到前院，你看到几块山石，东面一处假山小池。其上植有藤  \n"
"萝、青芷，异草芬芳荔薛。池中几尾小鱼自在的游来游去。假山外隔\n"
"著围篱，有一种山怀中的小花园的感觉。.\n"
msgstr ""

#. es2:d/latemoon/park/flower2 long
#: data/latemoon/rooms.json
msgid ""
"走进月洞门，只见迎面一带翠嶂，挡在南面。只见白石崚嶒，  \n"
"或如鬼怪，或如猛兽，纵横拱立，上边苔藓成斑，藤萝掩映，其\n"
"中微露羊肠小径。往南进入翠嶂，往北是小花厅。\n"
msgstr ""

#. es2:d/latemoon/park/moonc long
#: data/latemoon/rooms.json
msgid ""
"穿过一层竹篱、花嶂编的月洞门，在你眼前出现的是那由粉墙环\n"
"护，绿柳周垂的翠嶂。两边分别是游廊相接通往桃花林与长廊曲洞。\n"
"在这儿一棵西府海棠(flower)吸引你的注意，只见其势若伞，丝垂翠\n"
"缕，葩吐丹砂，十分漂亮。\n"
msgstr ""

#. es2:d/latemoon/park/moon2 long
#: data/latemoon/rooms.json
msgid ""
"湘园的桂花小径是以不同颜色的细石砌成各种图案。路面的\n"
"图案组成，全员是一个整体。但每幅图案又有独立的内容，总计\n"
"花石子路上约有二百幅。沿路观赏，美不胜收。\n"
msgstr ""

#. es2:d/latemoon/park/moon1 long
#: data/latemoon/rooms.json
msgid ""
"你走入一长廊曲洞，里头略略的有几点山石，种著芭蕉，你可以\n"
"听到潺潺的流水声，这里是园内假山开凿的通道，蜿蜒盘旋，从洞口\n"
"向外望去，是一碧清的水池。顺著曲径走去，转了两个弯子，看见一\n"
"座石板桥。\n"
msgstr ""

#. es2:d/latemoon/park/moon5 long
#: data/latemoon/rooms.json
msgid ""
"这是一片桂花园，园内种植桂花树十万多株，枝干苍劲，枝叶  \n"
"茂盛，树冠完整，富有生气。放眼展望，满遍披翠盖绿，葱郁的桂\n"
"花树斑烂绚丽，优雅大方，碧海银花，清香阵阵。薰的游人醉，衣\n"
"发常留馀香。\n"
msgstr ""

#. es2:d/latemoon/park/bridge1 long
#: data/latemoon/rooms.json
msgid ""
"你走至大桥前，见水如晶帘一般奔入，扶著藤栏过去，只见水\n"
"上落花愈多，其水愈清，溶溶荡荡，曲折萦纡，池边两行垂柳，杂\n"
"著桃、杏，遮天蔽日般，真无一些尘土。度过桥去则通往湖心亭。\n"
msgstr ""

#. es2:d/latemoon/park/bridge3 long
#: data/latemoon/rooms.json
msgid ""
"走在桥上，可以远观山坡帏脉，两边飞楼插空，雕饰绣栏，隐\n"
"于亭园树木之间；俯而视之，则清流泻雪石磴穿云。朱红玉石为栏\n"
"，环抱池沿，柳垂金线，桃吐丹霞。\n"
msgstr ""

#. es2:d/latemoon/park/moon3 long
#: data/latemoon/rooms.json
msgid ""
"桂花园的石子甬道是以不同颜色的细石砌成各种图案。路面\n"
"的图案组成，全员是一个整体。但每幅图案又有独立的内容，总\n"
"计花石子路上约有二百幅。沿路观赏，美不胜收。\n"
msgstr ""

#. es2:d/latemoon/park/moroom long
#: data/latemoon/rooms.json
msgid ""
"你一进了小轩内，只觉异香扑鼻，那些奇草仙藤，越冷越苍翠，\n"
"都结了实，似珊瑚豆子一般，累垂可爱。房内雪洞一般，清凉舒适  \n"
"，案上一个土定瓶，中供著数枝菊花，旁边放了两本书、茶瓯茶杯  \n"
"而已，床上只吊著青纱帐幔被褥，也十分朴实。\n"
msgstr ""

#. es2:d/latemoon/park/pavilion1 long
#: data/latemoon/rooms.json
msgid ""
"亭子座落在园内小水池上，亭柱周围以弧形座凳式栏板，内外\n"
"雕刻各种不同样式的梅枝，钻尖式紫琉璃瓦顶，天花板也有雕刻非\n"
"常精细的百花图案。上下担额枋彩画题材是海墁式点金加彩琼花。\n"
"体形别致，色彩丰富。亭边石桥飞架，通萃赏楼，轻灵精巧，为园\n"
"中一大奇景。\n"
msgstr ""

#. es2:d/latemoon/park/moon4 long
#: data/latemoon/rooms.json
msgid ""
"暖香榭位于水池东岸，秋水山房之西，依岩为屋，结构曲折，\n"
"极幽致，室小而精，尚朴去华，渊然静修，古香袭人。走进这里\n"
"你有一种心源湛澈，天地虚灵，彷佛置身于仙境的感觉。往西面\n"
"望去，水底亭台，历历可鉴。\n"
msgstr ""

#. es2:d/latemoon/park/paroad2 long
#: data/latemoon/rooms.json
msgid ""
"转过翠嫣桥，隐隐露出一带黄泥筑就矮墙，墙头用稻茎掩护，\n"
"有几百株杏花，如喷火蒸霞一般，里面数楹茅屋，外面却是桑、\n"
"榆、槿、杉各色树木新条，随其曲折编就两溜青篱，篱外有一土  \n"
"井，旁有一石牌(sign)。旁边有一些佳蔬菜花。\n"
msgstr ""

#. es2:d/latemoon/park/bridge2 long
#: data/latemoon/rooms.json
msgid ""
"这是一座最精美的桥，全长十二米，宽度恰可走两人。石拱\n"
"是单孔结构，青石桥面，汉白玉雕石栏杆，栏板上刻有精致美丽\n"
"的花纹。二十个望柱头上各有一小孔雀，情态各异，饶有趣味。\n"
msgstr ""

#. es2:d/latemoon/park/paroad1 long
#: data/latemoon/rooms.json
msgid ""
"你走在石子墁的花园甬路上，只见两边翠竹夹路，土地下苍苔\n"
"布满，往东北你看到凤尾森森，龙吟细细，通往暖香榭。南面则是\n"
"一个小门。西方通往园中小桥。\n"
msgstr ""

#. es2:d/latemoon/park/moondoor long
#: data/latemoon/rooms.json
msgid ""
"这是晚月庄的后门，在美丽的湘园南侧，这有一个木制的小门。\n"
"走出门外应是通往天山的小径。\n"
msgstr ""

#. es2:d/latemoon/upstar/upstar1 long
#. es2:d/latemoon/upstar/upstar4 long
#. es2:d/latemoon/upstar/upstar2 long
#. es2:d/latemoon/upstar/upstar3 long
#: data/latemoon/rooms.json
msgid ""
"你走在后厅二楼的走廊上，庄内像这样的走廊很多，你若没有地\n"
"理概念很容易迷路。长长的走道中, 纯金铸成的长灯架上挂了一排饰\n"
"丽的宫灯! 入夜之后灯火辉煌! 十分美丽!\n"
msgstr ""

#. es2:d/latemoon/upstar/uproom2 long
#: data/latemoon/rooms.json
msgid ""
"这是晚月庄的舞曲步法研究室, 名曰「翠湘」。墙上刻画著各种\n"
"基本步法与一些诗词曲赋。在每一位美女图的姿态形体之中，那种翩\n"
"然起舞的曼妙舞姿，含蕴许多珍贵奇妙的舞步。你可以看到几位师姐\n"
"一起走著奇特的步法，正在试著模拟这些舞步，一边低头沉思要如何\n"
"运用，十分的投入。\n"
msgstr ""

#. es2:d/latemoon/upstar/upcenter long
#: data/latemoon/rooms.json
msgid ""
"这里是庄院二楼的佛堂门前，你可以闻到一股浓郁的檀香气息。\n"
"走在这里你有一种庄严肃静的感觉，在闲暇之馀你觉得来到这可以\n"
"暂时忘去周遭的烦人琐事，彷佛可以放开一切，所有时空都静止般\n"
"的虚空幽静。西面你看到一扇檀香木门。\n"
msgstr ""

#. es2:d/latemoon/upstar/uproom long
#: data/latemoon/rooms.json
msgid ""
"这是专供庄内祭祀的佛堂，是一座精构楼阁，屋顶覆以琉璃瓦，四\n"
"角钻尖覆以鎏金铜瓦。堂内供奉  人灵「区冥」，旁有雨神「天龙」、\n"
"火神「凤凰」。两翼有琉璃鹤照壁，姿态生动。四周置陈神龛佛像，供\n"
"盘塔磬，及一股檀香的气息。\n"
msgstr ""

#. es2:d/latemoon/upstar/upstarc long
#: data/latemoon/rooms.json
msgid ""
"这里是庄院二楼的前堂楼，有著传统的古式建筑风格。由上好的        \n"
"桧木搭建而成, 东面一阵耀眼的的白光由两扇敞开的落地窗口射进来\n"
"，泛映出一种清新幽静的格局。开了楼门出去可以一览庄院内外的山\n"
"川景色，欣赏其美丽景观。\n"
msgstr ""

#. es2:d/latemoon/upstar/uplook long
#: data/latemoon/rooms.json
msgid ""
"这是晚月庄的前堂楼观景台，站在台前你可以看到整个庄院的  \n"
"布局，瀚烟山美丽景色尽收眼里。微微的山风轻拂你的脸庞，有种\n"
"说不出的轻爽。远处山寺的钟声，飞鸟的鸣啼，与眼前的景色构成\n"
"一幅山林风光的风景画。正下方是前院。\n"
msgstr ""

#. es2:d/latemoon/upstar/uproom3 long
#: data/latemoon/rooms.json
msgid ""
"这是晚月庄让弟子们静修的地方, 名曰「缀芳」。简单的布置加上\n"
"一座檀香炉, 你觉得这绝对是一个静修(ponder)的好场所。空气中弥漫\n"
"著一股肃穆的气息, 使人很容易进入忘我的境界。\n"
msgstr ""

#. es2:d/latemoon/sroad1 long
#: data/latemoon/rooms.json
msgid ""
"你走在一条蜿蜒的小径, 小径的两旁是半个人高的杂草, 你可以感受\n"
"到清凉的微风从两侧吹来。\n"
msgstr ""

#. es2:d/latemoon/sroad2 long
#: data/latemoon/rooms.json
msgid ""
"你走在这条蜿蜒的小径上, 本来向北走的小径被一道峭壁挡住了,\n"
"因此小径从这弯向东边去, 在你的西边是一片杂草和几棵小树。\n"
msgstr ""

#. es2:d/latemoon/sroad3 long
#: data/latemoon/rooms.json
msgid ""
"条蜿蜒的小径通往东南方, 在你的东面是一道峭壁, 而在你的\n"
"南边是一片浓密的竹林。\n"
msgstr ""

#. es2:d/latemoon/sroad4 long
#: data/latemoon/rooms.json
msgid ""
"这条蜿蜒的小径通往西南方, 西边是一片茂密的竹林, 小\n"
"径两旁是绿油油的草地，凉风从草地上吹拂而过，像嬉戏的儿\n"
"童般溜过你的足畔，使你不知不觉间脚步轻快了起来。\n"
msgstr ""

#. es2:d/latemoon/sroad5 long
#: data/latemoon/rooms.json
msgid ""
"这条蜿蜒的小径通往东南方, 在你的东面是一处陡坡, 而在你的\n"
"西边是一座茂密的竹林。\n"
msgstr ""

#. es2:d/latemoon/bamboo3 long
#. es2:d/latemoon/bamboo long
#. es2:d/latemoon/bamboo1 long
#. es2:d/latemoon/bamboo2 long
#. es2:d/latemoon/bamboo4 long
#: data/latemoon/rooms.json
msgid ""
"这是一座茂密的竹林。当你进入后彷佛迷失了方向！\n"
msgstr ""

#. latemoon.entrance.door name
#: data/latemoon/world.json
msgid "拱门"
msgstr ""

#. latemoon.latemoon5.door name
#: data/latemoon/world.json
