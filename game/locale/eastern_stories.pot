msgstr ""

#. choyin.windspring/sword text
#: data/common/journal.json
msgid "你得到了步玄派历代相传的掌门信物——风泉之剑。"
msgstr ""

#. choyin.taolin/sent text
#: data/common/journal.json
msgid "你向骆云舟拜师，他说：你还是先走一趟东边的桃林吧。"
msgstr ""

#. choyin.taolin/out text
#: data/common/journal.json
msgid "你读着树上的字条找路，走出了曼雩台东边的桃林。"
msgstr ""

#. guye.mountain/rope text
#: data/common/journal.json
msgid "你在绝壁上的山洞里得到一条金丝编成、刻满咒文的缚仙绳。"
msgstr ""

#. guye.mountain/immortal text
#: data/common/journal.json
msgid "你在云台向紫衣童子问起仙人。"
msgstr ""

#. guye.mountain/pill text
#: data/common/journal.json
