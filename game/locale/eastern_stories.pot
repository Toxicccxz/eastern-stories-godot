msgstr ""

#. latemoon.upstar.upcenter.door name
#: data/latemoon/world.json
msgid "檀香木门"
msgstr ""

#. latemoon.upstar.upstarc.door name
#: data/latemoon/world.json
msgid "楼门"
msgstr ""

#. latemoon.latemoon3.tea name
#: data/latemoon/world.json
msgid "茶壶"
msgstr ""

#. latemoon.latemoon8.dance name
#. latemoon.miroom.proxy_dance name
#. latemoon.miroom.dance name
#: data/latemoon/world.json
msgid "八卦图"
msgstr ""

#. latemoon.latemoon8.dance dance.tired
#. latemoon.miroom.dance dance.tired
#: data/latemoon/world.json
msgid "你现在的神太少了，无法专注跳出舞步！"
msgstr ""

#. latemoon.latemoon8.dance dance.clumsy
#. latemoon.miroom.dance dance.clumsy
#: data/latemoon/world.json
msgid "你在卦象中跳起舞来。但似乎不得要领！"
msgstr ""

#. latemoon.latemoon8.dance dance.steps.line
#. latemoon.miroom.dance dance.steps.line
#: data/latemoon/world.json
msgid "$N在卦象中跳起舞来..一曲「 有凤来仪 」突然..."
msgstr ""

#. latemoon.latemoon8.dance dance.steps.line
#. latemoon.miroom.dance dance.steps.line
#: data/latemoon/world.json
msgid "$N在卦象中跳起舞来..一曲「 西出阳关 」突然..."
msgstr ""

#. latemoon.miroom.proxy_dance act.verb
#: data/latemoon/world.json
msgid "请人替跳"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"冰匣已经开了。\n"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.say
#: data/latemoon/world.json
msgid "看我的！"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.emote
#: data/latemoon/world.json
msgid "走到卦象中央，一个姿势，起舞——一曲「有凤来仪」，脚尖从乾到坎没点错一个。"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.line
#. latemoon.miroom.dance dance.steps.act.steps.line
#: data/latemoon/world.json
msgid ""
"冰匣的盖子无声地滑开了。一件月白的衣从匣里浮起来，落在地上——寒气扑面，屋里的灯焰都矮了一截。\n"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.say
#: data/latemoon/world.json
msgid "好不好看！我得回去啦，不然蓝姐姐要骂。"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.say
#: data/latemoon/world.json
msgid "替你跳一支？好。我舞跳得不好，这一支倒是会的。"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.emote
#: data/latemoon/world.json
msgid "在卦象中起舞，一曲「有凤来仪」，轻得像没踩在地上。"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.say
#: data/latemoon/world.json
msgid "几百年没人跳对过——原来是要给人跳的。"
msgstr ""

#. latemoon.miroom.proxy_dance act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"这里没有人替你跳。筱薇在隔壁的内厅，芳绫关在前院的禁闭房。\n"
msgstr ""

#. latemoon.latemoon2.search name
#. latemoon.latemoon2.landmark.closet name
#: data/latemoon/world.json
msgid "碧纱橱"
msgstr ""

#. latemoon.latemoon2.search act.verb
#. latemoon.latemoon8.bed act.verb
#. canyon.train.bookcase act.verb
#: data/latemoon/world.json data/canyon/world.json
msgid "翻找"
msgstr ""

#. latemoon.latemoon2.search act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你盲目的找著，但无发现什么!\n"
msgstr ""

#. latemoon.latemoon2.search act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你翻箱倒柜想找出手镯，但似乎毫无所获。\n"
msgstr ""

#. latemoon.latemoon2.search act.acts.steps.lines.line
#: data/latemoon/world.json
msgid "你从橱子内取出玛瑙手镯。"
msgstr ""

#. latemoon.latemoon8.bed name
#: data/latemoon/world.json
msgid "石床"
msgstr ""

#. latemoon.latemoon8.bed act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你在石床后面找到了一本舞曲谱！\n"
msgstr ""

#. latemoon.latemoon8.bed act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你在石床附近找了很久，结果一无所获。\n"
msgstr ""

#. latemoon.room.bathroom.bath act.verb
#: data/latemoon/world.json
msgid "沐浴"
msgstr ""

#. latemoon.room.bathroom.bath act.acts.ask
#: data/latemoon/world.json
msgid ""
"此处是禁止男性进入！男人下池沐浴会中火玫瑰毒：毒发时不断伤神，伤得重了会丧命。\n"
"确定要下池沐浴吗？"
msgstr ""

#. latemoon.room.bathroom.bath act.acts.choice
#: data/latemoon/world.json
msgid "确定沐浴"
msgstr ""

#. latemoon.room.bathroom.bath act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你觉得池水好像有种奇特的沁凉！\n"
msgstr ""

#. latemoon.room.bathroom.bath act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你在池子中尽情沐浴，舒服的泡在池中。\n"
msgstr ""

#. latemoon.upstar.uproom3.ponder act.verb
#: data/latemoon/world.json
msgid "静修"
msgstr ""

#. latemoon.upstar.uproom3.ponder act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你双手合掌，安静的坐在地上。\n"
msgstr ""

#. latemoon.upstar.uproom3.ponder act.acts.steps.line
#: data/latemoon/world.json
msgid ""
"你彷佛变的较为祥合慈善了! \n"
msgstr ""

#. latemoon.miroom.landmark.ice_chest name
#: data/latemoon/world.json
msgid "冰匣"
msgstr ""

#. latemoon.miroom.landmark.ice_chest long
#: data/latemoon/world.json
msgid ""
"一只玄冰雕的匣子，齐膝高，匣盖上结着不化的霜。匣面刻着一行小字：凤仪起，匣自开。几百年没人跳对过。\n"
msgstr ""

#. latemoon.gate.landmark.lantern name
#: data/latemoon/world.json
msgid "灯笼"
msgstr ""

#. latemoon.gate.landmark.lantern long
#: data/latemoon/world.json
msgid ""
"灯笼上几个娟秀的字迹写著：\n"
"晚霞西照人影依稀 \n"
"月影高挂和风婉约 \n"
msgstr ""

#. latemoon.latemoon6.landmark.wall name
#. death.inn2.landmark.wall name
#: data/latemoon/world.json data/death/world.json
msgid "墙"
msgstr ""

#. latemoon.latemoon6.landmark.wall long
#: data/latemoon/world.json
msgid ""
"    你仔细观看石墙，突然发现原本单调的墙上隐隐约约出现了\n"
"一幅渺渺茫茫，似有似无的景像。彷佛是幻境，但又似真实，你\n"
"清楚的看到一首词：「梦里消魂无说处，觉来惆怅消魂误。」\n"
msgstr ""

#. latemoon.latemoon2.landmark.closet action
#: data/latemoon/world.json
msgid "取出衣服"
msgstr ""

#. latemoon.latemoon2.landmark.closet messages.take
#: data/latemoon/world.json
msgid "你从橱子内取出布裙。"
msgstr ""

#. latemoon.latemoon2.landmark.closet messages.empty
#: data/latemoon/world.json
msgid "橱子内的衣服好像被拿光了。"
msgstr ""

#. latemoon.latemoon2.landmark.closet long
#: data/latemoon/world.json
msgid ""
"这是一个上等木材作成的小橱子，里面放了一些物品。\n"
"你看到一件件的美丽衣饰，真想取出(take cloth)看看。\n"
msgstr ""

#. latemoon.latebook.landmark.picture name
#: data/latemoon/world.json
msgid "湘绣舞曲图"
msgstr ""

#. latemoon.latebook.landmark.picture long
#: data/latemoon/world.json
msgid ""
"这是一幅湘绣的彩图，上有几名貌美的女子，以不同的姿态\n"
"舞著，其漫妙之处让你著迷。图旁另绣有一曲名『西出阳关』\n"
"(dancing out)与『有凤来仪 』\n"
msgstr ""

#. latemoon.park.moonc.landmark.flower name
#: data/latemoon/world.json
msgid "西府海棠"
msgstr ""

#. latemoon.park.moonc.landmark.flower action
#: data/latemoon/world.json
msgid "摘花蕊"
msgstr ""

#. latemoon.park.moonc.landmark.flower messages.take
#: data/latemoon/world.json
msgid "你从西府海棠中摘下一朵小花蕊。"
msgstr ""

#. latemoon.park.moonc.landmark.flower messages.empty
#: data/latemoon/world.json
msgid "西府海棠上的小花蕊已经被摘光了。"
msgstr ""

#. latemoon.park.moonc.landmark.flower long
#: data/latemoon/world.json
msgid ""
"    你仔细看这是一棵形状有些奇特的西府海棠，有一淡淡\n"
"的奇异香气。原来在旁边还有一朵不太起眼，但是略成金黄\n"
"色的小花蕊，你的直觉告诉你它似乎是一种珍贵药材。你想\n"
"把它摘下(pick)。\n"
msgstr ""

#. latemoon.park.paroad2.landmark.sign name
#: data/latemoon/world.json
msgid "石牌"
msgstr ""

#. latemoon.park.paroad2.landmark.sign long
#: data/latemoon/world.json
msgid ""
"\n"
" 「六神」、「四鬼」、「三灵」 \n"
"\n"
"         旋芒震日月\n"
"         宝剑护河山\n"
"\n"
msgstr ""

#. latemoon.room.flower1.changing_room ask
#: data/latemoon/world.json
msgid ""
"此处是禁止男性进入！闯进去的男人会被晚月庄的女弟子撒下火玫瑰毒、一脚踢出来：毒发时不断伤神，伤得重了会丧命。\n"
"确定要进去吗？"
msgstr ""

#. latemoon.room.flower1.changing_room choice
#: data/latemoon/world.json
msgid "确定进去"
msgstr ""

#. latemoon.latemoon3.teacup taken.line
#: data/latemoon/world.json
msgid ""
"你将瓷杯交回给雨梅。\n"
msgstr ""

#. latemoon.latemoon3.teacup without
#: data/latemoon/world.json
msgid "你起身往南离开!"
msgstr ""

#. sanyen.npc.greeting long
#: data/sanyen/npcs.json
msgid ""
"这个知客僧脸色和蔼，虽然在寺中的地位不高，但是他总是让人有一种\n"
"值得信赖的感觉。\n"
msgstr ""

#. sanyen.npc.greeting accept_fight.say
#: data/sanyen/npcs.json
msgid "阿弥陀佛！小僧武功低微，认输便是。"
msgstr ""

#. sanyen.npc.monk long
#: data/sanyen/npcs.json
msgid ""
"瞧这个头陀的模样与服色，似乎不是山烟寺的僧人，但是他大喇喇地站在\n"
"这里，一副不可一世的样子。\n"
msgstr ""

#. sanyen.npc.bonze name
#: data/sanyen/npcs.json
msgid "僧人"
msgstr ""

#. sanyen.npc.bonze long
#: data/sanyen/npcs.json
msgid ""
"一个笑咪咪的僧人对著你微微颔首。\n"
msgstr ""

#. sanyen.npc.bonze accept_fight.say
#. sanyen.npc.work_bonze accept_fight.say
#: data/sanyen/npcs.json
msgid "阿弥陀佛！贫僧武功低微，施主不要开这种玩笑。"
msgstr ""

#. sanyen.npc.cripple long
#: data/sanyen/npcs.json
msgid ""
"这个僧人跛了右腿，脸上没有什么表情，一副若有所思的样子。\n"
msgstr ""

#. sanyen.npc.cripple accept_fight.say
#: data/sanyen/npcs.json
msgid "阿弥陀佛！贫僧武功低微，又是个残废，施主不要开这种玩笑。"
msgstr ""

#. sanyen.npc.drug_bonze long
#: data/sanyen/npcs.json
msgid ""
"一位长得相当精壮的年轻僧人, 他正在整理药材。\n"
msgstr ""

#. sanyen.npc.cook_bonze name
#: data/sanyen/npcs.json
msgid "烧饭僧"
msgstr ""

#. sanyen.npc.cook_bonze long
#: data/sanyen/npcs.json
msgid ""
"一位长得肥肥胖胖, 福福泰泰的中年僧人。\n"
msgstr ""

#. sanyen.npc.cook_bonze accept_fight.say
#: data/sanyen/npcs.json
msgid "阿弥陀佛 !! 贫僧的菜刀是用来切菜的, 不是用来砍人的。"
msgstr ""

#. sanyen.npc.little_bonze name
#: data/sanyen/npcs.json
msgid "小沙弥"
msgstr ""

#. sanyen.npc.little_bonze long
#: data/sanyen/npcs.json
msgid ""
"一个天真无邪的小和尚, 一颗圆滚滚光溜溜可爱的小光头, 让人看了\n"
"就十分的喜欢他。他正在为油灯添上香油。\n"
msgstr ""

#. sanyen.npc.little_bonze accept_fight.say
#: data/sanyen/npcs.json
msgid "师父! 救命啊!!  啊....不要打我..:("
msgstr ""

#. sanyen.npc.work_bonze long
#: data/sanyen/npcs.json
msgid ""
"一个肥肥胖胖的僧人, 看他拿著扫把有一下没一下的扫著, 就知道他\n"
"平常也是摸鱼大王。\n"
msgstr ""

#. es2:u/cloud/sunhill/northriver long
#: data/sanyen/rooms.json
msgid ""
"这里已靠近北岸，江水齐胸深，偶尔一个湍流卷过来，仿佛要将人\n"
"打入江底似的。\n"
msgstr ""

#. es2:u/cloud/sunhill/midriver long
#: data/sanyen/rooms.json
msgid ""
"这里虽说是泓水最窄的地方，可泓水在这里转了个弯，所以常有暗\n"
"流出现。常有过往船只在这里沉入江底，连水性了得的船夫们也不敢在\n"
"风大浪急时过江。\n"
msgstr ""

#. es2:u/cloud/sunhill/southriver long
#: data/sanyen/rooms.json
msgid ""
"这里靠近南岸，江水甚是寒冷。从这儿已能望到山烟寺的一角。\n"
msgstr ""

#. es2:u/cloud/sunhill/dukou long
#: data/sanyen/rooms.json
msgid ""
"这里是泓水南岸，再往南不远就是日照山了。\n"
msgstr ""

#. es2:u/cloud/sunhill/road1 long
#: data/sanyen/rooms.json
msgid ""
"这是条崎岖的黄土小径，北面通向渡口，往南小路蜿蜒而上，通往\n"
"山顶。\n"
msgstr ""

#. es2:u/cloud/sunhill/road2 long
#. es2:u/cloud/sunhill/road3 long
#. es2:u/cloud/sunhill/road4 long
#: data/sanyen/rooms.json
msgid ""
"这是条崎岖的黄土小径。\n"
msgstr ""

#. es2:d/sanyen/sroad1 long
#: data/sanyen/rooms.json
msgid ""
"这是一条铺著生满青苔大石的山路，但是路面大概常有人行走，因\n"
"此倒也并不湿滑，往南是一段石阶缓缓下山，往北则是通往山中的山路\n"
"，东面的山壁上刻著「山烟寺」几个大字，看起来岁月已经颇久了。\n"
msgstr ""

#. es2:d/sanyen/sroad2 long
#: data/sanyen/rooms.json
msgid ""
"这条山路到这里转了个弯，往东穿过一个山壁上凿出来的隧道，往\n"
"南则顺著山势缓缓下山。\n"
msgstr ""

#. es2:d/sanyen/gate long
#: data/sanyen/rooms.json
msgid ""
"这里是往山烟寺的山门，山烟寺在你的西面不远，由于寺中的老方丈\n"
"玄智和尚医术通神，不少受过恩惠的各地富豪将山烟寺修整得金碧辉煌，\n"
"庄严雄伟，因此山烟寺规模虽然不及京城的白象禅院，但是名气却是\n"
"大得多了。\n"
msgstr ""

#. es2:d/sanyen/tunnele long
#: data/sanyen/rooms.json
msgid ""
"你走进了一个凿穿山壁开成的隧道，东边是隧道的出口，往西不远\n"
"处也可以从这里瞧见西边的出口，一股硫磺的味道从隧道壁中传来，想\n"
"必左近便有温泉或是火山。\n"
msgstr ""

#. es2:d/sanyen/tunnel long
#: data/sanyen/rooms.json
msgid ""
"你走进了一个凿穿山壁开成的隧道，隧道也不甚长，约七、八丈左\n"
"右，西边就是隧道的出口，隧道中你可以闻到一股硫磺的味道，想必左\n"
"近便有温泉或是火山。\n"
msgstr ""

#. es2:d/sanyen/front_yard long
#: data/sanyen/rooms.json
msgid ""
"这里是山烟寺前的空地，平日僧人们就在这里练武强身，空地四周\n"
"种了一排白杨树，靠北边的地方放了一堆用来锻链膂力的砖头，寺门就\n"
"在你的北边, 东边则是山门。\n"
msgstr ""

#. es2:d/sanyen/door long
#: data/sanyen/rooms.json
msgid ""
"出现在眼前的是一座宏伟壮丽的寺门, 上方覆著镶金的瓦片, 瓦\n"
"片的下方挂著一方翡翠匾额, 上面写著『山烟寺』三个烫金大字。正\n"
"中的大门正紧紧关闭著, 只有在迎接大人物时才会开启。现在只开著\n"
"两旁的偏门。\n"
msgstr ""

#. es2:d/sanyen/road1 long
#: data/sanyen/rooms.json
msgid ""
"一条铺著青石板的大道, 两旁种植一排芍药。北方就是大雄宝殿\n"
", 一座上覆金瓦的雄伟建筑, 屋檐的四个角落雕就著四只栩栩如的金\n"
"龙, 屋檐下还各挂著一串金风铃, 清风吹来, 发出阵阵清脆的铃声。\n"
"东边有条小一点的石板路, 阵阵的药香就从东边传来。\n"
msgstr ""

#. es2:d/sanyen/road2 long
#: data/sanyen/rooms.json
msgid ""
"你正走在一条青石板铺造的小径上, 两旁种植著一排芍药。阵阵\n"
"药香随风送了过来, 原来北边是片广大的药圃。\n"
msgstr ""

#. es2:d/sanyen/drug_field long
#: data/sanyen/rooms.json
msgid ""
"一片广阔的药圃, 药香就是从这里散发出来的。这里似乎经过详\n"
"细的规划, 一块一块的, 哪边种当归, 哪边种枸杞, 绝不会混在一起\n"
"。只是看来看去都只是些寻常的药材, 看不到比较珍贵特殊的。\n"
msgstr ""

#. es2:d/sanyen/temple long
#: data/sanyen/rooms.json
msgid ""
"一阵耀眼的金光向你袭来, 你定神一看原来是座一丈八尺的如来\n"
"佛祖金身, 坐在一座三尺高的莲台上, 前方的香炉里香烟缓缓飘上天\n"
"。这整座山烟寺都是由上好的桧木搭建而成, 南方则是两扇敞开的金\n"
"门, 价值不菲, 气势不凡, 在佛像的右侧有道黄布幔, 布幔后似乎是\n"
"条通道。西边则传来阵阵的流水声。\n"
msgstr ""

#. es2:d/sanyen/inner_yard long
#: data/sanyen/rooms.json
msgid ""
"你正站在山烟寺的庭园里, 这庭园里不但花草茂盛, 而且小桥流\n"
"水, 假山凉亭, 应有尽有, 气派非凡。北边有间雅房, 东边穿过拱门\n"
"则是大殿。\n"
msgstr ""

#. es2:d/sanyen/heal_room long
#: data/sanyen/rooms.json
msgid ""
"你走进这里, 一阵刺鼻药味向你扑了过来。这是一间相当宽敞的\n"
"的大房间, 是玄智方丈为人看病的地方, 也是存放药草的地方。与屋\n"
"顶齐高的木柜, 画分成许多抽屉, 里面分别摆放著药材。两侧的墙璧\n"
"上挂了许许多多的檀木扁额(plaque)。\n"
msgstr ""

#. es2:d/sanyen/corridor long
#: data/sanyen/rooms.json
msgid ""
"你正走在一条长廊上, 两旁种植著一排月桂树。南边的布幔后是\n"
"大殿, 北方则是后殿。东边是个不小的广场, 广场上正晒著一些不知\n"
"名的药草。\n"
msgstr ""

#. es2:d/sanyen/corridor1 long
#: data/sanyen/rooms.json
msgid ""
"你正走在一条长廊上, 两旁分别是流云轩及后殿的外墙, 墙上画\n"
"著大慈大悲观世音菩萨救苦救难的事迹。长廊往东西两边延伸, 西边\n"
"的尽是一间相当大的房屋。\n"
msgstr ""

#. es2:d/sanyen/kitchen long
#: data/sanyen/rooms.json
msgid ""
"一间整理相乾净的厨房, 西北边的角落里砌了两个大灶, 灶里正\n"
"燃著熊熊大火, 灶上分别放著一个大锅(pot) 及一个蒸笼(steampot)\n"
"。锅子及蒸笼正冒著阵阵的热气以及香气, 你忍不住想打开来看看。\n"
msgstr ""

#. es2:d/sanyen/back_temple long
#: data/sanyen/rooms.json
msgid ""
"一间宽大的后殿, 正中有一尊药师如来的金身塑像。四周的墙上\n"
"唯妙唯肖地彩绘著十八罗汉, 每个罗汉的旁边并写著他得道升天的过\n"
"程。\n"
msgstr ""

#. es2:d/sanyen/tower long
#: data/sanyen/rooms.json
msgid ""
"你正站在两座高塔前, 左边这一座名曰: 『明心塔』, 右方名叫\n"
"『见性塔』。历来, 当山烟寺中的高僧涅盘后, 遗体火化后所得的舍\n"
"利子就存放在这两座塔里。\n"
msgstr ""

#. sunhill name
#: data/sanyen/world.json
msgid "日照山"
msgstr ""

#. sanyen.road1.door name
#: data/sanyen/world.json
msgid "金门"
msgstr ""

#. sanyen.heal_room.landmark.plaque name
#: data/sanyen/world.json
msgid "檀木扁额"
msgstr ""

