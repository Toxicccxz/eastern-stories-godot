msgid "$N注视著$n的行动，企图寻找机会出手。"
msgstr "$N은(는) $n의 움직임을 주시하며 손쓸 틈을 엿본다."

msgid "$N正盯著$n的一举一动，随时准备发动攻势。"
msgstr "$N은(는) $n의 일거수일투족을 노려보며 언제든 공세를 펼칠 채비를 한다."

msgid "$N缓缓地移动脚步，想要找出$n的破绽。"
msgstr "$N은(는) 천천히 발을 옮기며 $n의 허점을 찾는다."

msgid "$N目不转睛地盯著$n的动作，寻找进攻的最佳时机。"
msgstr "$N은(는) 눈도 깜박이지 않고 $n의 동작을 노려보며 공격할 최적의 때를 엿본다."

msgid "$N慢慢地移动著脚步，伺机出手。"
msgstr "$N은(는) 천천히 발을 옮기며 기회를 노린다."

msgid "$N哈哈大笑，说道：承让了！"
msgstr "$N이(가) 껄껄 웃으며 말한다. “양보해 주셔서 감사합니다!”"

msgid "$N双手一拱，笑著说道：承让！"
msgstr "$N이(가) 두 손을 맞잡아 포권하고 웃으며 말한다. “양보해 주셔서 감사합니다!”"

msgid "$N胜了这招，向後跃开三尺，笑道：承让！"
msgstr "$N이(가) 이번 초식을 이기고 석 자 뒤로 훌쩍 물러나 웃는다. “양보해 주셔서 감사합니다!”"

msgid "$n脸色微变，说道：佩服，佩服！"
msgstr "$n의 안색이 살짝 변한다. “탄복했소, 탄복했소!”"

msgid "$n向後退了几步，说道：这场比试算我输了，佩服，佩服！"
msgstr "$n이(가) 몇 걸음 물러서며 말한다. “이번 비무는 내가 졌소. 탄복했소, 탄복했소!”"

msgid "$n向後一纵，躬身做揖说道：阁下武艺不凡，果然高明！"
msgstr "$n이(가) 뒤로 훌쩍 물러나 허리 굽혀 읍한다. “무예가 범상치 않으시구려. 과연 고명하시오!”"

msgid "$N受到$n的内力反震，闷哼一声。"
msgstr "$N은(는) $n의 내력에 되튕겨 나며 끙 하고 신음한다."

msgid "$N被$n以内力反震，「嘿」地一声退了两步。"
msgstr "$N은(는) $n의 내력에 되튕겨 “흡!” 하고 두 걸음 물러난다."

msgid "$N被$n以内力一震，胸口有如受到一记重击，连退了五六步！"
msgstr "$N은(는) $n의 내력에 한 번 튕기자 가슴에 묵직한 일격을 맞은 듯 대여섯 걸음을 연달아 물러난다!"

msgid "$N被$n的内力一震，眼前一黑，身子向後飞出丈许！！"
msgstr "$N은(는) $n의 내력에 튕기자 눈앞이 캄캄해지며 몸이 한 장 남짓 뒤로 날아간다!!"

msgid "$N一击不中，露出了破绽！"
msgstr "$N의 일격이 빗나가며 허점이 드러난다!"

msgid "$N见$n攻击失误，趁机发动攻击！"
msgstr "$N은(는) $n의 공격이 빗나간 것을 보고 그 틈을 타 공격한다!"

msgid "结果没有造成任何伤害。"
msgstr "그러나 아무런 상처도 입히지 못했다."

msgid "擦伤"
msgstr "찰과상"

msgid "割伤"
msgstr "베인 상처"

msgid "结果只是轻轻地划破$p的皮肉。"
msgstr "그러나 $p의 살갗을 살짝 스치는 데 그쳤다."

msgid "结果在$p$l划出一道细长的血痕。"
msgstr "$p의 $l에 가늘고 긴 핏자국이 그어졌다."

msgid "结果「嗤」地一声划出一道伤口！"
msgstr "“칙!” 하는 소리와 함께 상처가 벌어졌다!"

msgid "结果「嗤」地一声划出一道血淋淋的伤口！"
msgstr "“칙!” 하는 소리와 함께 피가 철철 흐르는 상처가 벌어졌다!"

msgid "结果「嗤」地一声划出一道又长又深的伤口，溅得$N满脸鲜血！"
msgstr "“칙!” 하는 소리와 함께 길고 깊은 상처가 벌어지며, $N의 얼굴에 온통 피가 튀었다!"

msgid "结果只听见$n一声惨嚎，$w已在$p$l划出一道深及见骨的可怕伤口！！"
msgstr "$n의 처절한 비명과 함께, $w이(가) $p의 $l에 뼈가 드러날 만큼 끔찍한 상처를 냈다!!"

msgid "结果只是轻轻地刺破$p的皮肉。"
msgstr "그러나 $p의 살갗을 살짝 찌르는 데 그쳤다."

msgid "结果在$p$l刺出一个创口。"
msgstr "$p의 $l에 찔린 상처가 하나 생겼다."

msgid "结果「噗」地一声刺入了$n$l寸许！"
msgstr "“푹!” 하는 소리와 함께 $n의 $l에 한 치 남짓 박혔다!"

msgid "结果「噗」地一声刺进$n的$l，使$p不由自主地退了几步！"
msgstr "“푹!” 하는 소리와 함께 $n의 $l에 꽂히며, $p은(는) 저도 모르게 몇 걸음 물러났다!"

msgid "结果「噗嗤」地一声，$w已在$p$l刺出一个血肉模糊的血窟窿！"
msgstr "“푸욱!” 하는 소리와 함께, $w이(가) $p의 $l에 피범벅이 된 구멍을 뚫었다!"

msgid "结果只听见$n一声惨嚎，$w已在$p的$l对穿而出，鲜血溅得满地！！"
msgstr "$n의 처절한 비명과 함께, $w이(가) $p의 $l을(를) 꿰뚫고 나와 피가 사방에 튀었다!!"

msgid "结果只是轻轻地碰到，比拍苍蝇稍微重了点。"
msgstr "그러나 살짝 닿았을 뿐이다. 파리를 때리는 것보다 조금 더 셀 뿐이다."

msgid "结果在$p的$l造成一处瘀青。"
msgstr "$p의 $l에 멍이 하나 들었다."

msgid "结果一击命中，$n的$l登时肿了一块老高！"
msgstr "정통으로 맞아, $n의 $l이(가) 대번에 퉁퉁 부어올랐다!"

msgid "结果一击命中，$n闷哼了一声显然吃了不小的亏！"
msgstr "정통으로 맞아, $n이(가) 끙 하고 신음했다. 적잖이 당한 것이 분명하다!"

msgid "结果「砰」地一声，$n退了两步！"
msgstr "“퍽!” 하는 소리와 함께 $n이(가) 두 걸음 물러났다!"
