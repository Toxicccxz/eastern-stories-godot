msgstr "안위, 여섯 표."

msgid "颜违，七票。"
msgstr "안위, 일곱 표."

msgid "颜违，八票。"
msgstr "안위, 여덟 표."

msgid "颜违，九票。"
msgstr "안위, 아홉 표."

msgid "卫盟主，零票。"
msgstr "위 맹주, 영 표."

msgid "旧盟主，零票。"
msgstr "전 맹주, 영 표."

msgid "卫盟主，一票。"
msgstr "위 맹주, 한 표."

msgid "旧盟主，一票。"
msgstr "전 맹주, 한 표."

msgid "卫盟主，两票。"
msgstr "위 맹주, 두 표."

msgid "旧盟主，两票。"
msgstr "전 맹주, 두 표."

msgid "卫盟主，三票。"
msgstr "위 맹주, 세 표."

msgid "旧盟主，三票。"
msgstr "전 맹주, 세 표."

msgid "卫盟主，四票。"
msgstr "위 맹주, 네 표."

msgid "旧盟主，四票。"
msgstr "전 맹주, 네 표."

msgid "卫盟主，五票。"
msgstr "위 맹주, 다섯 표."

