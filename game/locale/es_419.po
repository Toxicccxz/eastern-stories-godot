msgid "%s摇摇头，说道：没听说过。"
msgstr "%s{:el} niega con la cabeza: \"Nunca oí hablar de eso.\""

msgid "%s睁大眼睛望著你，显然不知道你在说什麽。"
msgstr "%s{:el} te mira con los ojos muy abiertos; está claro que no tiene idea de qué le hablas."

msgid "%s耸了耸肩，很抱歉地说：无可奉告。"
msgstr "%s{:el} se encoge de hombros, como disculpándose: \"No hay nada que yo pueda contar.\""

msgid "%s说道：嗯....这我可不清楚，你最好问问别人吧。"
msgstr "%s{:el} dice: \"Mmm... de eso no sé nada. Mejor habría que preguntarle a otro.\""

msgid "%s想了一会儿，说道：对不起，你问的事我实在没有印象。"
msgstr "%s{:el} lo piensa un momento: \"Lo siento, de eso no recuerdo nada.\""

msgid "你向{npc}问道：敢问{respect}尊姓大名？"
msgstr "Le preguntas a {npc}{:el}: \"¿Me permite saber su nombre, {respect}?\""

msgid "你向{npc}问道：这位{respect}，{self}初到贵宝地，不知这里有些什麽风土人情？"
msgstr "Le preguntas a {npc}{:el}: \"Disculpe, {respect}: acabo de llegar a estas tierras. ¿Qué costumbres hay por aquí?\""

msgid "你向{npc}问道：这位{respect}，不知最近有没有听说什麽消息？"
msgstr "Le preguntas a {npc}{:el}: \"Dígame, {respect}, ¿ha oído alguna noticia últimamente?\""

msgid "你向{npc}打听有关『{topic}』的消息。"
msgstr "Le preguntas a {npc}{:el} por \"{topic}\"."

msgid "但是很显然的，%s现在的状况没有办法给你任何答覆。"
msgstr "Pero está claro que %s{:el} no está en condiciones de darte respuesta alguna."

msgid "{npc}对你把眼一瞪：{self}的名字是可以随便提的吗？！我看你这{rude}是活腻了！"
msgstr "{npc}{:el} te fulmina con la mirada: \"¿¡Quién te crees para andar soltando mi nombre!? ¡Parece que te cansaste de vivir, {rude}!\""

msgid "{npc}对你哈哈一笑：{npc}便是{self}！"
msgstr "{npc}{:el} suelta una carcajada: \"¿{npc}{:el}? ¡{~:Ese|Esa} soy yo!\""

msgid "{npc}对你作了一揖：这位{respect}可真会开玩笑，怎么会突然问起{self}的名字？"
msgstr "{npc}{:el} junta los puños y te hace una reverencia: \"Qué bromista es usted, {respect}. ¿A qué viene preguntar mi nombre así de pronto?\""

msgid "{npc}对你说道：这里是{place}，至于其它的，{self}不便多说。"
msgstr "{npc}{:el} te dice: \"Esto es {place}{:el}. Lo demás no me toca a mí decirlo.\""

msgid "{npc}在你的耳边悄声说道：{line}"
msgstr "{npc}{:el} te susurra al oído: \"{line}\""

