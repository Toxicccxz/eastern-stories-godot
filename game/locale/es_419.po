msgid "忙碌：约 {n} 秒后空下来"
msgstr "Ocupado: libre en unos {n} s"

msgid "朱鸿雪的任务：时间已过"
msgstr "Encargo de Zhu Hongxue: se acabó el tiempo"

msgid "朱鸿雪的任务：还有{time}"
msgstr "Encargo de Zhu Hongxue: quedan {time}"

msgid "切磋 · 胜"
msgstr "Combate amistoso · Victoria"

msgid "切磋 · 负"
msgstr "Combate amistoso · Derrota"

msgid "切磋 · 平手"
msgstr "Combate amistoso · Empate"

msgid "对手：{who}　共 {rounds} 回合"
msgstr "Rival: {who}{:0} · Rondas: {rounds}"

msgid "共 {rounds} 回合"
msgstr "Rondas: {rounds}"

msgid "你先打中了对方，这一场是你赢了。"
msgstr "Acertaste primero. Este combate es tuyo."

msgid "对方先打中了你。切磋点到为止，随时可以再来。"
msgstr "El otro acertó primero. El combate amistoso se queda en un toque; puedes repetirlo cuando quieras."

msgid "谁也没打中谁，双方停了手。"
msgstr "Nadie acertó un golpe y ambos se detuvieron."

msgid "实战经验 +{n}"
msgstr "Experiencia de combate +{n}"

msgid "潜能 +{n}"
msgstr "Potencial +{n}"

