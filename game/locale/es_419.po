msgstr "Espada"

msgid "刀法"
msgstr "Sable"

msgid "棍法"
msgstr "Garrote"

msgid "杖法"
msgstr "Bastón"

msgid "暗器"
msgstr "Armas ocultas"

msgid "内功"
msgstr "Neigong"

msgid "招架"
msgstr "Parada"

msgid "轻功"
msgstr "Qinggong"

msgid "法术"
msgstr "Misticismo"

msgid "咒文"
msgstr "Conjuros"

msgid "行动"
msgstr "Movimiento"

msgid "阵法"
msgstr "Formaciones"

msgid "鞭法"
msgstr "Látigo"

msgid "驱尸"
msgstr "Levantar muertos"

msgid "你正在战斗中！"
msgstr "¡Estás en pleno combate!"

msgid "你要驱动哪一具尸体？"
msgstr "¿Qué cadáver quieres levantar?"

msgid "你的法力不够了！"
msgstr "¡No te queda suficiente Poder arcano!"

msgid "$N对著地上的$n喃喃地念了几句咒语，$n抽搐了几下竟站了起来！"
msgstr "$N{:el} {N:murmuras|murmura} unas palabras de conjuro sobre {n:ti|$n{:el}}, en el suelo. ¡$n{:el} {n:te agitas|se agita} un par de veces y {n:te levantas|se levanta}!"

msgid "阴阳眼"
msgstr "Vista espectral"

msgid "你已经施展过阴阳眼的法术了。"
msgstr "Ya lanzaste la Vista espectral."

msgid "你的法力不够。"
msgstr "No tienes suficiente Poder arcano."

msgid "$N微一凝神，闭著眼睛念了几句咒语，施展「阴阳眼」法术。"
msgstr "$N{:el} {N:concentras|concentra} un instante la mente, {N:cierras|cierra} los ojos, {N:murmuras|murmura} unas palabras y {N:lanzas|lanza} la Vista espectral."

msgid "你的阴阳眼法术失效了。"
msgstr "Tu Vista espectral se disipa."

msgid "你失败了。"
msgstr "Fallaste."

msgid "你要对谁施展这个法术？"
msgstr "¿Sobre quién quieres lanzar este hechizo?"

msgid "你的法力不够！"
msgstr "¡No tienes suficiente Poder arcano!"

msgid "你的精神没有办法有效集中！"
msgstr "¡No logras concentrar la mente!"

msgid "但是被$n躲开了。"
msgstr "Pero $n{:el} {n:lo esquivas|lo esquiva}."

msgid "( 你上一个动作还没有完成，不能念咒文。)"
msgstr "( Todavía no has terminado lo que hacías; aún no puedes recitar conjuros. )"

msgid "这里不准念咒文。"
msgstr "Aquí no se permite recitar conjuros."

msgid "你请先用 enable 指令选择你要使用的咒文系。"
msgstr "Elige primero la escuela de conjuros que quieres usar."

msgid "你所选用的咒文系中没有这种咒文。"
msgstr "La escuela de conjuros que elegiste no tiene ese conjuro."

msgid "( 你上一个动作还没有完成，不能施展神通。)"
msgstr "( Todavía no has terminado lo que hacías; aún no puedes usar un arte sobrenatural. )"

msgid "这里无法使用神通。"
msgstr "Aquí no funcionan las artes sobrenaturales."

msgid "你请先用 enable 指令选择你要使用的神通系。"
msgstr "Elige primero el sistema de artes sobrenaturales que quieres usar."

msgid "你所选用的法术系中没有这种法术。"
msgstr "El sistema de hechizos que elegiste no incluye ese hechizo."

msgid "「封」字诀"
msgstr "Secreto \"Sello\""

msgid "牵制攻击只能对战斗中的对手使用。"
msgstr "El ataque de contención solo funciona contra un rival en combate."

msgid "$n目前正自顾不暇，放胆攻击吧！"
msgstr "¡{n:Tienes|$n{:el} tiene} las manos ocupadas: ataca sin miedo!"

msgid "$N使出封山剑法「封」字诀，连递数个虚招企图扰乱$n的攻势，结果$p被$P攻了个措手不及！"
msgstr "$N{:el} {N:usas|usa} el secreto \"Sello\" de la Espada de la Montaña Vacía y {N:lanzas|lanza} una finta tras otra para desbaratar {n:tu ataque|el ataque de $n{:el}}, ¡y $n{:el} no {n:alcanzas|alcanza} a reaccionar a tiempo!"

msgid "$N使出封山剑法「封」字诀，连递数个虚招企图扰乱$n的攻势，可是$p看破了$P的企图，并没有上当。"
msgstr "$N{:el} {N:usas|usa} el secreto \"Sello\" de la Espada de la Montaña Vacía y {N:lanzas|lanza} una finta tras otra para desbaratar {n:tu ataque|el ataque de $n{:el}}, pero $n{:el} {n:descubres|descubre} {N:tu|su} intención y no {n:caes|cae} en la trampa."

msgid "游识神通"
msgstr "Sentido errante"

msgid "你要移动到哪一个人身边？"
msgstr "¿Junto a quién quieres ir?"

msgid "你无法感受到这个人的灵力 ...."
msgstr "No logras percibir el Poder místico de esta persona..."

msgid "中止施法。"
msgstr "Interrumpes el hechizo."

msgid "$N低头闭目，开始施展游识神通 ...."
msgstr "$N{:el} {N:bajas|baja} la cabeza, {N:cierras|cierra} los ojos y {N:empiezas|empieza} a usar el Sentido errante..."

msgid "战斗中无法使用游识神通！"
msgstr "¡No puedes usar el Sentido errante en combate!"

msgid "你的灵力不够！"
msgstr "¡No tienes suficiente Poder místico!"

msgid "游识神通只能对自己使用！"
msgstr "¡El Sentido errante solo puede usarse sobre ti mismo!"

msgid "你感受到对方的灵力，但是不够强烈。"
msgstr "Percibes su Poder místico, pero no con la fuerza suficiente."

msgid "你因为不够熟练而失败了。"
msgstr "Fallas por falta de práctica."

msgid "$N口中喃喃地念著咒文，忽然大喝一声“疾！”"
msgstr "$N{:el} {N:murmuras|murmura} un conjuro y de pronto {N:gritas|grita}: \"¡Rápido!\""

msgid "只见一道黑气罩在$n身上！"
msgstr "¡Un vapor negro {n:te envuelve|envuelve a $n{:el}}!"

msgid "只见一道金光罩在$n身上！"
msgstr "¡Una luz dorada {n:te envuelve|envuelve a $n{:el}}!"

msgid "只见一团火焰罩在$n身上！"
msgstr "¡Una bola de fuego {n:te envuelve|envuelve a $n{:el}}!"

msgid "只听在一声海啸，海水将$n团团围住！"
msgstr "¡Con el rugido de un maremoto, el mar {n:te rodea|rodea a $n{:el}} por completo!"

msgid "只见空中落下无数大木，正把$n困在中央！"
msgstr "¡Del cielo caen innumerables troncos enormes que {n:te encierran|encierran a $n{:el}} en el centro!"

msgid "只见$N化作一道黑气，然后消失得无影无踪！"
msgstr "¡$N{:el} {N:te conviertes|se convierte} en un vapor negro y {N:desapareces|desaparece} sin dejar rastro!"

msgid "只见$N化作一道金光，然后消失得无影无踪！"
msgstr "¡$N{:el} {N:te conviertes|se convierte} en un rayo de luz dorada y {N:desapareces|desaparece} sin dejar rastro!"

msgid "只见$N化作一团火焰，然后消失得无影无踪！"
msgstr "¡$N{:el} {N:te conviertes|se convierte} en una bola de fuego y {N:desapareces|desaparece} sin dejar rastro!"

msgid "只见$N化作一道长虹，然后消失得无影无踪！"
msgstr "¡$N{:el} {N:te conviertes|se convierte} en un largo arcoíris y {N:desapareces|desaparece} sin dejar rastro!"

msgid "只见$N化作一团大雾，然后消失得无影无踪！"
msgstr "¡$N{:el} {N:te conviertes|se convierte} en una gran niebla y {N:desapareces|desaparece} sin dejar rastro!"

msgid "但是$n纵身一跃，脱离了围困。"
msgstr "Pero $n{:el} {n:das|da} un salto y {n:escapas|escapa} del cerco."

msgid "困"
msgstr "Atrapar"

msgid "遁"
msgstr "Esfumarse"

msgid "这个法术只能在战斗中使用！"
msgstr "¡Este hechizo solo puede usarse en combate!"

msgid "$n正自顾不暇，放胆进攻吧。"
msgstr "{n:Tienes|$n{:el} tiene} las manos ocupadas: ataca sin miedo."

msgid "「缺」字诀"
msgstr "Secreto \"Hueco\""

msgid "'缺'字诀只能在战斗中使用。"
msgstr "El secreto \"Hueco\" solo puede usarse en combate."

msgid "你要对谁使用'缺'字诀？"
msgstr "¿Contra quién quieres usar el secreto \"Hueco\"?"

msgid "你已经在运用中了。"
msgstr "Ya lo estás usando."

msgid "$N剑招陡变，空门大开，诱使$n进招，"
msgstr "{N:Tu espada cambia|La espada de $N{:el} cambia} de pronto y deja una gran brecha abierta para {n:atraerte|atraer a $n{:el}} al ataque,"

msgid "可是$n看破了$N的企图，并没有上当。"
msgstr "pero $n{:el} {n:descubres|descubre} {N:tu intención|la intención de $N{:el}} y no {n:caes|cae} en la trampa."

msgid "$N突然对$n发出奋力一击！"
msgstr "¡$N{:el} {N:lanzas|lanza} de pronto un golpe con {N:todas tus fuerzas|todas sus fuerzas} contra {n:ti|$n{:el}}!"

msgid "「玄羽乱舞」"
msgstr "\"Danza salvaje de la pluma oscura\""

msgid "「玄羽乱舞」只能在战斗中使用。"
msgstr "\"Danza salvaje de la pluma oscura\" solo puede usarse en combate."

msgid "你的气不够！"
msgstr "¡No tienes suficiente Qi!"

msgid "你的真气不够！"
msgstr "¡No tienes suficiente Qi verdadero!"

msgid "$N使出步玄七诀第一式「玄羽乱舞」，身法陡然加快！"
msgstr "$N{:el} {N:usas|usa} \"Danza salvaje de la pluma oscura\", la primera de los Siete secretos del Paso Místico, ¡y {N:ganas|gana} velocidad de golpe!"

msgid "$N的身形转了几转，倏地停住了脚步。"
msgstr "$N{:el} {N:giras|gira} unas cuantas veces y {N:te detienes|se detiene} de golpe."

msgid "$N迅捷无伦地在$n身旁绕了一圈 ..."
msgstr "$N{:el} {N:das|da} una vuelta veloz alrededor de {n:ti|$n{:el}}..."

msgid "但是$N找不到机会出手！"
msgstr "¡Pero $N{:el} no {N:encuentras|encuentra} ninguna ocasión de atacar!"

msgid "$N眼睛忽然睁开，喃喃地说道：杀....死....$n...."
msgstr "{N:Tus ojos se abren|Los ojos de $N{:el} se abren} de golpe y {N:murmuras|murmura}: \"Matar... matar... {n:a ti|a $n{:el}}...\""

msgid "你要在这张符上写谁的名字？"
msgstr "¿Qué nombre escribes en este talismán?"

msgid "心识神通"
msgstr "Sentido del corazón"

msgid "$N一手放在$n的天灵盖上，一手贴在$n的後心，闭上眼睛缓缓低吟 ..."
msgstr "$N{:el} {N:apoyas|apoya} una mano en {n:tu coronilla|la coronilla de $n{:el}} y otra en {n:tu espalda|su espalda}, {N:cierras|cierra} los ojos y {N:entonas|entona} un canto bajo..."

msgid "你要对谁使用心识神通？"
msgstr "¿Con quién quieres usar el Sentido del corazón?"

msgid "召护法"
msgstr "Llamar guardián"

msgid "只有战斗中才能召唤天将！"
msgstr "¡Solo puedes invocar a un general celestial en combate!"

msgid "你的精神无法集中！"
msgstr "¡No logras concentrar la mente!"

msgid "$N喃喃地念了几句咒语。"
msgstr "$N{:el} {N:murmuras|murmura} unas palabras de conjuro."

msgid "但是什麽也没有发生。"
msgstr "Pero no ocurre nada."

msgid "( 你上一个动作还没有完成，不能施用外功。)"
msgstr "( Todavía no has terminado lo que hacías; aún no puedes usar una técnica externa. )"

msgid "你请先用 enable 指令选择你要使用的外功。"
msgstr "Elige primero la técnica externa que quieres usar."

msgid "你所使用的外功中没有这种功能。"
msgstr "La técnica externa que usas no puede hacer eso."

msgid "「点」字诀"
msgstr "Secreto \"Punto\""

msgid "「点」字诀只能对战斗中的对手使用。"
msgstr "El secreto \"Punto\" solo funciona contra un rival en combate."

msgid "$N使出封山剑法「点」字诀，可是内力不继，剑尖一颤，手中的剑险些脱手飞出！"
msgstr "$N{:el} {N:usas|usa} el secreto \"Punto\" de la Espada de la Montaña Vacía, ¡pero {N:tu|su} Fuerza interior se agota: la punta de la espada tiembla y el arma casi se escapa de {N:tu|su} mano!"

msgid "$N使出封山剑法「点」字诀，劲力尽数聚在剑尖，一剑直刺$n！"
msgstr "¡$N{:el} {N:usas|usa} el secreto \"Punto\" de la Espada de la Montaña Vacía, {N:reúnes|reúne} toda {N:tu|su} fuerza en la punta de la espada y {N:lanzas|lanza} una estocada directa contra {n:ti|$n{:el}}!"

msgid "用 {force} 点内力把劲力聚在剑尖，这一剑伤得更重；内力不够，剑会险些脱手，白白耽误几手"
msgstr "Con {force} de Fuerza interior reúnes la fuerza en la punta de la espada y la estocada hiere más; si no basta, la espada casi se te escapa de la mano y pierdes algunos turnos en vano"

msgid "召天将"
msgstr "Llamar general celestial"

msgid "战斗时不能画符！"
msgstr "¡No puedes dibujar talismanes en combate!"

msgid "你的精神太差了，无法画符。"
msgstr "Tu Espíritu está demasiado bajo para dibujar un talismán."

msgid "你所学的法术没有这种符。"
msgstr "Los hechizos que has aprendido no incluyen ese talismán."

msgid "紫光"
msgstr "Luz violeta"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团紫光射向$n！"
msgstr "¡$N{:el} {N:murmuras|murmura} un conjuro y {N:agitas|agita} la mano izquierda: en ella se forma una bola de luz violeta que sale disparada hacia {n:ti|$n{:el}}!"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，拖出一条长长的七彩光气，光气绕了回转过来又从$N顶门注入$P的体内！"
msgstr "Con un \"tsss\", la luz violeta atraviesa {n:tu cuerpo|el cuerpo de $n{:el}} y arrastra una larga estela de aliento de siete colores que da la vuelta y entra por la coronilla de {N:ti|$N{:el}}, hasta lo hondo de {N:tu|su} cuerpo."

msgid "结果「嗤」地一声，紫光从$p身上透体而过，无声无息地钻入地下！"
msgstr "Con un \"tsss\", la luz violeta atraviesa {n:tu cuerpo|el cuerpo de $n{:el}} y se hunde en la tierra sin ruido."

msgid "白光"
msgstr "Luz blanca"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团白光射向$n！"
msgstr "¡$N{:el} {N:murmuras|murmura} un conjuro y {N:agitas|agita} la mano izquierda: en ella se forma una bola de luz blanca que sale disparada hacia {n:ti|$n{:el}}!"

msgid "结果「嗤」地一声，白光从$p身上透体而过，拖出一条长长的黑气直射到两三丈外的地下！"
msgstr "Con un \"tsss\", la luz blanca atraviesa {n:tu cuerpo|el cuerpo de $n{:el}} y arrastra una larga estela de vapor negro que se clava en el suelo a dos o tres zhang de distancia."

msgid "结果「嗤」地一声，白光从$p身上透体而过，无声无息地钻入地下！"
msgstr "Con un \"tsss\", la luz blanca atraviesa {n:tu cuerpo|el cuerpo de $n{:el}} y se hunde en la tierra sin ruido."

msgid "青光"
msgstr "Luz azul"

msgid "你失败了！"
msgstr "¡Fallaste!"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团青光射向$n！"
msgstr "¡$N{:el} {N:murmuras|murmura} un conjuro y {N:agitas|agita} la mano izquierda: en ella se forma una bola de luz azul que sale disparada hacia {n:ti|$n{:el}}!"

msgid "结果「嗤」地一声，青光从$p身上透体而过，拖出一条长长的血箭直射到两三丈外的地下！"
msgstr "Con un \"tsss\", la luz azul atraviesa {n:tu cuerpo|el cuerpo de $n{:el}} y arrastra una larga flecha de sangre que se clava en el suelo a dos o tres zhang de distancia."

msgid "结果「嗤」地一声，青光从$p身上透体而过，无声无息地钻入地下！"
msgstr "Con un \"tsss\", la luz azul atraviesa {n:tu cuerpo|el cuerpo de $n{:el}} y se hunde en la tierra sin ruido."

msgid "投降？现在没有人在打你啊....？"
msgstr "¿Rendirte? Nadie está peleando contigo..."

msgid "$n向$N求饶，但是$N大声说道：{rude}废话少说，纳命来！"
msgstr "$n{:el} {n:suplicas|suplica} piedad {N:a ti|a $N{:el}}, pero {N:rugues|$N{:el} ruge}: \"¡Basta de palabras, {rude}! ¡Entrega la vida!\""

msgid "$N说道：「不打了，不打了，我投降....。」"
msgstr "$N{:el} {N:dices|dice}: \"Basta, basta, me rindo...\""

msgid "「逐」字诀"
msgstr "Secreto \"Perseguir\""

msgid "「逐」字诀只能对战斗中的对手使用。"
msgstr "El secreto \"Perseguir\" solo funciona contra un rival en combate."

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p已显吃力。"
msgstr "$N{:el} {N:usas|usa} el secreto \"Perseguir\" de la Espada de la Montaña Vacía: la espada se cierra y su luz cae sobre {n:ti|$n{:el}}, que {n:ya estás|ya está} en apuros."

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p从容化解"
msgstr "$N{:el} {N:usas|usa} el secreto \"Perseguir\" de la Espada de la Montaña Vacía: la espada se cierra y su luz cae sobre {n:ti|$n{:el}}, pero {n:lo desvías|$n{:el} lo desvía} con calma"

msgid "空识神通"
msgstr "Sentido del vacío"

msgid "$N盘膝而座，开始运用空识神通静思入定 ..."
msgstr "$N{:el} {N:te sientas|se sienta} con las piernas cruzadas y {N:empiezas|empieza} a usar el Sentido del vacío, sumido en la quietud..."

msgid "空识神通只能对自己使用。"
msgstr "El Sentido del vacío solo puede usarse sobre ti mismo."

msgid "你觉得脑中一片混乱，你的潜能降低了！"
msgstr "Sientes la mente hecha un caos: ¡tu Potencial baja!"

msgid "你的潜能提高了！"
msgstr "¡Tu Potencial sube!"

msgid "可是你只觉得一无所获。"
msgstr "Pero solo sientes que no has ganado nada."

