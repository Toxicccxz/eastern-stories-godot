msgid "如果你愿意拜%s为师父，就向他拜师。"
msgstr "Si quieres que %s sea tu Shifu, pide ser su discípulo."

msgid "你决定背叛师门，改投入%s门下！！"
msgstr "¡Decides traicionar a tu escuela e irte con %s!"

msgid "你跪了下来向%s恭恭敬敬地磕了四个响头，叫道：「师父！」"
msgstr "Te arrodillas ante %s, golpeas el suelo con la frente cuatro veces con todo respeto y exclamas: \"¡Shifu!\""

msgid "你决定拜%s为师。"
msgstr "Decides tomar a %s como Shifu."

msgid "%s决定收你为弟子。"
msgstr "%s decide aceptarte como discípulo."

msgid "弟子"
msgstr "Discípulo"

msgid "恭喜您成为{family}的第{generation}代弟子。"
msgstr "¡Felicidades! Ahora eres {jugador:discípulo|discípula} de la generación {generation} de {family}{:el}."

msgid "拳脚"
msgstr "Puño"

