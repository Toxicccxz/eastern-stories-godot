msgid "{npc}昏迷不醒，收不了东西。"
msgstr "{npc}{:el} está inconsciente y no puede recibir nada."

msgid "确定{action}吗？"
msgstr "{action}: ¿seguro?"

msgid "确定要拜{npc}为师吗？"
msgstr "¿Seguro que quieres ser discípulo de {npc}{:el}?"

msgid "收徒条件："
msgstr "Condiciones para ser discípulo:"

