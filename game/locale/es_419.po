msgid "$N注视著$n的行动，企图寻找机会出手。"
msgstr "$N{:el} {N:vigilas|vigila} cada movimiento {n:tuyo|de $n{:el}} en busca de una ocasión para atacar."

msgid "$N正盯著$n的一举一动，随时准备发动攻势。"
msgstr "$N{:el} {N:sigues|sigue} con la mirada cada gesto {n:tuyo|de $n{:el}}, {N:listo|lista|listo|lista} para atacar en cualquier momento."

msgid "$N缓缓地移动脚步，想要找出$n的破绽。"
msgstr "$N{:el} {N:mueves|mueve} los pies despacio, buscando un hueco en la guardia {n:tuya|de $n{:el}}."

msgid "$N目不转睛地盯著$n的动作，寻找进攻的最佳时机。"
msgstr "$N{:el} {N:clavas|clava} los ojos en los movimientos {n:tuyos|de $n{:el}}, esperando el mejor momento para atacar."

msgid "$N慢慢地移动著脚步，伺机出手。"
msgstr "$N{:el} {N:mueves|mueve} los pies con lentitud, a la espera de {N:tu|su} ocasión."

msgid "$N哈哈大笑，说道：承让了！"
msgstr "$N{:el} {N:sueltas|suelta} una carcajada: \"¡Gracias por contenerse!\""

msgid "$N双手一拱，笑著说道：承让！"
msgstr "$N{:el} {N:juntas|junta} los puños y {N:dices|dice} con una sonrisa: \"¡Gracias por contenerse!\""

msgid "$N胜了这招，向後跃开三尺，笑道：承让！"
msgstr "$N{:el} {N:ganas|gana} este intercambio, {N:saltas|salta} tres pies hacia atrás y {N:dices|dice}, riendo: \"¡Gracias por contenerse!\""

msgid "$n脸色微变，说道：佩服，佩服！"
msgstr "$n{:el} {n:palideces|palidece} un poco: \"¡Admirable, de veras admirable!\""

msgid "$n向後退了几步，说道：这场比试算我输了，佩服，佩服！"
msgstr "$n{:el} {n:retrocedes|retrocede} unos pasos: \"Este combate es suyo. ¡Admirable, de veras admirable!\""

msgid "$n向後一纵，躬身做揖说道：阁下武艺不凡，果然高明！"
msgstr "$n{:el} {n:saltas|salta} hacia atrás y {n:haces|hace} una reverencia con los puños juntos: \"Su destreza es extraordinaria. ¡Magistral, de verdad!\""

msgid "$N受到$n的内力反震，闷哼一声。"
msgstr "$N{:el} {N:recibes|recibe} el rebote de la fuerza interior {n:tuya|de $n{:el}} y {N:ahogas|ahoga} un gemido."

msgid "$N被$n以内力反震，「嘿」地一声退了两步。"
msgstr "$N{:el} {N:recibes|recibe} el rebote de la fuerza interior {n:tuya|de $n{:el}} y, con un \"¡Jm!\", {N:retrocedes|retrocede} dos pasos."

msgid "$N被$n以内力一震，胸口有如受到一记重击，连退了五六步！"
msgstr "$N{:el} {N:recibes|recibe} la sacudida de la fuerza interior {n:tuya|de $n{:el}}: es como un mazazo en el pecho, ¡y {N:retrocedes|retrocede} cinco o seis pasos!"

msgid "$N被$n的内力一震，眼前一黑，身子向後飞出丈许！！"
msgstr "$N{:el} {N:recibes|recibe} de lleno la fuerza interior {n:tuya|de $n{:el}}: todo se vuelve negro, ¡¡y {N:sales|sale} volando un zhang hacia atrás!!"

msgid "$N一击不中，露出了破绽！"
msgstr "¡$N{:el} {N:fallas|falla} el golpe y {N:dejas|deja} la guardia abierta!"

msgid "$N见$n攻击失误，趁机发动攻击！"
msgstr "¡$N{:el} {N:aprovechas|aprovecha} el fallo {n:tuyo|de $n{:el}} para atacar!"

msgid "结果没有造成任何伤害。"
msgstr "No causa daño alguno."

msgid "擦伤"
msgstr "rasguño"

msgid "割伤"
msgstr "corte"

msgid "结果只是轻轻地划破$p的皮肉。"
msgstr "Apenas {n:te|le} rasga la piel."

msgid "结果在$p$l划出一道细长的血痕。"
msgstr "Deja una línea de sangre larga y fina en {n:tu|su} $l{:0}."

msgid "结果「嗤」地一声划出一道伤口！"
msgstr "¡Zas! ¡Abre una herida!"

msgid "结果「嗤」地一声划出一道血淋淋的伤口！"
msgstr "¡Zas! ¡Abre una herida sangrante!"

msgid "结果「嗤」地一声划出一道又长又深的伤口，溅得$N满脸鲜血！"
msgstr "¡Zas! ¡Abre una herida larga y profunda, y la sangre {N:te salpica toda la cara|le salpica toda la cara a $N{:el}}!"

msgid "结果只听见$n一声惨嚎，$w已在$p$l划出一道深及见骨的可怕伤口！！"
msgstr "¡¡$n{:el} {n:sueltas|suelta} un alarido: $w{:el} abre en {n:tu|su} $l{:0} una herida espantosa que llega al hueso!!"

msgid "结果只是轻轻地刺破$p的皮肉。"
msgstr "Apenas {n:te|le} pincha la piel."

msgid "结果在$p$l刺出一个创口。"
msgstr "Deja una herida punzante en {n:tu|su} $l{:0}."

msgid "结果「噗」地一声刺入了$n$l寸许！"
msgstr "¡Pum! {n:Se te clava|A $n{:el} se le clava} una pulgada en {n:tu|su} $l{:0}."

msgid "结果「噗」地一声刺进$n的$l，使$p不由自主地退了几步！"
msgstr "¡Pum! ¡Se clava en {n:tu|su} $l{:0} y {n:te obliga|obliga a $n{:el}} a retroceder unos pasos!"

msgid "结果「噗嗤」地一声，$w已在$p$l刺出一个血肉模糊的血窟窿！"
msgstr "¡Chas! ¡$w{:el} abre un boquete sangriento en {n:tu|su} $l{:0}!"

msgid "结果只听见$n一声惨嚎，$w已在$p的$l对穿而出，鲜血溅得满地！！"
msgstr "¡¡$n{:el} {n:sueltas|suelta} un alarido: $w{:el} atraviesa {n:tu|su} $l{:0} de lado a lado y la sangre lo salpica todo!!"

msgid "结果只是轻轻地碰到，比拍苍蝇稍微重了点。"
msgstr "Apenas roza; un poco más fuerte que espantar una mosca."

msgid "结果在$p的$l造成一处瘀青。"
msgstr "Deja un moretón en {n:tu|su} $l{:0}."

msgid "结果一击命中，$n的$l登时肿了一块老高！"
msgstr "¡Golpe certero! {n:Se te hincha|A $n{:el} se le hincha} al instante {n:tu|su} $l{:0}."

msgid "结果一击命中，$n闷哼了一声显然吃了不小的亏！"
msgstr "¡Golpe certero! $n{:el} {n:ahogas|ahoga} un gemido; está claro que {n:te|le} dolió."

msgid "结果「砰」地一声，$n退了两步！"
msgstr "¡Pum! ¡$n{:el} {n:retrocedes|retrocede} dos pasos!"

msgid "菜单"
msgstr "Menú"

msgid "草往哪边倒，风就往哪边吹。"
msgstr "Hacia donde se inclina la hierba, hacia allá sopla el viento."

msgid "目标"
msgstr "Objetivo"

msgid "交互"
msgstr "Interactuar"

msgid "查看"
msgstr "Mirar"

msgid "打听"
msgstr "Preguntar"

msgid "通行"
msgstr "Pasar"

msgid "拾取"
msgstr "Recoger"

msgid "偷窃"
msgstr "Robar"

msgid "行贿"
msgstr "Sobornar"

msgid "返回"
msgstr "Volver"

msgid "东方故事"
msgstr "Historias de Oriente"

msgid "跪下受戒就是剃度出家：{npc}会剃去你的头发，你从此是僧人。\n你的名字会改成法名：「{prefixes}」中随机一字，加上你名字的第一个字「{first}」（例如「{example}」），原来的名字从此不再使用。\n确定要跪下受戒吗？"
msgstr "Arrodillarte para recibir los preceptos es tomar la tonsura: {npc}{:el} te rapará la cabeza y desde entonces serás {jugador:monje|monja}.\nTu nombre pasará a ser un nombre del dharma: un carácter al azar de \"{prefixes}\", más el primer carácter de tu nombre, \"{first}\" (por ejemplo, \"{example}\"). Tu nombre de antes no se usará nunca más.\n¿Quieres arrodillarte para recibir los preceptos?"

msgid "你可以打听这些事情："
msgstr "Puedes preguntar por esto:"

msgid "告辞"
msgstr "Despedirse"

msgid "接话：{line}"
msgstr "Responder: {line}"

msgid "打听 · %s"
msgstr "Preguntar · %s"

msgid "问"
msgstr "Preguntar"

msgid "确定受戒"
msgstr "Arrodillarse"

msgid "当前 {current} / 有效 {effective} / 最大 {maximum}"
msgstr "Actual {current} / Efectivo {effective} / Máximo {maximum}"

msgid "建议：{next}"
msgstr "Consejo: {next}"

msgid "切至左侧"
msgstr "Vista izquierda"

msgid "切换左侧与右侧 45° 固定视角"
msgstr "Alternar entre las vistas fijas de 45° izquierda y derecha"

msgid "切至右侧"
msgstr "Vista derecha"

msgid "雪亭镇"
msgstr "Pabellón Nevado"

msgid "封山剑派"
msgstr "Escuela de la Montaña Vacía"

msgid "柳淳风"
msgstr "Liu Chunfeng"

msgid "风雨双侠"
msgstr "Espadachín del Viento y la Lluvia"

msgid "柳馆主"
msgstr "maestro Liu"

msgid "掌门人"
msgstr "Maestro"

msgid "书在匣里。年轻时的糊涂话，留着给自己看。"
msgstr "El libro está en el cofre. Desatinos de juventud; los guardo para mí."

msgid "书在绘心那里。……她读得比我当年明白。"
msgstr "El libro lo tiene Huixin. ...Ella lo lee mejor de lo que yo lo leía entonces."

msgid "竹林道尽头那块大黄石，照我教你的法子推。书取出来，带回来。"
msgstr "La gran roca amarilla al final del Sendero del Bambú: empújala como te enseñé. Saca el libro y tráelo."

msgid "看着窗外的竹影，半晌才开口。"
msgstr " se queda mirando las sombras del bambú tras la ventana y tarda un buen rato en hablar."

msgid "二十岁那年，我在天驼关的竹林里住过一冬，悟出一点架剑的道理，写成一卷，起名《悟疾风劲竹书》，留在竹林尽头的石室里。"
msgstr "El año en que cumplí veinte pasé un invierno en el bosque de bambú del Paso del Camello; entendí un poco cómo se sostiene una espada, lo escribí en un rollo, lo llamé «Bambú contra el vendaval» y lo dejé en la cámara de piedra al fondo del bosque."

msgid "石室的口子有一块大黄石堵着。硬推，没有几十年的内力推不动——我当年也推不动。"
msgstr "Una gran roca amarilla tapa la boca de la cámara. Empujándola a lo bruto, sin décadas de fuerza interior no se mueve; yo tampoco pude moverla entonces."

msgid "那块石头不是那样推的。贴着它左下角那道青苔印，肩抵住，脚蹬石根；等风过竹林、石头自己松那一下，再发力。竹子是这么弯的，石头也是这么开的。"
msgstr "Esa piedra no se empuja así. Apoya el hombro en la marca de musgo de su esquina inferior izquierda y afirma los pies en la base; espera a que el viento pase por el bambú y la piedra ceda un poco por sí sola, y entonces empuja. Así se dobla el bambú, y así se abre la piedra."

msgid "书只有那一本。你替我取出来。"
msgstr "Ese libro es el único que hay. Sácalo por mí."

msgid "一卷旧书罢了。"
msgstr "No es más que un libro viejo."

msgid "本宗的规矩，从今往后是你我两个人守。"
msgstr "Desde hoy, las reglas de nuestra rama las guardamos dos: tú y yo."

msgid "你选了。武馆的门不拦你——只是剑，我不能再教了。"
msgstr "Elegiste. La puerta del salón no se te cierra; solo que la espada ya no te la puedo enseñar."

msgid "点了点头，像是早知道，又像是松了一口气。"
msgstr " asiente, como si lo hubiera sabido desde siempre, o como si se quitara un peso de encima."

msgid "好。那从今日起，「点」字诀归你。"
msgstr "Bien. Entonces, desde hoy, la técnica del 'Punto' es tuya."

msgid "平时使剑，内力聚在手臂上；「点」字诀把劲力聚在剑尖，以意使剑。刺出去的那一下，比你现在重得多——内力不够的时候别使，剑会脱手。"
msgstr "Cuando usas la espada, la fuerza interior se reúne en el brazo; la técnica del 'Punto' la reúne en la punta, y es la mente la que mueve la espada. Esa estocada pega mucho más fuerte que todo lo que tienes ahora; no la uses cuando te falte fuerza interior, o la espada se te escapará de la mano."

msgid "拔出玄苏剑，剑尖在你面前的青砖上轻轻一点。砖没有裂，砖下的土陷下去一个指头深的坑。"
msgstr " desenvaina la espada Xuansu y roza con la punta la baldosa azul que tienes delante. La baldosa no se agrieta; la tierra de debajo se hunde un dedo de hondo."

msgid "封山这一辈，掌门的剑往后传给你。"
msgstr "En esta generación de la Montaña Vacía, la espada del Maestro pasa a ti."

msgid "绘心……她要走，我不拦。"
msgstr "Huixin... Si quiere irse, no la detendré."

msgid "封山剑派只有一宗。"
msgstr "La Escuela de la Montaña Vacía tiene una sola rama."

msgid "劲在剑尖，意在剑先。内力不够的时候别使。"
msgstr "La fuerza en la punta, la mente por delante de la espada. No la uses cuando te falte fuerza interior."

msgid "绘心自己悟的那一路，劲发得早了半分。你替我告诉她——不，不必说是我说的。"
msgstr "El camino que Huixin descubrió sola suelta la fuerza un pelo antes de tiempo. Díselo de mi parte... no, no hace falta que digas que lo dije yo."

msgid "「点」字诀是掌门一脉单传的。"
msgstr "La técnica del 'Punto' solo pasa de Maestro a heredero, de uno en uno."

msgid "镇上清净了。门户的名头不是谁都能借的——这一回，是你替武馆拿回来的。"
msgstr "El pueblo está tranquilo otra vez. No cualquiera puede tomar prestado el nombre de la escuela; esta vez fuiste tú quien se lo devolvió al salón."

msgid "镇西官道上那几个人，你去会一会。先看清他们凭的是什么，再动手。"
msgstr "Esos hombres del camino real al oeste del pueblo: ve a verlos. Primero mira en qué se apoyan; después actúa."

msgid "放下手里的茶，看了你一眼。"
msgstr " deja su té y te echa una mirada."

msgid "既入了门，武馆的事你也该担一件。"
msgstr "Ya que entraste en la escuela, también te toca cargar con un asunto del salón."

msgid "这几日有来投师的人说，在镇西的青石官道上交过「拜师钱」——十两银子，收钱的自称封山弟子。淳风武馆收徒，从来不收这个钱。"
msgstr "Estos días, algunos que vinieron a pedir ingreso dicen que pagaron una 'cuota de ingreso' en el Camino real de piedra azul, al oeste del pueblo: diez taels de plata, a unos que se decían discípulos de la Montaña Vacía. El Salón del Viento Puro jamás cobró ese dinero a quien acepta como discípulo."

msgid "我不便去。掌门出手打几个骗子，传出去是笑话。你是新面孔，他们不认得你——去看看他们凭的是什么。"
msgstr "No me conviene ir. Un Maestro que sale a golpear a unos estafadores sería el hazmerreír. Tú eres una cara nueva; no te conocen. Ve a ver en qué se apoyan."

msgid "武馆自家的事，不劳外人费心。"
msgstr "Los asuntos del salón son cosa nuestra; no hace falta que los de fuera se molesten."

msgid "牌我收着。逄师弟什么时候自己来取，什么时候还他。"
msgstr "La placa la guardo yo. Cuando el hermano Pang venga a buscarla él mismo, se la devolveré."

msgid "他认了就好。牌给我吧。"
msgstr "Si lo reconoció, basta. Dame la placa."

msgid "牌没带回来？……丢了也好，省得再有人拿它骗人。"
msgstr "¿No trajiste la placa? ...Quizá es mejor que se haya perdido; así nadie más la usará para engañar."

msgid "门户的名头，不是谁都能借的。这件事你办得干净——从今日起，你是这一辈的大弟子。"
msgstr "No cualquiera puede tomar prestado el nombre de la escuela. Resolviste esto con limpieza; desde hoy eres {jugador:el discípulo mayor|la discípula mayor} de tu generación."

msgid "还有一件事，李教头会同你说。"
msgstr "Queda un asunto más; el instructor Li te lo dirá."

msgid "接过腰牌翻过来，看见背面那个字，半晌没有说话。"
msgstr " toma la placa, le da la vuelta y, al ver el carácter del reverso, se queda un buen rato sin hablar."

msgid "逄……是逄义师弟的牌。同辈里他的剑不比我差，只是好赌。"
msgstr "Pang... Es la placa de mi hermano menor Pang Yi. En nuestra generación su espada no era peor que la mía; solo que le gustaba demasiado el juego."

msgid "牌是真的，人是假的——那就是牌从他手里流出去了。他这些年多半泡在绮云镇的赌场里。"
msgstr "La placa es auténtica; el hombre, no. Así que la placa salió de sus manos. Estos años seguro que ha vivido metido en las casas de apuestas de Tejenubes."

msgid "你去问他一句：牌是怎么到外人手里的。问明白了，再把牌带回来。"
msgstr "Ve y hazle una sola pregunta: cómo llegó la placa a manos de un extraño. Cuando lo tengas claro, trae la placa de vuelta."

msgid "把腰牌递还给你。"
msgstr " te devuelve la placa."

msgid "封山弟子人人有一块腰牌，正面一座山，背面是自己的姓。你的那块，等你的剑入了门再说。"
msgstr "Todo discípulo de la Montaña Vacía tiene una placa: una montaña en el anverso y su apellido en el reverso. La tuya, ya veremos cuando tu espada esté a la altura de la escuela."

msgid "他肯认，就还是封山的人。"
msgstr "Si lo reconoce, sigue siendo de la Montaña Vacía."

msgid "逄师弟与我同辈，剑上的天分不在我之下。……好赌，多年不回武馆了。"
msgstr "El hermano Pang es de mi generación; su talento con la espada no era menor que el mío. ...Le gusta el juego; hace años que no vuelve al salón."

msgid "淳风武馆是先父所创，在下辱承其名，虽忝掌封山门户，不敢忘了先人遗志。"
msgstr "El Salón del Viento Puro lo fundó mi difunto padre. Indigno de llevar su nombre y sin méritos para estar al frente de la Escuela de la Montaña Vacía, no me atrevo a olvidar la voluntad de nuestros mayores."

msgid "先父临终之时将这武馆交到在下手中，需得好好照看。"
msgstr "En su lecho de muerte, mi difunto padre puso este salón en mis manos; debo cuidarlo bien."

msgid "刘兄弟在寒舍管事已经五年了，过去之事不须再提。"
msgstr "El hermano Liu lleva cinco años a cargo de mi humilde casa. Lo pasado no hace falta volver a mencionarlo."

msgid "你既然知道我是柳馆主，怎麽不知道我是柳淳风？"
msgstr "Si sabes que soy el maestro Liu, ¿cómo no sabes que soy Liu Chunfeng?"

msgid "这里便是淳风武馆。"
msgstr "Este es el Salón del Viento Puro."

msgid "听说大内的人在黄石隘口挖出了东西，又被人抢了去。抢东西的若是往老松岭去了，多半是投老松寨。"
msgstr "Dicen que la gente del Palacio Imperial desenterró algo en el Desfiladero de Piedra Amarilla y que se lo arrebataron. Si el ladrón fue hacia el Cerro de los Pinos Viejos, lo más seguro es que fuera a unirse al Fuerte de los Pinos Viejos."

msgid "正纷扰间，一匹快马冲进了广场，两名老者立即站了起来。"
msgstr "En medio del alboroto, un caballo veloz irrumpió en la plaza, y los dos ancianos se pusieron de pie al instante."

msgid "不料一名老者忽然说道：「大声点，让众位兄弟都听见了。」"
msgstr "Pero uno de los ancianos dijo de pronto: \"Más alto, que lo oigan todos los hermanos.\""

msgid "那人一怔，随即大声说道：「方位是在西南二十四里，黄石隘口。」"
msgstr "El jinete se quedó un instante cortado y luego dijo en voz alta: \"La dirección es veinticuatro li al suroeste: el Desfiladero de Piedra Amarilla.\""

msgid "时间是天朝佑圣元年，岁次甲子，年仅十六岁的皇帝刚刚登基，雪亭镇上熙来攘往，一队身著白衣的朝廷武官和两名老者在镇前的广场中坐著，四面来来往往的人当中，有不少显然是武林中人，正探头探脑地向著广场张望。"
msgstr "Era el primer año de la era Yousheng de la Dinastía Celestial, año jiazi del ciclo. El emperador, de solo dieciséis años, acababa de subir al trono. El pueblo de Pabellón Nevado bullía de gente; en la plaza a la entrada del pueblo estaban sentados una tropa de oficiales de la corte vestidos de blanco y dos ancianos. Entre los que iban y venían, no pocos eran a todas luces gente del wulin, y estiraban el cuello hacia la plaza."

msgid "马上乘客一跃而下，快步走到老者身前，躬身说道：「禀将军，时辰已到，白道长命下官回禀，方位是在....」，说著压低了声音。"
msgstr "El jinete saltó del caballo, se acercó a paso rápido a los ancianos y dijo con una reverencia: \"Mi general, ha llegado la hora. El taoísta Bai me manda informar que la dirección es...\" Y aquí bajó la voz."

msgid "广场西边一家小客栈里，一个年约十四岁的少年问店里的小二道：「这些人神秘得紧，却不知到底在玩什麽把戏？」"
msgstr "En una pequeña posada al oeste de la plaza, {jugador:un muchacho|una muchacha} de unos catorce años le preguntó al mozo: \"Esta gente es de lo más misteriosa. ¿Qué andarán tramando?\""

msgid "小二抄起脖子上的毛巾，抹了抹脸，说道：「小哥您有所不知，这些个爷儿们可是大内来的高手，这次是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的，那骑马的官爷所称的白道长，便是咱们这附近有名的太乙观观主....」"
msgstr "El mozo se quitó la toalla del cuello, se secó la cara y dijo: \"Usted no lo sabe, joven: estos señores son maestros venidos del mismísimo Palacio Imperial. Vienen por orden de nuestro emperador a buscar en la Ciudad del Viento una espada que llaman 'Filo Giratorio'. Y el taoísta Bai que nombró el señor del caballo es el abad del Monasterio Taiyi, muy famoso por estos rumbos...\""

msgid "少年奇道：「岚城？那是什麽地方？怎麽我从小到大不曾听过有这个地方？」"
msgstr "{jugador:El muchacho|La muchacha} se extrañó: \"¿La Ciudad del Viento? ¿Qué lugar es ese? ¿Cómo es que en toda mi vida nunca oí hablar de él?\""

msgid "少年听著出了神，怔怔地望著外面的天空，一朵朵的浮云飘来飘去，他的心思也不由自主地飞了起来。"
msgstr "{jugador:El muchacho|La muchacha} escuchaba sin pestañear, con la vista perdida en el cielo de fuera. Las nubes pasaban una tras otra, y sus pensamientos echaron a volar con ellas."

msgid "那少年，便是你。"
msgstr "{jugador:Ese muchacho|Esa muchacha} eras tú."

msgid "寻剑令"
msgstr "Edicto de la Espada"

msgid "大内高手在找一把剑。去西南二十四里的黄石隘口，看他们找什么。"
msgstr "Los maestros del Palacio Imperial buscan una espada. Ve al Desfiladero de Piedra Amarilla, veinticuatro li al suroeste, y mira qué buscan."

msgid "在黄石隘口看着官队挖出石匣、又被黑衣道士抢走"
msgstr "Viste en el Desfiladero de Piedra Amarilla cómo los oficiales desenterraban un cofre de piedra y un taoísta de negro se lo arrebataba"

msgid "跟店小二打听广场上的「官爷」。"
msgstr "Preguntar al mozo de la posada por los \"Oficiales\" de la plaza."

msgid "店小二说外头广场上来了大内的官爷，叫你去瞧瞧。"
msgstr "El mozo de la posada te contó que a la plaza habían llegado oficiales del Palacio Imperial y te dijo que fueras a echar un vistazo."

msgid "去镇前的广场，看看官爷们在做什么。"
msgstr "Ir a la plaza a la entrada del pueblo y ver qué hacen los oficiales."

msgid "冯策叫信使大声报了方位：西南二十四里，黄石隘口。"
msgstr "Feng Ce hizo que el mensajero anunciara en voz alta la dirección: veinticuatro li al suroeste, el Desfiladero de Piedra Amarilla."

msgid "在广场上当面向大内的总教头问了寻剑的事"
msgstr "Preguntaste cara a cara, en la plaza, al instructor jefe del Palacio Imperial por la búsqueda de la espada"

msgid "围观的江湖客悄悄告诉你：官爷们要去西南二十四里的黄石隘口。"
msgstr "Un andariego entre los curiosos te dijo en voz baja que los oficiales iban al Desfiladero de Piedra Amarilla, veinticuatro li al suroeste."

msgid "在广场上向围观的江湖人打听了官队的去处"
msgstr "Preguntaste a la gente del jianghu en la plaza adónde iba la comitiva oficial"

msgid "去西南二十四里的黄石隘口，看他们找什么。"
msgstr "Ir al Desfiladero de Piedra Amarilla, veinticuatro li al suroeste, y ver qué buscan."

msgid "你到了黄石隘口。官队正在山壁下挖土，白道长守在坑边。"
msgstr "Llegaste al Desfiladero de Piedra Amarilla. Los oficiales cavaban al pie del paredón y el taoísta Bai vigilaba junto al hoyo."

msgid "看官队在山壁下挖什么。"
msgstr "Ver qué desentierran los oficiales al pie del paredón."

msgid "官队挖出一只刻着风纹的石匣；一个黑衣黑冠的道士从崖上掠下，抢了匣子就逃，掉下一块布条。白道长说匣里是岚城的风铃。"
msgstr "Los oficiales desenterraron un cofre de piedra con grabados de viento; un taoísta de túnica y gorro negros bajó del risco en un vuelo, agarró el cofre y huyó, y se le cayó una tira de tela. El taoísta Bai dijo que en el cofre estaban las campanillas de viento de la Ciudad del Viento."

msgid "拾起黑衣道士掉下的布条。"
msgstr "Recoger la tira de tela que se le cayó al taoísta de negro."

msgid "布条上刻着老松寨的记号：黑衣道士往老松岭去了。"
msgstr "La tira de tela llevaba la marca del Fuerte de los Pinos Viejos: el taoísta de negro se fue hacia el Cerro de los Pinos Viejos."

msgid "店小二"
msgstr "Mozo de la posada"

msgid "小二哥"
msgstr "mozo"

msgid "笑咪咪地说道：这位$RESPECT，进来喝杯茶，歇歇腿吧。"
msgstr " dice con una sonrisa de oreja a oreja: \"Pase, $RESPECT, tómese una taza de té y descanse las piernas.\""

msgid "用脖子上的毛巾抹了抹手，说道：这位$RESPECT，请进请进。"
msgstr " se limpia las manos con la toalla del cuello: \"¡Pase, pase, $RESPECT!\""

msgid "这位$RESPECT，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。"
msgstr "¡Pase, $RESPECT, y tómese unas copitas del vino tinto de la casa! Lo destapamos en la bodega hace apenas unos días."

msgid "鸡腿骨头别扔，东街那两条野狗见了骨头就跟人走，怪得很。"
msgstr "No tire los huesos de pollo. Esos dos perros salvajes de la calle del Este siguen a cualquiera que lleve un hueso; es de lo más raro."

msgid "哟，可算清净了！来，刚烤好的鸡腿，小店的一点心意。"
msgstr "¡Uy, por fin hay paz! Tenga, un muslo de pollo recién asado: cortesía de la casa."

msgid "唉，别提了。楼上几间客房闹老鼠，客人嫌吵，掌柜的又舍不得请人。这位$RESPECT要是肯上去收拾收拾，小店请您吃顿热的。"
msgstr "Ay, ni me lo recuerde. En las habitaciones de arriba hay ratas; los huéspedes se quejan del ruido y el patrón no quiere gastar en contratar a nadie. Si usted quisiera subir a limpiar aquello, $RESPECT, la casa le paga una comida caliente."

msgid "多亏了您！……他们把您楼上那屋翻了个底朝天，问那只匣子问了三遍，小的说不知道。"
msgstr "¡Gracias a usted! ...Revolvieron de arriba abajo su cuarto de arriba y preguntaron tres veces por aquel cofre. Yo les dije que no sabía nada."

msgid "掌柜的说了：楼上那间屋给您留着，往后不收钱。您是咱们雪亭的人。"
msgstr "El patrón lo dijo: el cuarto de arriba queda reservado para usted, y de ahora en adelante sin cobrarle. Usted es de los nuestros, de Pabellón Nevado."

msgid "捂着青了半边的脸，压低了声音。"
msgstr " se tapa la mitad amoratada de la cara y baja la voz."

msgid "两个白衣的官爷，拿着一张画像，说您是什么逆灵宫的同党……就在里头翻呢！掌柜的拦了一下，挨了一脚。"
msgstr "Dos oficiales de blanco, con un retrato, diciendo que usted es cómplice de un tal Palacio Negro... ¡Están revolviéndolo todo ahí dentro! El patrón quiso detenerlos y se llevó una patada."

msgid "白衣人？前些日子广场上那队官爷，都是穿白的。"
msgstr "¿Hombres de blanco? La tropa de oficiales que estuvo en la plaza hace unos días iba toda de blanco."

msgid "外头广场上来了官爷，一队白衣的武官，还有两位老者坐着，说是大内来的高手。这位$RESPECT要是闲，去瞧瞧热闹也好。"
msgstr "Allá afuera, en la plaza, llegaron unos oficiales: una tropa de oficiales vestidos de blanco y dos ancianos sentados con ellos; dicen que son maestros del Palacio Imperial. Si tiene tiempo, $RESPECT, vaya a ver el espectáculo."

msgid "小哥您有所不知，这些个爷儿们是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的。他们等的白道长，便是咱们这附近有名的太乙观观主。"
msgstr "Usted no lo sabe, joven: estos señores vienen por orden de nuestro emperador a buscar en la Ciudad del Viento una espada que llaman 'Filo Giratorio'. El taoísta Bai al que esperan es el abad del Monasterio Taiyi, muy famoso por estos rumbos."

msgid "$RESPECT，您来的那天傍晚说是来投淳风武馆的，饭没吃完就困得睁不开眼，是小的扶您上的楼。这封信落在桌上了，小的一直替您收着呢。"
msgstr "La tarde que llegó, $RESPECT, dijo que venía a ingresar en el Salón del Viento Puro, y antes de terminar de cenar ya no podía con el sueño; fui yo quien le dio el brazo para subir la escalera. Esta carta se le quedó en la mesa, y yo se la estuve guardando."

msgid "从柜台底下摸出一封折了又折的信，递给你。"
msgstr " saca de debajo del mostrador una carta doblada y redoblada y te la entrega."

msgid "对了，外头广场上来了官爷，一队白衣的武官，还有两位老者坐着，说是大内来的高手。$RESPECT要是闲，去瞧瞧热闹也好。"
msgstr "Por cierto, allá afuera, en la plaza, llegaron unos oficiales: una tropa de oficiales vestidos de blanco y dos ancianos sentados con ellos; dicen que son maestros del Palacio Imperial. Si tiene tiempo, $RESPECT, vaya a ver el espectáculo."

msgid "这些个爷儿们是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的。他们等的白道长，便是咱们这附近有名的太乙观观主。"
msgstr "Estos señores vienen por orden de nuestro emperador a buscar en la Ciudad del Viento una espada que llaman 'Filo Giratorio'. El taoísta Bai al que esperan es el abad del Monasterio Taiyi, muy famoso por estos rumbos."

msgid "请柬早给您了。正月十七，水烟阁外头的虹台——您可别忘了。"
msgstr "La invitación ya se la di. El diecisiete del primer mes, en la Terraza del Arcoíris, frente al Pabellón de la Neblina; no se le vaya a olvidar."

msgid "哟，您可回来了！前两天水烟阁差人送来一张帖子，指名道姓给您的。"
msgstr "¡Vaya, por fin volvió! Hace un par de días el Pabellón de la Neblina mandó a alguien con una invitación, con su nombre y apellido."

msgid "从柜台底下摸出一张大红帖子，在围裙上擦了擦手，双手递给你。"
msgstr " saca de debajo del mostrador una gran tarjeta roja, se limpia las manos en el delantal y te la ofrece con las dos manos."

msgid "请柬？没有您的信啊。"
msgstr "¿Una invitación? No llegó nada para usted."

msgid "看见你进门，眼睛一亮，从柜台后头钻了出来。"
msgstr " te ve entrar, se le iluminan los ojos y sale disparado de detrás del mostrador."

msgid "$RESPECT，您可回来了！前两天水烟阁差人送来一张帖子，指名道姓给您的。"
msgstr "¡Por fin volvió, $RESPECT! Hace un par de días el Pabellón de la Neblina mandó a alguien con una invitación, con su nombre y apellido."

msgid "正月十七，水烟阁外头的虹台，九派选盟主——小的长这么大，还没见过咱们雪亭的人拿这种帖子。"
msgstr "El diecisiete del primer mes, en la Terraza del Arcoíris, frente al Pabellón de la Neblina, las nueve escuelas eligen al líder de la alianza. En toda mi vida nunca vi a nadie de Pabellón Nevado recibir una invitación así."

msgid "你现在正站在雪亭镇南边的一家小客栈里，这家客栈虽小，却是方圆\n五百里内最负盛名的一家，客栈的主人据说是一位云游四海的仙人，如果\n你的福缘深厚的话，也许可以在这里遇到他。除此之外，来自各地的旅人\n都喜欢聚集在这里交换旅途上的见闻，你也可以在这里打听到许多有趣的\n消息。靠近门口的地方有一块乌木雕成的招牌。\n西北边有一个红木门，门上泛著一层白色的光晕，一种令人感觉\n很有力量，又很柔和的光芒。\n"
msgstr "Estás en una pequeña posada del sur de Pabellón Nevado. Aunque pequeña, es la más famosa en quinientos li a la redonda; dicen que su dueño es un inmortal que recorre los cuatro mares, y si tu Fortuna es grande, quizá te lo encuentres aquí. Además, viajeros de todas partes se reúnen aquí para contarse lo que vieron en el camino, así que también puedes enterarte de muchas noticias interesantes. Cerca de la puerta hay un letrero tallado en ébano. Al noroeste hay una puerta de caoba que despide un halo de luz blanca, un resplandor que se siente muy poderoso y a la vez muy suave."

msgid "这里是雪亭镇镇前广场的空地，地上整齐地铺著大石板。广场中央有\n一个木头搭的架子，经过多年的风吹日晒雨淋，看来非常破旧。四周建筑\n林立。往西你可以看到一间客栈，看来生意似乎很好。\n"
msgstr "Esta es la explanada de la plaza a la entrada de Pabellón Nevado, pavimentada con grandes losas bien alineadas. En el centro de la plaza hay un armazón de madera que, tras muchos años de viento, sol y lluvia, se ve muy deteriorado. Alrededor se apiñan los edificios. Al oeste ves una posada que parece tener mucha clientela."

msgid "你现在正走在雪亭镇的街道上，东边不远处有一间高大的院子，门\n口立著一根粗大的旗杆，旗子上写著「淳风武馆」，往南只听得人声鼎\n沸，是个五十尺见方的广场，人来人往相当热闹。往北可望见一座牌坊\n，年代久远，上面的字迹早已看不出是什么字，出了牌坊就是镇外。\n"
msgstr "Caminas por una calle de Pabellón Nevado. No lejos, al este, hay un recinto alto; ante su puerta se alza un asta gruesa, y en la bandera se lee \"Salón del Viento Puro\". Al sur se oye el bullicio de la gente: es una plaza de cincuenta pies por lado, muy animada por el ir y venir. Al norte se ve un arco conmemorativo, tan antiguo que hace mucho que ya no se distingue qué dicen sus letras; pasado el arco quedan las afueras del pueblo."

msgid "你现在正站在一间大宅院的入口，两只巨大的石狮镇守在大门的两\n侧，一阵阵吆喝与刀剑碰撞的声音从院子中传来。通过红漆大门\n往东可以望见许多身穿灰衣的汉子正在操练。\n"
msgstr "Estás a la entrada de un gran recinto. Dos enormes leones de piedra custodian los lados del portón, y desde el patio llegan gritos y el choque de sables y espadas. Por el portón lacado en rojo, al este, ves a muchos hombres vestidos de gris entrenando."

msgid "你现在正站在一个宽敞的教练场中，地上铺著黄色的细砂，许多人\n正在这里努力地操练著，北边是一间高大的兵器厅，往东则是武馆师父\n们休息的大厅。\n"
msgstr "Estás en un amplio campo de entrenamiento cubierto de arena fina y amarilla, donde mucha gente se ejercita con empeño. Al norte hay una alta sala de armas, y al este, la sala donde descansan los maestros del salón."

msgid "这里是淳风武馆的正厅，五张太师椅一字排开面对著门口，这是武\n馆中四位大师傅与馆主柳淳风的座位，和一般武馆不同的是，墙上竟然\n挂著几幅风骨颇为不俗的书画，显示这里的主人并非大字不识的粗汉，\n而是文武双全的高人。\n"
msgstr "Esta es la sala principal del Salón del Viento Puro. Cinco sillones de madera, alineados en fila, miran hacia la puerta: son los asientos de los cuatro grandes maestros y del maestro del salón, Liu Chunfeng. A diferencia de otros salones de artes marciales, de las paredes cuelgan algunas pinturas y caligrafías de notable carácter, prueba de que el dueño de la casa no es un bruto iletrado, sino un hombre de letras y de armas."

msgid "饮风客栈二楼"
msgstr "Posada Bebeviento, piso de arriba"

msgid "你现在来到了饮风客栈的二楼，这家客栈有个很奇怪的规矩，就是只留宿\n名头够大的客人，如果你只是一个无名小卒，不论出再多银两都租不到一间空\n房，墙边有一道楼梯通往一楼的茶座。\n"
msgstr "Llegas al segundo piso de la Posada Bebeviento. La posada tiene una regla muy curiosa: solo aloja a huéspedes de nombre lo bastante grande; si eres un don nadie, por mucha plata que ofrezcas no conseguirás una habitación libre. Junto a la pared, una escalera baja al salón de té de la planta baja."

msgid "这是一间打扫得相当乾净的客房，虽然所有的家俱看起来都相当朴\n素，比不上县城里几家著名的大酒馆，但是自有一种敦厚亲切的感觉，\n你在这里相信可以安心的休息。\n"
msgstr "Es una habitación de huéspedes muy bien barrida. Los muebles son todos bastante sencillos, nada que ver con las famosas tabernas de la ciudad del condado, pero tienen un aire honesto y acogedor; aquí podrás descansar con tranquilidad."

msgid "这里是淳风武馆中的天井，往西走可以回到正厅，往北边是书房，\n南边是招待客人的厢房，往东一条长廊通往武馆内院，天井中种满了许\n多奇花异草，中央立著一根石柱，上面似乎刻著字。\n"
msgstr "Este es el patio del Salón del Viento Puro. Al oeste se vuelve a la sala principal; al norte está el estudio, y al sur, el cuarto lateral para los huéspedes. Al este, una larga galería lleva al patio interior del salón. El patio está lleno de flores y plantas raras, y en el centro se alza un pilar de piedra que parece tener algo grabado."

msgid "这里是淳风武馆的内院，平常武馆弟子没有馆主的允许是不敢到这\n里来的，往东是柳家的祠堂，馆主和家眷的卧房分别位于往北一条走道\n的两旁，厨房以及柴房、仆役的卧房都在往南的走道两旁，往西则是天\n井。\n"
msgstr "Este es el patio interior del Salón del Viento Puro. Normalmente los discípulos no se atreven a venir aquí sin permiso del maestro del salón. Al este está el santuario de la familia Liu; los dormitorios del maestro y de su familia quedan a ambos lados de un pasillo hacia el norte, y la cocina, la leñera y los cuartos de los sirvientes, a ambos lados del pasillo del sur. Al oeste está el patio."

msgid "这是一把沈重的铁斧，用来砍柴。\n"
msgstr "Es un hacha de hierro pesada, para cortar leña."

msgid "这是一把沈重的铁锤，打造的相当坚实。\n"
msgstr "Es un martillo de hierro pesado y muy bien forjado."

msgid "这是寺庙接受善男信女捐献香油钱的功德箱，你可以把想捐的钱\n放进去。\n"
msgstr "Es la caja de ofrendas donde los fieles dejan su dinero para el incienso. Puedes meter en ella lo que quieras donar."

msgid "这是一把练习剑法用的竹剑，剑尖处用布包了起来以免误伤同伴。\n"
msgstr "Es una espada de bambú para practicar esgrima, con la punta envuelta en tela para no herir a los compañeros por accidente."

msgid "这件粉红色的绸衫上面绣著几只黄鹊，闻起来还有一股淡香。\n"
msgstr "Esta blusa de seda rosa lleva bordadas unas oropéndolas y todavía huele a un perfume suave."

msgid "这似乎是一本什么刀谱的前几页，虽然并没有关于招式的详细解说，可是\n前面有关刀法的总纲与精义倒是不少。\n"
msgstr "Parecen las primeras páginas de algún manual de sable. No explican los movimientos en detalle, pero sí traen bastante sobre los principios y la esencia del arte del sable."

msgid "这是一位来雪亭镇的外地旅客.\n"
msgstr "Viene de fuera y está de paso por Pabellón Nevado."

msgid "一只浑身脏兮兮的野狗。\n"
msgstr "Un perro salvaje todo cubierto de mugre."

msgid "野狗用鼻子闻了闻你的脚。\n"
msgstr "El perro salvaje te olfatea los pies."

msgid "野狗在你的脚边挨挨擦擦的，想讨东西吃。\n"
msgstr "El perro salvaje se te restriega contra los pies, a ver si le das algo de comer."

msgid "野狗对著你摇了摇尾巴。\n"
msgstr "El perro salvaje te mueve la cola."

msgid "野狗用后腿抓了抓自己的耳朵。\n"
msgstr "El perro salvaje se rasca la oreja con una pata trasera."

msgid "高兴地汪汪叫了起来。"
msgstr " ladra de alegría."

msgid "这个老人看起来七十多岁了，看著他佝偻的身影，你忽然觉得心情沈重了下来。\n"
msgstr "Este anciano parece tener más de setenta años. Al ver su figura encorvada, de pronto se te encoge el corazón."

msgid "这位$RESPECT，捐点香火钱积点阴德吧。"
msgstr "Una limosna para el incienso, $RESPECT; así acumula méritos para la otra vida."

msgid "多谢这位$RESPECT，神明一定会保佑你的。"
msgstr "Gracias, $RESPECT. Los dioses le darán su protección."

msgid "一个喝得醉醺醺的年轻人.....\n"
msgstr "Un joven borracho como una cuba..."

msgid "酒..... 给我酒...."
msgstr "Vino... dame vino..."

msgid "去去去去去.. 我又不是收破烂的..."
msgstr "Fuera, fuera, fuera... que yo no soy chatarrero..."

msgid "真没诚意, 剩么一点... "
msgstr "¡Qué tacaño! ¿Solo esto?..."

msgid "多谢, 不过我还有酒... "
msgstr "Gracias, pero todavía tengo vino..."

msgid "听说沈记商行有在卖蒙汗药...\n"
msgstr "Dicen que el Comercio Shen vende polvo somnífero..."

msgid "嗯.. 你是想问我玉佩的事吧? 我卖给沈老板了, 那东西不吉祥...\n"
msgstr "Mmm... ¿quieres preguntarme por el colgante de jade, verdad? Se lo vendí al patrón Shen; esa cosa trae mala suerte..."

msgid "多谢啦....."
msgstr "Muchas gracias..."

msgid "这个人不但自己收破烂，身上也穿得破烂不堪。\n"
msgstr "Este hombre no solo recoge cachivaches: él mismo va vestido con harapos."

msgid "收破烂的吆喝道：收～破～烂～哪～\n"
msgstr "El chatarrero pregona: \"¡Cachivaaaches! ¡Compro cachivaaaches!\""

msgid "收破烂的嘴里嘟哝著，不知道说些什么。\n"
msgstr "El chatarrero masculla algo entre dientes que no se entiende."

msgid "收破烂的伸手捉住了身上的虱子，一脚踩得扁扁的。 \n"
msgstr "El chatarrero se quita un piojo de encima y lo aplasta de un pisotón."

msgid "$RESPECT饶命！小的这就离开！"
msgstr "¡Piedad, $RESPECT! ¡Ya me voy, ya me voy!"

msgid "多谢这位$RESPECT！"
msgstr "¡Muchas gracias, $RESPECT!"

msgid "刘安禄是淳风武馆的门房，除了馆主柳淳风没有人知道他的出身来历，只知\n到他的武艺不弱，一手快刀在这一带罕有敌手。\n"
msgstr "Liu Anlu es el portero del Salón del Viento Puro. Salvo el maestro del salón, Liu Chunfeng, nadie conoce su origen; solo se sabe que no es nada malo en las artes marciales y que con su sable rápido pocos en la comarca le hacen frente."

msgid "刘安禄说道：你当这里是什么地方，敢来这里撒野？\n"
msgstr "Liu Anlu dice: \"¿Qué te crees que es este lugar, que vienes a armar escándalo?\""

msgid "刘安禄说道：想我堂堂....呃....连我这个淳风武馆的小小的门房都可以收拾你！\n"
msgstr "Liu Anlu dice: \"Yo, el gran... ejem... ¡Hasta un simple portero del Salón del Viento Puro como yo puede contigo!\""

msgid "刘安禄忽然挥出一刀，招数精奇，但是刀到中途忽然像是想起什么，急忙收招。\n"
msgstr "Liu Anlu lanza de pronto un sablazo de una técnica extraña y sutil, pero a medio camino parece recordar algo y lo retira a toda prisa."

msgid "刘安禄说道：你快走吧，就算我输了你啦....\n"
msgstr "Liu Anlu dice: \"Vete de una vez, ¿quieres? Digamos que ganaste tú...\""

msgid "看见你，放下了手里的扫帚。"
msgstr " te ve y deja la escoba."

msgid "李教头同我说了。……那句话是你替我挡的。"
msgstr "El instructor Li me lo contó. ...Esa vez diste la cara por mí."

msgid "我欠你一句话。哪天你用得着野羊山的人，开口。"
msgstr "Te debo una. El día que necesites a alguien del Cerro de las Cabras, solo dilo."

msgid "背着一个青布包袱，望着往野羊山去的那条路。"
msgstr " lleva a la espalda un hatillo de tela azul y mira el camino que va al Cerro de las Cabras."

msgid "话是你说的。我不怨你——五年前我就该走。"
msgstr "Tú lo dijiste. No te guardo rencor; hace cinco años que debí irme."

msgid "馆主留我到今天，是他的情分；武馆的规矩，是老馆主的。两样都没错。"
msgstr "Que el maestro me tuviera aquí hasta hoy fue cosa de su bondad; las reglas del salón son del viejo maestro. Ninguna de las dos cosas estuvo mal."

msgid "刘老三"
msgstr "Liu el Tercero"

msgid "刘安禄的来历不简单。当面问出这个名字，是把事情挑明——他未必肯善罢甘休。要问吗？"
msgstr "Liu Anlu esconde algo. Decirle este nombre a la cara es poner las cartas sobre la mesa, y puede que no lo deje pasar. ¿Preguntar de todos modos?"

msgid "……老子认了，还问什么。你要问野羊寨的事，问大寨主。"
msgstr "...Ya lo reconocí, ¿qué más quieres saber? Si quieres saber del Fuerte de las Cabras, pregúntale al gran jefe."

msgid "老子就是血手刘三，血手刘三就是你老子！纳命来！"
msgstr "¡Yo soy Liu Mano Sangrienta, y Liu Mano Sangrienta es tu padre! ¡Ven a morir!"

msgid "我...不知道！"
msgstr "¡Yo... no sé nada!"

msgid "刘安禄眼中突然放出异样的光芒，颤声说道：看来...你都知道了？"
msgstr "A Liu Anlu se le enciende un brillo extraño en los ojos, y con la voz temblorosa dice: \"Así que... ¿ya lo sabes todo?\""

msgid "刘安禄大喝一声，叫道：既然如此，老子今天豁出去了，纳命来！"
msgstr "Liu Anlu suelta un rugido: \"¡Pues bien, hoy no tengo nada que perder! ¡Ven a morir!\""

msgid "刘安禄使开单刀，招数精奇，沈猛狠辣，和刚才简直判若两人！"
msgstr "¡Liu Anlu despliega su sable con una técnica sutil, golpes feroces y despiadados; parece otro hombre!"

msgid "血手刘三"
msgstr "Liu Mano Sangrienta"

msgid "大寨主"
msgstr "Gran jefe"

msgid "刘安禄沉默了半晌，低声道：野羊寨的大寨主霍铮，是我拜过把子的大哥。"
msgstr "Liu Anlu guarda silencio un buen rato y luego dice en voz baja: \"El gran jefe del Fuerte de las Cabras, Huo Zheng, es mi hermano mayor de juramento.\""

msgid "半年前，北麓那座黑砖道观的道士上山要人。大哥跟他们走了，再没回来。那伙人自称逆灵宫。"
msgstr "Hace medio año, los taoístas de ese monasterio de ladrillo negro de la falda norte subieron a la montaña a reclamarlo. El hermano mayor se fue con ellos y nunca volvió. Esa gente se hace llamar el Palacio Negro."

msgid "黄霸——老三——把寨子接了过去，每年给道观纳供，金帛、牲口，要什么送什么。我不肯伺候那群臭道士，就下了山。"
msgstr "Huang Ba, nuestro tercero, se quedó con el fuerte, y cada año le paga tributo al monasterio: oro, sedas, ganado, lo que pidan. Yo no quise servir a esa pandilla de taoístas apestosos y bajé de la montaña."

msgid "纳供的车这几天就上山。到了山路转角，道士从北边山壁的裂口把东西吊上去——道观就在裂口上头。你要去，替我看一眼大哥。"
msgstr "Los carros del tributo suben uno de estos días. En el recodo del camino, los taoístas suben la carga por una grieta del paredón norte; el monasterio está justo encima. Si vas, échale un vistazo a mi hermano mayor por mí."

msgid "……大哥的事，等你知道野羊山北麓是个什么地方再说。"
msgstr "...Lo del hermano mayor, cuando sepas qué clase de lugar es la falda norte del Cerro de las Cabras."

msgid "大寨主？我是淳风武馆的门房，哪来的什么大寨主。"
msgstr "¿Gran jefe? Yo soy el portero del Salón del Viento Puro; ¿de dónde voy a sacar un gran jefe?"

msgid "野羊山寨二寨主"
msgstr "Segundo jefe del Fuerte de las Cabras"

msgid "刘安禄望着北边，低声道：大哥……\n"
msgstr "Liu Anlu mira hacia el norte y dice en voz baja: \"Hermano mayor...\""

msgid "刘安禄叫道：老子已经认输了，你还要怎样！\n"
msgstr "Liu Anlu grita: \"¡Ya me di por vencido! ¿¡Qué más quieres!?\""

msgid "你看到一位身材高大的汉子，正在辛苦地操练著。\n"
msgstr "Ves a un hombre alto y fornido que entrena con gran esfuerzo."

msgid "拳法教练"
msgstr "Instructor de puño"

msgid "李火狮是个孔武有力的大块头，他正在训练他的弟子们习练「柳家拳\n法」。\n"
msgstr "Li Huoshi es un grandulón fuerte como un toro; está entrenando a sus alumnos en el Puño de la familia Liu."

msgid "这里当然是淳风武馆，不然还是哪里？\n"
msgstr "Esto es el Salón del Viento Puro, claro. ¿Qué otro lugar iba a ser?"

msgid "在下姓李，名字就叫火狮，人称李教头的便是我。\n"
msgstr "Me apellido Li y me llamo Huoshi; el que llaman instructor Li soy yo."

msgid "柳家拳法"
msgstr "Puño de la familia Liu"

msgid "哦....说来惭愧，小弟这套拳法还没学得到家, 柳馆主就教我在这里传艺。\n"
msgstr "Oh... me da vergüenza decirlo: yo mismo todavía no domino del todo este puño, y aun así el maestro Liu me puso a enseñarlo aquí."

msgid "话是你说的，馆主也认了。老刘回了野羊山——这扇门，他不会再进了。"
msgstr "Tú lo dijiste, y el maestro lo aceptó. El viejo Liu volvió al Cerro de las Cabras; por esa puerta no volverá a entrar."

msgid "话是你说的，馆主也认了。武馆的规矩，谁也不能例外。……老刘走的时候，把门房的钥匙擦得干干净净。"
msgstr "Tú lo dijiste, y el maestro lo aceptó. Las reglas del salón no tienen excepciones. ...Cuando el viejo Liu se fue, dejó la llave de la portería limpia y reluciente."

msgid "你说认错了人，我就当是认错了人。弟子们那边，我去压。"
msgstr "Dices que se equivocaron de hombre; entonces se equivocaron de hombre. A los discípulos los callo yo."

msgid "老刘前些日子不辞而别，门房的桌子空着。偏偏那几个骗子又在镇上嚷，说他是野羊山的二寨主。"
msgstr "El viejo Liu se fue hace unos días sin despedirse, y la mesa de la portería está vacía. Y justo ahora esos estafadores andan gritando por el pueblo que él es el segundo jefe del Cerro de las Cabras."

msgid "弟子们都在猜。有人说该报官，有人说该上野羊山问个明白。"
msgstr "Los discípulos andan haciendo conjeturas. Unos dicen que hay que avisar a las autoridades; otros, que hay que subir al Cerro de las Cabras a averiguarlo."

msgid "馆主不开口。骗子是你打发的——老刘到底是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr "El maestro no dice nada. Fuiste tú quien despachó a los estafadores; así que dile tú a todos quién es en verdad el viejo Liu: desenmascararlo o cubrirlo."

msgid "那天你和老刘在门口动了刀，弟子们都看见了——那套刀法，不是一个门房使得出来的。"
msgstr "Aquel día, cuando el viejo Liu y tú cruzaron sables en la puerta, lo vieron todos los discípulos: esa técnica no es de un portero."

msgid "偏偏那几个骗子又在镇上嚷，说他是野羊山的血手刘三。"
msgstr "Y justo ahora esos estafadores andan gritando por el pueblo que él es Liu Mano Sangrienta, del Cerro de las Cabras."

msgid "馆主不开口。你和他交过手，你最清楚——他是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr "El maestro no dice nada. Tú peleaste con él; tú lo sabes mejor que nadie. Así que dile tú a todos quién es: desenmascararlo o cubrirlo."

msgid "那几个骗子在镇上嚷，说咱们门房老刘是野羊山的二寨主，叫什么血手刘三。"
msgstr "Esos estafadores andan gritando por el pueblo que nuestro portero, el viejo Liu, es el segundo jefe del Cerro de las Cabras, uno al que llaman Liu Mano Sangrienta."

msgid "老刘在武馆五年，扫地、守门、记账，没出过一回错。可弟子们听见了，就得有个说法：武馆不留匪，这是老馆主立的规矩。"
msgstr "El viejo Liu lleva cinco años en el salón: barre, cuida la puerta, lleva las cuentas, y nunca cometió un error. Pero los discípulos ya lo oyeron, así que tiene que haber una respuesta: el salón no da cobijo a bandidos; esa es una regla del viejo maestro."

msgid "馆主不开口。骗子是你打发的，话是你听见的——他是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr "El maestro no dice nada. Fuiste tú quien despachó a los estafadores y quien oyó lo que dijeron; así que dile tú a todos quién es: desenmascararlo o cubrirlo."

msgid "门房老刘？在武馆五年了，话不多，人勤快。"
msgstr "¿El viejo Liu, el portero? Lleva cinco años en el salón. Habla poco y es muy trabajador."

msgid "说破门房的来历"
msgstr "Desenmascarar al portero"

msgid "告诉李火狮：门房刘安禄就是野羊山的血手刘三。\n武馆不留匪——这句话出口，武馆从此没有他的位置，弟子们会记得是你说的。\n要说破吗？"
msgstr "Dile a Li Huoshi que el portero, Liu Anlu, es Liu Mano Sangrienta, del Cerro de las Cabras.\nEl salón no da cobijo a bandidos: una vez dicho, ya no habrá lugar para él en el salón, y los discípulos recordarán que lo dijiste tú.\n¿Desenmascararlo?"

msgid "你已经说过了。"
msgstr "Ya lo dijiste."

msgid "你前头说的是认错了人。话出了口，就别改了。"
msgstr "Antes dijiste que se equivocaron de hombre. Lo dicho, dicho está; no lo cambies."

msgid "的脸沉了下来。"
msgstr " ensombrece el rostro."

msgid "……血手刘三。五年，我天天和他一张桌子吃饭。"
msgstr "...Liu Mano Sangrienta. Cinco años comiendo con él en la misma mesa todos los días."

msgid "规矩是老馆主立的，我去回馆主。你做得对——只是往后弟子们看你，眼神会不一样。"
msgstr "La regla la puso el viejo maestro; yo iré a informar al maestro. Hiciste bien; solo que, de ahora en adelante, los discípulos te mirarán de otra manera."

msgid "说破什么？"
msgstr "¿Desenmascarar qué?"

msgid "替门房瞒下来"
msgstr "Cubrir al portero"

msgid "告诉李火狮：那伙骗子认错了人。\n武馆里没人再提这件事，刘安禄欠你一句话；可这句话从此算在你头上，日后再有人认出他，弟子们先问的是你。\n要替他瞒吗？"
msgstr "Dile a Li Huoshi que esos estafadores se equivocaron de hombre.\nEn el salón nadie volverá a hablar del asunto, y Liu Anlu te deberá una; pero desde ahora esa palabra corre por tu cuenta: si algún día alguien lo reconoce, los discípulos te pedirán cuentas a ti primero.\n¿Cubrirlo?"

msgid "认错了人。我已经同弟子们说过了。"
msgstr "Se equivocaron de hombre. Ya se lo dije a los discípulos."

msgid "话已经出了口，瞒不回去了。"
msgstr "Lo dicho, dicho está; ya no se puede ocultar."

msgid "盯着你看了一会儿，慢慢点了点头。"
msgstr " te observa un rato y asiente despacio."

msgid "认错了人。好，我就这么同弟子们说。"
msgstr "Se equivocaron de hombre. Bien, eso les diré a los discípulos."

msgid "你担着这句话，就担到底。"
msgstr "Si cargas con esta palabra, cárgala hasta el final."

msgid "瞒什么？"
msgstr "¿Cubrir qué?"

msgid "点了点头。"
msgstr " asiente."

msgid "进招吧。"
msgstr "Adelante, ataca."

msgid "馆主吩咐过，不许和来这里的客人过招。"
msgstr "El maestro lo ordenó: nada de combates con los visitantes."

msgid "对不起，这位$RESPECT，您不是我们武馆的弟子。"
msgstr "Lo siento, $RESPECT, usted no pertenece a nuestro salón."

msgid "李火狮不愿意教你拳法。"
msgstr "Li Huoshi no quiere enseñarte su puño."

msgid "你看到一位面色黝黑的农夫。\n"
msgstr "Ves a un campesino de cara curtida por el sol."

msgid "农夫叫道：杀人哪！杀人哪！\n"
msgstr "El campesino grita: \"¡Que me matan! ¡Que me matan!\""

msgid "农夫叫道：有土匪哪！光天化日下打劫哪！\n"
msgstr "El campesino grita: \"¡Bandidos! ¡Asaltan a plena luz del día!\""

msgid "一只浑身脏兮兮的野狗，一双眼睛正恶狠狠地瞪著你。\n"
msgstr "Un perro salvaje todo cubierto de mugre, que te clava una mirada feroz."

msgid "教书先生"
msgstr "Maestro de escuela"

msgid "魏无极是个博学多闻的教书先生，他年轻时曾经中过举人，但是\n因为生性喜爱自由而不愿做官，魏无极以教书为业，如果你付他\n一笔学费，就可以成为他的弟子学习读书识字。\n"
msgstr "Wei Wuji es un maestro de escuela muy erudito. De joven aprobó los exámenes provinciales, pero, amante de su libertad, no quiso ser funcionario y vive de la enseñanza. Si le pagas una cuota, puedes hacerte su alumno y aprender a leer y escribir."

msgid "学费"
msgstr "Matrícula"

msgid "嗯 ... 读书识字是做人的第一步。"
msgstr "Mmm... saber leer y escribir es el primer paso para ser una persona de verdad."

msgid "学好了读书识字的本领，胜过于百万的家财。"
msgstr "Aprender bien a leer y escribir supera a una fortuna de millones."

msgid "所以说学问是金钱买不到的。"
msgstr "Por eso se dice que el saber no se compra con dinero."

msgid "虽然学问是无价的，不过如果你有心的话 ..."
msgstr "Aunque el saber no tiene precio, si de verdad tienes interés..."

msgid "只要五两银子。"
msgstr "...son solo cinco taels de plata."

msgid "手头紧？街东头的谷场正缺短工，干一回给一两。"
msgstr "¿Andas corto de dinero? El molino del extremo este de la calle necesita jornaleros: un tael por jornada."

msgid "对，读书识字。"
msgstr "Eso es: leer y escribir."

msgid "哦 ... 你是说野羊山寨的二寨主，人称血手刘三的刘安禄吗？"
msgstr "Ah... ¿te refieres a Liu Anlu, el segundo jefe del Fuerte de las Cabras, al que llaman Liu Mano Sangrienta?"

msgid "他又出来做恶了？"
msgstr "¿Ya anda otra vez haciendo maldades?"

msgid "你带我去见他，让我跟他说几句话。"
msgstr "Llévame a verlo. Déjame hablar un par de palabras con él."

msgid "点了点头，说道：哦，向你这么有心的学生还真是不多见，好好努力将来必定前途无量，谢了。"
msgstr " asiente: \"Oh, pocos alumnos tan aplicados como tú se ven. Esfuérzate y tendrás un gran porvenir. Gracias.\""

msgid "点了点头，说道：很好，从今天起你随时可以来问我有关读书识字的任何问题。"
msgstr " asiente: \"Muy bien. Desde hoy puedes venir cuando quieras a preguntarme lo que sea sobre la lectura y la escritura.\""

msgid "你的诚意不够，这钱还是拿回去吧。"
msgstr "No muestras suficiente sinceridad; mejor llévate ese dinero."

msgid "咦？我不记得收过你这个学生啊...."
msgstr "¿Eh? No recuerdo haberte aceptado como alumno..."

msgid "你看到一个粗壮的大汉，身上穿著普通樵夫的衣服。\n"
msgstr "Ves a un hombretón fornido con ropa de leñador corriente."

msgid "樵夫说道：野羊山那群臭道士真是该千刀万剐....\n"
msgstr "El leñador dice: \"A esos taoístas apestosos del Cerro de las Cabras habría que cortarlos en mil pedazos...\""

msgid "樵夫说道：不知道那些牛鼻子施了什么妖法，前天回家差点迷了路。\n"
msgstr "El leñador dice: \"No sé qué brujería echaron esos narices de buey, pero anteayer casi me pierdo de camino a casa.\""

msgid "樵夫说道：唉....日子越来越不好过罗。\n"
msgstr "El leñador dice: \"Ay... la vida está cada vez más difícil.\""

msgid "雪亭驿长"
msgstr "Jefe de la posta"

msgid "杜宽担任雪亭驿的驿长已经有十几年了，虽然期间有几次升迁的\n机会，但是他都因为舍不得离开这个小山村而放弃了，雪亭镇的\n居民对杜宽的风评相当不错，常常会来到驿站跟他聊天。\n"
msgstr "Du Kuan lleva más de diez años como jefe de la Posta de Pabellón Nevado. Tuvo varias ocasiones de ascenso, pero las rechazó todas porque no quería dejar este pueblito de montaña. Los vecinos de Pabellón Nevado lo tienen en muy buena estima y a menudo pasan por la posta a conversar con él."

msgid "驿站"
msgstr "Posta"

msgid "是啊... 这里就是雪亭驿，你要寄信吗？"
msgstr "Así es... esta es la Posta de Pabellón Nevado. ¿Quieres mandar una carta?"

msgid "官府的信差都改走飞鸢栈道了，咱这儿如今只剩百姓的信。"
msgstr "Los correos oficiales ahora van todos por la Pasarela del Milano Volador; aquí ya solo nos quedan las cartas de la gente."

msgid "送信"
msgstr "Entrega de cartas"

msgid "往后有信，还找你。"
msgstr "Si hay otra carta, te la daré a ti."

msgid "送到了？好，说好的脚钱。往后有信，还找你。"
msgstr "¿Ya la entregaste? Bien, aquí está tu paga, como quedamos. Si hay otra carta, te la daré a ti."

msgid "信丢了？……还好驿里留着底子，我再誊一封。这回别再弄丢了，陈镖头的镖局就在绮云镇街上。"
msgstr "¿Perdiste la carta? ...Por suerte en la posta guardamos copia; te escribo otra. Esta vez no la pierdas: la agencia de escoltas del jefe de escoltas Chen está en la calle de Tejenubes."

msgid "信送到了么？陈镖头的镖局就在绮云镇街上。"
msgstr "¿Ya entregaste la carta? La agencia de escoltas del jefe de escoltas Chen está en la calle de Tejenubes."

msgid "正好有封信，要送到绮云镇振远镖局陈镖头手里。驿里就我一个走不开——你若肯跑这一趟，回来给你一两脚钱。出镇往南过卧龙岗，岗上有强人，别跟他们纠缠，走你的路就是。"
msgstr "Justo tengo una carta que debe llegar a manos del jefe de escoltas Chen, de los Escoltas del Largo Camino, en Tejenubes. Aquí estoy yo solo y no puedo irme; si haces el viaje, a la vuelta te doy un tael por el mandado. Sal del pueblo hacia el sur y cruza la Loma del Dragón Dormido. En la loma hay salteadores: no te enredes con ellos, sigue tu camino y ya."

msgid "悬赏"
msgstr "Recompensas"

msgid "门外那张榜是乔阴府发的悬赏。榜上的恶人要是教你拿住了，赏银照榜发——拿不住也别逞强。"
msgstr "El tablón de afuera es la lista de recompensas de la prefectura de Sombra Alta. Si atrapas a alguno de los malhechores que aparecen ahí, te pagan la recompensa según la lista; y si no puedes con ellos, no te hagas {jugador:el héroe|la heroína}."

msgid "一只贼头贼脑的大老鼠。\n"
msgstr "Una rata enorme de aspecto furtivo."

msgid "这位店小二正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n"
msgstr "El mozo de la posada va y viene muy sonriente, y de vez en cuando se seca la cara con el trapo que lleva colgado al cuello."

msgid "楼上"
msgstr "Piso de arriba"

msgid "白衣人"
msgstr "Hombres de blanco"

msgid "官爷"
msgstr "Oficiales"

msgid "请柬"
msgstr "Invitación"

msgid "钱庄老板"
msgstr "Banquero"

msgid "安惜迩是个看起来相当斯文的年轻人，不过有时候会有些心不在焉的\n样子，雪亭镇的居民对安惜迩都觉得有点神秘莫测的感觉，为什么他\n年纪轻轻就身为一家大钱庄的老板，还有他一身稀奇古怪的武功，所\n幸安惜迩似乎天性恬淡，甚至有些隐者的风骨，只要旁人不去惹他，\n他也绝不会去招惹旁人。\n"
msgstr "An Xi'er parece un joven bastante refinado, aunque a veces se le ve algo distraído. A los vecinos de Pabellón Nevado les resulta un tanto misterioso: ¿cómo es que, tan joven, es dueño de un gran banco, y de dónde sacó sus extrañas artes marciales? Por suerte, An Xi'er parece de carácter sereno, incluso con algo de ermitaño: mientras nadie se meta con él, él jamás se mete con nadie."

msgid "安惜迩似笑非笑地望著你，脸上的神气古理古怪，不知道在想些什么？\n"
msgstr "An Xi'er te mira con una media sonrisa y una expresión rarísima. ¿Qué estará pensando?"

msgid "安惜迩的身影晃了一下，似乎在你身上各处大穴摸了一下，不过也许是你的错觉。\n"
msgstr "La silueta de An Xi'er titila un instante; parece haberte tocado todos los puntos vitales del cuerpo, aunque quizá fue solo tu imaginación."

msgid "安惜迩神情忽然严肃了起来，不过好像是在想自己的事，与你无关。\n"
msgstr "An Xi'er se pone serio de repente, pero parece pensar en sus propios asuntos, nada que ver contigo."

msgid "安惜迩忽然呵呵呵地笑了起来，却不知道在笑些什么....\n"
msgstr "An Xi'er suelta de pronto una risita, ji, ji, ji, sin que se sepa de qué se ríe..."

msgid "咦... 要打就真打吧，光是较量多没意思？"
msgstr "Vaya... si vamos a pelear, peleemos en serio. ¿Qué gracia tiene un simple combate amistoso?"

msgid "王铁匠正用铁钳夹住一块红热的铁块放进炉中。\n"
msgstr "El herrero Wang sujeta con las tenazas un trozo de hierro al rojo y lo mete en la fragua."

msgid "小人姓王，单名一个恒字，可是小人西瓜大的字识不到一担，只有王字会写。\n"
msgstr "Mi apellido es Wang, y mi nombre, Heng, a secas; pero no reconozco ni una letra grande como una sandía, y la única que sé escribir es la de Wang."

msgid "这里是小人糊口的铺子，小人一家五口都住在后边的屋子。\n"
msgstr "Este es el taller que me da de comer; los cinco de mi familia vivimos en los cuartos de atrás."

msgid "锄头"
msgstr "Azadón"

msgid "锄头... 抱歉，锄头已经卖光了...\n"
msgstr "¿Un azadón...? Lo siento, ya se me acabaron los azadones..."

msgid "铲子"
msgstr "Pala"

msgid "对不起，小人店里的铲子都给人订走了。\n"
msgstr "Lo siento, todas las palas del taller ya están encargadas."

msgid "铁锤？小人做的铁锤坚固又耐用，一把只要三百文钱。\n"
msgstr "¿Un martillo de hierro? Los que hago yo son sólidos y duraderos; solo trescientos wen cada uno."

msgid "杨掌柜是这附近相当有名的大善人，常常施舍草药给付不起药钱的穷人\n。此外他的医术也不错，年轻时曾经跟著山烟寺的玄智和尚学医，一般\n的伤寒小病直接问他开药吃比医生还灵。\n"
msgstr "El tendero Yang es muy conocido por aquí como un hombre de gran bondad, que a menudo regala hierbas a los pobres que no pueden pagar las medicinas. Además, no es mal curandero: de joven estudió medicina con el monje Xuanzhi del Templo de la Bruma, y para un resfriado o un malestar menor, pedirle a él un remedio funciona mejor que ir al médico."

msgid "治伤"
msgstr "Curar heridas"

msgid "这位$RESPECT，您看起来气色很好啊，不像有受伤的样子。"
msgstr "Tiene usted muy buen semblante, $RESPECT; no se le ve ninguna herida."

msgid "哦....我看看....只是些皮肉小伤，您买包金创药回去敷敷就没事了。"
msgstr "A ver... déjeme ver... solo son unos rasguños. Compre un paquete de ungüento para heridas, póngaselo y se le pasará."

msgid "开药"
msgstr "Receta"

msgid "麝香给你了。替我问玄智师父好。"
msgstr "Aquí tiene su almizcle. Salude de mi parte a Shifu Xuanzhi."

msgid "玄智师父开的方子？我看看——附子、麝香、鬼臼。"
msgstr "¿Una receta de Shifu Xuanzhi? A ver: acónito, almizcle, raíz de podófilo."

msgid "脸色沉了下来。"
msgstr " ensombrece el rostro."

msgid "鬼臼以毒攻毒……这是阴寒入骨的方子。乔阴那边，又不太平了？"
msgstr "La raíz de podófilo combate veneno con veneno... Esta receta es para un frío que se metió hasta los huesos. ¿Otra vez hay problemas por el lado de Sombra Alta?"

msgid "从药柜最上头一格取下一个小罐，用桑皮纸包了一小包，递给你。"
msgstr " baja un frasquito del cajón más alto del armario de medicinas, envuelve un paquetito en papel de morera y te lo entrega."

msgid "师父要的东西，不收钱。我年轻时跟着他学医三年，他教的头一句：药是凉的，人心得是热的。"
msgstr "Lo que pide mi Shifu no se cobra. De joven estudié medicina con él tres años, y lo primero que me enseñó fue esto: la medicina es fría; el corazón de la gente tiene que ser cálido."

msgid "山烟寺？我年轻时曾经跟著山烟寺的玄智和尚学医。玄智师父的医术，天底下没几个人比得上。"
msgstr "¿El Templo de la Bruma? De joven estudié medicina con el monje Xuanzhi de ese templo. Pocos bajo el cielo igualan el arte médico de Shifu Xuanzhi."

msgid "柳绘心是淳风武馆馆主柳淳风的独生女。\n"
msgstr "Liu Huixin es la única hija de Liu Chunfeng, maestro del Salón del Viento Puro."

msgid "柳绘心秀眉微蹙，说道：喂！我哪里得罪你了？干嘛这样跟我拼死拼活？\n"
msgstr "Liu Huixin frunce levemente sus finas cejas: \"¡Oye! ¿Qué te hice yo? ¿Por qué peleas conmigo como si te fuera la vida en ello?\""

msgid "柳绘心不住地望著窗外：你还是快走吧，我没空陪你练功夫！\n"
msgstr "Liu Huixin no deja de mirar por la ventana: \"Mejor vete ya, ¡no tengo tiempo para practicar contigo!\""

msgid "我每天夜里读一页。爹爹年轻的时候，字写得比现在放得开。"
msgstr "Leo una página cada noche. Cuando papá era joven, su letra era más suelta que ahora."

msgid "爹爹把它锁起来了，是不是？……他什么都锁起来。"
msgstr "Papá lo guardó bajo llave, ¿verdad? ...Lo guarda todo bajo llave."

msgid "爹爹在天驼关写过一卷书，我只听李教头提过一句。他从来不让我看。"
msgstr "Papá escribió un libro en el Paso del Camello; solo oí al instructor Li mencionarlo una vez. Nunca me deja verlo."

msgid "北宗"
msgstr "Rama norte"

msgid "跟柳绘心立北宗：封山的剑往外传。\n你转入封山剑派北宗，和她同辈；她把自己悟出来的「点」字诀教给你。柳淳风不再教你武功，「掌门传人」的名分没有了。这不算叛师：评价不清零，也不记背叛。封山在虹台上的那一票，会被颜违拿「给北宗一个座」来换（已经入了虹台的席的，这一票不再跟着变）。\n这是封山这条线的大分裂，选了不能改。要跟她吗？"
msgstr "Fundar la rama norte con Liu Huixin: la espada de la Montaña Vacía se enseñará a los de fuera.\nPasas a la rama norte de la Escuela de la Montaña Vacía, como su igual, y ella te enseña la técnica del \"Punto\" que descubrió por sí misma. Liu Chunfeng ya no te enseñará artes marciales y pierdes la condición de {jugador:heredero|heredera} del Maestro. Esto no cuenta como traicionar a tu Shifu: tu reputación no se pone a cero ni queda registrada ninguna traición. Yan Wei cambiará el voto de la Montaña Vacía en la Terraza del Arcoíris por \"un asiento para la rama norte\" (si ya se ocuparon los asientos de la Terraza del Arcoíris, ese voto ya no cambia).\nEs la gran escisión de la línea de la Montaña Vacía y no se puede deshacer. ¿Irte con ella?"

msgid "北宗现在有两个人了。"
msgstr "Ahora la rama norte somos dos."

msgid "你选了爹爹那一边。我不怪你。"
msgstr "Elegiste el lado de papá. No te culpo."

msgid "的眼圈红了一下，很快又忍了回去。"
msgstr " tiene los ojos enrojecidos un instante, pero enseguida se contiene."

msgid "那北宗就有两个人了。"
msgstr "Entonces la rama norte somos dos."

msgid "「点」字诀爹爹没教过我，是我自己看他练剑悟的：劲不在手臂上，在剑尖上。你看——"
msgstr "Papá nunca me enseñó la técnica del 'Punto'; la descubrí yo sola viéndolo practicar con la espada: la fuerza no está en el brazo, está en la punta. Mira..."

msgid "的细剑平平递出，剑尖在廊柱上一点，柱子背面迸出一小块木屑。"
msgstr " adelanta en línea recta su espada fina; la punta toca una columna del corredor, y del otro lado de la columna salta una astilla."

msgid "内力不够的时候别使，剑会脱手。我脱过好几回。"
msgstr "No la uses cuando te falte fuerza interior, o la espada se te escapará de la mano. A mí se me escapó varias veces."

msgid "爹爹不会再教你了。对不起。……可是阿桂他们，往后也算你的师弟师妹。"
msgstr "Papá ya no te va a enseñar. Lo siento. ...Pero Agui y los demás, de ahora en adelante, también son tus hermanos menores de escuela."

msgid "北宗？绮云镇口的公告上还这么写呢。爹爹说那是旧名。"
msgstr "¿La rama norte? El aviso a la entrada de Tejenubes todavía lo dice. Papá dice que es un nombre viejo."

msgid "劲不在手臂上，在剑尖上。内力不够别使，剑会脱手。"
msgstr "La fuerza no está en el brazo, está en la punta. No la uses si te falta fuerza interior, o la espada se te escapará de la mano."

msgid "爹爹练剑的时候，我在窗后头看过。"
msgstr "Cuando papá practicaba con la espada, yo lo miraba desde detrás de la ventana."

msgid "正月十七的事过去了。北宗的剑，照旧教人。"
msgstr "Lo del diecisiete ya pasó. La espada de la rama norte se sigue enseñando."

msgid "北宗这一票，正月十七照你说的投。"
msgstr "El voto de la rama norte, el diecisiete, irá como tú digas."

msgid "颜违许了北宗一个座。北宗能在虹台上坐下来，是你陪我走出来的——这一票投颜违，是说好了的。"
msgstr "Yan Wei le prometió un asiento a la rama norte. Si la rama norte puede sentarse en la Terraza del Arcoíris, es porque tú saliste conmigo; este voto va para Yan Wei, así quedamos."

msgid "把剑在膝上横过来，想了想。"
msgstr " se pone la espada atravesada sobre las rodillas y lo piensa."

msgid "可你要是想自己站出来，这一票我给你。"
msgstr "Pero si tú quieres dar la cara, este voto es tuyo."

msgid "虹台？那是爹爹的事。"
msgstr "¿La Terraza del Arcoíris? Eso es cosa de papá."

msgid "请柳绘心把北宗这一票交给你：正月十七虹台上，封山的座听你的——颜违许的那个座还是北宗的，这一票不再投他。\n要这么说吗？"
msgstr "Pedirle a Liu Huixin que te entregue el voto de la rama norte: el diecisiete, en la Terraza del Arcoíris, el asiento de la Montaña Vacía irá como tú digas. El asiento que prometió Yan Wei sigue siendo de la rama norte, pero el voto ya no será para él.\n¿Decírselo?"

msgid "封山那一票在爹爹手里。你去问他。"
msgstr "El voto de la Montaña Vacía lo tiene papá. Pregúntale a él."

msgid "说过了。北宗听你的。"
msgstr "Ya lo hablamos. La rama norte va contigo."

msgid "笑了一下。"
msgstr " sonríe un poco."

msgid "好。北宗的座，听你的。"
msgstr "Bien. El asiento de la rama norte será como tú digas."

msgid "这是爹爹收起来的那一卷……你从哪里拿来的？还回去吧。"
msgstr "Este es el libro que papá guardó... ¿De dónde lo sacaste? Devuélvelo."

msgid "把《悟疾风劲竹书》交给柳绘心。\n她会头一回读到父亲年轻时写的字。书只有这一本，给出去就读不到了；柳淳风不会再见到它。\n要交给她吗？"
msgstr "Darle «Bambú contra el vendaval» a Liu Huixin.\nLeerá por primera vez lo que su padre escribió de joven. Solo existe este ejemplar: si se lo das, ya no podrás leerlo, y Liu Chunfeng no volverá a verlo.\n¿Dárselo?"

msgid "接过书，翻开第一页，手停住了。"
msgstr " toma el libro, lo abre por la primera página y su mano se detiene."

msgid "「直竹贵地生，风吹动不止」……这是爹爹的字。他从来没给我看过。"
msgstr "'El bambú recto nace en buena tierra; el viento lo sopla y no deja de moverse'... Es la letra de papá. Nunca me lo mostró."

msgid "「起迄中空立，随风飘不定」——原来他年轻的时候，也想过剑可以是弯的。"
msgstr "'Hueco se yergue de la raíz a la punta; se mece con el viento sin parar'... Así que de joven él también pensó que una espada podía doblarse."

msgid "把书抱在怀里。"
msgstr " abraza el libro contra el pecho."

msgid "你……过两日到内院来。我给你看一样东西。别告诉爹爹。"
msgstr "Tú... ven al patio interior dentro de un par de días. Quiero enseñarte algo. No se lo digas a papá."

msgid "这上头是……爹爹的名字？你先去见过爹爹再说吧。"
msgstr "Aquí arriba dice... ¿el nombre de papá? Ve primero a ver a papá."

msgid "北宗就我们两个人，打坏了谁教阿桂他们？"
msgstr "En la rama norte solo somos dos; si uno sale herido, ¿quién les enseña a Agui y los demás?"

msgid "师姐！别整天想著练功嘛，我们去花园摘花儿玩嘛？"
msgstr "¡Hermana mayor! No pienses todo el día en entrenar. ¿Vamos al jardín a cortar flores?"

msgid "我才不要，你们去找李教头练吧！"
msgstr "¡Ni loca! ¡Vayan a practicar con el instructor Li!"

msgid "爹爹说过，不能跟你们这些江湖人物比武过招。"
msgstr "Papá dice que no debo medirme en combate con gente del jianghu como ustedes."

msgid "一个满脸风霜之色的老乞丐。\n"
msgstr "Un viejo mendigo de rostro curtido por la intemperie."

msgid "乞丐说道：好心的大爷哪～ 赏我要饭的几文钱吧～\n"
msgstr "El mendigo dice: \"Alma caritativa, unas monedas para este pobre mendigo...\""

msgid "乞丐懒洋洋地打了个哈欠。\n"
msgstr "El mendigo bosteza con desgana."

msgid "乞丐伸手捉住了身上的虱子，骂道：老子身上没几两肉，全叫你们给咬糜了。 \n"
msgstr "El mendigo se atrapa un piojo y refunfuña: \"Ya no me queda carne en el cuerpo, y ustedes me la dejaron hecha papilla.\""

msgid "多谢这位$RESPECT，您好心一定会有好报的！"
msgstr "Gracias, $RESPECT. ¡Tanta bondad sin duda tendrá su recompensa!"

msgid "逄义是封山派中和柳淳风同辈的弟子，但是生性好赌的他并不受师父\n及同门师兄弟的喜爱，因此辈分虽高，却未曾担任门中任何重要职务\n。逄义经常外出，美其名曰：旅行，实则避债，碍于门规又不敢做那\n打家劫舍的勾当，因此经常四处寻找赚钱发财的机会。\n"
msgstr "Pang Yi es un discípulo de la Escuela de la Montaña Vacía de la misma generación que Liu Chunfeng, pero su afición al juego le ganó la antipatía de su Shifu y de sus hermanos de escuela; por eso, pese a su rango, nunca ocupó ningún cargo importante en la escuela. Pang Yi sale a menudo de viaje, o eso dice; en realidad huye de sus deudas, y como las reglas de la escuela no le permiten dedicarse al pillaje, anda siempre buscando alguna ocasión de hacer dinero."

msgid "赚钱"
msgstr "Ganar dinero"

msgid "真的？哪里有钱赚？"
msgstr "¿De verdad? ¿Dónde hay dinero que ganar?"

msgid "发财"
msgstr "Hacerse rico"

msgid "发财我倒不敢想，只要有人肯雇用我，手边有几百两银子就好了。"
msgstr "Hacerme rico ni me atrevo a soñarlo. Con que alguien quisiera contratarme y tuviera unos cientos de taels a mano, me conformaría."

msgid "是的，一天一百两银子，只要不违背侠义道，我可以做任何事。"
msgstr "Así es: cien taels de plata al día, y mientras no vaya contra el código de caballería, haré lo que sea."

msgid "柳淳风是在下同门师兄。"
msgstr "Liu Chunfeng es mi hermano mayor de escuela."

msgid "阁下如果也爱好此道，不如改天兄弟陪阁下玩几手？"
msgstr "Si a usted también le gusta el juego, ¿por qué no echamos unas manos otro día?"

msgid "牌你带回去交给师兄。我没脸拿。"
msgstr "Lleve la placa a mi hermano mayor. No tengo cara para quedármela."

msgid "手里的骰子掉在了桌上。"
msgstr " deja caer sobre la mesa los dados que tenía en la mano."

msgid "……是我的牌。"
msgstr "...Es mi placa."

msgid "上个月手气背，欠了场子里一个姓罗的十二两。他不要银子，只要这块牌，说是拿去「挂两天」。我当他要个彩头。"
msgstr "El mes pasado tuve mala racha y le quedé debiendo doce taels a uno de apellido Luo en la casa de apuestas. No quiso la plata: quería esta placa, para 'tenerla un par de días', dijo. Pensé que la quería de amuleto."

msgid "他拿去雪亭收拜师钱？打的是师兄的旗号？"
msgstr "¿Se la llevó a Pabellón Nevado para cobrar cuotas de ingreso? ¿En nombre de mi hermano mayor?"

msgid "半天没说话，把面前剩的几个筹码推开了。"
msgstr " se queda un buen rato sin hablar y aparta las pocas fichas que le quedan delante."

msgid "门规我没犯过——不偷不抢，不打家劫舍。可牌是我押出去的，这一条赖不掉。你带回去交给师兄，就说逄义认了。"
msgstr "Nunca violé las reglas de la escuela: ni robar, ni asaltar, ni saquear casas. Pero la placa la empeñé yo, y de eso no me libro. Llévela a mi hermano mayor y dígale que Pang Yi lo reconoce."

msgid "什么腰牌？在下的腰牌好好地……"
msgstr "¿Qué placa? Mi placa está aquí, bien..."

msgid "摸了摸腰间，没有说下去。"
msgstr " se palpa la cintura y no termina la frase."

msgid "这里是雪亭镇的街道，往北是一个热闹的广场，南边是条小路通往\n一座林子，东边则有一条小径沿著山腰通往山上，往西是一条比较窄的\n街道，参差不齐的瓦屋之间传来几声犬吠。\n"
msgstr "Esta es una calle de Pabellón Nevado. Al norte hay una plaza muy concurrida; al sur, una vereda lleva a un bosque; al este, un sendero sube por la ladera de la montaña, y al oeste hay una calle más estrecha, desde donde llegan algunos ladridos entre las casas de tejas disparejas."

msgid "这是一条普通的黄土小径，弯弯曲曲往东一路盘旋上山，北边有\n一间城隍庙，往西则是雪亭镇的街道。\n"
msgstr "Es un sendero de tierra amarilla corriente, que serpentea hacia el este montaña arriba. Al norte hay un templo del Dios de la Ciudad, y al oeste, las calles de Pabellón Nevado."

msgid "这是一条普通的黄土小径，小径往西南通往一处山间的平地，从这\n里可以望见不少房屋错落在平地上，往北则一路上山。\n"
msgstr "Es un sendero de tierra amarilla corriente. Hacia el suroeste lleva a un llano entre los montes, donde se ven muchas casas desperdigadas; hacia el norte sigue subiendo la montaña."

msgid "这是一条说宽不宽，说窄倒也不窄的山路，路面用几块生满青苔的\n大石铺成，西面是一段坡地，从这里可以望见西边有几间房屋错落在林\n木间，东面则是山壁，山路往西衔接一条黄土小径，往北则是通往山\n上的石阶。\n"
msgstr "Es un camino de montaña ni ancho ni estrecho, empedrado con unas cuantas piedras grandes cubiertas de musgo. Al oeste hay una pendiente, desde donde se ven algunas casas desperdigadas entre los árboles; al este se alza el paredón. Por el oeste, el camino empalma con un sendero de tierra amarilla, y al norte unos escalones de piedra suben la montaña."

msgid "这是一间十分老旧的城隍庙，在你面前的神桌上供奉著一尊红脸的城\n隍，庙虽老旧，但是神案四周已被香火薰成乌黑的颜色，显示这里必定相\n当受到信徒的敬仰。\n"
msgstr "Es un templo del Dios de la Ciudad muy viejo. En la mesa del altar que tienes delante se venera una imagen del Dios de la Ciudad de cara roja. Aunque el templo es viejo, el humo del incienso dejó negro todo el contorno del altar, prueba de que los fieles le tienen gran devoción."

msgid "你现在正走在雪亭镇的大街，往南直走不远处是镇上的广场，在你\n的东边是一间大宅院，不过正门不在这个方向，往西是一家打铁铺子，\n叮叮当当的声音大老远可以听得到，街道往北边一直通往镇外。\n"
msgstr "Caminas por la calle mayor de Pabellón Nevado. No lejos, todo recto hacia el sur, está la plaza del pueblo. Al este tienes un gran recinto, aunque su puerta principal no da a este lado; al oeste hay una herrería, cuyo martilleo se oye desde muy lejos. La calle sigue al norte hasta salir del pueblo."

msgid "这里是雪亭镇的大街，东边有一栋陈旧的建筑，看起来像是什么店\n铺，但是并没有任何招牌，只有一扇门上面写著一个大大的「当\n」字，往西是一间药铺，大街往南北两个方向延伸。\n"
msgstr "Esta es la calle mayor de Pabellón Nevado. Al este hay un edificio viejo que parece algún tipo de tienda, pero no tiene letrero; solo una puerta con un gran carácter que dice \"Empeño\". Al oeste hay una botica. La calle se extiende hacia el norte y hacia el sur."

msgid "这里是雪亭镇的大街，一条小巷子通往东边，西边则是一间驿站，\n由于雪亭镇来往的商旅、官员并不很多，因此虽然是官府的驿站，也接\n受百姓的信件，大街往北是一处山坳，从这里远远地可以望见北方的野\n羊山，出了山坳就是一条碎石路通往山上。\n"
msgstr "Esta es la calle mayor de Pabellón Nevado. Un callejón lleva al este, y al oeste hay una posta. Como por Pabellón Nevado pasan pocos comerciantes y funcionarios, esta posta, aunque es del gobierno, acepta también las cartas de la gente. Al norte de la calle hay una hondonada, desde donde se divisa a lo lejos, al norte, el Cerro de las Cabras; pasada la hondonada, un camino de grava sube la montaña."

msgid "这里是一处山坳，往南就是雪亭镇，一条蜿蜒的小径往东通往另一\n个邻近的小山村，一块官府立的告示牌立在路旁，上面写著有关野羊山\n土匪出没的警告标志。\n"
msgstr "Es una hondonada entre los montes. Al sur está Pabellón Nevado, y un sendero sinuoso lleva al este hacia otra aldea de montaña cercana. Junto al camino hay un tablón de avisos puesto por el gobierno, con una advertencia sobre los bandidos que rondan el Cerro de las Cabras."

msgid "这是一间谷物加工厂，这里是谷子脱壳成米的地方。米厂老板是一个一\n看就知道是十分精明的干瘦的中年人，老是带着一脸奸笑。你可以看到\n许多人正在忙忙碌碌的工作着，门口挂著一块牌子，往西是通往\n雪亭镇大街的大门。\n"
msgstr "Es un molino de grano, donde se descascara el grano para sacar el arroz. El dueño del molino es un hombre flaco de mediana edad que a simple vista se nota muy astuto, siempre con una sonrisa taimada. Ves a mucha gente trabajando sin parar. En la entrada cuelga una tablilla; al oeste está el portón que da a la calle mayor de Pabellón Nevado."

msgid "这是一间素来以公平信用著称的钱庄，钱庄的老板还是个曾经中过\n举人的读书人，你可以看到钱庄里里外外都打扫得乾乾净净，一个胖胖\n的中年人坐在柜台后面，柜台上放著一块牌子，往东是通往雪亭\n镇大街的大门。\n"
msgstr "Es un banco famoso desde siempre por su trato justo y honrado; su dueño es un hombre de letras que alguna vez aprobó los exámenes provinciales. Todo el banco, por dentro y por fuera, está limpísimo. Un hombre regordete de mediana edad está sentado tras el mostrador, sobre el que hay una tablilla. Al este está la puerta que da a la calle mayor de Pabellón Nevado."

msgid "这是一家中等规模的当铺，老旧的柜台上放著一张木牌，屋\n里的光线不是很亮，往东的出口被一块蓝色布帘遮著，上面有「非请莫\n入」的字样，西边有一扇木雕门通往大街。\n"
msgstr "Es una casa de empeños de tamaño mediano. Sobre el viejo mostrador hay una tablilla de madera. La luz en el cuarto no es mucha. La salida del este está tapada por una cortina de tela azul que dice \"Prohibido el paso sin permiso\"; al oeste, una puerta de madera tallada da a la calle mayor."

msgid "这里是雪亭镇的街道，你的北边有一家客栈，从这里就可以听到客\n栈里人们饮酒谈笑的声音，街道往东不远处有个转角往北，如果你往东\n直走就是上山的小径了，往西则可以走到车马来往络绎不绝的官道。\n"
msgstr "Esta es una calle de Pabellón Nevado. Al norte tienes una posada; desde aquí ya se oyen las voces de la gente que bebe y ríe dentro. No lejos, al este, la calle dobla hacia el norte en una esquina; si sigues recto al este llegarás al sendero que sube la montaña, y al oeste se llega al camino real, por donde no deja de pasar un ir y venir de carros y caballos."

msgid "这是一条宽敞坚实的青石板铺成的大道，路上车马的痕迹已经在路\n面上留下一条条明显的凹痕，往东是一条较小的街道通往雪亭镇，大路\n从这里往北可达水烟阁，往西南穿过黄石隘口则通往戍守京畿重地的天\n驼关。\n"
msgstr "Es un camino ancho y sólido, empedrado con losas de piedra azul; el paso de carros y caballos dejó en él surcos bien marcados. Al este, una calle más pequeña lleva a Pabellón Nevado. Desde aquí, el camino real va al norte hasta el Pabellón de la Neblina y, al suroeste, cruzando el Desfiladero de Piedra Amarilla, hasta el Paso del Camello, que guarda los accesos a la Capital."

msgid "这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从这\n里往北通往水烟阁，往东则是衔接雪亭镇街道的路口。\n"
msgstr "Es un camino ancho y sólido de losas de piedra azul, con árboles y flores plantados en orden a ambos lados. Desde aquí va al norte hasta el Pabellón de la Neblina; al este está el cruce con la calle de Pabellón Nevado."

msgid "这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从这\n里往西通往水烟阁，往南则是衔接雪亭镇街道的路口。\n"
msgstr "Es un camino ancho y sólido de losas de piedra azul, con árboles y flores plantados en orden a ambos lados. Desde aquí va al oeste hasta el Pabellón de la Neblina; al sur está el cruce con la calle de Pabellón Nevado."

msgid "这里是一间宽敞的书院，虽然房子看起来很老旧了，但是打扫得很\n整洁。墙壁上挂著一幅山水画，意境颇为不俗。书院的大门开在北边，\n西边有一扇木门通往边厢。\n"
msgstr "Es una academia espaciosa. Aunque el edificio se ve muy viejo, está muy limpia y ordenada. En la pared cuelga una pintura de paisaje de notable calidad. La puerta de la academia se abre al norte, y al oeste una puerta de madera lleva a un cuarto lateral."

msgid "这里是一间打铁铺子，从火炉中冒出的火光将墙壁映得通红，屋子\n的角落里堆满了各式铁器的完成品或未完成品，像是锄头、铁锤、铲子\n等，叮叮当当的声音敲得满屋子响。\n"
msgstr "Es una herrería. El resplandor de la fragua tiñe de rojo las paredes, y en los rincones se amontonan herramientas de hierro de todo tipo, terminadas o a medio hacer: azadones, martillos, palas... El martilleo resuena por todo el taller."

msgid "这里是一间规模不小的药铺，奇怪的是，在这里你闻不到一丝药铺\n应有的药味，有的只是一股淡淡的檀香，令人觉得心旷神怡，药铺的柜\n台就在店铺靠北的一面，柜台后是一个巨大的药柜， 上面的\n小抽屉只怕有七、八百个之多，但是全部没有贴标签，药铺的出口在东\n边，柜台上贴著一张发黄的纸片。\n"
msgstr "Es una botica bastante grande. Lo curioso es que aquí no se huele ni rastro del olor a medicina que debería tener una botica: solo un suave aroma a sándalo que da gusto respirar. El mostrador está en el lado norte de la tienda y, detrás, un enorme armario de medicinas con quizá setecientos u ochocientos cajoncitos, ninguno con etiqueta. La salida está al este, y en el mostrador hay pegado un papel amarillento."

msgid "这里是负责雪亭镇官府文书跟军令往来的雪亭驿，但是因为出了雪\n亭镇往北的野羊山近年来有盗匪盘据，官府的信差最近都改走东边的飞\n鸢栈道，所以雪亭驿来往的人就少了，驿站的官员索性就开始接一些百\n姓的信件，一方面打发时间，一方面也有点事做以免被上级裁撤。驿站\n大门口上悬著一块木牌，上面写了些字。\n"
msgstr "Esta es la Posta de Pabellón Nevado, encargada de los documentos oficiales y las órdenes militares del pueblo. Pero como en los últimos años unos bandidos se adueñaron del Cerro de las Cabras, al norte del pueblo, los correos oficiales van ahora por la Pasarela del Milano Volador, al este, y por la posta pasa poca gente. Así que los funcionarios de la posta empezaron a aceptar cartas de la gente, en parte para matar el tiempo y en parte para tener algo que hacer y que sus superiores no la cierren. Sobre la puerta de la posta cuelga una tablilla de madera con algo escrito."

msgid "这里是丰登当铺的储藏室，有时候当铺里的大朝奉会把铺里存不下\n的死当货物拿出来拍卖，不过你现在只能看见一个个锁著的箱子。往西\n边穿过一道布帘可以回到当铺店面。\n"
msgstr "Este es el almacén de la Casa de empeños Buena Cosecha. A veces el prestamista mayor saca a remate las prendas no rescatadas que ya no caben en la tienda, pero ahora solo ves cajas cerradas con candado. Al oeste, tras una cortina de tela, se vuelve al local de la casa de empeños."

msgid "这里是一间布置得相当雅致的厢房，从窗子可以看到北边的天井跟\n南边的庭园中各式各样的奇花异草，以及他们所带来的淡淡香气，厢房\n的东面墙上还挂著一幅仕女图，画中是一位宫装美妇，往西\n是通往天井的出口。\n"
msgstr "Es un cuarto lateral amueblado con mucho gusto. Por la ventana se ven las flores y plantas raras del patio, al norte, y del jardín interior, al sur, y llega su suave fragancia. En la pared este cuelga además un retrato de una dama: una bella mujer con ropas de corte. Al oeste está la salida al patio."

msgid "这里是一间整理得相当乾净的书房，红木桌椅上铺著蓝绸巾，显得\n十分考究，西面的立著一个书架，上面放著一排排的古书，往南走出房\n门可以看到天井。\n"
msgstr "Es un estudio muy limpio y ordenado. Sobre la mesa y las sillas de caoba hay paños de seda azul, todo muy refinado. Contra la pared oeste hay una estantería con hileras de libros antiguos. Saliendo por la puerta, al sur, se ve el patio."

msgid "这是一间堆满各式兵器、刀械的储藏室，各式武器都依照种类、长\n短、依次放在一起，并且擦拭得一尘不染，储藏室的出口在你的南边，\n面对出口的左手边有一个架子。\n"
msgstr "Es un almacén lleno de armas y hojas de todo tipo, ordenadas por clase y largo y limpias sin una mota de polvo. La salida del almacén está al sur, y a la izquierda, mirando hacia la salida, hay un estante."

msgid "这里是一间窄小的密室，你的面前只有一个破旧的小床跟一\n些乾草。\n"
msgstr "Es un cuarto secreto estrecho. Delante de ti solo hay una camita vieja y algo de paja seca."

msgid "往左推"
msgstr "Empujar a la izquierda"

msgid "这个架子上空荡荡的，什么都没有。\n"
msgstr "Este estante está vacío; no hay nada en él."

msgid "你将架子往左推...，忽然「喀」一声架子又移回原位。"
msgstr "Empujas el estante hacia la izquierda... y de pronto, con un clic, vuelve a su sitio."

msgid "地板忽然发出轧轧的声音，一块地面缓缓移动著，露出一个向下的阶梯。"
msgstr "De pronto el suelo cruje y rechina; una parte del piso se desliza despacio y deja ver unos escalones que bajan."

msgid "地板忽然发出轧轧的声音，一块地面缓缓移动著，将向下的通道盖住了。"
msgstr "De pronto el suelo cruje y rechina; una parte del piso se desliza despacio y vuelve a tapar el paso hacia abajo."

msgid "药铺"
msgstr "Botica"

msgid "非请莫入"
msgstr "Privado"

msgid "当铺"
msgstr "Empeños"

msgid "驿"
msgstr "Posta"

msgid "打铁铺"
msgstr "Herrería"

msgid "米厂"
msgstr "Molino"

msgid "一把沈重的大钢叉，七根尖刺发出黑黝黝的光芒。\n"
msgstr "Un pesado tridente de acero; sus siete puntas despiden un brillo negro y apagado."

msgid "一个负责看守鬼门关的阴卒，他们是鬼卒中的精锐，负责阻挡想要\n侵入酆都城的妖魔鬼怪。\n"
msgstr "Un guardia del inframundo que custodia la Puerta de los Fantasmas. Es de la élite de los soldados fantasma y se encarga de frenar a los demonios y espíritus que quieren invadir Fengdu."

msgid "阴鬼牙将是守关鬼卒里的精锐，你现在只是一缕鬼魂，打输了会再死一次，再受一次死亡的惩罚。确定要攻击他吗？"
msgstr "Los capitanes fantasma son la élite de los soldados fantasma que guardan la puerta. Ahora no eres más que un alma en pena: si pierdes, morirás otra vez y sufrirás de nuevo el castigo de la muerte. ¿Seguro que quieres atacarlo?"

msgid "白无常伸著长长的舌头瞪著你，死白的脸上看不出任何喜怒哀乐。\n"
msgstr "Impermanencia Blanca te mira fijamente con su larga lengua colgando; en su cara de un blanco mortal no se adivina alegría ni enojo."

msgid "白无常发出一阵像呻吟的声音，当他发现你正注视著他的时候，瞪了你一眼。\n"
msgstr "Impermanencia Blanca suelta un sonido parecido a un gemido; cuando se da cuenta de que lo estás mirando, te fulmina con la mirada."

msgid "白无常把长长的舌头伸出来，缓缓地舔了舔自己又白又长的手指。\n"
msgstr "Impermanencia Blanca saca su larga lengua y se lame despacio los dedos, largos y blancos."

msgid "白无常说道：喂！新来的，你叫什么名字？"
msgstr "Impermanencia Blanca dice: \"¡Oye! Tú, {jugador:el nuevo|la nueva}, ¿cómo te llamas?\""

msgid "白无常用奇异的眼光盯著你，好像要看穿你的一切似的。"
msgstr "Impermanencia Blanca te clava una mirada extraña, como si quisiera ver a través de ti."

msgid "白无常「哼」的一声，从袖中掏出一本像帐册的东西翻看著。"
msgstr "Impermanencia Blanca suelta un \"¡Hmf!\", saca de la manga algo parecido a un libro de cuentas y se pone a hojearlo."

msgid "白无常阁上册子，说道：咦？阳寿未尽？怎么可能？"
msgstr "Impermanencia Blanca cierra el libro: \"¿Eh? ¿Aún no se te acabaron los años de vida? ¿Cómo puede ser?\""

msgid "白无常搔了搔头，叹道：罢了罢了，你走吧。"
msgstr "Impermanencia Blanca se rasca la cabeza y suspira: \"Bueno, bueno, vete ya.\""

msgid "黑无常伸著长长的舌头瞪著你，黝黑的脸上看不出任何喜怒哀乐。\n"
msgstr "Impermanencia Negra te mira fijamente con su larga lengua colgando; en su cara oscura no se adivina alegría ni enojo."

msgid "黑无常发出一阵像呻吟的声音，当他发现你正注视著他的时候，瞪了你一眼。\n"
msgstr "Impermanencia Negra suelta un sonido parecido a un gemido; cuando se da cuenta de que lo estás mirando, te fulmina con la mirada."

msgid "黑无常把长长的舌头伸出来，缓缓地舔了舔自己又黑又长的手指。\n"
msgstr "Impermanencia Negra saca su larga lengua y se lame despacio los dedos, largos y negros."

msgid "喂！阳人来阴间做什么？"
msgstr "¡Oye! ¿Qué viene a hacer un vivo al Inframundo?"

msgid "黑无常说道：喂！新来的，你叫什么名字？"
msgstr "Impermanencia Negra dice: \"¡Oye! Tú, {jugador:el nuevo|la nueva}, ¿cómo te llamas?\""

msgid "黑无常用奇异的眼光盯著你，好像要看穿你的一切似的。"
msgstr "Impermanencia Negra te clava una mirada extraña, como si quisiera ver a través de ti."

msgid "这里是一条漫长的石桥，往南石桥延伸进大雾之中，望不到尽头，\n往北引隐约约有一座城楼，不过你分不清是真实的影像还是幻觉，东西\n两面都是一望无际的大雾，一阵阵阴冷的微风从雾中吹过。\n"
msgstr "Es un larguísimo puente de piedra. Al sur se pierde en una niebla espesa, sin que se le vea el final; al norte se adivina una torre de muralla, aunque no sabes si es real o una ilusión. Al este y al oeste solo hay niebla sin fin, y una brisa fría y lúgubre sopla una y otra vez entre la niebla."

msgid "你现在正站在一条极长的石桥上，桥头一块石碑上面刻著「奈何桥\n」三个古篆，东、西两面都是大雾，连桥底下是不是水都看不到，浓雾\n中有许多朦胧的人影鱼贯地向北走去，奈何桥往南延伸到一片大雾之中\n，北边引隐约约有一座城楼的影子。\n"
msgstr "Estás sobre un puente de piedra larguísimo. En una estela de piedra, a la entrada del puente, hay grabados tres antiguos caracteres de sello: \"Puente del Desamparo\". Al este y al oeste todo es niebla, tan espesa que ni siquiera se ve si hay agua bajo el puente. En la niebla, muchas siluetas borrosas avanzan en fila hacia el norte. El Puente del Desamparo se pierde al sur en la niebla, y al norte se adivina la sombra de una torre de muralla."

msgid "这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大的\n黑色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关就无法再\n回阳间了。\n"
msgstr "Esta es la famosa entrada del Inframundo, la Puerta de los Fantasmas. Ante ti se alza una alta torre negra. Muchas almas de difuntos avanzan en fila entre llantos, porque quien cruza la Puerta de los Fantasmas ya no puede volver al mundo de los vivos."

msgid "你现在来到一座黑色城楼之前，城楼上刻著三个大字：酆都城。往\n南不远处有一座桥，桥上鬼影幢幢，但是却听不到半点声音，往北走进\n城楼只见一片黑漆漆的，只有少许暗红色的火光若隐若现地闪烁著。\n"
msgstr "Llegas ante una torre negra. En ella hay grabados tres grandes caracteres: Fengdu. No lejos, al sur, hay un puente atestado de sombras fantasmales, pero no se oye ni el menor ruido. Al norte, al entrar en la torre, todo es negrura, con apenas unos destellos de fuego rojo oscuro que aparecen y desaparecen."

msgid "你走在一条阴森森的路上, 浓浓的雾环绕在你的四周, 好像永\n远都不会散去似的. 往南看去你勉强可以分辨出一个城楼的模样,\n往北隐约可以看到几盏灯笼, 在浓雾中显得格外的诡异. 路的两旁\n各有一栋木造的建筑, 门都是半开的, 但你看不清楚里面有什么.\n\n"
msgstr "Caminas por un camino lúgubre; una niebla espesa te rodea, como si nunca fuera a disiparse. Mirando al sur apenas distingues la forma de una torre de muralla; al norte se ven vagamente unos cuantos faroles, extrañamente siniestros en la niebla. A cada lado del camino hay una construcción de madera con la puerta entornada, pero no alcanzas a ver qué hay dentro."

msgid "你一进来就发现屋里异常的温暖, 墙角壁炉里微弱的火光将你\n的影子投射在对面的墙上. 几个人影围在炉旁不知在讨\n论些什么. 屋内有几张木桌, 椅, 墙上挂了几幅字画, 一切看来非\n常的详和宁静, 你几乎忘了自己身在何处.\n \n"
msgstr "Nada más entrar notas que la habitación está extrañamente tibia. El débil resplandor de la chimenea del rincón proyecta tu sombra en la pared de enfrente. Unas cuantas siluetas rodean la chimenea, hablando de quién sabe qué. Hay varias mesas y sillas de madera, y en las paredes cuelgan algunas pinturas y caligrafías; todo se ve tan apacible y sereno que casi olvidas dónde estás."

msgid "屋里相当冷清, 外面的浓雾还不时地从半开著的门缝飘进来,\n地面上散著一些破旧的物品, 不过光从外表已经无法分辨出那是些\n什么东西了. 墙上刻著一些潦草的字体, 墙角的一盏灯笼挣\n扎似地发出一阵阵微弱的光芒, 也始得那些字看来格外的诡异.\n\n"
msgstr "La habitación está bastante desolada; la niebla de fuera se cuela de vez en cuando por la puerta entornada. Por el suelo hay tirados algunos objetos viejos y rotos, pero ya no se puede saber qué eran solo con mirarlos. En la pared hay unas letras garabateadas, y un farol en el rincón, como luchando por no apagarse, despide un brillo débil e intermitente que hace que esas letras se vean aún más siniestras."

msgid "你走在一条阴森森的路上, 浓浓的雾环绕在你的四周, 好像永\n远都不会散去似的. 整条路前后只看到零星的几盏灯笼........\n \n"
msgstr "Caminas por un camino lúgubre; una niebla espesa te rodea, como si nunca fuera a disiparse. En todo el camino, de punta a punta, solo se ven unos pocos faroles dispersos..."

msgid "浓雾在这里聚成一堵墙，路到这里就断了。\n"
msgstr "Aquí la niebla se apiña hasta formar un muro, y el camino se corta."

msgid "一个空洞的声音在你耳边响起...."
msgstr "Una voz hueca resuena junto a tu oído..."

msgid "没有回头路了!"
msgstr "¡No hay vuelta atrás!"

msgid "你走著走著..... 发现四周景色居然都没有变...."
msgstr "Caminas y caminas... y descubres que el paisaje a tu alrededor no ha cambiado en absoluto..."

msgid "从你站的位置很难辨别出那几个人的容貌, 四个披著黑斗蓬的人斜靠在壁\n炉边的角落, 偶尔传来其中几人说话的声音, 不过从这个距离你无法听到\n他们讨论的内容. 当你还在考虑要不要靠过去一点时, 其中一人回头看了\n你一眼, 你愣住了... 那人... 那人......... 居然长得跟你一模一样!\n"
msgstr "Desde donde estás es difícil distinguir las caras de esas personas: cuatro figuras con capas negras se recuestan en el rincón junto a la chimenea; de vez en cuando se oye hablar a alguna, pero a esta distancia no alcanzas a oír de qué hablan. Mientras todavía dudas si acercarte un poco más, una de ellas voltea a mirarte, y te quedas de piedra... Esa persona... esa persona... ¡es idéntica a ti!"

msgid "几行你勉强分辨得出来的字:\n我被困在这里了.... 我要回家啦!!!!!!!!!!!\n                      ^^^^\n                        靠自己啦...\n什么叫靠自己啊?!?!? 这里连个活人都没有...\n\n看到你自己时问一下吧... 自己人都会互相帮忙的说.. \n                                    ^^^^\n                                 你... 确... 定?!?!\n喔.. \n"
msgstr "Unas líneas que apenas alcanzas a descifrar:\nEstoy atrapado aquí... ¡¡¡Quiero ir a casa!!!\n                                      ^^^^\n                                        Cuenta contigo mismo...\n¿¿¡¡Cómo que contar conmigo mismo!!?? Aquí no hay ni un alma viva...\n\nPregunta cuando te veas a ti mismo... Uno siempre ayuda a los suyos, digo..\n                                                  ^^^^^\n                                               ¿¡Se... gu... ro!?\nAh.."

msgid "打听「回家」"
msgstr "Preguntar por \"Volver a casa\""

msgid "你走上前去, 低声的向那个长得跟你一样的人询问回家的事.\n"
msgstr "Te adelantas y, en voz baja, le preguntas a esa persona idéntica a ti cómo volver a casa."

msgid "那人一句话也不说就往你这边撞过来, 你眼前一阵黑....\n"
msgstr "Sin decir palabra, esa persona se abalanza contra ti, y todo se vuelve negro..."

msgid "$N用後腿往$n的$l用力一蹬"
msgstr "$N{:el} {N:lanzas|lanza} con las patas traseras una fuerte patada contra {n:ti|$n{:el}}, directo a {n:tu|su} $l{:0}"

msgid "蹬"
msgstr "Patada"

msgid "咬伤"
msgstr "mordedura"

msgid "$N扑上来张嘴往$n的$l狠狠地一咬"
msgstr "$N{:el} {N:te abalanzas|se abalanza} sobre {n:ti|$n{:el}} y {N:lanzas|lanza} una feroz dentellada a {n:tu|su} $l{:0}"

msgid "咬"
msgstr "Mordisco"

msgid "$N用爪子往$n的$l一抓"
msgstr "$N{:el} {N:lanzas|lanza} un zarpazo contra {n:ti|$n{:el}}, directo a {n:tu|su} $l{:0}"

msgid "抓"
msgstr "Zarpazo"

msgid "$N用嘴往$n的$l一啄"
msgstr "$N{:el} {N:lanzas|lanza} un picotazo contra {n:ti|$n{:el}}, directo a {n:tu|su} $l{:0}"

msgid "啄"
msgstr "Picotazo"

msgid "$N攻击$n的$l"
msgstr "$N{:el} {N:lanzas|lanza} un ataque contra {n:ti|$n{:el}}, directo a {n:tu|su} $l{:0}"

msgid "对白自动继续"
msgstr "Avance automático del diálogo"

msgid "对白自动继续已生效，但未能保存。"
msgstr "El avance automático del diálogo se aplicó, pero no se pudo guardar el ajuste."

msgid "剧情演出和大段讲述里，一句话读完的时间到了就自己到下一句；关掉后每一句都等你按键。打听、问话和选择始终等你"
msgstr "En las escenas de la historia y en los relatos largos, cada frase pasa sola a la siguiente cuando hubo tiempo de leerla; si lo desactivas, cada frase espera a que pulses una tecla. Preguntar, interrogar y elegir siempre te esperan"

msgid "下一句"
msgstr "Siguiente"

msgctxt "lit"
msgid "子时"
msgstr "medianoche"

msgctxt "lit"
msgid "钥匙"
msgstr "llave"

msgctxt "lit"
msgid "布条"
msgstr "tira de tela"

msgctxt "lit"
msgid "老松岭"
msgstr "Cerro de los Pinos Viejos"

msgctxt "lit"
msgid "老松寨"
msgstr "Fuerte de los Pinos Viejos"

msgid "【长大】你{age}岁了：气的上限多了 {kee} 点，精的上限多了 {gin} 点。"
msgstr "[Crecimiento] Ya tienes {age} años: tu Qi máximo subió en {kee} y tu Esencia máxima, en {gin}."

msgid "黑焰鞭影"
msgstr "Látigo de llama negra"

msgid "侮天鬼身上那条黑焰的出手：焰舌一吐、焰卷一缠、焰星一溅，都是快的，一下接一下，不蓄势，也不停。"
msgstr "Así ataca la llama negra que envuelve a Desafiacielos: una lengua de llama que se dispara, un remolino de llama que se enrosca, chispas de llama que salpican; todo rápido, un golpe tras otro, sin tomar impulso y sin detenerse."

msgid "$N肩上的黑焰一吐，一道「焰舌」直舔$n的$l"
msgstr "La llama negra de {N:tus hombros|los hombros de $N{:el}} se dispara: una «Lengua de llama» va directo hacia {n:ti|$n{:el}}, a {n:tu|su} $l{:0}"

msgid "$N手中$w一卷，「焰卷」贴着地面缠向$n的$l"
msgstr "$N{:el} {N:enroscas|enrosca} $w{:el} y un «Remolino de llama» se desliza pegado al suelo hacia {n:ti|$n{:el}}, a {n:tu|su} $l{:0}"

msgid "$N$w一抖，迸出点点「焰星」，溅向$n的$l"
msgstr "$N{:el} {N:sacudes|sacude} $w{:el} y {N:haces|hace} saltar «Chispas de llama» contra {n:ti|$n{:el}}, a {n:tu|su} $l{:0}"

msgid "你把穿灵收在身边，剑身上的霜一点一点化了。你练的是拳，空着手迎上去。\n"
msgstr "Guardas Traspasalmas a tu lado, y la escarcha de la hoja se va derritiendo poco a poco. Lo tuyo es el puño: sales a su encuentro con las manos vacías.\n"

msgid "镖单？先把山门的事办了。"
msgstr "¿El registro de escolta? Primero ocúpate del asunto de la puerta de la montaña."

msgid "什么镖单？"
msgstr "¿Qué registro de escolta?"

msgid "盟主"
msgstr "Líder de la Alianza"

msgid "盟主的事，七长老做主了。执事有执事的公事。"
msgstr "Del Líder de la Alianza se ocupa el Séptimo Anciano. Un intendente tiene sus deberes de intendente."

msgid "等。他回来，或者不回来，椅子都是他的。"
msgstr "Espera. Vuelva o no vuelva, el sillón es suyo."

msgid "京师的事了结了，盟主还是没有回来。七长老常下楼来看那把椅子——你出去走一走，他再下来的时候，你在厅里。"
msgstr "Lo de la Capital está resuelto y el Líder de la Alianza sigue sin volver. El Séptimo Anciano baja a menudo a mirar ese sillón. Sal a dar una vuelta; cuando vuelva a bajar, estate en el salón."

msgid "二十年前带走盟主的是兵部的白衣武官。线索在京师尚书府——我出不了水烟阁，你替我记着。"
msgstr "Quien se llevó al Líder de la Alianza hace veinte años fue un oficial de blanco del Ministerio de Guerra. La pista está en la residencia del ministro, en la Capital. Yo no puedo salir del Pabellón de la Neblina; llévalo tú en la memoria por mí."

msgid "看了一眼厅侧坐着的那个白发老人，压低了声音。"
msgstr " lanza una mirada al anciano de pelo blanco sentado a un lado del salón y baja la voz."

msgid "陈天星查清了：那趟镖是兵部点名改走老松岭的。兵部知道盟主哪一天过岭。"
msgstr "Chen Tianxing lo ha aclarado: fue el Ministerio de Guerra el que ordenó, por su nombre, que esa escolta cambiara de ruta por el Cerro de los Pinos Viejos. El Ministerio sabía qué día cruzaría el cerro el Líder de la Alianza."

msgid "人回来了，椅子还空着。七长老这几天常下楼来，站在那把椅子跟前。"
msgstr "El hombre ha vuelto y el sillón sigue vacío. Estos días el Séptimo Anciano baja a menudo y se queda de pie ante ese sillón."

msgid "你出去走一走；他再下来的时候，你在厅里。"
msgstr "Sal a dar una vuelta; cuando él vuelva a bajar, estate en el salón."

msgid "那张镖单我锁起来了，可上面那条路我看过：本该走官道，却改走了老松岭——改路的人，知道盟主哪一天过岭。"
msgstr "Ese registro de escolta lo guardé bajo llave, pero la ruta que traía la he visto: debía ir por el camino real y la cambiaron por el Cerro de los Pinos Viejos. Quien cambió la ruta sabía qué día cruzaría el cerro el Líder de la Alianza."

msgid "合上卷宗，看了一眼大厅中央那张黝黑的太师椅。"
msgstr " cierra el expediente y mira el oscuro sillón del centro del salón."

msgid "山门和镖单的事你都办过了。盟主的事，也该同你说了。"
msgstr "Del asunto de la puerta de la montaña y del registro ya te has ocupado. Ahora toca hablarte del Líder de la Alianza."

msgid "二十年前，先帝召盟主进京。盟主带着阁里藏的一份旧记载上路，五长老押着盟主印随行，振远的镖走在前头。过了老松岭，一个人也没回来。"
msgstr "Hace veinte años, el difunto emperador convocó al Líder de la Alianza a la Capital. El Líder partió con un viejo registro guardado en el Pabellón; el Quinto Anciano lo acompañó custodiando el sello de la Alianza, y la escolta del Largo Camino iba delante. Pasado el Cerro de los Pinos Viejos, no volvió nadie."

msgid "老松岭下的樵夫说，那天岭上来过一队穿白衣的武官。白衣，腰里挂的是兵部的刀。"
msgstr "El leñador de la falda del Cerro de los Pinos Viejos contó que ese día subió al cerro una tropa de oficiales vestidos de blanco, con el sable del Ministerio de Guerra al cinto."

msgid "京师的事有了结果，庾子建那边也有了说法——可盟主没有回来。椅子还空着。"
msgstr "Lo de la Capital tiene ya resultado y Yu Zijian ha dado su versión, pero el Líder de la Alianza no ha vuelto. El sillón sigue vacío."

msgid "七长老这几天常下楼来，站在那把椅子跟前。你出去走一走；他再下来的时候，你在厅里。"
msgstr "Estos días el Séptimo Anciano baja a menudo y se queda de pie ante ese sillón. Sal a dar una vuelta; cuando él vuelva a bajar, estate en el salón."

msgid "二十年来，兵部尚书一直是庾子建。盟主要是还活着，线索在京师——尚书府。"
msgstr "En estos veinte años el ministro de Guerra ha sido siempre Yu Zijian. Si el Líder aún vive, la pista está en la Capital: en la residencia del ministro."

msgid "这件事我出不了水烟阁：执法使一动，七长老就要问为什么。你替我记着。"
msgstr "Yo no puedo salir del Pabellón de la Neblina: si el Ejecutor se mueve, el Séptimo Anciano preguntará por qué. Llévalo tú en la memoria por mí."

msgid "盟主的事……等山门和镖单的事办完了，我再同你说。"
msgstr "Lo del Líder de la Alianza... cuando termines con el asunto de la puerta de la montaña y el del registro, te lo cuento."

msgid "盟主二十年没回来了。这件事，水烟阁不同外人说。"
msgstr "El Líder de la Alianza lleva veinte años sin volver. Esto el Pabellón de la Neblina no lo habla con forasteros."

msgid "椅子"
msgstr "Sillón"

msgid "站潘军禅：等盟主回来。\n正月十七，天邪派在虹台上的那一票投旧盟主——卫沧澜回来了是他本人，没回来就是那把空椅子（已经入了虹台的席的，这一票不再跟着变）。潘军禅以执法使的名义升你执事；颜违会记下你，正月十七那天，他的人会多出一件事来。\n这是天邪这条线的大分裂，选了不能改。要站潘军禅吗？"
msgstr "Ponerte del lado de Pan Junchan: esperar a que vuelva el Líder de la Alianza.\nEl 17 del primer mes, en la Terraza del Arcoíris, el voto de la Escuela Rebelde va para el antiguo Líder de la Alianza: Wei Canglan en persona si ha vuelto, o ese sillón vacío si no (si ya has tomado asiento en la Terraza del Arcoíris, este voto ya no cambia). Pan Junchan te asciende a Intendente en nombre del Ejecutor; Yan Wei te tendrá anotado, y ese 17 su gente tendrá una tarea más.\nEs la gran división de la línea Rebelde y, una vez elegida, no se puede cambiar. ¿Ponerte del lado de Pan Junchan?"

msgid "椅子是盟主的。正月十七，天邪派那一票，你我一起投。"
msgstr "El sillón es del Líder. El 17 del primer mes, el voto de los Rebeldes lo daremos juntos, tú y yo."

msgid "你站到七长老那边去了。执事的公事，照办就是。"
msgstr "Te has puesto del lado del Séptimo Anciano. Los deberes de un intendente se cumplen como se ordenan, y punto."

msgid "看了你很久，才笑了一下——这一回的笑，和平时不一样。"
msgstr " te mira largo rato y solo entonces sonríe un poco: esta vez la sonrisa no es la de siempre."

msgid "好。门规里没有哪一条，写着盟主没死、椅子能换人。"
msgstr "Bien. En el reglamento de la escuela no hay un solo artículo que diga que, si el Líder no ha muerto, el sillón puede cambiar de dueño."

msgid "从今日起，你是水烟阁的执事。正月十七，天邪派那一票，等盟主。"
msgstr "Desde hoy eres Intendente del Pabellón de la Neblina. El 17 del primer mes, el voto de los Rebeldes espera al Líder de la Alianza."

msgid "七长老那里，往后说话小心些——他记性好。"
msgstr "Con el Séptimo Anciano, de ahora en adelante habla con cuidado: tiene buena memoria."

msgid "盟主的椅子，空了二十年了。"
msgstr "El sillón del Líder lleva veinte años vacío."

msgid "票是我唱的。唱完了，就是定了。"
msgstr "El voto lo proclamé yo. Proclamado, queda decidido."

msgid "天邪这一票，正月十七照你说的。"
msgstr "El voto de los Rebeldes, el 17 del primer mes, será como tú digas."

msgid "脸上没有什么表情。"
msgstr " no muestra ninguna expresión."

msgid "你站了颜长老。天邪这一票，长老们说投他，就投他。"
msgstr "Apoyaste al Anciano Yan. El voto de los Rebeldes: si los ancianos dicen que se le dé, se le da."

msgid "……执事要是想自己坐那把椅子，天邪这一票也是执事的。公事公办。"
msgstr "...Si el Intendente quiere sentarse él mismo en ese sillón, el voto de los Rebeldes también es suyo. Asunto de oficio, trato de oficio."

msgid "等盟主回来。我说过的话不改。"
msgstr "Esperaré al Líder de la Alianza. No cambio lo que dije."

msgid "你是执事。你要这一票，你开口。"
msgstr "Eres Intendente. Si quieres este voto, pídelo."

msgid "盟主回来了，就坐在厅里。天邪这一票，投他。"
msgstr "El Líder de la Alianza ha vuelto y está sentado en el salón. El voto de los Rebeldes es para él."

msgid "二十年没管过事又怎样？那把椅子是他的。"
msgstr "¿Y qué si lleva veinte años sin ocuparse de nada? Ese sillón es suyo."

msgid "望了一眼正厅那把空着的太师椅。"
msgstr " mira el sillón vacío del salón principal."

msgid "盟主没有回来。厅里是颜长老在管事——长老们的意思，天邪这一票投他。"
msgstr "El Líder de la Alianza no ha vuelto. En el salón manda el Anciano Yan; los ancianos quieren que el voto de los Rebeldes sea para él."

msgid "我一个执法使，拦不住。"
msgstr "Yo, un simple Ejecutor, no puedo impedirlo."

msgid "正月十七……盟主的事还没有着落，说虹台早了。"
msgstr "El 17 del primer mes... lo del Líder de la Alianza aún no está resuelto; hablar de la Terraza del Arcoíris es prematuro."

msgid "请潘军禅把天邪派这一票交给你：正月十七虹台上，天邪听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir a Pan Junchan que te entregue el voto de la Escuela Rebelde: el 17 del primer mes, en la Terraza del Arcoíris, los Rebeldes harán lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "说过了。天邪听你的。"
msgstr "Dicho está. Los Rebeldes harán lo que digas."

msgid "沉默了一会儿。"
msgstr " guarda silencio un rato."

msgid "好。天邪这一票，执事说了算。"
msgstr "Bien. El voto de los Rebeldes lo decide el Intendente."

msgid "信我收下了。"
msgstr "Me quedo con la carta."

msgid "信我收下了。山门的事，不劳你了。"
msgstr "Me quedo con la carta. Del asunto de la puerta de la montaña ya no tienes que ocuparte."

msgid "展开信看了一遍，半晌没有说话。"
msgstr " despliega la carta, la lee de principio a fin y pasa un buen rato sin decir nada."

msgid "字是七长老身边账房的笔迹。……颜长老在数人头：哪几派来，椅子空不空，阁里谁跟谁走得近——数到我头上来了。"
msgstr "La letra es del contable que sirve al Séptimo Anciano. ...El Anciano Yan está contando cabezas: qué escuelas vendrán, si el sillón está vacío, quién anda con quién en el Pabellón... y ya ha llegado a contarme a mí."

msgid "数人头不犯门规。可派人扮成外人上山，数到自己阁里来——这件事，我记下了。"
msgstr "Contar cabezas no rompe el reglamento. Pero mandar gente disfrazada de forasteros a la montaña para contar las de nuestro propio pabellón... eso lo anoto."

msgid "展开信看了一遍，脸上的笑没了。"
msgstr " despliega la carta, la lee y la sonrisa se le borra del rostro."

msgid "纸是兵部的公文纸，裁去了抬头。他们想知道两件事：椅子空着没有，卫盟主还在不在。"
msgstr "El papel es papel oficial del Ministerio de Guerra, con el encabezado recortado. Quieren saber dos cosas: si el sillón sigue vacío y si el Líder Wei sigue vivo."

msgid "兵部的人扮成皮货商上水烟阁打听盟主——二十年来，这是头一回。有人在京师，替盟主的生死记着账。"
msgstr "Gente del Ministerio de Guerra, disfrazada de peleteros, viene al Pabellón de la Neblina a preguntar por el Líder: en veinte años, es la primera vez. En la Capital hay quien lleva la cuenta de su vida y su muerte."

msgid "镖单你已经给了陈总镖头。这一张存根，你自己留着。"
msgstr "El registro de escolta ya se lo diste al Jefe Chen, el jefe general de escoltas. Este talón guárdalo tú."

msgid "刑堂里已经锁着一张了。"
msgstr "En la sala de castigos ya hay uno guardado bajo llave."

msgid "把镖单交给潘军禅，锁进水烟阁的刑堂。\n振远的脸面保住了，这件事到此为止——陈天星不会再查。\n镖单只有一张。交给他吗？"
msgstr "Entregar el registro de escolta a Pan Junchan, para que lo guarde bajo llave en la sala de castigos del Pabellón de la Neblina.\nEl buen nombre del Largo Camino queda a salvo y el asunto termina aquí: Chen Tianxing no seguirá investigando.\nSolo hay un registro. ¿Se lo entregas?"

msgid "接过镖单看了一遍，折好收进了袖里。"
msgstr " recibe el registro, lo lee de principio a fin, lo dobla y se lo guarda en la manga."

msgid "锁进刑堂。振远的脸面，水烟阁替他们留着。"
msgstr "Bajo llave en la sala de castigos. El Pabellón de la Neblina le guarda al Largo Camino su buen nombre."

msgid "陈剑秋那里，我派人去说一声。二十年了，他也该睡个好觉。"
msgstr "Enviaré a alguien a avisar a Chen Jianqiu. Veinte años... ya es hora de que duerma bien."

msgid "振远的东西，你自己收好。"
msgstr "Lo del Largo Camino, guárdalo tú."

msgid "执法使"
msgstr "Ejecutor"

msgid "於兰前辈入了朝，萧师兄……没有回来。水烟阁不能没有收徒的人，我以执法使的名义代收。天邪派门规甚严，$RESPECT如果真的有心，且发个誓来。"
msgstr "El veterano Yulan entró en la corte y el hermano mayor Xiao... no ha vuelto. El Pabellón de la Neblina no puede quedarse sin quien acepte discípulos; yo, en nombre del Ejecutor, los acepto en su lugar. Las reglas de la Escuela Rebelde son muy estrictas: si de verdad lo deseas, $RESPECT, haz primero un juramento."

msgid "执法使代收，也是照门规收。不发誓，不收。"
msgstr "Que el Ejecutor acepte en su lugar es aceptar también según el reglamento. Sin juramento, no hay admisión."

msgid "好。师父不在，执法使替他们看着你。"
msgstr "Bien. Tu maestro no está; el Ejecutor velará por ti en su lugar."

msgid "冲你点了点头，没有笑。"
msgstr " te saluda con un movimiento de cabeza, sin sonreír."

msgid "从楼上下来，走到大厅中央那张黝黑的太师椅跟前，伸手在扶手上按了一按。"
msgstr " baja de la planta alta, camina hasta el oscuro sillón del centro del salón y presiona el brazo del sillón con la mano."

msgid "这个「代」字，本座顶了这些日子，也该去掉了。正月十七九派上虹台，水烟阁要有一个真正坐这把椅子的人。"
msgstr "Este «en funciones» que llevo pegado tantos días ya es hora de quitármelo. El 17 del primer mes las nueve escuelas subirán a la Terraza del Arcoíris, y el Pabellón de la Neblina necesita a alguien que se siente de verdad en ese sillón."

msgid "二十年了，这把椅子一直空着。正月十七九派上虹台，水烟阁总得拿出个说法——椅子空着，武林就没有一个能说话的人。"
msgstr "Veinte años lleva vacío ese sillón. El 17 del primer mes, cuando las nueve escuelas suban a la Terraza del Arcoíris, el Pabellón de la Neblina tendrá que dar alguna explicación: con el sillón vacío, el wulin no tiene a nadie que hable por él."

msgid "坐在厅侧的一张矮凳上，手里还拿着那本诗集，没有抬头。"
msgstr " está sentado en un taburete bajo a un lado del salón, con el libro de poemas aún en la mano, sin levantar la cabeza."

msgid "盟主回来了，本座比谁都高兴。可一个二十年没管过事的人，正月十七上了虹台，九派问他这二十年武林是什么样子——他答得上来么？"
msgstr "Que el Líder haya vuelto me alegra más que a nadie. Pero un hombre que lleva veinte años sin ocuparse de nada, cuando suba el 17 a la Terraza del Arcoíris y las nueve escuelas le pregunten cómo ha estado el wulin estos veinte años... ¿sabrá responder?"

msgid "椅子空着，是因为盟主还没回来。"
msgstr "El sillón está vacío porque el Líder de la Alianza aún no ha vuelto."

msgid "二十年了，执法使。人要是回得来，早就回来了。"
msgstr "Veinte años, Ejecutor. Si pudiera volver, ya habría vuelto."

msgid "九派里几派会来，阁里谁跟谁走得近——本座心里有数。山门上跑掉的那一个，没有白跑。"
msgstr "Cuántas de las nueve escuelas vendrán y quién anda con quién en el Pabellón, yo lo tengo claro. El que se escapó en la puerta de la montaña no se escapó en vano."

msgid "上个月山门上那个探子，听说是从执法使眼皮底下走的？椅子空着，外人就敢上山来问盟主的死活。"
msgstr "Dicen que el espía de la puerta de la montaña, el mes pasado, se fue delante de las narices del Ejecutor. Con el sillón vacío, hasta los forasteros se atreven a subir a preguntar si el Líder vive o muere."

msgid "上个月扮成皮货商上山来数人头的，是七长老账房里的人。"
msgstr "Quien subió el mes pasado disfrazado de peletero a contar cabezas era gente de la contaduría del Séptimo Anciano."

msgid "数人头不犯门规。正月十七几派来、椅子空不空，总得有人去数。"
msgstr "Contar cabezas no rompe el reglamento. Alguien tiene que contar cuántas escuelas vienen el 17 y si el sillón está vacío."

msgid "上个月山门上拿下的那个，是兵部的人。京师有人替盟主的生死记着账。"
msgstr "El que cayó el mes pasado en la puerta de la montaña era del Ministerio de Guerra. En la Capital hay quien lleva la cuenta de la vida y la muerte del Líder."

msgid "所以更要早定。椅子空一天，朝廷就多一天的念想。"
msgstr "Por eso hay que decidir cuanto antes. Cada día que el sillón sigue vacío, la corte tiene un día más de esperanza."

msgid "陈天星查清了：二十年前那趟镖，是兵部点名改走老松岭的。"
msgstr "Chen Tianxing lo ha aclarado: la escolta de hace veinte años cambió de ruta por el Cerro de los Pinos Viejos por orden expresa del Ministerio de Guerra."

msgid "查清了又如何？水烟阁不能为一趟镖跟朝廷耗二十年。正月十七之后，旧案到此为止。"
msgstr "¿Y qué si lo ha aclarado? El Pabellón de la Neblina no puede pasar veinte años enfrentado a la corte por una escolta. Pasado el 17 del primer mes, el viejo caso termina aquí."

msgid "镖单锁进了刑堂——执法使自己也知道，有些旧案，到此为止最好。"
msgstr "El registro de escolta está bajo llave en la sala de castigos. El propio Ejecutor sabe que hay casos viejos que es mejor dejar donde terminan."

msgid "锁起来，是替振远留脸面，不是替谁结案。"
msgstr "Bajo llave es para que el Largo Camino conserve su buen nombre, no para cerrar el caso de nadie."

msgid "盟主回来了。他坐不坐这把椅子，正月十七由他自己说，轮不到别人替他定。"
msgstr "El Líder ha vuelto. Si se sienta o no en este sillón, lo dirá él mismo el 17 del primer mes; no le toca a otro decidirlo por él."

msgid "盟主一天没有消息，这把椅子就一天是盟主的。等他回来。"
msgstr "Mientras no haya noticias del Líder, el sillón es suyo. Esperémoslo."

msgid "转过身来，看着你。"
msgstr " se vuelve y te mira."

msgid "你是天邪这一辈的大弟子。正月十七，天邪派那一票该投给谁，你说一句。跟着本座，水烟阁的执事有你一个。"
msgstr "Eres {jugador:el discípulo mayor|la discípula mayor} de esta generación Rebelde. El 17 del primer mes, di a quién debe ir el voto de la Escuela Rebelde. Si me sigues, entre los intendentes del Pabellón de la Neblina habrá uno que eres tú."

msgid "七长老许得出口的，我许不出口。我只问你一句：门规里哪一条，写着盟主没死，椅子就能换人？"
msgstr "Lo que el Séptimo Anciano puede prometer, yo no puedo. Solo te hago una pregunta: ¿en qué artículo del reglamento dice que, si el Líder no ha muerto, el sillón puede cambiar de dueño?"

msgid "绝尘子本为释家人，后得奇人指点，得悟道家真谛，佛道双修，\n皆入化境。后访遍名山大川，自号绝尘，创此绝尘一派。\n"
msgstr "Juechenzi era en origen un budista; más tarde, guiado por una persona extraordinaria, alcanzó a comprender la verdad del taoísmo y cultivó a la vez ambos caminos hasta dominarlos por completo. Después recorrió las montañas y los ríos famosos, se dio a sí mismo el nombre de Juechen y fundó la Escuela del Desapego.\n"

msgid "祖师"
msgstr "Fundador"

msgid "绝尘子道：你为何无故滋事，误我清修！\n"
msgstr "Juechenzi dice: \"¿Por qué buscas pleito sin motivo y estorbas mi retiro?\"\n"

msgid "绝尘子道：贫道向以遁世为乐，你何苦如此相逼？\n"
msgstr "Juechenzi dice: \"Este humilde taoísta siempre se ha complacido en vivir apartado del mundo. ¿Por qué me acosas así?\"\n"

msgid "绝尘派是我所创，你有何指教？"
msgstr "La Escuela del Desapego la fundé yo. ¿Qué tienes que decirme?"

msgid "入我派者，需有慧根。"
msgstr "Quien entre en mi escuela necesita una buena raíz de sabiduría."

msgid "我便是绝尘子。"
msgstr "Soy Juechenzi."

msgid "绝尘派不问世事。"
msgstr "La Escuela del Desapego no se ocupa de los asuntos del mundo."

msgid "洞里的事，你都知道了。"
msgstr "Lo de la cueva ya lo sabes todo."

msgid "闭着眼睛听你说完，过了很久才睁开。"
msgstr " escucha con los ojos cerrados hasta que terminas y pasa un largo rato antes de abrirlos."

msgid "洞里有东西，老道知道。"
msgstr "En la cueva hay algo. Este viejo taoísta lo sabe."

msgid "那道门拴着，阵守得住石室——老道就不管。"
msgstr "Esa puerta tiene el cerrojo echado y la formación sostiene la cámara de piedra. Este viejo taoísta no interviene."

msgid "又闭上了眼睛。"
msgstr " vuelve a cerrar los ojos."

msgid "青石村？绝尘派不问世事。"
msgstr "¿Aldea Piedra Azul? La Escuela del Desapego no se ocupa de los asuntos del mundo."

msgid "绝尘派不问世事。村里人的事，你要管，自己去管。"
msgstr "La Escuela del Desapego no se ocupa de los asuntos del mundo. Si los de la aldea te importan, ocúpate tú."

msgid "睁开眼睛，打量了你一番。"
msgstr " abre los ojos y te examina de arriba abajo."

msgid "你走得出老道的阵。"
msgstr "Eres capaz de salir de la formación de este viejo taoísta."

msgid "……村里人的事，你要管，自己去管。"
msgstr "...Si los asuntos de la aldea te importan, ocúpate tú."

msgid "正月十七的事，过去了。"
msgstr "Lo del 17 del primer mes ya pasó."

msgid "绝尘派这一票，在你手里。"
msgstr "El voto de la Escuela del Desapego está en tus manos."

msgid "了尘替老道去。虹台的事，问他。"
msgstr "Liaochen va en lugar de este viejo taoísta. Lo de la Terraza del Arcoíris, pregúntaselo a él."

msgid "说过了。阵是你陪着推出去的，这一票，你要，就是你的。"
msgstr "Dicho está. Fuiste tú quien acompañó a empujar la formación; este voto, si lo quieres, es tuyo."

msgid "阵推到了洞口，老道答应过的，下山走一趟。投旧盟主，椅子照旧。"
msgstr "La formación llegó hasta la boca de la cueva, como este viejo taoísta prometió: bajar de la montaña una vez. Voto para el antiguo Líder; el sillón queda como estaba."

msgid "眯着眼睛看了你一会儿。"
msgstr " te mira un rato con los ojos entornados."

msgid "……那个阵，是你陪着推出去的。这一票，你要，就是你的。"
msgstr "...Esa formación la empujaste tú, acompañando. Este voto, si lo quieres, es tuyo."

msgid "老道说话算话。正月十七，老道下山走一趟。"
msgstr "Este viejo taoísta cumple su palabra. El 17 del primer mes, bajará de la montaña una vez."

msgid "虹台？绝尘派不问世事，向来不去。"
msgstr "¿La Terraza del Arcoíris? La Escuela del Desapego no se ocupa de los asuntos del mundo y nunca va."

msgid "眯着眼睛打量了你一番。"
msgstr " te examina de arriba abajo con los ojos entornados."

msgid "……你走得过老道的八卦阵。好，你要老道下山，老道就下山——投旧盟主，椅子照旧。"
msgstr "...Pasaste por la formación de los Ocho Trigramas de este viejo taoísta. Bien: si quieres que baje, bajará. Voto para el antiguo Líder; el sillón queda como estaba."

msgid "虹台上那把椅子谁坐，跟老道没有关系。"
msgstr "Quién se siente en ese sillón de la Terraza del Arcoíris no tiene nada que ver con este viejo taoísta."

msgid "下山"
msgstr "Bajar de la montaña"

msgid "请绝尘子下山：正月十七绝尘派来虹台，这一票投旧盟主。\n要这么说吗？"
msgstr "Pedir a Juechenzi que baje de la montaña: el 17 del primer mes la Escuela del Desapego irá a la Terraza del Arcoíris y su voto será para el antiguo Líder.\n¿Decirlo así?"

msgid "了尘替老道去了。"
msgstr "Liaochen fue en lugar de este viejo taoísta."

msgid "说过了。老道下山。"
msgstr "Dicho está. Este viejo taoísta bajará."

msgid "拂了拂袖子。"
msgstr " se sacude la manga."

msgid "好。老道走一趟。"
msgstr "Bien. Este viejo taoísta hará el viaje."

msgid "玄尘"
msgstr "Xuanchen"

msgid "了尘走了。玄尘这个名字，也跟着他下了山。"
msgstr "Liaochen se fue. El nombre de Xuanchen bajó de la montaña con él."

msgid "那个名字，了尘叫过一回，就够了。"
msgstr "Ese nombre, con que Liaochen lo diga una vez, basta."

msgid "叫过了。……那个名字三十年没人叫了。"
msgstr "Ya lo dijo. ...Hace treinta años que nadie pronuncia ese nombre."

msgid "睁开眼睛，看了你很久。"
msgstr " abre los ojos y te mira un largo rato."

msgid "了尘跟你说的？"
msgstr "¿Te lo dijo Liaochen?"

msgid "望着佛像顶上那颗夜明珠。"
msgstr " mira la perla luminosa en lo alto de la estatua de Buda."

msgid "玄尘。……那个名字三十年没人叫了。"
msgstr "Xuanchen. ...Hace treinta años que nadie pronuncia ese nombre."

msgid "三十年前，老道是山烟寺玄字辈的和尚，玄智是老道的师兄。天竺来的法师背着经上山，师父不收。老道想看那部经，就追出了山门。"
msgstr "Hace treinta años, este viejo taoísta era monje de la generación Xuan del Templo de la Bruma, y Xuanzhi era su hermano mayor. Un maestro llegado de la India subió a la montaña con unas escrituras y el Shifu no lo aceptó. Este viejo taoísta quiso ver aquellas escrituras y salió corriendo tras él por la puerta del templo."

msgid "在番坊住了一年，法王点化了老道：佛经、道书、大秦人的书，经就是经，不拣。"
msgstr "Pasó un año en el Barrio Extranjero y el Rey del Dharma le abrió los ojos: escrituras budistas, libros taoístas, libros de Daqin; una escritura es una escritura, no se escoge."

msgid "法王跟你说，他没有点化过老道？……他向来这么说。"
msgstr "¿El Rey del Dharma te dijo que él nunca le abrió los ojos a este viejo taoísta? ...Siempre dice eso."

msgid "你说，师兄收了那部经？"
msgstr "¿Dices que mi hermano mayor aceptó esa escritura?"

msgid "闭上眼睛，很久没有说话。"
msgstr " cierra los ojos y pasa mucho tiempo sin decir nada."

msgid "三十年。"
msgstr "Treinta años."

msgid "后来走到青石村后山，摆了这个阵。阵外的事，老道不管；阵里的人，老道护着。"
msgstr "Luego llegué a la montaña trasera de Aldea Piedra Azul y dispuse esta formación. De lo que pasa fuera de la formación, este viejo taoísta no se ocupa; a quienes están dentro, los protege."

msgid "了尘是阵里的人。"
msgstr "Liaochen está dentro de la formación."

msgid "师兄还是守着本寺一脉。他守得住，老道就放心了。"
msgstr "Mi hermano mayor sigue guardando el linaje de su templo. Si puede guardarlo, este viejo taoísta está tranquilo."

msgid "老道绝尘。"
msgstr "Este viejo taoísta es Juechen."

msgid "守阵"
msgstr "Guardar la formación"

msgid "守阵：了尘留在石室。绝尘子把八卦阵往外推到青石村北边的洞口，那里从此不进鬼卒。\n绝尘子肯把奇门遁甲（连同它的根基小天魔道）教给不是绝尘派的人（只这两门）。\n绝尘子下山一回：正月十七虹台上，绝尘派来，这一票投旧盟主（已经入了虹台的席的，这一票不再跟着变）。\n下山那条路就没了。要这么说吗？"
msgstr "Guardar la formación: Liaochen se queda en la cámara de piedra. Juechenzi empuja la formación de los Ocho Trigramas hasta la boca de la cueva, al norte de Aldea Piedra Azul, y desde entonces ningún soldado fantasma entra por allí.\nJuechenzi enseñará Qimen Dunjia (con su base, el Saber demoníaco menor) a quien no sea de la Escuela del Desapego (solo esas dos artes).\nJuechenzi baja una vez de la montaña: el 17 del primer mes, en la Terraza del Arcoíris, la Escuela del Desapego irá y su voto será para el antiguo Líder (si ya has tomado asiento en la Terraza del Arcoíris, este voto ya no cambia).\nSe pierde el camino de «Bajar de la montaña». ¿Decirlo así?"

msgid "阵推到洞口了。"
msgstr "La formación llegó a la boca de la cueva."

msgid "了尘走了。阵，老道一个人守。"
msgstr "Liaochen se fue. La formación, este viejo taoísta la guarda solo."

msgid "看着跪在地上的了尘，很久没有说话。"
msgstr " mira a Liaochen, arrodillado en el suelo, y pasa mucho rato sin decir nada."

msgid "起来。"
msgstr "Levántate."

msgid "阵，老道往外推，推到洞口。青石村北边，往后什么都进不来。山下的人冻不着，阵里的人也不出去。"
msgstr "La formación, este viejo taoísta la empuja hacia afuera, hasta la boca de la cueva. Al norte de Aldea Piedra Azul, de ahora en adelante nada podrá entrar. La gente de abajo no pasará frío y los de dentro de la formación no saldrán."

msgid "了尘把金刚杖拾起来，站起身，退到了师父身后。\n"
msgstr "Liaochen recoge su bastón de vajra, se pone en pie y retrocede hasta quedar detrás de su Shifu.\n"

msgid "绝尘派不问世事——这一回，老道问一回。正月十七，老道下山走一趟。"
msgstr "La Escuela del Desapego no se ocupa de los asuntos del mundo; esta vez, este viejo taoísta se ocupa una vez. El 17 del primer mes, este viejo taoísta bajará de la montaña."

msgid "绝尘派不问世事——这一回，老道问一回。"
msgstr "La Escuela del Desapego no se ocupa de los asuntos del mundo; esta vez, este viejo taoísta se ocupa una vez."

msgid "守什么？"
msgstr "¿Guardar qué?"

msgid "请绝尘子把绝尘派这一票交给你：正月十七虹台上，绝尘派听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir a Juechenzi que te entregue el voto de la Escuela del Desapego: el 17 del primer mes, en la Terraza del Arcoíris, la Escuela del Desapego hará lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "说过了。绝尘派听你的。"
msgstr "Dicho está. La Escuela del Desapego hará lo que digas."

msgid "好。绝尘派这一票，你拿去。"
msgstr "Bien. El voto de la Escuela del Desapego, llévatelo."

msgid "他回日照山了。"
msgstr "Ha vuelto al Monte Soleado."

msgid "望着大厅南边的石门。"
msgstr " mira la puerta de piedra al sur del gran salón."

msgid "出了阵，就是世事。"
msgstr "Fuera de la formación, empieza el mundo."

msgid "{title}{nickname}{name}要叛师！！！"
msgstr "¡¡¡{title} {name}{:0} quiere traicionar a su escuela!!!"

msgid "入我派者，需有慧根。$RESPECT的资质不宜！"
msgstr "Quien entre en mi escuela necesita una buena raíz de sabiduría. Tu aptitud no es la adecuada, $RESPECT."

msgid "$RESPECT似乎尚缺江湖历练，不宜投入绝尘门下。"
msgstr "Parece que aún te falta experiencia del jianghu, $RESPECT. No conviene que ingreses en la Escuela del Desapego."

msgid "很好$RESPECT多加努力他日必定有成。"
msgstr "Muy bien. Esfuérzate más, $RESPECT, y algún día lo lograrás."

msgid "这是一位来自天界的守护神，专门担任护法之责。\n"
msgstr "Es un guardián celestial llegado del cielo, dedicado a proteger la Ley.\n"

msgid "一道金光由天而降，金光中走出一个身穿金色战袍的将官。"
msgstr "Un rayo de luz dorada desciende del cielo y de él sale un oficial con armadura dorada."

msgid "$N说道：末将奉法主召唤，特来护法！"
msgstr "$N{:el} {N:dices|dice}: \"Este humilde general acude al llamado del señor del Dharma para protegerlo.\""

msgid "$N说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！"
msgstr "$N{:el} {N:dices|dice}: \"Este humilde general, llamado por el señor del Dharma, ya ha cumplido su misión de protección. ¡Me despido!\""

msgid "$N化成一道金光，冲上天际消失不见了。"
msgstr "$N{:el} {N:te conviertes|se convierte} en un rayo de luz dorada, {N:te lanzas|se lanza} al cielo y {N:desapareces|desaparece}."

msgid "林忌是一位道行十分高深的修道者，你发现他的眼珠一个是黑色的，一\n个是金色的，这正是「谷衣心法」修炼到极高境界的徵兆。\n"
msgstr "Lin Ji es un practicante de altísimo nivel taoísta. Notas que uno de sus ojos es negro y el otro dorado: la señal de que ha cultivado el Método interno de la túnica de grano hasta un nivel supremo.\n"

msgid "天师"
msgstr "Maestro Celestial"

msgid "道童"
msgstr "Acólitos"

msgid "的眉头动了一下。"
msgstr " frunce un instante el ceño."

msgid "北麓的道观收孩子，说是收道童。茅山查了二十年，查到的孩子都没有回来过。"
msgstr "El monasterio de la falda norte recoge niños; dicen que acólitos. El Monte Mao lleva veinte años investigando y ninguno de los niños que halló ha vuelto jamás."

msgid "晚月庄那个女人是逃出来的？……那她是第一个。六阴剑是逆灵宫的剑，教给孩子，是为了让他们替宫里杀人。"
msgstr "¿La mujer de la Mansión Luna Tardía escapó? ...Entonces fue la primera. La espada de los seis yin es del Palacio Negro: se la enseñan a los niños para que maten por el palacio."

msgid "道童？"
msgstr "¿Acólitos?"

msgid "茅山的家事，不劳你了。"
msgstr "Los asuntos de familia del Monte Mao no hace falta que te preocupen."

msgid "没有抬头。"
msgstr " no levanta la cabeza."

msgid "书在藏经楼，他守着。他二十年不进这道门——进来一回，就不走了。"
msgstr "El libro está en la Biblioteca de escrituras y él lo guarda. Lleva veinte años sin cruzar esta puerta: si entra una vez, ya no se va."

msgid "你们说留，就留吧。"
msgstr "Si ustedes dicen que se quede, que se quede."

msgid "书烧了。他回京城去了——那里还有他守着的人。"
msgstr "El libro se quemó. Él volvió a la Capital: allí tiene a gente que cuidar."

msgid "书在这里，人也在这里。"
msgstr "El libro está aquí y él también."

msgid "烧，问我「烧」；留，去问他「留」。你带它回来的——你说。"
msgstr "Para quemarlo, pregúntame por 'Quemar'; para conservarlo, ve y pregúntale a él por 'Conservar'. Tú lo trajiste de vuelta: tú decides."

msgid "他会来的。书在我这里，他总要来看一眼。"
msgstr "Vendrá. El libro está conmigo y tarde o temprano vendrá a verlo."

msgid "下回你进大殿，他就在门口了。"
msgstr "La próxima vez que entres en el gran salón, él ya estará en la puerta."

msgid "他在京城兵部尚书府，二十年了。书在他手里。"
msgstr "Está en la residencia del ministro de Guerra, en la Capital, desde hace veinte años. El libro lo tiene él."

msgid "把拂尘搁在香案上，半晌没有说话。"
msgstr " deja el espantamoscas sobre la mesa del incienso y pasa un buen rato sin decir nada."

msgid "少的那一函叫《上清符箓》，茅山的符都在里头。"
msgstr "El tomo que falta se llama «Libro de talismanes de la Suprema Claridad»; ahí están todos los talismanes del Monte Mao."

msgid "二十年前，京里兵部的庾大人夜夜见白衣人，派人上山，求茅山去镇宅。茅山不给官家看门——我不肯。"
msgstr "Hace veinte años, el señor Yu, del Ministerio de Guerra, veía cada noche a gente vestida de blanco y envió a alguien al monte a pedir que el Monte Mao fuera a calmar su casa. El Monte Mao no hace de portero para los funcionarios. Yo me negué."

msgid "我那师弟说，镇宅也是救人。夜里揣着那函书下了山，再没回来。"
msgstr "Mi hermano menor dijo que calmar una casa también es salvar gente. Esa noche bajó de la montaña con ese tomo en el pecho y no volvió más."

msgid "「我守人」……他守的是谁，我不知道。他在京城兵部尚书府，二十年了。你替我去看一眼。"
msgstr "'Yo protejo a la gente'... A quién protegía, no lo sé. Lleva veinte años en la residencia del ministro de Guerra, en la Capital. Ve a verlo por mí."

msgid "藏经楼二楼，红布桌上的镇教秘籍，你数过没有？"
msgstr "En el segundo piso de la Biblioteca de escrituras, sobre la mesa de tela roja, ¿has contado los manuales secretos del Monte Mao?"

msgid "上去看看。"
msgstr "Sube a verlo."

msgid "金色的那只眼睛动了一下。"
msgstr " mueve el ojo dorado."

msgid "尚书府的花匠？……你见过他。他还叫我师兄。"
msgstr "¿El jardinero de la residencia del ministro? ...Lo has visto. Aún me llama hermano mayor."

msgid "茅山的家事，本不该同外人说。你见过他，就算茅山的朋友。"
msgstr "Los asuntos de familia del Monte Mao no deberían contarse a forasteros. Pero lo has visto, así que cuentas como amigo del Monte Mao."

msgid "藏经楼你上去看看。二楼红布桌上的镇教秘籍，你数一数。"
msgstr "Sube a la Biblioteca de escrituras. Sobre la mesa de tela roja del segundo piso, cuenta los manuales secretos del Monte Mao."

msgid "你替茅山戴过那顶冠，算茅山的朋友。茅山的家事，不瞒你。"
msgstr "Te pusiste por el Monte Mao aquel gorro: cuentas como amigo del Monte Mao. Los asuntos de familia del Monte Mao no te los oculto."

msgid "我有个师弟，二十年前下了山。"
msgstr "Tengo un hermano menor que bajó de la montaña hace veinte años."

msgid "茅山的家事。"
msgstr "Asuntos de familia del Monte Mao."

msgid "烧"
msgstr "Quemar"

msgid "跟林忌：《上清符箓》投进殿前的香炉，镇教秘籍从此少一函——茅山宁可没有这本书。花匠下山回京城，守着庾清尘。\n林忌教你谷衣心法。正月十七虹台上，茅山这一票投颜违：主剿，北麓剿干净，不留根（已经入了虹台的席的，这一票不再跟着变）。\n终章之后北麓那座道观里的人还没有去处的，问林忌「剿」，官兵上山。\n要这么办吗？"
msgstr "Seguir a Lin Ji: el «Libro de talismanes de la Suprema Claridad» se echa al incensario ante el salón y a los manuales secretos del Monte Mao desde entonces les falta un tomo: el Monte Mao prefiere no tener ese libro. El jardinero baja a la Capital y vigila a Yu Qingchen.\nLin Ji te enseña el Método interno de la túnica de grano. El 17 del primer mes, en la Terraza del Arcoíris, el voto del Monte Mao va para Yan Wei: partidario de aplastarlos, de limpiar la falda norte sin dejar raíces (si ya has tomado asiento en la Terraza del Arcoíris, este voto ya no cambia).\nSi, después del capítulo final, la gente de aquel monasterio de la falda norte aún no tiene adónde ir, pregunta a Lin Ji por 'Sofocar': los soldados subirán a la montaña.\n¿Hacerlo así?"

msgid "书锁回去了。……师弟守着。"
msgstr "El libro volvió a su cerradura. ...Mi hermano menor lo guarda."

msgid "烧了。灰是青的。"
msgstr "Quemado. Las cenizas eran azules."

msgid "把《上清符箓》捧到殿前的香炉边，一页一页撕下来，投进去。"
msgstr " lleva el «Libro de talismanes de la Suprema Claridad» junto al incensario ante el salón, arranca las páginas una a una y las echa dentro."

msgid "前半本的朱砂符烧起来是红的，后半本的黑字烧起来是青的。花匠站在殿门口，一直看到最后一页。\n"
msgstr "Los talismanes de cinabrio de la primera mitad arden rojos; los caracteres negros de la segunda mitad arden azules. El jardinero, de pie en la puerta del salón, mira hasta la última página.\n"

msgid "茅山宁可没有这本书。"
msgstr "El Monte Mao prefiere no tener ese libro."

msgid "师弟，回京城去吧。那孩子还要人看着。"
msgstr "Hermano menor, vuelve a la Capital. Aquel niño aún necesita a alguien que lo cuide."

msgid "花匠朝林忌拜了一拜，什么也没说，转身下山去了。\n"
msgstr "El jardinero se inclina ante Lin Ji, no dice nada y baja la montaña.\n"

msgid "烧什么？"
msgstr "¿Quemar qué?"

msgid "谷衣心法是我茅山派为对抗邪魔外道所创的内功心法。\n"
msgstr "El Método interno de la túnica de grano es un método interno de fuerza que nuestra Escuela del Monte Mao creó para enfrentarse a los demonios y a las sendas perversas.\n"

msgid "我茅山派自张天师开山立派至今，世世代代皆以降妖伏魔为己任。\n"
msgstr "Desde que el Maestro Celestial Zhang fundó la escuela, nuestra Escuela del Monte Mao ha tenido siempre por misión someter demonios y dominar espectros.\n"

msgid "官兵上了北麓。宫里剩下的人，这一回一个也走不了。"
msgstr "Los soldados han subido a la falda norte. De los que quedaban en el palacio, esta vez no se escapa ninguno."

msgid "宫里剩下的人下了山，茅山看着。坛上的火，灭了。"
msgstr "Los que quedaban en el palacio bajaron de la montaña y el Monte Mao los vigila. El fuego del altar se apagó."

msgid "师弟已经上了北麓。他去劝，就让他劝完。"
msgstr "Mi hermano menor ya subió a la falda norte. Si ha ido a persuadirlos, que termine de persuadirlos."

msgid "回北麓去，同宫里当家的说「下山」。"
msgstr "Vuelve a la falda norte y dile al que manda en el palacio: 'Bajar de la montaña'."

msgid "把拂尘搭在臂弯里，金色的那只眼睛望着北边。"
msgstr " se echa el espantamoscas en el pliegue del brazo y mira al norte con el ojo dorado."

msgid "湖底的事了了，商玦没有回来。可北麓那座道观里还有人——坛上的火没有灭，他们管这叫续灯。"
msgstr "Lo del lago terminó y Shang Jue no volvió. Pero en el monasterio de la falda norte aún hay gente: el fuego del altar no se ha apagado y lo llaman mantener la lámpara encendida."

msgid "茅山要一个了断。交给官府去剿，还是劝他们下山，交茅山看着。"
msgstr "El Monte Mao quiere un desenlace: o se los entrega a las autoridades para que los aplasten, o se les persuade de bajar de la montaña y el Monte Mao los vigila."

msgid "看了你很久，叹了一口气。"
msgstr " te mira largo rato y suspira."

msgid "他们认出你了。冠摘了吧——戴着它，北麓上谁都认得你。"
msgstr "Te han reconocido. Quítate el gorro: con él puesto, en la falda norte todos te reconocerán."

msgid "你递出来的东西，茅山都用上了。这就够了。"
msgstr "Todo lo que entregaste, el Monte Mao lo aprovechó. Con eso basta."

msgid "你露的破绽太多了。宫里迟早认出你——别再回那座道观。"
msgstr "Dejaste demasiados cabos sueltos. Tarde o temprano el palacio te reconocerá: no vuelvas a ese monasterio."

msgid "时辰和路，茅山记下了。那一夜，北麓下湖的路上有茅山的人。"
msgstr "El Monte Mao anotó la hora y el camino. Esa noche habrá gente del Monte Mao en el camino al lago desde la falda norte."

msgid "那就去吧。冠戴好——那一剑，只有你递得出去。"
msgstr "Pues ve. Ponte bien el gorro: esa estocada solo puedes darla tú."

msgid "唤首那一夜过去了。茅山没等到你的话。"
msgstr "Pasó la noche de la Invocación de la Cabeza. El Monte Mao no recibió tu palabra."

msgid "倒戈，还是潜伏，你定。定了，来告诉我。"
msgstr "Pasarte al otro bando o seguir oculto: decídelo tú. Cuando lo hayas decidido, ven a decírmelo."

msgid "湖上的事要紧。先去湖上。"
msgstr "Lo del lago es urgente. Ve primero al lago."

msgid "放下手里的拂尘，金色的那只眼睛看着你。"
msgstr " deja el espantamoscas y te mira con el ojo dorado."

msgid "钉子拔了，头在冰下醒了。他们等的那一夜，就是唤首：宫里倾巢下湖，商玦走在最前头。"
msgstr "Arrancaron el clavo y la cabeza despertó bajo el hielo. La noche que esperaban es la Invocación de la Cabeza: el palacio baja entero al lago, con Shang Jue en cabeza."

msgid "你告诉我哪一夜、走哪条路，茅山的人就截在北麓下湖的路上——到了冰龙厅，他身边剩不下几个人。可那顶冠，从此就没用了。"
msgstr "Si me dices qué noche y por qué camino, la gente del Monte Mao cortará el paso en el camino de la falda norte al lago: al llegar a la sala del Dragón de Hielo, a su lado no le quedarán muchos. Pero ese gorro, desde entonces, ya no servirá de nada."

msgid "或者你什么都不说。戴着冠跟他们下湖，站在他身后——第一剑，只有你递得出去。宫里要是已经起了疑心，这条路就走不得。"
msgstr "O no dices nada. Te pones el gorro, bajas al lago con ellos y te quedas detrás de él: la primera estocada solo puedes darla tú. Si en el palacio ya sospechan, este camino no se puede tomar."

msgid "倒戈，还是潜伏，你定。"
msgstr "Pasarte al otro bando o seguir oculto: decídelo tú."

msgid "宫里的事快到头了。他们在等一夜——钉子拔了，湖上的事近了，那一夜才会来。"
msgstr "Lo del palacio está por terminar. Esperan una noche: cuando arranquen el clavo y lo del lago esté cerca, vendrá esa noche."

msgid "到时候我要知道：哪一夜，走哪条路。"
msgstr "Entonces necesitaré saber qué noche y por qué camino."

msgid "人放出去了。茅山的人在北麓底下接着，送他们各回各家。"
msgstr "Ya se dejó salir a esa gente. La gente del Monte Mao los espera al pie de la falda norte y los llevará de vuelta, cada uno a su casa."

msgid "宫里的事还没完——你戴着那顶冠，就还是他们的人。等我的话。"
msgstr "Lo del palacio no ha terminado: mientras lleves ese gorro, sigues siendo de los suyos. Espera mi palabra."

msgid "地牢里那三个人。钥匙在狱卒腰上——那人好酒，子时就歪在长凳上睡。开了门，人自己会走。"
msgstr "Los tres de la mazmorra. La llave está en la cintura del carcelero: es aficionado al vino y a medianoche se queda dormido en el banco. Abre la puerta y la gente se irá sola."

msgid "把名单折好，压在香炉底下。"
msgstr " dobla la lista y la deja bajo el incensario."

msgid "茅山截下了一车。可上一车已经上了山——地牢里新关了三个人。"
msgstr "El Monte Mao interceptó un carro. Pero el anterior ya subió a la montaña: en la mazmorra hay tres personas nuevas."

msgid "放他们出来。钥匙在狱卒腰上；那人好酒，子时就歪在石阶边的长凳上睡。开了门，人自己会走：货栈的侧门，夜里没人看。"
msgstr "Déjalos salir. La llave está en la cintura del carcelero; es aficionado al vino y a medianoche se queda dormido en el banco junto a los escalones de piedra. Abierta la puerta, la gente se irá sola: la puerta lateral del almacén, de noche, no la vigila nadie."

msgid "还有一样。账房案角那只铁匣，锁和牢门是一套。里头是名册的原本——人是谁送上山的，押的谁的印，都在上面。"
msgstr "Y algo más. La caja de hierro en la esquina del escritorio del contable: su cerradura y la de la mazmorra son un juego. Dentro está el original del registro: quién llevó a quién a la montaña, con el sello de quién, todo consta."

msgid "带不带出来，你定。带出来，是一样物证；宫里也就少了一样东西。"
msgstr "Si lo sacas o no, decídelo tú. Si lo sacas, es una prueba; y al palacio le faltará una cosa."

msgid "名单抄到了？给我。"
msgstr "¿Copiaste la lista? Dámela."

msgid "看了你一眼，没有说话。"
msgstr " te mira y no dice nada."

msgid "禁书回了宫里，是你送回去的。……也罢。他当你是自己人，门你进得去。"
msgstr "El libro prohibido volvió al palacio: lo devolviste tú. ...Bueno. Te considera de los suyos y puedes entrar por la puerta."

msgid "进去，干活，听。他们在等什么，要多少人，人从哪里来。"
msgstr "Entra, trabaja, escucha. Qué esperan, cuánta gente necesitan, de dónde sale esa gente."

msgid "进去，先干活。管事派什么，你干什么；他们说什么，你听什么。"
msgstr "Entra y trabaja primero. Haz lo que el encargado te mande y escucha lo que digan."

msgid "野羊山北麓那座黑砖道观，茅山盯了它两年。我要一个进得去的人，戴着他们的冠替我看、替我听。"
msgstr "El monasterio de ladrillo negro de la falda norte del Cerro de las Cabras: el Monte Mao lo vigila desde hace dos años. Necesito a alguien que pueda entrar, que con su gorro mire y escuche por mí."

msgid "可你身上有东方神教的令。一个人只藏得住一重身份——这件事，我不能托你。"
msgstr "Pero llevas la placa de la Orden del Cuervo Dorado. Una persona solo puede esconder una identidad: esto no puedo encargártelo."

msgid "野羊山北麓那座黑砖道观，茅山盯了它两年。他们拜的不是神，是劫；收的不是香火，是人。"
msgstr "El monasterio de ladrillo negro de la falda norte del Cerro de las Cabras: el Monte Mao lo vigila desde hace dos años. No adoran a un dios, sino a la calamidad; lo que recogen no es incienso, sino gente."

msgid "你进去过，还出来了。茅山的道士进不去——一身符水的味道，隔着三里地，他们就闻得出来。"
msgstr "Entraste y saliste. Los taoístas del Monte Mao no pueden entrar: con ese olor a agua de talismán, a tres li de distancia ya los huelen."

msgid "我要一个进得去的人：戴着他们的冠，替我看，替我听。他们在等什么，要多少人，人从哪里来。"
msgstr "Necesito a alguien que pueda entrar: con su gorro, que mire y escuche por mí. Qué esperan, cuánta gente necesitan, de dónde sale esa gente."

msgid "这件事做了，就脱不了身。想好了，再问我「眼线」。"
msgstr "Una vez hecho, no podrás salir. Piénsalo bien y luego pregúntame por 'Espía'."

msgid "北麓那座道观？与你无关。"
msgstr "¿Ese monasterio de la falda norte? No es asunto tuyo."

msgid "眼线"
msgstr "Espía"

msgid "答应下来，戴着黑冠回逆灵宫，做茅山的眼线。\n一个人只藏得住一重身份：接了这件事，东方神教那边的门，从此不再为你开。\n答应吗？"
msgstr "Aceptar, volver al Palacio Negro con el gorro negro y ser el espía del Monte Mao.\nUna persona solo puede esconder una identidad: si aceptas esto, la puerta de la Orden del Cuervo Dorado ya no se te abrirá.\n¿Aceptas?"

msgid "你已经答应过了。冠戴好。"
msgstr "Ya aceptaste. Ponte bien el gorro."

msgid "金色的那只眼睛看了你很久。"
msgstr " te mira largo rato con el ojo dorado."

msgid "你身上有东方神教的令。茅山不用替两家办事的眼线——不是信不过你，是信不过那块令。"
msgstr "Llevas la placa de la Orden del Cuervo Dorado. El Monte Mao no emplea espías que sirvan a dos casas: no es que no confíe en ti, es que no confía en esa placa."

msgid "好。"
msgstr "Bien."

msgid "那一夜地牢里的人是你放走的。宫里记得那一夜——他们不知道是你，只知道有人。"
msgstr "Esa noche, los de la mazmorra los dejaste salir tú. El palacio recuerda esa noche: no saben que fuiste tú, solo que fue alguien."

msgid "戴着冠回去，管事会派你活。冠丢了，问我「黑冠」。"
msgstr "Vuelve con el gorro puesto y el encargado te asignará trabajo. Si pierdes el gorro, pregúntame por 'Gorro negro'."

msgid "你身上那卷东西，是逆灵天书的残卷。拿着它的人死在后山了。它不能跟着你进去，也不能就这么留在外头。"
msgstr "Ese rollo que llevas es un fragmento de la Escritura Negra. Murió en la montaña trasera quien lo tenía. No puede entrar contigo, ni puede quedarse así, fuera."

msgid "交给我，我当面烧了它。宫里会少一卷书，迟早有人问起——这就是你要担的。"
msgstr "Dámelo y lo quemo delante de ti. Al palacio le faltará un rollo y tarde o temprano alguien preguntará: eso es lo que tendrás que cargar."

msgid "你身上那卷东西，是逆灵天书的残卷。它不能跟着你进去，也不能就这么留在外头。"
msgstr "Ese rollo que llevas es un fragmento de la Escritura Negra. No puede entrar contigo, ni puede quedarse así, fuera."

msgid "交给我，我当面烧了它——可宫里会少一卷书，迟早有人问起。还给后山那个大弟子，他会当你是他的人——禁书也就回了宫里。"
msgstr "Dámelo y lo quemo delante de ti; pero al palacio le faltará un rollo y tarde o temprano alguien preguntará. O devuélveselo al discípulo mayor de la montaña trasera: te tendrá por uno de los suyos y el libro prohibido volverá al palacio."

msgid "你定。"
msgstr "Decídelo tú."

msgid "那卷残卷不在你身上？……那就当它没回宫。宫里少了一卷书，迟早有人问起。"
msgstr "¿Ese fragmento no está contigo? ...Entonces cuenta como si no hubiera vuelto al palacio. Al palacio le faltará un rollo y tarde o temprano alguien preguntará."

msgid "……先听我把话说完。"
msgstr "...Primero déjame terminar."

msgid "从香案底下取出一顶黑冠，递给你。"
msgstr " saca de debajo de la mesa del incienso un gorro negro y te lo entrega."

msgid "上个月茅山弟子在北麓截下来的。冠是真的，戴它的人回不来了。"
msgstr "Lo interceptaron discípulos del Monte Mao en la falda norte el mes pasado. El gorro es auténtico; quien lo llevaba ya no volverá."

msgid "冠在你身上。戴好，别摘——摘了，他们下一眼就认得你。"
msgstr "El gorro está contigo. Póntelo y no te lo quites: si te lo quitas, a la siguiente mirada te reconocerán."

msgid "逆灵宫的道士戴的东西。问它做什么。"
msgstr "Lo que llevan los taoístas del Palacio Negro. ¿Para qué lo preguntas?"

msgid "倒戈"
msgstr "Cambiar de bando"

msgid "前夜倒戈：把逆灵宫下湖的时辰和路交给茅山。\n终章冰龙厅里，商玦身边只剩两个道士；点将时多一拨茅山的人，林忌在湖畔。\n可黑冠从此没用，逆灵宫的门不再为你开。\n就这样吗？"
msgstr "Cambiar de bando la víspera: entregar al Monte Mao la hora y el camino por donde el Palacio Negro baja al lago.\nEn la sala del Dragón de Hielo del capítulo final, a Shang Jue solo le quedan dos taoístas a su lado; al reunir a los combatientes habrá un grupo más del Monte Mao, y Lin Ji estará a la orilla del lago.\nPero el gorro negro ya no servirá y la puerta del Palacio Negro dejará de abrirse para ti.\n¿Así?"

msgid "时辰和路，茅山记下了。"
msgstr "El Monte Mao anotó la hora y el camino."

msgid "你已经定了潜伏。冠戴好。"
msgstr "Ya decidiste seguir oculto. Ponte bien el gorro."

msgid "他们迟早认出你。时辰和路，茅山自己去找。"
msgstr "Tarde o temprano te reconocerán. La hora y el camino el Monte Mao tendrá que buscarlos por su cuenta."

msgid "湖上的事已经开始了，来不及了。"
msgstr "Lo del lago ya ha empezado. Es demasiado tarde."

msgid "听你一字一句说完，把那条路在香案上用指头画了一遍。"
msgstr " te escucha palabra por palabra y traza ese camino con el dedo sobre la mesa del incienso."

msgid "好。那一夜，北麓下湖的路上有茅山的人。"
msgstr "Bien. Esa noche habrá gente del Monte Mao en el camino al lago desde la falda norte."

msgid "冠可以摘了。他们很快就会知道，是谁说出去的。"
msgstr "Puedes quitarte el gorro. Pronto sabrán quién lo dijo."

msgid "什么时辰？宫里还没到那一步。"
msgstr "¿Qué hora? El palacio aún no ha llegado a ese punto."

msgid "潜伏"
msgstr "Seguir oculto"

msgid "潜伏到底：什么也不交出去，戴着黑冠跟商玦的队伍下湖。\n冰龙厅里第一剑是你的，商玦带着重伤开打——可他的四个道士会先扑你，也没有人会多来帮你（没人知道你的消息）。\n宫里已经满了三条疑点的，走不了这条路。\n就这样吗？"
msgstr "Seguir oculto hasta el final: no entregar nada, ponerte el gorro negro y bajar al lago con la comitiva de Shang Jue.\nLa primera estocada en la sala del Dragón de Hielo es tuya y Shang Jue empieza el combate con heridas graves, pero sus cuatro taoístas se lanzarán primero sobre ti y nadie acudirá a ayudarte (nadie sabe de ti).\nSi en el palacio ya se acumularon tres sospechas, no se puede tomar este camino.\n¿Así?"

msgid "你已经定了。冠戴好——那一剑，只有你递得出去。"
msgstr "Ya decidiste. Ponte bien el gorro: esa estocada solo puedes darla tú."

msgid "时辰和路已经交出去了。那顶冠，没用了。"
msgstr "La hora y el camino ya los entregaste. Ese gorro ya no sirve."

msgid "宫里已经起了疑心。这条路，走不得了。"
msgstr "En el palacio ya sospechan. Este camino ya no se puede tomar."

msgid "……好。"
msgstr "...Bien."

msgid "冠戴好，什么也别说。他回头的时候，站在他身后的是你。"
msgstr "Póntelo bien y no digas nada. Cuando él se vuelva, quien estará detrás de él serás tú."

msgid "潜伏到哪一天？宫里还没到那一步。"
msgstr "¿Seguir oculto hasta cuándo? El palacio aún no ha llegado a ese punto."

msgid "名册"
msgstr "Registro"

msgid "名册就留在铁匣里？\n宫里什么也不会少，他们看不出你；你身上也就少了一样物证。\n就这样吗？"
msgstr "¿Dejar el registro en la caja de hierro?\nEn el palacio no faltará nada y no te descubrirán; y tú te quedarás sin una prueba.\n¿Así?"

msgid "名册在程不平那里。他会一个一个对出来——那是他的本事。"
msgstr "El registro está con Cheng Buping. Los cotejará uno por uno: es su especialidad."

msgid "京师的事定了。名册交给乔阴的程不平——他对得出那些押印，给那些人家里一个说法。"
msgstr "Lo de la Capital se resolvió. El registro se entregó a Cheng Buping, de Sombra Alta: él puede descifrar esos sellos de entrega y dar a esas familias una explicación."

msgid "兵部的印在上面。带它上京：朝上揭发兵部的时候，它是一样物证。"
msgstr "El sello del Ministerio de Guerra está en él. Llévalo a la Capital: cuando se denuncie al Ministerio de Guerra ante la corte, será una prueba."

msgid "名册留在匣里了。宫里什么也没少——他们看不出你。"
msgstr "El registro se quedó en la caja. Al palacio no le falta nada: no te descubrirán."

msgid "……也好。宫里什么也不会少，他们就看不出你。"
msgstr "...Mejor así. En el palacio no faltará nada y no te descubrirán."

msgid "那上面的押印，你说给我听，我记下了。"
msgstr "Esos sellos de entrega que hay en él, cuéntamelos; los anoto."

msgid "什么名册？"
msgstr "¿Qué registro?"

msgid "虹台上的事定了。茅山照旧降妖伏魔。"
msgstr "Lo de la Terraza del Arcoíris está decidido. El Monte Mao sigue sometiendo demonios como siempre."

msgid "茅山这一票，你说了算。"
msgstr "El voto del Monte Mao lo decides tú."

msgid "茅山这一票投旧盟主。北麓剩下的人交茅山看着——是师弟的主意。茅山认得他们的字了。"
msgstr "El voto del Monte Mao va para el antiguo Líder. A los que quedan en la falda norte los vigilará el Monte Mao: fue idea de mi hermano menor. El Monte Mao ya reconoce su escritura."

msgid "这一票的事，去藏经楼问他。"
msgstr "Sobre este voto, ve a preguntarle a él a la Biblioteca de escrituras."

msgid "茅山主剿。这一票原该投颜违——他和朝廷走得近，北麓那座道观，他剿得动。"
msgstr "El Monte Mao es partidario de aplastarlos. Este voto debería ir a Yan Wei: está cerca de la corte y ese monasterio de la falda norte él podría arrasarlo."

msgid "金色的那只眼睛看着你。"
msgstr " te mira con el ojo dorado."

msgid "可那函书是你带回山的，也是你看着烧的。茅山欠你一回：这一票，你要，就是你的。"
msgstr "Pero ese tomo lo trajiste tú a la montaña y lo viste quemar. El Monte Mao te debe una: este voto, si lo quieres, es tuyo."

msgid "可禁书是你交到我手里烧的。茅山欠你一回：这一票，你要，就是你的。"
msgstr "Pero ese libro prohibido me lo entregaste tú para quemarlo. El Monte Mao te debe una: este voto, si lo quieres, es tuyo."

msgid "可那张名单是你从账房抄出来的，名单上的人茅山找回了好几个。茅山欠你一回：这一票，你要，就是你的。"
msgstr "Pero esa lista la copiaste tú en la contaduría y el Monte Mao ha recuperado a varias de las personas que figuran en ella. El Monte Mao te debe una: este voto, si lo quieres, es tuyo."

msgid "茅山主剿。颜违和朝廷走得近，北麓那座道观，他剿得动。"
msgstr "El Monte Mao es partidario de aplastarlos. Yan Wei está cerca de la corte y ese monasterio de la falda norte él podría arrasarlo."

msgid "这一票投他。"
msgstr "Este voto es para él."

msgid "请林忌把茅山这一票交给你：正月十七虹台上，茅山听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir a Lin Ji que te entregue el voto del Monte Mao: el 17 del primer mes, en la Terraza del Arcoíris, el Monte Mao hará lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "说过了。茅山听你的。"
msgstr "Dicho está. El Monte Mao hará lo que digas."

msgid "这一票，去藏经楼问我师弟。"
msgstr "Sobre este voto, ve a preguntarle a mi hermano menor a la Biblioteca de escrituras."

msgid "好。茅山听你的。"
msgstr "Bien. El Monte Mao hará lo que digas."

msgid "剿"
msgstr "Sofocar"

msgid "官兵已经上了北麓。宫里剩下的人，一个也走不了。"
msgstr "Los soldados ya subieron a la falda norte. De los que quedaban en el palacio no se escapará ninguno."

msgid "人已经下山了，茅山看着。"
msgstr "Esa gente ya bajó de la montaña; el Monte Mao los vigila."

msgid "你已经答应去劝他们下山了。回北麓去，同宫里当家的说「下山」。"
msgstr "Ya aceptaste ir a persuadirlos de que bajen de la montaña. Vuelve a la falda norte y dile al que manda en el palacio: 'Bajar de la montaña'."

msgid "提笔写了一封信，把北麓那座道观的门户、上山的绳路一一画在信后。"
msgstr " escribe una carta y dibuja al dorso la entrada del monasterio de la falda norte y el sendero de cuerdas para subir, uno por uno."

msgid "这封信今晚就到乔阴，程不平会转给兵部。"
msgstr "Esta carta llega esta noche a Sombra Alta; Cheng Buping se la pasará al Ministerio de Guerra."

msgid "书烧了，他们的字茅山不认得了——那就不必认得。"
msgstr "El libro está quemado y el Monte Mao ya no reconoce esa escritura: entonces no hace falta reconocerla."

msgid "这封信今晚就到乔阴，程不平会转给兵部。官兵上了北麓，宫里剩下的人一个也走不了。"
msgstr "Esta carta llega esta noche a Sombra Alta; Cheng Buping se la pasará al Ministerio de Guerra. Los soldados suben a la falda norte y de los que quedan en el palacio no se escapa ninguno."

msgid "剿什么？"
msgstr "¿Sofocar qué?"

msgid "招安"
msgstr "Amnistía"

msgid "官兵已经上了北麓。来不及了。"
msgstr "Los soldados ya subieron a la falda norte. Es tarde."

msgid "想了很久，点了点头。"
msgstr " lo piensa mucho rato y asiente con la cabeza."

msgid "好。宫里剩下的，大半是被拐上山的孩子，烧了一辈子香，不知道自己烧的是什么。"
msgstr "Bien. La mayoría de los que quedan en el palacio son niños engañados para subir a la montaña: han quemado incienso toda la vida sin saber qué quemaban."

msgid "回北麓去，同宫里当家的说「下山」——玄冥子还在，就是他；不在了，就是那个领诵的。你戴着他们的冠，他们会听你说完。"
msgstr "Vuelve a la falda norte y dile al que manda en el palacio: 'Bajar de la montaña'. Si Xuanmingzi sigue ahí, será él; si no, el que dirige los cantos. Llevas su gorro y te dejarán terminar."

msgid "人带下山，茅山看着。"
msgstr "Trae a esa gente montaña abajo; el Monte Mao la vigilará."

msgid "招安什么？"
msgstr "¿Amnistía para quién?"

msgid "接过那函书，在香案前坐下，一页一页翻过去。"
msgstr " recibe el tomo, se sienta ante la mesa del incienso y lo hojea página a página."

msgid "翻到后半本，手停住了。"
msgstr " llega a la segunda mitad del libro y la mano se detiene."

msgid "……这是逆灵宫的字。"
msgstr "...Esta es la escritura del Palacio Negro."

msgid "他抄了两年。烧掉的东西，他一页一页抄回来。"
msgstr "Pasó dos años copiando. Lo que se quemó, lo copió página a página."

msgid "合上书，望着殿门外，很久没有说话。"
msgstr " cierra el libro, mira más allá de la puerta del salón y pasa mucho rato sin decir nada."

msgid "书留在我这里。他会来的。"
msgstr "El libro se queda conmigo. Él vendrá."

msgid "把逆灵天书的残卷交给林忌。\n他会当面烧了它，禁书不会再回逆灵宫——可宫里少了一卷书，那是一条疑点。玄冥子那边，这卷书就还不回去了。\n交给他吗？"
msgstr "Entregar a Lin Ji el fragmento de la Escritura Negra.\nLo quemará delante de ti y el libro prohibido no volverá al Palacio Negro; pero al palacio le faltará un rollo, y eso es una sospecha. Y ya no podrás devolverle ese rollo a Xuanmingzi.\n¿Se lo entregas?"

msgid "接过残卷，翻也没翻，凑到香案的烛火上。"
msgstr " recibe el fragmento, ni lo hojea y lo acerca a la llama de la vela de la mesa del incienso."

msgid "黑皮的书页卷起来，火苗是青的。"
msgstr " mira cómo las páginas de piel negra se enroscan; la llama es azul."

msgid "这东西不该回那里去。"
msgstr "Esto no debía volver allí."

msgid "这东西在你手里，在我手里，都干净不了。先想好你要做什么。"
msgstr "Esto, en tus manos o en las mías, no se vuelve limpio. Piensa primero qué vas a hacer."

msgid "接过名单，一行一行看下去，半晌没有说话。"
msgstr " recibe la lista, la lee línea a línea y pasa un buen rato sin decir nada."

msgid "三十六口。……茅山会去截下一车。"
msgstr "Treinta y seis personas. ...El Monte Mao interceptará un carro."

msgid "你回去。他们看不出来，你就还是他们的人。"
msgstr "Vuelve. Si no te descubren, sigues siendo de los suyos."

msgid "贫道是出家人，不便收女徒，得罪了。"
msgstr "Este humilde taoísta es un renunciante y no puede aceptar discípulas. Discúlpeme."

msgid "嗯... 想入我茅山派？也好...."
msgstr "Mmm... ¿quieres entrar en la Escuela del Monte Mao? Bien..."

msgid "慢著，一个一个来。"
msgstr "Un momento, de uno en uno."

msgid "这是一位来自阴界的守护神，专门担任护法之责。\n"
msgstr "Es un guardián del inframundo, dedicado a proteger la Ley.\n"

msgid "一道蓝光从地底升起，蓝光中出现一个手执钢叉、面目狰狞的鬼卒。"
msgstr "Una luz azul sube de la tierra y en ella aparece un soldado fantasma de rostro feroz con una horca de acero en la mano."

msgid "$N的身形发出幽暗的蓝光，沈入地下不见了。"
msgstr "$N{:el} {N:emites|emite} una luz azul tenue y {N:te hundes|se hunde} bajo tierra hasta desaparecer."

msgid "这是一只由修道人的杂念绮思所化的观想虫，会缠住人的魂魄。\n"
msgstr "Es un gusano de la mente, formado por los pensamientos dispersos y fantasías de un practicante, que se enreda en el alma de las personas.\n"

msgid "身体"
msgstr "cuerpo"

msgid "前脚"
msgstr "pata delantera"

msgid "後脚"
msgstr "pata trasera"

msgid "尾巴"
msgstr "cola"

msgid "你杀死了你的观想虫，并且从中悟到了一些咒术的道理。"
msgstr "Mataste a tu gusano de la mente y de ello comprendiste algo de la lógica de los conjuros."

msgid "你的观想虫被人杀死了！"
msgstr "¡Alguien ha matado a tu gusano de la mente!"

msgid "你觉得一阵天旋地转...."
msgstr "Todo te da vueltas..."

msgid "这是一只由修道人的杂念绮思所化的观想兽，会缠住人的魂魄。\n"
msgstr "Es una bestia de la mente, formada por los pensamientos dispersos y fantasías de un practicante, que se enreda en el alma de las personas.\n"

msgid "你杀死了你的观想兽，并且从中悟到了一些咒术的道理。"
msgstr "Mataste a tu bestia de la mente y de ello comprendiste algo de la lógica de los conjuros."

msgid "你的观想兽被人杀死了！"
msgstr "¡Alguien ha matado a tu bestia de la mente!"

msgid "这是一具被人用符咒控制的僵尸，从它苍白的脸上看不出任何喜怒哀乐。\n"
msgstr "Es un zombi controlado con talismanes; en su rostro pálido no se lee ninguna emoción.\n"

msgid "{name}的僵尸"
msgstr "Zombi de {name}{:0}"

msgid "$N告诉你：我...需...要...你...的...力...量..."
msgstr "$N{:el} te dice: \"Yo... ne... ce... si... to... tu... fuer... za...\""

msgid "$N缓缓地倒了下来，化为一滩血水。"
msgstr "$N{:el} {N:te desplomas|se desploma} lentamente y {N:te conviertes|se convierte} en un charco de sangre."

msgid "晚月庄主"
msgstr "Señora de Luna Tardía"

msgid "蓝止萍是一个十分出色的美女，她弹的一手琵琶更是闻名千里，许多\n王侯子弟，富商豪客都为她天下无双的美貌与琴艺倾倒。\n"
msgstr "Lan Zhiping es una belleza excepcional, y su manera de tocar el pipa es famosa a mil li a la redonda. Muchos hijos de príncipes y de nobles, ricos mercaderes y hombres de dinero han caído rendidos ante su belleza sin igual y su arte con las cuerdas.\n"

msgid "庄主"
msgstr "Señora"

msgid "蓝止萍嫣然一笑，一个转身迳自舞了起来，对眼前这场恶斗似乎全不放在心上。\n"
msgstr "Lan Zhiping sonríe con encanto, da media vuelta y se pone a bailar por su cuenta, como si aquella feroz pelea no le importara en absoluto.\n"

msgid "蓝止萍脚步轻移，翩翩地转了几个圈，回眸一笑。\n"
msgstr "Lan Zhiping mueve los pies con ligereza, gira graciosamente varias veces y mira atrás con una sonrisa.\n"

msgid "蓝止萍用手扶了扶自己的发簪，像是怕被对手碰歪似地。\n"
msgstr "Lan Zhiping se toca la horquilla del pelo, como si temiera que el adversario se la ladeara.\n"

msgid "蓝止萍笑嘻嘻地拾起地上一片从魔鞭翩珑上落下的花瓣。\n"
msgstr "Lan Zhiping, sonriente, recoge del suelo un pétalo caído de Pianlong, el látigo demoníaco.\n"

msgid "你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。"
msgstr "Sientes algo pegado en la cara, pero al llevarte la mano no hay nada."

msgid "男人都不是好东西，滚开！"
msgstr "Todos los hombres son basura. ¡Largo de aquí!"

msgid "很好，只要你对本庄主忠心耿耿，好处是少不了的。"
msgstr "Muy bien. Mientras me seas fiel en cuerpo y alma, no te faltarán recompensas."

msgid "$N暧昧地抚摸著$n的脸，说道：特别是像你这样的女孩 ...."
msgstr "$N{:el} {n:te acaricia el rostro con picardía y dice|acaricia con picardía el rostro de $n{:el} y dice}: \"Y más una muchacha como tú...\""

msgid "看了你一眼，没有笑。"
msgstr " te mira y no sonríe."

msgid "从内书房那边走过来，走得很慢。"
msgstr " viene del estudio interior, caminando muy despacio."

msgid "跟在她娘后面，面巾还蒙着，剑在鞘里，手离剑柄远远的。"
msgstr " sigue a su madre con el rostro aún cubierto, la espada en la vaina y la mano lejos de la empuñadura."

msgid "那一夜，前厅死了两个丫头，内厅死了昭蓉。晚月庄有晚月庄的规矩：血债，要有人抵。"
msgstr "Esa noche, en el salón delantero murieron dos criadas y en el salón interior murió Zhaorong. Luna Tardía tiene sus reglas: la deuda de sangre tiene que pagarla alguien."

msgid "神教的杀手，在我庄里住了三年。内书房、宝衣，她都看过了。晚月庄的规矩：神教的人进了这道门，不能就这么出去。"
msgstr "La asesina de la Orden vivió tres años en mi mansión. El estudio interior, la túnica... lo ha visto todo. La regla de Luna Tardía: quien sea de la Orden y cruce esta puerta no puede salir así como así."

msgid "令牌你还给了神教——她是神教的人，你也认了。"
msgstr "La placa se la devolviste a la Orden. Ella es de la Orden y tú lo reconociste."

msgid "把手里那块黑木令牌攥得更紧了。"
msgstr " aprieta con más fuerza la placa de madera negra que tiene en la mano."

msgid "人交给我。晚月庄不杀不还手的人——可她不能再待在庄里。怎么处置，是庄里的事。"
msgstr "Entrégamela. Luna Tardía no mata a quien no se defiende, pero ella ya no puede quedarse en la mansión. Qué se hace con ella es asunto de la mansión."

msgid "她是我女儿。"
msgstr "Es mi hija."

msgid "依庄规，问我「庄规」；要带她回来，去内书房问老人家「女儿」。"
msgstr "Si es según la regla de la mansión, pregúntame por 'Reglas de la mansión'; si quieres traerla de vuelta, ve al estudio interior y pregunta a la anciana por 'Hija'."

msgid "转身往内书房走，她女儿跟在后面。"
msgstr " se vuelve hacia el estudio interior y su hija la sigue."

msgid "庄规"
msgstr "Reglas de la mansión"

msgid "依庄规：人交给蓝止萍处置——台上不杀，可她不能再待在庄里。\n晚月庄这一票投颜违（逐神教）（已经入了虹台的席的，这一票不再跟着变）；老妇从此不再开口。本庄弟子晋阶执事。\n要这么说吗？"
msgstr "Según las reglas de la mansión: la entregas a Lan Zhiping para que decida; no la matarán en la terraza, pero ya no puede quedarse en la mansión.\nEl voto de Luna Tardía va para Yan Wei (expulsar a la Orden) (si ya has tomado asiento en la Terraza del Arcoíris, este voto ya no cambia); la anciana no volverá a hablar. Si eres discípula de la mansión, asciendes a Intendente.\n¿Decirlo así?"

msgid "你不是晚月庄的人了。这是晚月庄的事。"
msgstr "Ya no eres de Luna Tardía. Esto es asunto de Luna Tardía."

msgid "庄规是庄规。"
msgstr "Las reglas son las reglas."

msgid "你替她选了。晚月庄记着。"
msgstr "Elegiste por ella. Luna Tardía lo recordará."

msgid "抬了抬手，叫两个弟子去内书房。"
msgstr " levanta la mano y manda a dos discípulas al estudio interior."

msgid "带走。"
msgstr "Llévensela."

msgid "庄规是我立的，也是为这样的夜立的。往后庄门关得早一些——神教的人，不会再进来第二回。"
msgstr "Las reglas de la mansión las puse yo, y también para noches como esa. De ahora en adelante el portón se cerrará más temprano: la gente de la Orden no volverá a entrar una segunda vez."

msgid "庄规？问这个做什么。"
msgstr "¿Las reglas de la mansión? ¿Para qué lo preguntas?"

msgid "护法"
msgstr "Guardián"

msgid "做晚月庄的护法：不是弟子，不授辈分，本门的舞和指法不传；头衔换成「晚月庄护法」（本门再晋阶时换回本门的）。晚月庄的事，从此算你一份。\n要这么说吗？"
msgstr "Ser guardián de Luna Tardía: no eres {jugador:discípulo|discípula}, no se te concede generación y las danzas y el arte de dedos de esta escuela no se te enseñan; tu título pasa a ser «Guardián de Luna Tardía» (cuando asciendas otra vez en tu escuela, se vuelve el de tu escuela). Desde ahora, los asuntos de la mansión también son parte tuya.\n¿Decirlo así?"

msgid "你是晚月庄的护法。庄里的事，问我「庄里的事」。"
msgstr "Eres {jugador:guardián|guardiana} de Luna Tardía. De los asuntos de la mansión, pregúntame por 'Asuntos de la mansión'."

msgid "你是本庄的弟子。护法，是给庄外的人做的。"
msgstr "Eres de esta mansión. El puesto de guardián es para quienes están fuera."

msgid "晚月庄护法"
msgstr "Guardián de Luna Tardía"

msgid "上上下下打量了你一眼。"
msgstr " te mira de arriba abajo."

msgid "男人都不是好东西。"
msgstr "Todos los hombres son basura."

msgid "可你接住了瑷伦三鞭——她几百年没对男人抽过鞭子。宝衣的事，你也看着它有了着落。"
msgstr "Pero aguantaste los tres latigazos de Ailun, y ella no ha usado el látigo con un hombre en cientos de años. Y también viste cómo se resolvía lo de la túnica."

msgid "晚月庄不收男徒，这规矩不改。护法不是弟子：没有辈分，本庄的舞和指法也不传你。庄里的事，算你一份。"
msgstr "Luna Tardía no acepta discípulos varones, y esa regla no cambia. Un guardián no es discípulo: no tiene generación y las danzas y el arte de dedos de la mansión no se le enseñan. Los asuntos de la mansión, también son parte tuya."

msgid "你离了晚月庄的门。护法，也就不必了。"
msgstr "Saliste de la puerta de Luna Tardía. Ya no hace falta que seas guardián."

msgid "看了你一会儿。"
msgstr " te mira un rato."

msgid "你接住了瑷伦三鞭，宝衣的事也看着它有了着落。"
msgstr "Aguantaste los tres latigazos de Ailun y viste cómo se resolvía lo de la túnica."

msgid "你不在晚月庄门下，晚月庄不抢人。做个护法吧：没有辈分，本庄的功夫不传；庄里的事，算你一份。"
msgstr "No estás bajo Luna Tardía, y Luna Tardía no se lleva gente. Sé guardián: sin generación, las artes de la mansión no se te enseñan; los asuntos de la mansión, también son parte tuya."

msgid "护法？接得住瑷伦三鞭再说。"
msgstr "¿Guardián? Primero aguanta los tres latigazos de Ailun."

msgid "庄里的事"
msgstr "Asuntos de la mansión"

msgid "你已经不是晚月庄的人了。庄里的事，不劳你。"
msgstr "Ya no eres de Luna Tardía. Los asuntos de la mansión no son para que te molestes."

msgid "内书房那位老人家……让她静一静。"
msgstr "Esa anciana del estudio interior... déjala en paz."

msgid "她在内书房。庄规你替她破了一回——晚月庄记着。"
msgstr "Está en el estudio interior. Las reglas de la mansión las rompiste por ella una vez: Luna Tardía lo recordará."

msgid "那个蒙面的女人，你见过了，令牌也有了着落。下回进大厅，我有话说。"
msgstr "A esa mujer con el rostro cubierto ya la viste y lo de la placa también se resolvió. La próxima vez que entres en el gran salón, tengo algo que decirte."

msgid "她的令牌在你手上？给谁，你自己定。"
msgstr "¿La placa de ella la tienes tú? A quién se la das, lo decides tú."

msgid "老人家的心事……去问问那个蒙面的女人。"
msgstr "La preocupación de la anciana... ve a preguntarle a esa mujer con el rostro cubierto."

msgid "沧海龙吟跳回来了。宝衣……挡在了该挡的地方。"
msgstr "El «Canto del dragón sobre el mar azul» ha vuelto a bailarse. La túnica... se interpuso donde debía."

msgid "内书房那位老人家，有一桩心事压了很多年——你去看看她。"
msgstr "La anciana del estudio interior carga con una preocupación desde hace muchos años. Ve a verla."

msgid "宝衣回来了，池边的凤凰又亮了。晚月庄记你这一回。"
msgstr "La túnica volvió y el fénix junto al estanque brilla de nuevo. Luna Tardía te lo reconoce."

msgid "宝衣你带着。晚月庄自己守。"
msgstr "Quédate tú con la túnica. Luna Tardía se guarda sola."

msgid "脸色淡了下来。"
msgstr " enfría el semblante."

msgid "沧海龙吟跳回来了，宝衣却在西厢那位手里。"
msgstr "El «Canto del dragón sobre el mar azul» ha vuelto a bailarse, pero la túnica está en manos de la del ala oeste."

msgid "你去跟她要——她不会给。可晚月庄要让她知道，这件衣是谁的。"
msgstr "Ve a pedírsela: no te la dará. Pero Luna Tardía quiere que ella sepa de quién es esa prenda."

msgid "沧海龙吟跳回来了，区冥记得你。宝衣在瑷伦身上，庄里一切如旧。"
msgstr "El «Canto del dragón sobre el mar azul» ha vuelto a bailarse; Ouming te recuerda. La túnica está con Ailun y en la mansión todo sigue igual."

msgid "沧海龙吟跳回来了，区冥记得你。宝衣还在你身上——东厢的瑷伦，等你一句话。"
msgstr "El «Canto del dragón sobre el mar azul» ha vuelto a bailarse; Ouming te recuerda. La túnica sigue contigo: Ailun, en el ala este, espera tu palabra."

msgid "沧海龙吟跳回来了，区冥记得你。宝衣的事，等它有了着落，你去东厢见瑷伦。"
msgstr "El «Canto del dragón sobre el mar azul» ha vuelto a bailarse; Ouming te recuerda. Lo de la túnica: cuando se resuelva, ve a ver a Ailun al ala este."

msgid "步子在后院书房那幅湘绣图上，曲子在舞曲谱里。两样凑齐，去二楼佛堂，在区冥的神位前跳。"
msgstr "Los pasos están en el bordado del estudio del patio trasero; la música, en la partitura de danza. Reunidas ambas cosas, ve al oratorio del segundo piso y baila ante la tablilla de Ouming."

msgid "我们晚月庄是『以舞会友，以神换技』。可庄里失传过一支舞，叫沧海龙吟——寒谷龙舞里的一支，几十年没人跳过了。"
msgstr "Nuestra Luna Tardía 'hace amigos con la danza y cambia técnica por espíritu'. Pero en la mansión se perdió una danza, el «Canto del dragón sobre el mar azul», una de las de la Danza del dragón del Valle Frío, que lleva décadas sin bailarse."

msgid "步子绣在后院书房那幅湘绣舞曲图上，昭仪天天对着它看；曲子在舞曲谱里，欣芳知道谱放在哪。"
msgstr "Los pasos están bordados en el cuadro de danza de seda del estudio del patio trasero, que Zhaoyi mira todos los días; la música está en la partitura de danza y Xinfang sabe dónde está."

msgid "两样凑齐了，到二楼佛堂，在区冥的神位前跳一回。跳成了，你就是晚月庄的大弟子。"
msgstr "Reunidas ambas cosas, ve al oratorio del segundo piso y baila una vez ante la tablilla de Ouming. Si te sale, serás {jugador:el discípulo mayor|la discípula mayor} de Luna Tardía."

msgid "两样凑齐了，到二楼佛堂，在区冥的神位前跳一回。你是护法，跳成了也没有辈分——可区冥会记得你。"
msgstr "Reunidas ambas cosas, ve al oratorio del segundo piso y baila una vez ante la tablilla de Ouming. Siendo {jugador:guardián|guardiana}, aunque te salga no tendrás generación; pero Ouming te recordará."

msgid "两样凑齐了，到二楼佛堂，在区冥的神位前跳一回。那是玄天玉女的步子，男人跳不成——请芳绫或者欣芳替你跳。"
msgstr "Reunidas ambas cosas, ve al oratorio del segundo piso y baila una vez ante la tablilla de Ouming. Ese es el paso de la Doncella de Jade del Cielo Oscuro y un hombre no puede bailarlo: pide a Fangling o a Xinfang que baile por ti."

msgid "晚月庄的事，不劳外人。"
msgstr "Los asuntos de Luna Tardía no son cosa de forasteros."

msgid "虹台上的事，晚月庄记着。"
msgstr "Luna Tardía recuerda lo de la Terraza del Arcoíris."

msgid "晚月庄这一票投颜违。神教的人进过庄门，往后庄门要关紧——颜违说了，他当了盟主就逐神教。"
msgstr "El voto de Luna Tardía va para Yan Wei. La gente de la Orden ha cruzado nuestro portón; de ahora en adelante hay que cerrarlo bien. Yan Wei lo dijo: si es Líder, expulsará a la Orden."

msgid "这条庄规，是你陪我守下来的。这一票你要，就给你。"
msgstr "Esta regla de la mansión la sostuviste conmigo. Si quieres este voto, es tuyo."

msgid "晚月庄这一票投旧盟主。庄里收着一个神教的人——官府管不到这里，颜违也别想管到这里来。"
msgstr "El voto de Luna Tardía va para el antiguo Líder. En la mansión se acoge a alguien de la Orden: las autoridades no mandan aquí, y Yan Wei tampoco debe pensar que manda aquí."

msgid "庄规你替她破了一回。……这一票你要，我也给。"
msgstr "Rompiste por ella una vez las reglas de la mansión. ...Si quieres este voto, también te lo doy."

msgid "晚月庄这一票，你说了算。"
msgstr "El voto de Luna Tardía lo decides tú."

msgid "晚月庄这一票投颜违。说定了。"
msgstr "El voto de Luna Tardía va para Yan Wei. Decidido."

msgid "寒於宝衣烧了。晚月庄守了几百年的东西，挡完那一口就没了。"
msgstr "La Túnica de Hanyu se quemó. Lo que Luna Tardía guardó durante siglos se acabó al detener aquel golpe."

msgid "晚月庄这一票原该投旧盟主：封地照旧，官府管不到这里。可神教的人还在庄外转——颜违说了，他当了盟主就逐神教。"
msgstr "El voto de Luna Tardía debería ir al antiguo Líder: el feudo queda como está y las autoridades no mandan aquí. Pero la gente de la Orden sigue rondando fuera de la mansión. Yan Wei lo dijo: si es Líder, expulsará a la Orden."

msgid "你一句话，晚月庄这一票就投他。"
msgstr "Con una palabra tuya, el voto de Luna Tardía va para él."

msgid "宝衣在西厢那位手里。神教迟早要拿它做文章。"
msgstr "La túnica está en manos de la del ala oeste. Tarde o temprano la Orden hará algo con ella."

msgid "晚月庄这一票原该投旧盟主……颜违说了，他当了盟主就逐神教。你一句话，这一票就投他。"
msgstr "El voto de Luna Tardía debería ir al antiguo Líder... Yan Wei dijo que, si es Líder, expulsará a la Orden. Con una palabra tuya, el voto va para él."

msgid "宝衣在瑷伦手里——出过一回庄，是你送回来的。"
msgstr "La túnica está en manos de Ailun: salió una vez de la mansión y la trajiste tú de vuelta."

msgid "晚月庄这一票原该投旧盟主。你要，就给你。"
msgstr "El voto de Luna Tardía debería ir al antiguo Líder. Si lo quieres, es tuyo."

msgid "宝衣还在瑷伦手里。是你替晚月庄守住的。"
msgstr "La túnica sigue en manos de Ailun. La conservaste tú para Luna Tardía."

msgid "晚月庄这一票投旧盟主。"
msgstr "El voto de Luna Tardía va para el antiguo Líder."

msgid "封地照旧，官府管不到晚月庄——这就够了。"
msgstr "El feudo queda como está y las autoridades no mandan en Luna Tardía: con eso basta."

msgid "改投"
msgstr "Cambiar el voto"

msgid "请蓝止萍改投颜违：他当了盟主就逐神教，晚月庄这一票不投旧盟主了。\n要这么说吗？"
msgstr "Pedir a Lan Zhiping que cambie su voto a Yan Wei: si es Líder, expulsará a la Orden; el voto de Luna Tardía ya no va para el antiguo Líder.\n¿Decirlo así?"

msgid "晚月庄这一票跟着庄规走，不改。"
msgstr "El voto de Luna Tardía sigue las reglas de la mansión y no se cambia."

msgid "晚月庄这一票，那天她留下来就定了，不改。"
msgstr "El voto de Luna Tardía quedó decidido el día en que ella se quedó, y no se cambia."

msgid "说过了。晚月庄投颜违。"
msgstr "Dicho está. Luna Tardía vota por Yan Wei."

msgid "好。晚月庄投颜违。"
msgstr "Bien. Luna Tardía vota por Yan Wei."

msgid "请蓝止萍把晚月庄这一票交给你：正月十七虹台上，晚月庄听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir a Lan Zhiping que te entregue el voto de Luna Tardía: el 17 del primer mes, en la Terraza del Arcoíris, Luna Tardía hará lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "说过了。晚月庄听你的。"
msgstr "Dicho está. Luna Tardía hará lo que digas."

msgid "微微一笑。"
msgstr " sonríe levemente."

msgid "好。晚月庄听你的。"
msgstr "Bien. Luna Tardía hará lo que digas."

msgid "住持"
msgstr "Abad"

msgid "阿弥陀佛！出家人戒逞强恶斗！老衲不敢违反清规。"
msgstr "¡Amitabha! Los religiosos tienen prohibido pelear por vanidad. Este viejo monje no se atreve a violar la regla del templo."

msgid "施主既然身负绝艺，老衲佩服便是，也不必较量了。"
msgstr "Ya que usted posee un arte extraordinario, este viejo monje lo admira y no hace falta medir fuerzas."

msgid "剃度"
msgstr "Tonsura"

msgid "阿弥陀佛！你我同是出家人，何故跟老衲开这等玩笑？\n"
msgstr "¡Amitabha! Usted y yo ya somos religiosos; ¿por qué le gasta esta broma a este viejo monje?\n"

msgid "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n"
msgstr "¡Amitabha! Benefactora, esto es un templo; vaya usted a un convento a recibir la tonsura.\n"

msgid "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下受戒。\n"
msgstr "¡Amitabha! ¡Bien, bien! Si de verdad se refugia usted en Buda, arrodíllese y reciba los preceptos.\n"

msgid "出家"
msgstr "Hacerse monje"

msgid "看了你一眼，双手合十。"
msgstr " te mira y junta las palmas."

msgid "阿弥陀佛。施主身上有神教的血腥气。流云轩的事，不劳施主。"
msgstr "Amitabha. Hay olor a sangre de la Orden en usted. Lo del Cenador de las Nubes Errantes no es asunto suyo."

msgid "阿弥陀佛。流云轩的事，不劳施主了。"
msgstr "Amitabha. Lo del Cenador de las Nubes Errantes ya no es asunto suyo."

msgid "那樵夫的命，保住了。"
msgstr "La vida de ese leñador se salvó."

msgid "低头看着自己的手。"
msgstr " se mira las manos."

msgid "那只手……老衲尽力了。"
msgstr "Esa mano... este viejo monje hizo lo que pudo."

msgid "那樵夫好了。药僧都跟老衲说了。"
msgstr "Ese leñador está curado. El monje boticario ya se lo contó a este viejo monje."

msgid "寺规，施主破了。阿弥陀佛。"
msgstr "La regla del templo, usted la ha roto. Amitabha."

msgid "药喂下去了，寒气还在。"
msgstr "Ya se le dio la medicina, pero el frío sigue."

msgid "老衲的药是凉性的底子……赶不出这股寒。阿弥陀佛。"
msgstr "La medicina de este viejo monje tiene una base fría... no logra sacar ese frío. Amitabha."

msgid "药煎好了，拿去喂他。"
msgstr "La medicina ya está cocida; llévesela para dársela."

msgid "附子在药圃，麝香找雪亭的杨掌柜，鬼臼在乔阴树王坟边。三味齐了交给药僧煎。"
msgstr "El acónito está en el huerto de hierbas; el almizcle, con el tendero Yang de Pabellón Nevado; la raíz de podófilo, junto a la Tumba del Rey Árbol en Sombra Alta. Reunidos los tres, entréguelos al monje boticario para que los cueza."

msgid "乔阴来的樵夫，在树王坟边被鬼卒抓了一把。那不是寻常的伤——是阴间的寒气，钻进骨头里了。"
msgstr "El leñador de Sombra Alta recibió un zarpazo de un soldado fantasma junto a la Tumba del Rey Árbol. No es una herida común: es el frío del inframundo, que le ha entrado hasta los huesos."

msgid "捻了很久的念珠。"
msgstr " cuenta las cuentas del rosario durante largo rato."

msgid "老衲开个方子：附子回阳，麝香开窍，再要一味鬼臼，以毒攻毒。"
msgstr "Este viejo monje receta: acónito para devolver el yang, almizcle para abrir los orificios y además una raíz de podófilo, para combatir veneno con veneno."

msgid "附子，寺东的药圃里有；麝香，雪亭镇桑邻药铺的杨掌柜那里有——他年轻时跟老衲学过医；鬼臼，就长在乔阴树王坟边的石缝里。那里有鬼卒，小心。"
msgstr "El acónito lo hay en el huerto de hierbas al este del templo; el almizcle, con el tendero Yang de la Botica de la Morera de Pabellón Nevado, que de joven aprendió medicina con este viejo monje; la raíz de podófilo crece en las grietas de piedra junto a la Tumba del Rey Árbol, en Sombra Alta. Allí hay soldados fantasma: cuidado."

msgid "三味齐了，交给流云轩的药僧煎。"
msgstr "Reunidos los tres, entréguelos al monje boticario del Cenador de las Nubes Errantes para que los cueza."

msgid "阿弥陀佛。药僧说，施主肯帮流云轩的忙。帮手不必落发。"
msgstr "Amitabha. El monje boticario dice que usted está dispuesto a ayudar al Cenador de las Nubes Errantes. Para ayudar no hace falta raparse."

msgid "流云轩里躺着一个乔阴来的樵夫。阿弥陀佛。"
msgstr "En el Cenador de las Nubes Errantes yace un leñador venido de Sombra Alta. Amitabha."

msgid "流云轩是老衲为人看病、存放药草的地方。"
msgstr "El Cenador de las Nubes Errantes es donde este viejo monje atiende a los enfermos y guarda las hierbas."

msgid "头陀"
msgstr "Asceta"

msgid "他在流云轩。"
msgstr "Está en el Cenador de las Nubes Errantes."

msgid "捻了一颗念珠。"
msgstr " pasa una cuenta del rosario."

msgid "老衲该早十年开那道门。"
msgstr "Este viejo monje debió abrir esa puerta diez años antes."

msgid "他回番坊去了。金门外空了。……阿弥陀佛。"
msgstr "Volvió al Barrio Extranjero. Fuera de la Puerta Dorada ya no hay nadie... Amitabha."

msgid "他在殿上。老衲看见了。"
msgstr "Está en el salón. Este viejo monje lo vio."

msgid "他回金门外站着去了。十年了，他一直站在那里。"
msgstr "Volvió a quedarse de pie fuera de la Puerta Dorada. Diez años lleva allí."

msgid "他进了流云轩。……老衲知道。"
msgstr "Entró en el Cenador de las Nubes Errantes. ...Este viejo monje lo sabe."

msgid "拨了两颗念珠，没有再说。"
msgstr " mueve dos cuentas del rosario y no dice más."

msgid "他不是本寺的人。"
msgstr "No es de este templo."

msgid "十年前他到山门前来，老衲没让他进门。他也不走，就站在金门外，一站十年。"
msgstr "Hace diez años llegó a la puerta del templo y este viejo monje no lo dejó entrar. Tampoco se fue: se quedó de pie fuera de la Puerta Dorada, diez años."

msgid "本寺的规矩：外人不进流云轩。"
msgstr "La regla de este templo: los forasteros no entran en el Cenador de las Nubes Errantes."

msgid "寺规"
msgstr "Reglas del templo"

msgid "照寺规：不让独眼头陀进流云轩。\n玄智守着老葛治：命保得住，一只手保不住。头陀转身回金门外，从此不理你。\n这是山烟寺这条线上的一个选择，选了不能改。要照寺规吗？"
msgstr "Seguir las reglas del templo: no dejar entrar al asceta tuerto en el Cenador de las Nubes Errantes.\nXuanzhi atiende en persona al Viejo Ge: la vida se salva, pero una mano no. El asceta da media vuelta, vuelve a la Puerta Dorada y desde entonces no te hace caso.\nEs una elección de la línea del Templo de la Bruma y, una vez hecha, no se puede cambiar. ¿Seguir las reglas del templo?"

msgid "阿弥陀佛。"
msgstr "Amitabha."

msgid "寺规就是寺规。"
msgstr "La regla del templo es la regla del templo."

msgid "寺规，施主已经破了。"
msgstr "La regla del templo, usted ya la ha roto."

msgid "看了看你身后。"
msgstr " mira detrás de ti."

msgid "人是施主领来的，老衲不拦。"
msgstr "Ese hombre lo trajo usted. Este viejo monje no se lo impide."

msgid "双手合十。"
msgstr " junta las palmas."

msgid "阿弥陀佛。外人不进流云轩——这是本寺三百年的规矩，老衲不能在老衲手里破了它。"
msgstr "Amitabha. Los forasteros no entran en el Cenador de las Nubes Errantes: es la regla de este templo desde hace trescientos años y este viejo monje no puede romperla en sus manos."

msgid "那樵夫，老衲自己守。"
msgstr "Al leñador, este viejo monje lo cuidará solo."

msgid "玄智方丈进了流云轩，三天三夜没有出来。\n"
msgstr "El abad Xuanzhi entró en el Cenador de las Nubes Errantes y pasó tres días y tres noches sin salir.\n"

msgid "命，老衲保住了。那只手……寒气在骨头里待得太久，老衲保不住。"
msgstr "La vida, este viejo monje la salvó. La mano... el frío estuvo demasiado tiempo en los huesos y este viejo monje no pudo salvarla."

msgid "寺规？本寺的规矩，问知客僧。"
msgstr "¿La regla del templo? Las reglas de este templo, pregúntelas al monje de recepción."

msgid "阿弥陀佛。正月十七，过去了。"
msgstr "Amitabha. El 17 del primer mes ya pasó."

msgid "阿弥陀佛。山烟寺这一票，在施主手里。"
msgstr "Amitabha. El voto del Templo de la Bruma está en sus manos."

msgid "阿弥陀佛。山烟寺收了西来的经。容得下西来的经，也容得下别人——这一票投旧盟主。"
msgstr "Amitabha. El Templo de la Bruma ha acogido la escritura venida del oeste. Quien acoge la escritura venida del oeste puede acoger también a los demás: este voto va para el antiguo Líder."

msgid "朝流云轩的方向看了一眼。"
msgstr " mira hacia el Cenador de las Nubes Errantes."

msgid "那片叶子是施主带回来的。这一票，施主要，就是施主的。"
msgstr "Esa hoja de palma la trajo usted. Este voto, si usted lo desea, es suyo."

msgid "阿弥陀佛。本寺一脉，守清规。神教的杀手横行，颜施主说要逐了他们——山烟寺这一票投颜施主。"
msgstr "Amitabha. El linaje de este templo guarda la regla pura. Los asesinos de la Orden andan sueltos y el benefactor Yan dice que los expulsará: el voto del Templo de la Bruma va para el benefactor Yan."

msgid "拨了两颗念珠。"
msgstr " mueve dos cuentas del rosario."

msgid "可那片叶子，是施主陪着送回去的。这一票，施主要，就是施主的。"
msgstr "Pero esa hoja de palma usted la llevó de vuelta, acompañándola. Este voto, si usted lo desea, es suyo."

msgid "阿弥陀佛。山烟寺这一票，投旧盟主。"
msgstr "Amitabha. El voto del Templo de la Bruma va para el antiguo Líder."

msgid "阿弥陀佛。神教的杀手杀生无数，山烟寺原想借颜施主之手，逐了他们。"
msgstr "Amitabha. Los asesinos de la Orden han matado sin cuento; el Templo de la Bruma quería valerse del benefactor Yan para expulsarlos."

msgid "施主说，一代教主收回了教主令，正月十七神教不来搅局……施主若担保此事，山烟寺这一票便投旧盟主。容他们。"
msgstr "Usted dijo que el jefe de la Orden retiró la orden de jefe y que el 17 del primer mes la Orden no vendrá a estorbar... Si usted lo garantiza, el voto del Templo de la Bruma irá para el antiguo Líder. Que se les tolere."

msgid "阿弥陀佛。神教的杀手在江湖上横行，颜施主说要逐了他们。"
msgstr "Amitabha. Los asesinos de la Orden andan sueltos por el jianghu y el benefactor Yan dice que los expulsará."

msgid "山烟寺这一票，投颜施主。"
msgstr "El voto del Templo de la Bruma va para el benefactor Yan."

msgid "阿弥陀佛。湖上的事未了，虹台的事且放一放。"
msgstr "Amitabha. Lo del lago no ha terminado; lo de la Terraza del Arcoíris puede esperar."

msgid "请玄智和尚改投旧盟主：神教容得下，山烟寺这一票不投颜违了。\n要这么说吗？"
msgstr "Pedir al monje Xuanzhi que cambie su voto al antiguo Líder: la Orden será tolerada y el voto del Templo de la Bruma ya no va para Yan Wei.\n¿Decirlo así?"

msgid "阿弥陀佛。经收下了，山烟寺本来就投旧盟主。"
msgstr "Amitabha. La escritura ya fue acogida y el Templo de la Bruma ya votaba por el antiguo Líder."

msgid "阿弥陀佛。本寺一脉，说过了。这一票随守寺走。"
msgstr "Amitabha. El linaje de este templo ya lo dijo. Este voto sigue a quien guarda el templo."

msgid "阿弥陀佛。山烟寺投旧盟主，说过了。"
msgstr "Amitabha. El Templo de la Bruma vota por el antiguo Líder; ya está dicho."

msgid "阿弥陀佛。便依施主。"
msgstr "Amitabha. Sea como usted dice."

msgid "收经"
msgstr "Aceptar el sutra"

msgid "收经：独眼头陀受戒入寺，婆萝蜜多心经收进山烟寺。\n流云轩从此治得了鬼卒的寒；头陀在流云轩教婆萝蜜多心经，谁都能学（只这一门）。\n容得下西来的经，也容得下别人：正月十七虹台上，山烟寺这一票投旧盟主（已经入了虹台的席的，这一票不再跟着变）。\n守寺那条路就没了。要这么说吗？"
msgstr "Aceptar el sutra: el asceta tuerto recibe los preceptos e ingresa en el templo y el Sutra del Corazón entra en el Templo de la Bruma.\nDesde entonces el Cenador de las Nubes Errantes puede curar el frío de los soldados fantasma; el asceta enseña el Sutra del Corazón en el Cenador y cualquiera puede aprenderlo (solo esa arte).\nQuien acoge la escritura venida del oeste puede acoger también a los demás: el 17 del primer mes, en la Terraza del Arcoíris, el voto del Templo de la Bruma va para el antiguo Líder (si ya has tomado asiento en la Terraza del Arcoíris, este voto ya no cambia).\nSe pierde el camino de «Guardar el templo». ¿Decirlo así?"

msgid "阿弥陀佛。这是本寺的事。"
msgstr "Amitabha. Es asunto del templo."

msgid "经在流云轩，他也在。"
msgstr "La escritura está en el Cenador de las Nubes Errantes y él también."

msgid "本寺一脉。说过了。"
msgstr "El linaje de este templo. Ya está dicho."

msgid "看着香案上那片贝叶，捻了很久的念珠。"
msgstr " mira la hoja de palma sobre la mesa del incienso y cuenta las cuentas del rosario durante largo rato."

msgid "玄尘要是知道……他等这一天，等了三十年。"
msgstr "Si Xuanchen lo supiera... Esperó este día treinta años."

msgid "收。"
msgstr "Se acepta."

msgid "独眼头陀在佛前跪了下来。玄智伸出手掌，在他头顶轻轻地摩挲了几下。\n"
msgstr "El asceta tuerto se arrodilla ante Buda. Xuanzhi extiende la palma y le acaricia suavemente la coronilla varias veces.\n"

msgid "你是头陀，发就留着。法名，你的师父给过了，老衲不改。从今天起，你是山烟寺的人。"
msgstr "Eres asceta, así que conservas el cabello. El nombre de religión ya te lo dio tu maestro y este viejo monje no lo cambia. Desde hoy eres del Templo de la Bruma."

msgid "流云轩，你去。阴间的寒，往后山烟寺赶得出去了。"
msgstr "Ve al Cenador de las Nubes Errantes. El frío del inframundo, de ahora en adelante el Templo de la Bruma podrá expulsarlo."

msgid "头陀捧起那片贝叶，朝玄智拜了三拜，大步往流云轩去了。\n"
msgstr "El asceta recoge la hoja de palma, se inclina tres veces ante Xuanzhi y se dirige a grandes pasos al Cenador de las Nubes Errantes.\n"

msgid "收什么经？"
msgstr "¿Aceptar qué sutra?"

msgid "守寺"
msgstr "Guardar el templo"

msgid "守寺：本寺一脉，经交还龙若法王，头陀把它带回番坊，金门外从此空了。\n玄智肯把莲华心法（连同它的根基大乘佛法）教给不是本寺的人。流云轩照旧治不了鬼卒的寒。\n山烟寺守清规：正月十七虹台上，这一票投颜违（已经入了虹台的席的，这一票不再跟着变）。\n收经那条路就没了。要这么说吗？"
msgstr "Guardar el templo: el linaje de este templo; la escritura se devuelve al Rey del Dharma Longruo, el asceta se la lleva de vuelta al Barrio Extranjero y fuera de la Puerta Dorada queda vacío desde entonces.\nXuanzhi enseñará el Método interno del loto (con su base, el Dharma mahayana) a quien no sea del templo. El Cenador de las Nubes Errantes sigue sin poder curar el frío de los soldados fantasma.\nEl Templo de la Bruma guarda la regla pura: el 17 del primer mes, en la Terraza del Arcoíris, este voto va para Yan Wei (si ya has tomado asiento en la Terraza del Arcoíris, este voto ya no cambia).\nSe pierde el camino de «Aceptar el sutra». ¿Decirlo así?"

msgid "经已经收了。"
msgstr "La escritura ya fue aceptada."

msgid "把香案上那片贝叶拾起来，双手递还给头陀。"
msgstr " recoge la hoja de palma de la mesa del incienso y se la devuelve al asceta con ambas manos."

msgid "本寺一脉，三十年前不收，今天也不收。经，请带回给你的师父。替老衲谢他。"
msgstr "El linaje de este templo no la aceptó hace treinta años y hoy tampoco. Lleva la escritura de vuelta a tu maestro. Dale las gracias de parte de este viejo monje."

msgid "独眼头陀接过贝叶，看了玄智很久，一句话也没说，转身出了大殿。金门外那块他站了十年的地方，空了。\n"
msgstr "El asceta tuerto recibe la hoja de palma, mira largo rato a Xuanzhi y, sin decir palabra, da media vuelta y sale del gran salón. El lugar fuera de la Puerta Dorada donde estuvo de pie diez años queda vacío.\n"

msgid "看着殿门，忽然问你："
msgstr " mira la puerta del salón y de pronto te pregunta:"

msgid "玄尘师弟……他还好？"
msgstr "El hermano menor Xuanchen... ¿está bien?"

msgid "你说他在青石村后山，守着一个阵。玄智点了点头，没有再问。\n"
msgstr "Dices que está en la montaña trasera de Aldea Piedra Azul, guardando una formación. Xuanzhi asiente y no pregunta más.\n"

msgid "寺规就是寺规。外人不进流云轩，外来的经，也不进。……阿弥陀佛。"
msgstr "La regla es la regla. Los forasteros no entran en el Cenador de las Nubes Errantes, ni tampoco las escrituras venidas de fuera. ...Amitabha."

msgid "请玄智和尚把山烟寺这一票交给你：正月十七虹台上，山烟寺听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir al monje Xuanzhi que te entregue el voto del Templo de la Bruma: el 17 del primer mes, en la Terraza del Arcoíris, el Templo de la Bruma hará lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "阿弥陀佛。说过了，山烟寺听施主的。"
msgstr "Amitabha. Ya está dicho: el Templo de la Bruma hará lo que usted diga."

msgid "阿弥陀佛。山烟寺听施主的。"
msgstr "Amitabha. El Templo de la Bruma hará lo que usted diga."

msgid "了尘回来了。"
msgstr "Liaochen ha vuelto."

msgid "三十年前跟着玄尘师弟跑出山门的那个小沙弥，在流云轩给老衲烧过药炉。……他回来，不算外人。"
msgstr "El pequeño novicio que hace treinta años salió del templo corriendo tras el hermano menor Xuanchen, y que en el Cenador de las Nubes Errantes atizó el horno de las medicinas para este viejo monje... Si vuelve, no es un forastero."

msgid "$N双手合十，恭恭敬敬地跪了下来。"
msgstr "$N{:el} {N:juntas|junta} las manos y {N:te arrodillas|se arrodilla} con toda reverencia."

msgid "$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。"
msgstr "$n{:el} {n:extiendes|extiende} la palma y {N:te acaricia|acaricia a $N{:el}} suavemente la cabeza varias veces; luego {N:te rapa|le rapa} todo el cabello."

msgid "从今以後你的法名叫做{name}。"
msgstr "A partir de hoy, tu nombre de religión es {name}{:0}."

msgid "阿弥陀佛，女施主不要跟老纳开玩笑。"
msgstr "¡Amitabha! Benefactora, no bromee con este viejo monje."

msgid "阿弥陀佛，施主愿入佛门，请先到小寺剃度出家。"
msgstr "¡Amitabha! Si usted desea entrar en la puerta de Buda, reciba primero la tonsura en este humilde templo."

msgid "阿弥陀佛，善哉！善哉！"
msgstr "¡Amitabha! ¡Bien, bien!"

msgid "陆得财是一个浑身脏兮兮的老丐，一副无精打采要死不活的样子，可是\n武林中人人都识得他身上打著二十三个结的皮酒囊，这不但是「花紫会\n」龙头的信物，更是名镇漠南的「黑水伏蛟」独门兵器，只不过陆得财\n行踪诡密，据说各处随时都有七、八的他的替身在四处活动，所以你也\n很难确定眼前这个陆得财到底是不是真的。\n"
msgstr "Lu Decai es un viejo mendigo mugriento de pies a cabeza, de aspecto abatido y medio muerto. Sin embargo, todo el wulin conoce el odre de cuero que lleva, con veintitrés nudos: no solo es la prenda de la Cabeza de Dragón de la Hermandad de los Mendigos, sino también el arma única del «Dragón del Agua Negra», célebre al sur del desierto. Pero Lu Decai va y viene en secreto y se dice que siempre hay siete u ocho dobles suyos en distintos lugares, así que es difícil saber si este Lu Decai es el verdadero.\n"

msgid "龙头"
msgstr "Cabeza de Dragón"

msgid "我们花紫会只收化子，$RESPECT您还是回去享福吧。\n"
msgstr "La Hermandad de los Mendigos solo acepta mendigos, $RESPECT. Mejor vuelva usted a disfrutar de su vida.\n"

msgid "契我收过了。这一叠，烧了干净。"
msgstr "El contrato lo recibí. Este montón, mejor quemarlo."

msgid "契我收下。八户人家的事，叫花子记着；别的，不劳你。"
msgstr "Me quedo con los contratos. Lo de las ocho familias, este mendigo lo tendrá presente; de lo demás, no te molestes."

msgid "接过那叠契，一张一张数过去，数到第八张，揣进了怀里。"
msgstr " recibe el fajo de contratos, los cuenta uno por uno y, al llegar al octavo, se los guarda en el pecho."

msgid "八户。明天她们就回家。"
msgstr "Ocho familias. Mañana mismo vuelven a casa."

msgid "龙头要见见你这个人。"
msgstr "La Cabeza de Dragón quiere verte."

msgid "把腰里的皮酒囊解下来，往你面前一递。"
msgstr " se desata el odre de cuero de la cintura y te lo tiende."

msgid "数数。——二十二个。我是龙头的一个替身。"
msgstr "Cuenta. ...Veintidós. Soy un doble de la Cabeza de Dragón."

msgid "真龙头的酒囊二十三个结，替身的都少几个。龙头在哪，替身一个传一个，一个只认得下一个：雪亭镇广场上那个结最少，从他问起，问「龙头」。"
msgstr "El odre de la verdadera Cabeza de Dragón tiene veintitrés nudos; los de los dobles tienen menos. Dónde está la Cabeza de Dragón, un doble se lo dice a otro y cada uno solo conoce al siguiente: el de la plaza de Pabellón Nevado es el de menos nudos; empieza preguntándole a él por 'Cabeza de Dragón'."

msgid "陆得财守在福林大街上，手里摩挲着腰间的皮酒囊。\n"
msgstr "Lu Decai monta guardia en la calle Fulin, frotando con la mano el odre de cuero que lleva a la cintura.\n"

msgid "叫花子跟官府的人，没有正事说。"
msgstr "Un mendigo no tiene asuntos serios que hablar con la gente del gobierno."

msgid "你不是花紫会这边的人了。叫花子的事，不劳你。"
msgstr "Ya no eres de este lado de la Hermandad de los Mendigos. Los asuntos de los mendigos, no te molestes."

msgid "槐阳那八户的契，烧了。龙头那边，你从雪亭镇广场那个问起。"
msgstr "Los contratos de las ocho familias de Huaiyang, quemados. Para dar con la Cabeza de Dragón, empieza por preguntar al de la plaza de Pabellón Nevado."

msgid "契到手了？递给我。"
msgstr "¿Tienes el contrato? Dámelo."

msgid "福林酒楼二楼，那个姓胡的管事。契揣在他怀里——手要轻。"
msgstr "En el segundo piso de la Taberna Fulin, el administrador de apellido Hu. Lleva los contratos en el pecho: mano ligera."

msgid "抠了抠脚，眯着眼看你。"
msgstr " se rasca el pie y te mira con los ojos entornados."

msgid "县衙那面鼓，是你敲的？叫花子都听见了。"
msgstr "¿Fuiste tú quien tocó el tambor del tribunal? Hasta los mendigos lo oímos."

msgid "兵部有个收民夫的管事，姓胡，这几天住在福林酒楼二楼。他怀里揣着一叠卖身契——槐阳城外八户人家，男人去关北挖河没回来，就拿女人孩子抵。"
msgstr "Hay en el Ministerio de Guerra un administrador que recluta peones, de apellido Hu, que estos días se aloja en el segundo piso de la Taberna Fulin. Lleva en el pecho un fajo de contratos de venta: ocho familias de las afueras de Huaiyang cuyos hombres fueron a cavar el canal en el Norte del Paso y no volvieron, así que se toma a mujeres y niños como pago."

msgid "你去把契摸回来。不会偷？我教你两手（请教「偷窃」）。"
msgstr "Ve a robarle los contratos. ¿No sabes robar? Te enseño un par de trucos (pídeme 'Robar')."

msgid "失了手，他喊着扑上来，巡捕也记你一笔——乔阴的巡捕认得贼。"
msgstr "Si fallas, gritará y se te echará encima, y los alguaciles también te anotarán: en Sombra Alta, los alguaciles reconocen a los ladrones."

msgid "差事？……县衙门口那面鼓都没敲过的人，接不了叫花子的差事。"
msgstr "¿Encargo?... Quien nunca ha tocado el tambor del tribunal no puede aceptar un encargo de mendigos."

msgid "认这些年管事的人：真龙头把皮酒囊系到陆得财腰上，回京师的墙根接着看庾家。\n乔阴照旧——巷子里没有官差，巡捕照旧抓贼。正月十七，花紫会这一票投旧盟主（已经入了虹台的席的，票照入席时的算。）。\n要认他吗？"
msgstr "Reconocer a quien lleva años encargándose: la verdadera Cabeza de Dragón ata el odre de cuero a la cintura de Lu Decai y vuelve a mirar a los Yu desde el pie de las murallas de la Capital.\nSombra Alta sigue como estaba: en los callejones no hay agentes y los alguaciles siguen atrapando ladrones. El 17 del primer mes, el voto de la Hermandad de los Mendigos va para el antiguo Líder (si ya has tomado asiento, el voto cuenta como estaba al tomarlo).\n¿Reconocerlo?"

msgid "二十三个结了。……叫花子的巷子，还是叫花子的。"
msgstr "Veintitrés nudos. ...Los callejones de los mendigos siguen siendo de los mendigos."

msgid "你认了京城墙根下那个。……叫花子不认两个龙头，乔阴的事就不劳你了。"
msgstr "Reconociste al de las murallas de la Capital. ...Un mendigo no reconoce a dos Cabezas del Dragón; lo de Sombra Alta ya no es asunto tuyo."

msgid "把皮酒囊捧在手上，没有动。"
msgstr " sostiene el odre de cuero en las manos y no se mueve."

msgid "真龙头看了他半天，把自己腰里那只二十三个结的皮酒囊解下来，系到了陆得财腰上。\n"
msgstr "La verdadera Cabeza de Dragón lo miró un buen rato, se desató de la cintura su odre de veintitrés nudos y se lo ató a la cintura a Lu Decai.\n"

msgid "「京师的墙根，还得有人看着庾家。」他说完，头也不回地往南门去了。\n"
msgstr "Dijo: \"En el pie de las murallas de la Capital aún tiene que haber alguien vigilando a los Yu.\" Y se marchó hacia la puerta sur sin volver la cabeza.\n"

msgid "……二十年，我没让一个官差进过乔阴的巷子。往后也不让。"
msgstr "...En veinte años no dejé entrar a un solo agente en los callejones de Sombra Alta. Y de ahora en adelante tampoco."

msgid "我是龙头的一个替身。雪亭镇广场上那个结最少，从他问起。"
msgstr "Soy un doble de la Cabeza de Dragón. El de la plaza de Pabellón Nevado es el de menos nudos; empieza por él."

msgid "嘿嘿，你说呢？"
msgstr "Je, je. ¿Tú qué dices?"

msgid "嘿，正月十七？叫花子早忘了。"
msgstr "Je, ¿el 17 del primer mes? Los mendigos ya lo olvidaron."

msgid "花紫会这一票，正月十七照你说的。"
msgstr "El voto de la Hermandad de los Mendigos, el 17 del primer mes, será como tú digas."

msgid "拍了拍腰里那只二十三个结的皮酒囊。"
msgstr " da una palmada al odre de cuero de veintitrés nudos que lleva a la cintura."

msgid "花紫会这一票？投旧盟主。叫花子最怕官——颜违当了盟主，官差就要进乔阴的巷子了。"
msgstr "¿El voto de la Hermandad de los Mendigos? Para el antiguo Líder. Los mendigos temen sobre todo a las autoridades: si Yan Wei es Líder, los agentes entrarán en los callejones de Sombra Alta."

msgid "这只酒囊是你替我认下的。你要这一票，开口就是。"
msgstr "Este odre lo reconociste tú por mí. Si quieres este voto, no tienes más que decirlo."

msgid "嘿嘿一笑，抠了抠脚。"
msgstr " suelta una risita y se rasca el pie."

msgid "花紫会这一票？投旧盟主呗。"
msgstr "¿El voto de la Hermandad de los Mendigos? Pues para el antiguo Líder."

msgid "颜违跟朝廷走得近，他当了盟主，官差就要进乔阴的巷子了——叫花子最怕官。"
msgstr "Yan Wei está muy cerca de la corte y, si es Líder, los agentes entrarán en los callejones de Sombra Alta: los mendigos temen sobre todo a las autoridades."

msgid "虹台？叫花子不管那么远的事。"
msgstr "¿La Terraza del Arcoíris? Los mendigos no se meten en cosas tan lejanas."

msgid "请陆得财把花紫会这一票交给你：正月十七虹台上，花紫会听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir a Lu Decai que te entregue el voto de la Hermandad de los Mendigos: el 17 del primer mes, en la Terraza del Arcoíris, la Hermandad de los Mendigos hará lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "说过了。花紫会听你的。"
msgstr "Dicho está. La Hermandad de los Mendigos hará lo que digas."

msgid "好。花紫会这一票，你说了算。"
msgstr "Bien. El voto de la Hermandad de los Mendigos lo decides tú."

msgid "骆云舟生於京城有名的武林世家，他的本名是骆建炎，但是因为生性喜爱\n四处游荡，遂自号「云舟」，四处游山玩水，结交豪杰异人。数年前继承\n其父骆易而成为步玄派的新任掌门，但是喜爱飘泊的个性仍然不改，令门\n中耆宿头痛不已。\n"
msgstr "Luo Yunzhou nació en una célebre familia marcial de la Capital. Su nombre de pila es Luo Jianyan, pero, como por naturaleza le gusta vagar de un lugar a otro, se dio a sí mismo el nombre de «Yunzhou» y recorre montañas y ríos haciendo amistad con héroes y gente singular. Hace unos años heredó de su padre, Luo Yi, el cargo de nuevo Maestro de la Escuela del Paso Místico, pero su carácter errante no ha cambiado y a los veteranos de la escuela les causa un dolor de cabeza sin fin.\n"

msgid "你还是先走一趟东边的桃林吧。\n"
msgstr "Mejor da primero una vuelta por la arboleda de duraznos del este.\n"

msgid "很好，$RESPECT多加努力，他日必定有成。\n"
msgstr "Muy bien. Esfuérzate más, $RESPECT, y algún día lo lograrás.\n"

msgid "风泉"
msgstr "Fuente del Viento"

msgid "步玄的事，不劳你了。"
msgstr "Los asuntos del Paso Místico no son para que te molestes."

msgid "剑灵认过你了。步玄的人，见过它就算。"
msgstr "El alma de la espada ya te reconoció. Quien la ha visto cuenta como del Paso Místico."

msgid "夜里来曼雩台，问我「问剑」。"
msgstr "Ven de noche a la Terraza de la Danza de Lluvia y pregúntame por 'Prueba de la espada'."

msgid "把腰上那柄湛蓝的剑解下来，横在膝上。"
msgstr " se desata de la cintura la espada de azul intenso y la apoya sobre las rodillas."

msgid "风泉之剑。步玄历代掌门传下来的，剑里住着一个剑灵。"
msgstr "La Espada del Fuente del Viento. Los Maestros del Paso Místico se la han ido transmitiendo, y dentro de la espada vive un alma."

msgid "照规矩，它只在拿剑的人死了才出来——可步玄还有一条老规矩：见过剑灵的人，才算步玄的人。"
msgstr "Por regla, solo sale cuando muere quien porta la espada. Pero el Paso Místico tiene otra vieja regla: quien ha visto el alma de la espada cuenta como del Paso Místico."

msgid "夜里来曼雩台，问我「问剑」。我把剑插在石台上，它就出来了。"
msgstr "Ven de noche a la Terraza de la Danza de Lluvia y pregúntame por 'Prueba de la espada'. Clavo la espada en la plataforma de piedra y sale."

msgid "上下打量了你一眼，笑了。"
msgstr " te mira de arriba abajo y sonríe."

msgid "桃林里那几张字条，你一张一张走出来了？——走得出桃林的，就是桃林的客。"
msgstr "Esas notas de la arboleda de duraznos, ¿las fuiste siguiendo una a una? Quien sale de la arboleda de duraznos es huésped de la arboleda."

msgid "名帖的事办得怎样了？……有空的话，桃林走一趟，咱们说话。"
msgstr "¿Cómo va lo de la tarjeta de visita? ...Cuando tengas tiempo, pasa por la arboleda de duraznos y hablamos."

msgid "风泉之剑，步玄历代掌门的信物。剑里的事——先走一趟东边的桃林再说。"
msgstr "La Espada del Fuente del Viento, prenda de los Maestros del Paso Místico. Lo de la espada... primero da una vuelta por la arboleda de duraznos del este."

msgid "问剑"
msgstr "Prueba de la espada"

msgid "剑灵在「剑神如意」之前收了剑——它认你了。"
msgstr "El alma de la espada guardó la espada antes de 'Espada divina a voluntad': te ha reconocido."

msgid "步玄认你。"
msgstr "El Paso Místico te reconoce."

msgid "伸手把石缝里的剑拔了出来，又插了回去。"
msgstr " saca de la grieta de la piedra la espada y la vuelve a clavar."

msgid "四句念完了，剑灵回了剑。今夜到此——明晚天黑了再来。"
msgstr "Terminadas las cuatro frases, el alma volvió a la espada. Hoy se acaba aquí; vuelve mañana cuando oscurezca."

msgid "剑在石台上。天黑以后它就出来——跟它切磋，赶在「剑神如意」之前。"
msgstr "La espada está en la plataforma de piedra. Cuando oscurezca saldrá: mídete con ella y gana antes de 'Espada divina a voluntad'."

msgid "走到台边那块青石前，把风泉之剑往石缝里一插，剑身「嗡」地响了一声。"
msgstr " va hasta la piedra azul del borde de la plataforma, clava la Espada del Fuente del Viento en la grieta y la hoja suena con un \"zumbido\"."

msgid "天黑了，剑灵就站在这块石头前。跟它切磋——它念一句，强一分。"
msgstr "Al oscurecer, el alma de la espada estará ante esta piedra. Mídete con ella: por cada frase que recita, se hace un poco más fuerte."

msgid "念到第四句「剑神如意」之前打中它，就算过了。念完了，今夜就到此，明晚再来。"
msgstr "Si la golpeas antes de la cuarta frase, 'Espada divina a voluntad', has pasado. Si termina de recitar, hoy se acaba aquí; vuelve mañana por la noche."

msgid "问剑？"
msgstr "¿Prueba de la espada?"

msgid "骆家"
msgstr "Familia Luo"

msgid "骆家的事，不劳你了。"
msgstr "Los asuntos de la familia Luo no son para que te molestes."

msgid "大哥去了关北。他写信来，说那边的风比曼雩台还大。……最后一笔，没甩出格子。"
msgstr "Mi hermano mayor se fue al Norte del Paso. Escribió que allí el viento es más fuerte que en la Terraza de la Danza de Lluvia. ...El último trazo no se salió del recuadro."

msgid "大哥的供状在京城。骆家的门匾，我回去摘了——摘下来，背面是父亲的字。"
msgstr "La confesión de mi hermano mayor está en la Capital. El letrero de la familia Luo lo descolgaré yo cuando vuelva: por detrás está la letra de mi padre."

msgid "大哥在台上抄谱。你问他去——他话少，比从前多了一点。"
msgstr "Mi hermano mayor copia partituras en la plataforma. Ve a preguntarle: habla poco, un poco más que antes."

msgid "我进京一趟。西街相国府见——大哥在那里。"
msgstr "Voy a la Capital. Nos vemos en la Residencia del canciller de la calle Oeste: mi hermano mayor está allí."

msgid "听你说完，扇子停在半空，很久没有动。"
msgstr " te escucha hasta el final, el abanico se detiene en el aire y pasa mucho rato sin moverse."

msgid "那三句是他写的。……他写的时候就知道。"
msgstr "Esas tres frases las escribió él. ...Cuando las escribió, ya lo sabía."

msgid "父亲带我们练剑那年，他说剑是莽夫的东西，字才是骆家的。骆家的字，写到兵部的抄本上去了。"
msgstr "El año en que padre nos enseñó esgrima, dijo que la espada era cosa de brutos y que la letra era lo de la familia Luo. La letra de la familia Luo acabó escrita en las copias del Ministerio de Guerra."

msgid "站起来，把风泉之剑挂回腰上。"
msgstr " se levanta y se cuelga de nuevo la Espada del Fuente del Viento a la cintura."

msgid "十年没回京城了。我进京一趟——西街相国府见，大哥在韦相国那里。"
msgstr "Hace diez años que no vuelvo a la Capital. Voy a la Capital: nos vemos en la Residencia del canciller de la calle Oeste; mi hermano mayor está con el canciller Wei."

msgid "他读了？……他没回信。他从来不回。"
msgstr "¿La leyó? ...No contestó. Nunca contesta."

msgid "愣了一下，摇摇头，又写了一封。"
msgstr " se queda un instante parado, mueve la cabeza y escribe otra carta."

msgid "丢了就丢了。这一封，别再丢了。"
msgstr "Lo perdido, perdido está. Esta carta, que no se pierda otra vez."

msgid "信在你那里。他在庾子建府上的客厅——庾子建倒了，就去相国府找他。"
msgstr "La carta la tienes tú. Está en el salón de visitas de Yu Zijian; si Yu Zijian cayó, ve a buscarlo a la Residencia del canciller."

msgid "沉默了一会儿，用扇子敲了敲手心。"
msgstr " guarda silencio un rato y se golpea la palma con el abanico."

msgid "韦相国叫我「骆家的二小子」，没叫错。我上头还有一个大哥，骆建章。"
msgstr "El canciller Wei me llama 'el segundo hijo de los Luo' y no se equivoca. Por encima de mí hay un hermano mayor, Luo Jianzhang."

msgid "父亲带我们练剑，他不肯，说剑是莽夫的东西。他写得一手好字——比父亲的好，比我的好得多。"
msgstr "Padre nos enseñaba esgrima; él no quiso: dijo que la espada era cosa de brutos. Escribe una letra preciosa, mejor que la de padre y mucho mejor que la mía."

msgid "十年前他进了兵部尚书庾子建的府，做书启。我们兄弟俩，十年没说过一句话。"
msgstr "Hace diez años entró en la residencia de Yu Zijian, ministro de Guerra, de secretario. Mi hermano y yo llevamos diez años sin dirigirnos una palabra."

msgid "从袖子里抽出一张笺，提笔写了很久，写完折成一个小方块，最后一笔照旧甩出了格子。"
msgstr " saca del puño de la manga un papel, escribe largo rato, lo dobla hasta hacerlo un cuadradito y, como siempre, el último trazo se sale del recuadro."

msgid "你进京的时候，替我把这封信交给他。他在庾子建的客厅里写字——庾子建要是倒了，他多半在韦相国那里。"
msgstr "Cuando vayas a la Capital, entrégale esta carta de mi parte. Está escribiendo en el salón de visitas de Yu Zijian; si Yu Zijian ha caído, seguramente está con el canciller Wei."

msgid "骆家的事？……等你进了京，咱们再说。"
msgstr "¿Asuntos de la familia Luo? ...Cuando llegues a la Capital, hablamos."

msgid "骆家在京城住了五代。我是二小子。"
msgstr "La familia Luo lleva cinco generaciones en la Capital. Yo soy el segundo hijo."

msgid "京城"
msgstr "Capital"

msgid "名帖给过你了。韦相国那老头子脾气怪，可是不收银子，也不怕庾子建——京城里这样的人，数得过来。"
msgstr "La tarjeta ya te la di. El canciller Wei es un viejo de carácter raro, pero no acepta plata y tampoco le teme a Yu Zijian: en la Capital hay pocos así."

msgid "把扇子一收，看了你半晌。"
msgstr " cierra el abanico y te mira un buen rato."

msgid "你要进京告兵部尚书？——好。我家在京城住了五代，别的没有，认得几个不收银子的人。"
msgstr "¿Vas a la Capital a acusar al ministro de Guerra? ...Bien. Mi familia lleva cinco generaciones en la Capital: no tengo otra cosa, pero conozco a unas cuantas personas que no aceptan plata."

msgid "从袖子里抽出一张大红名帖，提笔写了一行，字写得飞快，最后一笔甩出了格子。"
msgstr " saca de la manga una tarjeta de visita roja, escribe una línea con letra veloz y el último trazo se sale del recuadro."

msgid "拿着，去西街的相国府，叩门递帖。韦相国是我父亲的老师。他那府里寒酸得很——别笑。"
msgstr "Toma. Ve a la Residencia del canciller en la calle Oeste, llama a la puerta y entrega la tarjeta. El canciller Wei fue maestro de mi padre. Su residencia es muy modesta: no te rías."

msgid "又看了你一眼。"
msgstr " te mira otra vez."

msgid "等这件事办完了，桃林走一趟，咱们说话。"
msgstr "Cuando termines con esto, pasa por la arboleda de duraznos y hablamos."

msgid "京城？我家在京城，我不爱回去。那里的人说话，十句有九句是给别人听的。"
msgstr "¿La Capital? Mi familia está en la Capital y a mí no me gusta volver. Allí, de cada diez frases que se dicen, nueve son para que las oiga otro."

msgid "虹台上的事，骆家记下了。"
msgstr "Lo de la Terraza del Arcoíris, la familia Luo lo tiene presente."

msgid "步玄这一票，听你的。"
msgstr "El voto del Paso Místico lo decides tú."

msgid "把扇子在掌心敲了两下。"
msgstr " golpea dos veces el abanico contra la palma."

msgid "骆家跟朝廷翻了脸。步玄这一票投旧盟主——兵部的旧案，查到底。"
msgstr "La familia Luo rompió con la corte. El voto del Paso Místico va para el antiguo Líder: el viejo caso del Ministerio de Guerra se investigará hasta el fondo."

msgid "大哥那张供状，是你陪着他写的。这一票，你要，就是你的。"
msgstr "La confesión de mi hermano mayor la escribiste tú, a su lado. Si quieres este voto, es tuyo."

msgid "骆家还是京城的世家，京城的意思，是颜违。步玄这一票投他。"
msgstr "La familia Luo sigue siendo una familia noble de la Capital, y la voluntad de la Capital es Yan Wei. El voto del Paso Místico va para él."

msgid "朝台上抄谱的大哥看了一眼。"
msgstr " mira a su hermano mayor, que copia partituras en la plataforma."

msgid "可大哥是你让我带回来的。骆家欠你一份情：这一票，你要，就是你的。"
msgstr "Pero a mi hermano mayor me lo trajiste tú. La familia Luo te debe un favor: este voto, si lo quieres, es tuyo."

msgid "骆家是京城的世家，这一票原该随朝廷——投颜违。"
msgstr "La familia Luo es una familia noble de la Capital y este voto, en principio, debería seguir a la corte: ir a Yan Wei."

msgid "可庾子建是你在朝上揭发的，骆家的名帖也是你拿去敲开相国府的门。骆家欠你一份情：这一票，你要，就是你的。"
msgstr "Pero a Yu Zijian lo denunciaste tú ante la corte, y la tarjeta de la familia Luo la usaste para abrir la puerta de la Residencia del canciller. La familia Luo te debe un favor: este voto, si lo quieres, es tuyo."

msgid "骆家在京城住了五代，京城的意思，是颜违。"
msgstr "La familia Luo lleva cinco generaciones en la Capital, y la voluntad de la Capital es Yan Wei."

msgid "步玄这一票投他。我不爱回去，可我姓骆。"
msgstr "El voto del Paso Místico va para él. No me gusta volver, pero me apellido Luo."

msgid "请骆云舟把步玄派这一票交给你：正月十七虹台上，步玄听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedir a Luo Yunzhou que te entregue el voto de la Escuela del Paso Místico: el 17 del primer mes, en la Terraza del Arcoíris, el Paso Místico hará lo que digas; si te presentas, el voto es tuyo, y si no, tú dices a quién se vota.\n¿Decirlo así?"

msgid "说过了。步玄听你的。"
msgstr "Dicho está. El Paso Místico hará lo que digas."

msgid "把扇子一收，笑了。"
msgstr " cierra el abanico y sonríe."

msgid "好。步玄听你的。"
msgstr "Bien. El Paso Místico hará lo que digas."

msgid "一个高大的人形，只有轮廓发出暗蓝色的光芒，其他部份都是透明的！\n"
msgstr "Una figura humana alta, solo cuyo contorno emite una luz azul oscura; el resto es transparente.\n"

msgid "剑气指天 ..."
msgstr "El aliento de la espada apunta al cielo..."

msgid "剑心内敛 ..."
msgstr "El corazón de la espada se repliega..."

msgid "剑芒游光 ..."
msgstr "El filo de la espada vaga en destellos..."

msgid "剑神如意！"
msgstr "¡Espada divina a voluntad!"

msgid "一阵蓝光笼罩住$N，「嗡」地一声，$N的轮廓又变清晰了一些！"
msgstr "Una luz azul envuelve a $N{:el}. Con un zumbido, el contorno de $N{:el} se vuelve un poco más nítido."

msgid "天空中万里无云"
msgstr "Ni una nube en el cielo"

msgid "几朵淡淡的云彩妆点著清朗的天空"
msgstr "Unas pocas nubes tenues salpican el cielo despejado"

msgid "白云在天空中飘来飘去"
msgstr "Nubes blancas vagan por el cielo"

msgid "厚厚的云层堆积在天边"
msgstr "Espesas nubes se amontonan en el horizonte"

msgid "天空中乌云密布"
msgstr "Nubes oscuras cubren el cielo"

msgid "微曦"
msgstr "Alba"

msgid "东方的天空中开始出现一丝微曦。"
msgstr "Un primer resplandor asoma en el cielo del este."

msgid "东方的天空已逐渐发白"
msgstr "El cielo del este va palideciendo"

msgid "日出"
msgstr "Salida del sol"

msgid "太阳从东方的地平线升起了。"
msgstr "El sol se alza sobre el horizonte del este."

msgid "太阳刚从东方的地平线升起"
msgstr "El sol acaba de alzarse sobre el horizonte del este"

msgid "上午"
msgstr "Mañana"

msgid "太阳已经高高地挂在东方的天空中。"
msgstr "El sol cuelga ya alto en el cielo del este."

msgid "太阳正高挂在东方的天空中"
msgstr "El sol cuelga alto en el cielo del este"

msgid "正午"
msgstr "Mediodía"

msgid "已经是正午了，太阳从你正上方照耀著大地。"
msgstr "Es mediodía. El sol baña la tierra desde justo encima de ti."

msgid "现在是正午时分，太阳高挂在你的头顶正上方"
msgstr "Es la hora del mediodía, y el sol está justo sobre tu cabeza"

msgid "下午"
msgstr "Tarde"

msgid "太阳开始从西方的天空中慢慢西沉。"
msgstr "El sol empieza a descender despacio por el cielo del oeste."

msgid "太阳正高挂在西方的天空中"
msgstr "El sol cuelga alto en el cielo del oeste"

msgid "傍晚"
msgstr "Atardecer"

msgid "傍晚了，太阳的馀晖将西方的天空映成一片火红。"
msgstr "Atardece, y los últimos rayos del sol tiñen de rojo fuego el cielo del oeste."

msgid "一轮火红的夕阳正徘徊在西方的地平线上"
msgstr "Un sol rojo como el fuego se demora sobre el horizonte del oeste"

msgid "夜晚"
msgstr "Noche"

msgid "夜晚降临了。"
msgstr "Ha caído la noche."

msgid "夜幕笼罩著大地"
msgstr "El manto de la noche cubre la tierra"

msgid "午夜"
msgstr "Medianoche"

msgid "已经是午夜了。"
msgstr "Es medianoche."

msgid "夜幕低垂，满天繁星"
msgstr "La noche pende baja y el cielo se llena de estrellas"

msgid "这是流通中单位最小的货币，约要一百文钱才值得一两银子。\n"
msgstr "La moneda de menor valor en circulación. Hacen falta unos cien wen para valer un tael de plata."

msgid "文"
msgstr "wen"

msgid "白花花的银子，人见人爱的银子。\n"
msgstr "Plata blanca y reluciente. Todo el mundo ama la plata."

msgid "黄澄澄的金子，人见人爱的金子，啊～～金子！\n"
msgstr "Oro amarillo y reluciente. Todo el mundo ama el oro. ¡Ah, el oro!"

msgid "一件普通的粗布衣服，不值什么钱。\n"
msgstr "Una túnica común de tela basta. Apenas tiene valor."

msgid "一个香喷喷、热腾腾的大包子。\n"
msgstr "Un bollo grande al vapor, caliente y fragante."

msgid "一枝烤得香喷喷鸡腿，你还犹豫什麽？准备胃液吧。\n"
msgstr "Un muslo de pollo asado que huele de maravilla. ¿Qué esperas? Ve preparando los jugos gástricos."

msgid "啃得精光的鸡腿骨头"
msgstr "Hueso de pollo roído"

msgid "一根啃得精光的鸡腿骨头。\n"
msgstr "Un hueso de muslo de pollo, roído hasta dejarlo limpio."

msgid "一个牛皮缝的大酒袋，大概装得八、九升的酒。\n"
msgstr "Un odre grande de cuero de buey cosido; caben unos ocho o nueve litros de vino."

msgid "这本旧书的纸张都已经泛黄了，上面只有一些字迹模糊的字句，似乎\n提到一些呼吸方法什么的。\n"
msgstr "El papel de este libro viejo hace tiempo que amarilleó. Solo hay unas líneas de letra borrosa, algo sobre maneras de respirar."

msgid "一颗金疮药, 可以用来敷上治伤 。\n"
msgstr "Una dosis de ungüento para heridas; se aplica sobre la herida para curarla."

msgid "这是一把看起相当普通的长剑，份量大约有十来斤左右。\n"
msgstr "Una espada larga de aspecto bastante corriente, de unos diez jin de peso."

msgid "这是一把通体黝黑的重剑，上面生满了尖锐的倒钩，乃是乔阴柳家\n历代相传的宝剑，据说这把剑杀人不沾血，永远保持杀气。\n"
msgstr "Una espada pesada, negra de punta a punta y cubierta de garfios afilados: el tesoro que la familia Liu de Sombra Alta se ha transmitido de generación en generación. Dicen que mata sin que la sangre la manche y que conserva siempre su aura asesina."

msgid "这是一包用来毁尸灭迹的化尸粉，只要用一丁点就可以\n化去一具尸体！\n"
msgstr "Un paquete de polvo disolvente de cadáveres, para borrar todo rastro de un cuerpo. ¡Una pizca basta para disolver un cadáver entero!"

msgid "这是一包用来解蛇毒的药\n可以用来解蛇毒!\n"
msgstr "Un paquete de medicina contra el veneno de serpiente. ¡Sirve para curar una mordedura!"

msgid "飞镖是一种十分常见的暗器。\n"
msgstr "El dardo es un arma oculta muy común."

msgid "枝"
msgstr "pieza"

msgid "这是一种毒性猛烈的春药，你可以把它倒在酒水之中使用。\n"
msgstr "Un afrodisíaco de efecto violento y venenoso. Se usa echándolo en el vino o en el agua."

msgid "这是一把看起相当普通的匕首。\n"
msgstr "Una daga de aspecto bastante corriente."

msgid "这是一寻常的单刀，份量大约六、七斤重。\n"
msgstr "Un sable de un solo filo, común, de unos seis o siete jin de peso."

msgid "这是一口寻常的布袋，可以用来装一些杂物。\n"
msgstr "Una bolsa de tela común, buena para guardar cosas sueltas."

msgid "这是一把八角铜锤，沉甸甸的。\n"
msgstr "Un martillo de bronce octogonal. Pesado."

msgid "这是一把又细又长的剑，轻飘飘的像是女孩子家的玩意。\n"
msgstr "Una espada larga y delgada, tan ligera que parece un juguete de niña."

msgid "这是一把暗绿色的鬼头刀，拿在手中沈甸甸地。\n"
msgstr "Un sable de cabeza de fantasma de color verde oscuro, pesado en la mano."

msgid "这是一把血红色的的长剑，份量大约有十来斤左右。\n"
msgstr "Una espada larga rojo sangre, de unos diez jin de peso."

msgid "这是寻常的绿林盗贼用来作案的蒙汗药，你可以把它倒在\n酒水之中使用。\n"
msgstr "El polvo somnífero corriente que los bandidos del bosque usan para sus fechorías. Se usa echándolo en el vino o en el agua."

msgid "这是一条紫铜杖，杖的两端似乎封这密文。\n"
msgstr "Un bastón de cobre rojo. Los dos extremos parecen sellados con una escritura secreta."

msgid "一把闪闪发著金光的长剑。\n"
msgstr "Una espada larga que reluce con luz dorada."

msgid "这是一把桃木雕成的古剑，闻起来有一股香味，剑身刻著许多你从未见过的咒\n文，只有剑柄部份有两个依稀可以辨认的篆字：「 王 禅 」\n"
msgstr "Una espada antigua tallada en madera de durazno. Huele a algo dulce, y la hoja está cubierta de conjuros que nunca habías visto. Solo en la empuñadura se distinguen apenas dos caracteres en escritura de sello: \"Wang Chan\"."

msgid "王禅剑发出一股金色的罡气，流遍$N的全身。"
msgstr "La espada Wang Chan despide un aura dorada que {N:te recorre de pies a cabeza|recorre de pies a cabeza a $N{:el}}."

msgid "这是道士们用来画符的符纸，具有封存法力的功用。\n"
msgstr "El papel talismánico con que los taoístas dibujan sus talismanes. Sirve para sellar poder arcano."

msgid "一条又粗又长，非常沈重的黄铜禅杖，上面镶著六个铜环。\n"
msgstr "Un bastón de monje de latón, grueso, largo y muy pesado, engastado con seis anillos de bronce."

msgid "这是步玄派历代相传的掌门信物，湛蓝色的剑身跟鹅黄色剑柄，使\n得风泉之剑成为具有「剑之王者」的美誉，除此之外，这把剑也是\n削铁如泥的利器。\n"
msgstr "El emblema de Maestro que la Escuela del Paso Místico se transmite de generación en generación. Con su hoja azul profundo y su empuñadura amarillo ganso, la Espada del Fuente del Viento tiene fama de ser «el rey de las espadas»; además, corta el hierro como si fuera barro."

msgid "你看到风泉之剑掉落在地上 ..."
msgstr "Ves caer al suelo la Espada del Fuente del Viento..."

msgid "不 ... 它飘了起来！一个人形忽然浮现，手中正握著风泉之剑！"
msgstr "No... ¡se eleva en el aire! ¡De pronto aparece una figura humana, empuñando la Espada del Fuente del Viento!"

msgid "拳脚功夫的根底，出拳踢腿、闪身贴近都从这里练起。柳家拳、天邪神掌这类拳掌指爪的专门功夫都要激发在它上面，根底越厚，激发出来越有分量。勤练拳脚，膂力也会慢慢长起来。"
msgstr "La base de todo el combate a puño: golpear, patear y deslizarte para acercarte empiezan aquí. Las artes especializadas de puño, palma, dedo y garra, como el Puño de la familia Liu o la Palma indómita, se aplican sobre ella: cuanto más firme la base, más peso tienen. Si entrenas puños y piernas con empeño, tu Fuerza irá creciendo poco a poco."

msgid "由於你勤练武艺，你的膂力提高了。"
msgstr "Gracias a tu empeño en entrenar, tu Fuerza ha aumentado."

msgid "使剑的根底：握剑、出剑、收剑的规矩都在这里。封山剑法、六阴追魂剑这些剑法都激发在它上面；没学过专门剑法的人，手里有剑也只能凭它出招。"
msgstr "La base de la espada: las reglas de empuñar, lanzar la estocada y envainar están aquí. Estilos como la Espada de la Montaña Vacía o la Espada de los seis yin se aplican sobre ella; quien no ha aprendido un estilo propio, aunque tenga una espada en la mano, solo puede atacar con esto."

msgid "使刀的根底：劈、砍、撩、斩的力道与分寸都从这里练起。春风快意刀、短歌刀法这些刀法都激发在它上面。"
msgstr "La base del sable: la fuerza y la medida de cada tajo, golpe, barrido y corte se entrenan aquí. Estilos como el Sable de la brisa primaveral o el Sable de la canción breve se aplican sobre ella."

msgid "用手中兵刃或一双肉掌格开来招的功夫。不少剑法、刀法、杖法也能激发为招架，用本门的招式化解对方的攻势。"
msgstr "El arte de desviar un ataque con el arma que llevas en la mano o con las palmas desnudas. Muchos estilos de espada, sable y bastón también pueden aplicarse como parada, y con los movimientos de su propia escuela deshacen el ataque del rival."

msgid "只听见「锵」一声，被$p格开了。"
msgstr "¡Clang! {n:Lo desvías|$n{:el} lo desvía}."

msgid "结果「当」地一声被$p挡开了。"
msgstr "¡Clonc! {n:Lo detienes|$n{:el} lo detiene}."

msgid "但是被$n用手中兵刃架开。"
msgstr "Pero {n:lo desvías|$n{:el} lo desvía} con {n:tu|su} arma."

msgid "但是$n身子一侧，用手中兵刃格开。"
msgstr "Pero {n:te echas a un lado y lo desvías|$n{:el} se echa a un lado y lo desvía} con {n:tu|su} arma."

msgid "但是被$p格开了。"
msgstr "Pero {n:lo desvías|$n{:el} lo desvía}."

msgid "结果被$p挡开了。"
msgstr "Pero {n:lo detienes|$n{:el} lo detiene}."

msgid "闪身避让的功夫，对方的招式能不能落在身上，多半看它。倒乱七星步、火蝠身法、七宝天岚舞这类身法都激发在它上面。"
msgstr "El arte de apartarte de un salto. Que los golpes del rival te alcancen o no depende sobre todo de esto. Pasos como los Pasos caóticos de las siete estrellas, los Pasos del murciélago de fuego o la Danza de la tormenta celeste se aplican sobre ella."

msgid "但是和$p$l偏了几寸。"
msgstr "Pero pasa a unos centímetros de {n:tu $l{:0}|$l{:el} de $n{:el}}."

msgid "但是被$p机灵地躲开了。"
msgstr "Pero {n:lo esquivas|$n{:el} lo esquiva} con agilidad."

msgid "但是$n身子一侧，闪了开去。"
msgstr "Pero {n:te haces a un lado y te escabulles|$n{:el} se hace a un lado y se escabulle}."

msgid "但是被$p及时避开。"
msgstr "Pero {n:lo evitas|$n{:el} lo evita} justo a tiempo."

msgid "但是$n已有准备，不慌不忙的躲开。"
msgstr "Pero {n:lo esperabas y te apartas|$n{:el} lo esperaba y se aparta} sin prisa."

msgid "一切内功的根基。内力的上限看它，打坐积下的内力才有地方存，运功调息、回气提神也都靠它；封山派内功、天邪神功等各家心法都要激发在它上面。内功修炼有成，根骨也会随之改善。"
msgstr "La raíz de todo neigong. De ella depende el tope de tu Fuerza interior; en ella se guarda la Fuerza interior que acumulas meditando, y con ella se hace circular la energía, se regula el aliento y se recuperan Qi y Espíritu. Los métodos de cada escuela, como el Neigong de la Montaña Vacía o el Arte rebelde, se aplican sobre ella. Si tu neigong madura, tu Constitución mejorará con él."

msgid "由於你的内功修炼有成，你的体质改善了。"
msgstr "Tu neigong ha madurado y tu Constitución ha mejorado."

msgid "乔阴柳家的柳东芦于七十年前所创：他是封山剑派第十二代掌门，以剑术成名，却把家传拳法融进封山剑意，创出这套适合膂力不强之人习练的拳法，补上了封山剑派近战的短处，后来更凭它力压群雄，夺得第九代武林盟主之位。柳家拳分内八套、外八套，流传在外的多是外八套，不须内功根基，容易上手；内八套是柳家秘传，外形一样，内力窍门却全然不同。练时须空手。"
msgstr "Lo creó hace setenta años Liu Donglu, de la familia Liu de Sombra Alta. Duodécimo Maestro de la Escuela de la Montaña Vacía y famoso por su esgrima, fundió el puño de su familia en el espíritu de la espada de la Montaña Vacía y creó este estilo de puño, pensado para quienes no tienen mucha fuerza. Con él cubrió el punto débil de la escuela en el cuerpo a cuerpo y, más tarde, derrotó a todos sus rivales y se convirtió en el noveno Líder de la Alianza del wulin. El Puño de la familia Liu tiene ocho formas internas y ocho externas; fuera de la familia se conocen sobre todo las externas, que no exigen base de neigong y se aprenden con facilidad. Las internas son el secreto de los Liu: las mismas formas por fuera, pero trucos de Fuerza interior del todo distintos. Se practica con las manos desnudas."

msgid "你的体力不够了，休息一下再练吧。"
msgstr "Te has quedado sin fuerzas. Descansa un poco antes de volver a entrenar."

msgid "练柳家拳法必须空手。"
msgstr "El Puño de la familia Liu se practica con las manos desnudas."

msgid "逼"
msgstr "Presionar"

msgid "抢压"
msgstr "Embestida"

msgid "先打实一拳贴上去，贴着才打得出重拳，一拳比一拳沉；打空了就被拉开。"
msgstr "Planta un puñetazo firme y pégate al rival: solo de cerca salen los golpes pesados, cada uno más hondo que el anterior. Si fallas, te apartan."

msgid "$N使一招「古松挂月」，对准$n的$l「呼」地一拳"
msgstr "$N{:el} {N:usas|usa} \"Luna sobre el pino viejo\" y {N:lanzas|lanza} con un \"¡fiuu!\" un puñetazo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N扬起拳头，一招「傲雪冬梅」便往$n的$l招呼过去"
msgstr "$N{:el} {N:alzas|alza} el puño y {N:lanzas|lanza} \"Ciruelo desafía la nieve\" hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N左手虚晃，右拳「孤崖听涛」往$n的$l击出"
msgstr "$N{:el} {N:finges|finge} con la izquierda y {N:descargas|descarga} el puño derecho hacia {n:tu $l{:0}|$l{:el} de $n{:el}}: \"Oleaje bajo el risco solitario\""

msgid "$N步履一沉，左拳拉开，右拳使出「荒山虎吟」击向$n$l"
msgstr "$N{:el} {N:hundes|hunde} el paso, {N:echas|echa} atrás el puño izquierdo y {N:lanzas|lanza} el derecho hacia {n:tu $l{:0}|$l{:el} de $n{:el}}: \"Rugido del tigre en el monte yermo\""

msgid "封山剑派的本门内功，只能向师长学，或在运功中慢慢精熟。封山剑法必须配合它才能练；运起功来，还能为自己疗伤。"
msgstr "El neigong propio de la Escuela de la Montaña Vacía. Solo se aprende de los mayores o se va perfeccionando poco a poco al hacerlo circular. La Espada de la Montaña Vacía solo se puede practicar con él, y al hacerlo circular también sirve para curar tus propias heridas."

msgid "封山派内功只能用学的，或是从运用中增加熟练度。"
msgstr "El Neigong de la Montaña Vacía solo se aprende, o se mejora usándolo."

msgid "花紫会一脉的内功，龙头陆得财身怀此功。练功须在有水的地方，既耗气也耗内力。"
msgstr "El neigong de la línea de la Hermandad de los Mendigos; lo posee el Cabeza de Dragón Lu Decai. Debe entrenarse donde haya agua y gasta tanto Qi como Fuerza interior."

msgid "伏蛟功只能在有水的地方练。"
msgstr "El Arte de domar serpientes solo puede practicarse donde haya agua."

msgid "你的气不够。"
msgstr "No tienes Qi suficiente."

msgid "你的内力不够"
msgstr "No tienes Fuerza interior suficiente."

msgid "振远镖局的看家刀法，总镖头陈天星凭它和天邪神掌在江湖上博得「刀掌双绝」之名。招名如「春风拂人醉」「远山伴人痴」「柳叶随人笑」，刀势轻飘，撩斩之间不见锋芒。"
msgstr "El sable de la casa de los Escoltas del Largo Camino. Con él y la Palma indómita, el Escolta Mayor Chen Tianxing se ganó en el jianghu el nombre de «Maestro doble del sable y la palma». Sus movimientos se llaman \"Ebrio de brisa\", \"Perdido en las colinas lejanas\" o \"Las hojas del sauce ríen\"; el filo flota con ligereza y entre los barridos y los tajos nunca deja ver su punta."

msgid "你必须先找一把刀，才能练刀法。"
msgstr "Primero necesitas un sable para practicar el arte del sable."

msgid "你的体力不够练这门刀法，还是先休息休息吧。"
msgstr "No tienes fuerzas para este estilo de sable. Mejor descansa primero."

msgid "$N使一招「春风拂人醉」，手中$w轻飘飘地向$n的$l斩去！"
msgstr "$N{:el} {N:usas|usa} \"Ebrio de brisa\" y {N:tu|su} $w{:0} cae ligero en un tajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N金刃劈风，$w随著一招「远山伴人痴」由下而上撩往$n的$l"
msgstr "$N{:el} {N:hendes|hiende} el viento con {N:tu|su} filo dorado, y con \"Perdido en las colinas lejanas\" {N:tu|su} $w{:0} sube barriendo desde abajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身形一转，一招「飞花逐人香」$w刀光不定，斩向$n的$l"
msgstr "$N{:el} {N:giras|gira} el cuerpo con \"Pétalos tras el aroma\", y {N:tu|su} $w{:0} centellea de un lado a otro mientras corta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N舞动$w，一招「柳叶随人笑」迅捷无伦地劈向$n的$l"
msgstr "$N{:el} {N:haces|hace} girar {N:tu|su} $w{:0} y \"Las hojas del sauce ríen\" cae con rapidez sin igual hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w一晃，一招「倩影惹人怜」往$n的$l斜斜砍出一刀"
msgstr "$N{:el} {N:agitas|agita} {N:tu|su} $w{:0}: \"Silueta que enternece\", y {N:descargas|descarga} un tajo oblicuo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N提刀过肩，蓄劲发力，一招「芦雪碎人影」直劈$n$l"
msgstr "$N{:el} {N:levantas|levanta} el arma por encima del hombro, {N:reúnes|reúne} fuerza y con \"Nieve de juncos rompe la sombra\" {N:cortas|corta} de arriba abajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N移步侧身，使一招「彩蝶灼人衣」刀光霍霍斩向$n的$l"
msgstr "$N{:el} {N:mueves|mueve} los pies y {N:te pones|se pone} de lado con \"Mariposas queman la seda\"; el filo destella al cortar hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "封山剑派是当今武林最大的一支剑派，这套剑法是当年创派的三位剑术名家在封山灵狐顶相互印证、合力创出的。招式并不难学，难在剑意：自「剑气」练起，次练「剑心」「剑芒」「剑神」，四者都练到登峰造极的人少之又少，所以同是封山剑法，造诣深浅不同的人使出来，威力差之千里。剑中有「封」「点」「逐」「缺」四字诀，须以封山派内功为根基。"
msgstr "La Escuela de la Montaña Vacía es la mayor escuela de espada del wulin de hoy. Este estilo de espada lo forjaron los tres maestros fundadores contrastando su arte en la Cumbre del Zorro Espiritual, en la Montaña Vacía. Los movimientos no son difíciles de aprender; lo difícil es el espíritu de la espada: se empieza por el «Qi de la espada», luego el «Corazón de la espada», el «Filo de la espada» y el «Espíritu de la espada»; muy pocos llegan a dominar los cuatro, y por eso la misma Espada de la Montaña Vacía, en manos de unos y otros, difiere en poder como el cielo de la tierra. La espada guarda cuatro secretos: Sellar, Punta, Perseguir y Hueco, y se apoya en el Neigong de la Montaña Vacía."

msgid "你按著所学练了一遍封山剑法。"
msgstr "Repasas la Espada de la Montaña Vacía tal como la aprendiste."

msgid "你的内力或气不够，没有办法练习封山剑法。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar la Espada de la Montaña Vacía."

msgid "你的内力不够，没有办法练封山剑法。"
msgstr "No tienes Fuerza interior suficiente para practicar la Espada de la Montaña Vacía."

msgid "封山剑法必须配合封山派内功才能练。"
msgstr "La Espada de la Montaña Vacía solo se puede practicar junto con el Neigong de la Montaña Vacía."

msgid "你必须先找一把剑才能练剑法。"
msgstr "Primero necesitas una espada para practicar esgrima."

msgid "引"
msgstr "Atraer"

msgid "逐"
msgstr "Perseguir"

msgid "候隙"
msgstr "Esperar un hueco"

msgid "不抢先：对方刺空或被架开，那一下就多出一剑，可以追，也可以封。"
msgstr "No tomes la iniciativa: cuando el rival falla la estocada o es parado, ese instante te regala una estocada extra, para perseguir o para sellar."

msgid "$N使一招「峰回路转」，手中$w如一条银蛇般刺向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Picos giran, sendas serpentean\" y {N:tu|su} $w{:0} se lanza como una serpiente de plata hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出封山剑法中的「空山鸟语」，剑光霍霍斩向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Trinos en la montaña vacía\", de la Espada de la Montaña Vacía, y el filo centellea al caer hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N一招「御风而行」，身形陡然滑出数尺，手中$w斩向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Cabalgar el viento\": {N:te deslizas|se desliza} de pronto varios pasos y {N:descargas|descarga} {N:tu|su} $w{:0} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w中宫直进，一式「旭日东升」对准$n的$l刺出一剑"
msgstr "$N{:el} {N:lanzas|lanza} {N:tu|su} $w{:0} recto por el centro con \"Sol naciente en el este\", en una estocada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N纵身一跃，手中$w一招「金光泻地」对准$n的$l斜斜刺出一剑"
msgstr "$N{:el} {N:saltas|salta}, y {N:tu|su} $w{:0} cae en diagonal hacia {n:tu $l{:0}|$l{:el} de $n{:el}} con \"Luz dorada inunda la tierra\""

msgid "$N的$w凭空一指，一招「童子引路」刺向$n的$l"
msgstr "$N{:el} {N:apuntas|apunta} con {N:tu|su} $w{:0} al vacío, y con \"El niño guía el camino\" {N:lanzas|lanza} una estocada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w向外一分，使一招「柳暗花明」反手对准$n$l一剑刺去"
msgstr "$N{:el} {N:abres|abre} {N:tu|su} $w{:0} hacia fuera y, con \"Sauces oscuros, flores brillantes\", {N:giras|gira} la muñeca y {N:lanzas|lanza} una estocada de revés hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N横剑上前，身形一转手中$w使一招「空谷秋虹」画出一道光弧斩向$n的$l"
msgstr "$N{:el} {N:avanzas|avanza} con el arma en horizontal y, al girar, {N:tu|su} $w{:0} traza un arco de luz hacia {n:tu $l{:0}|$l{:el} de $n{:el}}: \"Arcoíris de otoño en el valle vacío\""

msgid "封山派开山祖师锺虔在羿水之滨的石廊峡练武时，每到夜里便与出来吸血的血蛾扑击为戏，仰望北斗七星的方位变幻，发现血蛾无论如何进攻都脱不出七星的规律，苦思几日夜创成这套步法，第一次试招便杀了六只血蛾。它专门对付身法敏捷的敌人，以自然的规律料敌机先，对方一动，便已踏到正确的闪避方位。"
msgstr "Cuando Zhong Qian, fundador de la Escuela de la Montaña Vacía, entrenaba en la Garganta del Corredor de Piedra, a orillas del río Yi, se pasaba las noches jugando a pelear con las polillas de sangre que salían a chupar sangre. Mirando cómo cambiaba la posición de las siete estrellas de la Osa Mayor, vio que, por mucho que atacaran, las polillas no se salían del orden de las siete estrellas. Tras varios días y noches de cavilar creó estos pasos, y con el primer ensayo mató a seis polillas de sangre. Están hechos contra rivales ágiles: leen al enemigo con la regla de la naturaleza, y en cuanto el rival se mueve, ya has pisado el punto justo para esquivar."

msgid "你的气或内力不够，不能练倒乱七星步法。"
msgstr "No tienes Qi o Fuerza interior suficientes para practicar los Pasos caóticos de las siete estrellas."

msgid "你的内力不够，没有办法练倒乱七星步。"
msgstr "No tienes Fuerza interior suficiente para practicar los Pasos caóticos de las siete estrellas."

msgid "$n一招「天玑离枢」轻轻巧巧地避了开去。"
msgstr "$n{:el} {n:usas|usa} \"Tianji deja el eje\" y {n:te apartas|se aparta} con soltura de un salto."

msgid "只见$n身影一晃，一式「天璇乱步」早已避在七尺之外。"
msgstr "$n{:el} {n:te desdibujas|se desdibuja} y, con \"Paso torcido de Tianxuan\", ya {n:estás|está} a más de dos metros."

msgid "$n使出「倒转天权」，轻轻松松地闪过。"
msgstr "$n{:el} {n:usas|usa} \"Tianquan invertida\" y {n:esquivas|esquiva} sin esfuerzo."

msgid "$n左足一点，一招「逐影天枢」腾空而起，避了开去。"
msgstr "$n{:el} {n:te impulsas|se impulsa} con el pie izquierdo y, con \"Tianshu persigue la sombra\", {n:te elevas|se eleva} por el aire, fuera del alcance."

msgid "可是$n使一招「风动玉衡」，身子轻轻飘了开去。"
msgstr "Pero $n{:el} {n:usas|usa} \"Viento sobre Yuheng\" y {n:te alejas|se aleja} flotando con ligereza."

msgid "$n身影微动，已经藉一招「开阳薄雾」轻轻闪过。"
msgstr "$n{:el} {n:te mueves|se mueve} apenas y, con \"Kaiyang entre la bruma\", ya {n:lo has esquivado|lo ha esquivado} con ligereza."

msgid "但是$n一招「瑶光音迟」使出，早已绕到$N身後！"
msgstr "Pero $n{:el} {n:usas|usa} \"La luz de Yaoguang se demora\" y ya {n:estás|está} detrás de {N:ti|$N{:el}}."

msgid "相传是武术之神、太阳神君杞庸在西天大山中见到灵兽天邪虎后有所领悟而创的内功心法，与模拟天邪虎神态的天邪神掌相配。威力极强，消耗体力也极大：运起来能回气、提升战力、以内力强压杀气，最深的一手是「天邪虎啸」，一声长吼震伤身边所有的人。修习须有足够的杀气撑着，苦练下去，定力也会提高。"
msgstr "Se cuenta que lo creó Qi Yong, Señor Sol y dios de las artes marciales, tras ver al Tigre rebelde, bestia espiritual, en las grandes montañas del lejano oeste; hace pareja con la Palma indómita, que imita la estampa del tigre. Es de poder inmenso y de enorme desgaste: al hacerlo circular recuperas Qi, aumentas tu fuerza de combate y aplastas la Sed de sangre con la Fuerza interior; su movimiento más hondo es el \"Rugido del Tigre rebelde\", un largo rugido que hiere a todos los que te rodean. Para practicarlo hace falta Sed de sangre suficiente que lo sostenga, y a fuerza de entrenar también sube tu Temple."

msgid "天邪神功只能用学的，或是从运用中增加熟练度。"
msgstr "El Arte rebelde solo se aprende, o se mejora usándolo."

msgid "你的杀气不够，无法领悟更高深的天邪神功。"
msgstr "No tienes Sed de sangre suficiente para comprender el Arte rebelde más profundo."

msgid "由於你苦练天邪神功，你的定力提高了"
msgstr "Gracias a tu duro entrenamiento en el Arte rebelde, tu Temple ha aumentado."

msgid "茅山派的法术，以治鬼除魔为主，多是攻敌的法术，兼有符咒之法：紫幽、青冥、苍灵「幽冥三箭」各有所长，又能召唤金甲天兵下凡护法、开「阴阳眼」看见鬼魂，还能驱动尸体。须以天师正道为根基，修为不够便领悟不了更深的道术。"
msgstr "La hechicería de la Escuela del Monte Mao, dedicada sobre todo a someter fantasmas y expulsar demonios; casi toda es magia de ataque, con talismanes y conjuros. Las «Tres flechas del inframundo», Sombra Violeta, Oscuridad Azul y Espíritu Gris, tienen cada una sus virtudes; también puede llamar del cielo a soldados celestiales de armadura dorada para que protejan, abrir el «Ojo del yin y el yang» para ver a los fantasmas e incluso mover cadáveres. Debe apoyarse en el Camino de los Maestros Celestiales; sin suficiente cultivo, no se pueden comprender las artes más profundas."

msgid "你的天师正道修为不够，无法领悟更高深的茅山道术。"
msgstr "Tu cultivo en el Camino de los Maestros Celestiales no es lo bastante profundo para comprender la Hechicería del Monte Mao más elevada."

msgid "你的精神无法集中。"
msgstr "No logras concentrar la mente."

msgid "你闭目凝神，神游物外，开始修习茅山道术中的法术...."
msgstr "Cierras los ojos y recoges la mente, dejas que tu espíritu vague más allá del mundo y empiezas a practicar los conjuros de la Hechicería del Monte Mao..."

msgid "可是你心思一乱，变出了一只面目狰狞的$N！"
msgstr "¡Pero tu mente se turba y conjuras a $N{:un} de rostro horrendo!"

msgid "你的魂魄正被$N缠住，快把它除掉吧！"
msgstr "¡Tu alma está atrapada por $N{:el}! ¡Elimínalo cuanto antes!"

msgid "你的魂魄还没有全部收回，赶快杀死你的$N吧！"
msgstr "Tu alma aún no ha vuelto del todo. ¡Acaba cuanto antes con $N{:el} que conjuraste!"

msgid "道家的主要学问，茅山派大多数武功、法术都要以它为基础。天师正道修行不够就强练道家武功法术，很容易走火入魔、坠入魔道；杀气太重的人，也修不了它。"
msgstr "El saber principal de los taoístas; la mayor parte de las artes marciales y los conjuros de la Escuela del Monte Mao se apoyan en él. Quien fuerza artes o conjuros taoístas sin suficiente cultivo en el Camino de los Maestros Celestiales corre el riesgo de perder el control del Qi y caer en el camino demoníaco; y quien lleva demasiada Sed de sangre tampoco puede cultivarlo."

msgid "法术类技能必须用学的或是从实战中获取经验。"
msgstr "Las habilidades de conjuro solo se aprenden o se ganan con experiencia en combates reales."

msgid "你的杀气太重，无法修炼天师正道。"
msgstr "Tu Sed de sangre es demasiado pesada para cultivar el Camino de los Maestros Celestiales."

msgid "道家的一门内功。人食五谷，肉身都带五谷秽气，谷衣心法把秽气排出体外，修成一层护体之气，叫作「谷衣」——神仙所修称「丹衣」，妖魔所修称「血衣」「土衣」。心法共分十层，练到第五层「小成」左眼珠变成金色，第十层「大成」两眼皆金；运起来能疗伤，也能以「灵神诀」把内力化为法力。"
msgstr "Un neigong taoísta. Quien come grano lleva en la carne la impureza del grano; el Método interno de la túnica de grano expulsa esa impureza del cuerpo y forma una capa de Qi protector llamada «túnica de grano». La que cultivan los inmortales se llama «túnica de elixir», y la que cultivan los demonios, «túnica de sangre» o «túnica de tierra». El método tiene diez niveles: al quinto, el «logro menor», el ojo izquierdo se vuelve dorado; al décimo, el «gran logro», lo son los dos. Al hacerlo circular cura heridas, y con la «Fórmula del espíritu» convierte la Fuerza interior en Poder arcano."

msgid "谷衣心法只能用学的，或是从运用中增加熟练度。"
msgstr "El Método interno de la túnica de grano solo se aprende, o se mejora usándolo."

msgid "你的魔力不够，无法提升谷衣心法的造诣。"
msgstr "Tu Poder arcano no basta para avanzar en el Método interno de la túnica de grano."

msgid "茅山派的剑法，招名「三清归真」「众士护佑」「群魔辟易」「西出紫关」，取道家护法驱魔之意。练这门剑须有相当的内力。"
msgstr "La esgrima de la Escuela del Monte Mao: sus movimientos se llaman \"Los Tres Puros\", \"Protegido por la hueste\", \"Los demonios retroceden\" y \"Salida por el paso púrpura\", y recogen el sentido taoísta de proteger la fe y exorcizar demonios. Para practicar esta espada hace falta bastante Fuerza interior."

msgid "你按著所学练了一遍天师剑法。"
msgstr "Repasas la Espada del Maestro Celestial tal como la aprendiste."

msgid "你的内力或气不够，没有办法练习天师剑法。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar la Espada del Maestro Celestial."

msgid "你的内力不够，没有办法练天师剑法。"
msgstr "No tienes Fuerza interior suficiente para practicar la Espada del Maestro Celestial."

msgid "$N一招「三清归真」，手中$w挽起几个剑花，刺向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Los Tres Puros\" y {N:tu|su} $w{:0} dibuja unas flores de espada antes de lanzarse hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身形一变，一招「众士护佑」，$w罩向$n的$l"
msgstr "$N{:el} {N:cambias|cambia} de postura con \"Protegido por la hueste\", y {N:tu|su} $w{:0} se cierra sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N挥动$w，一招「天人合一」挟著闪闪剑光袭向$n的$l"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y, con \"Cielo y hombre en uno\", {N:embistes|embiste} hacia {n:tu $l{:0}|$l{:el} de $n{:el}} entre destellos de espada"

msgid "$N手中$w一抡，使出「群魔辟易」往$n的$l恶狠狠的砍去"
msgstr "$N{:el} {N:haces|hace} girar {N:tu|su} $w{:0} y, con \"Los demonios retroceden\", {N:descargas|descarga} un tajo feroz hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N一招「西出紫关」，$w一带，轻轻划向$n$l"
msgstr "$N{:el} {N:usas|usa} \"Salida por el paso púrpura\" y {N:pasas|pasa} {N:tu|su} $w{:0} con suavidad sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身剑合一，幻化成一道光华，一招「乾坤一掷」扑向$n"
msgstr "$N{:el} {N:te fundes|se funde} con {N:tu|su} espada en un único destello de luz, y con \"Todo en una jugada\" {N:te lanzas|se lanza} sobre {n:ti|$n{:el}}"

msgid "认字读书的本事。不识字就读不了任何书谱；识字越深，研读书册时长进越快。勤学苦读，悟性也会慢慢提高，有些讲究文墨的心法也要它做底子。"
msgstr "La capacidad de leer y escribir. Sin saber leer no se puede estudiar ningún libro ni manual; cuanto mejor lees, más rápido avanzas con los libros. Si estudias con empeño, tu Ingenio también irá mejorando, y algunas artes de gusto letrado la necesitan como base."

msgid "由於你的勤学苦读，你的悟性提高了。"
msgstr "Gracias a tu empeño en el estudio, tu Ingenio ha mejorado."

msgid "宫商声律的学问。音律之学有成，灵性会随之提高；步玄派的步玄七诀以音律为根底，音律修为不够，便领悟不了更深的诀窍。"
msgstr "El saber de las notas y la afinación. Si tu estudio de la música madura, tu Espiritualidad crece con él; los Siete secretos del Paso Místico se apoyan en la música, y sin suficiente música no se pueden comprender sus trucos más profundos."

msgid "由於你学习音律之学有成，你的灵性提高了"
msgstr "Tu estudio de la música ha dado fruto, y tu Espiritualidad ha mejorado."

msgid "吹拉弹拨的技艺，与音律之学互为表里。步玄派掌门骆云舟也传这一门。"
msgstr "El oficio de soplar, frotar, pulsar y tocar, anverso y reverso del estudio de la música. Luo Yunzhou, Maestro de la Escuela del Paso Místico, también lo enseña."

msgid "赶路奔走的根底。脚下快的人追得上人，也甩得开追兵；倒乱七星步、步玄七诀、火蝠身法这类身法，都能激发为行动。"
msgstr "La base del caminar y el correr. Quien tiene pies rápidos alcanza a otros y se sacude a los perseguidores; pasos como los Pasos caóticos de las siete estrellas, los Siete secretos del Paso Místico o los Pasos del murciélago de fuego pueden aplicarse como movimiento."

msgid "使杖、使棍的根底。山烟寺的流云杖法、绝尘派的金刚杖法都激发在它上面。"
msgstr "La base del bastón y el palo. El Bastón de nubes que fluyen del Templo de la Bruma y el Bastón de vajra de la Escuela del Desapego se aplican sobre ella."

msgid "暗器出手的功夫，准头与劲道都看它。晚月庄、花紫会的人多精于此道。"
msgstr "El arte de lanzar armas ocultas; de él dependen la puntería y la fuerza. La gente de la Mansión Luna Tardía y de la Hermandad de los Mendigos suele dominarlo."

msgid "临敌时凭风声辨出兵刃来路的本事，专门用来对付看不见的敌人：鬼魂、隐形的妖物，或是在光线昏暗的地方交手。"
msgstr "El arte de distinguir por el sonido del viento por dónde viene un arma, hecho para enemigos que no se ven: fantasmas, criaturas invisibles o peleas con poca luz."

msgid "顺手牵羊的手上功夫，下手越熟越不易被人察觉，运气好坏也有几分关系。花紫会龙头陆得财懂这一手，街上的飞贼也靠它吃饭。"
msgstr "Maña de manos largas: cuanto más ducha la mano, menos fácil es que te noten, y la suerte también cuenta. Lu Decai, Cabeza de Dragón de la Hermandad de los Mendigos, conoce la treta, y los ladrones de tejados de las calles viven de ella."

msgid "模拟灵兽天邪虎神态的掌法，与天邪神功相配而成，招式有「大天罗式」「小天罗式」「雪阳三连月」「灵动五方鼓」「风雷七星断」。须空手练，天邪神功火候不足、内力太弱都练不成。"
msgstr "Un estilo de palma que imita la estampa del Tigre rebelde, bestia espiritual, nacido para hacer pareja con el Arte rebelde. Sus movimientos incluyen \"Gran red celeste\", \"Pequeña red celeste\", \"Tres lunas sobre la nieve\", \"Tambor de las cinco direcciones\" y \"Truenos de las siete estrellas\". Se practica con las manos desnudas, y no se aprende con poco Arte rebelde ni con Fuerza interior débil."

msgid "你的内力不够了，休息一下再练吧。"
msgstr "Te has quedado sin Fuerza interior. Descansa un poco antes de volver a entrenar."

msgid "练天邪神掌必须空手。"
msgstr "La Palma indómita se practica con las manos desnudas."

msgid "你的天邪神功火候不足，无法练天邪掌法。"
msgstr "Tu Arte rebelde no está lo bastante maduro para practicar la Palma indómita."

msgid "你的内力太弱，无法练天邪掌法。"
msgstr "Tu Fuerza interior es demasiado débil para practicar la Palma indómita."

msgid "$N使出一招「大天罗式」，右掌穿出击向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Gran red celeste\" y {N:lanzas|lanza} la palma derecha hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出一招「大天罗式」，左掌化虚为实击向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Gran red celeste\": {N:tu|su} palma izquierda pasa de finta a golpe real hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出天邪掌法「小天罗式」，如鬼魅般欺至$n身前，一掌拍向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Pequeña red celeste\", de la Palma indómita, {N:te acercas|se acerca} a {n:ti|$n{:el}} como un espectro y {N:descargas|descarga} una palmada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N双掌一错，使出「雪阳三连月」，对准$n的$l连续拍出三掌"
msgstr "$N{:el} {N:cruzas|cruza} las palmas y, con \"Tres lunas sobre la nieve\", {N:golpeas|golpea} tres veces seguidas hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N左掌画了个圈圈，右掌推出，一招「灵动五方鼓」击向$n$l"
msgstr "$N{:el} {N:trazas|traza} un círculo con la palma izquierda y {N:empujas|empuja} la derecha: \"Tambor de las cinco direcciones\", hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出「风雷七星断」，身形散作七处同时向$n的$l出掌攻击"
msgstr "$N{:el} {N:usas|usa} \"Truenos de las siete estrellas\": {N:tu|su} cuerpo se reparte en siete a la vez, y cada uno golpea con la palma hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N吐气扬声，一招「气撼九重天」双掌并力推出"
msgstr "$N{:el} {N:exhalas|exhala} con un grito y, con \"El Qi sacude los nueve cielos\", {N:empujas|empuja} las dos palmas a la vez"

msgid "本是道家魔道的武功。三百年前一位天邪派前辈在首穷山一处废墟中得到六阴剑谱，谱分天殇、追魂、绝识三部，他年轻时练武伤了经脉，只练成追魂一部，另外两部至今下落不明。天邪派所传的追魂剑经三百多年演变，戾气消去不少而劲道更增，虽已失传了不少阴毒招式，仍是武林中赫赫有名的剑法。"
msgstr "En origen, un arte marcial del camino demoníaco taoísta. Hace trescientos años un anciano de la Escuela Rebelde halló en unas ruinas del monte Shouqiong el Manual de la espada de los seis yin, que se dividía en tres partes: Ruina del cielo, Persecución del alma y Corte de la conciencia; de joven se dañó los meridianos al practicar y solo logró dominar la de Persecución del alma, y las otras dos siguen perdidas. En más de trescientos años de transmisión, la espada de Persecución del alma de la Escuela Rebelde ha perdido buena parte de su veneno y ganado fuerza, y aunque se hayan perdido muchos de sus movimientos más crueles, sigue siendo una espada de gran fama en el wulin."

msgid "你按著所学练了一遍六阴追魂剑法。"
msgstr "Repasas la Espada de los seis yin tal como la aprendiste."

msgid "你的内力或气不够，没有办法练习六阴追魂剑。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar la Espada de los seis yin."

msgid "你的内力不够，没有办法练六阴追魂剑。"
msgstr "No tienes Fuerza interior suficiente para practicar la Espada de los seis yin."

msgid "你突然觉得一股恶气冲上心头，只觉得想杀人...."
msgstr "De pronto un rencor malsano te sube al corazón, y lo único que quieres es matar..."

msgid "$N使一招「群魔乱舞」，手中$w狂风骤雨般地向$n的$l连攻数剑"
msgstr "$N{:el} {N:usas|usa} \"Danza desatada de demonios\" y {N:tu|su} $w{:0} cae como una tormenta, tajo tras tajo, hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身形一转，一招「厉鬼缠身」$w斩向$n的$l"
msgstr "$N{:el} {N:giras|gira} el cuerpo con \"Fantasma furioso se aferra\", y {N:tu|su} $w{:0} corta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N舞动$w，一招「百鬼夜行」挟著闪闪剑光刺向$n的$l"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y, con \"Desfile nocturno de cien fantasmas\", {N:atacas|ataca} hacia {n:tu $l{:0}|$l{:el} de $n{:el}} entre destellos de espada"

msgid "$N手中$w一抖，使出「饿鬼拦路」往$n的$l刺出一剑"
msgstr "$N{:el} {N:sacudes|sacude} {N:tu|su} $w{:0} y, con \"Fantasma hambriento cierra el paso\", {N:lanzas|lanza} una estocada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w剑光暴长，一招「鬼影幢幢」往$n$l刺去"
msgstr "La luz de {N:tu $w{:0}|$w{:el} de $N{:el}} se alarga de golpe y, con \"Sombras de fantasmas\", se lanza hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w直指$n$l，一招「秋坟鬼唱」发出逼人剑气刺去"
msgstr "$N{:el} {N:apuntas|apunta} {N:tu|su} $w{:0} hacia {n:tu $l{:0}|$l{:el} de $n{:el}} y, con \"Canto fantasma en la tumba de otoño\", {N:atacas|ataca} con un filo de espada que oprime"

msgid "仿蝙蝠夜飞的身法，招名「寒蝠掠江」「轻蝠点梢」「夜蝠旋身」「火蝠曳空」，侧身一让，便叫来招扑了个空。天邪派与振远镖局都有高手使这门身法。"
msgstr "Pasos que imitan el vuelo nocturno de los murciélagos, con movimientos llamados \"Murciélago frío roza el río\", \"Murciélago ligero sobre la rama\", \"Murciélago nocturno gira\" y \"Murciélago de fuego surca el cielo\": un paso de lado, y el ataque se lanza contra el aire vacío. Hay maestros de estos pasos en la Escuela Rebelde y en los Escoltas del Largo Camino."

msgid "你的体力太差了，不能练火蝠身法。"
msgstr "No tienes fuerzas suficientes para practicar los Pasos del murciélago de fuego."

msgid "可是$p侧身一让，使出「寒蝠掠江」，$N这一招扑了个空。"
msgstr "Pero $n{:el} {n:te echas|se echa} a un lado con \"Murciélago frío roza el río\", y el ataque de {N:ti|$N{:el}} se lanza contra el aire vacío."

msgid "$p身形微晃，使出「灵蝠轻逝」，有惊无险地避开了$N这一招。"
msgstr "$n{:el} {n:te meces|se mece} un instante con \"El murciélago espiritual se esfuma\" y {n:evitas|evita} por un pelo el ataque de {N:ti|$N{:el}}."

msgid "$p身随意转，一式「轻蝠点梢」，倏地往一旁挪开了三尺，避过了这一招。"
msgstr "$n{:el} {n:te vuelves|se vuelve} a voluntad con \"Murciélago ligero sobre la rama\" y, en un parpadeo, {n:te apartas|se aparta} casi un metro, fuera del ataque."

msgid "却见$p足不点地，一招「夜蝠旋身」，往旁窜开数尺，躲了开去。"
msgstr "Pero $n{:el}, con los pies apenas rozando el suelo, {n:usas|usa} \"Murciélago nocturno gira\" y {n:te lanzas|se lanza} varios pasos de lado, fuera del alcance."

msgid "只见$p一招「火蝠曳空」，身形向上拔起数尺高，闪了过去。"
msgstr "$n{:el} {n:usas|usa} \"Murciélago de fuego surca el cielo\" y {n:te elevas|se eleva} varios pasos hacia arriba, fuera del golpe."

msgid "晚月庄的舞步身法，招名「蕙芳下凡」「双成献舞」「织女于归」「天女散花」「嫦娥奔月」，翩然起舞之间，已飘出数尺之外。只有女子才能练，又看灵性；勤练舞技，容貌也会更添光彩。"
msgstr "La danza de la Mansión Luna Tardía: sus movimientos se llaman \"Hada Orquídea desciende\", \"Shuangcheng baila\", \"La Tejedora se casa\", \"La doncella celeste esparce flores\" y \"Chang'e vuela a la luna\", y entre giros de baile ya te has apartado varios pasos. Solo pueden practicarla las mujeres, y depende de la Espiritualidad; si entrenas la danza, tu Apariencia también ganará brillo."

msgid "你的精神太差了，不能练七宝天岚舞。"
msgstr "Tu Espíritu está demasiado flojo para practicar la Danza de la tormenta celeste."

msgid "七宝天岚舞只有女性才能练。"
msgstr "La Danza de la tormenta celeste solo pueden practicarla las mujeres."

msgid "你的灵性不够，没有办法练七宝天岚舞。"
msgstr "Tu Espiritualidad no basta para practicar la Danza de la tormenta celeste."

msgid "由於你勤练舞技，你的容貌提高了"
msgstr "Gracias a tu empeño en la danza, tu Apariencia ha mejorado."

msgid "但$n一式「蕙芳下凡」随著轻轻一叹，顺著$N的招式飘出六尺之外！"
msgstr "Pero $n{:el}, con un leve suspiro, {n:usas|usa} \"Hada Orquídea desciende\" y {n:te alejas|se aleja} flotando casi dos metros siguiendo el ataque de {N:ti|$N{:el}}."

msgid "$n双脚微动翩然起舞，一招「双成献舞」，堪堪闪过$N的这招！"
msgstr "$n{:el} {n:mueves|mueve} los pies en un baile grácil con \"Shuangcheng baila\" y {n:esquivas|esquiva} por muy poco el ataque de {N:ti|$N{:el}}."

msgid "$n使出「织女于归」，突然幻化成一双倩影，$N从其中一人透体而过！"
msgstr "$n{:el} {n:usas|usa} \"La Tejedora se casa\" y {n:te desdoblas|se desdobla} de pronto en dos siluetas hermosas: ¡$N{:el} {N:atraviesas|atraviesa} limpiamente a una de ellas!"

msgid "$n一式「天女散花」，自水袖中散出一片花雨，$N被花影迷蒙了双眼，与$n擦肩而过"
msgstr "$n{:el} {n:usas|usa} \"La doncella celeste esparce flores\" y {n:esparces|esparce} una lluvia de pétalos desde las mangas; $N{:el} {N:quedas|queda} con los ojos nublados por la sombra de las flores y {N:pasas|pasa} rozando a {n:ti|$n{:el}}"

msgid "$n一招「嫦娥奔月」，轻轻一纵优雅的自$N头顶越过！"
msgstr "$n{:el} {n:usas|usa} \"Chang'e vuela a la luna\" y {n:saltas|salta} con ligereza y elegancia por encima de {N:tu cabeza|la cabeza de $N{:el}}"

msgid "神通一类法门的根底：灵力的上限看它，施展神通要用灵力。山烟寺的八识神通便激发在它上面。"
msgstr "La base de las artes del poder místico: de ella depende el tope del Poder místico, y usar un poder místico cuesta Poder místico. El Poder de las ocho conciencias del Templo de la Bruma se aplica sobre ella."

msgid "念咒施法的根底：法力的上限看它，冥思积下的法力才有地方存。茅山道术、奇门遁甲这些法术都激发在它上面。"
msgstr "La base de lanzar conjuros: de ella depende el tope del Poder arcano, y es donde cabe el Poder arcano que acumulas contemplando. Artes como la Hechicería del Monte Mao o el Qimen Dunjia se aplican sobre ella."

msgid "道家旁门的一路学问，绝尘派的奇门遁甲以它为根基，小天魔道修为不够，便领悟不了更深的遁甲之术。它只能向师父学，或在实战中体会；每有长进，杀气也跟着重一分。"
msgstr "Un saber de las sendas laterales del taoísmo. El Qimen Dunjia de la Escuela del Desapego se apoya en él, y sin suficiente Saber demoníaco menor no se pueden comprender sus artes más hondas. Solo se aprende de un Shifu o se capta en combates reales, y cada avance hace un poco más pesada tu Sed de sangre."

msgid "绝尘派的法术。口中念咒，大喝一声「疾！」，或化作黑气、金光、火焰、长虹、大雾遁去无踪，或以黑气、金光、火焰、海水、大木把敌人困在当中；战到危急，还能召来天将相助。须以小天魔道为根基。"
msgstr "La hechicería de la Escuela del Desapego. Se recita un conjuro y se grita \"¡Presto!\": o bien te esfumas sin dejar rastro convertido en vapor negro, luz dorada, llamas, arcoíris o niebla espesa, o bien atrapas al enemigo dentro de vapor negro, luz dorada, llamas, agua de mar o grandes árboles; cuando el combate se pone crítico, hasta puedes llamar a un general celestial en tu ayuda. Debe apoyarse en el Saber demoníaco menor."

msgid "你的小天魔道修为不够，无法领悟更高深的奇门遁甲之术。"
msgstr "Tu Saber demoníaco menor no es lo bastante profundo para comprender las artes más elevadas del Qimen Dunjia."

msgid "绝尘派的本门内功。绝尘子本是释家中人，后得奇人指点，悟得道家真谛，佛道双修，自号绝尘，创下此派；这门心法只能向师父学，或在运功中慢慢精熟。"
msgstr "El neigong propio de la Escuela del Desapego. Juechenzi fue en origen un budista; guiado después por un hombre extraordinario, comprendió el verdadero sentido del taoísmo, cultivó a la vez budismo y taoísmo, se dio el nombre de Juechen, «Desapego», y fundó esta escuela. El método solo se aprende de un Shifu o se va perfeccionando poco a poco al hacerlo circular."

msgid "绝尘心法只能用学的或是从运用中增加熟练度。"
msgstr "El Método interno del Desapego solo se aprende, o se mejora usándolo."

msgid "绝尘派所传的杖法，招式与山烟寺的流云杖法相同，是「天光乍现」「雨后初晴」「浮云写意」「游龙穿云」四式，起手一杖专扫下盘。练这门杖须有相当的膂力，膂力不足的人宜先把内力练足。"
msgstr "El estilo de bastón que transmite la Escuela del Desapego; sus movimientos son los mismos del Bastón de nubes que fluyen del Templo de la Bruma: las cuatro formas \"Irrumpe la primera luz\", \"Claro tras la lluvia\", \"Pincelada de nubes\" y \"Dragón errante cruza las nubes\", y la primera barre bajo, contra las piernas. Para practicarlo hace falta bastante Fuerza; quien no la tenga hará bien en entrenar primero su Fuerza interior."

msgid "你必须先找一根木杖或者是类似的武器，才能练杖法。"
msgstr "Primero necesitas un bastón de madera o un arma parecida para practicar el arte del bastón."

msgid "你的体力不够练这门杖法，还是先休息休息吧。"
msgstr "No tienes fuerzas para este estilo de bastón. Mejor descansa primero."

msgid "你的膂力还不够，也许该练一练内力来增强力量。"
msgstr "Todavía no tienes Fuerza suficiente. Quizá deberías entrenar tu Fuerza interior para aumentarla."

msgid "$N使一招「天光乍现」，手中$w扫向$n下盘！"
msgstr "$N{:el} {N:usas|usa} \"Irrumpe la primera luz\" y {N:tu|su} $w{:0} barre {n:tus piernas|las piernas de $n{:el}}"

msgid "挫伤"
msgstr "contusión"

msgid "$N挥起$w，一招「雨後初晴」攻向$n$l！"
msgstr "$N{:el} {N:alzas|alza} {N:tu|su} $w{:0} y, con \"Claro tras la lluvia\", {N:atacas|ataca} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N横过手中$w，使出「浮云写意」击向$n$l！"
msgstr "$N{:el} {N:cruzas|cruza} {N:tu|su} $w{:0} en horizontal y, con \"Pincelada de nubes\", {N:golpeas|golpea} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出一招「游龙穿云」，$w一挺撞向$n$l！"
msgstr "$N{:el} {N:usas|usa} \"Dragón errante cruza las nubes\" y {N:tu|su} $w{:0} se proyecta hacia delante y embiste contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "山烟寺的杖法，招名「天光乍现」「雨后初晴」「浮云写意」「游龙穿云」，可攻可守。番坊日陀罗寺的龙若法王也传这门杖法。练这门杖须有相当的膂力。"
msgstr "El estilo de bastón del Templo de la Bruma, con los movimientos \"Irrumpe la primera luz\", \"Claro tras la lluvia\", \"Pincelada de nubes\" y \"Dragón errante cruza las nubes\"; sirve para atacar y para defender. El Rey del Dharma Longruo, del Templo Ritola del Barrio Extranjero, también enseña este bastón. Para practicarlo hace falta bastante Fuerza."

msgid "五百多年前北冥大泽的黑妖蛇族入侵，一群佛门高僧集思广益，悟出这套心法为百姓疗伤，主要用来迅速医治战斗中所受的皮肉创伤。运起功来既能医治自己，也能替别人疗伤；须以大乘佛法为根基，佛法修为跟不上，便领会不了更深的境界。"
msgstr "Hace más de quinientos años, cuando invadió el clan de las serpientes negras demoníacas de la Gran ciénaga de Beiming, un grupo de monjes budistas eminentes juntó su ingenio y alcanzó este método para curar al pueblo; sirve sobre todo para tratar con rapidez las heridas de la carne recibidas en combate. Al hacerlo circular cura a uno mismo o a otros; debe apoyarse en el Dharma mahayana, y si el Dharma no sigue el paso, no se pueden comprender sus niveles más hondos."

msgid "莲华心法只能用学的，或是从运用中增加熟练度。"
msgstr "El Método interno del loto solo se aprende, o se mejora usándolo."

msgid "你的大乘佛法修为不够，无法领会更高深的莲华心法。"
msgstr "Tu cultivo del Dharma mahayana no es lo bastante profundo para comprender el Método interno del loto más elevado."

msgid "从天竺传来的一部内功，性子是火性的：运起来浑身发热，专克阴寒。只能用学的，没有运功的法门；中原只有日陀罗寺的人会，独眼头陀那只眼就是练它练坏的。"
msgstr "Un neigong llegado de la India, de naturaleza ardiente: al hacerlo circular el cuerpo entero se calienta, y es el azote del frío yin. Solo se aprende, y no tiene método para hacerlo circular. En las Llanuras Centrales solo lo conoce la gente del Templo Ritola; el ojo del Asceta tuerto se arruinó precisamente entrenándolo."

msgid "婆萝蜜多心经只能用学的。"
msgstr "El Sutra del Corazón solo se aprende."

msgid "佛门的根本学问，莲华心法、八识神通都以它为根基。杀气太重的人，修不了大乘佛法。"
msgstr "El saber fundamental del budismo; el Método interno del loto y el Poder de las ocho conciencias se apoyan en él. Quien lleva demasiada Sed de sangre no puede cultivar el Dharma mahayana."

msgid "你的杀气太重，无法修炼大乘佛法。"
msgstr "Tu Sed de sangre es demasiado pesada para cultivar el Dharma mahayana."

msgid "佛门弟子的日课，晨钟暮鼓之间念诵经文。山烟寺、日陀罗寺的僧人都会这一门。"
msgstr "La tarea diaria de los discípulos budistas: recitar sutras entre la campana de la mañana y el tambor de la tarde. Los monjes del Templo de la Bruma y del Templo Ritola dominan este arte."

msgid "佛家一门十分神奇的神通法术，由六百年前的高僧空正大师传下。神通分为八识，各以人的一种隐藏潜力为动力，如今传下来的有三识：心识救醒昏迷濒死之人，游识一念之间便到你见过的人身边，空识把灵力化为潜能。须与高深的佛法相辅，佛法修为不够便学不了。"
msgstr "Un arte mística budista muy prodigiosa, transmitida hace seiscientos años por el eminente monje Maestro Kongzheng. El poder se divide en ocho conciencias, cada una movida por un potencial oculto de la persona, y hoy se conservan tres: la conciencia del corazón despierta a quien yace inconsciente y al borde de la muerte; la conciencia errante te lleva en un pensamiento junto a alguien que has visto; y la conciencia vacía convierte el Poder místico en Potencial. Debe ir de la mano de un Dharma profundo; si el Dharma no basta, no se puede aprender."

msgid "你的佛法修为还不够高深，无法学习八识神通。"
msgstr "Tu cultivo del Dharma aún no es lo bastante profundo para aprender el Poder de las ocho conciencias."

msgid "使鞭的根底，软鞭出手要收得回来。晚月庄的寒雪鞭法激发在它上面。"
msgstr "La base del látigo: un látigo blando que sale de la mano tiene que poder volver. El Látigo de nieve fría de la Mansión Luna Tardía se aplica sobre ella."

msgid "使锤一类重兵器的根底，凭的是一身力气。"
msgstr "La base de los martillos y otras armas pesadas; todo depende de la fuerza bruta."

msgid "使斧的根底，大开大合，一斧下去要劈得开。"
msgstr "La base del hacha: balanceos grandes y abiertos, y cada golpe tiene que partir lo que alcance."

msgid "使匕首一类短刃的根底，贴身近打，出手要快。"
msgstr "La base de las dagas y otras hojas cortas: pelea de cerca, y la mano tiene que ser rápida."

msgid "使钢叉一类长兵的根底。阴间的鬼卒，手里多是钢叉。"
msgstr "La base de los tridentes y otras armas largas. Los soldados fantasma del Inframundo suelen llevar tridentes."

msgid "晚月庄的指法，只有女子才能练，须空手。招名「菊楼采月」「雪桥翦梅」「柳亭簪花」「桃坟扑蝶」，身影忽前忽后，一转身指尖已点到要害。"
msgstr "El arte de dedos de la Mansión Luna Tardía, solo para mujeres, y con las manos desnudas. Sus movimientos se llaman \"Luna de crisantemo\", \"Ciruelo cortado en el puente de nieve\", \"Flor de horquilla en el pabellón del sauce\" y \"Mariposa sobre la tumba de durazno\"; la silueta va y viene, y al girar la yema del dedo ya ha tocado un punto vital."

msgid "你的内力不够了。"
msgstr "Tu Fuerza interior se ha agotado."

msgid "你的精神无法集中了，休息一下再练吧。"
msgstr "No logras mantener la mente concentrada. Descansa un poco antes de volver a entrenar."

msgid "柔虹指是只有女子才能练的武功。"
msgstr "Solo las mujeres pueden aprender el Dedo del arcoíris suave."

msgid "练柔虹指必须空手。"
msgstr "El Dedo del arcoíris suave se practica con las manos desnudas."

msgid "$N左手一挥，一招「菊楼采月」右手点向$n$l"
msgstr "$N{:el} {N:agitas|agita} la mano izquierda y, con \"Luna de crisantemo\", {N:señalas|señala} con la derecha hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "右手食指"
msgstr "dedo índice derecho"

msgid "$N使一招「雪桥翦梅」，身影忽前忽後，突然一转身左手往$n的$l点去"
msgstr "$N{:el} {N:usas|usa} \"Ciruelo cortado en el puente de nieve\": la silueta va y viene y, de pronto, {N:giras|gira} y {N:señalas|señala} con la izquierda hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "左手中指"
msgstr "dedo medio izquierdo"

msgid "$N身法稍顿，左手一扬使出「柳亭簪花」往$n的$l点去"
msgstr "$N{:el} {N:detienes|detiene} un instante el paso, {N:alzas|alza} la mano izquierda con \"Flor de horquilla en el pabellón del sauce\" y {N:señalas|señala} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "只见$N纤腰一摆，陡然滑出数尺，右手顺著来势一招「桃坟扑蝶」往$n的$l点去"
msgstr "$N{:el} {N:meces|mece} la cintura esbelta y {N:te deslizas|se desliza} de pronto varios pasos; siguiendo el impulso, con \"Mariposa sobre la tumba de durazno\" {N:señalas|señala} con la derecha hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "晚月庄的鞭法，从「寒风起兮」「漫天飞雪」到「狂风骤雪」「风雪交加」，鞭影如满天飞雪，虚虚实实地袭人。须有足够的内力才能练。"
msgstr "El arte de látigo de la Mansión Luna Tardía, de \"Se alza el viento frío\" y \"Nieve llena el cielo\" a \"Vendaval y nevasca\" y \"Ventisca\": las sombras del látigo caen como nieve por todo el cielo, entre lo falso y lo cierto. Hace falta Fuerza interior suficiente para practicarlo."

msgid "你按著所学练了一遍寒雪鞭法。"
msgstr "Repasas el Látigo de nieve fría tal como lo aprendiste."

msgid "你的内力或气不够，没有办法练习寒雪鞭法。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar el Látigo de nieve fría."

msgid "你的内力不够，没有办法练寒雪鞭法, 多练些内力再来吧。"
msgstr "No tienes Fuerza interior suficiente para practicar el Látigo de nieve fría; vuelve cuando hayas entrenado más."

msgid "你必须先找一条鞭子才能练鞭法。"
msgstr "Primero necesitas un látigo para practicar el arte del látigo."

msgid "$N使一招「寒风起兮」，手中$w抖得笔直向$n的$l连刺数鞭"
msgstr "$N{:el} {N:usas|usa} \"Se alza el viento frío\" y {N:tu|su} $w{:0} se tensa recto y se clava una y otra vez hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身形一转，一招「漫天飞雪」$w幻出满天鞭影，虚虚实实地袭向$n的$l"
msgstr "$N{:el} {N:giras|gira} el cuerpo con \"Nieve llena el cielo\", y {N:tu|su} $w{:0} llena el aire de sombras de látigo, entre lo falso y lo cierto, hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N力贯$w，一招「雪花翩翩」点点鞭影飘浮不定地点向$n的$l"
msgstr "$N{:el} {N:cargas|carga} fuerza en {N:tu|su} $w{:0} y, con \"Copos que danzan\", motas de sombra de látigo caen inciertas sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w一抖，一招「积雪三尺」以一个怪异的角度往$n下盘卷去"
msgstr "$N{:el} {N:sacudes|sacude} {N:tu|su} $w{:0} y, con \"Nieve de tres pies\", esta se enrosca en un ángulo extraño contra {n:tus piernas|las piernas de $n{:el}}"

msgid "$N手中一紧，使招「狂风骤雪」，手里$w一鞭接著一鞭不停地抽向$n的$l"
msgstr "$N{:el} {N:aprietas|aprieta} la mano y, con \"Vendaval y nevasca\", {N:azotas|azota} con {N:tu|su} $w{:0} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}, golpe tras golpe y sin pausa"

msgid "鞭伤"
msgstr "verdugón"

msgid "$N一招「风雪交加」手中$w舞出一片鞭影扫向$n全身"
msgstr "$N{:el} {N:usas|usa} \"Ventisca\" y {N:tu|su} $w{:0} baila en una cortina de sombras de látigo que barre todo el cuerpo de {n:ti|$n{:el}}"

msgid "三十年前以一柄拂尘横扫武林的前辈异人残心师太所创的内功心法，纯走阴柔之路，发出的内劲寒冷无比；传说她曾在沙牢山一掌冻住七只雪狼，堪称当今寒冰掌一路中最凌厉的奇功。交手时阴寒之气常叫对方打个寒噤，运起「意寒睨」，更能以冰冷如刀的眼神伤敌。"
msgstr "Un neigong creado hace treinta años por la Abadesa Canxin, extraordinaria veterana que barrió el wulin con un espantamoscas de crin. Sigue solo la vía yin y suave, y la fuerza interior que emite es de un frío extremo; cuentan que en el monte Shalao congeló con una sola palma a siete lobos de nieve, y bien puede ser el arte más implacable de los de palma helada de hoy. En combate, su frío yin hace tiritar a menudo al rival, y al hacer circular la «Mirada de la intención helada» puedes herir al enemigo con una mirada fría como una hoja."

msgid "$N的招式挟著一股阴寒无比的劲风使得$n不禁打了个寒噤。"
msgstr "{N:Tu ataque trae|El ataque de $N{:el} trae} un viento de frío yin tan intenso que {n:no puedes evitar tiritar|$n{:el} no puede evitar tiritar}."

msgid "意寒功只能用学的，或是从运用中增加熟练度。"
msgstr "El Arte de la intención helada solo se aprende, o se mejora usándolo."

msgid "天山一脉的独门内功，只能向师父学，或在运功中慢慢精熟；雪影剑法必须以它为根基。"
msgstr "El neigong propio de la línea de Tianshan; solo se aprende de un Shifu o se va perfeccionando poco a poco al hacerlo circular; la Espada de la sombra de nieve debe apoyarse en él."

msgid "天山雪影心法只能用学的或是从运用中增加熟练度。"
msgstr "El Método interno de la sombra de nieve de Tianshan solo se aprende, o se mejora usándolo."

msgid "天山雪影剑，招名「回光幻电」「风霜碎影」「残阳照雪」「冰谷初虹」「长空雷隐」「断石狼烟」，剑光疾如闪电，身形飘忽如雪影。必须配合天山魔教的独门雪影心法才能练，内力不足也练不成。"
msgstr "La Espada de la sombra de nieve de Tianshan, con movimientos llamados \"Relámpago fantasma\", \"La escarcha rompe sombras\", \"Sol poniente sobre la nieve\", \"Arcoíris del valle helado\", \"Trueno en el cielo abierto\" y \"Almenara de piedra rota\": la luz de la espada es rápida como un relámpago y el cuerpo flota como una sombra sobre la nieve. Solo puede practicarse junto con el Método interno de la sombra de nieve, propio de la Orden Demoníaca de Tianshan, y no con poca Fuerza interior."

msgid "你按著所学练了一遍雪影剑法。"
msgstr "Repasas la Espada de la sombra de nieve tal como la aprendiste."

msgid "你的内力或气不够，没有办法练习雪影剑法。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar la Espada de la sombra de nieve."

msgid "你的内力不够，没有办法练雪影剑法。"
msgstr "No tienes Fuerza interior suficiente para practicar la Espada de la sombra de nieve."

msgid "雪影剑法必须配合天山魔教的独门雪影心法才能练。"
msgstr "La Espada de la sombra de nieve solo se puede practicar junto con el Método interno de la sombra de nieve, propio de la Orden Demoníaca de Tianshan."

msgid "$N使一招「回光幻电」，手中$w幻一条疾光刺向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Relámpago fantasma\" y {N:tu|su} $w{:0} se vuelve un rayo de luz veloz que se lanza hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出天山雪影剑中的「风霜碎影」，$w连挥剑光霍霍斩向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"La escarcha rompe sombras\", de la Espada de la sombra de nieve de Tianshan, y {N:tu|su} $w{:0} destella una y otra vez al cortar hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N一招「残阳照雪」，纵身飘开数尺，手中$w斩向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Sol poniente sobre la nieve\": {N:te desplazas|se desplaza} flotando varios pasos y {N:tu|su} $w{:0} corta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w中宫直进，一式「冰谷初虹」对准$n的$l刺出一剑"
msgstr "$N{:el} {N:lanzas|lanza} {N:tu|su} $w{:0} recto por el centro con \"Arcoíris del valle helado\", en una estocada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N纵身一跃，手中$w一招「长空雷隐」对准$n的$l斜斜刺出一剑"
msgstr "$N{:el} {N:saltas|salta}, y {N:tu|su} $w{:0} cae en diagonal hacia {n:tu $l{:0}|$l{:el} de $n{:el}} con \"Trueno en el cielo abierto\""

msgid "$N的$w凭空一指，一招「断石狼烟」刺向$n的$l"
msgstr "$N{:el} {N:apuntas|apunta} con {N:tu|su} $w{:0} al vacío y, con \"Almenara de piedra rota\", {N:lanzas|lanza} una estocada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "四百年前「秃笔狂生」骆步玄的成名武功。他原是一介书生，未曾拜师学艺，十九岁起赴京应试，屡试不中，某年考完步出试场，偶一抬头望见街边书肆的一幅对子，竟悟出一套神奇的武功，从此闯荡江湖未逢敌手，五十岁回京定居，创立了步玄派。步玄七诀号称天下轻功「轻捷第一」，姿态潇洒有如书法，第一式「玄羽乱舞」能在短时间里加快身法；须配合步玄心法，又以音律之学为根底。"
msgstr "La obra que dio fama a Luo Buxuan, «el Loco del Pincel Pelado», hace cuatrocientos años. Era un simple letrado que nunca estudió con maestro alguno. Desde los diecinueve años iba a la capital a presentarse a los exámenes y siempre suspendía; un año, al salir de la sala del examen, alzó la vista por casualidad y vio unos versos pareados en una librería de la calle, y de ellos dedujo un arte marcial prodigioso. Desde entonces recorrió el jianghu sin encontrar rival, y a los cincuenta años se estableció en la capital y fundó la Escuela del Paso Místico. Se dice que los Siete secretos del Paso Místico son el qinggong «más ligero bajo el cielo», de porte elegante como la caligrafía; la primera forma, \"Plumas oscuras en danza\", acelera los pasos por un breve tiempo. Debe usarse junto con el Método interno del Paso Místico, y se apoya en el estudio de la música."

msgid "你的气或神不够，不能练步玄七诀。"
msgstr "No tienes Qi o Espíritu suficientes para practicar los Siete secretos del Paso Místico."

msgid "步玄七诀必须配合步玄心法使用。"
msgstr "Los Siete secretos del Paso Místico deben usarse junto con el Método interno del Paso Místico."

msgid "你的音律之学修为不够，无法领悟更高深的步玄七诀。"
msgstr "Tu estudio de la música no es lo bastante profundo para comprender los Siete secretos del Paso Místico más elevados."

msgid "$n身影一转，轻易地避开了这一招。"
msgstr "$n{:el} {n:te giras|se gira} y {n:evitas|evita} el ataque sin esfuerzo."

msgid "$n身法飘忽，左一点，右一顿，早已闪在一旁。"
msgstr "$n{:el} {n:te mueves|se mueve} con ligereza: un toque a la izquierda, una pausa a la derecha, y ya {n:estás|está} a un lado."

msgid "但是$n身影一侧，在间不容发之际从容地避开了这一招。"
msgstr "Pero $n{:el} {n:te ladeas|se ladea} y, con un pelo de margen, {n:evitas|evita} el ataque con calma."

msgid "$n身形陡然拔高，使$N的攻势尽数落空。"
msgstr "$n{:el} {n:te elevas|se eleva} de golpe y el ataque de {N:ti|$N{:el}} no encuentra más que aire."

msgid "$n右足一点，身影向左滑开数尺，避了开去。"
msgstr "$n{:el} {n:te impulsas|se impulsa} con el pie derecho y {n:te deslizas|se desliza} varios pasos hacia la izquierda, fuera del camino."

msgid "步玄派的本门内功，只能向师父学，或在运功中慢慢精熟；步玄七诀、小步玄剑都要以它为根基。"
msgstr "El neigong propio de la Escuela del Paso Místico; solo se aprende de un Shifu o se va perfeccionando poco a poco al hacerlo circular. Los Siete secretos del Paso Místico y la Espada menor del Paso Místico se apoyan en él."

msgid "步玄心法只能学，或是从运用中增加熟练度。"
msgstr "El Método interno del Paso Místico solo se aprende, o se mejora usándolo."

msgid "步玄派的剑法，招名「暮雪三叹」「处子弄笛」「阳谷白练」，出剑急如骤雨。须先有相当火候的步玄心法，内力不足也练不成。"
msgstr "La esgrima de la Escuela del Paso Místico, con movimientos llamados \"Tres suspiros en la nieve del ocaso\", \"La doncella toca la flauta\" y \"Seda blanca del valle soleado\"; la espada llega rápida como un aguacero. Hace falta antes un Método interno del Paso Místico de cierto temple, y no se aprende con poca Fuerza interior."

msgid "你按著所学练了一遍小步玄剑。"
msgstr "Repasas la Espada menor del Paso Místico tal como la aprendiste."

msgid "你的内力或气不够，没有办法练习小步玄剑。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar la Espada menor del Paso Místico."

msgid "你的步玄心法火候还不够。"
msgstr "Tu Método interno del Paso Místico aún no está lo bastante maduro."

msgid "你的内力不够，没有办法练小步玄剑。"
msgstr "No tienes Fuerza interior suficiente para practicar la Espada menor del Paso Místico."

msgid "$N使一招「暮雪三叹」，手中$w急如骤雨般地刺向$n$l"
msgstr "$N{:el} {N:usas|usa} \"Tres suspiros en la nieve del ocaso\" y {N:tu|su} $w{:0} se lanza con la rapidez de un aguacero hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身形一晃，一招「处子弄笛」向$n$l刺出一剑"
msgstr "$N{:el} {N:te meces|se mece} con \"La doncella toca la flauta\" y {N:lanzas|lanza} una estocada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N舞动$w，一招「阳谷白练」挟著闪闪剑光刺向$n的$l"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y, con \"Seda blanca del valle soleado\", {N:atacas|ataca} hacia {n:tu $l{:0}|$l{:el} de $n{:el}} entre destellos de espada"

msgid "$N手中$w一个圈转，使出「薰容逐电」中锋直进刺向$n的$l"
msgstr "$N{:el} {N:haces|hace} girar {N:tu|su} $w{:0} una vez y, con \"Relámpago perfumado\", {N:hundes|hunde} la punta en línea recta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "花紫会的手上功夫，忽掌忽爪，招名多带市井气——「撺锅手」「撮灰手」「梁上君子」「随棍上身」，劲力一吐，能听见对方骨节作响。须空手练，内力太弱的人练不成。"
msgstr "Las artes de mano de la Hermandad de los Mendigos, ya palma, ya garra, con nombres de aire callejero: \"Mano que voltea la olla\", \"Mano que recoge ceniza\", \"Caballero de la viga\", \"Trepar por el palo\". Al soltar la fuerza se oye crujir los huesos del rival. Se practica con las manos desnudas, y no se aprende con poca Fuerza interior."

msgid "练油流麻香手必须空手。"
msgstr "La Mano de aceite y pimienta se practica con las manos desnudas."

msgid "你的内力太弱，无法练油流麻香手。"
msgstr "Tu Fuerza interior es demasiado débil para practicar la Mano de aceite y pimienta."

msgid "你听到「喀啦」一声轻响，竟似是骨碎的声音！"
msgstr "Oyes un leve \"crac\" que parece el de un hueso al romperse."

msgid "$N劲力一吐，$n的$l发出「喀」地一声爆响！"
msgstr "¡$N{:el} {N:sueltas|suelta} la fuerza y {n:tu $l{:0} suena|$l{:el} de $n{:el} suena} con un \"crac\" seco!"

msgid "只听见$n的$l「喀」地一声 ..."
msgstr "Solo se oye un \"crac\" en {n:tu $l{:0}|$l{:el} de $n{:el}}..."

msgid "$N左掌微分，右手一长使出一招「毒龙扑舟」，抓向$n的$l"
msgstr "$N{:el} {N:separas|separa} un poco la palma izquierda y {N:alargas|alarga} la derecha con \"Dragón venenoso asalta el bote\", en un zarpazo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N倏地一个转身，双手一翻「撺锅手」直掼$n$l"
msgstr "$N{:el} {N:te giras|se gira} de golpe y, con las dos manos vueltas, {N:descargas|descarga} \"Mano que voltea la olla\" contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身子微斜，随即跨出一步，左手忽掌忽爪使出「撮灰手」，拍向$n的$l"
msgstr "$N{:el} {N:ladeas|ladea} el cuerpo y de inmediato {N:das|da} un paso; con la mano izquierda, ya palma, ya garra, {N:usas|usa} \"Mano que recoge ceniza\" y {N:palmeas|palmea} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出「青蛇十段锦」，双手滑溜异常对准$n的$l抓去"
msgstr "$N{:el} {N:usas|usa} \"Brocado de la serpiente verde\", con las dos manos resbaladizas, y {N:agarras|agarra} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N左手虚晃，右掌飘飘，一招「梁上君子」击向$n$l"
msgstr "$N{:el} {N:finges|finge} con la izquierda, la palma derecha flota, y con \"Caballero de la viga\" {N:golpeas|golpea} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出「拨草寻履」，凌空跃起，冷不防在落地前对准$n$l踢出一脚"
msgstr "$N{:el} {N:usas|usa} \"Buscar el zapato entre la hierba\", {N:te lanzas|se lanza} por el aire y, sin aviso, antes de aterrizar, {N:das|da} una patada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N右手在$n$l划过，随後一招「随棍上身」左爪又向同一方位抓到"
msgstr "$N{:el} {N:pasas|pasa} la mano derecha sobre {n:tu $l{:0}|$l{:el} de $n{:el}} y luego, con \"Trepar por el palo\", {N:lanzas|lanza} la garra izquierda al mismo punto"

msgid "招名全出自《短歌行》——「对酒当歌」「人生几何」「譬如朝露」「去日苦多」……弯刀似月，刀势常由下而上撩斩。官府的带刀侍卫、高门大户的护院多使这一路刀法。"
msgstr "Todos los nombres de los movimientos salen de «Canción breve»: \"Cantar ante el vino\", \"¿Cuánto dura la vida?\", \"Como rocío de la mañana\", \"Tantos días idos\"... El sable curvo es como la luna, y sus golpes suelen subir barriendo desde abajo. Los guardias armados del gobierno y los guardias de las grandes casas suelen usar este estilo de sable."

msgid "$N使一招「对酒当歌」，手中$w风似地向$n的$l斩去！"
msgstr "$N{:el} {N:usas|usa} \"Cantar ante el vino\" y {N:tu|su} $w{:0} corta como el viento hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N弯刀似月，$w随著一招「人生几何」由下而上撩往$n的$l"
msgstr "$N{:el} {N:tienes|tiene} un sable curvo como la luna: con \"¿Cuánto dura la vida?\", {N:tu|su} $w{:0} sube barriendo desde abajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身形一转，一招「譬如朝露」$w如朝露闪烁，斩向$n的$l"
msgstr "$N{:el} {N:giras|gira} el cuerpo con \"Como rocío de la mañana\", y {N:tu|su} $w{:0} destella como el rocío al cortar hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N舞动$w，一招「去日苦多」往$n的$l斜斜砍出一刀"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y, con \"Tantos días idos\", {N:descargas|descarga} un tajo oblicuo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手中$w一晃，一招「慨当以慷」迅捷无伦地劈向$n的$l"
msgstr "$N{:el} {N:agitas|agita} {N:tu|su} $w{:0} y, con \"Ánimo que se agita\", {N:cortas|corta} con rapidez sin igual hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N提气丹田，身型咋展，一招「忧思难忘」直劈$n$l"
msgstr "$N{:el} {N:reúnes|reúne} Qi en el dantian y de pronto {N:te despliegas|se despliega} con \"Pena imposible de olvidar\", en un tajo recto hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N移步侧身，使一招「何以解忧」刀光霍霍斩向$n的$l"
msgstr "$N{:el} {N:mueves|mueve} los pies y {N:te pones|se pone} de lado con \"¿Qué alivia la pena?\"; el filo destella al cortar hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "招名取自《秋风辞》，从「秋风起兮白云飞」到「箫鼓鸣兮发棹歌」，身影一晃，便已避在数尺之外。练这门步法须有相当的内力；官府的侍卫、衙役常与短歌刀法一同修习。"
msgstr "Los nombres de los movimientos vienen de «El canto del viento de otoño», de \"Viento de otoño, nubes que vuelan\" a \"Flautas y tambores, canción de remos\": un balanceo, y ya estás varios pasos lejos. Para practicar estos pasos hace falta bastante Fuerza interior; los guardias y los guardias del tribunal suelen practicarlos junto con el Sable de la canción breve."

msgid "$n一招「秋风起兮白云飞」轻轻巧巧地避了开去。"
msgstr "$n{:el} {n:usas|usa} \"Viento de otoño, nubes que vuelan\" y {n:te apartas|se aparta} con soltura."

msgid "只见$n身影一晃，一式「草木黄落兮雁南归」早已避在七尺之外。"
msgstr "$n{:el} {n:te desdibujas|se desdibuja} y, con \"Hojas caídas, gansos al sur\", ya {n:estás|está} a más de dos metros."

msgid "$n使出「兰有秀兮菊有芳」，轻轻松松地闪过。"
msgstr "$n{:el} {n:usas|usa} \"Orquídea en flor, crisantemo fragante\" y {n:esquivas|esquiva} sin esfuerzo."

msgid "$n左足一点，一招「怀佳人兮不能忘」腾空而起，避了开去。"
msgstr "$n{:el} {n:te impulsas|se impulsa} con el pie izquierdo y, con \"La bella añorada, jamás olvidada\", {n:te elevas|se eleva} por el aire, fuera del alcance."

msgid "可是$n使一招「泛楼船兮济汾河」，身子轻轻飘了开去。"
msgstr "Pero $n{:el} {n:usas|usa} \"Navío de torres por el Fen\" y {n:te alejas|se aleja} flotando con ligereza."

msgid "$n身影微动，已经藉一招「横中流兮扬素波」轻轻闪过。"
msgstr "$n{:el} {n:te mueves|se mueve} apenas y, con \"Olas blancas en medio del río\", ya {n:lo has esquivado|lo ha esquivado} con ligereza."

msgid "但是$n一招「箫鼓鸣兮发棹歌」使出，早已绕到$N身後！"
msgstr "Pero $n{:el} {n:usas|usa} \"Flautas y tambores, canción de remos\" y ya {n:estás|está} detrás de {N:ti|$N{:el}}."

msgid "但是$n身形飘忽，轻轻一纵，一招「欢乐极兮哀情多」，避开这一击。"
msgstr "Pero $n{:el} {n:te meces|se mece}, {n:saltas|salta} con ligereza y, con \"Tanta alegría, tanta tristeza\", {n:evitas|evita} el golpe."

msgid "$n身形往上一拔，一招「少壮几时兮奈老何」，一个转折落在数尺之外。"
msgstr "$n{:el} {n:te elevas|se eleva} de golpe con \"¿Cuánto dura la juventud?\" y, tras un giro, {n:caes|cae} varios pasos más allá."

msgid "密宗一路的掌法，招名「苦海端无涯」「地狱似有门」「天堂却无路」「万念皆是空」，虚实相生；招架时能以双掌夹住来刃，或以「粘」字诀引偏兵器。须空手练。"
msgstr "Un estilo de palma de la línea esotérica, con movimientos llamados \"El mar de penas no tiene orilla\", \"Parece haber puerta al infierno\", \"Al cielo no hay camino\" y \"Todo pensamiento es vacío\", donde lo falso y lo cierto se engendran. Al parar, puede apresar la hoja entre las dos palmas o desviar el arma con la técnica del «pegado». Se practica con las manos desnudas."

msgid "练密宗大手印必须空手。"
msgstr "El Gran sello tántrico se practica con las manos desnudas."

msgid "$N使出一招「苦海端无涯」，左掌虚幌，右掌穿出击向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"El mar de penas no tiene orilla\": {N:finges|finge} con la palma izquierda y {N:lanzas|lanza} la derecha hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出一招「地狱似有门」，左掌化虚为实击向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Parece haber puerta al infierno\": {N:tu|su} palma izquierda pasa de finta a golpe real hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出密宗大手印中的「天堂却无路」，一掌拍向$n的$l"
msgstr "$N{:el} {N:usas|usa} \"Al cielo no hay camino\", del Gran sello tántrico, y {N:descargas|descarga} una palmada hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N双掌一错，使出「密宗为独尊」，对准$n的$l连续拍出"
msgstr "$N{:el} {N:cruzas|cruza} las palmas y, con \"El tantra sobre todo\", {N:golpeas|golpea} sin pausa hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N左掌立于胸前，右掌推出，一招「万念皆是空」击向$n$l"
msgstr "$N{:el} {N:colocas|coloca} la palma izquierda ante el pecho y {N:empujas|empuja} la derecha: \"Todo pensamiento es vacío\", hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N使出「佛云以杀止杀」，身形凌空飞起，从空中当头向$n的$l出掌攻击"
msgstr "$N{:el} {N:usas|usa} \"Matar para acabar con la matanza\", {N:te lanzas|se lanza} por el aire y {N:atacas|ataca} con la palma desde arriba hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "外门护体硬功：闭目凝神，气走全身，不躲不闪也能硬受来招。"
msgstr "Un endurecimiento externo del cuerpo: cierras los ojos y recoges la mente, el Qi recorre todo el cuerpo, y puedes encajar un golpe de frente sin esquivar ni inmutarte."

msgid "逍遥派一路的内功，讲究文墨修养：读书识字的造诣跟不上，小无相功便无法再进。只能向人学，或在运功中慢慢精熟。"
msgstr "El neigong de la línea de la Escuela Despreocupada, que da valor a la cultura letrada: si tu lectura y escritura no alcanzan, el Arte menor sin forma no puede avanzar. Solo se aprende de alguien o se va perfeccionando poco a poco al hacerlo circular."

msgid "小无相功只能用学的或是从运用中增加熟练度。"
msgstr "El Arte menor sin forma solo se aprende, o se mejora usándolo."

msgid "你的文学素养不够无法提升小无相功的造诣。"
msgstr "Tu cultura letrada no basta para avanzar en el Arte menor sin forma."

msgid "大内侍卫营的刀法，七式「值门」「出巡」「提灯」「锁宫」「拿下」「护驾」「天明」，一招一式都在宫门、长街、殿上。侍卫营总教头冯策的刀谱末页写着一句：「刀在鞘里的时候最多。」"
msgstr "El sable del Cuartel de la guardia de palacio, siete formas: \"Guardia de puerta\", \"Ronda\", \"Alzar el farol\", \"Cerrar el palacio\", \"Prenderlo\", \"Proteger al trono\", \"Despunta el día\"; cada movimiento ocurre en una puerta de palacio, en una calle larga, en un salón. En la última página del manual de sable de Feng Ce, instructor jefe del cuartel, hay escrita una frase: \"El sable pasa casi todo el tiempo en la vaina.\""

msgid "$N横刀当胸，一招「值门」$w刀背一磕，顺势削向$n的$l"
msgstr "$N{:el} {N:cruzas|cruza} la hoja ante el pecho y, con \"Guardia de puerta\", {N:golpeas|golpea} con el lomo de {N:tu|su} $w{:0} y {N:cortas|corta} después hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N脚下一错，一招「出巡」$w贴着身子递出，直取$n的$l！"
msgstr "$N{:el} {N:cambias|cambia} el paso y, con \"Ronda\", {N:tu|su} $w{:0} sale rozando el cuerpo en línea recta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N刀尖一挑，一招「提灯」$w晃过$n眼前，刀锋却落向$n的$l"
msgstr "$N{:el} {N:levantas|levanta} la punta y, con \"Alzar el farol\", {N:tu|su} $w{:0} destella ante {n:tus ojos|los ojos de $n{:el}} mientras el filo cae sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N沉肩坠肘，一招「锁宫」$w自上而下劈向$n的$l"
msgstr "$N{:el} {N:hundes|hunde} hombros y codos y, con \"Cerrar el palacio\", {N:tu|su} $w{:0} cae de arriba abajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N欺身而上，一招「拿下」$w刀柄撞向$n的$l，刀刃跟着就到"
msgstr "$N{:el} {N:te echas|se echa} encima y, con \"Prenderlo\", {N:estrellas|estrella} la empuñadura de {N:tu|su} $w{:0} contra {n:tu $l{:0}|$l{:el} de $n{:el}}, y el filo llega justo detrás"

msgid "$N退半步护住身后，一招「护驾」$w画了个半圆，扫过$n的$l"
msgstr "$N{:el} {N:retrocedes|retrocede} medio paso para cubrir lo que {N:tienes|tiene} detrás y, con \"Proteger al trono\", {N:tu|su} $w{:0} traza un semicírculo sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N大喝一声，一招「天明」$w自下而上斜劈，刀光照亮了$n的$l"
msgstr "$N{:el} {N:lanzas|lanza} un gran grito y, con \"Despunta el día\", {N:tu|su} $w{:0} corta en diagonal desde abajo, y su luz ilumina {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "关北槐阳王府骑兵的马上刀法，七式从「扬鞭」「回马」「斩缰」到「破阵」「归鞘」，刀自下而上撩出。刀谱每一页的边上都写着同一句话：「撩，不是砍。」"
msgstr "El sable a caballo de los jinetes de la Casa de Huaiyang, en el Norte del Paso. Siete formas, de \"Alzar el látigo\", \"Volver el caballo\" y \"Cortar las riendas\" a \"Romper la formación\" y \"Envainar\", con la hoja barriendo siempre desde abajo. En el borde de cada página del manual está escrita la misma frase: \"Barrer, no cortar.\""

msgid "$N手中$w一扬，一招「扬鞭」自下而上撩向$n的$l！"
msgstr "$N{:el} {N:alzas|alza} {N:tu|su} $w{:0} y, con \"Alzar el látigo\", {N:barres|barre} desde abajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N身子一拧，一招「回马」$w反手撩出，刀光从$n的$l掠过"
msgstr "$N{:el} {N:te retuerces|se retuerce} con \"Volver el caballo\" y {N:tu|su} $w{:0} sale de revés, y su luz roza {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N矮身一刀，一招「斩缰」$w贴地撩向$n的$l"
msgstr "$N{:el} {N:te agachas|se agacha} en un tajo con \"Cortar las riendas\" y {N:tu|su} $w{:0} barre a ras del suelo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N$w一抖，一招「卷沙」刀风卷起地上的沙土，斜斜撩往$n的$l"
msgstr "{N:Tu $w{:0} se estremece|$w{:el} de $N{:el} se estremece}: con \"Remolino de arena\", el viento de la hoja levanta la arena del suelo y barre en diagonal hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N踏步欺进，一招「踏雪」$w由肩上撩落，直取$n的$l"
msgstr "$N{:el} {N:avanzas|avanza} pisando fuerte y, con \"Pisar la nieve\", {N:tu|su} $w{:0} baja desde el hombro en línea recta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N大喝一声，一招「破阵」$w连撩三刀，刀刀奔$n的$l"
msgstr "$N{:el} {N:lanzas|lanza} un gran grito y, con \"Romper la formación\", {N:tu|su} $w{:0} barre tres veces seguidas, cada tajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手腕一翻，一招「归鞘」$w收势时顺手一撩，刀背扫过$n的$l"
msgstr "$N{:el} {N:giras|gira} la muñeca y, con \"Envainar\", al recoger {N:tu|su} $w{:0} {N:lanzas|lanza} un último barrido de pasada, y el lomo roza {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "番坊铁盾会的剑法，传自流落东方的大秦剑手：盾在前，剑在后，左臂圆盾挡住来招，右手短剑从盾下刺出，七式自「盾墙」至「盾下一剑」。臂上没有盾，铁盾会不教；入了鬼笠馆的人，铁盾会也不教。"
msgstr "El estilo de espada de la Hermandad del Escudo de Hierro del Barrio Extranjero, heredado de los espadachines de Daqin que acabaron errantes en el este: escudo delante, espada detrás. El escudo redondo del brazo izquierdo detiene el ataque y la espada corta de la mano derecha sale a estocadas por debajo, en siete formas, de \"Muro de escudos\" a \"Espada bajo el escudo\". A quien no lleva escudo en el brazo, la Hermandad no lo enseña; y a quien ha entrado en el Salón del Sombrero Fantasma, tampoco."

msgid "你举着盾，把铁盾剑法练了一遍：盾在前，剑在后。"
msgstr "Con el escudo en alto, repasas la Espada del escudo de hierro: escudo delante, espada detrás."

msgid "你的内力或气不够，没有办法练习铁盾剑法。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar la Espada del escudo de hierro."

msgid "你得先拿一把剑——短剑最好。"
msgstr "Primero necesitas una espada. Mejor una espada corta."

msgid "盾呢？没盾的剑法不是我们的剑法。"
msgstr "¿Y el escudo? Una esgrima sin escudo no es nuestra esgrima."

msgid "你是鬼笠馆的人。铁盾会的剑法，不教鬼笠馆。"
msgstr "Eres del Salón del Sombrero Fantasma. La esgrima de la Hermandad del Escudo de Hierro no se enseña al Salón del Sombrero Fantasma."

msgid "$N左臂一抬，一招「盾墙」盾面迎上$n的$l，$w从盾沿底下刺出"
msgstr "$N{:el} {N:alzas|alza} el brazo izquierdo y, con \"Muro de escudos\", el frente del escudo sale al paso de {n:tu $l{:0}|$l{:el} de $n{:el}} mientras {N:tu|su} $w{:0} se clava por debajo del borde"

msgid "$N盾身一侧，一招「侧刺」$w贴着盾沿直刺$n的$l"
msgstr "$N{:el} {N:ladeas|ladea} el escudo y, con \"Estocada lateral\", {N:tu|su} $w{:0} corre a lo largo del borde y se clava hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N踏前一步，一招「盾撞」整面盾撞向$n的$l"
msgstr "$N{:el} {N:avanzas|avanza} un paso y, con \"Embestida de escudo\", {N:estrellas|estrella} el escudo entero contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N手腕一沉，一招「短锋」$w只探出半尺，点向$n的$l"
msgstr "$N{:el} {N:dejas caer|deja caer} la muñeca y, con \"Punta corta\", {N:tu|su} $w{:0} asoma apenas un palmo y pica hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N盾面一收，一招「回盾」盾沿磕开来势，$w顺势划向$n的$l"
msgstr "$N{:el} {N:recoges|recoge} el escudo y, con \"Escudo de vuelta\", el borde aparta el ataque y {N:tu|su} $w{:0} sigue el impulso y corta hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N盾后$w连刺三下，一招「连刺」剑剑奔$n的$l"
msgstr "$N{:el} {N:clavas|clava} {N:tu|su} $w{:0} tres veces desde detrás del escudo con \"Triple estocada\", cada una hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N矮身藏在盾后，一招「盾下一剑」$w从盾底下猛地刺向$n的$l"
msgstr "$N{:el} {N:te agazapas|se agazapa} tras el escudo y, con \"Espada bajo el escudo\", {N:tu|su} $w{:0} sale de golpe por debajo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "番坊倭人浪人武馆鬼笠馆的刀法，刀窄而弯，拔刀、横扫、下劈、纳刀、退步五式之外，另有一式「一刀」。门规与中原相反：一击之内定生死。铁盾会的弟子，鬼笠馆不教。"
msgstr "El sable del Salón del Sombrero Fantasma, escuela de los ronin japoneses del Barrio Extranjero: hoja estrecha y curva; además de las cinco formas de desenvainar, barrer, tajo descendente, guardar el sable y paso atrás, hay una más, \"Un solo tajo\". Su regla es la contraria de las Llanuras Centrales: la vida y la muerte se deciden dentro de un solo golpe. El Salón del Sombrero Fantasma no enseña a los discípulos de la Hermandad del Escudo de Hierro."

msgid "你出刀，收刀，把鬼笠刀法练了一遍——一刀，只出一次。"
msgstr "Desenvainas, envainas y repasas el Sable del Sombrero Fantasma: un solo tajo, y solo una vez."

msgid "你的内力或气不够，没有办法练习鬼笠刀法。"
msgstr "No tienes Fuerza interior o Qi suficientes para practicar el Sable del Sombrero Fantasma."

msgid "刀呢？没刀的刀法不是刀法。"
msgstr "¿Y el sable? Un arte de sable sin sable no es un arte de sable."

msgid "你是铁盾会的人。盾在前的，用不着刀。"
msgstr "Eres de la Hermandad del Escudo de Hierro. Quien lleva el escudo delante no necesita sable."

msgid "$N手按刀柄，一招「拔刀」$w出鞘的一瞬斜斜划向$n的$l"
msgstr "$N{:el} {N:apoyas|apoya} la mano en la empuñadura y, con \"Desenvainar\", {N:tu|su} $w{:0} corta en diagonal hacia {n:tu $l{:0}|$l{:el} de $n{:el}} en el instante en que sale de la vaina"

msgid "$N$w平举，一招「横扫」刀光齐腰扫向$n的$l"
msgstr "$N{:el} {N:alzas|alza} {N:tu|su} $w{:0} en horizontal y, con \"Barrido\", su luz barre a la altura de la cintura hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N双手握刀举过头顶，一招「下劈」$w直劈$n的$l"
msgstr "$N{:el} {N:levantas|levanta} el arma con las dos manos sobre la cabeza y, con \"Tajo descendente\", {N:tu|su} $w{:0} cae en línea recta sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N$w收势回鞘，一招「纳刀」刀背顺势磕向$n的$l"
msgstr "$N{:el} {N:recoges|recoge} {N:tu|su} $w{:0} hacia la vaina y, con \"Guardar el sable\", el lomo golpea de pasada contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N退了半步，一招「退步」$w在退势里反撩$n的$l"
msgstr "$N{:el} {N:retrocedes|retrocede} medio paso y, con \"Paso atrás\", {N:tu|su} $w{:0} barre hacia arriba, aún en retirada, contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "$N双手握刀，一动不动，忽然一招「一刀」——$w从头顶直劈而下，一击之内定生死，直取$n的$l"
msgstr "$N{:el} {N:sujetas|sujeta} el arma con las dos manos y {N:te quedas|se queda} inmóvil; de pronto, \"Un solo tajo\": {N:tu|su} $w{:0} cae en línea recta desde arriba, vida o muerte en un solo golpe, hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "挥拳"
msgstr "Puñetazo"

msgid "$N挥拳攻击$n的$l"
msgstr "$N{:el} {N:lanzas|lanza} un puñetazo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "一抓"
msgstr "Zarpazo"

msgid "$N往$n的$l一抓"
msgstr "$N{:el} {N:lanzas|lanza} un zarpazo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "踢腿"
msgstr "Patada"

msgid "$N往$n的$l狠狠地踢了一脚"
msgstr "$N{:el} {N:das|da} una patada feroz hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "捶击"
msgstr "Mazazo"

msgid "$N提起拳头往$n的$l捶去"
msgstr "$N{:el} {N:alzas|alza} el puño y {N:lo descargas|lo descarga} sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "横拳"
msgstr "Gancho"

msgid "$N对准$n的$l用力挥出一拳"
msgstr "$N{:el} {N:lanzas|lanza} con fuerza un gancho contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "斩"
msgstr "Tajo"

msgid "$N挥动$w，斩向$n的$l"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y {N:cortas|corta} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "砍"
msgstr "Corte"

msgid "$N用$w往$n的$l砍去"
msgstr "$N{:el} {N:descargas|descarga} {N:tu|su} $w{:0} en un corte hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "砍伤"
msgstr "corte"

msgid "劈"
msgstr "Mandoble"

msgid "$N的$w朝著$n的$l劈将过去"
msgstr "{N:Tu $w{:0} se abate|$w{:el} de $N{:el} se abate} hendiendo hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "劈伤"
msgstr "herida profunda"

msgid "乱砍"
msgstr "Lluvia de tajos"

msgid "$N挥舞$w，对准$n的$l一阵乱砍"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y {N:descargas|descarga} una lluvia de tajos contra {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "刺"
msgstr "Estocada"

msgid "$N用$w往$n的$l刺去"
msgstr "$N{:el} {N:clavas|clava} {N:tu|su} $w{:0} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "捅"
msgstr "Puñalada"

msgid "$N的$w往$n的$l狠狠地一捅"
msgstr "{N:Tu $w{:0} se clava|$w{:el} de $N{:el} se clava} con saña hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "抽"
msgstr "Latigazo"

msgid "$N将$w一扬，往$n的$l抽去"
msgstr "$N{:el} {N:alzas|alza} {N:tu|su} $w{:0} y {N:azotas|azota} hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "戳"
msgstr "Pinchazo"

msgid "$N用$w往$n的$l直戳过去"
msgstr "$N{:el} {N:empujas|empuja} {N:tu|su} $w{:0} recto hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "射"
msgstr "Disparo"

msgid "$N将$w对准$n的$l射了过去"
msgstr "$N{:el} {N:apuntas|apunta} {N:tu|su} $w{:0} hacia {n:tu $l{:0}|$l{:el} de $n{:el}} y {N:disparas|dispara}"

msgid "砸"
msgstr "Aplastón"

msgid "$N挥舞$w，往$n的$l用力一砸"
msgstr "$N{:el} {N:blandes|blande} {N:tu|su} $w{:0} y {N:descargas|descarga} un aplastón con fuerza sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "当头砸"
msgstr "Aplastón desde arriba"

msgid "$N高高举起$w，往$n的$l当头砸下"
msgstr "$N{:el} {N:alzas|alza} {N:tu|su} $w{:0} y {N:descargas|descarga} un golpe de arriba abajo sobre {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "猛挥"
msgstr "Golpe furioso"

msgid "$N手握$w，眼露凶光，猛地对准$n的$l挥了过去"
msgstr "$N{:el} {N:empuñas|empuña} {N:tu|su} $w{:0}, con la mirada feroz, y {N:descargas|descarga} un golpe brutal hacia {n:tu $l{:0}|$l{:el} de $n{:el}}"

msgid "当前是眼下的数；有效是受伤压低的上限，歇着会慢慢长回来，疗伤更快；最大是你的本钱。"
msgstr "Actual es lo que tienes ahora; Efectivo es el tope que te dejan las heridas: se recupera con el descanso, y más rápido si te curas; Máximo es tu capital."

msgid "学武功、自学、修行都耗精，歇着慢慢回来；归零就昏倒。"
msgstr "Aprender artes marciales, estudiar por tu cuenta y cultivarte gastan Esencia; con el reposo vuelve poco a poco. Si llega a cero, te desmayas."

msgid "挨打、练功、打坐都耗气，歇着慢慢回来；归零就昏倒。"
msgstr "Recibir golpes, entrenar y meditar gastan Qi; con el reposo vuelve poco a poco. Si llega a cero, te desmayas."

msgid "研读、冥思都耗神，歇着慢慢回来；归零就昏倒。"
msgstr "Estudiar y contemplar gastan Espíritu; con el reposo vuelve poco a poco. Si llega a cero, te desmayas."

msgid "打坐得来，运功和加力都要用它；上限看基本内功。"
msgstr "Se gana meditando; la necesitas para hacer circular la energía y para la Fuerza extra. Su tope depende del Neigong básico."

msgid "每一击多灌进这么多内力，打得更重，内力也耗得更快。"
msgstr "Cada golpe suma esta cantidad de Fuerza interior: golpeas más fuerte y la gastas más rápido."

msgid "施法要用。冥思得来，上限看基本咒文。"
msgstr "Hace falta para lanzar conjuros. Se gana contemplando; su tope depende de los Conjuros básicos."

msgid "施展神通要用。修行得来，上限看基本法术。"
msgstr "Hace falta para usar poderes místicos. Se gana con el cultivo; su tope depende del Misticismo básico."

msgid "杀人会涨，胆气也跟着壮；太重学不了佛道心法，还可能失控伤人。运功或捐香火能压下去。"
msgstr "Sube al matar, y con ella el arrojo; si es demasiada, no podrás aprender los métodos budistas ni taoístas y puede que pierdas el control y hieras a otros. Hacer circular la Fuerza interior o dar limosna en el templo la baja."

msgid "随时间消耗，吃东西补；见底后内力、法力、灵力不再恢复。"
msgstr "Se gasta con el tiempo; repón comiendo. Al tocar fondo, la Fuerza interior, el Poder arcano y el Poder místico dejan de recuperarse."

msgid "随时间消耗，喝东西补；见底后什么都不再恢复。"
msgstr "Se gasta con el tiempo; repón bebiendo. Al tocar fondo, nada vuelve a recuperarse."

msgid "打架、办事得来；武功能练到多高看它。"
msgstr "Se gana peleando y haciendo encargos; de ella depende hasta dónde puedes llevar las artes marciales."

msgid "打架、办事得来，请教和自学要花它；没用掉的有上限。"
msgstr "Se gana peleando y haciendo encargos, y se gasta al pedir enseñanza a un Shifu o al estudiar por tu cuenta; lo que no gastas tiene un tope."

msgid "江湖上对你的总评：办成差事会涨，认输会掉。"
msgstr "La opinión que el jianghu tiene de ti en conjunto: sube al cumplir encargos y baja al rendirte."

msgid "你亲手杀过多少人。"
msgstr "A cuánta gente has matado con tus propias manos."

msgid "身上东西的总重和能背的上限，上限看膂力。"
msgstr "El peso total de lo que llevas y lo máximo que puedes cargar; el tope depende de la Fuerza."

msgid "你自己的分量，也决定肚子能装多少吃喝。"
msgstr "Tu propio peso; también decide cuánta comida y bebida le cabe a tu estómago."

msgid "力气：打得更重，背得更多，拿得动沉重的兵器。"
msgstr "Músculo: golpeas más fuerte, cargas más y puedes con armas pesadas."

msgid "敢不敢抢攻：自动对打时，胆识高的人出手更勤；不少师父也看它。"
msgstr "Atrevimiento para tomar la iniciativa: en el combate automático, quien tiene más arrojo ataca con más frecuencia; muchos Shifu también lo miran."

msgid "天资：学武功更快，耗精更少，打架时也更容易长进。"
msgstr "Talento: aprendes artes marciales más rápido, gastas menos Esencia y progresas más al pelear."

msgid "精神方面的体质：冥思和修行涨得更快，不少法门也看它。"
msgstr "Disposición espiritual: la contemplación y el cultivo avanzan más rápido, y muchas disciplinas la tienen en cuenta."

msgid "临危不乱：对手抢攻前要过你这一关，定力越高他们越容易转为守势；打空时也不易露破绽，还压得住杀气。"
msgstr "Sangre fría: el rival debe superarla antes de tomar la iniciativa; cuanto más alto el Temple, más a menudo se repliega a la defensiva. Al fallar dejas menos huecos, y contienes la Sed de sangre."

msgid "长相：有人看脸说话，也有师父看长相收人；容貌高，杀气重的人也不易对你翻脸。"
msgstr "Apariencia: hay quien juzga por la cara, y algunos Shifu aceptan discípulos por su aspecto; con buena apariencia, hasta los sanguinarios tardan más en volverse contra ti."

msgid "体质：精气神恢复得更快，打坐涨内力更快，昏倒后醒得更早，酒量也大。"
msgstr "Complexión: Esencia, Qi y Espíritu se recuperan más rápido, meditar sube más la Fuerza interior, te despiertas antes de un desmayo y aguantas mejor el vino."

msgid "运气：容易遇上一般人碰不到的机缘，好事坏事都有。"
msgstr "Suerte: te topas con oportunidades que la gente común no encuentra, buenas y malas."

msgid "青石山路"
msgstr "Camino de piedra azul"

msgid "铁链崖"
msgstr "Risco de la Cadena de Hierro"

msgid "晚月山路"
msgstr "Camino de Luna Tardía"

msgid "槐阳城"
msgstr "Huaiyang"

msgid "草原"
msgstr "Estepa"

msgid "工地"
msgstr "Obras"

msgid "古冢"
msgstr "Túmulo"

msgid "封山剑派是当今武林中最大的一支剑派。相传三位剑术名家在封山灵狐顶相互印证所学，创出封山剑法；招式不难学，难在剑意，讲究不抢先，等对手露出空子。七十年前一代掌门把乔阴柳家的家传拳法融进剑意，创出柳家拳，补上了剑派近身的短处。雪亭镇的淳风武馆是这一派的门户，镇上的后生多在那里学拳。"
msgstr "La Escuela de la Montaña Vacía es la mayor escuela de espada del wulin de hoy. Se cuenta que tres maestros de la espada contrastaron lo que sabían en la Cumbre del Zorro Espiritual y crearon la Espada de la Montaña Vacía; los movimientos no son difíciles, lo difícil es el espíritu de la espada, que no toma la iniciativa y espera a que el rival deje un hueco. Hace setenta años un Maestro de la escuela fundió el puño de la familia Liu de Sombra Alta en el espíritu de la espada y creó el Puño de la familia Liu, que cubrió el punto débil de la escuela en el cuerpo a cuerpo. El Salón del Viento Puro de Pabellón Nevado es la puerta de esta escuela, y los jóvenes del pueblo suelen aprender allí a pelear a puño."

msgid "柳家拳没什么花样：先打实一拳，人就贴上去了；贴上去，重拳才够得着，一拳比一拳沉。"
msgstr "El Puño de la familia Liu no tiene adornos: primero plantas un puñetazo firme y ya estás pegado; pegado, el golpe pesado te alcanza, y cada puñetazo es más hondo que el anterior."

msgid "最怕的是打空。一拳落了空，人就被拉开了，再重的拳头也只砸在风上——得重新打实一拳，才能再贴上去。"
msgstr "Lo que más se teme es fallar. Si un puñetazo cae en el vacío, te apartan, y por pesado que sea el puño solo golpea el viento: hay que volver a plantar un puñetazo firme para pegarse otra vez."

msgid "所以这拳是抢来的。对面守得稳，你就先用快的、虚的去碰，碰着了再压上去。"
msgstr "Por eso este puño se conquista. Si el rival se guarda bien, empieza con golpes rápidos y fintas para tantearlo, y cuando lo toques, presiona."

msgid "想拜馆主为师？馆主只看{requires}，哪一样不到，他都会摇头。拳脚简单，一拳就是一拳，先跟我拆几招也好。"
msgstr "¿Quieres que el maestro del salón te acepte como discípulo? Él solo mira {requires}, y si falta una sola cosa, sacudirá la cabeza. Las artes de puño y pie son sencillas, un puñetazo es un puñetazo; empieza practicando unos intercambios conmigo."

msgid "好，拆三回合，点到为止。"
msgstr "Bien, tres asaltos, sin pasarnos."

msgid "看见没有？我一拳打实了就贴上来，接着那记重的才够得着你。柳家拳的拳，是这么抢来的。"
msgstr "¿Lo has visto? En cuanto planto un puñetazo me pego a ti, y solo entonces el golpe pesado que sigue te alcanza. Así se conquista el Puño de la familia Liu."

msgid "三回合我一拳都没打实，就一直够不着你——柳家拳最怕的就是这个。你要学，先学怎么把第一拳打实。"
msgstr "En tres asaltos no planté un solo puñetazo y no te alcancé nunca: eso es lo que más teme el Puño de la familia Liu. Si quieres aprender, primero aprende a plantar el primer puñetazo."

msgid "你贴上来那一记，压得对，就是这个劲。"
msgstr "Ese golpe en que te pegaste a mí, y apretaste bien: es justo ese empuje."

msgid "你身上带着伤，拆什么招？先去桑邻药铺把伤治好。"
msgstr "Vienes herido, ¿cómo vas a intercambiar golpes? Primero ve a la Botica de la Morera y cúrate."

msgid "你是别派的弟子，馆主吩咐过，不许和外人过招。"
msgstr "Eres de otra escuela; el maestro del salón ordenó que no se practique con gente de fuera."

msgid "记住：一回合不是一招，是几手的事。你出一手，我出一手；谁手上还有余力，谁就多出一手。"
msgstr "Recuerda: un asalto no es un movimiento, sino cosa de varios turnos. Tú haces un turno, yo hago uno; y a quien le quede fuerza, hace uno más."

msgid "看我这一拳——打实了我就贴上来，紧跟着的那一记重的，你躲得开么？"
msgstr "¡Mira este puñetazo! Si planto, me pego a ti, y el golpe pesado que sigue, ¿lo esquivarás?"

msgid "最后一回合。你要是能让我一拳打空，我就得退开重来；你要是也打实了一拳，就试试压上来。"
msgstr "Último asalto. Si logras que mi puñetazo caiga en el vacío, tendré que apartarme y empezar de nuevo; y si tú también plantas un puñetazo, prueba a presionar."

msgid "爹爹的剑法，我只学了个皮毛。封山剑不抢先，先用引手逗对方出招——对方一剑刺空，或是被我架开，那一下就是空子，我这边就多出一剑来。"
msgstr "De la espada de mi padre solo aprendí lo básico. La espada de la Montaña Vacía no toma la iniciativa: primero tienta con la mano que atrae para que el otro ataque, y si falla la estocada o lo desvío, ese instante es el hueco, y me sobra una estocada."

msgid "多出来的那一剑最要紧：可以追着刺，也可以用「封」字诀把他封住，一封住，他好几手都出不来。"
msgstr "La estocada que sobra es la más importante: puedo perseguir con la punta, o sellarlo con el secreto de «Sellar»; en cuanto lo sello, no le salen varios turnos."

msgid "可是贪不得。多出来的那一剑要是只顾着攻，对方的下一手就没人守了。爹爹说，封山的剑是等出来的。"
msgstr "Pero no hay que ser codicioso. Si con esa estocada de más solo piensas en atacar, nadie guarda tu siguiente turno. Mi padre dice que la espada de la Montaña Vacía se gana esperando."

msgid "你若想拜爹爹为师，他只看{requires}——不到的，他会说学剑的人要胆大心细。"
msgstr "Si quieres que mi padre te acepte como discípulo, solo mira {requires}; a quien no llega, le dirá que quien aprende la espada debe ser audaz y cuidadoso."

msgid "那……只拆三回合，不伤人。"
msgstr "Entonces... solo tres asaltos, sin herir a nadie."

msgid "方才你那一下刺空了，我手里就多出一剑，那记「封」就是这么来的。封山的剑，是等人露空子。"
msgstr "Hace un momento fallaste la estocada y me sobró una estocada; ese «Sellar» salió así. La espada de la Montaña Vacía espera a que el otro deje un hueco."

msgid "三回合你一招都没打空，我就一直没等到空子，只好跟你慢慢磨。封山的剑是等出来的，等不到，就只能这样。"
msgstr "En tres asaltos no fallaste ni un golpe, así que nunca encontré el hueco y tuve que ir despacio contigo. La espada de la Montaña Vacía se gana esperando; si no llega el momento, solo queda esto."

msgid "你也等到了我的空子，多出来的那一剑用得对。"
msgstr "Tú también esperaste mi hueco, y usaste bien la estocada de más."

msgid "你带着伤呢，爹爹不许我跟伤者动手。"
msgstr "Estás herido; mi padre no me deja pelear con heridos."

msgid "你是别派的人，爹爹说过不能跟江湖人物比武过招。"
msgstr "Eres de otra escuela; mi padre dijo que no se puede practicar con gente del jianghu."

msgid "一回合里你出几手，我也出几手——你出完了，我才接着出。不急。"
msgstr "En un asalto tú haces los turnos que quieras, y yo hago los míos; cuando termines, sigo yo. Sin prisa."

msgid "你尽管来刺。要是刺空了，我手上就多一剑；看清楚我是怎么追上来的。"
msgstr "Ataca cuando quieras. Si fallas la estocada, me sobrará una; fíjate cómo te persigo."

msgid "最后一回合。你也可以不急着出手，等我刺空了再说。"
msgstr "Último asalto. También puedes no tener prisa en atacar y esperar a que yo falle."

msgid "封山剑法？小的不懂剑，只听来往的武师说：柳馆主的剑从不抢先，专等人家刺空了的那一下。"
msgstr "¿La espada de la Montaña Vacía? Este servidor no entiende de espadas, solo oye decir a los maestros que pasan: la espada del maestro Liu nunca toma la iniciativa, y espera justo a que el otro falle."

msgid "馆主的剑我看了五年。来踢馆的，十个有九个是自己刺空了，才挨那一下的。想拜他为师？他只看{requires}。"
msgstr "Llevo cinco años viendo la espada del maestro del salón. De diez que vienen a desafiarlo, nueve fallan primero y por eso reciben el golpe. ¿Quieres que te acepte como discípulo? Solo mira {requires}."

msgid "柳淳风是个读书人，剑法嘛……文绉绉的，依老夫看没什么杀气。"
msgstr "Liu Chunfeng es un hombre de libros; su esgrima, en fin... muy letrada. A juicio de este viejo, no tiene nada de ímpetu asesino."

msgid "绘心师妹的剑最吓人的是那记「封」字诀，被封住了好几手都出不来。不过她说剑要等——等什么，我也说不上来。"
msgstr "Lo más aterrador de la espada de la discípula Huixin es el «Sellar»: si te sella, no te salen varios turnos. Eso sí, ella dice que la espada espera... qué espera, no sabría decirte."

msgid "伤口"
msgstr "Heridas"

msgid "这是剑伤，口子又直又深——封山剑的路数，多半是这位$RESPECT自己先刺空了，人家才补的这一剑。"
msgstr "Es una herida de espada, el corte es recto y hondo: el estilo de la Montaña Vacía. Lo más probable es que usted fallara primero, $RESPECT, y el otro le diera este tajo de remate."

msgid "柳家拳？镇上后生练的都是这个。我瞧他们打架，先是一拳碰着人了，立马就贴上去，一拳比一拳重。"
msgstr "¿El Puño de la familia Liu? Es lo que practican los jóvenes del pueblo. Los veo pelear: en cuanto un puñetazo toca a alguien, se le pegan de inmediato, y cada puñetazo es más pesado."

msgid "李教头那身板，一拳打实了接着就是一记重的，叫什么虎吟。想拜柳馆主的，先去武馆找李教头拆拆招，拳脚简单，一拳就是一拳。"
msgstr "Con el corpachón de ese instructor Li, un puñetazo bien plantado y enseguida un golpe pesado, el que llaman «Rugido del tigre». Quien quiera ser discípulo del maestro Liu, que primero intercambie golpes con el instructor Li en el salón; las artes de puño son sencillas, un puñetazo es un puñetazo."

msgid "柳家拳好是好，就是练了脾气暴，李教头那些徒弟三天两头在街上跟人动手。"
msgstr "El Puño de la familia Liu es bueno, pero al practicarlo se vuelve uno de carácter violento: los discípulos del instructor Li se pelean con la gente por la calle cada dos por tres."

msgid "柳家拳最怕打空。一拳落了空，人就离远了，再重的拳也够不着——小的挨过，知道。"
msgstr "Al Puño de la familia Liu lo que más le asusta es fallar. Si el puñetazo cae en el vacío, uno se queda lejos y por pesado que sea el puño ya no alcanza. Este servidor lo ha sufrido, lo sabe."

msgid "这是拳伤，一片青紫，底下还压着一记重的——柳家拳的路数，人贴上来才打得出这么重。"
msgstr "Es una herida de puño, una mancha morada, y debajo todavía hay un golpe pesado: el estilo del Puño de la familia Liu; solo pegado al cuerpo sale un golpe tan pesado."

msgid "这位$RESPECT身上没什么新伤，用不着看。"
msgstr "No tiene heridas nuevas, $RESPECT. No hace falta revisarlo."

msgid "封山剑派北宗是封山剑派里的一支，剑法、拳脚和内功都与本宗同出一源。绮云镇口的公告上，至今还写着「封山剑派北宗所在的雪亭镇」。"
msgstr "La rama norte de la Escuela de la Montaña Vacía es una rama de la escuela; su espada, sus artes de puño y su neigong comparten origen con la rama principal. En el anuncio de la entrada de Tejenubes todavía pone «Pabellón Nevado, donde se halla la Escuela de la Montaña Vacía, rama norte»."

msgid "振远镖局是京师第一大镖局，在京城一带几乎无人不知其名，绮云镇上也有振远的镖局。镖局里的人走镖凭的是一手春风快意刀。走镖危险，镖局收人先看胆识。"
msgstr "Los Escoltas del Largo Camino son la mayor agencia de escoltas de la Capital; en la zona de la Capital casi nadie desconoce su nombre, y también tienen una agencia en Tejenubes. Su gente escolta con la maña del Sable de la brisa primaveral. Escoltar es peligroso, y la agencia acepta primero a quien tiene valor."

msgid "东方神教是一个行事隐秘的教门，不立山门，也不收寻常弟子。教中人散在各处，平日看不出身份，外人对它的宗旨所知甚少。只听说教中高手使一路雪影剑法，身法轻疾。"
msgstr "La Orden del Cuervo Dorado es una orden de proceder secreto; no tiene sede ni acepta discípulos corrientes. Su gente está dispersa por todas partes y de ordinario no se les nota; los de fuera saben muy poco de sus fines. Solo se dice que los maestros de la orden usan un estilo de la Espada de la sombra de nieve, de pasos rápidos y ligeros."

msgid "天邪派以水烟阁为大本营。水烟阁在雪亭镇西边青石官道尽头的山上，相传最早的主人是武术之神杞庸，后来成了历代武林盟主的行馆，每年正月十七在阁外虹台推选盟主。天邪神功与天邪神掌是这一派的根本，相传是杞庸见灵兽天邪虎而悟出；另有一路六阴追魂剑法，是三百年前一位前辈从废墟中得来的。门规甚严，拜师要么立誓恪守门规，要么接下三招。"
msgstr "La Escuela Rebelde tiene su cuartel general en el Pabellón de la Neblina. El Pabellón de la Neblina está en la montaña, al final del Camino real de piedra azul, al oeste de Pabellón Nevado; se cuenta que su primer dueño fue Qi Yong, dios de las artes marciales, y que después fue la residencia de todos los Líderes de la Alianza del wulin, que cada año el diecisiete del primer mes eligen líder en la Terraza del Arcoíris, fuera del pabellón. El Arte rebelde y la Palma indómita son la raíz de esta escuela, y se dice que Qi Yong las ideó al ver al Tigre rebelde, bestia espiritual; hay además una Espada de los seis yin, que un anciano obtuvo hace trescientos años en unas ruinas. Las reglas son muy estrictas: para ser discípulo hay que jurar guardarlas o aguantar tres golpes."

msgid "绝尘派是绝尘子一手所创的门派。绝尘子原是佛门中人，后得奇人指点，悟得道家真谛，佛道双修，访遍名山大川后自号绝尘。他的修行之所在青石村的石室里，门上写着「非我弟子，莫入此门」。入门看慧根，也要有相当的江湖历练。"
msgstr "La Escuela del Desapego la fundó Juechenzi por sí solo. Juechenzi fue en origen un budista; guiado después por un hombre extraordinario, comprendió el verdadero sentido del taoísmo y cultivó a la vez budismo y taoísmo, y tras recorrer las montañas y ríos famosos se dio el nombre de Juechen. Su lugar de retiro está en la cámara de piedra de Aldea Piedra Azul, y en la puerta está escrito: \"Quien no sea mi discípulo, que no entre.\" Para entrar cuenta la aptitud, y también bastante experiencia en el jianghu."

msgid "茅山派自张天师开山立派，世代以降妖伏魔为己任，门户在茅山上的灵心观。门下修谷衣心法，排去体内的五谷秽气，炼成护体之气；修到小成，左眼眼珠会变成金色。法术以治鬼除魔为主，根基是天师正道。灵心观是出家人的道观，只收男弟子。"
msgstr "La Escuela del Monte Mao fue abierta por el Maestro Celestial Zhang, y desde entonces su deber ha sido someter demonios y domar fantasmas; su sede es el Monasterio del Corazón Claro, en el Monte Mao. Sus discípulos cultivan el Método interno de la túnica de grano, que expulsa la impureza del grano del cuerpo y forma un Qi protector; al logro menor, la pupila del ojo izquierdo se vuelve dorada. Su hechicería se dedica sobre todo a someter fantasmas y expulsar demonios, y su base es el Camino de los Maestros Celestiales. El Monasterio del Corazón Claro es un monasterio de religiosos, y solo acepta discípulos varones."

msgid "晚月庄是绮云镇以西林子深处的一座大宅院，朱漆大门，门口挂着灯笼，出现在乡野之间显得有些突兀。庄里多是女子，只收女弟子，庄主的琵琶闻名千里。武功以七宝天岚舞的身法、柔虹指和寒雪鞭法见长，内功意寒功纯走阴柔一路。"
msgstr "La Mansión Luna Tardía es una gran casona al oeste de Tejenubes, en lo profundo del bosque, de portón lacado en rojo y faroles en la entrada, que parece fuera de lugar en pleno campo. Casi todas las que viven allí son mujeres; solo acepta discípulas, y la pipa de la dueña es famoso en mil li a la redonda. Sus artes marciales destacan por los pasos de la Danza de la tormenta celeste, el Dedo del arcoíris suave y el Látigo de nieve fría; el neigong, el Arte de la intención helada, sigue solo la vía yin y suave."

msgid "山烟寺在绮云镇南、泓水对岸的日照山上，整座寺由上好的桧木建成，金碧辉煌。寺中老方丈医术通神，受过恩惠的富豪出资修整，名气比京城的白象禅院还大。要入寺先得剃度出家，只收男子；武功以流云杖法和疗伤的莲华心法为主，佛法精深的还修八识神通。"
msgstr "El Templo de la Bruma está en el Monte Soleado, al sur de Tejenubes, al otro lado del río Hong; todo el templo está construido con buen ciprés y resplandece de oro y verde. El viejo abad del templo tiene un arte de curar prodigioso, y los ricos a los que ha favorecido costean sus reparaciones; su fama supera la del Monasterio del Elefante Blanco de la Capital. Para entrar hay que tonsurarse y hacerse monje, y solo se acepta a hombres; sus artes marciales son sobre todo el Bastón de nubes que fluyen y el Método interno del loto para curar, y los de Dharma profundo cultivan además el Poder de las ocho conciencias."

msgid "逍遥派的门户不在这一带，中原少见其门人。听说这一派收徒讲究人品文采，掌门是个风流倜傥的人物。"
msgstr "La sede de la Escuela Despreocupada no está por esta zona, y en las Llanuras Centrales se ven pocos de sus discípulos. Se cuenta que esta escuela acepta discípulos por su carácter y su cultura, y que su Maestro es un hombre elegante y desenfadado."

msgid "天山派的门户远在天山，中原少见其门人。晚月庄后门外的小径，据说就是通往天山的路。"
msgstr "La sede de la Escuela de Tianshan está lejos, en Tianshan, y en las Llanuras Centrales se ven pocos de sus discípulos. El sendero que sale de la puerta trasera de la Mansión Luna Tardía, dicen, lleva a Tianshan."

msgid "步玄派是四百年前「秃笔狂生」骆步玄在京城创立的门派。骆步玄原是屡试不中的书生，一日在街边书肆望见一副对子，竟悟出一套武功，从此闯荡江湖。门下的步玄七诀号称天下轻功「轻捷第一」，使起来姿态有如书法；骆家至今是京城有名的武林世家。想入门的人，要先走一趟乔阴曼雩台东边的桃林。"
msgstr "La Escuela del Paso Místico la fundó en la Capital, hace cuatrocientos años, Luo Buxuan, «el Loco del Pincel Pelado». Luo Buxuan era un letrado que suspendía los exámenes; un día, en una librería de la calle, vio unos versos pareados y de pronto dedujo un arte marcial, y desde entonces recorrió el jianghu. Los Siete secretos del Paso Místico de su escuela son el qinggong «más ligero bajo el cielo», y se usan con un porte como de caligrafía; la familia Luo sigue siendo hasta hoy una conocida estirpe marcial de la Capital. Quien quiera ingresar debe ir primero a la Arboleda de duraznos, al este de la Terraza de la Danza de Lluvia de Sombra Alta."

msgid "花紫会是乞丐们的帮会，只收身上没几个钱的化子。龙头的信物是一只打着二十三个结的皮酒囊；龙头行踪诡秘，据说各处总有七八个替身。会中的武功有油流麻香手和伏蛟功。"
msgstr "La Hermandad de los Mendigos es la hermandad de los pordioseros, y solo acepta a mendigos con pocas monedas encima. El emblema del Cabeza de Dragón es un odre de cuero con veintitrés nudos; el Cabeza de Dragón anda con gran sigilo, y se dice que en cada lugar tiene siete u ocho dobles. Sus artes son la Mano de aceite y pimienta y el Arte de domar serpientes."

msgid "铁盾会是番坊里大秦人的剑会，门前立着两面比人还高的铁包边大盾，盾面上漆着展翅的鹰。大秦人的祖上从西边来，在这片海边落了脚。会里的剑手左手盾、右手短剑，两两对练；铁盾剑法盾在前、剑在后，没有盾的人不教。"
msgstr "La Hermandad del Escudo de Hierro es la hermandad de esgrima de los hombres de Daqin del Barrio Extranjero; ante la puerta se alzan dos grandes escudos con borde de hierro, más altos que un hombre, con un águila de alas desplegadas pintada en el frente. Los antepasados de los de Daqin vinieron del oeste y se asentaron en esta costa. Los espadachines de la hermandad, con el escudo en la izquierda y una espada corta en la derecha, practican por parejas; la Espada del escudo de hierro lleva el escudo delante y la espada detrás, y a quien no tiene escudo no se enseña."

msgid "鬼笠馆是番坊里倭人浪人开的武馆，门楣上挂着一顶破了边的斗笠，馆名就是这么来的。门规只有一句：「一击之内定生死」——刀出鞘，只出一次。鬼笠刀法的刀比中原的窄而弯，劈下去就收，不出第二刀。"
msgstr "El Salón del Sombrero Fantasma es una escuela que abrieron ronin japoneses en el Barrio Extranjero; sobre el dintel cuelga un sombrero de paja con el borde roto, y de ahí el nombre. La regla es una sola frase: \"Vida o muerte dentro de un solo golpe\": el sable sale de la vaina una sola vez. El sable del Sombrero Fantasma es más estrecho y curvo que el de las Llanuras Centrales, corta y se recoge, y no da un segundo golpe."

msgid "日陀罗寺是番坊里一座不大的寺院，由两位天竺僧人所建，赭红的墙头长着草。院中一棵大榕树，是第一代师父从天竺带来的枝条插活的。入寺要先剃度出家，只收男子，所传的是莲华心法、流云杖法这些佛门功夫。"
msgstr "El Templo Ritola es un templo no muy grande del Barrio Extranjero, levantado por dos monjes indios, con hierba que crece sobre los muros de ocre rojizo. En el patio hay un gran baniano, plantado con un esqueje que el primer Shifu trajo de la India. Para entrar hay que tonsurarse y hacerse monje, y solo se acepta a hombres; lo que se transmite son artes budistas como el Método interno del loto y el Bastón de nubes que fluyen."

msgid "柳淳风是个相当高大的中年儒生，若不是从他腰间挂著的「玄苏剑」你\n大概猜不到眼前这个温文儒雅的中年人竟是家大武馆的馆主。\n"
msgstr "Liu Chunfeng es un letrado de mediana edad, de buena estatura; si no fuera por la espada Xuansu que lleva colgada a la cintura, nadie imaginaría que este hombre afable y culto es el maestro de un gran salón de artes marciales."

msgid "竹书"
msgstr "Libro de bambú"

msgid "本宗"
msgstr "Rama principal"

msgid "跟柳淳风守本宗：封山的剑不外传。\n他亲传你「点」字诀，你是掌门传人；柳绘心会离开武馆，带着「北宗」两个字去绮云镇。封山在虹台上的那一票跟着柳淳风——等盟主回来（已经入了虹台的席的，这一票不再跟着变）。\n这是封山这条线的大分裂，选了不能改。要跟师父吗？"
msgstr "Quedarte con Liu Chunfeng y la rama principal: la espada de la Montaña Vacía no se enseña a extraños.\nÉl te enseña en persona el secreto de la «punta», y eres quien hereda la dirección de la escuela; Liu Huixin dejará el salón y se irá a Tejenubes con el nombre de «rama norte». El voto de la Montaña Vacía en la Terraza del Arcoíris sigue a Liu Chunfeng: a esperar al Líder de la Alianza (si ya has tomado asiento en la Terraza, ese voto ya no cambia).\nEs la gran ruptura de la línea de la Montaña Vacía, y lo que elijas no se puede cambiar. ¿Seguir al Shifu?"

msgid "虹台上的事还没完。等散了会再说。"
msgstr "Lo de la Terraza del Arcoíris aún no ha terminado. Hablamos cuando la asamblea se disperse."

msgid "点字诀"
msgstr "Secreto de la punta"

msgid "武馆的事"
msgstr "Asuntos del salón"

msgid "腰牌"
msgstr "Placa"

msgid "先人遗志"
msgstr "Voluntad de los antepasados"

msgid "隘口"
msgstr "Desfiladero"

msgid "老松寨的常老大，人称泼风刀王，什么钱都收。要过他的寨门，带够银子；有本事的，就在寨门外叫阵——硬闯的人，没几个回来。"
msgstr "El Jefe Chang del Fuerte de los Pinos Viejos, al que llaman el Rey del Sable Tormenta, acepta todo el dinero. Para cruzar el portón de su fuerte, lleva plata de sobra; si tienes habilidad, reta a gritos fuera del portón: de los que entran a la fuerza, pocos vuelven."

msgid "黑冠黑衣的道士？这一带没有道观。你若在老松岭遇上，小心些，那种人下手没有分寸。"
msgstr "¿Un taoísta de gorro negro y túnica negra? Por aquí no hay monasterio. Si te lo cruzas en el Cerro de los Pinos Viejos, ten cuidado: esa gente no sabe dónde parar."

msgid "老岑的信，你留着。末一行我不认得——他说过他在山里见过一座城，我只当是饿昏了的话。"
msgstr "Quédate con la carta del viejo Cen. La última línea no la entiendo: dijo una vez que había visto una ciudad en la montaña, y yo lo tomé por delirios de hambre."

msgid "接过信，看了很久，又折好还给你。"
msgstr " toma la carta, la lee largo rato, la dobla de nuevo y te la devuelve."

msgid "老岑……二十多年前我在山里迷了路，三天没吃东西，是个砍柴的老人领我下的山。他不识几个字——这封信，他写了多久啊。"
msgstr "El viejo Cen... Hace más de veinte años me perdí en la montaña, tres días sin comer, y fue un leñador viejo quien me guio montaña abajo. Apenas sabía letras: ¿cuánto le habrá costado escribir esta carta?"

msgid "他托你来，武馆的门你随时进。拜不拜师，你自己定。"
msgstr "Él te mandó: la puerta del salón está abierta para ti cuando quieras. Que te hagas mi discípulo o no, lo decides tú."

msgid "末一行我不认得。他说过他在山里见过一座城，铃声满耳……我只当是饿昏了的话。你收好。"
msgstr "La última línea no la entiendo. Dijo que había visto una ciudad en la montaña, con el sonido de las campanas por todas partes... yo lo tomé por delirio de hambre. Guárdala bien."

msgid "什么信？"
msgstr "¿Qué carta?"

msgid "看了你一眼。"
msgstr " te echa un vistazo."

msgid "信没了？……罢了，我再写一封。"
msgstr "¿Perdiste la carta? ...En fin, escribiré otra."

msgid "提笔又写了一封信，封好了交给你。"
msgstr " toma el pincel, escribe otra carta, la sella y te la entrega."

msgid "这回收好。潘军禅认信不认人。"
msgstr "Esta vez guárdala bien. Pan Junchan atiende a la carta, no a la cara."

msgid "信已经给你了。去水烟阁找潘军禅，他是我的结拜义弟，见信如见我。"
msgstr "Ya te di la carta. Ve al Pabellón de la Neblina y busca a Pan Junchan: es mi hermano jurado, y ver mi carta es como verme a mí."

msgid "听你说完山洞里的事，沉默了半晌。"
msgstr " escucha lo que pasó en la cueva y guarda silencio un buen rato."

msgid "洞里那个道士，是你杀的？……头一回手上沾血，夜里睡得着就好。睡不着，来武馆找我，我陪你坐一坐。"
msgstr "Ese taoísta de la cueva, ¿lo mataste tú? ...La primera vez que se tiene sangre en las manos, si esa noche puedes dormir, bien. Si no puedes, ven al salón; me sentaré contigo un rato."

msgid "二十年前，振远镖局押一趟镖过老松岭，镖师随从一个都没回来。镖局丢了脸，陈剑秋到今天都不肯提。"
msgstr "Hace veinte años, los Escoltas del Largo Camino llevaron una escolta por el Cerro de los Pinos Viejos, y de los escoltas y sus acompañantes no volvió ninguno. La agencia perdió la cara, y Chen Jianqiu hasta hoy no quiere hablar de ello."

msgid "那具骸骨若真是水烟阁的人，这事就该问水烟阁。我写一封信，你拿去给执法使潘军禅，他是我的结拜义弟。"
msgstr "Si ese esqueleto es de verdad de gente del Pabellón de la Neblina, el asunto es para el Pabellón de la Neblina. Escribiré una carta; llévasela al Ejecutor Pan Junchan, mi hermano jurado."

msgid "提笔写了一封信，封好了交给你。"
msgstr " toma el pincel, escribe una carta, la sella y te la entrega."

msgid "先去绮云镇问问陈剑秋，把镖单要来。上了山，别带着兵刃进阁。"
msgstr "Primero ve a Tejenubes y pregunta a Chen Jianqiu por el registro de escolta; tráelo. Cuando subas a la montaña, no entres con armas en el pabellón."

msgid "还有一件：前夜老松岭上起了火，山下都看得见——是老松寨。那道士的同伙回来了，挨个问寨里的人：匣子在谁手里。夜里睡觉，把门闩上。"
msgstr "Y otra cosa: anteanoche hubo fuego en el Cerro de los Pinos Viejos, se veía desde el pie de la montaña: fue el Fuerte de los Pinos Viejos. Los compinches de ese taoísta volvieron y fueron preguntando uno por uno a la gente del fuerte quién tiene el cofre. De noche, echa el cerrojo a la puerta."

msgid "水烟阁在青石官道西头的山上，武者同盟的总坛。"
msgstr "El Pabellón de la Neblina está en la montaña, al final oeste del Camino real de piedra azul: es la sede de la Alianza Marcial."

msgid "虹台上的事定了。封山守封山的规矩。"
msgstr "Lo de la Terraza del Arcoíris está decidido. La Montaña Vacía se atiene a las reglas de la Montaña Vacía."

msgid "封山这一票，等盟主回来。"
msgstr "El voto de la Montaña Vacía espera a que regrese el Líder de la Alianza."

msgid "封山这一票，正月十七照你说的投。"
msgstr "El diecisiete del primer mes, el voto de la Montaña Vacía irá como dijiste."

msgid "把手里的茶盏放下，半晌没有说话。"
msgstr " deja la taza de té que tiene en la mano y pasa un buen rato sin decir palabra."

msgid "颜违许了北宗一个座。北宗的人上得了虹台，封山这一票，就跟着颜违走了。"
msgstr "Yan Wei le prometió un asiento a la rama norte. Si la gente de la rama norte llega a la Terraza del Arcoíris, el voto de la Montaña Vacía se va con Yan Wei."

msgid "那一票不在我手里。你要说什么，去内院同绘心说。"
msgstr "Ese voto no está en mis manos. Lo que tengas que decir, díselo a Huixin, en el patio interior."

msgid "等盟主回来。二十年了，虹台上那把石椅，封山不替任何人去坐。"
msgstr "Esperaremos a que regrese el Líder de la Alianza. Veinte años: la silla de piedra de la Terraza del Arcoíris, la Montaña Vacía no la ocupa por nadie."

msgid "……你是掌门传人。你要这一票投你自己，你开口。"
msgstr "...Eres quien hereda la escuela. Si quieres este voto para ti, solo tienes que pedirlo."

msgid "颜违要把那个「代」字去掉——他去他的。封山的剑不外传，封山的票也不跟着人走。"
msgstr "Yan Wei quiere quitar esa palabra, «en funciones»: allá él. La espada de la Montaña Vacía no se enseña a extraños, y el voto de la Montaña Vacía no sigue a nadie."

msgid "正月十七的事？湖上的事还没了，说那个早了。"
msgstr "¿El diecisiete del primer mes? Lo del lago aún no ha terminado; es pronto para hablar de eso."

msgid "这一票"
msgstr "Este voto"

msgid "请柳淳风把封山这一票交给你：正月十七虹台上，封山听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "Pedirle a Liu Chunfeng que te entregue el voto de la Montaña Vacía: el diecisiete del primer mes, en la Terraza del Arcoíris, la Montaña Vacía te obedece; si te presentas, el voto es tuyo; si no, tú dices a quién se vota.\n¿Quieres decirlo así?"

msgid "虹台上已经入了席。票就是票了。"
msgstr "Ya hay asientos tomados en la Terraza del Arcoíris. Un voto es un voto."

msgid "那一票不在我手里。"
msgstr "Ese voto no está en mis manos."

msgid "说过了。封山听你的。"
msgstr "Ya está dicho. La Montaña Vacía te obedece."

msgid "看了你很久，点了点头。"
msgstr " te mira largo rato y asiente."

msgid "好。封山听你的。"
msgstr "Bien. La Montaña Vacía te obedece."

msgid "……"
msgstr "..."

msgid "规矩是规矩。北宗的人，我不能再教了。"
msgstr "Las reglas son las reglas. A la gente de la rama norte ya no puedo enseñarla."

msgid "这卷书，你不是已经给了绘心么。……拿回去还她。"
msgstr "Este libro, ¿no se lo habías dado ya a Huixin? ...Devuélveselo."

msgid "把《悟疾风劲竹书》交给柳淳风。\n他会把它收进匣里，不再示人。书只有这一本，给出去就读不到了；柳绘心也读不到。\n要交给他吗？"
msgstr "Entregar «Bambú contra el vendaval» a Liu Chunfeng.\nÉl lo guardará en su cofre y no lo mostrará más. Solo hay este ejemplar: una vez entregado ya no podrás leerlo, y Liu Huixin tampoco.\n¿Quieres entregárselo?"

msgid "接过书，没有翻开，用袖口把封皮上的灰擦了。"
msgstr " toma el libro sin abrirlo y limpia con la manga el polvo de la cubierta."

msgid "直竹贵地生……二十岁写的。那时候以为自己什么都懂。"
msgstr "Bambú recto, raíz profunda... Lo escribí a los veinte años. Entonces creía que lo entendía todo."

msgid "年轻时的糊涂话，收起来罢。"
msgstr "Tonterías de juventud. Guárdalo."

msgid "把书收进了案头的匣里。"
msgstr " guarda el libro en el cofre de su mesa."

msgid "绘心这些日子常往内院去，一去就是半天。你改日替我看一眼。"
msgstr "Últimamente Huixin va mucho al patio interior y se pasa allí medio día. Échale un vistazo por mí otro día."

msgid "这卷书……你从竹林里取出来的？先留着读。武馆的事办完了，再同我说。"
msgstr "¿Este libro... lo sacaste del bosque de bambú? Quédatelo y léelo por ahora. Cuando termine lo del salón, hablaremos."

msgid "把腰牌收进袖里。"
msgstr " guarda la placa en la manga."

msgid "找回来了？我替他收着。"
msgstr "¿Lo encontraste? Yo se la guardo."

msgid "牌我替他收着。他什么时候戒了赌，什么时候自己来取。"
msgstr "Yo guardo la placa. Cuando deje el juego, que venga él mismo a buscarla."

msgid "牌是逄师弟的。你先去绮云镇问他一句，牌是怎么到外人手里的。"
msgstr "La placa es del hermano menor Pang. Primero ve a Tejenubes y pregúntale cómo fue a parar a manos de un extraño."

msgid "你跟了她。……也好。她一个人，我不放心。"
msgstr "Te fuiste con ella. ...Mejor así. No me gustaría que estuviera sola."

msgid "武馆的门不拦你。剑，我不能再教了——规矩是规矩。"
msgstr "La puerta del salón no se te cierra. La espada ya no puedo enseñártela: las reglas son las reglas."

msgid "刘兄弟的事，李教头回过我了。规矩是先父立的，我不能为他破。"
msgstr "Del hermano Liu me ha hablado el instructor Li. La regla la puso mi padre, y no puedo romperla por él."

msgid "五年前我留他，是我的事；今天你说破，是你的事。都没有错。"
msgstr "Hace cinco años lo retuve yo; eso fue cosa mía. Hoy tú lo dijiste en voz alta; eso fue cosa tuya. Ninguno se equivocó."

msgid "……说到规矩。我年轻时在天驼关的竹林里留过一卷书，写的也是这两个字。改日同你说。"
msgstr "...Hablando de reglas. De joven dejé un libro en el bosque de bambú del Paso del Camello, y trataba de estas dos palabras. Otro día te cuento."

msgid "李教头说，那伙人认错了人。"
msgstr "El instructor Li dice que esos hombres se equivocaron de persona."

msgid "看了你很久。"
msgstr " te mira largo rato."

msgid "刘兄弟的来历，五年前我就知道。你替他担了这句话——往后，也替武馆担着。"
msgstr "Hace cinco años que sé de dónde viene el hermano Liu. Tú cargaste con esa palabra por él; de ahora en adelante, cárgala también por el salón."

msgid "你跟了绘心，就是北宗的人。本宗的门，我不能再为你开。"
msgstr "Te fuiste con Huixin, así que eres de la rama norte. La puerta de la rama principal ya no puedo abrírtela."

msgid "学剑之人必须胆大心细，依我看$RESPECT的资质似乎不宜？"
msgstr "Quien aprende la espada debe ser audaz y cuidadoso. A mi juicio, $RESPECT, tus dotes no parecen las adecuadas."

msgid "很好，$RESPECT多加努力，他日必定有成。"
msgstr "Muy bien, $RESPECT. Esfuérzate, y algún día lo lograrás."

msgid "这是个正在执行公务的县城官兵，虽然和许多武林人物比起来，官兵\n们的武功实在稀松平常，但是他们是有组织、有纪律的战士，谁也不\n轻易地招惹他们。\n"
msgstr "Un soldado del condado en funciones oficiales. Comparados con muchos del wulin, la destreza marcial de los soldados es muy poca cosa, pero son combatientes organizados y disciplinados, y nadie los provoca a la ligera."

msgid "县城官兵喝道：还不快放下武器束手就缚？\n"
msgstr "El soldado del condado grita: \"¡Suelta el arma y entrégate ahora mismo!\"\n"

msgid "县城官兵喝道：大胆刁民竟敢拒捕？反了！反了！\n"
msgstr "El soldado del condado grita: \"¡Insolente! ¿Te atreves a resistirte al arresto? ¡Rebelión! ¡Esto es una rebelión!\"\n"

msgid "水烟阁传功使"
msgstr "Instructor del Pabellón de la Neblina"

msgid "於兰天武是当今皇上的叔父，但是他毕生浸淫武学，甘愿抛弃荣华富\n以换取水烟阁传功使一职，以便阅读水烟阁中所藏的武学典籍，无论\n你有什麽武学上的疑难，他都能为你解答。\n"
msgstr "Yulan Tianwu es tío del actual emperador, pero se ha sumergido toda la vida en las artes marciales y renunció de buen grado a riquezas y rangos a cambio del puesto de Instructor del Pabellón de la Neblina, para poder leer los clásicos marciales que guarda el pabellón; sea cual sea tu duda sobre las artes marciales, él sabe resolverla."

msgid "武学之道....嗯....只可意会，不可言喻。\n"
msgstr "El camino de las artes marciales... bueno... se entiende, pero no se puede decir.\n"

msgid "水烟阁乃是历届武林盟主的行馆，你有什麽事要见武林盟主？\n"
msgstr "El Pabellón de la Neblina es la residencia de todos los Líderes de la Alianza del wulin. ¿Qué asunto tienes con el Líder de la Alianza?\n"

msgid "哦....老夫向来有个规矩，凡是想拜我为师的，得接我三招不死，你想试试？\n"
msgstr "Oh... este viejo tiene una regla de siempre: quien quiera ser mi discípulo debe aguantar tres golpes míos sin morir. ¿Quieres intentarlo?\n"

msgid "皇上"
msgstr "Su Majestad"

msgid "老夫在朝上一天，庾子建就不是一个人说了算。"
msgstr "Mientras este viejo esté en la corte, Yu Zijian no decidirá solo."

msgid "昭儿？……他还小。朝廷的事，老夫不问了。"
msgstr "¿Zhao'er? ...Aún es un niño. Este viejo ya no pregunta por los asuntos de la corte."

msgid "在老夫手里。三百年前於兰家拔错了一把——决战那日，你来叫我，看老夫这一回拔得对不对。"
msgstr "En manos de este viejo. Hace trescientos años la familia Yulan sacó la espada equivocada: el día de la batalla decisiva, ven a llamarme y verás si esta vez este viejo la saca bien."

msgid "你拔的。好——於兰家这一回，不用再错一次。"
msgstr "La sacaste tú. Bien... La familia Yulan no tendrá que equivocarse otra vez."

msgid "萧家那孩子拿去了。他回了一趟岚城，比老夫配。"
msgstr "Se la llevó el muchacho Xiao. Fue una vez a la Ciudad del Viento; la merece más que este viejo."

msgid "寒於氏的剑。於兰家的血里有寒於氏的一份——君违嫁过来的那一份。三百年前，我家的人拔错了一把剑。"
msgstr "La espada del clan Hanyu. En la sangre de la familia Yulan hay una parte del clan Hanyu: la que trajo Junwei al casarse. Hace trescientos años, uno de los míos sacó la espada equivocada."

msgid "旋芒……先帝找了一辈子。老夫不找。"
msgstr "Filo Giratorio... El difunto emperador la buscó toda su vida. Este viejo no la busca."

msgid "找到城，叫我。风会知道怎么找到於兰家的人。"
msgstr "Cuando encuentres la ciudad, llámame. El viento sabrá cómo encontrar a un Yulan."

msgid "樵夫撞进去过，先帝的人没有。老夫不信那些。"
msgstr "Un leñador llegó a entrar alguna vez; la gente del difunto emperador, nunca. Este viejo no cree en esas cosas."

msgid "人送回水烟阁了。庾子建那道门，老夫往后还会去敲。"
msgstr "Ya lo devolvieron al Pabellón de la Neblina. A la puerta de Yu Zijian, este viejo volverá a llamar."

msgid "卫沧澜出来了？好。……二十年，老夫在水烟阁等他回来，他就关在京城。"
msgstr "¿Wei Canglan salió? Bien. ...Veinte años esperando en el Pabellón de la Neblina a que volviera, y estaba encerrado en la Capital."

msgid "虹台那边已经开了席。等散了会，老夫再去庾子建那里要人——这时候把人领出来，倒像是去抢那把椅子。"
msgstr "La Terraza del Arcoíris ya abrió los asientos. Cuando termine la asamblea, este viejo irá a casa de Yu Zijian a reclamar al hombre: sacarlo ahora parecería ir a arrebatar esa silla."

msgid "放下手里的茶盏，站了起来。"
msgstr " deja la taza de té y se pone en pie."

msgid "卫沧澜？二十年前的武林盟主……庾子建府上那间客房，老夫知道。"
msgstr "¿Wei Canglan? El Líder de la Alianza de hace veinte años... La habitación de invitados de la casa de Yu Zijian, este viejo la conoce."

msgid "昭儿的手诏召老夫回朝，也叫得开兵部尚书的门。你在这里等着。"
msgstr "El edicto manuscrito de Zhao'er llama a este viejo de vuelta a la corte, y también abre la puerta del Ministro de la Guerra. Espera aquí."

msgid "於兰天武大步出了养心殿，两个侍卫捧着黄绫跟在后头。\n"
msgstr "Yulan Tianwu sale a zancadas del Salón del Cultivo Mental, con dos guardias detrás que llevan la seda amarilla.\n"

msgid "过了一个多时辰，殿外一阵脚步响。於兰天武回来了，身后跟着一个白发的老人，腋下夹着一本诗集。\n"
msgstr "Pasadas un buen par de horas, se oyen pasos fuera del salón. Yulan Tianwu ha vuelto, y tras él viene un anciano de pelo blanco, con un libro de poemas bajo el brazo.\n"

msgid "庾子建亲自开的门，一句话也没说。……老夫进门的时候，他还躬着身。"
msgstr "Yu Zijian abrió la puerta en persona y no dijo una palabra. ...Cuando este viejo entró, él todavía estaba inclinado."

msgid "卫沧澜朝你点点头：「老夫先回水烟阁。这条命是皇叔从尚书府要回来的，欠朝廷一份。」\n"
msgstr "Wei Canglan te hace un gesto con la cabeza: \"Este viejo vuelve primero al Pabellón de la Neblina. Esta vida me la devolvió el tío imperial de la Mansión del Ministro; debo una parte a la corte.\"\n"

msgid "卫沧澜……二十年没有消息了。"
msgstr "¿Wei Canglan? ...Veinte años sin noticias."

msgid "$RESPECT若真的有心，不妨让我看看你的所学"
msgstr "Si de verdad tienes interés, $RESPECT, deja que vea lo que has aprendido"

msgid "如果想拜师的话，就请接受测试"
msgstr "Si quieres ser mi discípulo, acepta la prueba."

msgid "於兰天武点了点头，说道：很好，这是第一招...."
msgstr "Yulan Tianwu asiente y dice: \"Muy bien, este es el primer golpe...\""

msgid "於兰天武叹了口气，说道：连第一招都撑不过，真是自不量力...."
msgstr "Yulan Tianwu suspira y dice: \"Ni siquiera aguantas el primer golpe... qué atrevimiento...\""

msgid "於兰天武说道：这是第二招...."
msgstr "Yulan Tianwu dice: \"Este es el segundo golpe...\""

msgid "於兰天武「哼」地一声，说道：便是有这许多不怕死的家伙...."
msgstr "Yulan Tianwu dice con un \"¡hmm!\": \"Siempre hay tantos necios que no temen a la muerte...\""

msgid "於兰天武说道：第三招来了...."
msgstr "Yulan Tianwu dice: \"Aquí viene el tercer golpe...\""

msgid "於兰天武叹道：可惜，难道老夫一身武功竟无传人...."
msgstr "Yulan Tianwu suspira: \"Qué lástima. ¿Acaso toda la destreza de este viejo se quedará sin heredero...?\""

msgid "於兰天武哈哈大笑，说道：今日老夫终於觅得一个可造之才！"
msgstr "Yulan Tianwu ríe a carcajadas y dice: \"¡Hoy este viejo por fin ha encontrado a alguien digno de formar!\""

msgid "接过黄笺，看了一遍，又看了一遍，半晌没有说话。"
msgstr " toma el papel amarillo, lo lee una vez, lo lee otra, y pasa un buen rato sin decir palabra."

msgid "昭儿的字……还是这么慢。"
msgstr "La letra de Zhao'er... sigue siendo así de lenta."

msgid "三百年了，於兰家的人又要去碰那东西。老夫不回去，这孩子一个人扛不住。"
msgstr "Trescientos años, y un Yulan va a volver a tocar esa cosa. Si este viejo no vuelve, el muchacho no podrá cargar solo."

msgid "把手诏折好，揣进怀里，站了起来。"
msgstr " dobla el edicto, se lo guarda en el pecho y se pone en pie."

msgid "传功使的事，交给萧辟尘。——老夫回京。"
msgstr "Los asuntos del Instructor, a Xiao Bichen. —Este viejo vuelve a la Capital."

msgid "萧辟尘自幼生长於岚城之中，看起来仙风道骨，不食人间烟火。\n"
msgstr "Xiao Bichen se crió en la Ciudad del Viento; tiene un aire de inmortal, como si no comiera los alimentos de este mundo."

msgid "{respect}既然使兵刃，在下空手接招未免不敬。"
msgstr "Ya que empuñas un arma, {respect}, sería una falta de respeto que yo te recibiera con las manos desnudas."

msgid "进招吧！"
msgstr "¡Ataca!"

msgid "既然{respect}不使兵刃，在下自然奉陪！"
msgstr "Ya que no usas arma, {respect}, ¡yo también iré con las manos vacías!"

msgid "嗯... 既然{count}位都是空手，在下理当奉陪！"
msgstr "Hmm... ya que los {count} van con las manos vacías, ¡es justo que los acompañe!"

msgid "我天邪派门规甚严，$RESPECT如果真的有心，且发个誓来。"
msgstr "Las reglas de nuestra Escuela Rebelde son muy estrictas. Si de verdad tienes interés, $RESPECT, haz un juramento."

msgid "多说无益，若不发誓恪守门规，便是跪著求我也没用。"
msgstr "Hablar no sirve de nada. Si no juras guardar las reglas de la escuela, ni de rodillas conseguirás nada."

msgid "守门规"
msgstr "Guardar las reglas"

msgid "这就是了。"
msgstr "Eso es."

msgid "我回去过一回了。城还是那个样子，铃挂在钩上。……风记得我。"
msgstr "Volví una vez. La ciudad sigue como era, y la campanilla cuelga de su gancho. ...El viento me recuerda."

msgid "……这是我的铃。」他把铃接过去，翻来覆去看了很久，拇指在那个「尘」字上摸了一下，又还给你：「铃在，风认人。你带着它，比我带着它有用。"
msgstr "...Es mi campanilla.\" Toma la campanilla y la mira por todos lados un buen rato, pasa el pulgar sobre el carácter «Chen» y te la devuelve: \"Mientras la campanilla esté contigo, el viento reconoce a los suyos. Contigo sirve más que conmigo."

msgid "我四岁那年起了一场大风，醒来就在山外了，身边什么也没有。铃丢了，风就不认得我，我再也回不去。……风是从城里往外吹的。小时候我放风筝，线总是往外拽。"
msgstr "A los cuatro años se levantó un gran viento, y al despertar estaba fuera de las montañas, sin nada a mi lado. Perdí la campanilla, y el viento ya no me reconoció; nunca pude volver. ...El viento sopla desde la ciudad hacia fuera. De niño, cuando volaba cometas, el hilo siempre tiraba hacia fuera."

msgid "岚城……我是在那里长大的。别的，不说了。"
msgstr "La Ciudad del Viento... allí me crié. De lo demás, no hablo."

msgid "风铃"
msgstr "Campanilla de viento"

msgid "铃舌上那个字是铃匠刻的。岚城的孩子，人人一只。"
msgstr "La letra de la lengüeta de la campanilla la grabó el campanero. En la Ciudad del Viento, cada niño tiene una."

msgid "那只匣子……对着岚城的风才开。镜子里的上道，风从那头来。"
msgstr "Esa caja... solo se abre con el viento de la Ciudad del Viento. El camino de arriba, en el espejo: el viento viene de ese lado."

msgid "黄石隘口挖出来的那只石匣，后来在哪里？……先帝的人当年从山外收走过一只铃。我一直想，那是我的。"
msgstr "El cofre de piedra que se desenterró en el Desfiladero de Piedra Amarilla, ¿dónde acabó? ...Los hombres del difunto emperador se llevaron una vez una campanilla de fuera de las montañas. Siempre pensé que era la mía."

msgid "风铃？水烟阁的檐下也挂着几只，风一大就响。"
msgstr "¿Campanillas de viento? Bajo los aleros del Pabellón de la Neblina también cuelgan unas cuantas, y suenan cuando sopla fuerte."

msgid "在我背上。决战那日，它跟我下湖。"
msgstr "A mi espalda. El día de la batalla decisiva, bajará al lago conmigo."

msgid "是你。好。"
msgstr "Eres tú. Bien."

msgid "皇叔拔的？……也好。於兰家欠这把剑一回。"
msgstr "¿La sacó el tío imperial? ...Mejor así. La familia Yulan le debía una a esta espada."

msgid "岚城有一把剑，叫旋芒。守剑的老人不卖，不赏，不问剑给谁做什么——只问谁拔。"
msgstr "En la Ciudad del Viento hay una espada llamada Filo Giratorio. El anciano que la guarda no la vende, no la regala, no pregunta para quién ni para qué es la espada: solo pregunta quién la saca."

msgid "旋芒？朝廷要找的那把剑。……小天邪不问这个。"
msgstr "¿Filo Giratorio? La espada que busca la corte. ...El Pequeño Rebelde no pregunta por eso."

msgid "湖底"
msgstr "Fondo del lago"

msgid "湖底那颗头，三百年前是穿灵钉住的。这一回，我拿旋芒去。回不来，就回不来。"
msgstr "La cabeza del fondo del lago, hace trescientos años la clavó Traspasalmas. Esta vez llevo Filo Giratorio. Si no vuelvo, no vuelvo."

msgid "湖底？玉螺湖底下的事，小天邪不问。"
msgstr "¿El fondo del lago? Lo que hay bajo el Lago Caracola de Jade, el Pequeño Rebelde no lo pregunta."

msgid "水烟阁执法使"
msgstr "Ejecutor del Pabellón de la Neblina"

msgid "潘军禅是当今武林的一位传奇性人物，以他仅仅二十八岁的年龄竟能做到\n水烟阁执法使的职位，著实是一位不简单的人物。潘军禅是封山剑派掌门\n柳淳风的结拜义弟，但是他为人其实十分风趣，又好交朋友，丝毫不会摆\n出武林执法者的架子。\n"
msgstr "Pan Junchan es una figura legendaria del wulin de hoy: con solo veintiocho años ha llegado a ser Ejecutor del Pabellón de la Neblina, lo que lo hace un hombre nada común. Pan Junchan es hermano jurado menor de Liu Chunfeng, Maestro de la Escuela de la Montaña Vacía, pero en realidad es muy divertido y sociable, y no se da aires de ejecutor del wulin."

msgid "柳大哥？他是我的结拜义兄。你有他的信？拿来我看。"
msgstr "¿El hermano mayor Liu? Es mi hermano jurado mayor. ¿Tienes una carta suya? Trae, que la vea."

msgid "阁里那把是假的，真剑不在这儿。要找去年那个道士，往野羊山北麓去。"
msgstr "La del pabellón es falsa; la espada de verdad no está aquí. Si buscas al taoísta del año pasado, ve a la falda norte del Cerro de las Cabras."

msgid "看了柳淳风的信，笑了。"
msgstr " lee la carta de Liu Chunfeng y sonríe."

msgid "柳大哥的朋友就是我的朋友。邪剑穿灵？阁里挂着的那把，是仿的。"
msgstr "Un amigo del hermano Liu es amigo mío. ¿Traspasalmas, la espada maligna? La que cuelga en el pabellón es una imitación."

msgid "真剑早就不在水烟阁了。挂一把假的，是鱼饵——钓那些冲着它来的人。"
msgstr "La espada de verdad hace tiempo que no está en el Pabellón de la Neblina. Colgar una falsa es un cebo, para pescar a los que vienen por ella."

msgid "去年就钓上来一个：黑衣黑冠的道士，夜里来试剑，发觉是假的就走了。我的人跟到野羊山北麓，跟丢了。那边没有道观，只有一片黑砖。"
msgstr "El año pasado picó uno: un taoísta de túnica negra y gorro negro que vino de noche a probar la espada, y al ver que era falsa se fue. Mi gente lo siguió hasta la falda norte del Cerro de las Cabras y lo perdió. Allí no hay monasterio, solo un trecho de ladrillo negro."

msgid "柳大哥让你来的？信呢？没有他的信，执法使的佩剑不是你问得的。信丢了，回武馆找他再写一封。"
msgstr "¿Te mandó el hermano Liu? ¿Y la carta? Sin su carta, la espada del Ejecutor no es cosa que puedas preguntar. Si la perdiste, vuelve al salón a pedirle que escriba otra."

msgid "执法使的佩剑，也是你问得的？"
msgstr "La espada del Ejecutor, ¿y crees que puedes preguntar por ella?"

msgid "宝衣"
msgstr "Túnica de Hanyu"

msgid "晚月庄。守它的人不白给——我说过了。"
msgstr "La Mansión Luna Tardía. A quien la guarda no se le regala nada: ya te lo dije."

msgid "寒於宝衣？你倒问到点子上了。"
msgstr "¿La Túnica de Hanyu? Ahora sí preguntas lo que importa."

msgid "当年三件东西各归一处，宝衣归月神族保管。月神族早没了，只剩晚月庄那些女子——自称人灵区冥的后人，庄里供着她的神像，池边立着凤凰护庄。"
msgstr "En su día las tres cosas fueron cada una a un sitio, y la túnica quedó al cuidado del clan del Dios Luna. El clan del Dios Luna hace mucho que no existe; solo quedan las mujeres de la Mansión Luna Tardía, que se dicen descendientes del Alma humana Ouming: en la mansión veneran su imagen, y un fénix guarda la orilla del estanque."

msgid "衣在不在庄里，我不知道。守它的人不白给——你去了就明白。"
msgstr "Si la túnica está en la mansión, no lo sé. A quien la guarda no se le regala nada: ve y lo entenderás."

msgid "还有——野羊山那边前夜出了事。一伙黑冠道士摸上山，抓走了寨里两个人，挨个问：那天闯道观的孩子是谁。他们在找你。"
msgstr "Y otra cosa: anteanoche pasó algo en el Cerro de las Cabras. Una banda de taoístas de gorro negro subió a escondidas, se llevó a dos personas del fuerte y fue preguntando uno por uno quién era la persona joven que entró a la fuerza en el monasterio aquel día. Te buscan a ti."

msgid "执刑使管的是刀，不管衣裳。"
msgstr "El Ejecutor se ocupa de las hojas, no de la ropa."

msgid "山门"
msgstr "Puerta de la montaña"

msgid "人跑了。拿错的那一个，我赔过礼了。"
msgstr "Se escapó. Al que atrapé por error, ya le pedí disculpas."

msgid "水烟阁的门，一年到头有人来打听盟主。这一回跑掉的，下回还会来——下回你认得他。"
msgstr "A la puerta del Pabellón de la Neblina viene gente todo el año preguntando por el Líder de la Alianza. El que se escapó esta vez volverá, y la próxima vez lo reconocerás."

msgid "眼力差了一点，胆子不差。你守过一回山门了——从今日起，你是这一辈的大弟子。"
msgstr "Te falló un poco la vista, pero no el valor. Ya has guardado una vez la puerta de la montaña: desde hoy eres el discípulo mayor de esta generación."

msgid "人拿下了？他身上掉出来的信，给我看看。"
msgstr "¿Lo atrapaste? La carta que se le cayó del cuerpo, déjame verla."

msgid "人拿下了。身上的东西没捡着？……罢了，人押在刑堂里，我自己问。"
msgstr "Lo atrapaste. ¿No recogiste lo que llevaba encima? ...Da igual, el hombre está en la sala de castigos y lo interrogaré yo mismo."

msgid "你守过一回山门了——从今日起，你是这一辈的大弟子。"
msgstr "Ya has guardado una vez la puerta de la montaña: desde hoy eres el discípulo mayor de esta generación."

msgid "人认出来了，还没拿下？去，别让他下了山。"
msgstr "¿Lo reconociste y aún no lo has atrapado? Ve, que no baje de la montaña."

msgid "三个上山的人在阁前候着。问清来意，听他们怎么说盟主，看看路引——哪个不对，拿下。"
msgstr "Tres personas que subieron a la montaña esperan frente al pabellón. Averigua a qué vienen, escucha qué dicen del Líder de la Alianza, mira sus salvoconductos; el que no cuadre, apresado."

msgid "把手里的卷宗一合，冲你招了招手。"
msgstr " cierra el expediente que tiene en las manos y te hace una seña con la mano."

msgid "可这一个月，阁里丢了两份名帖，山下的客栈里也有人在打听——盟主还活着没有。"
msgstr "Pero este mes el pabellón ha perdido dos tarjetas de presentación, y en la posada al pie de la montaña alguien anda preguntando si el Líder de la Alianza sigue vivo."

msgid "我认得的人太多，往门口一站，探子就不开口了。你是新面孔。去山门值一班：上山的人问清来意，哪个不对，拿下。"
msgstr "Conozco a demasiada gente: si me planto en la puerta, el espía no abre la boca. Tú eres una cara nueva. Ve a hacer una guardia en la puerta de la montaña: averigua a qué viene cada uno que sube, y el que no cuadre, apresado."

msgid "拿错了人不要紧，我去赔礼。只是真的那个，就跑了。"
msgstr "Apresar a la persona equivocada no importa; yo iré a pedir disculpas. Lo malo es que el de verdad se escape."

msgid "山门有武士守着。执法使的事，不劳外人。"
msgstr "La puerta de la montaña tiene guardianes. Los asuntos del Ejecutor no son cosa de extraños."

msgid "镖单"
msgstr "Registro de escolta"

msgid "镖单在刑堂里锁着。振远的脸面，水烟阁替他们留着。"
msgstr "El registro de escolta está encerrado en la sala de castigos. El Pabellón de la Neblina les guarda a los del Largo Camino la cara."

msgid "交给陈总镖头了？……也好。他要查，就让他查到底。"
msgstr "¿Se lo diste al Escolta Mayor Chen? ...Mejor así. Si quiere investigar, que investigue hasta el fondo."

msgid "手令丢了？我再写一张。"
msgstr "¿Perdiste la orden? Te escribo otra."

msgid "镖单在你手里。给我锁进刑堂，还是带去京师给陈天星——你定。"
msgstr "El registro de escolta está en tus manos. Dámelo y lo encierro en la sala de castigos, o llévaselo a Chen Tianxing a la Capital: tú decides."

msgid "拿着手令去绮云镇的振远镖局，找陈剑秋。"
msgstr "Lleva la orden a los Escoltas del Largo Camino de Tejenubes y busca a Chen Jianqiu."

msgid "镖单不在你身上？去绮云镇问陈剑秋，振远的底账里还有存根。"
msgstr "¿El registro no lo llevas encima? Ve a Tejenubes y pregunta a Chen Jianqiu: en los libros de cuentas del Largo Camino aún queda un talón."

msgid "还有一件旧事。二十年前振远镖局替水烟阁押过一趟镖：盟主印一方，密件一匣，在老松岭丢了，一个人也没回来。"
msgstr "Hay otro asunto viejo. Hace veinte años los Escoltas del Largo Camino hicieron una escolta para el Pabellón de la Neblina: un sello de Líder de la Alianza y una caja de documentos secretos; se perdieron en el Cerro de los Pinos Viejos y no volvió ni un hombre."

msgid "那张镖单还在振远手里。我写张手令，你去绮云镇找陈剑秋——他见了我的印，会拿出来。"
msgstr "El registro de escolta sigue en manos del Largo Camino. Te escribo una orden; ve a Tejenubes y busca a Chen Jianqiu: cuando vea mi sello, lo sacará."

msgid "拿到了，镖单该放在哪儿，你再定。"
msgstr "Cuando lo tengas, decidirás tú dónde debe ir el registro."

msgid "还有一件旧事。二十年前振远镖局替水烟阁押过一趟镖：盟主印一方，密件一匣，在老松岭丢了。那张镖单，陈剑秋给过你。"
msgstr "Hay otro asunto viejo. Hace veinte años los Escoltas del Largo Camino hicieron una escolta para el Pabellón de la Neblina: un sello de Líder de la Alianza y una caja de documentos secretos, perdidos en el Cerro de los Pinos Viejos. Ese registro de escolta, Chen Jianqiu ya te lo dio."

msgid "镖单给我，我锁进刑堂：振远的脸面，水烟阁替他们留着，这件事到此为止。"
msgstr "Dame el registro y lo encierro en la sala de castigos: el Pabellón de la Neblina les guarda la cara a los del Largo Camino, y el asunto termina aquí."

msgid "陈天星不会这么想。京师的振远总局是他一手创的，他要知道当年那条路是谁点的。你把镖单带去给他，他会查到底——查出来的，未必只是振远的丑事。"
msgstr "Chen Tianxing no lo verá así. La Sede del Largo Camino de la Capital la fundó él con sus propias manos, y querrá saber quién marcó aquel camino. Si le llevas el registro, investigará hasta el fondo; y lo que saque a la luz quizá no sea solo una vergüenza del Largo Camino."

msgid "镖单只有一张。你定。"
msgstr "Solo hay un registro. Tú decides."
