msgid "{item}对你而言太重了，掉在你的脚边。"
msgstr "No puedes con {item}{:0}: cae a tus pies."

msgid "这里没有这个人。"
msgstr "Aquí no hay nadie así."

msgid "这样东西不能随便给人。"
msgstr "Esto no se puede regalar así como así."

msgid "你拿出{item}给{npc}。"
msgstr "Le tiendes {item}{:el} a {npc}{:el}."

msgid "你给{npc}{item}。"
msgstr "Le das {item}{:el} a {npc}{:el}."

msgid "{item}对{holder}而言太重了。"
