msgstr "{skill}: {line}"

msgid "空识神通要耗去 {gin} 点精，你现在撑不住，会当场昏过去。\n确定要施展吗？"
msgstr "El Sentido del vacío cuesta {gin} de Esencia; ahora no lo aguantarías y te desmayarías en el acto.\n¿Seguro que quieres usarlo?"

msgid "游识神通要耗去 {gin} 点精，你现在撑不住，施展完就会昏过去。\n确定要施展吗？"
msgstr "El Sentido errante cuesta {gin} de Esencia; ahora no lo aguantas y te desmayarás al terminar.\n¿Seguro que quieres usarlo?"

msgid "施展{spell}要耗去 {sen} 点神，你现在撑不住，施展完就会昏过去。\n确定要施展吗？"
msgstr "Usar {spell} cuesta {sen} de Espíritu; ahora no lo aguantas y te desmayarás al terminar.\n¿Seguro que quieres usarlo?"

msgid "请确认"
msgstr "Confirmar"

