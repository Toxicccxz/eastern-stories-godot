msgid "歇到回满"
msgstr "全快まで休む"

msgid "找个地方坐下歇着，让时间走起来：精、气、神慢慢回满就起身。世界照常运转，有人来袭会把你惊起。"
msgstr "腰を下ろして休み、時を進めます。精・気・神が満ちたら立ち上がります。その間も世の中は動いていて、誰かに襲われれば飛び起きます。"

msgid "你找个地方坐下，歇一歇。"
msgstr "適当な場所に腰を下ろし、ひと休みする。"

msgid "身上的限时差事照样计时：歇得越久，剩下的时辰越少。"
msgstr "期限付きの頼み事も、時間はそのまま進みます。長く休むほど、残りの時間は減っていきます。"

msgid "歇息中……已歇{time}"
msgstr "休息中……{time}経過"

msgid "起身"
msgstr "立ち上がる"

msgid "正在打斗，歇不下来。"
msgstr "戦っている最中で、休めない。"

msgid "你精神饱满，用不着歇。"
msgstr "気力は十分で、休む必要はない。"

msgid "你口干舌燥，歇着也回不过精神来：先找水喝。"
msgstr "喉がからからで、休んでも元気が戻らない。まず水を飲もう。"

msgid "现在歇不下来。"
msgstr "今は休めない。"

msgid "你歇了{time}，精、气、神都回满了。"
msgstr "{time}休んだ。精・気・神がすべて満ちた。"

msgid "你歇了{time}，起身活动活动。精、气、神还没全回满：伤要慢慢养，金疮药和运功疗伤快得多。"
msgstr "{time}休み、立ち上がって体をほぐした。精・気・神はまだ満ちきっていない。傷はゆっくりとしか癒えない。金創薬や運功での治療のほうがずっと早い。"

msgid "你歇了{time}，站了起来。"
msgstr "{time}休み、立ち上がった。"

msgid "你歇了{time}，忽然有人来袭，你一跃而起！"
msgstr "{time}休んだところで、不意に誰かが襲ってきた。とっさに跳ね起きる！"

msgid "你歇了{time}，身上一阵难受，歇不下去了。"
msgstr "{time}休んだが、体に不快感が走り、休んでいられなくなった。"

msgid "你歇了{time}，口干舌燥，再歇也回不过来：先找水喝。"
msgstr "{time}休んだが、喉がからからで、これ以上休んでも回復しない。まず水を飲もう。"

msgid "你歇了{time}，听见动静，站了起来。"
msgstr "{time}休んだところで物音が聞こえ、立ち上がった。"

msgid "你歇了{time}。"
msgstr "{time}休んだ。"

msgid "快"
msgstr "速"

msgid "重"
msgstr "重"

msgid "虚"
msgstr "虚"

msgid "守"
msgstr "守"

msgid "平"
msgstr "平"

msgid "快：命中高、伤害低；克重招。"
msgstr "速：命中が高く、ダメージは低い。重に強い。"

msgid "重：伤害高、命中低；克守招。"
msgstr "重：ダメージが高く、命中は低い。守に強い。"

msgid "虚：对方难以招架、伤害低，打中就打断对方的蓄势；克快招。"
msgstr "虚：相手は招架しにくく、ダメージは低い。当たれば相手の溜めを断ち切る。速に強い。"

msgid "守：这一回合自己更难被打中，伤害低；克虚招。"
msgstr "守：このラウンドは自分が当たりにくくなるが、ダメージは低い。虚に強い。"

msgid "平：没有偏向。"
msgstr "平：偏りなし。"

msgid "隙"
msgstr "隙"

msgid "压"
msgstr "圧"

msgid "连"
msgstr "連"

msgid "对方打空得 1 手"
msgstr "相手の空振りで1手"

msgid "近身打中得 1 手"
msgstr "近間で当てて1手"

msgid "换招连打得 1 手"
msgstr "技を替えた連打で1手"

msgid "够不着"
msgstr "届かない"

msgid "攻"
msgstr "攻"

msgid "游走"
msgstr "遊撃"

msgid "攻：伤害高，闪躲、招架低；有内功时加力到上限的一半。"
msgstr "攻：ダメージが高く、回避と招架は低い。内功があれば、加力が上限の半分まで上がる。"

msgid "守：招架高，伤害低。"
msgstr "守：招架が高く、ダメージは低い。"

msgid "游走：闪躲高，命中低。"
msgstr "遊撃：回避が高く、命中は低い。"

msgid "稳赢"
msgstr "楽勝"

msgid "占优"
msgstr "優勢"

msgid "五五开"
msgstr "五分"

msgid "吃亏"
msgstr "劣勢"

msgid "必败"
msgstr "必敗"

msgid "稳赢：{pronoun}远不是你的对手。"
msgstr "楽勝：{pronoun}はあなたの敵ではない。"

msgid "占优：你比{pronoun}强一些。"
msgstr "優勢：あなたのほうが{pronoun}より少し強い。"

msgid "五五开：{pronoun}和你不相上下。"
msgstr "五分：{pronoun}とあなたは互角だ。"

msgid "吃亏：{pronoun}比你强，打起来要吃亏。"
msgstr "劣勢：{pronoun}はあなたより強く、戦えば分が悪い。"

msgid "必败：{pronoun}远比你强，别打。"
msgstr "必敗：{pronoun}はあなたよりはるかに強い。戦わないほうがいい。"

msgid "{pronoun}这边有 {count} 个人一起上。"
msgstr "{pronoun}の側は{count}人がかりで来る。"

msgid "{pronoun}的闪躲比你高得多，你很难打中。"
msgstr "{pronoun}は回避があなたよりはるかに高く、なかなか当たらない。"

msgid "{pronoun}有兵刃在手，你空手难以近身。"
msgstr "{pronoun}は武器を手にしている。素手では懐に入りにくい。"

msgid "{pronoun}的经验比你多得多，你的拳脚落不实。"
msgstr "{pronoun}は経験があなたよりはるかに豊富で、拳脚がまともに入らない。"

msgid "{pronoun}下手太重，你撑不了几回合。"
msgstr "{pronoun}の攻撃は重すぎて、何合ももたない。"

msgid "你有兵刃在手，{pronoun}空手挡不住。"
msgstr "あなたは武器を手にしている。{pronoun}の素手では防ぎきれない。"

msgid "切磋稳赢：{pronoun}的招式你一眼看穿。"
msgstr "手合わせ・楽勝：{pronoun}の技は一目で見切れる。"

msgid "切磋占优：你多半先打中{pronoun}。"
msgstr "手合わせ・優勢：たいていはあなたが先に当てる。"

msgid "切磋五五开：谁先打中谁赢。"
msgstr "手合わせ・五分：先に当てたほうが勝つ。"

msgid "切磋吃亏：{pronoun}多半先打中你。"
msgstr "手合わせ・劣勢：たいていは{pronoun}が先に当てる。"

msgid "切磋必输：{pronoun}的招式你接不住。"
msgstr "手合わせ・必敗：{pronoun}の技は受けきれない。"

msgid "{name}打了个隔，不过依然烂醉如泥。"
msgstr "{name}はしゃっくりをしたが、相変わらず泥酔している。"

msgid "你觉得脑中昏昏沉沉，身子轻飘飘地，大概是醉了。"
msgstr "頭がぼんやりとして、体がふわふわする。どうやら酔ったらしい。"

msgid "{name}摇头晃脑地站都站不稳，显然是喝醉了。"
msgstr "{name}は頭をふらつかせ、まともに立っていられない。すっかり酔っているようだ。"

msgid "你觉得一阵酒意上冲，眼皮有些沉重了。"
msgstr "酔いがぐっと回ってきて、まぶたが少し重くなった。"

msgid "{name}脸上已经略显酒意了。"
msgstr "{name}の顔には、もうほんのりと酔いが出ている。"

msgid "你中的意寒掌毒发作了！"
msgstr "意寒掌の毒が回った！"

msgid "意寒掌毒"
msgstr "意寒掌の毒"

msgid "你中的火玫瑰毒发作了！"
msgstr "火薔薇の毒が回った！"

msgid "火玫瑰毒"
msgstr "火薔薇の毒"

msgid "你觉得脑中昏昏沉沉，心中空荡荡的，直想躺下来睡一觉。"
msgstr "頭がぼんやりとして心がからっぽになり、ただ横になって眠りたくなる。"

msgid "{name}摇头晃脑地站都站不稳，显然是蒙汗药的药力发作了。"
msgstr "{name}は頭をふらつかせ、まともに立っていられない。しびれ薬が効いてきたようだ。"

msgid "你中的蛇毒发作了！"
msgstr "蛇の毒が回った！"

msgid "蛇毒"
msgstr "蛇毒"

msgid "{name}({id})。\n"
msgstr "{name}（{id}）。\n"

msgid "僵尸追魂符（{name}）"
msgstr "キョンシー追魂符（{name}）"

msgid "断掉的{weapon}"
msgstr "折れた{weapon}"

msgid "歇到回满's pace and longest rest must not be negative"
msgstr "「全快まで休む」の速さと最長の休息は負の値にできません"

msgid "a run that rests by itself needs 歇到回满 (rest_world_scale)"
msgstr "自分で休む連続動作には「全快まで休む」（rest_world_scale）が必要です"

msgid "恭喜你！你又完成了一项任务！"
msgstr "おめでとうございます！ また任務を一つ果たしました！"

msgid "你被奖励了：\n{exp}点实战经验\n{pot}点潜能\n{score}点综合评价"
msgstr "報酬を得た：\n実戦経験 {exp}点\n潜在力 {pot}点\n総合評価 {score}点"

msgid "你亲手杀了自己的师父，被逐出了{family}！"
msgstr "自らの手で師父を殺し、{family}を破門された！"

msgid "弑师等同背叛师门：综合评价清零，背叛师门的次数变成 {count} 次。"
msgstr "師を殺すことは師門に背くのと同じです。総合評価は0になり、師門に背いた回数は{count}回になりました。"

msgid "「意寒睨」之术只能在战斗中使用。"
msgstr "『意寒睨』の術は戦闘中にしか使えない。"

msgid "你的内力不够。"
msgstr "内力が足りない。"

msgid "你要对谁施展「意寒睨」之术？"
msgstr "誰に『意寒睨』の術をかける？"

msgid "$N眼神忽然发出异光，双瞳犹如两把利刃般盯著$n！"
msgstr "$Nの目が不意に異様な光を放ち、二つの瞳が刃のように$nを射すくめる！"

msgid "$N很快地转过头去，避开了$n的目光。"
msgstr "$Nはさっと顔をそむけ、$nの視線を避けた。"

msgid "但是$N对$n的注视视若无睹....。"
msgstr "だが$Nは$nの視線を意にも介さない……。"

msgid "$N被$n的目光所摄，不自禁地打了个寒噤。"
msgstr "$Nは$nの眼光に気圧され、思わず身震いした。"

msgid "$N闭目凝神，用谷衣心法的内力运转了一次「灵神诀」..."
msgstr "$Nは目を閉じて心を静め、『谷衣心法』の内力で『霊神訣』を一巡りさせた……"

msgid "一股青气从$N身上散出，汇聚在$P的顶心，然後缓缓淡去。"
msgstr "青い気が$Nの体から立ちのぼって$Pの頭頂に集まり、やがてゆっくりと薄れていった。"

msgid "你必须先 enable 一种内功。"
msgstr "まず使う内功を一つ選ばなければならない。"

msgid "你只能用 none 表示不运内力，或数字表示每一击用几点内力。"
msgstr "内力を使わないなら none、一撃ごとに使う内力の量なら数字で指定する。"

msgid "疗伤"
msgstr "治療"

msgid "疗伤他人"
msgstr "他人を治療"

msgid "灵神诀"
msgstr "霊神訣"

msgid "恢复气"
msgstr "気を回復"

msgid "恢复神"
msgstr "神を回復"

msgid "恢复精"
msgstr "精を回復"

msgid "提升战斗力"
msgstr "戦闘力を高める"

msgid "压制杀气"
msgstr "殺気を抑える"

msgid "天邪虎啸"
msgstr "天邪虎嘯"

msgid "意寒睨"
msgstr "意寒睨"

msgid "你的气已经恢复到上限了。"
msgstr "気はもう上限まで回復している。"

msgid "$N深深吸了几口气，脸色看起来好多了。"
msgstr "$Nは何度か深く息を吸った。顔色がずいぶんよくなったようだ。"

msgid "你的神已经恢复到上限了。"
msgstr "神はもう上限まで回復している。"

msgid "$N微一凝神，缓缓地吸了口气，看起来有精神多了。"
msgstr "$Nはわずかに心を凝らし、ゆっくりと息を吸った。ずいぶん気力が戻ったようだ。"

msgid "你的精力已经恢复到上限了。"
msgstr "精はもう上限まで回復している。"

msgid "$N深深地吸了口气，手脚活动了几下，看起来有活力多了。"
msgstr "$Nは深く息を吸い、手足を軽く動かした。ずいぶん活力が戻ったようだ。"

msgid "( 你上一个动作还没有完成，不能施用内功。)"
msgstr "（まだ前の動作が終わっていないので、内功は使えない。）"

msgid "你请先用 enable 指令选择你要使用的内功。"
msgstr "まず使う内功を選ばなければならない。"

msgid "你所学的内功中没有这种功能。"
msgstr "学んだ内功には、そのような働きはない。"

msgid "战斗中运功疗伤？找死吗？"
msgstr "戦闘中に運功で治療？ 死にたいのか？"

msgid "你的真气不够。"
msgstr "真気が足りない。"

msgid "你已经受伤过重，只怕一运真气便有生命危险！"
msgstr "傷が深すぎる。真気を巡らせたとたん、命が危うくなりかねない！"

msgid "你全身放松，坐下来开始运功疗伤。"
msgstr "全身の力を抜いて腰を下ろし、運功で傷を癒やしはじめた。"

msgid "$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内...."
msgstr "$Nは腰を下ろして内功を巡らせ、$nの背に掌を当てて、ゆっくりと真気を$nの体内へ送り込む……"

msgid "过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。"
msgstr "しばらくすると$Nの額に玉のような汗が浮かび、$nはどす黒い血をひと口吐いた。顔色にずいぶん赤みが差してきた。"

msgid "你要用真气为谁疗伤？"
msgstr "誰を真気で治療する？"

msgid "战斗中无法运功疗伤！"
msgstr "戦闘中は運功で治療できない！"

msgid "{name}已经受伤过重，经受不起你的真气震荡！"
msgstr "{name}は傷が深すぎて、あなたの真気の衝撃に耐えられない！"

msgid "你已经在运功中了。"
msgstr "すでに運功している。"

msgid "你现在毫无杀气。"
msgstr "今は殺気がまったくない。"

msgid "$N微一凝神，运起天邪神功，放慢呼吸，开始收敛自己的杀气 ...."
msgstr "$Nはわずかに心を凝らして『天邪神功』を巡らせ、呼吸をゆるめて、自らの殺気を収めはじめた……"

msgid "$N微一凝神，运起天邪神功，全身骨节发出一阵爆豆般的声响！"
msgstr "$Nはわずかに心を凝らして『天邪神功』を巡らせた。全身の関節が豆のはじけるような音を立てる！"

msgid "天邪虎啸只能在战斗中使用。"
msgstr "天邪虎嘯は戦闘中にしか使えない。"

msgid "$N深深地吸一口气，开始发出有如猛虎般的啸声！"
msgstr "$Nは深く息を吸い込み、猛虎のような咆哮を上げはじめた！"

msgid "吃"
msgstr "食べる"

msgid "使用"
msgstr "使う"

msgid "你没有中蛇毒。"
msgstr "蛇の毒には冒されていない。"

msgid "但是你中的蛇毒并没有完全清除。"
msgstr "だが、蛇の毒はまだ抜けきっていない。"

msgid "你终于清除了体内所有的蛇毒！"
msgstr "ついに体内の蛇の毒がすべて抜けた！"

msgid "你服下蛇药，顿时感觉好多了。{after}"
msgstr "蛇毒消しを飲むと、たちまち楽になった。{after}"

msgid "体内的蛇毒还剩 {left} 分：每服一剂解去一分，每次毒发也会消退一分。"
msgstr "体内の蛇の毒は残り{left}。一服ごとに1減り、毒が回るたびにも1減ります。"

msgid "战斗中不能用药治伤!"
msgstr "戦闘中に薬で傷の手当てはできない！"

msgid "你没有受伤啊?"
msgstr "傷は負っていないが？"

msgid "你敷上金疮药 ."
msgstr "金創薬を塗った。"

msgid "你拿出一朵小花蕊，一口给吞了下去。"
msgstr "小さな花蕊を一つ取り出し、ひと口で飲み込んだ。"

msgid "只见你脸上泛起一阵红晕，整个人看起来好多了!"
msgstr "顔がぽっと赤らみ、すっかり元気になったようだ！"

msgid "你拿出一粒仙丹，纳入口中. 吃的太急, 鼻涕眼泪流了满脸.."
msgstr "仙丹を一粒取り出して口に含んだ。あわてて飲んだせいで、鼻水と涙で顔じゅうがぐしゃぐしゃになった……"

msgid "红酒"
msgstr "紅酒"

msgid "清水"
msgstr "清水"

msgid "你向{npc}请教有关「{skill}」的疑问。"
msgstr "{npc}に『{skill}』について教えを請うた。"

msgid "临阵磨枪？来不及啦。"
msgstr "今さら泥縄か？ もう間に合わない。"

msgid "你要向谁求教？"
msgstr "誰に教えを請う？"

msgid "嗯....你得先把%s弄醒再说。"
msgstr "うーん……まず%sを起こさないと。"

msgid "这项技能你恐怕必须找别人学了。"
msgstr "この技能は、ほかの誰かに習うしかなさそうだ。"

msgid "%s神色间似乎对你不是十分信任，也许是想起你从前背叛师门的事情 ...。"
msgstr "%sはどうもあまり信用してくれていないようだ。かつて師門に背いたことを思い出しているのかもしれない……。"

msgid "%s说道：嗯 .... 师父能教你的都教了，其他的你自己练吧。"
msgstr "%s「うむ……師父として教えられることは、すべて教えた。あとは自分で鍛えるといい」"

msgid "%s说道：虽然你是我门下的弟子，可是并非我的嫡传弟子 ...."
msgstr "%s「門下の弟子ではあるが、私の直弟子ではない……」"

msgid "%s说道：我只能教你这些粗浅的本门功夫，其他的还是去找你师父学吧。"
msgstr "%s「私が教えられるのは、この門の初歩の功夫だけだ。あとは自分の師父に習うといい」"

msgid "%s不愿意教你这项技能。"
msgstr "%sはこの技能を教えてくれない。"

msgid "这项技能你的程度已经不输你师父了。"
msgstr "この技能については、もう師父に引けを取らない。"

msgid "依你目前的能力，没有办法学习这种技能。"
msgstr "今の力では、この技能を学ぶことはできない。"

msgid "%s说道：%s"
msgstr "%s「%s」"

msgid "你的潜能已经发挥到极限了，没有办法再成长了。"
msgstr "潜在力はもう限界まで引き出した。これ以上は伸びない。"

msgid "但是%s现在并不准备回答你的问题。"
msgstr "だが、%sは今、問いに答える気がないようだ。"

msgid "但是%s显然太累了，没有办法教你什麽。"
msgstr "だが、%sは見るからに疲れきっていて、何も教えられそうにない。"

msgid "你向%s请教，但这次请教无法进行。"
msgstr "%sに教えを請うたが、今回は教えを受けられなかった。"

msgid "也许是缺乏实战经验，你对%s的回答总是无法领会。"
msgstr "実戦経験が足りないせいか、%sの答えがどうにも呑み込めない。"

msgid "你今天太累了，结果什麽也没有学到。"
msgstr "今日は疲れすぎていて、結局何も身につかなかった。"

msgid "你听了%s的指导，似乎有些心得。"
msgstr "%sの指導を聞いて、何かつかめた気がする。"

msgid "还能学到 {level} 级（{why}）"
msgstr "レベル{level}まで学べる（{why}）"

msgid "学不了：{why}"
msgstr "学べない：{why}"

msgid "{head}。"
msgstr "{head}。"

msgid "{head}；{problem}。"
msgstr "{head}。{problem}。"

msgid "{npc}自己是 {teacher} 级"
msgstr "{npc}自身がレベル{teacher}"

msgid "你已学到{npc}的 {teacher} 级"
msgstr "{npc}のレベル{teacher}まで学びきった"

msgid "背叛师门 {count} 次，{npc}只教到 {teacher} - 20×{count} = {cap} 级"
msgstr "師門に背いた回数{count}回、{npc}が教えるのはレベル{teacher} - 20×{count} = {cap}まで"

msgid "不是{npc}的嫡传弟子，只学得到{npc}等级（{teacher}）的三分之一左右"
msgstr "{npc}の直弟子ではないので、{npc}のレベル（{teacher}）の三分の一ほどまでしか学べない"

msgid "背叛师门 {count} 次，{npc}能教你的都教了"
msgstr "師門に背いた回数{count}回、{npc}が教えてくれることはもうない"

msgid "{level} 级要再学，须实战经验 ≥ {required}"
msgstr "レベル{level}から先へ学ぶには実戦経験 ≥ {required}が必要"

msgid "经验不足，要再学须实战经验 ≥ {required}（你 {have}）"
msgstr "経験不足：先へ学ぶには実戦経験 ≥ {required}が必要（現在 {have}）"

msgid "学不了：{npc}不肯指点你。"
msgstr "学べない：{npc}が教えてくれない。"

msgid "潜能已经用完"
msgstr "潜在力を使い果たした"

msgid "{npc}太累了"
msgstr "{npc}が疲れきっている"

msgid "{npc}现在不答问题"
