msgstr "{name}（{id}）。\n"

msgid "僵尸追魂符（{name}）"
msgstr "キョンシー追魂符（{name}）"

msgid "断掉的{weapon}"
msgstr "折れた{weapon}"

msgid "歇到回满's pace and longest rest must not be negative"
msgstr "「全快まで休む」の速さと最長の休息は負の値にできません"

msgid "a run that rests by itself needs 歇到回满 (rest_world_scale)"
msgstr "自分で休む連続動作には「全快まで休む」（rest_world_scale）が必要です"

msgid "恭喜你！你又完成了一项任务！"
msgstr "おめでとうございます！ また任務を一つ果たしました！"

msgid "你被奖励了：\n{exp}点实战经验\n{pot}点潜能\n{score}点综合评价"
msgstr "報酬を得た：\n実戦経験 {exp}点\n潜在力 {pot}点\n総合評価 {score}点"

msgid "你亲手杀了自己的师父，被逐出了{family}！"
msgstr "自らの手で師父を殺し、{family}を破門された！"

msgid "弑师等同背叛师门：综合评价清零，背叛师门的次数变成 {count} 次。"
msgstr "師を殺すことは師門に背くのと同じです。総合評価は0になり、師門に背いた回数は{count}回になりました。"

msgid "「意寒睨」之术只能在战斗中使用。"
msgstr "『意寒睨』の術は戦闘中にしか使えない。"

msgid "你的内力不够。"
msgstr "内力が足りない。"

msgid "你要对谁施展「意寒睨」之术？"
msgstr "誰に『意寒睨』の術をかける？"

msgid "$N眼神忽然发出异光，双瞳犹如两把利刃般盯著$n！"
msgstr "$Nの目が不意に異様な光を放ち、二つの瞳が刃のように$nを射すくめる！"

msgid "$N很快地转过头去，避开了$n的目光。"
msgstr "$Nはさっと顔をそむけ、$nの視線を避けた。"

msgid "但是$N对$n的注视视若无睹....。"
msgstr "だが$Nは$nの視線を意にも介さない……。"

msgid "$N被$n的目光所摄，不自禁地打了个寒噤。"
msgstr "$Nは$nの眼光に気圧され、思わず身震いした。"

msgid "$N闭目凝神，用谷衣心法的内力运转了一次「灵神诀」..."
msgstr "$Nは目を閉じて心を静め、谷衣心法の内力で『霊神訣』を一巡りさせた……"

msgid "一股青气从$N身上散出，汇聚在$P的顶心，然後缓缓淡去。"
msgstr "青い気が$Nの体から立ちのぼって$Pの頭頂に集まり、やがてゆっくりと薄れていった。"

msgid "你必须先 enable 一种内功。"
msgstr "まず使う内功を一つ選ばなければならない。"

msgid "你只能用 none 表示不运内力，或数字表示每一击用几点内力。"
msgstr "内力を使わないなら none、一撃ごとに使う内力の量なら数字で指定する。"

msgid "疗伤"
msgstr "治療"

msgid "疗伤他人"
msgstr "他人を治療"

msgid "灵神诀"
msgstr "霊神訣"

msgid "恢复气"
msgstr "気を回復"

msgid "恢复神"
msgstr "神を回復"

msgid "恢复精"
msgstr "精を回復"

msgid "提升战斗力"
msgstr "戦闘力を高める"

msgid "压制杀气"
msgstr "殺気を抑える"

msgid "天邪虎啸"
msgstr "天邪虎嘯"

msgid "意寒睨"
msgstr "意寒睨"

msgid "你的气已经恢复到上限了。"
msgstr "気はもう上限まで回復している。"

msgid "$N深深吸了几口气，脸色看起来好多了。"
msgstr "$Nは何度か深く息を吸った。顔色がずいぶんよくなったようだ。"

msgid "你的神已经恢复到上限了。"
msgstr "神はもう上限まで回復している。"

msgid "$N微一凝神，缓缓地吸了口气，看起来有精神多了。"
msgstr "$Nはわずかに心を凝らし、ゆっくりと息を吸った。ずいぶん気力が戻ったようだ。"

msgid "你的精力已经恢复到上限了。"
msgstr "精はもう上限まで回復している。"

msgid "$N深深地吸了口气，手脚活动了几下，看起来有活力多了。"
msgstr "$Nは深く息を吸い、手足を軽く動かした。ずいぶん活力が戻ったようだ。"

msgid "( 你上一个动作还没有完成，不能施用内功。)"
msgstr "（まだ前の動作が終わっていないので、内功は使えない。）"

msgid "你请先用 enable 指令选择你要使用的内功。"
msgstr "まず使う内功を選ばなければならない。"

msgid "你所学的内功中没有这种功能。"
msgstr "学んだ内功には、そのような働きはない。"

msgid "战斗中运功疗伤？找死吗？"
msgstr "戦闘中に運功で治療？ 死にたいのか？"

msgid "你的真气不够。"
msgstr "真気が足りない。"

msgid "你已经受伤过重，只怕一运真气便有生命危险！"
msgstr "傷が深すぎる。真気を巡らせたとたん、命が危うくなりかねない！"

msgid "你全身放松，坐下来开始运功疗伤。"
msgstr "全身の力を抜いて腰を下ろし、運功で傷を癒やしはじめた。"

msgid "$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内...."
msgstr "$Nは腰を下ろして内功を巡らせ、$nの背に掌を当てて、ゆっくりと真気を$nの体内へ送り込む……"

msgid "过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。"
msgstr "しばらくすると$Nの額に玉のような汗が浮かび、$nはどす黒い血をひと口吐いた。顔色にずいぶん赤みが差してきた。"

msgid "你要用真气为谁疗伤？"
msgstr "誰を真気で治療する？"

msgid "战斗中无法运功疗伤！"
msgstr "戦闘中は運功で治療できない！"

msgid "{name}已经受伤过重，经受不起你的真气震荡！"
msgstr "{name}は傷が深すぎて、あなたの真気の衝撃に耐えられない！"

msgid "你已经在运功中了。"
msgstr "すでに運功している。"

msgid "你现在毫无杀气。"
msgstr "今は殺気がまったくない。"

msgid "$N微一凝神，运起天邪神功，放慢呼吸，开始收敛自己的杀气 ...."
msgstr "$Nはわずかに心を凝らして天邪神功を巡らせ、呼吸をゆるめて、自らの殺気を収めはじめた……"

msgid "$N微一凝神，运起天邪神功，全身骨节发出一阵爆豆般的声响！"
msgstr "$Nはわずかに心を凝らして天邪神功を巡らせた。全身の関節が豆のはじけるような音を立てる！"

msgid "天邪虎啸只能在战斗中使用。"
msgstr "天邪虎嘯は戦闘中にしか使えない。"

msgid "$N深深地吸一口气，开始发出有如猛虎般的啸声！"
msgstr "$Nは深く息を吸い込み、猛虎のような咆哮を上げはじめた！"

msgid "吃"
msgstr "食べる"

msgid "使用"
msgstr "使う"

msgid "你没有中蛇毒。"
msgstr "蛇の毒には冒されていない。"

msgid "但是你中的蛇毒并没有完全清除。"
msgstr "だが、蛇の毒はまだ抜けきっていない。"

msgid "你终于清除了体内所有的蛇毒！"
msgstr "ついに体内の蛇の毒がすべて抜けた！"

msgid "你服下蛇药，顿时感觉好多了。{after}"
msgstr "蛇毒消しを飲むと、たちまち楽になった。{after}"

msgid "体内的蛇毒还剩 {left} 分：每服一剂解去一分，每次毒发也会消退一分。"
msgstr "体内の蛇の毒は残り{left}。一服ごとに1減り、毒が回るたびにも1減ります。"

msgid "战斗中不能用药治伤!"
msgstr "戦闘中に薬で傷の手当てはできない！"

msgid "你没有受伤啊?"
msgstr "傷は負っていないが？"

msgid "你敷上金疮药 ."
msgstr "金創薬を塗った。"

msgid "你拿出一朵小花蕊，一口给吞了下去。"
msgstr "小さな花蕊を一つ取り出し、ひと口で飲み込んだ。"

msgid "只见你脸上泛起一阵红晕，整个人看起来好多了!"
msgstr "顔がぽっと赤らみ、すっかり元気になったようだ！"

msgid "你拿出一粒仙丹，纳入口中. 吃的太急, 鼻涕眼泪流了满脸.."
msgstr "仙丹を一粒取り出して口に含んだ。あわてて飲んだせいで、鼻水と涙で顔じゅうがぐしゃぐしゃになった……"

msgid "红酒"
msgstr "紅酒"

msgid "清水"
msgstr "清水"

msgid "你向{npc}请教有关「{skill}」的疑问。"
msgstr "{npc}に『{skill}』について教えを請うた。"

msgid "临阵磨枪？来不及啦。"
msgstr "今さら泥縄か？ もう間に合わない。"

msgid "你要向谁求教？"
msgstr "誰に教えを請う？"

msgid "嗯....你得先把%s弄醒再说。"
msgstr "うーん……まず%sを起こさないと。"

msgid "这项技能你恐怕必须找别人学了。"
msgstr "この技能は、ほかの誰かに習うしかなさそうだ。"

msgid "%s神色间似乎对你不是十分信任，也许是想起你从前背叛师门的事情 ...。"
msgstr "%sはどうもあまり信用してくれていないようだ。かつて師門に背いたことを思い出しているのかもしれない……。"

msgid "%s说道：嗯 .... 师父能教你的都教了，其他的你自己练吧。"
msgstr "%s「うむ……師父として教えられることは、すべて教えた。あとは自分で鍛えるといい」"

msgid "%s说道：虽然你是我门下的弟子，可是并非我的嫡传弟子 ...."
msgstr "%s「門下の弟子ではあるが、私の直弟子ではない……」"

msgid "%s说道：我只能教你这些粗浅的本门功夫，其他的还是去找你师父学吧。"
msgstr "%s「私が教えられるのは、この門の初歩の功夫だけだ。あとは自分の師父に習うといい」"

msgid "%s不愿意教你这项技能。"
msgstr "%sはこの技能を教えてくれない。"

msgid "这项技能你的程度已经不输你师父了。"
msgstr "この技能については、もう師父に引けを取らない。"

msgid "依你目前的能力，没有办法学习这种技能。"
msgstr "今の力では、この技能を学ぶことはできない。"

msgid "%s说道：%s"
msgstr "%s「%s」"

msgid "你的潜能已经发挥到极限了，没有办法再成长了。"
msgstr "潜在力はもう限界まで引き出した。これ以上は伸びない。"

msgid "但是%s现在并不准备回答你的问题。"
msgstr "だが、%sは今、問いに答える気がないようだ。"

msgid "但是%s显然太累了，没有办法教你什麽。"
msgstr "だが、%sは見るからに疲れきっていて、何も教えられそうにない。"

msgid "你向%s请教，但这次请教无法进行。"
msgstr "%sに教えを請うたが、今回は教えを受けられなかった。"

msgid "也许是缺乏实战经验，你对%s的回答总是无法领会。"
msgstr "実戦経験が足りないせいか、%sの答えがどうにも呑み込めない。"

msgid "你今天太累了，结果什麽也没有学到。"
msgstr "今日は疲れすぎていて、結局何も身につかなかった。"

msgid "你听了%s的指导，似乎有些心得。"
msgstr "%sの指導を聞いて、何かつかめた気がする。"

msgid "还能学到 {level} 级（{why}）"
msgstr "レベル{level}まで学べる（{why}）"

msgid "学不了：{why}"
msgstr "学べない：{why}"

msgid "{head}。"
msgstr "{head}。"

msgid "{head}；{problem}。"
msgstr "{head}。{problem}。"

