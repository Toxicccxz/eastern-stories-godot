msgstr "$Nの剣筋が一変し、わざと大きく隙を見せて$nを誘い込む。"

msgid "可是$n看破了$N的企图，并没有上当。"
msgstr "だが$nは$Nのねらいを見抜き、その手には乗らなかった。"

msgid "$N突然对$n发出奋力一击！"
msgstr "$Nは不意に$nへ渾身の一撃を放った！"

msgid "「玄羽乱舞」"
msgstr "『玄羽乱舞』"

msgid "「玄羽乱舞」只能在战斗中使用。"
msgstr "『玄羽乱舞』は戦闘中にしか使えない。"

msgid "你的气不够！"
msgstr "気が足りない！"

msgid "你的真气不够！"
msgstr "真気が足りない！"

msgid "$N使出步玄七诀第一式「玄羽乱舞」，身法陡然加快！"
msgstr "$Nは歩玄七訣の第一式『玄羽乱舞』を繰り出し、身のこなしが一気に速くなった！"

msgid "$N的身形转了几转，倏地停住了脚步。"
msgstr "$Nは身をいくたびか翻し、ぴたりと足を止めた。"

msgid "$N迅捷无伦地在$n身旁绕了一圈 ..."
msgstr "$Nは目にもとまらぬ速さで$nのまわりをひと巡りする……"

msgid "但是$N找不到机会出手！"
msgstr "だが$Nは仕掛ける隙を見つけられない！"

msgid "$N眼睛忽然睁开，喃喃地说道：杀....死....$n...."
msgstr "$Nの目がかっと見開かれ、ぶつぶつとつぶやいた。「殺……す……$n……」"

msgid "你要在这张符上写谁的名字？"
msgstr "この符に誰の名を書く？"

msgid "心识神通"
msgstr "心識神通"

msgid "$N一手放在$n的天灵盖上，一手贴在$n的後心，闭上眼睛缓缓低吟 ..."
msgstr "$Nは片手を$nの頭頂に、もう片手を$nの背に当て、目を閉じてゆっくりと低く唱えはじめた……"

msgid "你要对谁使用心识神通？"
msgstr "誰に心識神通を使う？"

msgid "召护法"
msgstr "護法を召す"

msgid "只有战斗中才能召唤天将！"
msgstr "天将を召喚できるのは戦闘中だけだ！"

msgid "你的精神无法集中！"
msgstr "精神を集中できない！"

msgid "$N喃喃地念了几句咒语。"
msgstr "$Nは呪文をぶつぶつと唱えた。"

msgid "但是什麽也没有发生。"
msgstr "だが、何も起こらなかった。"

msgid "( 你上一个动作还没有完成，不能施用外功。)"
msgstr "（まだ前の動作が終わっていないので、外功は使えない。）"

msgid "你请先用 enable 指令选择你要使用的外功。"
msgstr "まず使う外功を選ばなければならない。"

msgid "你所使用的外功中没有这种功能。"
msgstr "使っている外功には、そのような働きはない。"

msgid "「点」字诀"
msgstr "『点』の字訣"

msgid "「点」字诀只能对战斗中的对手使用。"
msgstr "『点』の字訣は、戦っている相手にしか使えない。"

msgid "$N使出封山剑法「点」字诀，可是内力不继，剑尖一颤，手中的剑险些脱手飞出！"
msgstr "$Nは封山剣法『点』の字訣を繰り出したが、内力が続かず、剣先が震えて手の剣がすっぽ抜けかけた！"

msgid "$N使出封山剑法「点」字诀，劲力尽数聚在剑尖，一剑直刺$n！"
msgstr "$Nは封山剣法『点』の字訣を繰り出し、勁力のすべてを剣先に集めて、$nへまっすぐ突きかかる！"

msgid "用 {force} 点内力把劲力聚在剑尖，这一剑伤得更重；内力不够，剑会险些脱手，白白耽误几手"
msgstr "内力を{force}使って勁力を剣先に集め、この一撃の威力を上げる。内力が足りないと剣が手から抜けかけ、何手かをむだにする"

msgid "召天将"
msgstr "天将を召す"

msgid "战斗时不能画符！"
msgstr "戦闘中は符を描けない！"

msgid "你的精神太差了，无法画符。"
msgstr "神が衰えすぎていて、符を描けない。"

msgid "你所学的法术没有这种符。"
msgstr "学んだ法術に、そのような符はない。"

msgid "紫光"
msgstr "紫光"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团紫光射向$n！"
msgstr "$Nは口の中で呪文を唱えながら左手をひと振りした。手の中に紫の光の塊が集まり、$nめがけて飛んでいく！"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，拖出一条长长的七彩光气，光气绕了回转过来又从$N顶门注入$P的体内！"
msgstr "すると「しゅっ」という音とともに、紫の光が$pの体を突き抜けた。長い七色の光の尾が引かれ、それがくるりと戻ってきて、$Nの頭頂から体内へと流れ込んだ！"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，无声无息地钻入地下！"
msgstr "すると「しゅっ」という音とともに、紫の光が$pの体を突き抜け、音もなく地中へ潜り込んだ！"

msgid "白光"
msgstr "白光"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团白光射向$n！"
msgstr "$Nは口の中で呪文を唱えながら左手をひと振りした。手の中に白い光の塊が集まり、$nめがけて飛んでいく！"

msgid "结果「嗤」地一声，白光从$p身上透体而过，拖出一条长长的黑气直射到两三丈外的地下！"
msgstr "すると「しゅっ」という音とともに、白い光が$pの体を突き抜け、長い黒い気の尾を引いて、二、三丈先の地面に突き刺さった！"

msgid "结果「嗤」地一声，白光从$p身上透体而过，无声无息地钻入地下！"
msgstr "すると「しゅっ」という音とともに、白い光が$pの体を突き抜け、音もなく地中へ潜り込んだ！"

msgid "青光"
msgstr "青光"

msgid "你失败了！"
msgstr "失敗した！"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团青光射向$n！"
msgstr "$Nは口の中で呪文を唱えながら左手をひと振りした。手の中に青い光の塊が集まり、$nめがけて飛んでいく！"

msgid "结果「嗤」地一声，青光从$p身上透体而过，拖出一条长长的血箭直射到两三丈外的地下！"
msgstr "すると「しゅっ」という音とともに、青い光が$pの体を突き抜け、長い血の矢を引いて、二、三丈先の地面に突き刺さった！"

msgid "结果「嗤」地一声，青光从$p身上透体而过，无声无息地钻入地下！"
msgstr "すると「しゅっ」という音とともに、青い光が$pの体を突き抜け、音もなく地中へ潜り込んだ！"

msgid "投降？现在没有人在打你啊....？"
msgstr "降参？ 今は誰とも戦っていないが……？"

msgid "$n向$N求饶，但是$N大声说道：{rude}废话少说，纳命来！"
msgstr "$nは$Nに命乞いをしたが、$Nは大声で言った。「{rude}め、つべこべ言わずに命をよこせ！」"

msgid "$N说道：「不打了，不打了，我投降....。」"
msgstr "$N「もうやめだ、やめだ。降参する……」"

msgid "「逐」字诀"
msgstr "『逐』の字訣"

msgid "「逐」字诀只能对战斗中的对手使用。"
msgstr "『逐』の字訣は、戦っている相手にしか使えない。"

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p已显吃力。"
msgstr "$Nは封山剣法『逐』の字訣を繰り出した。剣が一段と鋭さを増して剣光が$nを覆い、$pはもう押されている。"

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p从容化解"
msgstr "$Nは封山剣法『逐』の字訣を繰り出した。剣が一段と鋭さを増して剣光が$nを覆ったが、$pは落ち着いてこれをさばいた"

msgid "空识神通"
msgstr "空識神通"

msgid "$N盘膝而座，开始运用空识神通静思入定 ..."
msgstr "$Nは足を組んで座り、空識神通で静かに瞑想に入った……"

msgid "空识神通只能对自己使用。"
msgstr "空識神通は自分にしか使えない。"

msgid "你觉得脑中一片混乱，你的潜能降低了！"
msgstr "頭の中がかき乱され、潜在力が下がった！"

msgid "你的潜能提高了！"
msgstr "潜在力が上がった！"

msgid "可是你只觉得一无所获。"
msgstr "だが、何も得られなかった。"

