msgstr "「パキン」という音とともに、{who}の手の{weapon}が真っ二つに折れた！"

msgid "{me}的{weapon}和{who}的{other}相击，冒出点点的火星。"
msgstr "{me}の{weapon}と{who}の{other}がぶつかり合い、火花が散った。"

msgid "%s脚下一个不稳，跌在地上一动也不动了。"
msgstr "%sは足をもつれさせて倒れ、そのまま動かなくなった。"

msgid "{who}用指甲挑了一点化尸粉在{corpse}上，只听见一阵「嗤嗤」声响带著一股可怕的恶臭，{corpse}只剩下一滩黄水。"
msgstr "{who}は爪の先で化屍粉を少しすくい、{corpse}にかけた。「ジュウジュウ」という音とともにおぞましい悪臭が立ちこめ、{corpse}は黄色い水たまりになった。"

msgid "这副骸骨已经躺在这里很久了。"
msgstr "この骸骨は、ずいぶん長いあいだここに横たわっている。"

msgid "这具尸体显然已经躺在这里有一段时间了，正散发著一股腐尸的味道。"
msgstr "この死体はここに横たわってしばらく経つらしく、腐臭を放っている。"

msgid "一阵风吹过，把{name}化成骨灰吹散了。"
msgstr "風が吹き抜け、{name}は灰となって散った。"

msgid "{name}开始腐烂了，发出一股难闻的恶臭。"
msgstr "{name}が腐りはじめ、ひどい悪臭を放っている。"

msgid "{name}被风吹乾了，变成一具骸骨。"
msgstr "{name}は風に干からび、骸骨になった。"

msgid "你没有足够的零钱，而对方也找不开...。"
msgstr "小銭が足りないうえ、相手もお釣りを出せない……。"

msgid "你的钱不够。"
msgstr "お金が足りない。"

msgid "这笔钱凑不整：对方找不开，你也没有合适的零钱。先去钱庄换些碎银或铜钱再来。"
msgstr "この金額はちょうどには払えません。相手はお釣りが出せず、こちらにも合う小銭がありません。先に両替屋で細かい銀か銅銭に替えてきてください。"

msgid "交易未完成，状态异常；已发生的扣款不会退回。"
msgstr "取引が正しく完了せず、状態に異常があります。すでに支払った分は戻りません。"

msgid "你拿起一根%s呜嘟嘟地吹了起来。"
msgstr "%sを一本手に取り、プープーと吹き鳴らした。"

msgid "你四处看看, 实在找不到地方挂绳子说..."
msgstr "あたりを見回したが、縄をかける場所がどうにも見つからない……。"

msgid "你把绳子一端挂好, 另一端往脖子上一套....."
msgstr "縄の一方の端をかけ、もう一方の端を首にかけた……。"

msgid "{npc}捡起{item}。"
msgstr "{npc}が{item}を拾った。"

msgid "你捡起%s。"
msgstr "%sを拾った。"

msgid "你附近没有这样东西。"
msgstr "近くにそういう物はない。"

msgid "{container}里什麽也没有，先装些水酒才能溶化药粉。"
msgstr "{container}の中は空っぽだ。薬の粉を溶かすには、先に水か酒を入れなければならない。"

msgid "你将一些{powder}倒进{container}，摇晃了几下。"
msgstr "{powder}を少し{container}に入れ、何度か振った。"

msgid "$N和$n仇人相见分外眼红，立刻打了起来！"
msgstr "$Nと$nは仇同士、顔を合わせるなり目の色を変えて、たちまち戦いはじめた！"

msgid "$N对著$n大喝：「可恶，又是你！」"
msgstr "$Nが$nに怒鳴った。「くそっ、またお前か！」"

msgid "$N和$n一碰面，二话不说就打了起来！"
msgstr "$Nと$nは顔を合わせるなり、問答無用で戦いはじめた！"

msgid "$N一眼瞥见$n，「哼」的一声冲了过来！"
msgstr "$Nは$nを見るなり、「ふん」と鼻を鳴らして突っかかっていった！"

msgid "$N一见到$n，愣了一愣，大叫：「我宰了你！」"
msgstr "$Nは$nを見て一瞬ぎょっとし、叫んだ。「殺してやる！」"

msgid "$N喝道：「$n，我们的帐还没算完，看招！」"
msgstr "$Nが怒鳴った。「$n、まだ勘定は済んでいないぞ。覚悟！」"

msgid "$N喝道：「$n，看招！」"
msgstr "$Nが一喝した。「$n、覚悟！」"

msgid "道："
msgstr "「"

msgid "{npc}发现了你！"
msgstr "{npc}がこちらに気づいた！"

msgid "{npc}发现了你，大喝一声！"
msgstr "{npc}がこちらに気づき、大声で一喝した！"

msgid "%s用一种异样的眼神扫视著在场的每一个人。"
msgstr "%sは異様な目つきで、その場の一人ひとりを見回した。"

msgid "{npc}对著你喝道：{self}看你实在很不顺眼，去死吧。"
msgstr "{npc}が怒鳴りつけてきた。「{self}はてめえがどうにも気に食わねえ。死にやがれ」"

msgid "{npc}对著你喝道：喂！{rude}，{self}正想找人打架，陪我玩两手吧！"
msgstr "{npc}が怒鳴りつけてきた。「おい、{rude}！ {self}はちょうど暴れたかったところだ。ひと勝負付き合え！」"

msgid "刀剑无眼，持兵刃比试可能真的受伤。"
msgstr "刀剣に目はありません。武器を持っての手合わせでは、本当に傷を負うことがあります。"

msgid "你用一种异样的眼神扫视著在场的每一个人。"
msgstr "異様な目つきで、その場の一人ひとりを見回した。"

msgid "你对著{npc}喝道：{self}看你实在很不顺眼，去死吧。"
msgstr "{npc}に向かって怒鳴った。「{self}はどうにもお前が気に入らない。死んでもらう」"

msgid "你对著{npc}喝道：喂！{rude}，{self}正想找人打架，陪我玩两手吧！"
msgstr "{npc}に向かって怒鳴った。「おい、{rude}！ {self}はちょうど誰かと一戦交えたかったところだ。少し付き合ってもらおう！」"

msgid "%s突然转过头来瞪你一眼。"
msgstr "%sが不意に振り向き、こちらをにらみつけた。"

msgid "{npc}拔刀上前，和你并肩而立！"
msgstr "{npc}が刀を抜いて進み出て、肩を並べた！"

msgid "%s慢慢睁开眼睛，清醒了过来。"
msgstr "%sはゆっくりと目を開け、意識を取り戻した。"

msgid "{npc}的测试：第 {n} / {total} 招"
msgstr "{npc}の試験：{n} / {total}手"

msgid "{npc}：第 {n} / {total} 句"
msgstr "{npc}：{n} / {total}"

msgid "{name}走了过来。"
msgstr "{name}がやって来た。"

msgid "你忽然觉得身上一轻，{item}不见了！"
msgstr "ふと体が軽くなった気がした。{item}がない！"

msgid "你昏迷不醒的时候，身上的{item}被人拿走了！"
msgstr "気を失っているあいだに、持っていた{item}を誰かに持ち去られた！"

msgid "你一回头，正好发现{npc}的手正抓著你身上的{item}！"
msgstr "振り向くと、ちょうど{npc}の手がこちらの{item}をつかんでいた！"

msgid "你喝道：「干什麽！」"
msgstr "怒鳴った。「何をする！」"

msgid "{npc}穿上一{unit}{item}。"
msgstr "{npc}は{item}を一{unit}身に着けた。"

msgid "{npc}戴上一{unit}{item}。"
msgstr "{npc}は{item}を一{unit}つけた。"

msgid "{npc}将一{unit}绑在腰间。"
msgstr "{npc}は何か一{unit}を腰に巻きつけた。"

msgid "{npc}装备{item}。"
msgstr "{npc}は{item}を装備した。"

msgid "{npc}装备{item}作武器。"
msgstr "{npc}は{item}を武器として構えた。"

msgid "{npc}收了刀，走了。"
msgstr "{npc}は刀を収めて去っていった。"

msgid "%s急急忙忙地离开了。"
msgstr "%sはあたふたと立ち去った。"

msgid "（{npc}要把你押到县衙受审：被押着走不开；可以向他行贿，也可以拒捕跟他动手。）"
msgstr "（{npc}に県衙へ引き立てられ、裁きにかけられようとしています。連行されているあいだは離れられません。{npc}に賄賂を贈ることも、捕縛に逆らって戦うこともできます。）"

msgid "木人是武馆拆招用的，只能切磋，打坏了还得赔。"
msgstr "木人は武館で稽古に使うものです。手合わせしかできず、壊せば弁償しなければなりません。"

msgid "你身上带着伤，先养好了再来拆招。"
msgstr "傷を負っているようです。まずは治してから稽古に来てください。"

msgid "你是别派的弟子，我不便指点。"
msgstr "他の門派の弟子に、稽古をつけるわけにはいきません。"

msgid "来，拆三回合，点到为止。"
msgstr "さあ、三合だけ稽古をしましょう。寸止めで。"

msgid "{npc}已经倒了。{npc}还有用，留{npc}一条命。"
msgstr "{npc}はもう倒れている。{npc}にはまだ用がある。{npc}の命は取らずにおく。"

msgid "这里禁止战斗。"
msgstr "ここでは戦闘は禁じられています。"

msgid "你想攻击谁？"
msgstr "誰を攻撃しますか？"

msgid "加油！加油！加油！"
msgstr "がんばれ！ がんばれ！ がんばれ！"

msgid "%s已经无法战斗了。"
msgstr "%sはもう戦えない。"

msgid "你对著{npc}说道：{self}{name}，领教{respect}的高招！"
msgstr "{npc}に言った。「{self}、{name}と申します。{respect}のお手並み、拝見いたします！」"

msgid "看起来%s并不想跟你较量。"
msgstr "どうやら%sは手合わせする気がないようだ。"

msgid "你向{npc}讨教{skill}，请{npc}拆几招给你看。"
msgstr "{npc}に{skill}の指南を頼み、何手か稽古をつけてもらうことにした。"

msgid "{npc}给你{item}。"
msgstr "{npc}が{item}をくれた。"

msgid "你可以购买下列这些东西："
msgstr "買えるもの："

msgid "{item}：{price}"
msgstr "{item}：{price}"

msgid "两{unit}{item}"
msgstr "{item}二{unit}"

msgid "你说道：%s"
msgstr "言った。「%s」"

msgid "关闭%s"
msgstr "%sを閉める"

msgid "打开%s"
msgstr "%sを開ける"

msgid "你咬破手指，用鲜血在{paper}上画了一道僵尸追魂符，写上了{name}的名字。"
msgstr "指を噛み切り、その血で{paper}にキョンシー追魂符を描いて、{name}の名を書き入れた。"

msgid "这里没有{name}。"
msgstr "ここに{name}はいない。"

msgid "等待机会对{npc}下手"
msgstr "{npc}に手を出す隙をうかがっている"

msgid "这里禁止行窃。"
msgstr "ここでは盗みは禁じられています。"

msgid "你已经在找机会下手了！"
msgstr "もう隙をうかがっているところだ！"

msgid "你想行窃的对象不在这里。"
msgstr "盗もうとした相手はここにいない。"

msgid "{npc}身上看起来没有什麽值钱的东西好偷。"
msgstr "{npc}は、盗むに値するような物は持っていないようだ。"

msgid "你不动声色地慢慢靠近{npc}，等待机会下手 ..."
msgstr "何食わぬ顔でそっと{npc}に近づき、手を出す隙をうかがう……"

msgid "太可惜了，你下手的目标已经走了。"
msgstr "残念、狙っていた相手は行ってしまった。"

msgid "你摸到{item}，可是对你而言太重了，不得不放弃。"
msgstr "{item}に手が届いたが、重すぎてどうにもならず、あきらめるしかなかった。"

msgid "得手了！"
msgstr "うまくいった！"

msgid "你成功地偷到{item}！"
msgstr "{item}をまんまと盗み取った！"

msgid "{npc}不经意地一转头，你急忙将手缩了回去！"
msgstr "{npc}がふと振り向いたので、あわてて手を引っこめた！"

msgid "还好，没有被发现。"
msgstr "やれやれ、気づかれなかった。"

msgid "糟糕！你失手了！"
msgstr "しまった！ しくじった！"

msgid "{npc}一回头，正好发现你的手正抓著{pronoun}身上的{item}！"
msgstr "{npc}が振り向くと、ちょうどこちらの手が{pronoun}の{item}をつかんでいるところだった！"

msgid "{npc}喝道：「干什麽！」"
msgstr "{npc}が怒鳴った。「何をする！」"

msgid "！"
msgstr "！"

msgid "{name}喝道：{text}"
msgstr "{name}が怒鳴った。「{text}」"

msgid "风停了。草直直地立着，雾也不动了，四下里一点声音都没有。"
msgstr "風がやんだ。草はまっすぐに立ち、霧も動かない。あたりには物音ひとつない。"

msgid "一阵乱风打着旋卷过去，辨不出是从哪边来的。"
msgstr "乱れた風が渦を巻いて吹き過ぎていった。どちらから吹いてきたのか見当もつかない。"

msgid "风从{quarter}边吹过来，草都朝一边倒。"
msgstr "風が{quarter}から吹いてきて、草がみな一方へなびいている。"

msgid "怀里的风铃轻轻响了一声，清清楚楚。"
msgstr "懐の風鈴が小さく一度、はっきりと鳴った。"

msgid "怀里的风铃叮叮地响，声音清亮。"
msgstr "懐の風鈴がちりんちりんと鳴った。澄んだ明るい音だ。"

msgid "怀里的风铃闷闷地响了两下。"
msgstr "懐の風鈴が、こもった音で二度鳴った。"

msgid "风：停了"
msgstr "風：凪"

msgid "风：乱风"
msgstr "風：乱れ風"

msgid "风：{quarter}风 {arrow}"
msgstr "風：{quarter}の風 {arrow}"

msgid "主手"
msgstr "利き手"

msgid "副手"
msgstr "添え手"

msgid "已穿戴"
msgstr "着用中"

msgid "每次练习耗 {mana} 点法力、{sen} 点神。心神一乱会变出{npcs}，它会立刻攻击你，活着时不能再练。亲手杀了它，{skill}会有长进；被别人杀了，你会昏倒。"
msgstr "練習のたびに法力{mana}と神{sen}を使う。心が乱れると{npcs}が現れ、すぐに襲いかかってくる。それが生きているあいだは練習できない。自分の手で倒せば{skill}が上達するが、ほかの者に倒されると気を失う。"

msgid "或"
msgstr "か"

msgid "需要先学会基本咒文，法力才能增长。"
msgstr "基本呪文を覚えないと、法力は伸びません。"

msgid "需要先学会基本法术，灵力才能增长。"
msgstr "基本法術を覚えないと、霊力は伸びません。"

msgid "{verb}要耗去{cost}，你现在撑不住，会当场昏过去。\n确定要{verb}吗？"
msgstr "「{verb}」には{cost}を使います。今の状態では耐えきれず、その場で気を失います。\nそれでも「{verb}」を行いますか？"

msgid " {amount} 点{resource}"
msgstr "{resource}{amount}"

