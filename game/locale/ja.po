msgstr "だが$Nは仕掛ける隙を見つけられない！"

msgid "$N眼睛忽然睁开，喃喃地说道：杀....死....$n...."
msgstr "$Nの目がかっと見開かれ、ぶつぶつとつぶやいた。「殺……す……$n……」"

msgid "你要在这张符上写谁的名字？"
msgstr "この符に誰の名を書く？"

msgid "心识神通"
msgstr "心識神通"

msgid "$N一手放在$n的天灵盖上，一手贴在$n的後心，闭上眼睛缓缓低吟 ..."
msgstr "$Nは片手を$nの頭頂に、もう片手を$nの背に当て、目を閉じてゆっくりと低く唱えはじめた……"

msgid "你要对谁使用心识神通？"
msgstr "誰に心識神通を使う？"

msgid "召护法"
msgstr "護法を召す"

msgid "只有战斗中才能召唤天将！"
msgstr "天将を召喚できるのは戦闘中だけだ！"

msgid "你的精神无法集中！"
msgstr "精神を集中できない！"

msgid "$N喃喃地念了几句咒语。"
msgstr "$Nは呪文をぶつぶつと唱えた。"

msgid "但是什麽也没有发生。"
msgstr "だが、何も起こらなかった。"

msgid "( 你上一个动作还没有完成，不能施用外功。)"
msgstr "（まだ前の動作が終わっていないので、外功は使えない。）"

msgid "你请先用 enable 指令选择你要使用的外功。"
msgstr "まず使う外功を選ばなければならない。"

msgid "你所使用的外功中没有这种功能。"
msgstr "使っている外功には、そのような働きはない。"

msgid "「点」字诀"
msgstr "『点』の字訣"

msgid "「点」字诀只能对战斗中的对手使用。"
msgstr "『点』の字訣は、戦っている相手にしか使えない。"

msgid "$N使出封山剑法「点」字诀，可是内力不继，剑尖一颤，手中的剑险些脱手飞出！"
msgstr "$Nは封山剣法『点』の字訣を繰り出したが、内力が続かず、剣先が震えて手の剣がすっぽ抜けかけた！"

msgid "$N使出封山剑法「点」字诀，劲力尽数聚在剑尖，一剑直刺$n！"
msgstr "$Nは封山剣法『点』の字訣を繰り出し、勁力のすべてを剣先に集めて、$nへまっすぐ突きかかる！"

msgid "用 {force} 点内力把劲力聚在剑尖，这一剑伤得更重；内力不够，剑会险些脱手，白白耽误几手"
msgstr "内力を{force}使って勁力を剣先に集め、この一撃の威力を上げる。内力が足りないと剣が手から抜けかけ、何手かをむだにする"

msgid "召天将"
msgstr "天将を召す"

msgid "战斗时不能画符！"
msgstr "戦闘中は符を描けない！"

msgid "你的精神太差了，无法画符。"
msgstr "神が衰えすぎていて、符を描けない。"

msgid "你所学的法术没有这种符。"
msgstr "学んだ法術に、そのような符はない。"

msgid "紫光"
msgstr "紫光"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团紫光射向$n！"
msgstr "$Nは口の中で呪文を唱えながら左手をひと振りした。手の中に紫の光の塊が集まり、$nめがけて飛んでいく！"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，拖出一条长长的七彩光气，光气绕了回转过来又从$N顶门注入$P的体内！"
msgstr "すると「しゅっ」という音とともに、紫の光が$pの体を突き抜けた。長い七色の光の尾が引かれ、それがくるりと戻ってきて、$Nの頭頂から体内へと流れ込んだ！"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，无声无息地钻入地下！"
msgstr "すると「しゅっ」という音とともに、紫の光が$pの体を突き抜け、音もなく地中へ潜り込んだ！"

msgid "白光"
msgstr "白光"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团白光射向$n！"
msgstr "$Nは口の中で呪文を唱えながら左手をひと振りした。手の中に白い光の塊が集まり、$nめがけて飛んでいく！"

msgid "结果「嗤」地一声，白光从$p身上透体而过，拖出一条长长的黑气直射到两三丈外的地下！"
msgstr "すると「しゅっ」という音とともに、白い光が$pの体を突き抜け、長い黒い気の尾を引いて、二、三丈先の地面に突き刺さった！"

msgid "结果「嗤」地一声，白光从$p身上透体而过，无声无息地钻入地下！"
msgstr "すると「しゅっ」という音とともに、白い光が$pの体を突き抜け、音もなく地中へ潜り込んだ！"

msgid "青光"
msgstr "青光"

msgid "你失败了！"
msgstr "失敗した！"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团青光射向$n！"
msgstr "$Nは口の中で呪文を唱えながら左手をひと振りした。手の中に青い光の塊が集まり、$nめがけて飛んでいく！"

msgid "结果「嗤」地一声，青光从$p身上透体而过，拖出一条长长的血箭直射到两三丈外的地下！"
msgstr "すると「しゅっ」という音とともに、青い光が$pの体を突き抜け、長い血の矢を引いて、二、三丈先の地面に突き刺さった！"

msgid "结果「嗤」地一声，青光从$p身上透体而过，无声无息地钻入地下！"
msgstr "すると「しゅっ」という音とともに、青い光が$pの体を突き抜け、音もなく地中へ潜り込んだ！"

msgid "投降？现在没有人在打你啊....？"
msgstr "降参？ 今は誰とも戦っていないが……？"

msgid "$n向$N求饶，但是$N大声说道：{rude}废话少说，纳命来！"
msgstr "$nは$Nに命乞いをしたが、$Nは大声で言った。「{rude}め、つべこべ言わずに命をよこせ！」"

msgid "$N说道：「不打了，不打了，我投降....。」"
msgstr "$N「もうやめだ、やめだ。降参する……」"

msgid "「逐」字诀"
msgstr "『逐』の字訣"

msgid "「逐」字诀只能对战斗中的对手使用。"
msgstr "『逐』の字訣は、戦っている相手にしか使えない。"

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p已显吃力。"
msgstr "$Nは封山剣法『逐』の字訣を繰り出した。剣が一段と鋭さを増して剣光が$nを覆い、$pはもう押されている。"

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p从容化解"
msgstr "$Nは封山剣法『逐』の字訣を繰り出した。剣が一段と鋭さを増して剣光が$nを覆ったが、$pは落ち着いてこれをさばいた"

msgid "空识神通"
msgstr "空識神通"

msgid "$N盘膝而座，开始运用空识神通静思入定 ..."
msgstr "$Nは足を組んで座り、空識神通で静かに瞑想に入った……"

msgid "空识神通只能对自己使用。"
msgstr "空識神通は自分にしか使えない。"

msgid "你觉得脑中一片混乱，你的潜能降低了！"
msgstr "頭の中がかき乱され、潜在力が下がった！"

msgid "你的潜能提高了！"
msgstr "潜在力が上がった！"

msgid "可是你只觉得一无所获。"
msgstr "だが、何も得られなかった。"

msgid "零"
msgstr "0"

msgid "十"
msgstr "十"

msgid "百"
msgstr "百"

msgid "千"
msgstr "千"

msgid "万"
msgstr "万"

msgid "亿"
msgstr "億"

msgid "兆"
msgstr "兆"

msgid "一"
msgstr "1"

msgid "二"
msgstr "2"

msgid "三"
msgstr "3"

msgid "四"
msgstr "4"

msgid "五"
msgstr "5"

msgid "六"
msgstr "6"

msgid "七"
msgstr "7"

msgid "八"
msgstr "8"

msgid "九"
msgstr "9"

msgid "负"
msgstr "マイナス"

msgid "你的「%s」进步了！"
msgstr "『%s』が上達した！"

msgid "没有这个技能种类，用 enable ? 可以查看有哪些种类。"
msgstr "そのような技能の種類はない。enable ? で種類を確かめられる。"

msgid "「{skill}」是所有{kind}的基础，不需要 enable。"
msgstr "『{skill}』はあらゆる{kind}の基礎なので、充てる必要はない。"

msgid "你不会这种技能。"
msgstr "その技能は身につけていない。"

msgid "你连「{basic}」都没学会，更别提{skill}了。"
msgstr "『{basic}』すら身につけていないのに、{skill}など論外だ。"

msgid "这个技能不能当成这种用途。"
msgstr "この技能はそういう使い方はできない。"

msgid "你改用另一种法术系，灵力必须重新锻炼。"
msgstr "別の法術の系統に替えたので、霊力は一から鍛え直さなければならない。"

msgid "你改用另一种内功，内力必须重新锻炼。"
msgstr "別の内功に替えたので、内力は一から鍛え直さなければならない。"

msgid "你改用另一种咒文系，法力必须重新修炼。"
msgstr "別の呪文の系統に替えたので、法力は一から修め直さなければならない。"

msgid "你已经在战斗中了，学一点实战经验吧。"
msgstr "もう戦いの最中だ。実戦経験でも積むといい。"

msgid "你只能练习用 enable 指定的特殊技能。"
msgstr "充てている特殊技能しか練習できない。"

msgid "你好像还没「学会」这项技能吧？最好先去请教别人。"
msgstr "この技能はまだ「身につけて」いないのでは？ まず誰かに教えを請うといい。"

msgid "你对这方面的技能还是一窍不通，最好从先从基本学起。"
msgstr "この方面の技能にはまるで心得がない。まず基本から学ぶといい。"

msgid "你现在不能练习这项技能。"
msgstr "今はこの技能を練習できない。"

msgid "你试著练习%s，但是并没有任何进步。"
msgstr "%sを練習してみたが、少しも上達しなかった。"

msgid "你的%s进步了！"
msgstr "%sが上達した！"

msgid "战斗中不能练内功，会走火入魔。"
msgstr "戦闘中に内功を練れば、走火入魔してしまう。"

msgid "你必须先用 enable 选择你要用的内功心法。"
msgstr "まず使う内功心法を選ばなければならない。"

msgid "你最少要花 10 点「气」才能练功。"
msgstr "練功には少なくとも「気」を10使う必要がある。"

msgid "你现在的气太少了，无法产生内息运行全身经脉。"
msgstr "気が少なすぎて、内息を全身の経脈に巡らせられない。"

msgid "你现在精神状况太差了，无法凝神专一！"
msgstr "神が衰えすぎていて、心を一つに凝らせない！"

msgid "你现在精力不够，无法控制内息的流动！"
msgstr "精が足りず、内息の流れを制御できない！"

msgid "你现在无法练功。"
msgstr "今は練功できない。"

msgid "你坐下来运气用功，一股内息开始在体内流动。"
msgstr "腰を下ろして気を巡らせると、一筋の内息が体内を流れはじめた。"

msgid "但是当你行功完毕，只觉得全身酸麻。"
msgstr "だが行功を終えると、全身がだるくしびれるばかりだった。"

msgid "当你的内息遍布全身经脉时却没有功力提升的迹象，似乎内力修为已经遇到了瓶颈。"
msgstr "内息が全身の経脈に行きわたっても、功力が伸びる兆しはない。内力の修為は壁に突き当たったようだ。"

msgid "你的内力增强了！"
msgstr "内力が強まった！"

msgid "战斗中冥思——找死吗？"
msgstr "戦闘中に瞑想――死にたいのか？"

msgid "你最少要花 10 点「神」才能冥思。"
msgstr "瞑想には少なくとも「神」を10使う必要がある。"

msgid "你现在精神太差了，进行冥思将会迷失，永远醒不过来！"
msgstr "神が衰えすぎている。今瞑想すれば心が迷い、二度と目覚められなくなる！"

msgid "你现在身体状况太差了，无法集中精神！"
msgstr "体の調子が悪すぎて、精神を集中できない！"

msgid "你现在身体状况太虚弱了，无法进入冥思的状态！"
msgstr "体が弱りすぎていて、瞑想に入れない！"

msgid "你现在无法冥思。"
msgstr "今は瞑想できない。"

msgid "你盘膝而坐，静坐冥思了一会儿。"
msgstr "足を組んで座り、しばし静かに瞑想した。"

msgid "但是当你睁开眼睛，只觉得脑中一片空白。"
msgstr "だが目を開けると、頭の中は真っ白だった。"

msgid "当你的法力增加的瞬间你忽然觉得脑中一片混乱，似乎魔力的提升已经到了瓶颈。"
msgstr "法力が増した瞬間、不意に頭の中がかき乱された。魔力の高まりは壁に突き当たったようだ。"

msgid "你的魔力提高了！"
msgstr "魔力が高まった！"

msgid "战斗也是一种修行，但不能和灵力的修行同时进行。"
msgstr "戦いもまた修行の一つだが、霊力の修行と同時にはできない。"

msgid "你最少要花 10 点精力才能进行修行。"
msgstr "修行には少なくとも精を10使う必要がある。"

msgid "你现在精力不足，无法修行灵力！"
msgstr "精が足りず、霊力を修行できない！"

msgid "你现在精神状况太差了，无法控制自己的心灵！"
msgstr "神が衰えすぎていて、自分の心を制御できない！"

msgid "你现在无法修行。"
msgstr "今は修行できない。"

msgid "你闭上眼睛开始打坐。"
msgstr "目を閉じて打坐を始めた。"

msgid "但是你一不小心却睡著了。"
msgstr "だが、うっかり眠り込んでしまった。"

msgid "你忽然觉得一阵天旋地转，头涨得像要裂开一样，似乎灵力的修行已经遇到了瓶颈。"
msgstr "不意に天地がぐるぐると回り、頭が割れそうなほど張りつめた。霊力の修行は壁に突き当たったようだ。"

msgid "你的道行提高了！"
msgstr "道行が高まった！"

msgid "这项技能不能通过自学取得进步！"
msgstr "この技能は独学では上達しない！"

msgid "你得有「%s」的入门知识才行。"
msgstr "『%s』の初歩を心得ていなければならない。"

msgid "你现在无法自学。"
msgstr "今は独学できない。"

msgid "你开始钻研有关「%s」的问题。"
msgstr "『%s』についての問題を突き詰めはじめた。"

msgid "也许是缺乏实战经验，结果是一无所获。"
msgstr "実戦経験が足りないせいか、何も得られなかった。"

msgid "你苦思冥想，似乎有些心得。"
msgstr "考えに考え抜いて、何かつかめた気がする。"

msgid "你无法在战斗中专心下来研读新知！"
msgstr "戦闘中に落ち着いて新しい知識を学ぶことはできない！"

msgid "你无法从这样东西学到任何东西。"
msgstr "これからは何も学べない。"

msgid "你是个文盲，先学学读书识字吧。"
msgstr "字が読めない。まず読み書きを覚えよう。"

msgid "你的实战经验不足，再怎麽读也没用。"
msgstr "実戦経験が足りず、いくら読んでもむだだ。"

msgid "以你目前的能力，还没有办法学这个技能。"
msgstr "今の力では、まだこの技能を学べない。"

msgid "你现在过於疲倦，无法专心下来研读新知。"
msgstr "疲れすぎていて、落ち着いて学ぶことができない。"

msgid "你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。"
msgstr "しばらく読んでみたが、書かれていることはどれも浅すぎて、何も得られなかった。"

msgid "你研读有关%s的技巧，似乎有点心得。"
msgstr "%sの技について読み込み、少し心得がつかめた気がする。"

msgid "你现在无法研读。"
msgstr "今は読めない。"

msgid "你向{npc}请教「{skill}」{count} 次"
msgstr "{npc}に『{skill}』の教えを{count}回請うた"

msgid "你练习{skill} {count} 次"
msgstr "{skill}を{count}回練習した"

msgid "你打坐 {count} 次"
msgstr "{count}回打坐した"

msgid "你冥思 {count} 次"
msgstr "{count}回瞑想した"

msgid "你修行 {count} 次"
msgstr "{count}回修行した"

msgid "（其间歇了 {rests} 回，共{time}）"
msgstr "（途中で{rests}回休み、計{time}）"

msgid "{head}：{changes}。"
msgstr "{head}：{changes}。"

msgid "，"
msgstr "、"

msgid "{skill} {from}→{to} 级"
msgstr "{skill} レベル{from}→{to}"

msgid "{skill}进度 {change}"
msgstr "{skill}の習得度 {change}"

msgid "打坐"
msgstr "打坐"

msgid "冥思"
msgstr "瞑想"

msgid "修行"
msgstr "修行"

msgid "停下：精不够了。请教一次耗精 {cost}，精须多于此数（你还有 {have}）。精要时间才回得来，窗口开着时间不走：点「歇到回满」歇一会儿再来；学了内功的，也可以在武学页运功恢复精。"
msgstr "中断：精が足りません。教えを一度請うごとに精を{cost}使い、それより多く残っている必要があります（残り{have}）。精は時間がたたないと戻らず、この画面を開いている間は時間が進みません。「全快まで休む」を押してひと休みしてから、また来てください。内功を学んでいれば、武学のページで運功して精を回復することもできます。"

msgid "停下：精不够了。请教一次耗精 {cost}，精须多于此数（你还有 {have}）。"
msgstr "中断：精が足りません。教えを一度請うごとに精を{cost}使い、それより多く残っている必要があります（残り{have}）。"

msgid "身上有限时的差事，歇着时限照走，所以没有自己歇；要歇就点「歇到回满」。"
msgstr "期限付きの頼み事を抱えていて、休んでいる間も期限は進むため、自動では休みませんでした。休むなら「全快まで休む」を押してください。"

msgid "停下：实战经验不足。「{skill}」{level} 级要再学，须实战经验 ≥ {required}（你 {have}）。"
msgstr "中断：実戦経験が足りません。『{skill}』をレベル{level}から先へ学ぶには、実戦経験 ≥ {required}が必要です（現在 {have}）。"

msgid "停下：「{skill}」这一级的进度已经攒满。先把{basic}提高到 {level} 级，再练才有长进。"
msgstr "中断：『{skill}』のこのレベルの習得度はもういっぱいです。先に{basic}をレベル{level}まで上げないと、練習しても伸びません。"

msgid "停下：每次只花 {amount} 点{source}，{action}不会有任何长进；多花一些再试。"
msgstr "中断：一回に{source}を{amount}しか使わないと、{action}しても少しも伸びません。もう少し多く使ってみてください。"

msgid "停下：{resource}的修为已到瓶颈（上限 {maximum}），再{action}，{resource}只会回落到 {maximum}。先提高{basic}吧。"
msgstr "中断：{resource}の修為が壁に突き当たりました（上限 {maximum}）。これ以上{action}しても、{resource}は{maximum}に戻るだけです。先に{basic}を上げましょう。"

msgid "停下：你被打断了。"
msgstr "中断：邪魔が入りました。"

msgid "你停了下来。"
msgstr "手を止めた。"

msgid "停下：已经连续 {count} 次了，歇一歇吧。"
msgstr "中断：もう{count}回続けています。ひと休みしましょう。"

msgid "Ok."
