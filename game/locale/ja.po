msgid "{pronoun}看起来远不如你。"
msgstr "{pronoun}はあなたよりはるかに格下に見える。"

msgid "{pronoun}看起来不如你。"
msgstr "{pronoun}はあなたより格下に見える。"

msgid "{pronoun}看起来和你不相上下。"
msgstr "{pronoun}はあなたと互角に見える。"

msgid "{pronoun}看起来比你强。"
