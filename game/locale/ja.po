msgid "$N注视著$n的行动，企图寻找机会出手。"
msgstr "$Nは$nの動きを注視し、仕掛ける隙をうかがう。"

msgid "$N正盯著$n的一举一动，随时准备发动攻势。"
msgstr "$Nは$nの一挙一動をにらみ、いつでも攻めかかれるよう身構える。"

msgid "$N缓缓地移动脚步，想要找出$n的破绽。"
msgstr "$Nはゆっくりと足を運び、$nの隙を探る。"

msgid "$N目不转睛地盯著$n的动作，寻找进攻的最佳时机。"
msgstr "$Nは$nの動きから目を離さず、攻め込む好機をうかがう。"

msgid "$N慢慢地移动著脚步，伺机出手。"
msgstr "$Nはじりじりと足を運び、機をうかがう。"

msgid "$N哈哈大笑，说道：承让了！"
msgstr "$Nは高らかに笑った。「お譲りいただき、恐れ入ります！」"

msgid "$N双手一拱，笑著说道：承让！"
msgstr "$Nは拱手して笑った。「お譲りいただき、恐れ入ります！」"

msgid "$N胜了这招，向後跃开三尺，笑道：承让！"
msgstr "$Nはこの一手を制すると、三尺ほど後ろへ跳びのいて笑った。「お譲りいただき、恐れ入ります！」"

msgid "$n脸色微变，说道：佩服，佩服！"
msgstr "$nはわずかに顔色を変えた。「お見事、お見事！」"

msgid "$n向後退了几步，说道：这场比试算我输了，佩服，佩服！"
msgstr "$nは数歩退いた。「この勝負、私の負けだ。お見事、お見事！」"

msgid "$n向後一纵，躬身做揖说道：阁下武艺不凡，果然高明！"
msgstr "$nは後ろへ跳びのき、身をかがめて拱手した。「そちらの武芸は並々ならぬ。まことにお見事！」"

msgid "$N受到$n的内力反震，闷哼一声。"
msgstr "$Nは$nの内力に弾き返され、うっとうめいた。"

msgid "$N被$n以内力反震，「嘿」地一声退了两步。"
msgstr "$Nは$nの内力に弾かれ、「くっ」と声をもらして二歩退いた。"

msgid "$N被$n以内力一震，胸口有如受到一记重击，连退了五六步！"
msgstr "$Nは$nの内力に弾かれ、胸に重い一撃を受けたかのように五、六歩よろめき退いた！"

msgid "$N被$n的内力一震，眼前一黑，身子向後飞出丈许！！"
msgstr "$Nは$nの内力に弾かれ、目の前が真っ暗になって、一丈あまりも後ろへ吹き飛んだ！！"

msgid "$N一击不中，露出了破绽！"
msgstr "$Nの一撃は空を切り、隙が生じた！"

msgid "$N见$n攻击失误，趁机发动攻击！"
msgstr "$Nは$nの攻撃が外れたのを見て、すかさず攻めかかる！"

msgid "结果没有造成任何伤害。"
msgstr "だが、傷ひとつ負わせられなかった。"

msgid "擦伤"
msgstr "かすり傷"

msgid "割伤"
msgstr "切り傷"

msgid "结果只是轻轻地划破$p的皮肉。"
msgstr "だが、$pの皮膚を浅く裂いただけだった。"

msgid "结果在$p$l划出一道细长的血痕。"
msgstr "$pの$lに、細く長い血の筋が走った。"

msgid "结果「嗤」地一声划出一道伤口！"
msgstr "「シュッ」という音とともに、傷口が開いた！"

msgid "结果「嗤」地一声划出一道血淋淋的伤口！"
msgstr "「シュッ」という音とともに、血まみれの傷口が開いた！"

msgid "结果「嗤」地一声划出一道又长又深的伤口，溅得$N满脸鲜血！"
msgstr "「シュッ」という音とともに長く深い傷口が開き、$Nの顔じゅうに鮮血が飛び散った！"

msgid "结果只听见$n一声惨嚎，$w已在$p$l划出一道深及见骨的可怕伤口！！"
msgstr "$nの悲鳴が響いたかと思うと、$wは$pの$lに、骨まで達する恐ろしい傷を刻んでいた！！"

msgid "结果只是轻轻地刺破$p的皮肉。"
msgstr "だが、$pの皮膚を浅く刺しただけだった。"

msgid "结果在$p$l刺出一个创口。"
msgstr "$pの$lに刺し傷が一つできた。"

msgid "结果「噗」地一声刺入了$n$l寸许！"
msgstr "「ズブッ」という音とともに、$nの$lに一寸ほど突き刺さった！"

msgid "结果「噗」地一声刺进$n的$l，使$p不由自主地退了几步！"
msgstr "「ズブッ」という音とともに$nの$lに突き刺さり、$pは思わず数歩よろめいた！"

msgid "结果「噗嗤」地一声，$w已在$p$l刺出一个血肉模糊的血窟窿！"
msgstr "「ズブリ」という音とともに、$wは$pの$lに血肉のつぶれた穴をうがった！"

msgid "结果只听见$n一声惨嚎，$w已在$p的$l对穿而出，鲜血溅得满地！！"
msgstr "$nの悲鳴が響いたかと思うと、$wは$pの$lを貫き通し、鮮血が辺り一面に飛び散った！！"

msgid "结果只是轻轻地碰到，比拍苍蝇稍微重了点。"
msgstr "だが軽く触れただけで、蠅をはたくより少し強い程度だった。"

msgid "结果在$p的$l造成一处瘀青。"
msgstr "$pの$lに青あざが一つできた。"

msgid "结果一击命中，$n的$l登时肿了一块老高！"
msgstr "一撃が命中し、$nの$lがたちまち大きく腫れ上がった！"

msgid "结果一击命中，$n闷哼了一声显然吃了不小的亏！"
msgstr "一撃が命中し、$nはうっとうめいた。かなりこたえたようだ！"

msgid "结果「砰」地一声，$n退了两步！"
msgstr "「ドン」という音とともに、$nは二歩退いた！"

