msgid "结果造成一处{type}！"
msgstr "{type}を負わせた！"

msgid "结果造成一处严重{type}！"
msgstr "重い{type}を負わせた！"

msgid "结果造成颇为严重的{type}！"
msgstr "かなり重い{type}を負わせた！"

msgid "结果造成相当严重的{type}！"
msgstr "相当に重い{type}を負わせた！"

