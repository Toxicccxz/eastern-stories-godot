msgstr "{npc}自身がレベル{teacher}"

msgid "你已学到{npc}的 {teacher} 级"
msgstr "{npc}のレベル{teacher}まで学びきった"

msgid "背叛师门 {count} 次，{npc}只教到 {teacher} - 20×{count} = {cap} 级"
msgstr "師門に背いた回数{count}回、{npc}が教えるのはレベル{teacher} - 20×{count} = {cap}まで"

msgid "不是{npc}的嫡传弟子，只学得到{npc}等级（{teacher}）的三分之一左右"
msgstr "{npc}の直弟子ではないので、{npc}のレベル（{teacher}）の三分の一ほどまでしか学べない"

msgid "背叛师门 {count} 次，{npc}能教你的都教了"
msgstr "師門に背いた回数{count}回、{npc}が教えてくれることはもうない"

msgid "{level} 级要再学，须实战经验 ≥ {required}"
msgstr "レベル{level}から先へ学ぶには実戦経験 ≥ {required}が必要"

msgid "经验不足，要再学须实战经验 ≥ {required}（你 {have}）"
msgstr "経験不足：先へ学ぶには実戦経験 ≥ {required}が必要（現在 {have}）"

msgid "学不了：{npc}不肯指点你。"
msgstr "学べない：{npc}が教えてくれない。"

msgid "潜能已经用完"
msgstr "潜在力を使い果たした"

msgid "{npc}太累了"
msgstr "{npc}が疲れきっている"

msgid "{npc}现在不答问题"
msgstr "{npc}は今、問いに答えない"

msgid "精不够：每次耗精 {cost}，精须多于此数"
msgstr "精が足りない：一回ごとに精を{cost}使い、それより多く残っている必要がある"

msgid "%s说道：您太客气了，这怎麽敢当？"
msgstr "%s「そんな、とんでもない。恐れ多いことです」"

msgid "%s像是受宠若惊一样，说道：请教？这怎麽敢当？"
msgstr "%sは恐縮しきった様子で言った。「教えを請うだなんて、とんでもありません」"

msgid "%s笑著说道：您见笑了，我这点雕虫小技怎够资格「指点」您什麽？"
msgstr "%sは笑って言った。「お戯れを。私のつまらない小技で、何を『指南』できましょう？」"

