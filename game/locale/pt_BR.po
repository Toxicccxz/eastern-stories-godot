msgstr "%s{:o} percorre todos os presentes com um olhar estranho."

msgid "{npc}对著你喝道：{self}看你实在很不顺眼，去死吧。"
msgstr "{npc}{:o} grita com você: \"Não vou com a sua cara. Morra.\""

