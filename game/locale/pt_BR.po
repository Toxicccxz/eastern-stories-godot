msgstr "{npc}{:o} não parece ter nada que valha a pena roubar."

msgid "你不动声色地慢慢靠近{npc}，等待机会下手 ..."
msgstr "Sem alarde, devagar, você se aproxima de {npc}{:o} e espera a chance de agir..."

msgid "太可惜了，你下手的目标已经走了。"
msgstr "Que pena: o alvo já foi embora."

msgid "你摸到{item}，可是对你而言太重了，不得不放弃。"
msgstr "Você toca {item}{:o}, mas pesa demais para você, e você tem de largar."

msgid "得手了！"
msgstr "Deu certo!"

msgid "你成功地偷到{item}！"
msgstr "Você roubou {item}{:o} com sucesso!"

msgid "{npc}不经意地一转头，你急忙将手缩了回去！"
msgstr "{npc}{:o} vira a cabeça sem querer, e você puxa a mão às pressas!"

msgid "还好，没有被发现。"
msgstr "Ufa: ninguém viu."

msgid "糟糕！你失手了！"
msgstr "Droga! Você errou!"

msgid "{npc}一回头，正好发现你的手正抓著{pronoun}身上的{item}！"
msgstr "{npc}{:o} se vira bem na hora e vê sua mão em {item}{:o} que {pronoun} traz consigo!"

msgid "{npc}喝道：「干什麽！」"
msgstr "{npc}{:o} grita: \"Ei! O que está fazendo?\""

