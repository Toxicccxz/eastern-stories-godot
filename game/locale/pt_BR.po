msgstr "O vento parou. A grama fica reta, a névoa não se move, e não há som algum ao redor."

msgid "一阵乱风打着旋卷过去，辨不出是从哪边来的。"
msgstr "Uma rajada gira em redemoinho e passa; não dá para dizer de que lado vem."

msgid "风从{quarter}边吹过来，草都朝一边倒。"
msgstr "O vento sopra do {quarter}, e toda a grama se inclina para um lado."

msgid "怀里的风铃轻轻响了一声，清清楚楚。"
msgstr "O sino de vento que você traz junto ao peito toca uma vez, suave e claro."

msgid "怀里的风铃叮叮地响，声音清亮。"
msgstr "O sino de vento que você traz junto ao peito tilinta, claro e brilhante."

msgid "怀里的风铃闷闷地响了两下。"
msgstr "O sino de vento que você traz junto ao peito toca duas vezes, abafado."

msgid "风：停了"
msgstr "Vento: parado"

msgid "风：乱风"
msgstr "Vento: rajadas"

msgid "风：{quarter}风 {arrow}"
msgstr "Vento: do {quarter} {arrow}"

