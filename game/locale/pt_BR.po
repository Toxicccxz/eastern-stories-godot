msgid "%s摇摇头，说道：没听说过。"
msgstr "%s{:o} balança a cabeça: \"Nunca ouvi falar.\""

msgid "%s睁大眼睛望著你，显然不知道你在说什麽。"
msgstr "%s{:o} te olha de olhos arregalados; está claro que não faz ideia do que você está falando."

msgid "%s耸了耸肩，很抱歉地说：无可奉告。"
msgstr "%s{:o} dá de ombros, como quem pede desculpas: \"Não tenho nada a dizer.\""

msgid "%s说道：嗯....这我可不清楚，你最好问问别人吧。"
msgstr "%s{:o} diz: \"Hum... disso eu não sei. Melhor perguntar a outra pessoa.\""

msgid "%s想了一会儿，说道：对不起，你问的事我实在没有印象。"
msgstr "%s{:o} pensa um pouco: \"Desculpe, não me lembro de nada sobre isso.\""

msgid "你向{npc}问道：敢问{respect}尊姓大名？"
msgstr "Você pergunta a {npc}{:o}: \"Posso saber seu nome, {respect}?\""

msgid "你向{npc}问道：这位{respect}，{self}初到贵宝地，不知这里有些什麽风土人情？"
msgstr "Você pergunta a {npc}{:o}: \"Com licença, {respect}: acabo de chegar a estas terras. Quais são os costumes por aqui?\""

msgid "你向{npc}问道：这位{respect}，不知最近有没有听说什麽消息？"
msgstr "Você pergunta a {npc}{:o}: \"Diga, {respect}, ouviu alguma notícia nos últimos dias?\""

msgid "你向{npc}打听有关『{topic}』的消息。"
msgstr "Você pergunta a {npc}{:o} sobre \"{topic}\"."

msgid "但是很显然的，%s现在的状况没有办法给你任何答覆。"
msgstr "Mas está claro que %s{:o} não está em condições de te dar resposta alguma."

msgid "{npc}对你把眼一瞪：{self}的名字是可以随便提的吗？！我看你这{rude}是活腻了！"
msgstr "{npc}{:o} te fuzila com o olhar: \"Quem você pensa que é para sair falando meu nome?! Parece que cansou de viver, {rude}!\""

msgid "{npc}对你哈哈一笑：{npc}便是{self}！"
msgstr "{npc}{:o} solta uma gargalhada: \"{npc}{:o}? Pois sou eu!\""

msgid "{npc}对你作了一揖：这位{respect}可真会开玩笑，怎么会突然问起{self}的名字？"
msgstr "{npc}{:o} junta os punhos e faz uma reverência: \"Gosta de uma brincadeira, hein, {respect}? Por que perguntar meu nome assim, de repente?\""

msgid "{npc}对你说道：这里是{place}，至于其它的，{self}不便多说。"
msgstr "{npc}{:o} te diz: \"Aqui é {place}{:o}. Quanto ao resto, não me cabe dizer.\""

