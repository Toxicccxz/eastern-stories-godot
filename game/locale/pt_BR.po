msgstr "Não há nada em {container}{:o}. Antes, coloque água ou vinho ali para dissolver o pó."

msgid "你将一些{powder}倒进{container}，摇晃了几下。"
msgstr "Você despeja um pouco de {powder}{:0} em {container}{:o} e dá uma sacudida."

msgid "$N和$n仇人相见分外眼红，立刻打了起来！"
msgstr "$N{:o} e $n{:o}, inimigos jurados, se encontram e já partem para a briga!"

msgid "$N对著$n大喝：「可恶，又是你！」"
msgstr "$N{:o} grita para $n{:o}: \"Maldição, você de novo!\""

msgid "$N和$n一碰面，二话不说就打了起来！"
msgstr "$N{:o} e $n{:o} se encontram e, sem dizer uma palavra, partem para a briga!"

msgid "$N一眼瞥见$n，「哼」的一声冲了过来！"
msgstr "$N{:o} avista $n{:o}, bufa e investe!"

msgid "$N一见到$n，愣了一愣，大叫：「我宰了你！」"
msgstr "$N{:o} vê $n{:o}, trava por um instante e grita: \"Vou te matar!\""

