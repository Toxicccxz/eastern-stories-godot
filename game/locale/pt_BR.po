msgid "{master}是你的师父。攻击就是生死相搏；若你亲手杀了{master}，便是弑师，等同背叛师门：\n· 被逐出{family}，门派、师父和称号都没有了。\n· 综合评价清零（现在是 {score}）。\n· 背叛师门的次数变成 {next} 次。\n确定要攻击吗？"
msgstr "{master}{:o} é seu Shifu. Atacar é uma luta até a morte; se você matar {master}{:o} com as próprias mãos, será o assassinato do seu Shifu, e isso conta como trair a sua escola:\n· Expulsão de {family}{:o}: você perde escola, Shifu e título.\n· Sua reputação volta a zero (agora é {score}).\n· Suas traições à escola passam a ser {next}.\nTem certeza de que quer atacar?"

msgid "消息记录"
msgstr "Registro de mensagens"

msgid "刀剑无眼：有人手持兵刃时，切磋中挨的刀剑会留下真伤，伤重了一样会丧命。\n确定要和{npc}切磋吗？"
msgstr "Lâminas não têm olhos: quando alguém empunha uma arma, os cortes recebidos num treino deixam ferimentos de verdade, e ferimentos graves também podem matar.\nTem certeza de que quer treinar com {npc}{:o}?"

msgid "{npc}不会只跟你点到为止：这一场切磋会变成生死相搏。\n确定要和{npc}切磋吗？"
msgstr "{npc}{:o} não vai se contentar com um toque: este treino vai virar uma luta até a morte.\nTem certeza de que quer treinar com {npc}{:o}?"

msgid "{npc}看起来比你强得多：即使只是切磋，一招就可能把你打昏。\n确定要和{npc}切磋吗？"
msgstr "{npc}{:o} parece muito mais forte que você: mesmo num treino, um só golpe pode te deixar inconsciente.\nTem certeza de que quer treinar com {npc}{:o}?"

msgid "{npc}看起来比你强得多，而且有人手持兵刃：切磋中挨的刀剑会留下真伤，伤重了一样会丧命。\n确定要和{npc}切磋吗？"
msgstr "{npc}{:o} parece muito mais forte que você, e alguém empunha uma arma: os cortes recebidos num treino deixam ferimentos de verdade, e ferimentos graves também podem matar.\nTem certeza de que quer treinar com {npc}{:o}?"

msgid "施法驱尸要耗去 {sen} 点神，你现在撑不住，会当场昏过去。\n确定要施法吗？"
msgstr "Levantar mortos custa {sen} de Espírito; você não aguenta isso agora e desmaiaria na hora.\nTem certeza de que quer lançar o feitiço?"

msgid "运功「疗伤他人」：把真气输入对方体内，为他疗伤（耗 150 点内力，内力须比最大内力多 150 以上；双方都不能在战斗中）。"
msgstr "Canalizar \"Curar outro\": você derrama seu Qi verdadeiro no corpo do outro para curá-lo (150 de Força interior; sua Força interior deve superar o máximo em pelo menos 150; nenhum dos dois pode estar em combate)."

msgid "施展「心识神通」：救醒昏迷的人（50 灵力、30 神）。最大灵力不过 101 必定失败，失败时你自己会昏倒。"
msgstr "Usar \"Sentido do coração\": desperta quem está inconsciente (50 de Energia espiritual, 30 de Espírito). Com Energia espiritual máxima de 101 ou menos, sempre falha, e ao falhar você mesmo desmaia."

msgid "心识神通要耗去 {atman} 点灵力和 {sen} 点神。能否救醒{npc}，全看你的灵力修为（最大灵力 {max_atman}）：{odds}\n确定要施展吗？"
msgstr "O Sentido do coração custa {atman} de Energia espiritual e {sen} de Espírito. Conseguir reanimar {npc}{:o} depende por inteiro da sua Energia espiritual (máxima {max_atman}): {odds}\nTem certeza de que quer usá-lo?"

msgid "最大灵力不过 101 必定失败，失败时你自己会当场昏过去。"
msgstr "Com Energia espiritual máxima de 101 ou menos, sempre falha; ao falhar, você desmaia na hora."

msgid "约有 {percent}% 的机会失败，失败时你自己会当场昏过去。"
msgstr "Há cerca de {percent}% de chance de falhar; se falhar, você desmaia na hora."

msgid "你现在的神撑不住这一下，无论成败都会当场昏过去。"
msgstr "Seu Espírito atual não aguenta isso: dê certo ou não, você desmaia na hora."

msgid "偷窃：从对方身上偷一样东西（三秒后见分晓）。失手被发现，对方会和你拼命，城里的巡捕也会把你当贼抓。"
msgstr "Roubar: tira uma coisa do outro (você saberá em três segundos). Se te descobrirem, a vítima luta com você até a morte, e os guardas da cidade te tratam como ladrão."

msgid "行贿：塞钱给押着你的巡捕，钱给够了他就放你走；给少了反倒罪加一等。"
msgstr "Subornar: passa dinheiro ao guarda que te leva preso. Se for o bastante, ele te solta; se for pouco, só piora a sua situação."

msgid "{npc}看起来比你强得多：要是失手被发现，{npc}会和你拼个你死我活。\n确定要下手吗？"
msgstr "{npc}{:o} parece muito mais forte que você: se te descobrirem, {npc}{:o} vai lutar com você até a morte.\nTem certeza de que quer tentar?"

msgid "施法「驱尸」：让这具尸体站起来跟着你（50 法力、30 神）。僵尸靠吸你的灵力维持，灵力不足时就会倒下化为血水。"
msgstr "Lançar \"Levantar mortos\": faz este cadáver se levantar e te seguir (50 de Poder arcano, 30 de Espírito). O zumbi vive da sua Energia espiritual; quando ela acaba, ele cai e se desfaz em sangue."

msgid "确定施法驱尸吗？"
msgstr "Tem certeza de que quer lançar o feitiço de levantar mortos?"

msgid "确定施法"
msgstr "Lançar feitiço"

msgid "确定为{npc}运功疗伤吗？"
msgstr "Tem certeza de que quer canalizar sua Força interior para curar {npc}{:o}?"

msgid "确定运功"
msgstr "Canalizar"

msgid "下手目标：{item}"
msgstr "Alvo do roubo: {item}{:0}"

msgid "随手摸一样"
msgstr "O que vier"

msgid "确定下手"
msgstr "Roubar"

msgid "失手被发现，{npc}会和你拼命。确定要下手吗？"
msgstr "Se te descobrirem, {npc}{:o} vai lutar com você até a morte. Tem certeza de que quer tentar?"

msgid "攻击就是生死相搏。确定要攻击{npc}吗？"
msgstr "Atacar é uma luta até a morte. Tem certeza de que quer atacar {npc}{:o}?"

msgid "切磋点到为止。确定要和{npc}切磋吗？"
msgstr "O treino para no toque. Tem certeza de que quer treinar com {npc}{:o}?"

msgid "确定切磋"
msgstr "Treinar"

msgid "{npc}会拆三回合给你看，点到为止、不伤人。确定要讨教吗？"
msgstr "{npc}{:o} vai trocar golpes com você por três rodadas, sem ferir ninguém. Tem certeza de que quer pedir a lição?"

msgid "确定讨教"
msgstr "Pedir lição"

msgid "化尸粉会把{name}连同里面的 {count} 件物品一起化成一滩黄水，化掉的东西再也找不回来。\n确定要化掉吗？"
msgstr "O pó dissolverá {name}{:o}, com os {count} itens que há dentro, numa poça de água amarela; o que se dissolve não volta mais.\nTem certeza de que quer dissolver?"

msgid "把绳子往脖子上一套，就是寻死：你会就此死去，和战死一样付出死亡的代价。\n确定要上吊吗？"
msgstr "Pôr a corda no pescoço é buscar a morte: você morrerá aqui e pagará o preço da morte como se tivesse caído em combate.\nTem certeza de que quer se enforcar?"

msgid "画这道符要耗去 {sen} 点神，你现在撑不住，会当场昏过去。\n确定要画吗？"
msgstr "Desenhar este talismã custa {sen} de Espírito; você não aguenta isso agora e desmaiaria na hora.\nTem certeza de que quer desenhar?"

msgid "你伤得太重了：画符要咬破手指流血，这一点血就会要了你的命。\n确定要画吗？"
msgstr "Seus ferimentos são graves demais: para desenhar o talismã é preciso morder o dedo e sangrar, e essa gota de sangue te mataria.\nTem certeza de que quer desenhar?"

msgid "{master}是你的师父。{zombie}会追杀{master}，它若得手，就算你弑师，等同背叛师门：\n· 被逐出{family}，门派、师父和称号都没有了。\n· 综合评价清零（现在是 {score}）。\n· 背叛师门的次数变成 {next} 次。\n确定要贴上这道符吗？"
msgstr "{master}{:o} é seu Shifu. {zombie}{:o} vai caçar {master}{:o}; se conseguir, a morte conta como obra sua: é matar o seu Shifu e trair a sua escola:\n· Expulsão de {family}{:o}: você perde escola, Shifu e título.\n· Sua reputação volta a zero (agora é {score}).\n· Suas traições à escola passam a ser {next}.\nTem certeza de que quer colar este talismã?"

msgid "{item}正装备在你身上。确定把它送给{npc}吗？送出去的东西一般就要不回来了。"
msgstr "{item}{:o} está equipado. Tem certeza de que quer dar isso a {npc}{:o}? O que se dá, em geral, não volta."

msgid "确定把{money}送给{npc}吗？送出去的钱一般就要不回来了。"
msgstr "Tem certeza de que quer dar {money} a {npc}{:o}? O dinheiro dado, em geral, não volta."

msgid "{npc}收下{item}，就会当场收你为徒。\n{warning}"
msgstr "Assim que {npc}{:o} aceitar {item}{:o}, você passa a ser discípulo, na hora.\n{warning}"

msgid "{item}不值钱，丢在地上就没人会注意它——丢下就再也找不回来了。\n确定要丢下吗？"
msgstr "{item}{:o} não vale nada. Se você largar isso no chão, ninguém vai reparar, e não há como recuperar.\nTem certeza de que quer largar?"

