msgstr "{npc}{:o} empunha {item}{:o} como arma."

msgid "{npc}收了刀，走了。"
msgstr "{npc}{:o} embainha a espada e vai embora."

msgid "%s急急忙忙地离开了。"
msgstr "%s{:o} sai às pressas."

