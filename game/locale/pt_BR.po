msgstr "Para passar do nível {level}, é preciso Experiência de combate ≥ {required}"

msgid "经验不足，要再学须实战经验 ≥ {required}（你 {have}）"
msgstr "Experiência insuficiente: para aprender mais é preciso Experiência de combate ≥ {required} (você tem {have})"

msgid "学不了：{npc}不肯指点你。"
msgstr "Não dá para aprender: {npc}{:o} não quer te orientar."

msgid "潜能已经用完"
msgstr "Potencial esgotado"

msgid "{npc}太累了"
msgstr "{npc}{:o} está {~:cansado|cansada} demais"

msgid "{npc}现在不答问题"
msgstr "{npc}{:o} não responde perguntas agora"

msgid "精不够：每次耗精 {cost}，精须多于此数"
msgstr "Essência insuficiente: cada lição custa {cost}, e é preciso ter mais que isso"

msgid "%s说道：您太客气了，这怎麽敢当？"
msgstr "%s diz: \"{jogador:O senhor|A senhora} é gentil demais; eu não poderia aceitar.\""

msgid "%s像是受宠若惊一样，说道：请教？这怎麽敢当？"
msgstr "%s parece não caber em si de tanta honra e diz: \"Aprender comigo? Eu não ousaria.\""

msgid "%s笑著说道：您见笑了，我这点雕虫小技怎够资格「指点」您什麽？"
msgstr "%s diz, rindo: \"{jogador:O senhor|A senhora} está de brincadeira. Como minhas modestas habilidades poderiam 'orientar' alguém como {jogador:o senhor|a senhora}?\""

