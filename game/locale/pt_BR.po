msgid "困住对手，让对方一段时间无法出手（{mana} 法力，可能失败）"
msgstr "Prenda o oponente para que ele não possa agir por um tempo ({mana} de Poder arcano, pode falhar)"

msgid "召来一名天将相助（{mana} 法力，可能失败）"
msgstr "Invoque um general celestial para ajudar ({mana} de Poder arcano, pode falhar)"

msgid "召来一名天将或阴鬼卒相助（{mana} 法力、{sen} 神，可能失败）"
msgstr "Invoque um general celestial ou um soldado fantasma para ajudar ({mana} de Poder arcano, {sen} de Espírito, pode falhar)"

msgid "看得见鬼魂，持续的秒数等于你的有效咒文等级（{mana} 法力、{sen} 神）"
msgstr "Veja os fantasmas por tantos segundos quanto seu nível efetivo de Encantamentos básicos ({mana} de Poder arcano, {sen} de Espírito)"

msgid "吸取对方的精"
msgstr "Absorva a Essência do oponente"

msgid "伤对方的神"
msgstr "Fira o Espírito do oponente"

msgid "伤对方的气"
msgstr "Fira o Qi do oponente"

msgid "{hurts}（{mana} 法力、{sen} 神，可能失败）"
msgstr "{hurts} ({mana} de Poder arcano, {sen} de Espírito, pode falhar)"

msgid "你也上去和对手性命相搏，对手会反过来对你下杀手"
msgstr "Entre também na luta até a morte: o oponente vai se voltar contra você para matar"

