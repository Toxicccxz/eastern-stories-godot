msgstr "億"

msgid "兆"
msgstr "兆"

msgid "一"
msgstr "一"

msgid "二"
msgstr "二"

msgid "三"
msgstr "三"

msgid "四"
msgstr "四"

msgid "五"
msgstr "五"

msgid "六"
msgstr "六"

