msgstr "振遠鏢局——顏違。"

msgid "振远镖局——卫盟主。"
msgstr "振遠鏢局——衛盟主。"

msgid "振远镖局——旧盟主。"
msgstr "振遠鏢局——舊盟主。"

msgid "振远镖局——投你。"
msgstr "振遠鏢局——投你。"

msgid "振远镖局——没有来，不算。"
msgstr "振遠鏢局——沒有來，不算。"

msgid "茅山派——颜违。"
msgstr "茅山派——顏違。"

msgid "茅山派——卫盟主。"
msgstr "茅山派——衛盟主。"

msgid "茅山派——旧盟主。"
msgstr "茅山派——舊盟主。"

msgid "茅山派——投你。"
msgstr "茅山派——投你。"

msgid "茅山派——没有来，不算。"
msgstr "茅山派——沒有來，不算。"

msgid "晚月庄——颜违。"
msgstr "晚月莊——顏違。"

msgid "晚月庄——卫盟主。"
msgstr "晚月莊——衛盟主。"

msgid "晚月庄——旧盟主。"
msgstr "晚月莊——舊盟主。"

msgid "晚月庄——投你。"
msgstr "晚月莊——投你。"

msgid "晚月庄——没有来，不算。"
msgstr "晚月莊——沒有來，不算。"

msgid "山烟寺——颜违。"
msgstr "山煙寺——顏違。"

msgid "山烟寺——卫盟主。"
msgstr "山煙寺——衛盟主。"

msgid "山烟寺——旧盟主。"
msgstr "山煙寺——舊盟主。"

msgid "山烟寺——投你。"
msgstr "山煙寺——投你。"

msgid "山烟寺——没有来，不算。"
msgstr "山煙寺——沒有來，不算。"

msgid "步玄派——颜违。"
msgstr "步玄派——顏違。"

msgid "步玄派——卫盟主。"
msgstr "步玄派——衛盟主。"

msgid "步玄派——旧盟主。"
msgstr "步玄派——舊盟主。"

msgid "步玄派——投你。"
msgstr "步玄派——投你。"

msgid "步玄派——没有来，不算。"
msgstr "步玄派——沒有來，不算。"

msgid "花紫会——卫盟主。"
msgstr "花紫會——衛盟主。"

msgid "花紫会——旧盟主。"
msgstr "花紫會——舊盟主。"

msgid "花紫会——颜违。"
msgstr "花紫會——顏違。"

msgid "花紫会——投你。"
msgstr "花紫會——投你。"

msgid "花紫会——没有来，不算。"
msgstr "花紫會——沒有來，不算。"

msgid "绝尘派——卫盟主。"
msgstr "絕塵派——衛盟主。"

msgid "绝尘派——旧盟主。"
msgstr "絕塵派——舊盟主。"

msgid "绝尘派——没有来，不算。"
msgstr "絕塵派——沒有來，不算。"

msgid "颜违，零票。"
msgstr "顏違，零票。"

msgid "颜违，一票。"
msgstr "顏違，一票。"

msgid "颜违，两票。"
msgstr "顏違，兩票。"

msgid "颜违，三票。"
msgstr "顏違，三票。"

msgid "颜违，四票。"
msgstr "顏違，四票。"

msgid "颜违，五票。"
msgstr "顏違，五票。"

msgid "颜违，六票。"
msgstr "顏違，六票。"

msgid "颜违，七票。"
msgstr "顏違，七票。"

msgid "颜违，八票。"
msgstr "顏違，八票。"

msgid "卫盟主，零票。"
msgstr "衛盟主，零票。"

msgid "旧盟主，零票。"
msgstr "舊盟主，零票。"

msgid "卫盟主，一票。"
msgstr "衛盟主，一票。"

msgid "旧盟主，一票。"
msgstr "舊盟主，一票。"

msgid "卫盟主，两票。"
msgstr "衛盟主，兩票。"

msgid "旧盟主，两票。"
msgstr "舊盟主，兩票。"

msgid "卫盟主，三票。"
msgstr "衛盟主，三票。"

msgid "旧盟主，三票。"
msgstr "舊盟主，三票。"

msgid "卫盟主，四票。"
msgstr "衛盟主，四票。"

msgid "旧盟主，四票。"
msgstr "舊盟主，四票。"

msgid "卫盟主，五票。"
msgstr "衛盟主，五票。"

msgid "旧盟主，五票。"
msgstr "舊盟主，五票。"

msgid "卫盟主，六票。"
msgstr "衛盟主，六票。"

msgid "旧盟主，六票。"
msgstr "舊盟主，六票。"

msgid "卫盟主，七票。"
msgstr "衛盟主，七票。"

msgid "旧盟主，七票。"
msgstr "舊盟主，七票。"

msgid "卫盟主，八票。"
msgstr "衛盟主，八票。"

msgid "旧盟主，八票。"
msgstr "舊盟主，八票。"

msgid "卫盟主，九票。"
msgstr "衛盟主，九票。"

msgid "旧盟主，九票。"
msgstr "舊盟主，九票。"

msgid "你，零票。"
msgstr "你，零票。"

msgid "你，一票。"
msgstr "你，一票。"

msgid "你，两票。"
msgstr "你，兩票。"

msgid "你，三票。"
msgstr "你，三票。"

msgid "你，四票。"
msgstr "你，四票。"

msgid "你，五票。"
msgstr "你，五票。"

msgid "你，六票。"
msgstr "你，六票。"

msgid "你，七票。"
msgstr "你，七票。"

msgid "你，八票。"
msgstr "你，八票。"

msgid "过了半数。从今天起，武林盟主是你。"
msgstr "過了半數。從今天起，武林盟主是你。"

msgid "转过身，向你抱了抱拳。九派的人一个一个站了起来。"
msgstr "轉過身，向你抱了抱拳。九派的人一個一個站了起來。"

msgid "武林盟主"
msgstr "武林盟主"

msgid "七长老过了半数。"
msgstr "七長老過了半數。"

msgid "整了整衣襟，走到石椅前，坐了下去。"
msgstr "整了整衣襟，走到石椅前，坐了下去。"

msgid "承蒙诸位。二十年的旧案，到此为止；水烟阁同朝廷，往后好好说话。北麓那座道观里剩下的，剿；东方神教，逐。"
msgstr "承蒙諸位。二十年的舊案，到此為止；水煙閣同朝廷，往後好好說話。北麓那座道觀裡剩下的，剿；東方神教，逐。"

msgid "没有人过半。换盟主要过半——椅子不换人。"
msgstr "沒有人過半。換盟主要過半——椅子不換人。"

msgid "卫盟主过了半数。换盟主要过半，旧盟主过半——椅子不换人。"
msgstr "衛盟主過了半數。換盟主要過半，舊盟主過半——椅子不換人。"

msgid "慢慢站起来，走到石椅前，坐了下去。"
msgstr "慢慢站起來，走到石椅前，坐了下去。"

msgid "老夫回来了，就坐回来。老松岭的旧案，查到底；北麓的孩子，交茅山看着；神教不犯九派，就容它。"
msgstr "老夫回來了，就坐回來。老松嶺的舊案，查到底；北麓的孩子，交茅山看著；神教不犯九派，就容它。"

msgid "老夫回来了，就坐回来。老松岭的旧案，查到底；神教不犯九派，就容它。北麓的孩子——老夫这条命是皇叔拿手诏从尚书府要回来的，欠朝廷一份——交官府看着。"
msgstr "老夫回來了，就坐回來。老松嶺的舊案，查到底；神教不犯九派，就容它。北麓的孩子——老夫這條命是皇叔拿手詔從尚書府要回來的，欠朝廷一份——交官府看著。"

msgid "还有一句：老夫是叫花子从狗洞里领出来的。乔阴的巷子，往后不许官差进。"
msgstr "還有一句：老夫是叫花子從狗洞裡領出來的。喬陰的巷子，往後不許官差進。"

msgid "还有一句：老夫是叫花子从狗洞里领出来的。花紫会要吃官饭，老夫不拦——只是官府的眼线，不许盯九派。"
msgstr "還有一句：老夫是叫花子從狗洞裡領出來的。花紫會要吃官飯，老夫不攔——只是官府的眼線，不許盯九派。"

msgid "没有人过半。换盟主要过半——椅子不换人，还空着，等盟主回来。"
msgstr "沒有人過半。換盟主要過半——椅子不換人，還空著，等盟主回來。"

msgid "旧盟主过了半数——椅子不换人，还空着，等盟主回来。"
msgstr "舊盟主過了半數——椅子不換人，還空著，等盟主回來。"

msgid "七长老照旧代理。"
msgstr "七長老照舊代理。"

msgid "盟主，台上有三件事，九派等你一句话。头一件：朝廷。二十年前老松岭那桩旧案——"
msgstr "盟主，臺上有三件事，九派等你一句話。頭一件：朝廷。二十年前老松嶺那樁舊案——"

msgid "老松岭的旧案："
msgstr "老松嶺的舊案："

msgid "查到底：封地照旧，不许官府过问"
msgstr "查到底：封地照舊，不許官府過問"

msgid "查到底：二十年前老松岭的旧案一查到底，水烟阁的封地照旧，不许官府过问。\n这一句是盟主在虹台上说的，写进武林的规矩，不能收回。要这么说吗？"
msgstr "查到底：二十年前老松嶺的舊案一查到底，水煙閣的封地照舊，不許官府過問。\n這一句是盟主在虹臺上說的，寫進武林的規矩，不能收回。要這麼說嗎？"

msgid "查到底"
msgstr "查到底"

msgid "好。旧案，查到底。"
msgstr "好。舊案，查到底。"

msgid "到此为止：水烟阁同朝廷走近"
msgstr "到此為止：水煙閣同朝廷走近"

msgid "到此为止：老松岭的旧案不再提，水烟阁同朝廷走近。\n这一句是盟主在虹台上说的，写进武林的规矩，不能收回。要这么说吗？"
msgstr "到此為止：老松嶺的舊案不再提，水煙閣同朝廷走近。\n這一句是盟主在虹臺上說的，寫進武林的規矩，不能收回。要這麼說嗎？"

msgid "好。旧案，到此为止。"
msgstr "好。舊案，到此為止。"

msgid "第二件：北麓那座道观里剩下的人。"
msgstr "第二件：北麓那座道觀裡剩下的人。"

msgid "逆灵宫剩下的人："
msgstr "逆靈宮剩下的人："

msgid "剿：一个不留"
msgstr "剿：一個不留"

msgid "剿：北麓那座道观里剩下的人，九派一个不留。\n这一句是盟主在虹台上说的，写进武林的规矩，不能收回。要这么说吗？"
msgstr "剿：北麓那座道觀裡剩下的人，九派一個不留。\n這一句是盟主在虹臺上說的，寫進武林的規矩，不能收回。要這麼說嗎？"

msgid "好。剿。"
msgstr "好。剿。"

msgid "交茅山看管：肯下山的，给一条路"
msgstr "交茅山看管：肯下山的，給一條路"

msgid "交茅山看管：北麓那座道观里剩下的人，肯下山的给一条路，交茅山看着。\n这一句是盟主在虹台上说的，写进武林的规矩，不能收回。要这么说吗？"
msgstr "交茅山看管：北麓那座道觀裡剩下的人，肯下山的給一條路，交茅山看著。\n這一句是盟主在虹臺上說的，寫進武林的規矩，不能收回。要這麼說嗎？"

msgid "交茅山"
msgstr "交茅山"

msgid "好。交茅山。"
msgstr "好。交茅山。"

msgid "第三件：东方神教。"
msgstr "第三件：東方神教。"

msgid "东方神教："
msgstr "東方神教："

msgid "逐：神教的人不许再在江湖上走"
msgstr "逐：神教的人不許再在江湖上走"

msgid "逐：东方神教的人，从今往后不许在九派的地方走。\n这一句是盟主在虹台上说的，写进武林的规矩，不能收回。要这么说吗？"
msgstr "逐：東方神教的人，從今往後不許在九派的地方走。\n這一句是盟主在虹臺上說的，寫進武林的規矩，不能收回。要這麼說嗎？"

msgid "好。逐。"
msgstr "好。逐。"

msgid "容：不犯九派，就容它"
msgstr "容：不犯九派，就容它"

msgid "容：东方神教不犯九派，九派就容它。\n这一句是盟主在虹台上说的，写进武林的规矩，不能收回。要这么说吗？"
msgstr "容：東方神教不犯九派，九派就容它。\n這一句是盟主在虹臺上說的，寫進武林的規矩，不能收回。要這麼說嗎？"

msgid "容"
msgstr "容"

msgid "好。容。"
msgstr "好。容。"

msgid "还有一件。你身上那把旋芒，斩过湖底那颗头——它往后在哪里？"
msgstr "還有一件。你身上那把旋芒，斬過湖底那顆頭——它往後在哪裡？"

msgid "旋芒："
msgstr "旋芒："

msgid "交给水烟阁，供在葬剑亭"
msgstr "交給水煙閣，供在葬劍亭"

msgid "把旋芒交给水烟阁，供在葬剑亭，让九派都看得见：它就不在你手里了。\n要交吗？"
msgstr "把旋芒交給水煙閣，供在葬劍亭，讓九派都看得見：它就不在你手裡了。\n要交嗎？"

msgid "供在葬剑亭"
msgstr "供在葬劍亭"

msgid "你把旋芒交了出去。潘军禅双手接过，用一块黄绫裹了。\n"
msgstr "你把旋芒交了出去。潘軍禪雙手接過，用一塊黃綾裹了。\n"

msgid "还给岚城"
msgstr "還給嵐城"

msgid "把旋芒还给岚城：举起剑，让风把它带回去，岚城云台的旋风里会再转着它。它就不在你手里了。\n要还吗？"
msgstr "把旋芒還給嵐城：舉起劍，讓風把它帶回去，嵐城雲臺的旋風裡會再轉著它。它就不在你手裡了。\n要還嗎？"

msgid "你把旋芒举过头顶。山风从虹谷里卷上来，剑在你手里一轻，转着往西去了。\n"
msgstr "你把旋芒舉過頭頂。山風從虹谷裡捲上來，劍在你手裡一輕，轉著往西去了。\n"

msgid "我留着"
msgstr "我留著"

msgid "旋芒留在你身上：它斩过湖底那颗头，往后还跟着你走。\n九派不再问它的去处。要留着吗？"
msgstr "旋芒留在你身上：它斬過湖底那顆頭，往後還跟著你走。\n九派不再問它的去處。要留著嗎？"

msgid "留着"
msgstr "留著"

msgid "你把旋芒收回鞘里。潘军禅看了你一眼，没有再问。\n"
msgstr "你把旋芒收回鞘裡。潘軍禪看了你一眼，沒有再問。\n"

msgid "散会。"
msgstr "散會。"

msgid "九派的人陆续下了虹台。旗一面一面拔了下来。\n"
msgstr "九派的人陸續下了虹臺。旗一面一面拔了下來。\n"

msgid "看告示"
msgstr "看告示"

msgid "告示上写着：正月十七，九派会于虹台，推举武林盟主。下面一行朱笔：「九派过半，新盟主在此。九派诸事，听盟主吩咐。」\n那新盟主，就是你。\n"
msgstr "告示上寫著：正月十七，九派會於虹臺，推舉武林盟主。下面一行硃筆：「九派過半，新盟主在此。九派諸事，聽盟主吩咐。」\n那新盟主，就是你。\n"

msgid "告示上写着：正月十七，九派会于虹台，推举武林盟主。下面一行朱笔：「九派过半，水烟阁七长老颜违为武林盟主。老松岭旧案，到此为止。」\n"
msgstr "告示上寫著：正月十七，九派會於虹臺，推舉武林盟主。下面一行硃筆：「九派過半，水煙閣七長老顏違為武林盟主。老松嶺舊案，到此為止。」\n"

msgid "告示上写着：正月十七，九派会于虹台，推举武林盟主。下面一行朱笔：「无人过半，盟主之位照旧。卫沧澜盟主复位。」\n"
msgstr "告示上寫著：正月十七，九派會於虹臺，推舉武林盟主。下面一行硃筆：「無人過半，盟主之位照舊。衛滄瀾盟主復位。」\n"

msgid "告示上写着：正月十七，九派会于虹台，推举武林盟主。下面一行朱笔：「无人过半，盟主之位照旧，虚位以待。」\n"
msgstr "告示上寫著：正月十七，九派會於虹臺，推舉武林盟主。下面一行硃筆：「無人過半，盟主之位照舊，虛位以待。」\n"

msgid "坐一坐"
msgstr "坐一坐"

msgid "你在太师椅上坐了一会儿。椅子又硬又凉，扶手让二十年前的手掌磨得发亮。\n"
msgstr "你在太師椅上坐了一會兒。椅子又硬又涼，扶手讓二十年前的手掌磨得發亮。\n"

msgid "樟木匾"
msgstr "樟木匾"

msgid "加入武者同盟"
msgstr "加入武者同盟"

msgid "恭喜，从今天起您已经成为一名武者！"
msgstr "恭喜，從今天起您已經成為一名武者！"

msgid "你已经参加了其他公会。"
msgstr "你已經參加了其他公會。"

msgid "要成为一名武者并不难，水烟阁随时欢迎任何身家清白之人成为我们的\n一份子，只要你加入武者同盟，就可以向同盟中的各大门派拜师\n学艺。\n"
msgstr "要成為一名武者並不難，水煙閣隨時歡迎任何身家清白之人成為我們的\n一份子，只要你加入武者同盟，就可以向同盟中的各大門派拜師\n學藝。\n"

msgid "石碑"
msgstr "石碑"

msgid "石碑上面几个苍劲古朴的字写道：虹谷石台，乙丑年水烟阁第六代\n阁主关雨楼立。\n你仔细一看，这几个字迹丝毫没有斧凿痕迹，竟像是题字的人直接\n用手指在岩石上写出来一般。\n"
msgstr "石碑上面幾個蒼勁古樸的字寫道：虹谷石臺，乙丑年水煙閣第六代\n閣主關雨樓立。\n你仔細一看，這幾個字跡絲毫沒有斧鑿痕跡，竟像是題字的人直接\n用手指在岩石上寫出來一般。\n"

msgid "石碑上龙飞凤武地刻著几个大字：\n\n    风波剑神黎红药前辈葬剑于此，水烟阁第四代七长老比武\n    不胜，以奸计害人而自取其辱，武者皆不齿其小人行径，\n    合力击杀于此，甲辰年立此亭书铭其事以为后人殷鉴。\n\n                        第三代水烟阁主 于兰玫音\n                        第四代水烟阁主 聂    言   合立\n                        第五代水烟阁主 段 柏 山\n"
msgstr "石碑上龍飛鳳武地刻著幾個大字：\n\n    風波劍神黎紅藥前輩葬劍於此，水煙閣第四代七長老比武\n    不勝，以奸計害人而自取其辱，武者皆不齒其小人行徑，\n    合力擊殺於此，甲辰年立此亭書銘其事以為後人殷鑑。\n\n                        第三代水煙閣主 於蘭玫音\n                        第四代水煙閣主 聶    言   合立\n                        第五代水煙閣主 段 柏 山\n"

msgid "擎天柱"
msgstr "擎天柱"

msgid "一根两丈多高的白石柱子，四四方方，上头一道一道刻着箍纹，柱身让几百年的风雨磨圆了角。\n柱脚的石座上刻着历代盟主的名字，一行一行，最早的几行已经看不清了；最后一行是「卫沧澜」三个字，后面空着。\n"
msgstr "一根兩丈多高的白石柱子，四四方方，上頭一道一道刻著箍紋，柱身讓幾百年的風雨磨圓了角。\n柱腳的石座上刻著歷代盟主的名字，一行一行，最早的幾行已經看不清了；最後一行是「衛滄瀾」三個字，後面空著。\n"

msgid "一把整块青白石凿成的椅子，椅背对着南边的深谷，两边扶手上磨出了浅浅的手印。\n椅面上积着几片落叶，石缝里钻出一蓬草——很多年没有人坐过了。\n"
msgstr "一把整塊青白石鑿成的椅子，椅背對著南邊的深谷，兩邊扶手上磨出了淺淺的手印。\n椅面上積著幾片落葉，石縫裡鑽出一蓬草——很多年沒有人坐過了。\n"

msgid "虹谷"
msgstr "虹谷"

msgid "谷底的水雾一阵一阵往上涌，白茫茫的看不见底。\n太阳照过来的时候，雾里挂着一道淡淡的虹，一头搭在虹台的石沿上，一头没进对面的山里——虹谷的名字就是这样来的。\n"
msgstr "谷底的水霧一陣一陣往上湧，白茫茫的看不見底。\n太陽照過來的時候，霧裡掛著一道淡淡的虹，一頭搭在虹臺的石沿上，一頭沒進對面的山裡——虹谷的名字就是這樣來的。\n"

msgid "水烟阁武士喝道：慢著，进水烟阁，先放下你的兵刃！"
msgstr "水煙閣武士喝道：慢著，進水煙閣，先放下你的兵刃！"

msgid "水烟阁武士挡住了你的去路。"
msgstr "水煙閣武士擋住了你的去路。"

msgid "陶壶"
msgstr "陶壺"

msgid "一个手工制造的陶壶, 看起来年代久远.\n"
msgstr "一個手工製造的陶壺, 看起來年代久遠.\n"

msgid "米酒"
msgstr "米酒"

msgid "追风剑"
msgstr "追風劍"

msgid "这是一把淡青色的的长剑，看上去锋利异常。\n"
msgstr "這是一把淡青色的的長劍，看上去鋒利異常。\n"

msgid "绳子"
msgstr "繩子"

msgid "这是一捆粗麻绳. 你可以用它来上吊.\n\n"
msgstr "這是一捆粗麻繩. 你可以用它來上吊.\n\n"

msgid "捆"
msgstr "捆"

msgid "上面刻著一些字:\n行气, 深则蓄, 蓄则伸, 伸则下, 下则定, 定则固, 固则萌, 萌则长, 长则退,\n退则天. 天几舂在上, 地几舂在下, 顺则生, 逆则死.\n"
msgstr "上面刻著一些字:\n行氣, 深則蓄, 蓄則伸, 伸則下, 下則定, 定則固, 固則萌, 萌則長, 長則退,\n退則天. 天幾舂在上, 地幾舂在下, 順則生, 逆則死.\n"

msgid "采石工"
msgstr "採石工"

msgid "沈万年"
msgstr "沈萬年"

msgid "沈记商行掌柜"
msgstr "沈記商行掌櫃"

msgid "你真贪心耶... "
msgstr "你真貪心耶... "

msgid "这样东西... 刚刚有人来要过了."
msgstr "這樣東西... 剛剛有人來要過了."

msgid "一份只要 10 两银子, 保证有效喔.\n"
msgstr "一份只要 10 兩銀子, 保證有效喔.\n"

msgid "老板塞了一包蒙汗药给你。\n"
msgstr "老闆塞了一包蒙汗藥給你。\n"

msgid "想骗我啊?\n"
msgstr "想騙我啊?\n"

msgid "我不知道你给我钱干嘛, 不过谢啦!"
msgstr "我不知道你給我錢幹嘛, 不過謝啦!"

msgid "柜子上一堆冥纸和香烛等, 标价 10 文钱. 墙上挂著几把竹扫帚,\n每把 50 文钱. 柜台上摆著一块木牌, 上面写著:\n棺材: 时价. 没看到的东西问一下掌柜的, 我们应该都有.\n"
msgstr "櫃子上一堆冥紙和香燭等, 標價 10 文錢. 牆上掛著幾把竹掃帚,\n每把 50 文錢. 櫃檯上擺著一塊木牌, 上面寫著:\n棺材: 時價. 沒看到的東西問一下掌櫃的, 我們應該都有.\n"

msgid "我不卖东西给陌生人!"
msgstr "我不賣東西給陌生人!"

msgid "妇人"
msgstr "婦人"

msgid "没见识过我的菜刀神功是吧, 接招!"
msgstr "沒見識過我的菜刀神功是吧, 接招!"

msgid "死小孩, 专们欺负老人家!"
msgstr "死小孩, 專們欺負老人家!"

msgid "以大欺小啊你..."
msgstr "以大欺小啊你..."

msgid "妇人说道：我说啊, 管管你们家那小鬼啊.\n"
msgstr "婦人說道：我說啊, 管管你們家那小鬼啊.\n"

msgid "妇人说道：明知山洞那边闹鬼, 没事带著我们家那两个跑过去.\n"
msgstr "婦人說道：明知山洞那邊鬧鬼, 沒事帶著我們家那兩個跑過去.\n"

msgid "妇人打开锅盖闻了一下.\n"
msgstr "婦人打開鍋蓋聞了一下.\n"

msgid "妇人朝门外看了看.\n"
msgstr "婦人朝門外看了看.\n"

msgid "小孩"
msgstr "小孩"

msgid "工匠"
msgstr "工匠"

msgid "老公公"
msgstr "老公公"

msgid "喊道: 老公我来帮你了!"
msgstr "喊道: 老公我來幫你了!"

msgid "老婆婆"
msgstr "老婆婆"

msgid "叫道: 好啊,敢砍我老婆, 去死吧!"
msgstr "叫道: 好啊,敢砍我老婆, 去死吧!"

msgid "村长"
msgstr "村長"

msgid "嗯...... 你是说那个从古墓盗出来的玉佩?\n"
msgstr "嗯...... 你是說那個從古墓盜出來的玉佩?\n"

msgid "应该蛮珍贵的, 可是有点来路不明...\n"
msgstr "應該蠻珍貴的, 可是有點來路不明...\n"

msgid "我送给一个年轻人了, 不过听说他得此玉佩后性情大变.\n"
msgstr "我送給一個年輕人了, 不過聽說他得此玉佩後性情大變.\n"

msgid "看来此物不祥... \n"
msgstr "看來此物不祥... \n"

msgid "你要找他吗? 有人说他现在以酒度日, 我也不知他的下落.\n"
msgstr "你要找他嗎? 有人說他現在以酒度日, 我也不知他的下落.\n"

msgid "造孽啊........\n"
msgstr "造孽啊........\n"

msgid "国之将亡，必有妖孽。"
msgstr "國之將亡，必有妖孽。"

msgid "望着北边的山，摇了摇头。"
msgstr "望著北邊的山，搖了搖頭。"

msgid "……这回，是真的出来了。"
msgstr "……這回，是真的出來了。"

msgid "听你说孩子回来了，长长地出了一口气。"
msgstr "聽你說孩子回來了，長長地出了一口氣。"

msgid "回来了就好，回来了就好……"
msgstr "回來了就好，回來了就好……"

msgid "拄着拐杖站起来，望着北边的山。"
msgstr "拄著拐杖站起來，望著北邊的山。"

msgid "那洞里的冷，不是人间的冷。我拴那道门的时候就知道。"
msgstr "那洞裡的冷，不是人間的冷。我拴那道門的時候就知道。"

msgid "国之将亡……"
msgstr "國之將亡……"

msgid "顿了很久。"
msgstr "頓了很久。"

msgid "……必有妖孽。"
msgstr "……必有妖孽。"

msgid "我活了九十五年，这句话从来不敢说完。"
msgstr "我活了九十五年，這句話從來不敢說完。"

msgid "看见你身后的阿牛，拐杖在地上顿了一下。"
msgstr "看見你身後的阿牛，拐杖在地上頓了一下。"

msgid "快，快带他去北边路口，他娘在那儿喊了一天了。"
msgstr "快，快帶他去北邊路口，他娘在那兒喊了一天了。"

msgid "阿牛和小翠还在洞里。开了那道木门往里走——洞里有东西，小心。"
msgstr "阿牛和小翠還在洞裡。開了那道木門往裡走——洞裡有東西，小心。"

msgid "叹了一口气。"
msgstr "嘆了一口氣。"

msgid "北边那个山洞？那道门是我拴的，拴了好些年了。洞里冷，冷到骨头缝里——绝对不可以打开。"
msgstr "北邊那個山洞？那道門是我拴的，拴了好些年了。洞裡冷，冷到骨頭縫裡——絕對不可以打開。"

msgid "可妇人家的阿牛，背着他妹妹，又钻进去了。门上那条铁链……早就锈断了。"
msgstr "可婦人家的阿牛，背著他妹妹，又鑽進去了。門上那條鐵鏈……早就鏽斷了。"

msgid "这阵子夜里，洞口那边有声音。不是风。"
msgstr "這陣子夜裡，洞口那邊有聲音。不是風。"

msgid "你要是去，就开了那道木门往里走。把孩子带出来。"
msgstr "你要是去，就開了那道木門往裡走。把孩子帶出來。"

msgid "北边那个山洞？那道门是我拴的。洞里冷，绝对不可以打开。"
msgstr "北邊那個山洞？那道門是我拴的。洞裡冷，絕對不可以打開。"

msgid "村长说道：国之将亡.....\n"
msgstr "村長說道：國之將亡.....\n"

msgid "必有妖孽"
msgstr "必有妖孽"

msgid "对呀.. 你就是妖孽... "
msgstr "對呀.. 你就是妖孽... "

msgid "工匠的小孩"
msgstr "工匠的小孩"

msgid "小孩很好奇地往门缝里看去。\n"
msgstr "小孩很好奇地往門縫裡看去。\n"

msgid "小孩说道：村长说这道门绝对不可以打开喔!\n"
msgstr "小孩說道：村長說這道門絕對不可以打開喔!\n"

msgid "小孩说道：不知道里面是什么...\n"
msgstr "小孩說道：不知道裡面是什麼...\n"

msgid "这是一只体型相当大的蜘蛛, 看来有点吓人.\n\n"
msgstr "這是一隻體型相當大的蜘蛛, 看來有點嚇人.\n\n"

msgid "这是一条平整的石板路, 上面隐约可以看见两道很深的车轮, 看来\n是用来作运输用途的道路. 往西是通往山下的路, 往东你可以看到一些\n建筑物, 像是村庄之类的. 南边看去是一片矮树丛.\n"
msgstr "這是一條平整的石板路, 上面隱約可以看見兩道很深的車輪, 看來\n是用來作運輸用途的道路. 往西是通往山下的路, 往東你可以看到一些\n建築物, 像是村莊之類的. 南邊看去是一片矮樹叢.\n"

msgid "这是一条平整的石板路, 上面隐约可以看见两道很深的车轮, 看来\n是用来作运输用途的道路. 往北是一条较小的碎石路通往村内. 东边有\n一栋石屋, 旁边的空地堆了一些石料. 南边看去是一片矮树丛. 石板路\n往西边延伸.\n"
msgstr "這是一條平整的石板路, 上面隱約可以看見兩道很深的車輪, 看來\n是用來作運輸用途的道路. 往北是一條較小的碎石路通往村內. 東邊有\n一棟石屋, 旁邊的空地堆了一些石料. 南邊看去是一片矮樹叢. 石板路\n往西邊延伸.\n"

msgid "这里是采石场在村口的工作站，一栋小小的木屋立在东边，旁边是一\n条上山的斜坡。路旁有一口井。空地上停著几辆载满石料的车。往西是一\n条铺著大石板的路，一路往山下延伸过去。\n"
msgstr "這裡是採石場在村口的工作站，一棟小小的木屋立在東邊，旁邊是一\n條上山的斜坡。路旁有一口井。空地上停著幾輛載滿石料的車。往西是一\n條鋪著大石板的路，一路往山下延伸過去。\n"

msgid "你走在一条不算宽的碎石路上, 往北是一个交叉路口. 东边有一栋\n木造建筑, 看来相当的破旧, 一片快要散掉似的木牌悬挂在门口, 上面\n的字迹已经不是很清楚了. 往南过去是一条铺著石板的大路.\n"
msgstr "你走在一條不算寬的碎石路上, 往北是一個交叉路口. 東邊有一棟\n木造建築, 看來相當的破舊, 一片快要散掉似的木牌懸掛在門口, 上面\n的字跡已經不是很清楚了. 往南過去是一條鋪著石板的大路.\n"

msgid "这里是青石村唯一的商店 -- 沈记商行, 在这里村民可以购买\n日常生活用品, 工具, 甚至于棺材. 真可以说是一间「杂」货店.\n屋内相当的拥挤, 到处都是箱子和杂物.\n"
msgstr "這裡是青石村唯一的商店 -- 沈記商行, 在這裡村民可以購買\n日常生活用品, 工具, 甚至於棺材. 真可以說是一間「雜」貨店.\n屋內相當的擁擠, 到處都是箱子和雜物.\n"

msgid "你来到一条三叉路口, 往东看去是另一条更小更窄的黄土路, 主要\n道路是南北向的, 西边有一栋民宅.\n"
msgstr "你來到一條三叉路口, 往東看去是另一條更小更窄的黃土路, 主要\n道路是南北向的, 西邊有一棟民宅.\n"

msgid "这是一间简陋的民宅，阴暗窄小的屋内散著一地的柴火和各式工具。\n屋角的石炉上闪著微弱的火光，一锅不知是什么的东西正冒出阵阵香味。\n另一角放著一张简陋的木床和几张椅子。\n"
msgstr "這是一間簡陋的民宅，陰暗窄小的屋內散著一地的柴火和各式工具。\n屋角的石爐上閃著微弱的火光，一鍋不知是什麼的東西正冒出陣陣香味。\n另一角放著一張簡陋的木床和幾張椅子。\n"

msgid "这是一条小小的巷子，地上铺著碎石和黄土。南北各有一栋建筑，不\n过南方的屋子出口不在这边。往东可以看到一个小小的广场，往西则是一\n个三岔路口。\n"
msgstr "這是一條小小的巷子，地上鋪著碎石和黃土。南北各有一棟建築，不\n過南方的屋子出口不在這邊。往東可以看到一個小小的廣場，往西則是一\n個三岔路口。\n"

msgid "这是一间普通的民宅，矮小的屋内整齐地堆著一排排的石板，墙上则\n挂著各式各样的雕刻，切割的工具。屋角放著各式的成品及半成品如石桌\n、石椅、墓碑等。\n"
msgstr "這是一間普通的民宅，矮小的屋內整齊地堆著一排排的石板，牆上則\n掛著各式各樣的雕刻，切割的工具。屋角放著各式的成品及半成品如石桌\n、石椅、墓碑等。\n"

msgid "这是一个小小的广场，地上铺著切割整齐的大石块。广场周围有几间\n屋子，其中以正南边那栋木屋最为特别。往西是一条窄窄的小巷子，往东\n则是连接著采石场的空地。中央有一棵大榕树，像一座凉亭般地立在广场\n上。\n"
msgstr "這是一個小小的廣場，地上鋪著切割整齊的大石塊。廣場周圍有幾間\n屋子，其中以正南邊那棟木屋最為特別。往西是一條窄窄的小巷子，往東\n則是連接著採石場的空地。中央有一棵大榕樹，像一座涼亭般地立在廣場\n上。\n"

msgid "这是一间简陋的民宅, 屋顶隐约还可以看到一些破洞. 墙角堆\n著些柴火, 墙壁上还可以看到烟熏的痕迹. 除了一些简陋的家具外\n屋内空空荡荡的.\n"
msgstr "這是一間簡陋的民宅, 屋頂隱約還可以看到一些破洞. 牆角堆\n著些柴火, 牆壁上還可以看到煙燻的痕跡. 除了一些簡陋的家具外\n屋內空空蕩蕩的.\n"

msgid "这是一间看起来有点不一样的民宅，屋子的中央有一个石制的炉子，\n上面生著一堆火，熊熊的火光把屋内照得像白天似的光亮。墙上挂著几幅\n字画，一边还放了一个木制的书架，上面整齐地排著一些旧得不能再旧的\n书。炉子的旁边摆了一张手工精美的石椅，看来像个很重要的位置。\n"
msgstr "這是一間看起來有點不一樣的民宅，屋子的中央有一個石製的爐子，\n上面生著一堆火，熊熊的火光把屋內照得像白天似的光亮。牆上掛著幾幅\n字畫，一邊還放了一個木製的書架，上面整齊地排著一些舊得不能再舊的\n書。爐子的旁邊擺了一張手工精美的石椅，看來像個很重要的位置。\n"

msgid "这是一片黄土空地，四周堆著一些切割整齐的大石块和碎石。往东看\n去就是采石场，高耸的石璧经过多年的采挖已经看不出原来的模样了。往\n南看去是一些矮小的房舍和储存工具的地方，往西是村内的广场，往北靠\n近广场的地方有一栋简陋的民宅。\n"
msgstr "這是一片黃土空地，四周堆著一些切割整齊的大石塊和碎石。往東看\n去就是採石場，高聳的石璧經過多年的採挖已經看不出原來的模樣了。往\n南看去是一些矮小的房舍和儲存工具的地方，往西是村內的廣場，往北靠\n近廣場的地方有一棟簡陋的民宅。\n"

msgid "这是一间民宅, 屋内除了一张石床外其他一无所有. 昏暗的屋\n内看来死气沉沉的, 似乎这屋子的主人很久没回来了. 屋角有一个\n形状很奇怪的蜘蛛网.\n"
msgstr "這是一間民宅, 屋內除了一張石床外其他一無所有. 昏暗的屋\n內看來死氣沉沉的, 似乎這屋子的主人很久沒回來了. 屋角有一個\n形狀很奇怪的蜘蛛網.\n"

msgid "这里是采石场的工作站，几间矮小的房舍延著山壁建造。靠南的山边\n有一间马房，旁边还堆著山一般的乾草饲料，几辆运输用的车子停在旁边\n。往北看去是采石场的空地往南是一条由石板铺成的小斜坡，通往村前的\n工作站。西边不远处有一栋看来相当特别的房舍。\n"
msgstr "這裡是採石場的工作站，幾間矮小的房舍延著山壁建造。靠南的山邊\n有一間馬房，旁邊還堆著山一般的乾草飼料，幾輛運輸用的車子停在旁邊\n。往北看去是採石場的空地往南是一條由石板鋪成的小斜坡，通往村前的\n工作站。西邊不遠處有一棟看來相當特別的房舍。\n"

msgid "小路到了这里往北就算是出了村子. 西边有一间小小的土地庙, 东\n边是一栋民宅似的建筑, 不过入口不在这边. 往南是一个交叉路口.\n"
msgstr "小路到了這裡往北就算是出了村子. 西邊有一間小小的土地廟, 東\n邊是一棟民宅似的建築, 不過入口不在這邊. 往南是一個交叉路口.\n"

msgid "这是一间小小的土地庙, 庙内相当的暗, 一股湿气混上焚烧冥\n纸的味道使得屋内的的气味显得很奇特. 供桌上零星地放个一些水\n果, 一尊木刻的土地公像孤独地立在前面. 庙外的小空地边有一个\n简陋的金纸亭.\n"
msgstr "這是一間小小的土地廟, 廟內相當的暗, 一股溼氣混上焚燒冥\n紙的味道使得屋內的的氣味顯得很奇特. 供桌上零星地放個一些水\n果, 一尊木刻的土地公像孤獨地立在前面. 廟外的小空地邊有一個\n簡陋的金紙亭.\n"

msgid "一条看来相当荒凉的小路, 两旁杂草丛生, 好像很久都没有人来过\n的样子. 往南很远的地方可以看到村子的入口, 往北的路似乎不是很明\n显.\n"
msgstr "一條看來相當荒涼的小路, 兩旁雜草叢生, 好像很久都沒有人來過\n的樣子. 往南很遠的地方可以看到村子的入口, 往北的路似乎不是很明\n顯.\n"

msgid "小路到了这里以后往北变得很不明显, 往南还可以依稀看到村子的\n入口, 路的四周长满了杂草和小树之类的, 看来相当的荒凉. \n"
msgstr "小路到了這裡以後往北變得很不明顯, 往南還可以依稀看到村子的\n入口, 路的四周長滿了雜草和小樹之類的, 看來相當的荒涼. \n"

msgid "这里是山洞的入口, 往南看去是一条小小的碎石路, 两旁长满\n杂草, 看来很不明显. 往北是一道厚厚的木门, 上面用一条手臂粗\n的铁链拴著. 虽然如此, 你仍可以感到一股寒气从里面透出来.\n"
msgstr "這裡是山洞的入口, 往南看去是一條小小的碎石路, 兩旁長滿\n雜草, 看來很不明顯. 往北是一道厚厚的木門, 上面用一條手臂粗\n的鐵鏈拴著. 雖然如此, 你仍可以感到一股寒氣從裡面透出來.\n"

msgid "山洞很矮，几乎站不直身子，脚下偶尔踩到石头或是些莫名其妙的东西，\n洞内奇寒澈骨，南面是一扇木门，北面隐隐地有些亮光。\n"
msgstr "山洞很矮，幾乎站不直身子，腳下偶爾踩到石頭或是些莫名其妙的東西，\n洞內奇寒澈骨，南面是一扇木門，北面隱隱地有些亮光。\n"

msgid "山洞很矮，几乎站不直身子，脚下偶尔踩到石头或是些莫名其妙的东西，\n洞内奇寒澈骨，南面似乎可以前行，北面是一出口。\n"
msgstr "山洞很矮，幾乎站不直身子，腳下偶爾踩到石頭或是些莫名其妙的東西，\n洞內奇寒澈骨，南面似乎可以前行，北面是一出口。\n"

msgid "这是一段荒芜的山路，显然很少有人走过，东面是陡峭的\n山壁，山壁上零星的长着几棵小树，西面是深不见底的悬崖，\n仔细一听，仿佛下面有潺潺的流水声。山路的南边有一个山洞\n黑乎乎的看不清里面的景色，山路一直向北蜿蜒。\n"
msgstr "這是一段荒蕪的山路，顯然很少有人走過，東面是陡峭的\n山壁，山壁上零星的長著幾棵小樹，西面是深不見底的懸崖，\n仔細一聽，彷彿下面有潺潺的流水聲。山路的南邊有一個山洞\n黑乎乎的看不清裡面的景色，山路一直向北蜿蜒。\n"

msgid "这是一段荒芜的山路，显然很少有人走过，东面是陡峭的\n山壁，山壁上零星的长着几棵小树，西面是深不见底的悬崖，\n仔细一听，仿佛下面有潺潺的流水声。山路一直向北蜿蜒。\n"
msgstr "這是一段荒蕪的山路，顯然很少有人走過，東面是陡峭的\n山壁，山壁上零星的長著幾棵小樹，西面是深不見底的懸崖，\n仔細一聽，彷彿下面有潺潺的流水聲。山路一直向北蜿蜒。\n"

msgid "这是一段荒芜的山路，显然很少有人走过，东面是陡峭的\n山壁，山壁上零星的长着几棵小树，西面是深不见底的悬崖，\n仔细一听，仿佛下面有潺潺的流水声。山路的北边似乎到了\n尽头。\n"
msgstr "這是一段荒蕪的山路，顯然很少有人走過，東面是陡峭的\n山壁，山壁上零星的長著幾棵小樹，西面是深不見底的懸崖，\n仔細一聽，彷彿下面有潺潺的流水聲。山路的北邊似乎到了\n盡頭。\n"

msgid "你走到了山路的尽头，发现三面都是石壁，东面石壁上有一个洞口，洞内隐隐\n发出风雷之声，洞口上方似乎刻着一副图，北面是一扇大石门，\n门上苔迹斑斑，显然已经很久没人打开过了。\n"
msgstr "你走到了山路的盡頭，發現三面都是石壁，東面石壁上有一個洞口，洞內隱隱\n發出風雷之聲，洞口上方似乎刻著一副圖，北面是一扇大石門，\n門上苔跡斑斑，顯然已經很久沒人打開過了。\n"

msgid "这是一间石室，室内透着一种说不清的神秘力量，西边有两张石椅\n东首墙上挂这一把木剑。北边通往大厅，但墙上写了两行字，走近仔细\n辨认，是：非我弟子，莫入此门。\n"
msgstr "這是一間石室，室內透著一種說不清的神秘力量，西邊有兩張石椅\n東首牆上掛這一把木劍。北邊通往大廳，但牆上寫了兩行字，走近仔細\n辨認，是：非我弟子，莫入此門。\n"

msgid "这就是传说中的绝尘子的修行之所，北面是一座佛像，佛像顶部\n有一颗夜明珠发出莹莹的光芒。室内设施古朴，但却一尘不染。\n"
msgstr "這就是傳說中的絕塵子的修行之所，北面是一座佛像，佛像頂部\n有一顆夜明珠發出瑩瑩的光芒。室內設施古樸，但卻一塵不染。\n"

msgid "这是一间石室，西边有一个大厅，大厅中有光线透出来，因此可以看清\n石室中的东西，南边有两个蒲团，似是用来打坐的，此外别无他物。\n"
msgstr "這是一間石室，西邊有一個大廳，大廳中有光線透出來，因此可以看清\n石室中的東西，南邊有兩個蒲團，似是用來打坐的，此外別無他物。\n"

msgid "你来到了一条小溪的旁边，溪水很清澈，缓缓地向南流去，西面\n灌木丛中隐隐的有条小路。\n忽然水中有一道亮光闪过，不过看不清是什么，你是否要下去\n找一找?\n"
msgstr "你來到了一條小溪的旁邊，溪水很清澈，緩緩地向南流去，西面\n灌木叢中隱隱的有條小路。\n忽然水中有一道亮光閃過，不過看不清是什麼，你是否要下去\n找一找?\n"

msgid "从这里向四周望去，只见一片无垠的绿野，然而地面上似乎\n罩着一层神密的薄雾，渐渐地远处的景色模糊起来，你觉得\n自己正深处一个飘忽的所在。你一回身，看见有一个路牌\n树在那里。\n"
msgstr "從這裡向四周望去，只見一片無垠的綠野，然而地面上似乎\n罩著一層神密的薄霧，漸漸地遠處的景色模糊起來，你覺得\n自己正深處一個飄忽的所在。你一回身，看見有一個路牌\n樹在那裡。\n"

msgid "从这里向四周望去，只见群山环绕，不知所处，地面上似乎\n罩着一层神密的薄雾，渐渐地远处的景色模糊起来，你觉得\n自己正深处一个飘忽的所在。你一回身，看见有一个路牌树\n在那里。\n"
msgstr "從這裡向四周望去，只見群山環繞，不知所處，地面上似乎\n罩著一層神密的薄霧，漸漸地遠處的景色模糊起來，你覺得\n自己正深處一個飄忽的所在。你一回身，看見有一個路牌樹\n在那裡。\n"

msgid "从这里向四周望去，只见四面环水，只有脚下一点陆地，水面上\n似乎罩着一层神密的薄雾，渐渐地远处的景色模糊起来，你觉得\n自己正深处一个飘忽的所在。你一回身，看见有一个路牌树\n在那里。\n"
msgstr "從這裡向四周望去，只見四面環水，只有腳下一點陸地，水面上\n似乎罩著一層神密的薄霧，漸漸地遠處的景色模糊起來，你覺得\n自己正深處一個飄忽的所在。你一回身，看見有一個路牌樹\n在那裡。\n"

msgid "从这里向四周望去，只见寒风阵阵，奇寒澈骨，如入北极风洞，四周\n似乎罩着一层神密的薄雾，风吹不散，渐渐地远处的景色模糊起来，你\n觉得自己正深处一个飘忽的所在。你一回身，看见有一个路牌树\n在那里。\n"
msgstr "從這裡向四周望去，只見寒風陣陣，奇寒澈骨，如入北極風洞，四周\n似乎罩著一層神密的薄霧，風吹不散，漸漸地遠處的景色模糊起來，你\n覺得自己正深處一個飄忽的所在。你一回身，看見有一個路牌樹\n在那裡。\n"

msgid "从这里向四周望去，只见铅云低沉，忽然一道闪电，跟着一阵巨雷，\n远山为之回响，身旁似乎罩着一层神密的薄雾，渐渐地远处的景色\n模糊起来，你觉得自己正深处一个飘忽的所在。你一回身，看见有\n一个路牌树在那里。\n"
msgstr "從這裡向四周望去，只見鉛雲低沉，忽然一道閃電，跟著一陣巨雷，\n遠山為之迴響，身旁似乎罩著一層神密的薄霧，漸漸地遠處的景色\n模糊起來，你覺得自己正深處一個飄忽的所在。你一回身，看見有\n一個路牌樹在那裡。\n"

msgid "从这里向四周望去，只见火光冲天，炽热难当，身旁似乎罩着一层\n神密的薄雾，渐渐地远处的景色模糊起来，你觉得自己正深处一个\n飘忽的所在。你一回身，看见有一个路牌树在那里。\n"
msgstr "從這裡向四周望去，只見火光沖天，熾熱難當，身旁似乎罩著一層\n神密的薄霧，漸漸地遠處的景色模糊起來，你覺得自己正深處一個\n飄忽的所在。你一回身，看見有一個路牌樹在那裡。\n"

msgid "从这里向四周望去，只见身处一个大湖泊之中，脚下只有四尺见方的\n一块陆地，湖上似乎罩着一层神密的薄雾，渐渐地远处的景色模糊起来，\n你觉得自己正深处一个飘忽的所在。你一回身，看见有一个路牌\n树在那里。\n"
msgstr "從這裡向四周望去，只見身處一個大湖泊之中，腳下只有四尺見方的\n一塊陸地，湖上似乎罩著一層神密的薄霧，漸漸地遠處的景色模糊起來，\n你覺得自己正深處一個飄忽的所在。你一回身，看見有一個路牌\n樹在那裡。\n"

msgid "从这里向四周望去，只见长天一碧，沃野千里，正自心旷神怡，\n那层神密的薄雾又起，渐渐地远处的景色模糊起来，你觉得自\n己正深处一个飘忽的所在。你一回身，看见有一个路牌\n树在那里。\n"
msgstr "從這裡向四周望去，只見長天一碧，沃野千里，正自心曠神怡，\n那層神密的薄霧又起，漸漸地遠處的景色模糊起來，你覺得自\n己正深處一個飄忽的所在。你一回身，看見有一個路牌\n樹在那裡。\n"

msgid "这是一块绝地,四周没有任何出口,你不禁急得要哭了出来,忽然,你发现\n远方有一块大石动了一下,走近一看,似乎可以推一下。\n"
msgstr "這是一塊絕地,四周沒有任何出口,你不禁急得要哭了出來,忽然,你發現\n遠方有一塊大石動了一下,走近一看,似乎可以推一下。\n"

msgid "大石门"
msgstr "大石門"

msgid "密门"
msgstr "密門"

msgid "井"
msgstr "井"

msgid "图"
msgstr "圖"

msgid "这是一副八卦阵图,图下面有一行模糊的小字：八卦古阵\n"
msgstr "這是一副八卦陣圖,圖下面有一行模糊的小字：八卦古陣\n"

msgid "路牌上写着：  坤--坤为地，遇青龙而生，遇玄武而死，遇白虎而困，遇朱雀而涉。\n"
msgstr "路牌上寫著：  坤--坤為地，遇青龍而生，遇玄武而死，遇白虎而困，遇朱雀而涉。\n"

msgid "路牌上写着：  艮--艮为山，遇青龙而涉，遇玄武而生，遇白虎而死，遇朱雀而困。\n"
msgstr "路牌上寫著：  艮--艮為山，遇青龍而涉，遇玄武而生，遇白虎而死，遇朱雀而困。\n"

msgid "路牌上写着：  坎--坎为水，遇青龙而死，遇玄武而涉，遇白虎而生，遇朱雀而困。\n"
msgstr "路牌上寫著：  坎--坎為水，遇青龍而死，遇玄武而涉，遇白虎而生，遇朱雀而困。\n"

msgid "路牌上写着：  巽--巽为风，遇青龙而生，遇玄武而死，遇白虎而涉，遇朱雀而困。\n"
msgstr "路牌上寫著：  巽--巽為風，遇青龍而生，遇玄武而死，遇白虎而涉，遇朱雀而困。\n"

msgid "路牌上写着：  震--震为雷，遇青龙而涉，遇玄武而生，遇白虎而困，遇朱雀而死。\n"
msgstr "路牌上寫著：  震--震為雷，遇青龍而涉，遇玄武而生，遇白虎而困，遇朱雀而死。\n"

msgid "路牌上写着：  离--离为火，遇青龙而死，遇玄武而涉，遇白虎而生，遇朱雀而困。\n"
msgstr "路牌上寫著：  離--離為火，遇青龍而死，遇玄武而涉，遇白虎而生，遇朱雀而困。\n"

msgid "路牌上写着：  兑--兑为泽，遇青龙而困，遇玄武而生，遇白虎而死，遇朱雀而涉。\n"
msgstr "路牌上寫著：  兌--兌為澤，遇青龍而困，遇玄武而生，遇白虎而死，遇朱雀而涉。\n"

msgid "路牌上写着：  乾--乾为天，遇青龙而死，遇玄武而困，遇白虎而涉，遇朱雀而生。\n"
msgstr "路牌上寫著：  乾--乾為天，遇青龍而死，遇玄武而困，遇白虎而涉，遇朱雀而生。\n"

msgid "大石"
msgstr "大石"

msgid "推"
msgstr "推"

msgid "远方有一块大石动了一下,走近一看,似乎可以推一下。\n"
msgstr "遠方有一塊大石動了一下,走近一看,似乎可以推一下。\n"

msgid "你出力不太够喔！"
msgstr "你出力不太夠喔！"

msgid "你用力推活动的大岩石,大岩石动了一下"
msgstr "你用力推活動的大岩石,大岩石動了一下"

msgid "大岩石滚开了,你从大岩石后面的小洞钻了出去"
msgstr "大岩石滾開了,你從大岩石後面的小洞鑽了出去"

msgid "四周没有任何出口。推不动那块大石的话，就只能在这里等下去了。\n"
msgstr "四周沒有任何出口。推不動那塊大石的話，就只能在這裡等下去了。\n"

msgid "你在绝地里苦等良久，终于昏昏沉沉地睡了过去……醒来时，你已经躺在雪亭镇的饮风客栈里。"
msgstr "你在絕地裡苦等良久，終於昏昏沉沉地睡了過去……醒來時，你已經躺在雪亭鎮的飲風客棧裡。"

msgid "水"
msgstr "水"

msgid "下水寻找"
msgstr "下水尋找"

msgid "溪水很清澈，水中忽然有一道亮光闪过，不过看不清是什么。\n"
msgstr "溪水很清澈，水中忽然有一道亮光閃過，不過看不清是什麼。\n"

msgid "你跳入溪水之中，开始仔细寻找...."
msgstr "你跳入溪水之中，開始仔細尋找...."

msgid "你竟从水中找出一把追风剑!"
msgstr "你竟從水中找出一把追風劍!"

msgid "你在水中忙了半天，结果一无所获。"
msgstr "你在水中忙了半天，結果一無所獲。"

msgid "蜘蛛网"
msgstr "蜘蛛網"

msgid "一个很大的蜘蛛网.\n"
msgstr "一個很大的蜘蛛網.\n"

msgid "突然你觉得头上有个阴影, 不自觉的抬起头来一看 ............好大的 ..... 蜘蛛..... \n"
msgstr "突然你覺得頭上有個陰影, 不自覺的抬起頭來一看 ............好大的 ..... 蜘蛛..... \n"

msgid "你向石洞走去，忽然一阵狂风涌至，你抵受不住，只好退了回来"
msgstr "你向石洞走去，忽然一陣狂風湧至，你抵受不住，只好退了回來"

msgid "入口被魔法封住了！"
msgstr "入口被魔法封住了！"

msgid "青布道袍"
msgstr "青布道袍"

msgid "一件式样简单的青布道袍\n"
msgstr "一件式樣簡單的青布道袍\n"

msgid "黑布鞋"
msgstr "黑布鞋"

msgid "魔法入门"
msgstr "魔法入門"

msgid "这似乎是一本魔法的入门书，里面说了一些稀奇古怪的和一般的武学不同的东西\n"
msgstr "這似乎是一本魔法的入門書，裡面說了一些稀奇古怪的和一般的武學不同的東西\n"

msgid "符咒简介"
msgstr "符咒簡介"

msgid "这似乎是一本符咒的简介，里面画着一些稀奇古怪的符号\n"
msgstr "這似乎是一本符咒的簡介，裡面畫著一些稀奇古怪的符號\n"

msgid "拂尘"
msgstr "拂塵"

msgid "一柄以藤木为柄, 马尾为丝的拂尘\n"
msgstr "一柄以藤木為柄, 馬尾為絲的拂塵\n"

msgid "旧道袍"
msgstr "舊道袍"

msgid "一件补了又补, 洗到泛白的旧道袍\n"
msgstr "一件補了又補, 洗到泛白的舊道袍\n"

msgid "青铜道冠"
msgstr "青銅道冠"

msgid "一顶青铜道冠\n"
msgstr "一頂青銅道冠\n"

msgid "八卦道袍"
msgstr "八卦道袍"

msgid "一件胸前绣有八卦的黄色道袍。\n"
msgstr "一件胸前繡有八卦的黃色道袍。\n"

msgid "碧玉冠"
msgstr "碧玉冠"

msgid "一顶镶著一块碧玉的道冠。\n"
msgstr "一頂鑲著一塊碧玉的道冠。\n"

msgid "一个福福泰泰的中年人, 他正气喘嘘嘘地走著石梯道\n"
msgstr "一個福福泰泰的中年人, 他正氣喘噓噓地走著石梯道\n"

msgid "茅山派第八代弟子"
msgstr "茅山派第八代弟子"

msgid "一个长得眉清目秀的小男孩, 正努力地在打扫石阶\n"
msgstr "一個長得眉清目秀的小男孩, 正努力地在打掃石階\n"

msgid "僵尸侍者是林忌的弟子，着一身黑色的道袍\n"
msgstr "殭屍侍者是林忌的弟子，著一身黑色的道袍\n"

msgid "僵尸侍者说道：我们茅山派实力最强！谁敢欺负我们？\n"
msgstr "殭屍侍者說道：我們茅山派實力最強！誰敢欺負我們？\n"

msgid "僵尸侍者说道：大家快加入茅山派吧! \n"
msgstr "殭屍侍者說道：大家快加入茅山派吧! \n"

msgid "茅山派不和别派的人过招。"
msgstr "茅山派不和別派的人過招。"

msgid "僵尸护法是茅山派的护法，着一身黑色的道袍\n"
msgstr "殭屍護法是茅山派的護法，著一身黑色的道袍\n"

msgid "玄和"
msgstr "玄和"

msgid "一个长得眉清目秀的小男孩, 正忙著浇花除草\n"
msgstr "一個長得眉清目秀的小男孩, 正忙著澆花除草\n"

msgid "老道士"
msgstr "老道士"

msgid "一位四处云游的老道士, 他正在观心观挂单中。\n看他饱经沧桑的脸孔, 似乎他也是经历过无数的大风大浪。\n"
msgstr "一位四處雲遊的老道士, 他正在觀心觀掛單中。\n看他飽經滄桑的臉孔, 似乎他也是經歷過無數的大風大浪。\n"

msgid "无量寿佛 ! 贫道年迈力衰, 怎是施主的对手。"
msgstr "無量壽佛 ! 貧道年邁力衰, 怎是施主的對手。"

msgid "茅山派第六代弟子"
msgstr "茅山派第六代弟子"

msgid "一位神色和平的中年道士, 他正在教授他的徒弟如何运功导气\n"
msgstr "一位神色和平的中年道士, 他正在教授他的徒弟如何運功導氣\n"

msgid "茅山派第七代弟子"
msgstr "茅山派第七代弟子"

msgid "一位身材魁武的年轻道士, 他正在练拳, 你看他舞得虎虎生风\n"
msgstr "一位身材魁武的年輕道士, 他正在練拳, 你看他舞得虎虎生風\n"

msgid "清灵"
msgstr "清靈"

msgid "一位神情专注的道士, 他正轮值到看守藏经楼。\n"
msgstr "一位神情專注的道士, 他正輪值到看守藏經樓。\n"

msgid "清平"
msgstr "清平"

msgid "清风"
msgstr "清風"

msgid "清音"
msgstr "清音"

msgid "这是一条宽敞坚实的青石大道, 大道沿著山腰往南向山下延伸, 东\n边是一条石英岩石阶蜿蜒往山上而去。在石阶的尽头, 是一座颇为雄伟\n的道观, 在江湖跑过的人都知道, 那是茅山派的所在地。\n"
msgstr "這是一條寬敞堅實的青石大道, 大道沿著山腰往南向山下延伸, 東\n邊是一條石英岩石階蜿蜒往山上而去。在石階的盡頭, 是一座頗為雄偉\n的道觀, 在江湖跑過的人都知道, 那是茅山派的所在地。\n"

msgid "你正站在这阶梯的起点, 纯白色宽敞的石英岩阶梯蜿蜒而上, 在青\n翠的山色中形成一条纯白色的巨龙。抬头仰望石阶尽头的那座庙宇, 虽\n然无情的岁月已经在它身上留下痕迹, 但仍不失其庄严神圣的气息。\n"
msgstr "你正站在這階梯的起點, 純白色寬敞的石英岩階梯蜿蜒而上, 在青\n翠的山色中形成一條純白色的巨龍。抬頭仰望石階盡頭的那座廟宇, 雖\n然無情的歲月已經在它身上留下痕跡, 但仍不失其莊嚴神聖的氣息。\n"

msgid "你正走在一道长长的石英岩阶梯上, 阶梯的两侧种植著一排高耸\n的松树。雪亭镇就在西边不远的山下, 你隐约还能听到从镇上传来的\n话语声。\n"
msgstr "你正走在一道長長的石英岩階梯上, 階梯的兩側種植著一排高聳\n的松樹。雪亭鎮就在西邊不遠的山下, 你隱約還能聽到從鎮上傳來的\n話語聲。\n"

msgid "你正走在一道长长的石英岩阶梯上, 阶梯的两侧种植著一排高耸\n的松树。雪亭镇就在西边不远的山下, 你隐约还能听到从镇上传来的\n话语声。阶梯从这里弯向北边。\n"
msgstr "你正走在一道長長的石英岩階梯上, 階梯的兩側種植著一排高聳\n的松樹。雪亭鎮就在西邊不遠的山下, 你隱約還能聽到從鎮上傳來的\n話語聲。階梯從這裡彎向北邊。\n"

msgid "你正走在一道长长的石英岩阶梯上, 阶梯的两侧种植著一排高耸\n的松树。抬头望望东北边那座高耸挺拔的山峰, 在云雾飘渺的山顶上\n, 矗立著一座雄伟的白色楼阁。\n"
msgstr "你正走在一道長長的石英岩階梯上, 階梯的兩側種植著一排高聳\n的松樹。抬頭望望東北邊那座高聳挺拔的山峰, 在雲霧飄渺的山頂上\n, 矗立著一座雄偉的白色樓閣。\n"

msgid "长长的阶梯也终将到了尽头, 阶梯的尽头矗立著一座山门, 山门\n上龙飞凤舞地写了三个字, 笔力苍劲有力显得气势非凡。山风吹来带\n著丝丝的寒意, 令你有股高处不胜寒的感觉。\n"
msgstr "長長的階梯也終將到了盡頭, 階梯的盡頭矗立著一座山門, 山門\n上龍飛鳳舞地寫了三個字, 筆力蒼勁有力顯得氣勢非凡。山風吹來帶\n著絲絲的寒意, 令你有股高處不勝寒的感覺。\n"

msgid "在你眼前是一座古色古香的山门, 上面以龙飞凤舞的笔迹书写著\n「灵心观」三字, 据说是当年太阳神君「杞庸」亲笔所题。往北方看\n过去是一个颇大的广场。门前则是一条石英岩铺设的阶梯沿著山腰往\n东而下。\n"
msgstr "在你眼前是一座古色古香的山門, 上面以龍飛鳳舞的筆跡書寫著\n「靈心觀」三字, 據說是當年太陽神君「杞庸」親筆所題。往北方看\n過去是一個頗大的廣場。門前則是一條石英岩鋪設的階梯沿著山腰往\n東而下。\n"

msgid "你正站在灵心观前的广场前, 一片用石英岩铺成的广场。一对雄\n伟的石狮子站在庙门的两侧, 狮子的两侧立著两根雕著龙纹的石柱。\n广场的中央还有一个大香炉, 香炉里正冒著袅袅的香烟。\n"
msgstr "你正站在靈心觀前的廣場前, 一片用石英岩鋪成的廣場。一對雄\n偉的石獅子站在廟門的兩側, 獅子的兩側立著兩根雕著龍紋的石柱。\n廣場的中央還有一個大香爐, 香爐裡正冒著裊裊的香煙。\n"

msgid "你现在来到灵心观的大殿, 在你的眼前是一尊真武大帝的金身。\n在金身的下方是一张朱红色的大供桌, 上面排满了鲜花素果。在桌子\n的前方则摆放著三四个蒲团。东西两侧的圆形拱门通往连接后殿的回\n廊。走过南边的红漆木门就是广场。\n"
msgstr "你現在來到靈心觀的大殿, 在你的眼前是一尊真武大帝的金身。\n在金身的下方是一張朱紅色的大供桌, 上面排滿了鮮花素果。在桌子\n的前方則擺放著三四個蒲團。東西兩側的圓形拱門通往連接後殿的回\n廊。走過南邊的紅漆木門就是廣場。\n"

msgid "你现在正走在一条回廊上, 西北方是一座花木扶苏的天井, 穿过\n西边的圆形拱门就可以回到大殿。\n"
msgstr "你現在正走在一條迴廊上, 西北方是一座花木扶蘇的天井, 穿過\n西邊的圓形拱門就可以回到大殿。\n"

msgid "你现在正走在一条回廊上, 东北方是一座花木扶苏的天井, 穿过\n东边的圆形拱门就可以回到大殿。\n"
msgstr "你現在正走在一條迴廊上, 東北方是一座花木扶蘇的天井, 穿過\n東邊的圓形拱門就可以回到大殿。\n"

msgid "你正走在一条回廊之上, 回廊往南北延伸, 两端分别连接著大殿\n及后殿。西边是一座花草扶苏的天井, 东边则是一排厢房。\n"
msgstr "你正走在一條迴廊之上, 迴廊往南北延伸, 兩端分別連接著大殿\n及後殿。西邊是一座花草扶蘇的天井, 東邊則是一排廂房。\n"

msgid "你正走在一条回廊之上, 回廊往南北延伸, 两端分别连接著大殿\n及后殿。东边是一座花草扶苏的天井, 西边是一间上了锁的房间。\n"
msgstr "你正走在一條迴廊之上, 迴廊往南北延伸, 兩端分別連接著大殿\n及後殿。東邊是一座花草扶蘇的天井, 西邊是一間上了鎖的房間。\n"

msgid "你正站在灵心观的天井里, 这里种植著一些花草树木, 在西北角\n落里有著一口水井。北边就是供俸茅山派历代掌门人的地方, 南边则\n是一面墙, 墙的另一侧就是大殿。\n"
msgstr "你正站在靈心觀的天井裡, 這裡種植著一些花草樹木, 在西北角\n落裡有著一口水井。北邊就是供俸茅山派歷代掌門人的地方, 南邊則\n是一面牆, 牆的另一側就是大殿。\n"

msgid "这是一间供香客或其他江湖同道休息挂单的客房, 屋子里只是简\n单地摆放著几件家俱。从西边的天井中, 传来了阵阵的花香。\n"
msgstr "這是一間供香客或其他江湖同道休息掛單的客房, 屋子裡只是簡\n單地擺放著幾件家俱。從西邊的天井中, 傳來了陣陣的花香。\n"

msgid "你正站在回廊转角的地方, 回廊从这往西及南边而去。在走廊\n的东侧是一排厢房。北方是一条铺著青石板的小径。\n"
msgstr "你正站在迴廊轉角的地方, 迴廊從這往西及南邊而去。在走廊\n的東側是一排廂房。北方是一條鋪著青石板的小徑。\n"

msgid "你现在走在围绕著天井的回廊上, 回廊往东西两侧延伸, 南边就\n是天井, 你也许可以走过去赏赏花, 散散心。在你的北方, 走过那扇\n红漆木门就是后殿, 也是茅山派供奉历代掌门人灵位的地方。\n"
msgstr "你現在走在圍繞著天井的迴廊上, 迴廊往東西兩側延伸, 南邊就\n是天井, 你也許可以走過去賞賞花, 散散心。在你的北方, 走過那扇\n紅漆木門就是後殿, 也是茅山派供奉歷代掌門人靈位的地方。\n"

msgid "你正站在回廊转角的地方, 回廊从这往东边及南边而去。在北边\n是一间大房子, 里面传来阵阵叱喝的声音。\n"
msgstr "你正站在迴廊轉角的地方, 迴廊從這往東邊及南邊而去。在北邊\n是一間大房子, 裡面傳來陣陣叱喝的聲音。\n"

msgid "这是一间供香客或其他江湖同道休息挂单的客房, 屋子里只是简\n单地摆放著几件家俱。你闻到天井中传来淡淡的花香。\n"
msgstr "這是一間供香客或其他江湖同道休息掛單的客房, 屋子裡只是簡\n單地擺放著幾件家俱。你聞到天井中傳來淡淡的花香。\n"

msgid "你正站在灵心观的后殿, 正中央供奉著茅山派开山祖师张天师的\n画像, 在画像的下方摆放著当年张天师收妖伏魔时所用的宝剑。剑的\n两旁陪祀著历代掌门人的牌位。走出南边的红漆木门可以看到天井。\n"
msgstr "你正站在靈心觀的後殿, 正中央供奉著茅山派開山祖師張天師的\n畫像, 在畫像的下方擺放著當年張天師收妖伏魔時所用的寶劍。劍的\n兩旁陪祀著歷代掌門人的牌位。走出南邊的紅漆木門可以看到天井。\n"

msgid "你正站在一间宽阔的大房间里, 这里是茅山派弟子打坐练功的地\n方, 空气中弥漫著一股股汗臭味。四周的墙壁上画著一幅幅经脉穴道\n图。靠近墙壁的地上则摆著一个个练功用的木人。\n"
msgstr "你正站在一間寬闊的大房間裡, 這裡是茅山派弟子打坐練功的地\n方, 空氣中瀰漫著一股股汗臭味。四周的牆壁上畫著一幅幅經脈穴道\n圖。靠近牆壁的地上則擺著一個個練功用的木人。\n"

msgid "一条铺著青石板的小径, 两侧高大的松树, 偶有松针缓缓飘落。\n树干上布满了青苔, 甚至还有些蔓延到石板上。南边通往回廊, 西侧\n则是后殿。\n"
msgstr "一條鋪著青石板的小徑, 兩側高大的松樹, 偶有松針緩緩飄落。\n樹幹上佈滿了青苔, 甚至還有些蔓延到石板上。南邊通往迴廊, 西側\n則是後殿。\n"

msgid "绕过了后殿, 出现在眼前的是一栋木造两层高的屋子。屋子四周\n的门窗都紧紧的关著, 门口上方挂著一方蓝色琉璃匾额, 上书『藏经\n楼』三个金字。门旁立著一个石碑。\n"
msgstr "繞過了後殿, 出現在眼前的是一棟木造兩層高的屋子。屋子四周\n的門窗都緊緊的關著, 門口上方掛著一方藍色琉璃匾額, 上書『藏經\n樓』三個金字。門旁立著一個石碑。\n"

msgid "这里是灵心观中收藏书籍的地方, 四周的书架上堆了满满的书。\n有些书已经旧的纸张都泛黄了, 摸一摸可能就会散掉甚至变成飞灰。\n你再仔细的看了看, 发现这里都只是些寻常的修道的书籍, 似乎没有\n什么特别的。角落里有一座小小的木梯通往二楼。\n"
msgstr "這裡是靈心觀中收藏書籍的地方, 四周的書架上堆了滿滿的書。\n有些書已經舊的紙張都泛黃了, 摸一摸可能就會散掉甚至變成飛灰。\n你再仔細的看了看, 發現這裡都只是些尋常的修道的書籍, 似乎沒有\n什麼特別的。角落裡有一座小小的木梯通往二樓。\n"

msgid "上了楼来, 首先你看到一幅张天师的画像挂在对面的墙上, 画像\n的下方摆著一张覆著红布的桌子, 桌上整齐地放著茅山的镇教秘籍。\n"
msgstr "上了樓來, 首先你看到一幅張天師的畫像掛在對面的牆上, 畫像\n的下方擺著一張覆著紅布的桌子, 桌上整齊地放著茅山的鎮教秘籍。\n"

msgid "红漆木门"
msgstr "紅漆木門"

msgid "镇教秘籍"
msgstr "鎮教秘籍"

msgid "红布桌上的镇教秘籍一函一函码得整整齐齐。你数过去，是六函；第七函的位置空着，红布上压着一张发黄的字条：\n\n    书我带走。师兄守山，我守人。\n\n"
msgstr "紅布桌上的鎮教秘籍一函一函碼得整整齊齊。你數過去，是六函；第七函的位置空著，紅布上壓著一張發黃的字條：\n\n    書我帶走。師兄守山，我守人。\n\n"

msgid "石碑上写著 : \n\n    非\n    茅  不\n    山  得\n    弟  进\n    子  入\n\n"
msgstr "石碑上寫著 : \n\n    非\n    茅  不\n    山  得\n    弟  進\n    子  入\n\n"

msgid "一道无形的墙挡住了门口, 差点把你的鼻子给撞扁了。"
msgstr "一道無形的牆擋住了門口, 差點把你的鼻子給撞扁了。"

msgid "你推开门走了进去, 顺手把门关了起来。"
msgstr "你推開門走了進去, 順手把門關了起來。"

msgid "你拉开门大步走了出去, 随手把门带上。"
msgstr "你拉開門大步走了出去, 隨手把門帶上。"

msgid "你一脚踩在青苔上, 不小心滑了一跤, 四脚朝天地摔在地上起不来。"
msgstr "你一腳踩在青苔上, 不小心滑了一跤, 四腳朝天地摔在地上起不來。"

msgid "婢女"
msgstr "婢女"

msgid "蓝雨梅是晚月庄主蓝止萍的养女，由于庄主不信任男子，因此\n晚月庄接待外宾的工作向来由她负责。\n"
msgstr "藍雨梅是晚月莊主藍止萍的養女，由於莊主不信任男子，因此\n晚月莊接待外賓的工作向來由她負責。\n"

msgid "蓝雨梅微笑著说道：我们晚月庄是『 以舞会友，以神换技 』\n"
msgstr "藍雨梅微笑著說道：我們晚月莊是『 以舞會友，以神換技 』\n"

msgid "蓝雨梅看你一脸疑惑！笑著说：我教你跳一曲『西出阳关』好吗?\n"
msgstr "藍雨梅看你一臉疑惑！笑著說：我教你跳一曲『西出陽關』好嗎?\n"

msgid "蓝雨梅微笑著说道：我跳支舞给您看好不好？\n"
msgstr "藍雨梅微笑著說道：我跳支舞給您看好不好？\n"

msgid "蓝雨梅微笑著说道：我的舞跳得不好，待会儿我请芳绫跳舞给您看，别走远喔。\n"
msgstr "藍雨梅微笑著說道：我的舞跳得不好，待會兒我請芳綾跳舞給您看，別走遠喔。\n"

msgid "西出阳关"
msgstr "西出陽關"

msgid "『西出阳关』是一种幻影式舞步。可以移形换影。\n"
msgstr "『西出陽關』是一種幻影式舞步。可以移形換影。\n"

msgid "学舞"
msgstr "學舞"

msgid "来!我教你...『西出阳关』是 ..... \n经过雨梅指导后你渐渐懂了! \n"
msgstr "來!我教你...『西出陽關』是 ..... \n經過雨梅指導後你漸漸懂了! \n"

msgid "舞"
msgstr "舞"

msgid "我会的舞是属于「幻影式舞步」。\n"
msgstr "我會的舞是屬於「幻影式舞步」。\n"

msgid "她是个可爱的女孩。不过有点任性，听说她贪玩被关在 \n禁闭室。听说她爱玩竹蜻蜓哦。\n"
msgstr "她是個可愛的女孩。不過有點任性，聽說她貪玩被關在 \n禁閉室。聽說她愛玩竹蜻蜓哦。\n"

msgid "庄内有人会用竹子作成不同物品。\n"
msgstr "莊內有人會用竹子作成不同物品。\n"

msgid "沧海龙吟"
msgstr "滄海龍吟"

msgid "是一种失传以久的「寒谷龙舞」\n"
msgstr "是一種失傳以久的「寒谷龍舞」\n"

msgid "雨梅对你微笑，和善的对你说：\n  这位$RESPECT，你好！欢迎来到晚月庄。请坐！"
msgstr "雨梅對你微笑，和善的對你說：\n  這位$RESPECT，你好！歡迎來到晚月莊。請坐！"

msgid "雨梅对你微笑，纤细的双手捧著茶，\n 说道：这位$RESPECT，你好！欢迎来到晚月庄。请用茶！"
msgstr "雨梅對你微笑，纖細的雙手捧著茶，\n 說道：這位$RESPECT，你好！歡迎來到晚月莊。請用茶！"

msgid "这是上等金轩茶!您品尝一下。\n"
msgstr "這是上等金軒茶!您品嚐一下。\n"

msgid "她看起来像个小灵精，头上梳两个小包包头。\n她坐在地上，看到你看她便向你作了个鬼脸!\n你想她一定是调皮才会在这受罚!\n"
msgstr "她看起來像個小靈精，頭上梳兩個小包包頭。\n她坐在地上，看到你看她便向你作了個鬼臉!\n你想她一定是調皮才會在這受罰!\n"

msgid "顽皮的芳绫向你扮个鬼脸。  *^G^* \n"
msgstr "頑皮的芳綾向你扮個鬼臉。  *^G^* \n"

msgid "芳绫走到中央，一个姿势(Pose)。哇!你没想到她跳舞时竟有此深造诣。\n"
msgstr "芳綾走到中央，一個姿勢(Pose)。哇!你沒想到她跳舞時竟有此深造詣。\n"

msgid "芳绫说：好不好看！这可是我花好久练成的哦! \n"
msgstr "芳綾說：好不好看！這可是我花好久練成的哦! \n"

msgid "芳绫缓缓的移动著，手上的动作变化万千，有一种说不出的美妙。\n"
msgstr "芳綾緩緩的移動著，手上的動作變化萬千，有一種說不出的美妙。\n"

msgid "芳绫说：你好烦哦! 快走开! \n"
msgstr "芳綾說：你好煩哦! 快走開! \n"

msgid "芳绫说：你想学可以去问昭仪姐，她会的比我多。嘻! \n"
msgstr "芳綾說：你想學可以去問昭儀姐，她會的比我多。嘻! \n"

msgid "芳绫说：丑八怪! 不要烦我。走开啦! \n"
msgstr "芳綾說：醜八怪! 不要煩我。走開啦! \n"

msgid "她嘟著嘴。有点生气的翻过头去，不理你！\n"
msgstr "她嘟著嘴。有點生氣的翻過頭去，不理你！\n"

msgid "谢谢!我已经告诉你秘密了呀!去找呀! "
msgstr "謝謝!我已經告訴你秘密了呀!去找呀! "

msgid "芳绫很开心的拿起竹蜻蜓把玩!\n"
msgstr "芳綾很開心的拿起竹蜻蜓把玩!\n"

msgid "满怀感激的谢谢你! 她小声的在你耳边说：\n"
msgstr "滿懷感激的謝謝你! 她小聲的在你耳邊說：\n"

msgid "『 庄内前厅某处藏有一宝物手镯哦!』\n"
msgstr "『 莊內前廳某處藏有一寶物手鐲哦!』\n"

msgid "你可以找找看! \n"
msgstr "你可以找找看! \n"

msgid "这要送给我啊?! 怎么好意思!谢谢你。"
msgstr "這要送給我啊?! 怎麼好意思!謝謝你。"

msgid "替跳"
msgstr "替跳"

msgid "从地上一跃而起。"
msgstr "從地上一躍而起。"

msgid "沧海龙吟？！图跟谱都凑齐了？"
msgstr "滄海龍吟？！圖跟譜都湊齊了？"

msgid "带我去佛堂——这支舞我做梦都想跳。蓝姐姐问起来，你替我扛着。"
msgstr "帶我去佛堂——這支舞我做夢都想跳。藍姐姐問起來，你替我扛著。"

msgid "走呀走呀！密室在哪边？"
msgstr "走呀走呀！密室在哪邊？"

msgid "我都替你跳过了！还要？"
msgstr "我都替你跳過了！還要？"

msgid "从地上跳起来。"
msgstr "從地上跳起來。"

msgid "关着也闷死了！第二密室？带我去——蓝姐姐问起来，你替我扛着。"
msgstr "關著也悶死了！第二密室？帶我去——藍姐姐問起來，你替我扛著。"

msgid "替什么跳？我在受罚呢。你先去问守衣人吧。"
msgstr "替什麼跳？我在受罰呢。你先去問守衣人吧。"

msgid "芳绫踮着脚跟在你后面，一步一个花样。\n"
msgstr "芳綾踮著腳跟在你後面，一步一個花樣。\n"

msgid "晚月庄第三代弟子"
msgstr "晚月莊第三代弟子"

msgid "她看起来非常可爱。身材玲珑有致，曲线苗条。\n第一眼印象，你觉的她舞蹈一定跳的不错，看她的一举一动\n有一种说不出的流畅优雅！\n"
msgstr "她看起來非常可愛。身材玲瓏有致，曲線苗條。\n第一眼印象，你覺的她舞蹈一定跳的不錯，看她的一舉一動\n有一種說不出的流暢優雅！\n"

msgid "昭仪以轻妙的舞步，在房内跳了起来!你看的入神。\n"
msgstr "昭儀以輕妙的舞步，在房內跳了起來!你看的入神。\n"

msgid "昭仪抬头望著那幅图画，略有所思... \n"
msgstr "昭儀抬頭望著那幅圖畫，略有所思... \n"

msgid "这是一张非常真贵的湘绣舞曲图，我也在研究中。\n"
msgstr "這是一張非常真貴的湘繡舞曲圖，我也在研究中。\n"

msgid "嗯 ...为这舞曲名。似乎雨梅姊知道。"
msgstr "嗯 ...為這舞曲名。似乎雨梅姊知道。"

msgid "回头看了一眼墙上的图。"
msgstr "回頭看了一眼牆上的圖。"

msgid "庄主让你找它？步子就绣在这幅图上——你仔细看那几位姐姐的姿势。曲子图上没有，在舞曲谱里；欣芳姐知道谱放在哪。"
msgstr "莊主讓你找它？步子就繡在這幅圖上——你仔細看那幾位姐姐的姿勢。曲子圖上沒有，在舞曲譜裡；欣芳姐知道譜放在哪。"

msgid "有凤来仪"
msgstr "有鳳來儀"

msgid "嗯 ...为这舞曲名。很有名！ \n"
msgstr "嗯 ...為這舞曲名。很有名！ \n"

msgid "「幻影式舞步」步法与地点都很重要。\n"
msgstr "「幻影式舞步」步法與地點都很重要。\n"

msgid "她聪明伶俐，会跳一些自创的舞步。\n"
msgstr "她聰明伶俐，會跳一些自創的舞步。\n"

msgid "画"
msgstr "畫"

msgid "沧海龙吟是一幅湘绣舞曲图，记载一些珍贵舞步。\n"
msgstr "滄海龍吟是一幅湘繡舞曲圖，記載一些珍貴舞步。\n"

msgid "寒谷龙舞"
msgstr "寒谷龍舞"

msgid "昭仪很奇怪的望著你，说道:嘻!你对舞有兴趣呀! "
msgstr "昭儀很奇怪的望著你，說道:嘻!你對舞有興趣呀! "

msgid "只见两眼溜来溜去，一种很神秘的表情，嘟著嘴。"
msgstr "只見兩眼溜來溜去，一種很神秘的表情，嘟著嘴。"

msgid "过了一会说：好吧!偷偷跟你说，你可以查看墙上的图。 "
msgstr "過了一會說：好吧!偷偷跟你說，你可以查看牆上的圖。 "

msgid "...."
msgstr "...."

msgid "昭仪很高兴的看著你，说道:嘻!你对舞有兴趣呀!"
msgstr "昭儀很高興的看著你，說道:嘻!你對舞有興趣呀!"

msgid "这有一幅图画，我从那悟到好多新舞步哦! "
msgstr "這有一幅圖畫，我從那悟到好多新舞步哦! "

msgid "『 沧海龙吟』是一首失传以久的舞曲。传说...."
msgstr "『 滄海龍吟』是一首失傳以久的舞曲。傳說...."

msgid "......"
msgstr "......"

msgid "昭蓉"
msgstr "昭蓉"

msgid "她长得十分漂亮！让你忍不住多瞧她几眼，从她身上\n你闻到淡淡的香气。她很有礼貌的向你点头，优雅的\n动作，轻盈的步伐，好美哦!\n"
msgstr "她長得十分漂亮！讓你忍不住多瞧她幾眼，從她身上\n你聞到淡淡的香氣。她很有禮貌的向你點頭，優雅的\n動作，輕盈的步伐，好美哦!\n"

msgid "我舞跳的不好!我比较喜欢静态的活动。\n"
msgstr "我舞跳的不好!我比較喜歡靜態的活動。\n"

msgid "听说她贪玩被关在禁闭室。她最爱玩竹蜻蜓了! \n"
msgstr "聽說她貪玩被關在禁閉室。她最愛玩竹蜻蜓了! \n"

msgid "昭蓉对你微笑，和善的对你点点头。"
msgstr "昭蓉對你微笑，和善的對你點點頭。"

msgid "昭蓉对你微笑，以纤细轻柔的声音 \n 说道：这位$RESPECT，你好！欢迎来到晚月庄。"
msgstr "昭蓉對你微笑，以纖細輕柔的聲音 \n 說道：這位$RESPECT，你好！歡迎來到晚月莊。"

msgid "密函里写的就是它。师父要我在庄里住着，等——等有人把它拿出来。"
msgstr "密函裡寫的就是它。師父要我在莊裡住著，等——等有人把它拿出來。"

msgid "天山派也想要它。守衣的那个女人我打不过，等着看谁打得过。"
msgstr "天山派也想要它。守衣的那個女人我打不過，等著看誰打得過。"

msgid "曲馥琪"
msgstr "曲馥琪"

msgid "她国色天香，娇丽无伦；温柔娴静，秀绝人寰。\n她姿容绝美，世所罕见。从她身旁你闻道一寒谷\n幽香。\n"
msgstr "她國色天香，嬌麗無倫；溫柔嫻靜，秀絕人寰。\n她姿容絕美，世所罕見。從她身旁你聞道一寒谷\n幽香。\n"

msgid "她是惜春的妹妹，跟姐姐从小就在晚月庄\n长大。因为与双亲失散，被庄主收留。平\n常帮忙庄内琐碎事务。\n"
msgstr "她是惜春的妹妹，跟姐姐從小就在晚月莊\n長大。因為與雙親失散，被莊主收留。平\n常幫忙莊內瑣碎事務。\n"

msgid "苗郁淑"
msgstr "苗郁淑"

msgid "她看起来很有活力，两眼明亮有神。给你\n一种巾帼不让须眉的气势，但刚毅之中似\n又隐含著女孩子有的娇柔。\n"
msgstr "她看起來很有活力，兩眼明亮有神。給你\n一種巾幗不讓鬚眉的氣勢，但剛毅之中似\n又隱含著女孩子有的嬌柔。\n"

msgid "阁下! 这里是庄内后厅厢房。不方便男客进入哦! \n请随手关门，并保持安静! 谢谢! \n"
msgstr "閣下! 這裡是莊內後廳廂房。不方便男客進入哦! \n請隨手關門，並保持安靜! 謝謝! \n"

msgid "看管人"
msgstr "看管人"

msgid "这个老妇人不知姓甚名谁, 她在晚月很久了, 一直看管\n书房, 连庄主都对她很尊敬。\n"
msgstr "這個老婦人不知姓甚名誰, 她在晚月很久了, 一直看管\n書房, 連莊主都對她很尊敬。\n"

msgid "前辈"
msgstr "前輩"

msgid "这里是书房，有些鞭法教材存放在这儿。"
msgstr "這裡是書房，有些鞭法教材存放在這兒。"

msgid "心事"
msgstr "心事"

msgid "坐在窗下，没有抬头，也没有开口。"
msgstr "坐在窗下，沒有抬頭，也沒有開口。"

msgid "她在这屋里。我压了这些年的心事，你替我了了。"
msgstr "她在這屋裡。我壓了這些年的心事，你替我了了。"

msgid "低下头。"
msgstr "低下頭。"

msgid "她都跟你说了？……道观、神教——当年是我把她送出庄门的。"
msgstr "她都跟你說了？……道觀、神教——當年是我把她送出莊門的。"

msgid "去问问她。她不对我说的话，也许会对你说。她就在这屋里。"
msgstr "去問問她。她不對我說的話，也許會對你說。她就在這屋裡。"

msgid "去问问她。她不对我说的话，也许会对你说。夜里，后山的竹林。"
msgstr "去問問她。她不對我說的話，也許會對你說。夜裡，後山的竹林。"

msgid "实不相瞒，这杀手是我的私生女，但已误入歧途 ...\n我一直舍不得亲手杀了她，你若能帮忙我会非常感谢。 \n只是要以令牌为证，唉 ..."
msgstr "實不相瞞，這殺手是我的私生女，但已誤入歧途 ...\n我一直捨不得親手殺了她，你若能幫忙我會非常感謝。 \n只是要以令牌為證，唉 ..."

msgid "沉默了很久。"
msgstr "沉默了很久。"

msgid "……这些年我想的，其实不是这个。我想知道她为什么走到这一步，可她从来不对我说。"
msgstr "……這些年我想的，其實不是這個。我想知道她為什麼走到這一步，可她從來不對我說。"

msgid "她就在这屋里，蒙着面，在书架那边走来走去——你看她的眉眼。替我问她一声「娘」。"
msgstr "她就在這屋裡，蒙著面，在書架那邊走來走去——你看她的眉眼。替我問她一聲「娘」。"

msgid "那一夜之后，她再没进过庄门。可我知道她没走远：夜里，庄后山路尽头的竹林里有人在哭。替我去问她一声「娘」。"
msgstr "那一夜之後，她再沒進過莊門。可我知道她沒走遠：夜裡，莊後山路盡頭的竹林裡有人在哭。替我去問她一聲「娘」。"

msgid "令牌在我这里。她还活着——这就够了。"
msgstr "令牌在我這裡。她還活著——這就夠了。"

msgid "你还给了神教？……也好。那块东西，本来就不该在晚月庄。"
msgstr "你還給了神教？……也好。那塊東西，本來就不該在晚月莊。"

msgid "令牌在你手上？给我。我不要它为证她死了——我要它为证她还活着。"
msgstr "令牌在你手上？給我。我不要它為證她死了——我要它為證她還活著。"

msgid "就在我儿身上 ...你拿到了就给我。"
msgstr "就在我兒身上 ...你拿到了就給我。"

msgid "衣在庄里几百年了。它在，庄就在；它走了，庄里的人就得自己守了。"
msgstr "衣在莊裡幾百年了。它在，莊就在；它走了，莊裡的人就得自己守了。"

msgid "女儿"
msgstr "女兒"

msgid "带她回来：她留在晚月庄，跟着她娘守内书房，不再蒙面。\n晚月庄这一票投旧盟主（不要官府、也不要颜违管到庄里来）（已经入了虹台的席的，这一票不再跟着变）；蓝止萍从此对你冷一分。本庄弟子的执事，由老妇向庄主讨。\n要这么说吗？"
msgstr "帶她回來：她留在晚月莊，跟著她娘守內書房，不再蒙面。\n晚月莊這一票投舊盟主（不要官府、也不要顏違管到莊裡來）（已經入了虹臺的席的，這一票不再跟著變）；藍止萍從此對你冷一分。本莊弟子的執事，由老婦向莊主討。\n要這麼說嗎？"

msgid "她在这里。"
msgstr "她在這裡。"

msgid "你已经不是晚月庄的人了。这是晚月庄的事。"
msgstr "你已經不是晚月莊的人了。這是晚月莊的事。"

msgid "走过去，伸手把女儿脸上的面巾摘了下来。"
msgstr "走過去，伸手把女兒臉上的面巾摘了下來。"

msgid "她是我女儿。我把她送出去过一回，不送第二回。"
msgstr "她是我女兒。我把她送出去過一回，不送第二回。"

msgid "庄主那里，我去说。"
msgstr "莊主那裡，我去說。"

msgid "她的令牌已经在我这里了。"
msgstr "她的令牌已經在我這裡了。"

msgid "你把她那块令还给了神教。别的令牌，我不要。"
msgstr "你把她那塊令還給了神教。別的令牌，我不要。"

msgid "接过令牌，攥在手心里，手在抖。"
msgstr "接過令牌，攥在手心裡，手在抖。"

msgid "她还活着……我拿着它，就知道她还活着。"
msgstr "她還活著……我拿著它，就知道她還活著。"

msgid "作为感谢，我传你一些内力。"
msgstr "作為感謝，我傳你一些內力。"

msgid "无名老妇手抵在你的后心，头上冒出丝丝白气。\n"
msgstr "無名老婦手抵在你的後心，頭上冒出絲絲白氣。\n"

msgid "你感觉到一股热气传了过来。\n"
msgstr "你感覺到一股熱氣傳了過來。\n"

msgid "把令牌交给无名老妇：她知道女儿还活着，给你一份谢礼（谢礼只给一回）。\n令牌给了她，就不能再还给朱鸿雪了。\n要给吗？"
msgstr "把令牌交給無名老婦：她知道女兒還活著，給你一份謝禮（謝禮只給一回）。\n令牌給了她，就不能再還給朱鴻雪了。\n要給嗎？"

msgid "作为感谢，我给你一本寒雪鞭法密笈。"
msgstr "作為感謝，我給你一本寒雪鞭法密笈。"

msgid "谢礼，我早先给过你一回了。这一回，是我欠你的。"
msgstr "謝禮，我早先給過你一回了。這一回，是我欠你的。"

msgid "我要的不是令牌。你见过她了么？"
msgstr "我要的不是令牌。你見過她了麼？"

msgid "令牌我收过一回了。谢礼，也只给一回。"
msgstr "令牌我收過一回了。謝禮，也只給一回。"

msgid "无名老妇坐在书房里，手里的鞭子一直没举起来。\n"
msgstr "無名老婦坐在書房裡，手裡的鞭子一直沒舉起來。\n"

msgid "无名老妇坐在书房里，把那根鞭子横在膝上，一下一下地擦。\n"
msgstr "無名老婦坐在書房裡，把那根鞭子橫在膝上，一下一下地擦。\n"

msgid "无名老妇坐在书房的窗下，一句话也不说。\n"
msgstr "無名老婦坐在書房的窗下，一句話也不說。\n"

msgid "无名老妇和她女儿对坐在窗下，一个擦鞭子，一个擦剑。\n"
msgstr "無名老婦和她女兒對坐在窗下，一個擦鞭子，一個擦劍。\n"

msgid "是她。我听见前厅的声音就知道是她。我没拦住——我一直没拦住。"
msgstr "是她。我聽見前廳的聲音就知道是她。我沒攔住——我一直沒攔住。"

msgid "抬起头，看着东厢的方向。"
msgstr "抬起頭，看著東廂的方向。"

msgid "衣回来了？……好。庄里还守得住。"
msgstr "衣回來了？……好。莊裡還守得住。"

msgid "坐在窗下，手里攥着那块黑木令牌，没有抬头。"
msgstr "坐在窗下，手裡攥著那塊黑木令牌，沒有抬頭。"

msgid "坐在窗下，两只手空空地搁在膝上，没有抬头。"
msgstr "坐在窗下，兩隻手空空地擱在膝上，沒有抬頭。"

msgid "回来了就好。……庄主那里，执事的事我替你讨了。"
msgstr "回來了就好。……莊主那裡，執事的事我替你討了。"

msgid "杀手"
msgstr "殺手"

msgid "蒙面杀手"
msgstr "蒙面殺手"

msgid "这是个蒙面杀手，眉眼看起来有些面熟。\n"
msgstr "這是個蒙面殺手，眉眼看起來有些面熟。\n"

msgid "蒙面杀手喝道：为什么杀我？\n"
msgstr "蒙面殺手喝道：為什麼殺我？\n"

msgid "蒙面杀手叹道：你知道我心里有多痛苦吗？！\n"
msgstr "蒙面殺手嘆道：你知道我心裡有多痛苦嗎？！\n"

msgid "娘"
msgstr "娘"

msgid "令牌丢了？……"
msgstr "令牌丟了？……"

msgid "又从怀里摸出一块黑木令牌，丢给你。"
msgstr "又從懷裡摸出一塊黑木令牌，丟給你。"

msgid "拿好。神教给我的令，不止一块。"
msgstr "拿好。神教給我的令，不止一塊。"

msgid "我说完了。"
msgstr "我說完了。"

msgid "的手停在剑柄上，很久没有动。"
msgstr "的手停在劍柄上，很久沒有動。"

msgid "她让你来问的？……她从来不问。"
msgstr "她讓你來問的？……她從來不問。"

msgid "我七岁那年，她把我送出了庄门——晚月庄容不下一个来历不明的孩子。北麓有个道观收孩子，说是收道童。"
msgstr "我七歲那年，她把我送出了莊門——晚月莊容不下一個來歷不明的孩子。北麓有個道觀收孩子，說是收道童。"

msgid "那里的人不念经，只教剑。六阴追魂剑，从追魂那一部学起；学不会的孩子，后来就不见了。"
msgstr "那裡的人不念經，只教劍。六陰追魂劍，從追魂那一部學起；學不會的孩子，後來就不見了。"

msgid "我是自己逃出来的。东方神教收留了我，给了我这块令。"
msgstr "我是自己逃出來的。東方神教收留了我，給了我這塊令。"

msgid "朱鸿雪派我回晚月庄：我是她的女儿，内书房的门对我开着，宝衣藏在哪里，我看得见。"
msgstr "朱鴻雪派我回晚月莊：我是她的女兒，內書房的門對我開著，寶衣藏在哪裡，我看得見。"

#~ msgid "我在这屋里住了三年。宝衣一直在瑷伦身上，我一回也没有动手。"
#~ msgstr "我在這屋裡住了三年。寶衣一直在璦倫身上，我一回也沒有動手。"

msgid "从腰间解下一块黑木令牌，丢给你。"
msgstr "從腰間解下一塊黑木令牌，丟給你。"

msgid "拿去。给她，还是还给神教，你定。我累了。"
msgstr "拿去。給她，還是還給神教，你定。我累了。"

msgid "杀手站在书架边，剑在鞘里，手离剑柄远远的。\n"
msgstr "殺手站在書架邊，劍在鞘裡，手離劍柄遠遠的。\n"

msgid "她看起来成熟中带有一些稚气。飘逸的长发\n十分迷人。她是个孤儿，从小与妹妹圆春被\n庄主收留，她很聪明，在第四代弟子中算是\n武功很出色的一个。\n"
msgstr "她看起來成熟中帶有一些稚氣。飄逸的長髮\n十分迷人。她是個孤兒，從小與妹妹圓春被\n莊主收留，她很聰明，在第四代弟子中算是\n武功很出色的一個。\n"

msgid "瑷伦"
msgstr "璦倫"

msgid "晚月庄开山祖师"
msgstr "晚月莊開山祖師"

msgid "她看上去三十七岁。庄里最老的仆妇说，她小时候见到的瑷伦也是这张脸。鞭子挂在腰上，手搭在鞭柄上，像搭在一个老朋友的肩上。\n"
msgstr "她看上去三十七歲。莊裡最老的僕婦說，她小時候見到的璦倫也是這張臉。鞭子掛在腰上，手搭在鞭柄上，像搭在一個老朋友的肩上。\n"

msgid "叫瑷伦随你下湖？她穿着宝衣跟你去玉螺湖，等事情了结。"
msgstr "叫璦倫隨你下湖？她穿著寶衣跟你去玉螺湖，等事情了結。"

msgid "我去湖边等你。"
msgstr "我去湖邊等你。"

msgid "站起来，把宝衣的带子系紧。"
msgstr "站起來，把寶衣的帶子繫緊。"

msgid "三百年……不，比三百年长。走吧，我在湖边等你。"
msgstr "三百年……不，比三百年長。走吧，我在湖邊等你。"

msgid "还不到时候。等湖底那颗头醒了，你再来叫我。"
msgstr "還不到時候。等湖底那顆頭醒了，你再來叫我。"

msgid "湖底？你问错人了。"
msgstr "湖底？你問錯人了。"

msgid "衣在我身上。决战那日，你来叫我。"
msgstr "衣在我身上。決戰那日，你來叫我。"

msgid "衣出过庄，又回来了。决战那日，你来叫我。"
msgstr "衣出過莊，又回來了。決戰那日，你來叫我。"

msgid "衣在你身上。你说留着，就留着——别丢了它。"
msgstr "衣在你身上。你說留著，就留著——別丟了它。"

msgid "衣出了庄。你带着它，就别再回头问我。"
msgstr "衣出了莊。你帶著它，就別再回頭問我。"

msgid "你把它给了西厢那个人。几百年的东西，一句话就换了主。"
msgstr "你把它給了西廂那個人。幾百年的東西，一句話就換了主。"

msgid "衣在第二密室的冰匣里，匣只认「有凤来仪」。我说过了。"
msgstr "衣在第二密室的冰匣裡，匣只認「有鳳來儀」。我說過了。"

msgid "你接住了。再问你一句：你拿它去做什么？——斩鬼，交给别人，还是你自己也不知道。想好了告诉我。"
msgstr "你接住了。再問你一句：你拿它去做什麼？——斬鬼，交給別人，還是你自己也不知道。想好了告訴我。"

msgid "潘军禅的嘴向来快。是，衣在庄里，我守着。守了几百年——你看我多大？"
msgstr "潘軍禪的嘴向來快。是，衣在莊裡，我守著。守了幾百年——你看我多大？"

msgid "宝衣不白给。接我三鞭，站着不倒，我们再谈。"
msgstr "寶衣不白給。接我三鞭，站著不倒，我們再談。"

msgid "南危水肯开口，是你的本事。是，衣在庄里，我守着。守了几百年——你看我多大？"
msgstr "南危水肯開口，是你的本事。是，衣在莊裡，我守著。守了幾百年——你看我多大？"

msgid "什么宝衣？老身只会教鞭。"
msgstr "什麼寶衣？老身只會教鞭。"

msgid "为了斩鬼"
msgstr "為了斬鬼"

msgid "这是你给守衣人的答复，说出去就改不了。"
msgstr "這是你給守衣人的答覆，說出去就改不了。"

msgid "寒於留它，本来就是为这个。衣在第二密室的冰匣里，匣只认「有凤来仪」——那支舞你跳得成，我教你记住它的名字。"
msgstr "寒於留它，本來就是為這個。衣在第二密室的冰匣裡，匣只認「有鳳來儀」——那支舞你跳得成，我教你記住它的名字。"

msgid "开了匣，衣是你的。带走，还是留给我守到决战那日，你自己定。"
msgstr "開了匣，衣是你的。帶走，還是留給我守到決戰那日，你自己定。"

msgid "寒於留它，本来就是为这个。衣在第二密室的冰匣里，匣只认「有凤来仪」——那是玄天玉女的步法，男子跳不成。"
msgstr "寒於留它，本來就是為這個。衣在第二密室的冰匣裡，匣只認「有鳳來儀」——那是玄天玉女的步法，男子跳不成。"

msgid "请庄里的姑娘替你跳：筱薇在内厅，或者禁闭房里那个贪玩的芳绫。开了匣，衣是你的。带走，还是留给我守到决战那日，你自己定。"
msgstr "請莊裡的姑娘替你跳：筱薇在內廳，或者禁閉房裡那個貪玩的芳綾。開了匣，衣是你的。帶走，還是留給我守到決戰那日，你自己定。"

msgid "你答过了。"
msgstr "你答過了。"

msgid "先接我三鞭。"
msgstr "先接我三鞭。"

msgid "交给安妮儿"
msgstr "交給安妮兒"

msgid "脸冷了下来。"
msgstr "臉冷了下來。"

msgid "西厢那个人等了三年，等的就是你这句话。我不拦——拿得走就拿。"
msgstr "西廂那個人等了三年，等的就是你這句話。我不攔——拿得走就拿。"

msgid "衣在第二密室的冰匣里，匣只认「有凤来仪」。你跳得成，记住它的名字。"
msgstr "衣在第二密室的冰匣裡，匣只認「有鳳來儀」。你跳得成，記住它的名字。"

msgid "衣在第二密室的冰匣里，匣只认「有凤来仪」，男子跳不成。请筱薇或者芳绫替你跳。"
msgstr "衣在第二密室的冰匣裡，匣只認「有鳳來儀」，男子跳不成。請筱薇或者芳綾替你跳。"

msgid "安妮儿？你连她在等什么都没问过，就要替她拿衣？"
msgstr "安妮兒？你連她在等什麼都沒問過，就要替她拿衣？"

msgid "不知道"
msgstr "不知道"

msgid "不知道，比胡说一个好。衣在第二密室的冰匣里，匣只认「有凤来仪」——你跳得成，记住它的名字。"
msgstr "不知道，比胡說一個好。衣在第二密室的冰匣裡，匣只認「有鳳來儀」——你跳得成，記住它的名字。"

msgid "开了匣再想。带走，还是留给我守到决战那日。"
msgstr "開了匣再想。帶走，還是留給我守到決戰那日。"

msgid "不知道，比胡说一个好。衣在第二密室的冰匣里，匣只认「有凤来仪」，男子跳不成——请筱薇或者芳绫替你跳。"
msgstr "不知道，比胡說一個好。衣在第二密室的冰匣裡，匣只認「有鳳來儀」，男子跳不成——請筱薇或者芳綾替你跳。"

msgid "还衣"
msgstr "還衣"

#~ msgid "把寒於宝衣还给瑷伦：她又是守衣人，池边的凤凰回来；决战那日问她「湖底」，她穿着它跟你下湖。\n宝衣从此不在你身上，下湖时没有它挡寒气。\n要还吗？"
#~ msgstr "把寒於寶衣還給璦倫：她又是守衣人，池邊的鳳凰回來；決戰那日問她「湖底」，她穿著它跟你下湖。\n寶衣從此不在你身上，下湖時沒有它擋寒氣。\n要還嗎？"

msgid "衣在湖底烧了。它挡在了该挡的地方，不必再说还不还。"
msgstr "衣在湖底燒了。它擋在了該擋的地方，不必再說還不還。"

msgid "衣在我身上了。"
msgstr "衣在我身上了。"

msgid "你说过留着。"
msgstr "你說過留著。"

msgid "native:latemoon/cold_robe"
msgstr "native:latemoon/cold_robe"

msgid "看着你手里的衣，很久没有伸手。"
msgstr "看著你手裡的衣，很久沒有伸手。"

msgid "出了庄门的衣，我说过不收。"
msgstr "出了莊門的衣，我說過不收。"

msgid "接过宝衣，抖开，披在肩上。衣角落下去的时候，屋里凉了一截。"
msgstr "接過寶衣，抖開，披在肩上。衣角落下去的時候，屋裡涼了一截。"

msgid "……可它回来了。我守到决战那日——到时候你来叫我，我跟你下湖底。"
msgstr "……可它回來了。我守到決戰那日——到時候你來叫我，我跟你下湖底。"

msgid "衣不在你身上，就别说还。"
msgstr "衣不在你身上，就別說還。"

msgid "还什么？"
msgstr "還什麼？"

msgid "宝衣留在你身上：瑷伦不再问，庄里照旧没有护佑。\n要这么说吗？"
msgstr "寶衣留在你身上：璦倫不再問，莊裡照舊沒有護佑。\n要這麼說嗎？"

msgid "衣已经回来了。"
msgstr "衣已經回來了。"

msgid "说过了。"
msgstr "說過了。"

msgid "你说过，为了斩鬼。那就带着它去斩。"
msgstr "你說過，為了斬鬼。那就帶著它去斬。"

msgid "你说过要交给西厢那个人，到头来自己带着。也好——总比给她好。"
msgstr "你說過要交給西廂那個人，到頭來自己帶著。也好——總比給她好。"

msgid "没有说话，过了一会儿才开口。"
msgstr "沒有說話，過了一會兒才開口。"

msgid "你说过你不知道拿它做什么。带着吧——到了湖底那一天，你就知道了。"
msgstr "你說過你不知道拿它做什麼。帶著吧——到了湖底那一天，你就知道了。"

msgid "留着什么？"
msgstr "留著什麼？"

msgid "拜师! 不敢当，我都老了!你去找「芷萍」好了，看她收不收你?"
msgstr "拜師! 不敢當，我都老了!你去找「芷萍」好了，看她收不收你?"

msgid "老身不收男徒!"
msgstr "老身不收男徒!"

msgid "瑷伦说道：小心了，这是第一鞭..."
msgstr "璦倫說道：小心了，這是第一鞭..."

msgid "瑷伦面露微笑：好！第二鞭来了..."
msgstr "璦倫面露微笑：好！第二鞭來了..."

msgid "瑷伦叹了口气道：看来还是不行啊..."
msgstr "璦倫嘆了口氣道：看來還是不行啊..."

msgid "瑷伦鼓励道：很不错，看这最后一鞭..."
msgstr "璦倫鼓勵道：很不錯，看這最後一鞭..."

msgid "瑷伦叹了口气道：太可惜了！"
msgstr "璦倫嘆了口氣道：太可惜了！"

msgid "瑷伦露出慈祥的面容：看来我没看错人。"
msgstr "璦倫露出慈祥的面容：看來我沒看錯人。"

msgid "晚月庄第一代弟子"
msgstr "晚月莊第一代弟子"

msgid "接她三鞭"
msgstr "接她三鞭"

msgid "瑷伦的三鞭是真打：\n· 每一鞭都实打实地落在你身上。\n· 哪一鞭接不住，就算没接下：你会昏倒，但不伤性命、不留伤，歇一会儿就能再来。\n· 接不接得住看气长不长：气随内力上限涨，内力上限靠打坐——先向师父学一门内功、装上，再去打坐。\n确定接她三鞭吗？"
msgstr "璦倫的三鞭是真打：\n· 每一鞭都實打實地落在你身上。\n· 哪一鞭接不住，就算沒接下：你會昏倒，但不傷性命、不留傷，歇一會兒就能再來。\n· 接不接得住看氣長不長：氣隨內力上限漲，內力上限靠打坐——先向師父學一門內功、裝上，再去打坐。\n確定接她三鞭嗎？"

msgid "瑷伦看了你很久：倒了两回，还站到我面前来。这份硬气，我认——这三鞭，我不用内力。"
msgstr "璦倫看了你很久：倒了兩回，還站到我面前來。這份硬氣，我認——這三鞭，我不用內力。"

msgid "瑷伦摆摆手：你的气还没喘匀。歇好了再来。"
msgstr "璦倫擺擺手：你的氣還沒喘勻。歇好了再來。"

msgid "瑷伦收起鞭子：站得住。那就再问你一句——你拿它去做什么？"
msgstr "璦倫收起鞭子：站得住。那就再問你一句——你拿它去做什麼？"

msgid "接下了守衣人瑷伦的三鞭"
msgstr "接下了守衣人璦倫的三鞭"

msgid "衣要还，你开口说一声。"
msgstr "衣要還，你開口說一聲。"

msgid "出了庄门的衣，不是晚月庄的了。拿走吧。"
msgstr "出了莊門的衣，不是晚月莊的了。拿走吧。"

msgid "我守到决战那日。到时候你来叫我，我跟你下湖底。"
msgstr "我守到決戰那日。到時候你來叫我，我跟你下湖底。"

msgid "守衣人"
msgstr "守衣人"

msgid "瑷伦的手搭在腰间，那里多了一层月白的衣角。\n"
msgstr "璦倫的手搭在腰間，那裡多了一層月白的衣角。\n"

msgid "瑷伦说：决战那日，你来叫我。\n"
msgstr "璦倫說：決戰那日，你來叫我。\n"

msgid "瑷伦望着东厢的窗，很久没动。\n"
msgstr "璦倫望著東廂的窗，很久沒動。\n"

msgid "瑷伦低声说：几百年……到我手里丢的。\n"
msgstr "璦倫低聲說：幾百年……到我手裡丟的。\n"

msgid "看了你一眼，又看向你空着的手。"
msgstr "看了你一眼，又看向你空著的手。"

msgid "衣出了庄，凤凰暗了。前厅的事你看见了——那是衣走了的价钱。"
msgstr "衣出了莊，鳳凰暗了。前廳的事你看見了——那是衣走了的價錢。"

msgid "没有看你。"
msgstr "沒有看你。"

msgid "你把它给了西厢那个人。凤凰暗了，前厅死了人——几百年的东西，一句话就换了主。"
msgstr "你把它給了西廂那個人。鳳凰暗了，前廳死了人——幾百年的東西，一句話就換了主。"

msgid "安妮儿"
msgstr "安妮兒"

msgid "手搭在膝上那件月白的衣上，没有抬头。"
msgstr "手搭在膝上那件月白的衣上，沒有抬頭。"

msgid "蓝止萍让你来要？"
msgstr "藍止萍讓你來要？"

msgid "衣在我这里。月神族守了几百年，守给我的——这话我对你说过。回去告诉她：湖上出事那天，衣会在该在的地方。"
msgstr "衣在我這裡。月神族守了幾百年，守給我的——這話我對你說過。回去告訴她：湖上出事那天，衣會在該在的地方。"

msgid "它在我这里。你记得这一点就够了——东方神教也记得。"
msgstr "它在我這裡。你記得這一點就夠了——東方神教也記得。"

msgid "衣回了瑷伦身上？……出过庄的衣，回得去。你倒比我想的懂它。"
msgstr "衣回了璦倫身上？……出過莊的衣，回得去。你倒比我想的懂它。"

msgid "宝衣出了庄。你的名字，我记下了。"
msgstr "寶衣出了莊。你的名字，我記下了。"

msgid "守衣人让你过了？那她看中了你。我在西厢住了三年，等一件东西，也等一个配得上它的人——衣交给我，不比交给一个几百年不出庄的人差。"
msgstr "守衣人讓你過了？那她看中了你。我在西廂住了三年，等一件東西，也等一個配得上它的人——衣交給我，不比交給一個幾百年不出莊的人差。"

msgid "我在西厢住了三年，等一件东西，也等一个配得上它的人。你是哪一个？"
msgstr "我在西廂住了三年，等一件東西，也等一個配得上它的人。你是哪一個？"

msgid "等谁"
msgstr "等誰"

msgid "门关着。神教的事，去问你的教主。"
msgstr "門關著。神教的事，去問你的教主。"

msgid "不等了。教主令收回来了，你身上有黄金令——想学天山的剑，就在这里学（「请教」）。"
msgstr "不等了。教主令收回來了，你身上有黃金令——想學天山的劍，就在這裡學（「請教」）。"

msgid "把膝上的衣叠好，站起身来。"
msgstr "把膝上的衣疊好，站起身來。"

msgid "朱鸿雪的名单上，还差最后一个名字。我知道是谁。"
msgstr "朱鴻雪的名單上，還差最後一個名字。我知道是誰。"

msgid "到场院去。我会在那里。"
msgstr "到場院去。我會在那裡。"

msgid "膝上空着。她看了你一会儿。"
msgstr "膝上空著。她看了你一會兒。"

msgid "朱鸿雪派你来的。"
msgstr "朱鴻雪派你來的。"

msgid "衣烧了，在湖底。我等的东西，用过了——它最后挡在了该挡的地方。"
msgstr "衣燒了，在湖底。我等的東西，用過了——它最後擋在了該擋的地方。"

msgid "我不用再等了。神教还想要什么，让她自己来西厢问我。"
msgstr "我不用再等了。神教還想要什麼，讓她自己來西廂問我。"

msgid "回去告诉朱鸿雪吧。你可以照实说。"
msgstr "回去告訴朱鴻雪吧。你可以照實說。"

msgid "衣在我这里。可它不是神教的——它守的是湖底的东西，不是谁家的香火。"
msgstr "衣在我這裡。可它不是神教的——它守的是湖底的東西，不是誰家的香火。"

msgid "我等的是那一天：湖底那东西醒的那一天，衣该在一个配得上它的人身上。也许是你，也许是别人。不会是朱鸿雪。"
msgstr "我等的是那一天：湖底那東西醒的那一天，衣該在一個配得上它的人身上。也許是你，也許是別人。不會是朱鴻雪。"

msgid "抬眼看了你一会儿。"
msgstr "抬眼看了你一會兒。"

msgid "衣回了瑷伦身上。守衣人守着它，我也就不急了。"
msgstr "衣回了璦倫身上。守衣人守著它，我也就不急了。"

msgid "我在等湖上出事的那一天。那一天，衣该在一个配得上它的人身上——瑷伦，你，都行。只是不该在神教手里。"
msgstr "我在等湖上出事的那一天。那一天，衣該在一個配得上它的人身上——璦倫，你，都行。只是不該在神教手裡。"

msgid "看了你一眼，像在数你的名字有几个字。"
msgstr "看了你一眼，像在數你的名字有幾個字。"

msgid "衣出了庄，跟着你走了。我等的东西从我门前过去了，没进我的门。"
msgstr "衣出了莊，跟著你走了。我等的東西從我門前過去了，沒進我的門。"

msgid "我还在等——等你哪一天明白那件衣是做什么用的。到那时，它不该在神教手里。"
msgstr "我還在等——等你哪一天明白那件衣是做什麼用的。到那時，它不該在神教手裡。"

msgid "看了一眼你的包袱，又看着你。"
msgstr "看了一眼你的包袱，又看著你。"

msgid "衣出了冰匣，在你身上。我等的就是它，也在等拿着它的人——你还没想好把它交给谁。"
msgstr "衣出了冰匣，在你身上。我等的就是它，也在等拿著它的人——你還沒想好把它交給誰。"

msgid "交给谁都行，只是不该交给神教。"
msgstr "交給誰都行，只是不該交給神教。"

msgid "我在等一件衣，也在等一个人。衣在这庄子的冰匣里；人……我还没见到。"
msgstr "我在等一件衣，也在等一個人。衣在這莊子的冰匣裡；人……我還沒見到。"

msgid "等到了，我把衣交给那个人——交给那个人，不是交给神教。"
msgstr "等到了，我把衣交給那個人——交給那個人，不是交給神教。"

msgid "教主令在我这里。神教往后只派该死的人的差事——鸿雪答应了。"
msgstr "教主令在我這裡。神教往後只派該死的人的差事——鴻雪答應了。"

msgid "天山雪影剑、雪影心法，你来学（「请教」）。"
msgstr "天山雪影劍、雪影心法，你來學（「請教」）。"

msgid "门关着。"
msgstr "門關著。"

msgid "教主？"
msgstr "教主？"

msgid "出了庄的衣，不必再拿来给我看。"
msgstr "出了莊的衣，不必再拿來給我看。"

msgid "接过宝衣，手指在衣料上停了一停。"
msgstr "接過寶衣，手指在衣料上停了一停。"

msgid "月神族守了几百年，守给我的。"
msgstr "月神族守了幾百年，守給我的。"

msgid "你配得上。东方神教记得你——这句话，以后有用。"
msgstr "你配得上。東方神教記得你——這句話，以後有用。"

msgid "安妮儿把一件月白的衣叠在膝上，谁也不看。\n"
msgstr "安妮兒把一件月白的衣疊在膝上，誰也不看。\n"

msgid "安妮儿看了你一眼，像在数你的名字有几个字。\n"
msgstr "安妮兒看了你一眼，像在數你的名字有幾個字。\n"

msgid "宝衣出了庄，没进我的门。你的名字，我记下了。"
msgstr "寶衣出了莊，沒進我的門。你的名字，我記下了。"

msgid "虞琼衣"
msgstr "虞瓊衣"

msgid "晚月庄弟子"
msgstr "晚月莊弟子"

msgid "琼衣很礼貌的向你微笑! \n"
msgstr "瓊衣很禮貌的向你微笑! \n"

msgid "说道：请保持安静哦! \n"
msgstr "說道：請保持安靜哦! \n"

msgid "龙韶吟"
msgstr "龍韶吟"

msgid "你觉得被打中的地方一阵麻痒！"
msgstr "你覺得被打中的地方一陣麻癢！"

msgid "韶吟惊慌生气的怒斥： 喂! 兄台不要乱闯! \n"
msgstr "韶吟驚慌生氣的怒斥： 喂! 兄臺不要亂闖! \n"

msgid "她的眼神骤变，隐约中似乎让人神智渐模糊! \n"
msgstr "她的眼神驟變，隱約中似乎讓人神智漸模糊! \n"

msgid "阮欣郁"
msgstr "阮欣郁"

msgid "欣郁大喊： 喂! 兄台! 这不准男人进来! \n"
msgstr "欣郁大喊： 喂! 兄臺! 這不准男人進來! \n"

msgid "欣郁从袖里取出一把粉红色细粉泼撒出去。\n"
msgstr "欣郁從袖裡取出一把粉紅色細粉潑撒出去。\n"

msgid "欣郁一脚往闯入者踢了出去。\n"
msgstr "欣郁一腳往闖入者踢了出去。\n"

msgid "凤凰"
msgstr "鳳凰"

msgid "护庄神像"
msgstr "護莊神像"

msgid "火神「凤凰」乃勇士寒于的魂魄所化成的十三个精灵之一。\n由于其奇异神迹，被晚月庄供奉为护庄神兽。\n"
msgstr "火神「鳳凰」乃勇士寒於的魂魄所化成的十三個精靈之一。\n由於其奇異神蹟，被晚月莊供奉為護莊神獸。\n"

msgid "神像眼神骤变，幻化成七彩凤凰，出现金色光芒。\n"
msgstr "神像眼神驟變，幻化成七彩鳳凰，出現金色光芒。\n"

msgid "金仪彤"
msgstr "金儀彤"

msgid "她国色天香，娇丽无伦；温柔娴静，秀绝人寰。\n可惜眉心上有一道地煞纹干犯紫斗，恐要玉手\n染血，浩劫武林。\n"
msgstr "她國色天香，嬌麗無倫；溫柔嫻靜，秀絕人寰。\n可惜眉心上有一道地煞紋干犯紫斗，恐要玉手\n染血，浩劫武林。\n"

msgid "她长得十分漂亮！让你忍不住多瞧她几眼，从她身上\n你闻到淡淡的香气。她很有礼貌的向你点头，优雅的\n动作，轻盈的步伐，好美哦!\n她是晚月庄主蓝止萍的养女。\n"
msgstr "她長得十分漂亮！讓你忍不住多瞧她幾眼，從她身上\n你聞到淡淡的香氣。她很有禮貌的向你點頭，優雅的\n動作，輕盈的步伐，好美哦!\n她是晚月莊主藍止萍的養女。\n"

msgid "咦..!你也喜欢玩啊! 我会做哦! \n不过我需要一根竹子! 你找来我帮你做! \n"
msgstr "咦..!你也喜歡玩啊! 我會做哦! \n不過我需要一根竹子! 你找來我幫你做! \n"

msgid "筱薇对你微笑，和善的对你点点头。"
msgstr "筱薇對你微笑，和善的對你點點頭。"

msgid "筱薇对你微笑，以纤细轻柔的声音 \n 说道：这位$RESPECT，你好！欢迎来到晚月庄。"
msgstr "筱薇對你微笑，以纖細輕柔的聲音 \n 說道：這位$RESPECT，你好！歡迎來到晚月莊。"

msgid "我已经帮你做一个竹蜻蜓了呀! "
msgstr "我已經幫你做一個竹蜻蜓了呀! "

msgid "筱薇微笑的看著你说：你要作竹蜻蜓呀!\n"
msgstr "筱薇微笑的看著你說：你要作竹蜻蜓呀!\n"

msgid "筱薇将你给她的竹子仔细的看了一下。说道：不错是根玉竹! \n"
msgstr "筱薇將你給她的竹子仔細的看了一下。說道：不錯是根玉竹! \n"

msgid "筱薇将竹子周围的叶子弄掉，灵巧的削凿著。\n"
msgstr "筱薇將竹子周圍的葉子弄掉，靈巧的削鑿著。\n"

msgid "经过不久，筱薇把竹蜻蜓做好了。\n"
msgstr "經過不久，筱薇把竹蜻蜓做好了。\n"

msgid "筱薇将做好的竹蜻蜓递给你，微笑说道：嗯! 做好了! \n"
msgstr "筱薇將做好的竹蜻蜓遞給你，微笑說道：嗯! 做好了! \n"

msgid "采花少女"
msgstr "採花少女"

msgid "采花少女是绮云镇居民的小孩，从小就到晚月庄来摘桂花，蓝止\n萍很喜欢她们，也教给她们了些基本的武功，时间久了，这些少\n女的功夫还都不错。\n"
msgstr "採花少女是綺雲鎮居民的小孩，從小就到晚月莊來摘桂花，藍止\n萍很喜歡她們，也教給她們了些基本的武功，時間久了，這些少\n女的功夫還都不錯。\n"

msgid "顽皮的采花少女向你扮个鬼脸。  *^G^* \n"
msgstr "頑皮的採花少女向你扮個鬼臉。  *^G^* \n"

msgid "采花少女说道：华中理工大学的桂花树比晚月庄多多了，你知道吗？\n"
msgstr "採花少女說道：華中理工大學的桂花樹比晚月莊多多了，你知道嗎？\n"

msgid "采花少女望着天边的晚霞，双手托着香腮，说道：我好想去华工大摘桂花。\n"
msgstr "採花少女望著天邊的晚霞，雙手托著香腮，說道：我好想去華工大摘桂花。\n"

msgid "采花少女嘀咕着：听说华工的桂花有好几种呢。\n"
msgstr "採花少女嘀咕著：聽說華工的桂花有好幾種呢。\n"

msgid "采花少女秀眉微蹙，说道：你欺负我年纪小是吗？\n"
msgstr "採花少女秀眉微蹙，說道：你欺負我年紀小是嗎？\n"

msgid "采花少女说道：你要是再无理取闹，让火玫瑰毒死你！\n"
msgstr "採花少女說道：你要是再無理取鬧，讓火玫瑰毒死你！\n"

msgid "采花少女骂道：你这无赖，别死缠着我！\n"
msgstr "採花少女罵道：你這無賴，別死纏著我！\n"

msgid "桂花"
msgstr "桂花"

msgid "华中理工大学的桂花树比晚月庄多多了，你知道吗？"
msgstr "華中理工大學的桂花樹比晚月莊多多了，你知道嗎？"

msgid "上官钰翎"
msgstr "上官鈺翎"

msgid "玉涵湘"
msgstr "玉涵湘"

msgid "小金鼠"
msgstr "小金鼠"

msgid "一只可爱的长尾巴的小金鼠。 \n"
msgstr "一隻可愛的長尾巴的小金鼠。 \n"

msgid "小金鼠摇摇尾巴!全身晃呀晃! \n"
msgstr "小金鼠搖搖尾巴!全身晃呀晃! \n"

msgid "小金鼠眼睛眨呀眨!好像快睡著了! \n"
msgstr "小金鼠眼睛眨呀眨!好像快睡著了! \n"

msgid "嘟嘟玩太累了!睡著了! \n"
msgstr "嘟嘟玩太累了!睡著了! \n"

msgid "小金鼠「嘟嘟」它跳啊跳的! \n"
msgstr "小金鼠「嘟嘟」它跳啊跳的! \n"

msgid "小金鼠「嘟嘟」眼睛眨呀眨看著你 \n"
msgstr "小金鼠「嘟嘟」眼睛眨呀眨看著你 \n"

msgid "小金鼠发出「  叽! 叽!」」的叫声! \n"
msgstr "小金鼠發出「  嘰! 嘰!」」的叫聲! \n"

msgid "一只羽毛鲜艳的小金丝雀。\n"
msgstr "一隻羽毛鮮豔的小金絲雀。\n"

msgid "小金丝雀叽叽的叫! \n"
msgstr "小金絲雀嘰嘰的叫! \n"

msgid "金丝雀用嘴整理羽毛。 \n"
msgstr "金絲雀用嘴整理羽毛。 \n"

msgid "美珊"
msgstr "美珊"

msgid "她看起来成熟中带有一些韵味。飘逸的长发\n十分迷人。\n"
msgstr "她看起來成熟中帶有一些韻味。飄逸的長髮\n十分迷人。\n"

msgid "小白兔"
msgstr "小白兔"

msgid "一只红眼睛的小白兔。\n"
msgstr "一隻紅眼睛的小白兔。\n"

msgid "小白兔蹦蹦跳跳的。\n"
msgstr "小白兔蹦蹦跳跳的。\n"

msgid "小白兔用嘴舔前肢。 \n"
msgstr "小白兔用嘴舔前肢。 \n"

msgid "舞曲谱啊，师姐她们练习舞步的时候才用的着，\n你也想学吗？ 嘻嘻...\n"
msgstr "舞曲譜啊，師姐她們練習舞步的時候才用的著，\n你也想學嗎？ 嘻嘻...\n"

msgid "人灵「区冥」"
msgstr "人靈「區冥」"

msgid "神像"
msgstr "神像"

msgid "人灵「区冥」乃勇士寒于的魂魄所化成的十三个精灵之一。\n晚月庄的开山先辈，传说是其后裔子孙。故其为\n晚月庄的祖先神位。\n"
msgstr "人靈「區冥」乃勇士寒於的魂魄所化成的十三個精靈之一。\n晚月莊的開山先輩，傳說是其後裔子孫。故其為\n晚月莊的祖先神位。\n"

msgid "神像的目光落在你身上，柔和得像晚月。\n"
msgstr "神像的目光落在你身上，柔和得像晚月。\n"

msgid "你有一种奇特的感觉，彷佛有人在盯著你看。\n"
msgstr "你有一種奇特的感覺，彷彿有人在盯著你看。\n"

msgid "这是条用鹅卵石铺成的小路，往西可以看到一座用淡青色围墙围住\n的庭院，有两个身着彩衣的女子笑盈盈的站在那里说笑着，她们身后的\n一扇拱门，檐顶下面写着「晚月庄」。院墙那边飘出的阵阵曲声勾\n人魂魄，隐约还可闻到一股香气。\n"
msgstr "這是條用鵝卵石鋪成的小路，往西可以看到一座用淡青色圍牆圍住\n的庭院，有兩個身著彩衣的女子笑盈盈的站在那裡說笑著，她們身後的\n一扇拱門，簷頂下面寫著「晚月莊」。院牆那邊飄出的陣陣曲聲勾\n人魂魄，隱約還可聞到一股香氣。\n"

msgid "你来到了这个小径的尽头，一个有著朱红漆大门大宅\n院矗立在你的面前，门口挂著两串灯笼,上面写\n得有字，像这样一间豪华的大宅院出现在这样的乡间野外\n，使你觉得有些突兀，大宅的南边、东边都是茂密的林子\n，看来也没有其他的路。\n"
msgstr "你來到了這個小徑的盡頭，一個有著朱紅漆大門大宅\n院矗立在你的面前，門口掛著兩串燈籠,上面寫\n得有字，像這樣一間豪華的大宅院出現在這樣的鄉間野外\n，使你覺得有些突兀，大宅的南邊、東邊都是茂密的林子\n，看來也沒有其他的路。\n"

msgid "一走入这个庭园，扑鼻而来的便是一股若有似无，但是又沁人心\n脾的花香，庭园甚是宽敞，许多奇花异石错落其间，显是经过高手匠\n人的精心布置，西边花丛间可看到主屋的屋角，一条石板小径沿著假\n山通往主屋。\n"
msgstr "一走入這個庭園，撲鼻而來的便是一股若有似無，但是又沁人心\n脾的花香，庭園甚是寬敞，許多奇花異石錯落其間，顯是經過高手匠\n人的精心佈置，西邊花叢間可看到主屋的屋角，一條石板小徑沿著假\n山通往主屋。\n"

msgid "走进大厅，抬头迎面看见的是一面紫红绣金挂幔，一面屏风将宽敞的\n大厅隔成两半，东西两面各设著七张紫檀雕案，案上一色白玉羊脂花瓶，\n瓶中插著粉红的处子牡丹，紫檀雕案中间又都挂著七尺来长的画轴，各式\n鸟兽虫鱼，翎毛丹青，栩栩如生，宛如要从画纸上飞出，嬉戏于大厅之中\n，这大厅中的富贵气派之中透著一股秀气，但是却也无一般富豪人家或酒\n店的庸脂俗粉之气。\n    屏风两旁的白石嵌云柱上工整地刻著一幅对联写道：\n\n    「座上珠玑照日月，却掩珠帘，难为芳心;\n      堂前飘香焕云霞，不知岁月，但晓清音。」\n\n"
msgstr "走進大廳，抬頭迎面看見的是一面紫紅繡金掛幔，一面屏風將寬敞的\n大廳隔成兩半，東西兩面各設著七張紫檀雕案，案上一色白玉羊脂花瓶，\n瓶中插著粉紅的處子牡丹，紫檀雕案中間又都掛著七尺來長的畫軸，各式\n鳥獸蟲魚，翎毛丹青，栩栩如生，宛如要從畫紙上飛出，嬉戲於大廳之中\n，這大廳中的富貴氣派之中透著一股秀氣，但是卻也無一般富豪人家或酒\n店的庸脂俗粉之氣。\n    屏風兩旁的白石嵌雲柱上工整地刻著一幅對聯寫道：\n\n    「座上珠璣照日月，卻掩珠簾，難為芳心;\n      堂前飄香煥雲霞，不知歲月，但曉清音。」\n\n"

msgid "这里是晚月庄接待宾客的傍厅，厅中摆了一张桌几，上面摆著\n一块大红镶金桌巾，靠东壁面西设著半旧青缎靠背引枕，两张太师\n椅座。桌几上有一精致的茶壶，旁有盛好的上等茗茶。\n"
msgstr "這裡是晚月莊接待賓客的傍廳，廳中擺了一張桌几，上面擺著\n一塊大紅鑲金桌巾，靠東壁面西設著半舊青緞靠背引枕，兩張太師\n椅座。桌几上有一精緻的茶壺，旁有盛好的上等茗茶。\n"

msgid "这是晚月庄后的小小庭院，面积似乎不大，但花木扶疏，举目四望，\n竟种满了无数梅花，婉约娟秀，别有一番滋味。清风徐来，梅花特有的\n清香弥漫在风中.....\n"
msgstr "這是晚月莊後的小小庭院，面積似乎不大，但花木扶疏，舉目四望，\n竟種滿了無數梅花，婉約娟秀，別有一番滋味。清風徐來，梅花特有的\n清香瀰漫在風中.....\n"

msgid "你走在一条长廊上，两旁都是庭台堂庑，廊上弥漫著一股\n香郁的气息，廊下是由青石砖铺成，一边接后厅内院，一边的\n尽头则是一幅大石壁画，西侧似有一铜门。\n有一间书房。\n"
msgstr "你走在一條長廊上，兩旁都是庭臺堂廡，廊上瀰漫著一股\n香郁的氣息，廊下是由青石磚鋪成，一邊接後廳內院，一邊的\n盡頭則是一幅大石壁畫，西側似有一銅門。\n有一間書房。\n"

msgid "这里四面都是单调的墙壁。通常庄内弟子犯错就是\n关在这儿！反省思过。\n"
msgstr "這裡四面都是單調的牆壁。通常莊內弟子犯錯就是\n關在這兒！反省思過。\n"

msgid "你走在一条长廊上，两旁都是庭台堂庑，廊上弥漫著一股\n香郁的气息，长廊向东西方延伸而去。东边是后厅院子，西边\n有一间书房。\n"
msgstr "你走在一條長廊上，兩旁都是庭臺堂廡，廊上瀰漫著一股\n香郁的氣息，長廊向東西方延伸而去。東邊是後廳院子，西邊\n有一間書房。\n"

msgid "这是一间小小的书房，窗明几净，朴素典雅，一张古意盎然的红木书桌，\n吸引了你的目光，上面摆著一座小小的香炉，几本善本书整齐的堆放在桌上\n，可见主人相当的爱惜书本。一幅「沧海龙吟」的舞曲图画挂在墙上，似乎\n有一些秘密在里头。\n"
msgstr "這是一間小小的書房，窗明几淨，樸素典雅，一張古意盎然的紅木書桌，\n吸引了你的目光，上面擺著一座小小的香爐，幾本善本書整齊的堆放在桌上\n，可見主人相當的愛惜書本。一幅「滄海龍吟」的舞曲圖畫掛在牆上，似乎\n有一些秘密在裡頭。\n"

msgid "这是一间密室。地上铺著可以合地打坐的大理石床。四周挂了一\n些兵器，正面墙上写了偌大的 『 舞 』字！ 地板上隐约看到一幅先\n天八卦图。中央画著两仪，八个角落分别是：乾坤兑离震巽坎艮、等\n卦相。墙上画著几幅玄天玉女翩然起舞的美妙步法。\n"
msgstr "這是一間密室。地上鋪著可以合地打坐的大理石床。四周掛了一\n些兵器，正面牆上寫了偌大的 『 舞 』字！ 地板上隱約看到一幅先\n天八卦圖。中央畫著兩儀，八個角落分別是：乾坤兌離震巽坎艮、等\n卦相。牆上畫著幾幅玄天玉女翩然起舞的美妙步法。\n"

msgid "你从后廊往西出了内厅进入穿堂。往北是内院，一条宽过道，西  \n面立著一个粉油大影壁，后有一大半门，小小的一所庭宇。\n"
msgstr "你從後廊往西出了內廳進入穿堂。往北是內院，一條寬過道，西  \n面立著一個粉油大影壁，後有一大半門，小小的一所庭宇。\n"

msgid "走入内厅，你看到袭地铺满红毯。四面相对十二张雕漆椅上，都\n是一色灰鼠椅搭小褥，厅中摆了小屏风，四周挂满山水墨画。一个木\n隔架，旁边还有一碧纱橱。\n"
msgstr "走入內廳，你看到襲地鋪滿紅毯。四面相對十二張雕漆椅上，都\n是一色灰鼠椅搭小褥，廳中擺了小屏風，四周掛滿山水墨畫。一個木\n隔架，旁邊還有一碧紗櫥。\n"

msgid "你走在后厅内院的仪门，是晚月庄后厅内院长廊走道的相接路\n口。东北方是往膳房的夹道，西面是长廊夹道，南面是到后厅，往北\n则可走出大门前往前院。\n"
msgstr "你走在後廳內院的儀門，是晚月莊後廳內院長廊走道的相接路\n口。東北方是往膳房的夾道，西面是長廊夾道，南面是到後廳，往北\n則可走出大門前往前院。\n"

msgid "你走在后厅内院的夹道上，庄内像这样的走廊很多，你若没有地\n理概念很容易迷路。长长的走道中, 纯金铸成的长灯架上挂了一排饰\n丽的宫灯! 入夜之后灯火辉煌! 十分美丽!\n"
msgstr "你走在後廳內院的夾道上，莊內像這樣的走廊很多，你若沒有地\n理概念很容易迷路。長長的走道中, 純金鑄成的長燈架上掛了一排飾\n麗的宮燈! 入夜之後燈火輝煌! 十分美麗!\n"

msgid "这是一间客房，两边摆了一对小茶几。上面的彩绘瓶中插了一束\n琼花，茶几旁两张雕漆椅。整个房间简朴幽静，为晚月庄供外客留宿\n的一间厢房。\n"
msgstr "這是一間客房，兩邊擺了一對小茶几。上面的彩繪瓶中插了一束\n瓊花，茶几旁兩張雕漆椅。整個房間簡樸幽靜，為晚月莊供外客留宿\n的一間廂房。\n"

msgid "这是一间上等厢房，光线适中。近窗边有一张桌子，旁有书橱!\n还有一个古琴放在平台上! 墙上除了美丽的饰物外，还挂了一些书画\n有一浓郁清新的书香气息! 通常是给远道而来的贵客休憩夜宿的一间\n上等厢房。\n"
msgstr "這是一間上等廂房，光線適中。近窗邊有一張桌子，旁有書櫥!\n還有一個古琴放在平臺上! 牆上除了美麗的飾物外，還掛了一些書畫\n有一濃郁清新的書香氣息! 通常是給遠道而來的貴客休憩夜宿的一間\n上等廂房。\n"

msgid "你走进一间装饰华丽的大饭厅，有一种说不出的气派，一张杉木  \n雕饰的大圆桌子在厅子中央，铺著丝绸彩桌巾，上等南湖紫玉盘，湘\n陵的瓷玉碗，银匙金筷。十分奢华。这是晚月庄宴请宾客的地方，平\n常也是庄主及庄内辈份高的前辈用膳的地方。\n"
msgstr "你走進一間裝飾華麗的大飯廳，有一種說不出的氣派，一張杉木  \n雕飾的大圓桌子在廳子中央，鋪著絲綢彩桌巾，上等南湖紫玉盤，湘\n陵的瓷玉碗，銀匙金筷。十分奢華。這是晚月莊宴請賓客的地方，平\n常也是莊主及莊內輩份高的前輩用膳的地方。\n"

msgid "这是一间膳房，中央摆了二张大圆桌。周围三十二张雕饰木藤椅。\n平常庄内上下用膳的地方，东边是厨房，西边则是大饭厅，这虽然不\n及饭厅华丽，但所有锅盘匙碗，也都是上等珍品。有大户人家的气派\n与富贵。\n"
msgstr "這是一間膳房，中央擺了二張大圓桌。周圍三十二張雕飾木藤椅。\n平常莊內上下用膳的地方，東邊是廚房，西邊則是大飯廳，這雖然不\n及飯廳華麗，但所有鍋盤匙碗，也都是上等珍品。有大戶人家的氣派\n與富貴。\n"

msgid "你走进厨房，看到有好多的烹饪用品与设备，小蒸笼、大锅、平  \n炊灶、烧饭炉等，五花八门，式样齐全。旁边的大仓储中，更放满各\n式各样山珍美味，各种材料，调味物品应有尽有。里头的掌厨师姐们\n忙里忙外，在为准备一道道佳肴辛苦著! 闻到那阵阵美味的菜香，你\n的肚子咕噜咕噜叫了起来!\n"
msgstr "你走進廚房，看到有好多的烹飪用品與設備，小蒸籠、大鍋、平  \n炊灶、燒飯爐等，五花八門，式樣齊全。旁邊的大倉儲中，更放滿各\n式各樣山珍美味，各種材料，調味物品應有盡有。裡頭的掌廚師姐們\n忙裡忙外，在為準備一道道佳餚辛苦著! 聞到那陣陣美味的菜香，你\n的肚子咕嚕咕嚕叫了起來!\n"

msgid "你进了后厅，这是后院上房五间中，最大的一间厅房。四面墙            \n壁，玲珑剔透，琴剑书画，挂在墙上。锦笼纱罩，金彩珠光，连地上                  \n踏的砖，皆是碧绿凿花，是雕空的紫檀板壁。厅上摆了二十六张桧木\n交椅，庄内对外展示舞步表演，都是在这举行。\n"
msgstr "你進了後廳，這是後院上房五間中，最大的一間廳房。四面牆            \n壁，玲瓏剔透，琴劍書畫，掛在牆上。錦籠紗罩，金彩珠光，連地上                  \n踏的磚，皆是碧綠鑿花，是雕空的紫檀板壁。廳上擺了二十六張檜木\n交椅，莊內對外展示舞步表演，都是在這舉行。\n"

msgid "这是一间安静的书房, 光线适中, 近窗边有一张桌子, 旁有书橱\n还有一个古琴放在平台上! 墙上除了美丽的饰物外, 还挂了一些书画                  \n有一股浓郁清新的书香气息!\n"
msgstr "這是一間安靜的書房, 光線適中, 近窗邊有一張桌子, 旁有書櫥\n還有一個古琴放在平臺上! 牆上除了美麗的飾物外, 還掛了一些書畫                  \n有一股濃郁清新的書香氣息!\n"

msgid "这是一间安静的书房, 光线适中。近窗边有一张桌子，旁有书橱! \n还有一个古琴放在平台上! 墙上除了美丽的饰物外，还挂了一些书画 \n有一股浓郁清新的书香气息! \n"
msgstr "這是一間安靜的書房, 光線適中。近窗邊有一張桌子，旁有書櫥! \n還有一個古琴放在平臺上! 牆上除了美麗的飾物外，還掛了一些書畫 \n有一股濃郁清新的書香氣息! \n"

msgid "通过后厅走道，接著你走进东厢房走道。除了长长的走道中，\n一排饰丽的宫灯! 走道两旁摆设了许多奇花异草，各有各的特色与\n形态，空气中弥漫一种淡淡的香气。往南通往东厢房。\n"
msgstr "通過後廳走道，接著你走進東廂房走道。除了長長的走道中，\n一排飾麗的宮燈! 走道兩旁擺設了許多奇花異草，各有各的特色與\n形態，空氣中瀰漫一種淡淡的香氣。往南通往東廂房。\n"

msgid "通过后厅走道，接著你走进东厢房走道。除了长长的走道中，\n一排饰丽的宫灯! 走道两旁摆设了许多奇花异草，各有各的特色与\n形态，空气中弥漫一种淡淡的香气。东面你看到一扇厢门。\n"
msgstr "通過後廳走道，接著你走進東廂房走道。除了長長的走道中，\n一排飾麗的宮燈! 走道兩旁擺設了許多奇花異草，各有各的特色與\n形態，空氣中瀰漫一種淡淡的香氣。東面你看到一扇廂門。\n"

msgid "你进入东厢房来，临窗的地上铺著猩红毛毯，正面设著大红金钱\n蟒靠背，石青金钱蟒引枕，秋香色金钱蟒大条褥。两边设一对梅花式\n红漆小几，几上茗琬瓶花俱备。这是一间上等厢房。\n"
msgstr "你進入東廂房來，臨窗的地上鋪著猩紅毛毯，正面設著大紅金錢\n蟒靠背，石青金錢蟒引枕，秋香色金錢蟒大條褥。兩邊設一對梅花式\n紅漆小几，几上茗琬瓶花俱備。這是一間上等廂房。\n"

msgid "通过后厅走道，接著你走进西厢房走道。长长的走道中，纯金\n成的长灯架上挂了一排饰丽的宫灯! 走道两旁摆设了许多奇花异草，\n空气中弥漫一种淡淡的香气。在一柱柱雕饰华丽的长柱，刻画许多\n彩绘的图形，美不胜收。\n"
msgstr "通過後廳走道，接著你走進西廂房走道。長長的走道中，純金\n成的長燈架上掛了一排飾麗的宮燈! 走道兩旁擺設了許多奇花異草，\n空氣中瀰漫一種淡淡的香氣。在一柱柱雕飾華麗的長柱，刻畫許多\n彩繪的圖形，美不勝收。\n"

msgid "你走在西厢房走道上。长长的走道中，纯金成的长灯架上挂了一排\n饰丽的宫灯! 走道两旁摆设了许多奇花异草，空气中弥漫一种淡淡的香\n气。在一柱柱雕饰华丽的长柱，刻画许多彩绘的图形，美不胜收。西面\n你看到一扇门。\n"
msgstr "你走在西廂房走道上。長長的走道中，純金成的長燈架上掛了一排\n飾麗的宮燈! 走道兩旁擺設了許多奇花異草，空氣中瀰漫一種淡淡的香\n氣。在一柱柱雕飾華麗的長柱，刻畫許多彩繪的圖形，美不勝收。西面\n你看到一扇門。\n"

msgid "你进入西厢房来，地下面西放著四张椅子，都搭著银红撒花椅被\n椅子两边有一对高几，右边几上文王鼎，匙筋香盒；左边几上汝窑美\n人瓶内插著花卉茗琬棰壶等物。隔窗望去，隐约可看见花园景色。.\n"
msgstr "你進入西廂房來，地下面西放著四張椅子，都搭著銀紅撒花椅被\n椅子兩邊有一對高几，右邊几上文王鼎，匙筋香盒；左邊几上汝窯美\n人瓶內插著花卉茗琬棰壺等物。隔窗望去，隱約可看見花園景色。.\n"

msgid "你进了内厅，迎面挂著葱绿洒花软帘，掀帘进去，抬头一看，\n只见四面墙壁，玲珑剔透，琴剑书画，挂在墙上。锦笼纱罩，金彩\n珠光，连地上踏的砖，皆是碧绿凿花，左一架书，右一架屏。四面\n是雕空的紫檀板壁。\n"
msgstr "你進了內廳，迎面掛著蔥綠灑花軟簾，掀簾進去，抬頭一看，\n只見四面牆壁，玲瓏剔透，琴劍書畫，掛在牆上。錦籠紗罩，金彩\n珠光，連地上踏的磚，皆是碧綠鑿花，左一架書，右一架屏。四面\n是雕空的紫檀板壁。\n"

msgid "通过『 垂花门 』便是往后院。垂花门为男女之门限，古来女\n人就有「大门不出，二门不迈」的谚语，于是二门堪称为男女门限\n。后院为庄内女弟子厢房，与湘园。东面一扇小门，为庄内更衣沐\n浴的小花池。更是严禁外人胡乱闯入。\n"
msgstr "通過『 垂花門 』便是往後院。垂花門為男女之門限，古來女\n人就有「大門不出，二門不邁」的諺語，於是二門堪稱為男女門限\n。後院為莊內女弟子廂房，與湘園。東面一扇小門，為莊內更衣沐\n浴的小花池。更是嚴禁外人胡亂闖入。\n"

msgid "这是一间更衣室，你看到许多柜子，衣架上挂了许多的衣服饰\n品。墙上的架上挂了一些丝巾，你可以闻到淡淡的香气围绕四周。\n东侧一蓝青洒花软帘，隔帘望去，隐约可看到小花池，一团的雾气\n你有点想去冲凉沐浴，让精神好些。当然此处是禁止男性进入!\n"
msgstr "這是一間更衣室，你看到許多櫃子，衣架上掛了許多的衣服飾\n品。牆上的架上掛了一些絲巾，你可以聞到淡淡的香氣圍繞四周。\n東側一藍青灑花軟簾，隔簾望去，隱約可看到小花池，一團的霧氣\n你有點想去沖涼沐浴，讓精神好些。當然此處是禁止男性進入!\n"

msgid "这是一个小花池，清澈的池水含著淡淡的幽香。池周围有许多奇花    \n异草，时如至芝兰之室，清香袭脑，温馨荡魄。缤纷的花瓣飘在池上，\n云幢羽葆中，簇拥著许多师姐妹，有的嘻戏玩耍，有的翩然起舞。你也\n想到小花池中沐浴休憩。\n"
msgstr "這是一個小花池，清澈的池水含著淡淡的幽香。池周圍有許多奇花    \n異草，時如至芝蘭之室，清香襲腦，溫馨蕩魄。繽紛的花瓣飄在池上，\n雲幢羽葆中，簇擁著許多師姐妹，有的嘻戲玩耍，有的翩然起舞。你也\n想到小花池中沐浴休憩。\n"

msgid "你走到前院，你看到几块山石，东面一处假山小池。其上植有藤  \n萝、青芷，异草芬芳荔薛。池中几尾小鱼自在的游来游去。假山外隔\n著围篱，有一种山怀中的小花园的感觉。.\n"
msgstr "你走到前院，你看到幾塊山石，東面一處假山小池。其上植有藤  \n蘿、青芷，異草芬芳荔薛。池中幾尾小魚自在的游來游去。假山外隔\n著圍籬，有一種山懷中的小花園的感覺。.\n"

msgid "走进月洞门，只见迎面一带翠嶂，挡在南面。只见白石崚嶒，  \n或如鬼怪，或如猛兽，纵横拱立，上边苔藓成斑，藤萝掩映，其\n中微露羊肠小径。往南进入翠嶂，往北是小花厅。\n"
msgstr "走進月洞門，只見迎面一帶翠嶂，擋在南面。只見白石崚嶒，  \n或如鬼怪，或如猛獸，縱橫拱立，上邊苔蘚成斑，藤蘿掩映，其\n中微露羊腸小徑。往南進入翠嶂，往北是小花廳。\n"

msgid "穿过一层竹篱、花嶂编的月洞门，在你眼前出现的是那由粉墙环\n护，绿柳周垂的翠嶂。两边分别是游廊相接通往桃花林与长廊曲洞。\n在这儿一棵西府海棠吸引你的注意，只见其势若伞，丝垂翠\n缕，葩吐丹砂，十分漂亮。\n"
msgstr "穿過一層竹籬、花嶂編的月洞門，在你眼前出現的是那由粉牆環\n護，綠柳周垂的翠嶂。兩邊分別是遊廊相接通往桃花林與長廊曲洞。\n在這兒一棵西府海棠吸引你的注意，只見其勢若傘，絲垂翠\n縷，葩吐丹砂，十分漂亮。\n"

msgid "湘园的桂花小径是以不同颜色的细石砌成各种图案。路面的\n图案组成，全员是一个整体。但每幅图案又有独立的内容，总计\n花石子路上约有二百幅。沿路观赏，美不胜收。\n"
msgstr "湘園的桂花小徑是以不同顏色的細石砌成各種圖案。路面的\n圖案組成，全員是一個整體。但每幅圖案又有獨立的內容，總計\n花石子路上約有二百幅。沿路觀賞，美不勝收。\n"

msgid "你走入一长廊曲洞，里头略略的有几点山石，种著芭蕉，你可以\n听到潺潺的流水声，这里是园内假山开凿的通道，蜿蜒盘旋，从洞口\n向外望去，是一碧清的水池。顺著曲径走去，转了两个弯子，看见一\n座石板桥。\n"
msgstr "你走入一長廊曲洞，裡頭略略的有幾點山石，種著芭蕉，你可以\n聽到潺潺的流水聲，這裡是園內假山開鑿的通道，蜿蜒盤旋，從洞口\n向外望去，是一碧清的水池。順著曲徑走去，轉了兩個彎子，看見一\n座石板橋。\n"

msgid "这是一片桂花园，园内种植桂花树十万多株，枝干苍劲，枝叶  \n茂盛，树冠完整，富有生气。放眼展望，满遍披翠盖绿，葱郁的桂\n花树斑烂绚丽，优雅大方，碧海银花，清香阵阵。薰的游人醉，衣\n发常留馀香。\n"
msgstr "這是一片桂花園，園內種植桂花樹十萬多株，枝幹蒼勁，枝葉  \n茂盛，樹冠完整，富有生氣。放眼展望，滿遍披翠蓋綠，蔥鬱的桂\n花樹斑爛絢麗，優雅大方，碧海銀花，清香陣陣。薰的遊人醉，衣\n發常留餘香。\n"

msgid "你走至大桥前，见水如晶帘一般奔入，扶著藤栏过去，只见水\n上落花愈多，其水愈清，溶溶荡荡，曲折萦纡，池边两行垂柳，杂\n著桃、杏，遮天蔽日般，真无一些尘土。度过桥去则通往湖心亭。\n"
msgstr "你走至大橋前，見水如晶簾一般奔入，扶著藤欄過去，只見水\n上落花愈多，其水愈清，溶溶蕩蕩，曲折縈紆，池邊兩行垂柳，雜\n著桃、杏，遮天蔽日般，真無一些塵土。度過橋去則通往湖心亭。\n"

msgid "走在桥上，可以远观山坡帏脉，两边飞楼插空，雕饰绣栏，隐\n于亭园树木之间；俯而视之，则清流泻雪石磴穿云。朱红玉石为栏\n，环抱池沿，柳垂金线，桃吐丹霞。\n"
msgstr "走在橋上，可以遠觀山坡幃脈，兩邊飛樓插空，雕飾繡欄，隱\n於亭園樹木之間；俯而視之，則清流瀉雪石磴穿雲。朱紅玉石為欄\n，環抱池沿，柳垂金線，桃吐丹霞。\n"

msgid "桂花园的石子甬道是以不同颜色的细石砌成各种图案。路面\n的图案组成，全员是一个整体。但每幅图案又有独立的内容，总\n计花石子路上约有二百幅。沿路观赏，美不胜收。\n"
msgstr "桂花園的石子甬道是以不同顏色的細石砌成各種圖案。路面\n的圖案組成，全員是一個整體。但每幅圖案又有獨立的內容，總\n計花石子路上約有二百幅。沿路觀賞，美不勝收。\n"

msgid "你一进了小轩内，只觉异香扑鼻，那些奇草仙藤，越冷越苍翠，\n都结了实，似珊瑚豆子一般，累垂可爱。房内雪洞一般，清凉舒适  \n，案上一个土定瓶，中供著数枝菊花，旁边放了两本书、茶瓯茶杯  \n而已，床上只吊著青纱帐幔被褥，也十分朴实。\n"
msgstr "你一進了小軒內，只覺異香撲鼻，那些奇草仙藤，越冷越蒼翠，\n都結了實，似珊瑚豆子一般，累垂可愛。房內雪洞一般，清涼舒適  \n，案上一個土定瓶，中供著數枝菊花，旁邊放了兩本書、茶甌茶杯  \n而已，床上只吊著青紗帳幔被褥，也十分樸實。\n"

msgid "亭子座落在园内小水池上，亭柱周围以弧形座凳式栏板，内外\n雕刻各种不同样式的梅枝，钻尖式紫琉璃瓦顶，天花板也有雕刻非\n常精细的百花图案。上下担额枋彩画题材是海墁式点金加彩琼花。\n体形别致，色彩丰富。亭边石桥飞架，通萃赏楼，轻灵精巧，为园\n中一大奇景。\n"
msgstr "亭子座落在園內小水池上，亭柱周圍以弧形座凳式欄板，內外\n雕刻各種不同樣式的梅枝，鑽尖式紫琉璃瓦頂，天花板也有雕刻非\n常精細的百花圖案。上下擔額枋彩畫題材是海墁式點金加彩瓊花。\n體形別緻，色彩豐富。亭邊石橋飛架，通萃賞樓，輕靈精巧，為園\n中一大奇景。\n"

msgid "暖香榭位于水池东岸，秋水山房之西，依岩为屋，结构曲折，\n极幽致，室小而精，尚朴去华，渊然静修，古香袭人。走进这里\n你有一种心源湛澈，天地虚灵，彷佛置身于仙境的感觉。往西面\n望去，水底亭台，历历可鉴。\n"
msgstr "暖香榭位於水池東岸，秋水山房之西，依岩為屋，結構曲折，\n極幽致，室小而精，尚樸去華，淵然靜修，古香襲人。走進這裡\n你有一種心源湛澈，天地虛靈，彷彿置身於仙境的感覺。往西面\n望去，水底亭臺，歷歷可鑑。\n"

msgid "转过翠嫣桥，隐隐露出一带黄泥筑就矮墙，墙头用稻茎掩护，\n有几百株杏花，如喷火蒸霞一般，里面数楹茅屋，外面却是桑、\n榆、槿、杉各色树木新条，随其曲折编就两溜青篱，篱外有一土  \n井，旁有一石牌。旁边有一些佳蔬菜花。\n"
msgstr "轉過翠嫣橋，隱隱露出一帶黃泥築就矮牆，牆頭用稻莖掩護，\n有幾百株杏花，如噴火蒸霞一般，裡面數楹茅屋，外面卻是桑、\n榆、槿、杉各色樹木新條，隨其曲折編就兩溜青籬，籬外有一土  \n井，旁有一石牌。旁邊有一些佳蔬菜花。\n"

msgid "这是一座最精美的桥，全长十二米，宽度恰可走两人。石拱\n是单孔结构，青石桥面，汉白玉雕石栏杆，栏板上刻有精致美丽\n的花纹。二十个望柱头上各有一小孔雀，情态各异，饶有趣味。\n"
msgstr "這是一座最精美的橋，全長十二米，寬度恰可走兩人。石拱\n是單孔結構，青石橋面，漢白玉雕石欄杆，欄板上刻有精緻美麗\n的花紋。二十個望柱頭上各有一小孔雀，情態各異，饒有趣味。\n"

msgid "你走在石子墁的花园甬路上，只见两边翠竹夹路，土地下苍苔\n布满，往东北你看到凤尾森森，龙吟细细，通往暖香榭。南面则是\n一个小门。西方通往园中小桥。\n"
msgstr "你走在石子墁的花園甬路上，只見兩邊翠竹夾路，土地下蒼苔\n佈滿，往東北你看到鳳尾森森，龍吟細細，通往暖香榭。南面則是\n一個小門。西方通往園中小橋。\n"

msgid "这是晚月庄的后门，在美丽的湘园南侧，这有一个木制的小门。\n走出门外应是通往天山的小径。\n"
msgstr "這是晚月莊的後門，在美麗的湘園南側，這有一個木製的小門。\n走出門外應是通往天山的小徑。\n"

msgid "你走在后厅二楼的走廊上，庄内像这样的走廊很多，你若没有地\n理概念很容易迷路。长长的走道中, 纯金铸成的长灯架上挂了一排饰\n丽的宫灯! 入夜之后灯火辉煌! 十分美丽!\n"
msgstr "你走在後廳二樓的走廊上，莊內像這樣的走廊很多，你若沒有地\n理概念很容易迷路。長長的走道中, 純金鑄成的長燈架上掛了一排飾\n麗的宮燈! 入夜之後燈火輝煌! 十分美麗!\n"

msgid "这是晚月庄的舞曲步法研究室, 名曰「翠湘」。墙上刻画著各种\n基本步法与一些诗词曲赋。在每一位美女图的姿态形体之中，那种翩\n然起舞的曼妙舞姿，含蕴许多珍贵奇妙的舞步。你可以看到几位师姐\n一起走著奇特的步法，正在试著模拟这些舞步，一边低头沉思要如何\n运用，十分的投入。\n"
msgstr "這是晚月莊的舞曲步法研究室, 名曰「翠湘」。牆上刻畫著各種\n基本步法與一些詩詞曲賦。在每一位美女圖的姿態形體之中，那種翩\n然起舞的曼妙舞姿，含蘊許多珍貴奇妙的舞步。你可以看到幾位師姐\n一起走著奇特的步法，正在試著模擬這些舞步，一邊低頭沉思要如何\n運用，十分的投入。\n"

msgid "这里是庄院二楼的佛堂门前，你可以闻到一股浓郁的檀香气息。\n走在这里你有一种庄严肃静的感觉，在闲暇之馀你觉得来到这可以\n暂时忘去周遭的烦人琐事，彷佛可以放开一切，所有时空都静止般\n的虚空幽静。西面你看到一扇檀香木门。\n"
msgstr "這裡是莊院二樓的佛堂門前，你可以聞到一股濃郁的檀香氣息。\n走在這裡你有一種莊嚴肅靜的感覺，在閒暇之餘你覺得來到這可以\n暫時忘去周遭的煩人瑣事，彷彿可以放開一切，所有時空都靜止般\n的虛空幽靜。西面你看到一扇檀香木門。\n"

msgid "这是专供庄内祭祀的佛堂，是一座精构楼阁，屋顶覆以琉璃瓦，四\n角钻尖覆以鎏金铜瓦。堂内供奉  人灵「区冥」，旁有雨神「天龙」、\n火神「凤凰」。两翼有琉璃鹤照壁，姿态生动。四周置陈神龛佛像，供\n盘塔磬，及一股檀香的气息。\n"
msgstr "這是專供莊內祭祀的佛堂，是一座精構樓閣，屋頂覆以琉璃瓦，四\n角鑽尖覆以鎏金銅瓦。堂內供奉  人靈「區冥」，旁有雨神「天龍」、\n火神「鳳凰」。兩翼有琉璃鶴照壁，姿態生動。四周置陳神龕佛像，供\n盤塔磬，及一股檀香的氣息。\n"

msgid "这里是庄院二楼的前堂楼，有著传统的古式建筑风格。由上好的        \n桧木搭建而成, 东面一阵耀眼的的白光由两扇敞开的落地窗口射进来\n，泛映出一种清新幽静的格局。开了楼门出去可以一览庄院内外的山\n川景色，欣赏其美丽景观。\n"
msgstr "這裡是莊院二樓的前堂樓，有著傳統的古式建築風格。由上好的        \n檜木搭建而成, 東面一陣耀眼的的白光由兩扇敞開的落地窗口射進來\n，泛映出一種清新幽靜的格局。開了樓門出去可以一覽莊院內外的山\n川景色，欣賞其美麗景觀。\n"

msgid "这是晚月庄的前堂楼观景台，站在台前你可以看到整个庄院的  \n布局，瀚烟山美丽景色尽收眼里。微微的山风轻拂你的脸庞，有种\n说不出的轻爽。远处山寺的钟声，飞鸟的鸣啼，与眼前的景色构成\n一幅山林风光的风景画。正下方是前院。\n"
msgstr "這是晚月莊的前堂樓觀景臺，站在臺前你可以看到整個莊院的  \n佈局，瀚煙山美麗景色盡收眼裡。微微的山風輕拂你的臉龐，有種\n說不出的輕爽。遠處山寺的鐘聲，飛鳥的鳴啼，與眼前的景色構成\n一幅山林風光的風景畫。正下方是前院。\n"

msgid "这是晚月庄让弟子们静修的地方, 名曰「缀芳」。简单的布置加上\n一座檀香炉, 你觉得这绝对是一个静修的好场所。空气中弥漫\n著一股肃穆的气息, 使人很容易进入忘我的境界。\n"
msgstr "這是晚月莊讓弟子們靜修的地方, 名曰「綴芳」。簡單的佈置加上\n一座檀香爐, 你覺得這絕對是一個靜修的好場所。空氣中瀰漫\n著一股肅穆的氣息, 使人很容易進入忘我的境界。\n"

msgid "你走在一条蜿蜒的小径, 小径的两旁是半个人高的杂草, 你可以感受\n到清凉的微风从两侧吹来。\n"
msgstr "你走在一條蜿蜒的小徑, 小徑的兩旁是半個人高的雜草, 你可以感受\n到清涼的微風從兩側吹來。\n"

msgid "你走在这条蜿蜒的小径上, 本来向北走的小径被一道峭壁挡住了,\n因此小径从这弯向东边去, 在你的西边是一片杂草和几棵小树。\n"
msgstr "你走在這條蜿蜒的小徑上, 本來向北走的小徑被一道峭壁擋住了,\n因此小徑從這彎向東邊去, 在你的西邊是一片雜草和幾棵小樹。\n"

msgid "条蜿蜒的小径通往东南方, 在你的东面是一道峭壁, 而在你的\n南边是一片浓密的竹林。\n"
msgstr "條蜿蜒的小徑通往東南方, 在你的東面是一道峭壁, 而在你的\n南邊是一片濃密的竹林。\n"

msgid "这条蜿蜒的小径通往西南方, 西边是一片茂密的竹林, 小\n径两旁是绿油油的草地，凉风从草地上吹拂而过，像嬉戏的儿\n童般溜过你的足畔，使你不知不觉间脚步轻快了起来。\n"
msgstr "這條蜿蜒的小徑通往西南方, 西邊是一片茂密的竹林, 小\n徑兩旁是綠油油的草地，涼風從草地上吹拂而過，像嬉戲的兒\n童般溜過你的足畔，使你不知不覺間腳步輕快了起來。\n"

msgid "这条蜿蜒的小径通往东南方, 在你的东面是一处陡坡, 而在你的\n西边是一座茂密的竹林。\n"
msgstr "這條蜿蜒的小徑通往東南方, 在你的東面是一處陡坡, 而在你的\n西邊是一座茂密的竹林。\n"

msgid "这是一座茂密的竹林。当你进入后彷佛迷失了方向！\n"
msgstr "這是一座茂密的竹林。當你進入後彷彿迷失了方向！\n"

msgid "拱门"
msgstr "拱門"

msgid "铜门"
msgstr "銅門"

msgid "后厅大门"
msgstr "後廳大門"

msgid "雕饰厢门"
msgstr "雕飾廂門"

msgid "垂花门"
msgstr "垂花門"

msgid "小帘门"
msgstr "小簾門"

msgid "檀香木门"
msgstr "檀香木門"

msgid "楼门"
msgstr "樓門"

msgid "茶壶"
msgstr "茶壺"

msgid "八卦图"
msgstr "八卦圖"

msgid "你现在的神太少了，无法专注跳出舞步！"
msgstr "你現在的神太少了，無法專注跳出舞步！"

msgid "你在卦象中跳起舞来。但似乎不得要领！"
msgstr "你在卦象中跳起舞來。但似乎不得要領！"

msgid "$N在卦象中跳起舞来..一曲「 有凤来仪 」突然..."
msgstr "$N在卦象中跳起舞來..一曲「 有鳳來儀 」突然..."

msgid "$N在卦象中跳起舞来..一曲「 西出阳关 」突然..."
msgstr "$N在卦象中跳起舞來..一曲「 西出陽關 」突然..."

msgid "请人替跳"
msgstr "請人替跳"

msgid "冰匣已经开了。\n"
msgstr "冰匣已經開了。\n"

msgid "看我的！"
msgstr "看我的！"

msgid "走到卦象中央，一个姿势，起舞——一曲「有凤来仪」，脚尖从乾到坎没点错一个。"
msgstr "走到卦象中央，一個姿勢，起舞——一曲「有鳳來儀」，腳尖從乾到坎沒點錯一個。"

msgid "冰匣的盖子无声地滑开了。一件月白的衣从匣里浮起来，落在地上——寒气扑面，屋里的灯焰都矮了一截。\n"
msgstr "冰匣的蓋子無聲地滑開了。一件月白的衣從匣裡浮起來，落在地上——寒氣撲面，屋裡的燈焰都矮了一截。\n"

msgid "好不好看！我得回去啦，不然蓝姐姐要骂。"
msgstr "好不好看！我得回去啦，不然藍姐姐要罵。"

msgid "替你跳一支？好。我舞跳得不好，这一支倒是会的。"
msgstr "替你跳一支？好。我舞跳得不好，這一支倒是會的。"

msgid "在卦象中起舞，一曲「有凤来仪」，轻得像没踩在地上。"
msgstr "在卦象中起舞，一曲「有鳳來儀」，輕得像沒踩在地上。"

msgid "几百年没人跳对过——原来是要给人跳的。"
msgstr "幾百年沒人跳對過——原來是要給人跳的。"

msgid "这里没有人替你跳。筱薇在隔壁的内厅，芳绫关在前院的禁闭房。\n"
msgstr "這裡沒有人替你跳。筱薇在隔壁的內廳，芳綾關在前院的禁閉房。\n"

msgid "神位前"
msgstr "神位前"

msgid "你在神位前跳起舞来。但似乎不得要领！"
msgstr "你在神位前跳起舞來。但似乎不得要領！"

msgid "舞到最后一转，满堂的檀香烟忽然一齐往上走。区冥神像的眉间亮了一下，像高处有人点了一盏灯。\n"
msgstr "舞到最後一轉，滿堂的檀香煙忽然一齊往上走。區冥神像的眉間亮了一下，像高處有人點了一盞燈。\n"

msgid "$N在区冥的神位前跳起舞来..一曲「 沧海龙吟 」，步子是图上的，曲子是谱上的..."
msgstr "$N在區冥的神位前跳起舞來..一曲「 滄海龍吟 」，步子是圖上的，曲子是譜上的..."

msgid "沧海龙吟已经在神位前跳过了。\n"
msgstr "滄海龍吟已經在神位前跳過了。\n"

msgid "图和谱还没凑齐，谁也跳不出沧海龙吟。\n"
msgstr "圖和譜還沒湊齊，誰也跳不出滄海龍吟。\n"

msgid "走到神位前，照着图上的姿势起舞——一曲「沧海龙吟」，转到第七转时裙角带起了风。"
msgstr "走到神位前，照著圖上的姿勢起舞——一曲「滄海龍吟」，轉到第七轉時裙角帶起了風。"

msgid "跳成了！跳成了！我要去跟蓝姐姐说——不行，她会骂我偷跑出来。"
msgstr "跳成了！跳成了！我要去跟藍姐姐說——不行，她會罵我偷跑出來。"

msgid "沧海龙吟？谱是我让你去找的，这一支我来跳。"
msgstr "滄海龍吟？譜是我讓你去找的，這一支我來跳。"

msgid "在神位前站定，袖子一扬，一曲「沧海龙吟」，满身都是寒谷的幽香。"
msgstr "在神位前站定，袖子一揚，一曲「滄海龍吟」，滿身都是寒谷的幽香。"

msgid "几十年没人跳过了——区冥还认得。"
msgstr "幾十年沒人跳過了——區冥還認得。"

msgid "这里没有人替你跳。翠湘阁的莫欣芳在回廊那头，芳绫关在前院的禁闭房。\n"
msgstr "這裡沒有人替你跳。翠湘閣的莫欣芳在迴廊那頭，芳綾關在前院的禁閉房。\n"

msgid "碧纱橱"
msgstr "碧紗櫥"

msgid "翻找"
msgstr "翻找"

msgid "你盲目的找著，但无发现什么!\n"
msgstr "你盲目的找著，但無發現什麼!\n"

msgid "你翻箱倒柜想找出手镯，但似乎毫无所获。\n"
msgstr "你翻箱倒櫃想找出手鐲，但似乎毫無所獲。\n"

msgid "你从橱子内取出玛瑙手镯。"
msgstr "你從櫥子內取出瑪瑙手鐲。"

msgid "石床"
msgstr "石床"

msgid "你在石床后面找到了一本舞曲谱！\n"
msgstr "你在石床後面找到了一本舞曲譜！\n"

msgid "你在石床附近找了很久，结果一无所获。\n"
msgstr "你在石床附近找了很久，結果一無所獲。\n"

msgid "沐浴"
msgstr "沐浴"

msgid "此处是禁止男性进入！男人下池沐浴会中火玫瑰毒：毒发时不断伤神，伤得重了会丧命。\n确定要下池沐浴吗？"
msgstr "此處是禁止男性進入！男人下池沐浴會中火玫瑰毒：毒發時不斷傷神，傷得重了會喪命。\n確定要下池沐浴嗎？"

msgid "确定沐浴"
msgstr "確定沐浴"

msgid "你觉得池水好像有种奇特的沁凉！\n"
msgstr "你覺得池水好像有種奇特的沁涼！\n"

msgid "你在池子中尽情沐浴，舒服的泡在池中。\n"
msgstr "你在池子中盡情沐浴，舒服的泡在池中。\n"

msgid "静修"
msgstr "靜修"

msgid "你双手合掌，安静的坐在地上。\n"
msgstr "你雙手合掌，安靜的坐在地上。\n"

msgid "你彷佛变的较为祥合慈善了! \n"
msgstr "你彷彿變的較為祥合慈善了! \n"

msgid "冰匣"
msgstr "冰匣"

msgid "一只玄冰雕的匣子，齐膝高，匣盖上结着不化的霜。匣面刻着一行小字：凤仪起，匣自开。几百年没人跳对过。\n"
msgstr "一隻玄冰雕的匣子，齊膝高，匣蓋上結著不化的霜。匣面刻著一行小字：鳳儀起，匣自開。幾百年沒人跳對過。\n"

msgid "灯笼"
msgstr "燈籠"

msgid "灯笼上几个娟秀的字迹写著：\n晚霞西照人影依稀 \n月影高挂和风婉约 \n"
msgstr "燈籠上幾個娟秀的字跡寫著：\n晚霞西照人影依稀 \n月影高掛和風婉約 \n"

msgid "墙"
msgstr "牆"

msgid "    你仔细观看石墙，突然发现原本单调的墙上隐隐约约出现了\n一幅渺渺茫茫，似有似无的景像。彷佛是幻境，但又似真实，你\n清楚的看到一首词：「梦里消魂无说处，觉来惆怅消魂误。」\n"
msgstr "    你仔細觀看石牆，突然發現原本單調的牆上隱隱約約出現了\n一幅渺渺茫茫，似有似無的景像。彷彿是幻境，但又似真實，你\n清楚的看到一首詞：「夢裡消魂無說處，覺來惆悵消魂誤。」\n"

msgid "取出衣服"
msgstr "取出衣服"

msgid "你从橱子内取出布裙。"
msgstr "你從櫥子內取出布裙。"

msgid "橱子内的衣服好像被拿光了。"
msgstr "櫥子內的衣服好像被拿光了。"

msgid "这是一个上等木材作成的小橱子，里面放了一些物品。\n你看到一件件的美丽衣饰，真想取出看看。\n"
msgstr "這是一個上等木材作成的小櫥子，裡面放了一些物品。\n你看到一件件的美麗衣飾，真想取出看看。\n"

msgid "湘绣舞曲图"
msgstr "湘繡舞曲圖"

msgid "这是一幅湘绣的彩图，上有几名貌美的女子，以不同的姿态\n舞著，其漫妙之处让你著迷。图旁另绣有一曲名『西出阳关』\n与『有凤来仪 』\n"
msgstr "這是一幅湘繡的彩圖，上有幾名貌美的女子，以不同的姿態\n舞著，其漫妙之處讓你著迷。圖旁另繡有一曲名『西出陽關』\n與『有鳳來儀 』\n"

msgid "西府海棠"
msgstr "西府海棠"

msgid "摘花蕊"
msgstr "摘花蕊"

msgid "你从西府海棠中摘下一朵小花蕊。"
msgstr "你從西府海棠中摘下一朵小花蕊。"

msgid "西府海棠上的小花蕊已经被摘光了。"
msgstr "西府海棠上的小花蕊已經被摘光了。"

msgid "    你仔细看这是一棵形状有些奇特的西府海棠，有一淡淡\n的奇异香气。原来在旁边还有一朵不太起眼，但是略成金黄\n色的小花蕊，你的直觉告诉你它似乎是一种珍贵药材。你想\n把它摘下。\n"
msgstr "    你仔細看這是一棵形狀有些奇特的西府海棠，有一淡淡\n的奇異香氣。原來在旁邊還有一朵不太起眼，但是略成金黃\n色的小花蕊，你的直覺告訴你它似乎是一種珍貴藥材。你想\n把它摘下。\n"

msgid "石牌"
msgstr "石牌"

msgid "\n 「六神」、「四鬼」、「三灵」 \n\n         旋芒震日月\n         宝剑护河山\n\n"
msgstr "\n 「六神」、「四鬼」、「三靈」 \n\n         旋芒震日月\n         寶劍護河山\n\n"

msgid "此处是禁止男性进入！闯进去的男人会被晚月庄的女弟子撒下火玫瑰毒、一脚踢出来：毒发时不断伤神，伤得重了会丧命。\n确定要进去吗？"
msgstr "此處是禁止男性進入！闖進去的男人會被晚月莊的女弟子撒下火玫瑰毒、一腳踢出來：毒發時不斷傷神，傷得重了會喪命。\n確定要進去嗎？"

msgid "确定进去"
msgstr "確定進去"

msgid "你将瓷杯交回给雨梅。\n"
msgstr "你將瓷杯交回給雨梅。\n"

msgid "你起身往南离开!"
msgstr "你起身往南離開!"

msgid "这个知客僧脸色和蔼，虽然在寺中的地位不高，但是他总是让人有一种\n值得信赖的感觉。\n"
msgstr "這個知客僧臉色和藹，雖然在寺中的地位不高，但是他總是讓人有一種\n值得信賴的感覺。\n"

msgid "阿弥陀佛！小僧武功低微，认输便是。"
msgstr "阿彌陀佛！小僧武功低微，認輸便是。"

msgid "瞧这个头陀的模样与服色，似乎不是山烟寺的僧人，但是他大喇喇地站在\n这里，一副不可一世的样子。\n"
msgstr "瞧這個頭陀的模樣與服色，似乎不是山煙寺的僧人，但是他大喇喇地站在\n這裡，一副不可一世的樣子。\n"

msgid "独眼头陀跟在你身后，大步流星，那只独眼盯着前头的路。\n"
msgstr "獨眼頭陀跟在你身後，大步流星，那隻獨眼盯著前頭的路。\n"

msgid "独眼头陀抱着刀站着，那只独眼半闭着，像是睡着了。\n"
msgstr "獨眼頭陀抱著刀站著，那隻獨眼半閉著，像是睡著了。\n"

msgid "看了一眼叶边那行字，没有接。"
msgstr "看了一眼葉邊那行字，沒有接。"

msgid "师父的字……你拿着。问我「经」。"
msgstr "師父的字……你拿著。問我「經」。"

msgid "病人"
msgstr "病人"

msgid "大喇喇地站着，不理你。"
msgstr "大喇喇地站著，不理你。"

msgid "转过身去，不理你。"
msgstr "轉過身去，不理你。"

msgid "那樵夫的寒，赶干净了。"
msgstr "那樵夫的寒，趕乾淨了。"

msgid "走啊。流云轩在哪，你比我熟。"
msgstr "走啊。流雲軒在哪，你比我熟。"

msgid "那只独眼转过来，盯着你看了很久。"
msgstr "那隻獨眼轉過來，盯著你看了很久。"

msgid "流云轩那个樵夫。寒气退不下去，是不是？"
msgstr "流雲軒那個樵夫。寒氣退不下去，是不是？"

msgid "那是鬼卒的阴寒，钻进骨头了。玄智的药是凉性的底子，赶不出来。"
msgstr "那是鬼卒的陰寒，鑽進骨頭了。玄智的藥是涼性的底子，趕不出來。"

msgid "我能。"
msgstr "我能。"

msgid "我的内功是火性的。可他们的寺规不许外人进流云轩——十年了，我连金门都没进过。"
msgstr "我的內功是火性的。可他們的寺規不許外人進流雲軒——十年了，我連金門都沒進過。"

msgid "你领我进去（问我「领路」），或者照他们的寺规来。"
msgstr "你領我進去（問我「領路」），或者照他們的寺規來。"

msgid "领路"
msgstr "領路"

msgid "领独眼头陀进流云轩，让他给老葛治伤。\n寺规不许外人进流云轩：老葛当场好，玄智记你不守寺规（山烟寺的弟子，这一回没有晋阶）；头陀从此肯跟你说话。\n这是山烟寺这条线上的一个选择，选了不能改，照寺规那条路就没了。要领他去吗？"
msgstr "領獨眼頭陀進流雲軒，讓他給老葛治傷。\n寺規不許外人進流雲軒：老葛當場好，玄智記你不守寺規（山煙寺的弟子，這一回沒有晉階）；頭陀從此肯跟你說話。\n這是山煙寺這條線上的一個選擇，選了不能改，照寺規那條路就沒了。要領他去嗎？"

msgid "治完了。"
msgstr "治完了。"

msgid "走。"
msgstr "走。"

msgid "把刀往背后一插，跟在你身后。"
msgstr "把刀往背後一插，跟在你身後。"

msgid "我是从番坊来的。日陀罗寺。"
msgstr "我是從番坊來的。日陀羅寺。"

msgid "摸了摸那只瞎眼上的眼罩。"
msgstr "摸了摸那隻瞎眼上的眼罩。"

msgid "我练的经，玄智的寺里不认。三十年前不认，今天也不认。……别的，去问我师父。"
msgstr "我練的經，玄智的寺裡不認。三十年前不認，今天也不認。……別的，去問我師父。"

msgid "经"
msgstr "經"

msgid "native:fanfang/sutra_leaf"
msgstr "native:fanfang/sutra_leaf"

msgid "你把那片贝叶举到他眼前。他转回来了。\n"
msgstr "你把那片貝葉舉到他眼前。他轉回來了。\n"

msgid "接过那片贝叶，那只独眼在叶边那行字上停了很久。"
msgstr "接過那片貝葉，那隻獨眼在葉邊那行字上停了很久。"

msgid "师父的字。"
msgstr "師父的字。"

msgid "「收不收，是山烟寺的事。」……十年，我站在门外，等的就是这一句。"
msgstr "「收不收，是山煙寺的事。」……十年，我站在門外，等的就是這一句。"

msgid "我上殿去。你也来——玄智要问一个人，问的是你。"
msgstr "我上殿去。你也來——玄智要問一個人，問的是你。"

msgid "独眼头陀把贝叶揣进怀里，大步跨进了金门，往大雄宝殿去了。\n"
msgstr "獨眼頭陀把貝葉揣進懷裡，大步跨進了金門，往大雄寶殿去了。\n"

msgid "（龙若法王给你的那片贝叶，要举到他眼前。）\n"
msgstr "（龍若法王給你的那片貝葉，要舉到他眼前。）\n"

msgid "师父给你的东西呢？"
msgstr "師父給你的東西呢？"

msgid "僧人"
msgstr "僧人"

msgid "一个笑咪咪的僧人对著你微微颔首。\n"
msgstr "一個笑咪咪的僧人對著你微微頷首。\n"

msgid "阿弥陀佛！贫僧武功低微，施主不要开这种玩笑。"
msgstr "阿彌陀佛！貧僧武功低微，施主不要開這種玩笑。"

msgid "这个僧人跛了右腿，脸上没有什么表情，一副若有所思的样子。\n"
msgstr "這個僧人跛了右腿，臉上沒有什麼表情，一副若有所思的樣子。\n"

msgid "阿弥陀佛！贫僧武功低微，又是个残废，施主不要开这种玩笑。"
msgstr "阿彌陀佛！貧僧武功低微，又是個殘廢，施主不要開這種玩笑。"

msgid "一位长得相当精壮的年轻僧人, 他正在整理药材。\n"
msgstr "一位長得相當精壯的年輕僧人, 他正在整理藥材。\n"

msgid "替流云轩帮这个忙，做「流云轩的帮手」。\n山烟寺和东方神教是死对头：帮了流云轩，朱鸿雪的令就不会再交给你。\n要帮吗？"
msgstr "替流雲軒幫這個忙，做「流雲軒的幫手」。\n山煙寺和東方神教是死對頭：幫了流雲軒，朱鴻雪的令就不會再交給你。\n要幫嗎？"

msgid "看了你一眼，低下头接着整理药材，一句话也不说。"
msgstr "看了你一眼，低下頭接著整理藥材，一句話也不說。"

msgid "流云轩的事，不劳施主了。"
msgstr "流雲軒的事，不勞施主了。"

msgid "鬼卒抓的伤，流云轩现在治得了——头陀师兄一掌按下去，寒气冒成一缕白烟。"
msgstr "鬼卒抓的傷，流雲軒現在治得了——頭陀師兄一掌按下去，寒氣冒成一縷白煙。"

msgid "方丈说，早十年就该开那道门。"
msgstr "方丈說，早十年就該開那道門。"

msgid "鬼卒抓的伤，流云轩还是治不了。……方丈说，本寺一脉。"
msgstr "鬼卒抓的傷，流雲軒還是治不了。……方丈說，本寺一脈。"

msgid "老葛回乔阴了。方丈守了他三天三夜……那只右手是保不住了。"
msgstr "老葛回喬陰了。方丈守了他三天三夜……那隻右手是保不住了。"

msgid "老葛好了，回乔阴去了。……那头陀的手，热得跟炭一样。"
msgstr "老葛好了，回喬陰去了。……那頭陀的手，熱得跟炭一樣。"

msgid "药喂下去了，寒气还是退不下去。"
msgstr "藥餵下去了，寒氣還是退不下去。"

msgid "方丈的方子：附子、麝香、鬼臼。三味齐了，拿来给我煎（问我「煎药」）。"
msgstr "方丈的方子：附子、麝香、鬼臼。三味齊了，拿來給我煎（問我「煎藥」）。"

msgid "乔阴来的樵夫，伤口是冷的。去前殿问方丈「流云轩」。"
msgstr "喬陰來的樵夫，傷口是冷的。去前殿問方丈「流雲軒」。"

msgid "师兄，乔阴来的樵夫老葛，在树王坟被鬼卒抓了一把，伤口是冷的。"
msgstr "師兄，喬陰來的樵夫老葛，在樹王墳被鬼卒抓了一把，傷口是冷的。"

msgid "方丈的药压不住。去前殿问方丈「流云轩」吧。"
msgstr "方丈的藥壓不住。去前殿問方丈「流雲軒」吧。"

msgid "朝草垫上那个裹着两床被子的人努了努嘴。"
msgstr "朝草墊上那個裹著兩床被子的人努了努嘴。"

msgid "乔阴来的樵夫，姓葛，在树王坟被鬼卒抓了一把。伤口是冷的，方丈的药压不住。"
msgstr "喬陰來的樵夫，姓葛，在樹王墳被鬼卒抓了一把。傷口是冷的，方丈的藥壓不住。"

msgid "你肯帮忙？……好。去前殿问方丈「流云轩」，他开方子。"
msgstr "你肯幫忙？……好。去前殿問方丈「流雲軒」，他開方子。"

msgid "煎药"
msgstr "煎藥"

msgid "药喂过了。"
msgstr "藥餵過了。"

msgid "叹了口气，把药渣倒回罐里，又煎了一碗。"
msgstr "嘆了口氣，把藥渣倒回罐裡，又煎了一碗。"

msgid "这一碗，别再洒了。"
msgstr "這一碗，別再灑了。"

msgid "药在你手里，去喂他（「给」老葛）。我得看着火。"
msgstr "藥在你手裡，去餵他（「給」老葛）。我得看著火。"

msgid "native:sanyen/fuzi"
msgstr "native:sanyen/fuzi"

msgid "native:snow/musk"
msgstr "native:snow/musk"

msgid "native:choyin/guijiu"
msgstr "native:choyin/guijiu"

msgid "把三味药摊在案上，一样一样地看过。"
msgstr "把三味藥攤在案上，一樣一樣地看過。"

msgid "附子、麝香、鬼臼——齐了。"
msgstr "附子、麝香、鬼臼——齊了。"

msgid "药僧生起小炉子，药罐里咕嘟咕嘟地翻着黑汤，满屋子的药味更冲了。\n"
msgstr "藥僧生起小爐子，藥罐裡咕嘟咕嘟地翻著黑湯，滿屋子的藥味更衝了。\n"

msgid "煎好了。你扶他起来喂（「给」老葛）——我得看着火。"
msgstr "煎好了。你扶他起來餵（「給」老葛）——我得看著火。"

msgid "三味还没齐：附子在药圃，麝香找雪亭的杨掌柜，鬼臼在乔阴树王坟边。"
msgstr "三味還沒齊：附子在藥圃，麝香找雪亭的楊掌櫃，鬼臼在喬陰樹王墳邊。"

msgid "煎什么药？方丈没开方子。"
msgstr "煎什麼藥？方丈沒開方子。"

msgid "看见你进来，放下了手里的药杵。"
msgstr "看見你進來，放下了手裡的藥杵。"

msgid "老葛回乔阴了。方丈守了他三天三夜，命保住了——那只右手，抬不起来了。"
msgstr "老葛回喬陰了。方丈守了他三天三夜，命保住了——那隻右手，抬不起來了。"

msgid "……那头陀不是坏人。他站在金门外十年，一句话没说过。"
msgstr "……那頭陀不是壞人。他站在金門外十年，一句話沒說過。"

msgid "他练的那门经，是从番坊来的。番坊的日陀罗寺。"
msgstr "他練的那門經，是從番坊來的。番坊的日陀羅寺。"

msgid "烧饭僧"
msgstr "燒飯僧"

msgid "一位长得肥肥胖胖, 福福泰泰的中年僧人。\n"
msgstr "一位長得肥肥胖胖, 福福泰泰的中年僧人。\n"

msgid "阿弥陀佛 !! 贫僧的菜刀是用来切菜的, 不是用来砍人的。"
msgstr "阿彌陀佛 !! 貧僧的菜刀是用來切菜的, 不是用來砍人的。"

msgid "小沙弥"
msgstr "小沙彌"

msgid "一个天真无邪的小和尚, 一颗圆滚滚光溜溜可爱的小光头, 让人看了\n就十分的喜欢他。他正在为油灯添上香油。\n"
msgstr "一個天真無邪的小和尚, 一顆圓滾滾光溜溜可愛的小光頭, 讓人看了\n就十分的喜歡他。他正在為油燈添上香油。\n"

msgid "师父! 救命啊!!  啊....不要打我..:("
msgstr "師父! 救命啊!!  啊....不要打我..:("

msgid "一个肥肥胖胖的僧人, 看他拿著扫把有一下没一下的扫著, 就知道他\n平常也是摸鱼大王。\n"
msgstr "一個肥肥胖胖的僧人, 看他拿著掃把有一下沒一下的掃著, 就知道他\n平常也是摸魚大王。\n"

msgid "这里已靠近北岸，江水齐胸深，偶尔一个湍流卷过来，仿佛要将人\n打入江底似的。\n"
msgstr "這裡已靠近北岸，江水齊胸深，偶爾一個湍流捲過來，彷彿要將人\n打入江底似的。\n"

msgid "这里虽说是泓水最窄的地方，可泓水在这里转了个弯，所以常有暗\n流出现。常有过往船只在这里沉入江底，连水性了得的船夫们也不敢在\n风大浪急时过江。\n"
msgstr "這裡雖說是泓水最窄的地方，可泓水在這裡轉了個彎，所以常有暗\n流出現。常有過往船隻在這裡沉入江底，連水性了得的船夫們也不敢在\n風大浪急時過江。\n"

msgid "这里靠近南岸，江水甚是寒冷。从这儿已能望到山烟寺的一角。\n"
msgstr "這裡靠近南岸，江水甚是寒冷。從這兒已能望到山煙寺的一角。\n"

msgid "这里是泓水南岸，再往南不远就是日照山了。\n"
msgstr "這裡是泓水南岸，再往南不遠就是日照山了。\n"

msgid "这是条崎岖的黄土小径，北面通向渡口，往南小路蜿蜒而上，通往\n山顶。\n"
msgstr "這是條崎嶇的黃土小徑，北面通向渡口，往南小路蜿蜒而上，通往\n山頂。\n"

msgid "这是条崎岖的黄土小径。\n"
msgstr "這是條崎嶇的黃土小徑。\n"

msgid "这是一条铺著生满青苔大石的山路，但是路面大概常有人行走，因\n此倒也并不湿滑，往南是一段石阶缓缓下山，往北则是通往山中的山路\n，东面的山壁上刻著「山烟寺」几个大字，看起来岁月已经颇久了。\n"
msgstr "這是一條鋪著生滿青苔大石的山路，但是路面大概常有人行走，因\n此倒也並不溼滑，往南是一段石階緩緩下山，往北則是通往山中的山路\n，東面的山壁上刻著「山煙寺」幾個大字，看起來歲月已經頗久了。\n"

msgid "这条山路到这里转了个弯，往东穿过一个山壁上凿出来的隧道，往\n南则顺著山势缓缓下山。\n"
msgstr "這條山路到這裡轉了個彎，往東穿過一個山壁上鑿出來的隧道，往\n南則順著山勢緩緩下山。\n"

msgid "这里是往山烟寺的山门，山烟寺在你的西面不远，由于寺中的老方丈\n玄智和尚医术通神，不少受过恩惠的各地富豪将山烟寺修整得金碧辉煌，\n庄严雄伟，因此山烟寺规模虽然不及京城的白象禅院，但是名气却是\n大得多了。\n"
msgstr "這裡是往山煙寺的山門，山煙寺在你的西面不遠，由於寺中的老方丈\n玄智和尚醫術通神，不少受過恩惠的各地富豪將山煙寺修整得金碧輝煌，\n莊嚴雄偉，因此山煙寺規模雖然不及京城的白象禪院，但是名氣卻是\n大得多了。\n"

msgid "你走进了一个凿穿山壁开成的隧道，东边是隧道的出口，往西不远\n处也可以从这里瞧见西边的出口，一股硫磺的味道从隧道壁中传来，想\n必左近便有温泉或是火山。\n"
msgstr "你走進了一個鑿穿山壁開成的隧道，東邊是隧道的出口，往西不遠\n處也可以從這裡瞧見西邊的出口，一股硫磺的味道從隧道壁中傳來，想\n必左近便有溫泉或是火山。\n"

msgid "你走进了一个凿穿山壁开成的隧道，隧道也不甚长，约七、八丈左\n右，西边就是隧道的出口，隧道中你可以闻到一股硫磺的味道，想必左\n近便有温泉或是火山。\n"
msgstr "你走進了一個鑿穿山壁開成的隧道，隧道也不甚長，約七、八丈左\n右，西邊就是隧道的出口，隧道中你可以聞到一股硫磺的味道，想必左\n近便有溫泉或是火山。\n"

msgid "这里是山烟寺前的空地，平日僧人们就在这里练武强身，空地四周\n种了一排白杨树，靠北边的地方放了一堆用来锻链膂力的砖头，寺门就\n在你的北边, 东边则是山门。\n"
msgstr "這裡是山煙寺前的空地，平日僧人們就在這裡練武強身，空地四周\n種了一排白楊樹，靠北邊的地方放了一堆用來鍛鏈膂力的磚頭，寺門就\n在你的北邊, 東邊則是山門。\n"

msgid "出现在眼前的是一座宏伟壮丽的寺门, 上方覆著镶金的瓦片, 瓦\n片的下方挂著一方翡翠匾额, 上面写著『山烟寺』三个烫金大字。正\n中的大门正紧紧关闭著, 只有在迎接大人物时才会开启。现在只开著\n两旁的偏门。\n"
msgstr "出現在眼前的是一座宏偉壯麗的寺門, 上方覆著鑲金的瓦片, 瓦\n片的下方掛著一方翡翠匾額, 上面寫著『山煙寺』三個燙金大字。正\n中的大門正緊緊關閉著, 只有在迎接大人物時才會開啟。現在只開著\n兩旁的偏門。\n"

msgid "一条铺著青石板的大道, 两旁种植一排芍药。北方就是大雄宝殿\n, 一座上覆金瓦的雄伟建筑, 屋檐的四个角落雕就著四只栩栩如的金\n龙, 屋檐下还各挂著一串金风铃, 清风吹来, 发出阵阵清脆的铃声。\n东边有条小一点的石板路, 阵阵的药香就从东边传来。\n"
msgstr "一條鋪著青石板的大道, 兩旁種植一排芍藥。北方就是大雄寶殿\n, 一座上覆金瓦的雄偉建築, 屋簷的四個角落雕就著四隻栩栩如的金\n龍, 屋簷下還各掛著一串金風鈴, 清風吹來, 發出陣陣清脆的鈴聲。\n東邊有條小一點的石板路, 陣陣的藥香就從東邊傳來。\n"

msgid "你正走在一条青石板铺造的小径上, 两旁种植著一排芍药。阵阵\n药香随风送了过来, 原来北边是片广大的药圃。\n"
msgstr "你正走在一條青石板鋪造的小徑上, 兩旁種植著一排芍藥。陣陣\n藥香隨風送了過來, 原來北邊是片廣大的藥圃。\n"

msgid "一片广阔的药圃, 药香就是从这里散发出来的。这里似乎经过详\n细的规划, 一块一块的, 哪边种当归, 哪边种枸杞, 绝不会混在一起\n。只是看来看去都只是些寻常的药材, 看不到比较珍贵特殊的。\n"
msgstr "一片廣闊的藥圃, 藥香就是從這裡散發出來的。這裡似乎經過詳\n細的規劃, 一塊一塊的, 哪邊種當歸, 哪邊種枸杞, 絕不會混在一起\n。只是看來看去都只是些尋常的藥材, 看不到比較珍貴特殊的。\n"

msgid "一阵耀眼的金光向你袭来, 你定神一看原来是座一丈八尺的如来\n佛祖金身, 坐在一座三尺高的莲台上, 前方的香炉里香烟缓缓飘上天\n。这整座山烟寺都是由上好的桧木搭建而成, 南方则是两扇敞开的金\n门, 价值不菲, 气势不凡, 在佛像的右侧有道黄布幔, 布幔后似乎是\n条通道。西边则传来阵阵的流水声。\n"
msgstr "一陣耀眼的金光向你襲來, 你定神一看原來是座一丈八尺的如來\n佛祖金身, 坐在一座三尺高的蓮臺上, 前方的香爐裡香煙緩緩飄上天\n。這整座山煙寺都是由上好的檜木搭建而成, 南方則是兩扇敞開的金\n門, 價值不菲, 氣勢不凡, 在佛像的右側有道黃布幔, 布幔後似乎是\n條通道。西邊則傳來陣陣的流水聲。\n"

msgid "你正站在山烟寺的庭园里, 这庭园里不但花草茂盛, 而且小桥流\n水, 假山凉亭, 应有尽有, 气派非凡。北边有间雅房, 东边穿过拱门\n则是大殿。\n"
msgstr "你正站在山煙寺的庭園裡, 這庭園裡不但花草茂盛, 而且小橋流\n水, 假山涼亭, 應有盡有, 氣派非凡。北邊有間雅房, 東邊穿過拱門\n則是大殿。\n"

msgid "你走进这里, 一阵刺鼻药味向你扑了过来。这是一间相当宽敞的\n的大房间, 是玄智方丈为人看病的地方, 也是存放药草的地方。与屋\n顶齐高的木柜, 画分成许多抽屉, 里面分别摆放著药材。两侧的墙璧\n上挂了许许多多的檀木扁额。\n"
msgstr "你走進這裡, 一陣刺鼻藥味向你撲了過來。這是一間相當寬敞的\n的大房間, 是玄智方丈為人看病的地方, 也是存放藥草的地方。與屋\n頂齊高的木櫃, 畫分成許多抽屜, 裡面分別擺放著藥材。兩側的牆璧\n上掛了許許多多的檀木扁額。\n"

msgid "你正走在一条长廊上, 两旁种植著一排月桂树。南边的布幔后是\n大殿, 北方则是后殿。东边是个不小的广场, 广场上正晒著一些不知\n名的药草。\n"
msgstr "你正走在一條長廊上, 兩旁種植著一排月桂樹。南邊的布幔後是\n大殿, 北方則是後殿。東邊是個不小的廣場, 廣場上正曬著一些不知\n名的藥草。\n"

msgid "你正走在一条长廊上, 两旁分别是流云轩及后殿的外墙, 墙上画\n著大慈大悲观世音菩萨救苦救难的事迹。长廊往东西两边延伸, 西边\n的尽是一间相当大的房屋。\n"
msgstr "你正走在一條長廊上, 兩旁分別是流雲軒及後殿的外牆, 牆上畫\n著大慈大悲觀世音菩薩救苦救難的事蹟。長廊往東西兩邊延伸, 西邊\n的盡是一間相當大的房屋。\n"

msgid "一间整理相乾净的厨房, 西北边的角落里砌了两个大灶, 灶里正\n燃著熊熊大火, 灶上分别放著一个大锅 及一个蒸笼\n。锅子及蒸笼正冒著阵阵的热气以及香气, 你忍不住想打开来看看。\n"
msgstr "一間整理相乾淨的廚房, 西北邊的角落裡砌了兩個大灶, 灶裡正\n燃著熊熊大火, 灶上分別放著一個大鍋 及一個蒸籠\n。鍋子及蒸籠正冒著陣陣的熱氣以及香氣, 你忍不住想打開來看看。\n"

msgid "一间宽大的后殿, 正中有一尊药师如来的金身塑像。四周的墙上\n唯妙唯肖地彩绘著十八罗汉, 每个罗汉的旁边并写著他得道升天的过\n程。\n"
msgstr "一間寬大的後殿, 正中有一尊藥師如來的金身塑像。四周的牆上\n唯妙唯肖地彩繪著十八羅漢, 每個羅漢的旁邊並寫著他得道昇天的過\n程。\n"

msgid "你正站在两座高塔前, 左边这一座名曰: 『明心塔』, 右方名叫\n『见性塔』。历来, 当山烟寺中的高僧涅盘后, 遗体火化后所得的舍\n利子就存放在这两座塔里。\n"
msgstr "你正站在兩座高塔前, 左邊這一座名曰: 『明心塔』, 右方名叫\n『見性塔』。歷來, 當山煙寺中的高僧涅盤後, 遺體火化後所得的舍\n利子就存放在這兩座塔裡。\n"

msgid "金门"
msgstr "金門"

msgid "檀木扁额"
msgstr "檀木扁額"

