msgid "由於你勤练武艺，你的膂力提高了。"
msgstr "由於你勤練武藝，你的膂力提高了。"

msgid "使剑的根底：握剑、出剑、收剑的规矩都在这里。封山剑法、六阴追魂剑这些剑法都激发在它上面；没学过专门剑法的人，手里有剑也只能凭它出招。"
msgstr "使劍的根底：握劍、出劍、收劍的規矩都在這裡。封山劍法、六陰追魂劍這些劍法都激發在它上面；沒學過專門劍法的人，手裡有劍也只能憑它出招。"

msgid "基本刀法"
msgstr "基本刀法"

msgid "使刀的根底：劈、砍、撩、斩的力道与分寸都从这里练起。春风快意刀、短歌刀法这些刀法都激发在它上面。"
msgstr "使刀的根底：劈、砍、撩、斬的力道與分寸都從這裡練起。春風快意刀、短歌刀法這些刀法都激發在它上面。"

msgid "用手中兵刃或一双肉掌格开来招的功夫。不少剑法、刀法、杖法也能激发为招架，用本门的招式化解对方的攻势。"
msgstr "用手中兵刃或一雙肉掌格開來招的功夫。不少劍法、刀法、杖法也能激發為招架，用本門的招式化解對方的攻勢。"

msgid "只听见「锵」一声，被$p格开了。"
msgstr "只聽見「鏘」一聲，被$p格開了。"

msgid "结果「当」地一声被$p挡开了。"
msgstr "結果「當」地一聲被$p擋開了。"

msgid "但是被$n用手中兵刃架开。"
msgstr "但是被$n用手中兵刃架開。"

msgid "但是$n身子一侧，用手中兵刃格开。"
msgstr "但是$n身子一側，用手中兵刃格開。"

msgid "但是被$p格开了。"
msgstr "但是被$p格開了。"

msgid "结果被$p挡开了。"
msgstr "結果被$p擋開了。"

msgid "闪身避让的功夫，对方的招式能不能落在身上，多半看它。倒乱七星步、火蝠身法、七宝天岚舞这类身法都激发在它上面。"
msgstr "閃身避讓的功夫，對方的招式能不能落在身上，多半看它。倒亂七星步、火蝠身法、七寶天嵐舞這類身法都激發在它上面。"

msgid "但是和$p$l偏了几寸。"
msgstr "但是和$p$l偏了幾寸。"

msgid "但是被$p机灵地躲开了。"
msgstr "但是被$p機靈地躲開了。"

msgid "但是$n身子一侧，闪了开去。"
msgstr "但是$n身子一側，閃了開去。"

msgid "但是被$p及时避开。"
msgstr "但是被$p及時避開。"

msgid "但是$n已有准备，不慌不忙的躲开。"
msgstr "但是$n已有準備，不慌不忙的躲開。"

msgid "一切内功的根基。内力的上限看它，打坐积下的内力才有地方存，运功调息、回气提神也都靠它；封山派内功、天邪神功等各家心法都要激发在它上面。内功修炼有成，根骨也会随之改善。"
msgstr "一切內功的根基。內力的上限看它，打坐積下的內力才有地方存，運功調息、回氣提神也都靠它；封山派內功、天邪神功等各家心法都要激發在它上面。內功修煉有成，根骨也會隨之改善。"

msgid "由於你的内功修炼有成，你的体质改善了。"
msgstr "由於你的內功修煉有成，你的體質改善了。"

msgid "乔阴柳家的柳东芦于七十年前所创：他是封山剑派第十二代掌门，以剑术成名，却把家传拳法融进封山剑意，创出这套适合膂力不强之人习练的拳法，补上了封山剑派近战的短处，后来更凭它力压群雄，夺得第九代武林盟主之位。柳家拳分内八套、外八套，流传在外的多是外八套，不须内功根基，容易上手；内八套是柳家秘传，外形一样，内力窍门却全然不同。练时须空手。"
msgstr "喬陰柳家的柳東蘆於七十年前所創：他是封山劍派第十二代掌門，以劍術成名，卻把家傳拳法融進封山劍意，創出這套適合膂力不強之人習練的拳法，補上了封山劍派近戰的短處，後來更憑它力壓群雄，奪得第九代武林盟主之位。柳家拳分內八套、外八套，流傳在外的多是外八套，不須內功根基，容易上手；內八套是柳家秘傳，外形一樣，內力竅門卻全然不同。練時須空手。"

msgid "你的体力不够了，休息一下再练吧。"
msgstr "你的體力不夠了，休息一下再練吧。"

msgid "练柳家拳法必须空手。"
msgstr "練柳家拳法必須空手。"

msgid "逼"
msgstr "逼"

msgid "抢压"
msgstr "搶壓"

msgid "先打实一拳贴上去，贴着才打得出重拳，一拳比一拳沉；打空了就被拉开。"
msgstr "先打實一拳貼上去，貼著才打得出重拳，一拳比一拳沉；打空了就被拉開。"

msgid "$N使一招「古松挂月」，对准$n的$l「呼」地一拳"
msgstr "$N使一招「古松掛月」，對準$n的$l「呼」地一拳"

msgid "$N扬起拳头，一招「傲雪冬梅」便往$n的$l招呼过去"
msgstr "$N揚起拳頭，一招「傲雪冬梅」便往$n的$l招呼過去"

msgid "$N左手虚晃，右拳「孤崖听涛」往$n的$l击出"
msgstr "$N左手虛晃，右拳「孤崖聽濤」往$n的$l擊出"

msgid "$N步履一沉，左拳拉开，右拳使出「荒山虎吟」击向$n$l"
msgstr "$N步履一沉，左拳拉開，右拳使出「荒山虎吟」擊向$n$l"

msgid "封山派内功"
msgstr "封山派內功"

msgid "封山剑派的本门内功，只能向师长学，或在运功中慢慢精熟。封山剑法必须配合它才能练；运起功来，还能为自己疗伤。"
msgstr "封山劍派的本門內功，只能向師長學，或在運功中慢慢精熟。封山劍法必須配合它才能練；運起功來，還能為自己療傷。"

msgid "封山派内功只能用学的，或是从运用中增加熟练度。"
msgstr "封山派內功只能用學的，或是從運用中增加熟練度。"

msgid "伏蛟功"
msgstr "伏蛟功"

msgid "花紫会一脉的内功，龙头陆得财身怀此功。练功须在有水的地方，既耗气也耗内力。"
msgstr "花紫會一脈的內功，龍頭陸得財身懷此功。練功須在有水的地方，既耗氣也耗內力。"

msgid "伏蛟功只能在有水的地方练。"
msgstr "伏蛟功只能在有水的地方練。"

msgid "你的气不够。"
msgstr "你的氣不夠。"

msgid "你的内力不够"
msgstr "你的內力不夠"

msgid "春风快意刀"
msgstr "春風快意刀"

msgid "振远镖局的看家刀法，总镖头陈天星凭它和天邪神掌在江湖上博得「刀掌双绝」之名。招名如「春风拂人醉」「远山伴人痴」「柳叶随人笑」，刀势轻飘，撩斩之间不见锋芒。"
msgstr "振遠鏢局的看家刀法，總鏢頭陳天星憑它和天邪神掌在江湖上博得「刀掌雙絕」之名。招名如「春風拂人醉」「遠山伴人痴」「柳葉隨人笑」，刀勢輕飄，撩斬之間不見鋒芒。"

msgid "你必须先找一把刀，才能练刀法。"
msgstr "你必須先找一把刀，才能練刀法。"

msgid "你的体力不够练这门刀法，还是先休息休息吧。"
msgstr "你的體力不夠練這門刀法，還是先休息休息吧。"

msgid "$N使一招「春风拂人醉」，手中$w轻飘飘地向$n的$l斩去！"
msgstr "$N使一招「春風拂人醉」，手中$w輕飄飄地向$n的$l斬去！"

msgid "$N金刃劈风，$w随著一招「远山伴人痴」由下而上撩往$n的$l"
msgstr "$N金刃劈風，$w隨著一招「遠山伴人痴」由下而上撩往$n的$l"

msgid "$N身形一转，一招「飞花逐人香」$w刀光不定，斩向$n的$l"
msgstr "$N身形一轉，一招「飛花逐人香」$w刀光不定，斬向$n的$l"

msgid "$N舞动$w，一招「柳叶随人笑」迅捷无伦地劈向$n的$l"
msgstr "$N舞動$w，一招「柳葉隨人笑」迅捷無倫地劈向$n的$l"

msgid "$N手中$w一晃，一招「倩影惹人怜」往$n的$l斜斜砍出一刀"
msgstr "$N手中$w一晃，一招「倩影惹人憐」往$n的$l斜斜砍出一刀"

msgid "$N提刀过肩，蓄劲发力，一招「芦雪碎人影」直劈$n$l"
msgstr "$N提刀過肩，蓄勁發力，一招「蘆雪碎人影」直劈$n$l"

msgid "$N移步侧身，使一招「彩蝶灼人衣」刀光霍霍斩向$n的$l"
msgstr "$N移步側身，使一招「彩蝶灼人衣」刀光霍霍斬向$n的$l"

msgid "封山剑法"
msgstr "封山劍法"

msgid "封山剑派是当今武林最大的一支剑派，这套剑法是当年创派的三位剑术名家在封山灵狐顶相互印证、合力创出的。招式并不难学，难在剑意：自「剑气」练起，次练「剑心」「剑芒」「剑神」，四者都练到登峰造极的人少之又少，所以同是封山剑法，造诣深浅不同的人使出来，威力差之千里。剑中有「封」「点」「逐」「缺」四字诀，须以封山派内功为根基。"
msgstr "封山劍派是當今武林最大的一支劍派，這套劍法是當年創派的三位劍術名家在封山靈狐頂相互印證、合力創出的。招式並不難學，難在劍意：自「劍氣」練起，次練「劍心」「劍芒」「劍神」，四者都練到登峰造極的人少之又少，所以同是封山劍法，造詣深淺不同的人使出來，威力差之千里。劍中有「封」「點」「逐」「缺」四字訣，須以封山派內功為根基。"

msgid "你按著所学练了一遍封山剑法。"
msgstr "你按著所學練了一遍封山劍法。"

msgid "你的内力或气不够，没有办法练习封山剑法。"
msgstr "你的內力或氣不夠，沒有辦法練習封山劍法。"

msgid "你的内力不够，没有办法练封山剑法。"
msgstr "你的內力不夠，沒有辦法練封山劍法。"

msgid "封山剑法必须配合封山派内功才能练。"
msgstr "封山劍法必須配合封山派內功才能練。"

msgid "你必须先找一把剑才能练剑法。"
msgstr "你必須先找一把劍才能練劍法。"

msgid "引"
msgstr "引"

msgid "逐"
msgstr "逐"

msgid "候隙"
msgstr "候隙"

msgid "不抢先：对方刺空或被架开，那一下就多出一剑，可以追，也可以封。"
msgstr "不搶先：對方刺空或被架開，那一下就多出一劍，可以追，也可以封。"

msgid "$N使一招「峰回路转」，手中$w如一条银蛇般刺向$n的$l"
msgstr "$N使一招「峰迴路轉」，手中$w如一條銀蛇般刺向$n的$l"

msgid "$N使出封山剑法中的「空山鸟语」，剑光霍霍斩向$n的$l"
msgstr "$N使出封山劍法中的「空山鳥語」，劍光霍霍斬向$n的$l"

msgid "$N一招「御风而行」，身形陡然滑出数尺，手中$w斩向$n的$l"
msgstr "$N一招「御風而行」，身形陡然滑出數尺，手中$w斬向$n的$l"

msgid "$N手中$w中宫直进，一式「旭日东升」对准$n的$l刺出一剑"
msgstr "$N手中$w中宮直進，一式「旭日東昇」對準$n的$l刺出一劍"

msgid "$N纵身一跃，手中$w一招「金光泻地」对准$n的$l斜斜刺出一剑"
msgstr "$N縱身一躍，手中$w一招「金光瀉地」對準$n的$l斜斜刺出一劍"

msgid "$N的$w凭空一指，一招「童子引路」刺向$n的$l"
msgstr "$N的$w憑空一指，一招「童子引路」刺向$n的$l"

msgid "$N手中$w向外一分，使一招「柳暗花明」反手对准$n$l一剑刺去"
msgstr "$N手中$w向外一分，使一招「柳暗花明」反手對準$n$l一劍刺去"

msgid "$N横剑上前，身形一转手中$w使一招「空谷秋虹」画出一道光弧斩向$n的$l"
msgstr "$N橫劍上前，身形一轉手中$w使一招「空谷秋虹」畫出一道光弧斬向$n的$l"

msgid "倒乱七星步法"
msgstr "倒亂七星步法"

msgid "封山派开山祖师锺虔在羿水之滨的石廊峡练武时，每到夜里便与出来吸血的血蛾扑击为戏，仰望北斗七星的方位变幻，发现血蛾无论如何进攻都脱不出七星的规律，苦思几日夜创成这套步法，第一次试招便杀了六只血蛾。它专门对付身法敏捷的敌人，以自然的规律料敌机先，对方一动，便已踏到正确的闪避方位。"
msgstr "封山派開山祖師鍾虔在羿水之濱的石廊峽練武時，每到夜裡便與出來吸血的血蛾撲擊為戲，仰望北斗七星的方位變幻，發現血蛾無論如何進攻都脫不出七星的規律，苦思幾日夜創成這套步法，第一次試招便殺了六隻血蛾。它專門對付身法敏捷的敵人，以自然的規律料敵機先，對方一動，便已踏到正確的閃避方位。"

msgid "你的气或内力不够，不能练倒乱七星步法。"
msgstr "你的氣或內力不夠，不能練倒亂七星步法。"

msgid "你的内力不够，没有办法练倒乱七星步。"
msgstr "你的內力不夠，沒有辦法練倒亂七星步。"

msgid "$n一招「天玑离枢」轻轻巧巧地避了开去。"
msgstr "$n一招「天璣離樞」輕輕巧巧地避了開去。"

msgid "只见$n身影一晃，一式「天璇乱步」早已避在七尺之外。"
msgstr "只見$n身影一晃，一式「天璇亂步」早已避在七尺之外。"

msgid "$n使出「倒转天权」，轻轻松松地闪过。"
msgstr "$n使出「倒轉天權」，輕輕鬆鬆地閃過。"

msgid "$n左足一点，一招「逐影天枢」腾空而起，避了开去。"
msgstr "$n左足一點，一招「逐影天樞」騰空而起，避了開去。"

msgid "可是$n使一招「风动玉衡」，身子轻轻飘了开去。"
msgstr "可是$n使一招「風動玉衡」，身子輕輕飄了開去。"

msgid "$n身影微动，已经藉一招「开阳薄雾」轻轻闪过。"
msgstr "$n身影微動，已經藉一招「開陽薄霧」輕輕閃過。"

msgid "但是$n一招「瑶光音迟」使出，早已绕到$N身後！"
msgstr "但是$n一招「瑤光音遲」使出，早已繞到$N身後！"

msgid "天邪神功"
msgstr "天邪神功"

msgid "相传是武术之神、太阳神君杞庸在西天大山中见到灵兽天邪虎后有所领悟而创的内功心法，与模拟天邪虎神态的天邪神掌相配。威力极强，消耗体力也极大：运起来能回气、提升战力、以内力强压杀气，最深的一手是「天邪虎啸」，一声长吼震伤身边所有的人。修习须有足够的杀气撑着，苦练下去，定力也会提高。"
msgstr "相傳是武術之神、太陽神君杞庸在西天大山中見到靈獸天邪虎後有所領悟而創的內功心法，與模擬天邪虎神態的天邪神掌相配。威力極強，消耗體力也極大：運起來能回氣、提升戰力、以內力強壓殺氣，最深的一手是「天邪虎嘯」，一聲長吼震傷身邊所有的人。修習須有足夠的殺氣撐著，苦練下去，定力也會提高。"

msgid "天邪神功只能用学的，或是从运用中增加熟练度。"
msgstr "天邪神功只能用學的，或是從運用中增加熟練度。"

msgid "你的杀气不够，无法领悟更高深的天邪神功。"
msgstr "你的殺氣不夠，無法領悟更高深的天邪神功。"

msgid "由於你苦练天邪神功，你的定力提高了"
msgstr "由於你苦練天邪神功，你的定力提高了"

msgid "茅山道术"
msgstr "茅山道術"

msgid "茅山派的法术，以治鬼除魔为主，多是攻敌的法术，兼有符咒之法：紫幽、青冥、苍灵「幽冥三箭」各有所长，又能召唤金甲天兵下凡护法、开「阴阳眼」看见鬼魂，还能驱动尸体。须以天师正道为根基，修为不够便领悟不了更深的道术。"
msgstr "茅山派的法術，以治鬼除魔為主，多是攻敵的法術，兼有符咒之法：紫幽、青冥、蒼靈「幽冥三箭」各有所長，又能召喚金甲天兵下凡護法、開「陰陽眼」看見鬼魂，還能驅動屍體。須以天師正道為根基，修為不夠便領悟不了更深的道術。"

msgid "你的天师正道修为不够，无法领悟更高深的茅山道术。"
msgstr "你的天師正道修為不夠，無法領悟更高深的茅山道術。"

msgid "你的精神无法集中。"
msgstr "你的精神無法集中。"

msgid "你闭目凝神，神游物外，开始修习茅山道术中的法术...."
msgstr "你閉目凝神，神遊物外，開始修習茅山道術中的法術...."

msgid "可是你心思一乱，变出了一只面目狰狞的$N！"
msgstr "可是你心思一亂，變出了一隻面目猙獰的$N！"

msgid "你的魂魄正被$N缠住，快把它除掉吧！"
msgstr "你的魂魄正被$N纏住，快把它除掉吧！"

msgid "你的魂魄还没有全部收回，赶快杀死你的$N吧！"
msgstr "你的魂魄還沒有全部收回，趕快殺死你的$N吧！"

msgid "天师正道"
msgstr "天師正道"

msgid "道家的主要学问，茅山派大多数武功、法术都要以它为基础。天师正道修行不够就强练道家武功法术，很容易走火入魔、坠入魔道；杀气太重的人，也修不了它。"
msgstr "道家的主要學問，茅山派大多數武功、法術都要以它為基礎。天師正道修行不夠就強練道家武功法術，很容易走火入魔、墜入魔道；殺氣太重的人，也修不了它。"

msgid "法术类技能必须用学的或是从实战中获取经验。"
msgstr "法術類技能必須用學的或是從實戰中獲取經驗。"

msgid "你的杀气太重，无法修炼天师正道。"
msgstr "你的殺氣太重，無法修煉天師正道。"

msgid "谷衣心法"
msgstr "谷衣心法"

msgid "道家的一门内功。人食五谷，肉身都带五谷秽气，谷衣心法把秽气排出体外，修成一层护体之气，叫作「谷衣」——神仙所修称「丹衣」，妖魔所修称「血衣」「土衣」。心法共分十层，练到第五层「小成」左眼珠变成金色，第十层「大成」两眼皆金；运起来能疗伤，也能以「灵神诀」把内力化为法力。"
msgstr "道家的一門內功。人食五穀，肉身都帶五穀穢氣，谷衣心法把穢氣排出體外，修成一層護體之氣，叫作「谷衣」——神仙所修稱「丹衣」，妖魔所修稱「血衣」「土衣」。心法共分十層，練到第五層「小成」左眼珠變成金色，第十層「大成」兩眼皆金；運起來能療傷，也能以「靈神訣」把內力化為法力。"

msgid "谷衣心法只能用学的，或是从运用中增加熟练度。"
msgstr "谷衣心法只能用學的，或是從運用中增加熟練度。"

msgid "你的魔力不够，无法提升谷衣心法的造诣。"
msgstr "你的魔力不夠，無法提升谷衣心法的造詣。"

msgid "天师剑法"
msgstr "天師劍法"

msgid "茅山派的剑法，招名「三清归真」「众士护佑」「群魔辟易」「西出紫关」，取道家护法驱魔之意。练这门剑须有相当的内力。"
msgstr "茅山派的劍法，招名「三清歸真」「眾士護佑」「群魔辟易」「西出紫關」，取道家護法驅魔之意。練這門劍須有相當的內力。"

msgid "你按著所学练了一遍天师剑法。"
msgstr "你按著所學練了一遍天師劍法。"

msgid "你的内力或气不够，没有办法练习天师剑法。"
msgstr "你的內力或氣不夠，沒有辦法練習天師劍法。"

msgid "你的内力不够，没有办法练天师剑法。"
msgstr "你的內力不夠，沒有辦法練天師劍法。"

msgid "$N一招「三清归真」，手中$w挽起几个剑花，刺向$n的$l"
msgstr "$N一招「三清歸真」，手中$w挽起幾個劍花，刺向$n的$l"

msgid "$N身形一变，一招「众士护佑」，$w罩向$n的$l"
msgstr "$N身形一變，一招「眾士護佑」，$w罩向$n的$l"

msgid "$N挥动$w，一招「天人合一」挟著闪闪剑光袭向$n的$l"
msgstr "$N揮動$w，一招「天人合一」挾著閃閃劍光襲向$n的$l"

msgid "$N手中$w一抡，使出「群魔辟易」往$n的$l恶狠狠的砍去"
msgstr "$N手中$w一掄，使出「群魔辟易」往$n的$l惡狠狠的砍去"

msgid "$N一招「西出紫关」，$w一带，轻轻划向$n$l"
msgstr "$N一招「西出紫關」，$w一帶，輕輕劃向$n$l"

msgid "$N身剑合一，幻化成一道光华，一招「乾坤一掷」扑向$n"
msgstr "$N身劍合一，幻化成一道光華，一招「乾坤一擲」撲向$n"

msgid "读书识字"
msgstr "讀書識字"

msgid "认字读书的本事。不识字就读不了任何书谱；识字越深，研读书册时长进越快。勤学苦读，悟性也会慢慢提高，有些讲究文墨的心法也要它做底子。"
msgstr "認字讀書的本事。不識字就讀不了任何書譜；識字越深，研讀書冊時長進越快。勤學苦讀，悟性也會慢慢提高，有些講究文墨的心法也要它做底子。"

msgid "由於你的勤学苦读，你的悟性提高了。"
msgstr "由於你的勤學苦讀，你的悟性提高了。"

msgid "音律"
msgstr "音律"

msgid "宫商声律的学问。音律之学有成，灵性会随之提高；步玄派的步玄七诀以音律为根底，音律修为不够，便领悟不了更深的诀窍。"
msgstr "宮商聲律的學問。音律之學有成，靈性會隨之提高；步玄派的步玄七訣以音律為根底，音律修為不夠，便領悟不了更深的訣竅。"

msgid "由於你学习音律之学有成，你的灵性提高了"
msgstr "由於你學習音律之學有成，你的靈性提高了"

msgid "乐器"
msgstr "樂器"

msgid "吹拉弹拨的技艺，与音律之学互为表里。步玄派掌门骆云舟也传这一门。"
msgstr "吹拉彈撥的技藝，與音律之學互為表裡。步玄派掌門駱雲舟也傳這一門。"

msgid "基本行动"
msgstr "基本行動"

msgid "赶路奔走的根底。脚下快的人追得上人，也甩得开追兵；倒乱七星步、步玄七诀、火蝠身法这类身法，都能激发为行动。"
msgstr "趕路奔走的根底。腳下快的人追得上人，也甩得開追兵；倒亂七星步、步玄七訣、火蝠身法這類身法，都能激發為行動。"

msgid "基本杖法"
msgstr "基本杖法"

msgid "使杖、使棍的根底。山烟寺的流云杖法、绝尘派的金刚杖法都激发在它上面。"
msgstr "使杖、使棍的根底。山煙寺的流雲杖法、絕塵派的金剛杖法都激發在它上面。"

msgid "基本暗器"
msgstr "基本暗器"

msgid "暗器出手的功夫，准头与劲道都看它。晚月庄、花紫会的人多精于此道。"
msgstr "暗器出手的功夫，準頭與勁道都看它。晚月莊、花紫會的人多精於此道。"

msgid "听风辨器之术"
msgstr "聽風辨器之術"

msgid "临敌时凭风声辨出兵刃来路的本事，专门用来对付看不见的敌人：鬼魂、隐形的妖物，或是在光线昏暗的地方交手。"
msgstr "臨敵時憑風聲辨出兵刃來路的本事，專門用來對付看不見的敵人：鬼魂、隱形的妖物，或是在光線昏暗的地方交手。"

msgid "顺手牵羊的手上功夫，下手越熟越不易被人察觉，运气好坏也有几分关系。花紫会龙头陆得财懂这一手，街上的飞贼也靠它吃饭。"
msgstr "順手牽羊的手上功夫，下手越熟越不易被人察覺，運氣好壞也有幾分關係。花紫會龍頭陸得財懂這一手，街上的飛賊也靠它吃飯。"

msgid "天邪神掌"
msgstr "天邪神掌"

msgid "模拟灵兽天邪虎神态的掌法，与天邪神功相配而成，招式有「大天罗式」「小天罗式」「雪阳三连月」「灵动五方鼓」「风雷七星断」。须空手练，天邪神功火候不足、内力太弱都练不成。"
msgstr "模擬靈獸天邪虎神態的掌法，與天邪神功相配而成，招式有「大天羅式」「小天羅式」「雪陽三連月」「靈動五方鼓」「風雷七星斷」。須空手練，天邪神功火候不足、內力太弱都練不成。"

msgid "你的内力不够了，休息一下再练吧。"
msgstr "你的內力不夠了，休息一下再練吧。"

msgid "练天邪神掌必须空手。"
msgstr "練天邪神掌必須空手。"

msgid "你的天邪神功火候不足，无法练天邪掌法。"
msgstr "你的天邪神功火候不足，無法練天邪掌法。"

msgid "你的内力太弱，无法练天邪掌法。"
msgstr "你的內力太弱，無法練天邪掌法。"

msgid "$N使出一招「大天罗式」，右掌穿出击向$n的$l"
msgstr "$N使出一招「大天羅式」，右掌穿出擊向$n的$l"

msgid "$N使出一招「大天罗式」，左掌化虚为实击向$n的$l"
msgstr "$N使出一招「大天羅式」，左掌化虛為實擊向$n的$l"

msgid "$N使出天邪掌法「小天罗式」，如鬼魅般欺至$n身前，一掌拍向$n的$l"
msgstr "$N使出天邪掌法「小天羅式」，如鬼魅般欺至$n身前，一掌拍向$n的$l"

msgid "$N双掌一错，使出「雪阳三连月」，对准$n的$l连续拍出三掌"
msgstr "$N雙掌一錯，使出「雪陽三連月」，對準$n的$l連續拍出三掌"

msgid "$N左掌画了个圈圈，右掌推出，一招「灵动五方鼓」击向$n$l"
msgstr "$N左掌畫了個圈圈，右掌推出，一招「靈動五方鼓」擊向$n$l"

msgid "$N使出「风雷七星断」，身形散作七处同时向$n的$l出掌攻击"
msgstr "$N使出「風雷七星斷」，身形散作七處同時向$n的$l出掌攻擊"

msgid "$N吐气扬声，一招「气撼九重天」双掌并力推出"
msgstr "$N吐氣揚聲，一招「氣撼九重天」雙掌併力推出"

msgid "六阴追魂剑法"
msgstr "六陰追魂劍法"

msgid "本是道家魔道的武功。三百年前一位天邪派前辈在首穷山一处废墟中得到六阴剑谱，谱分天殇、追魂、绝识三部，他年轻时练武伤了经脉，只练成追魂一部，另外两部至今下落不明。天邪派所传的追魂剑经三百多年演变，戾气消去不少而劲道更增，虽已失传了不少阴毒招式，仍是武林中赫赫有名的剑法。"
msgstr "本是道家魔道的武功。三百年前一位天邪派前輩在首窮山一處廢墟中得到六陰劍譜，譜分天殤、追魂、絕識三部，他年輕時練武傷了經脈，只練成追魂一部，另外兩部至今下落不明。天邪派所傳的追魂劍經三百多年演變，戾氣消去不少而勁道更增，雖已失傳了不少陰毒招式，仍是武林中赫赫有名的劍法。"

msgid "你按著所学练了一遍六阴追魂剑法。"
msgstr "你按著所學練了一遍六陰追魂劍法。"

msgid "你的内力或气不够，没有办法练习六阴追魂剑。"
msgstr "你的內力或氣不夠，沒有辦法練習六陰追魂劍。"

msgid "你的内力不够，没有办法练六阴追魂剑。"
msgstr "你的內力不夠，沒有辦法練六陰追魂劍。"

msgid "你突然觉得一股恶气冲上心头，只觉得想杀人...."
msgstr "你突然覺得一股惡氣衝上心頭，只覺得想殺人...."

msgid "$N使一招「群魔乱舞」，手中$w狂风骤雨般地向$n的$l连攻数剑"
msgstr "$N使一招「群魔亂舞」，手中$w狂風驟雨般地向$n的$l連攻數劍"

msgid "$N身形一转，一招「厉鬼缠身」$w斩向$n的$l"
msgstr "$N身形一轉，一招「厲鬼纏身」$w斬向$n的$l"

msgid "$N舞动$w，一招「百鬼夜行」挟著闪闪剑光刺向$n的$l"
msgstr "$N舞動$w，一招「百鬼夜行」挾著閃閃劍光刺向$n的$l"

msgid "$N手中$w一抖，使出「饿鬼拦路」往$n的$l刺出一剑"
msgstr "$N手中$w一抖，使出「餓鬼攔路」往$n的$l刺出一劍"

msgid "$N手中$w剑光暴长，一招「鬼影幢幢」往$n$l刺去"
msgstr "$N手中$w劍光暴長，一招「鬼影幢幢」往$n$l刺去"

msgid "$N手中$w直指$n$l，一招「秋坟鬼唱」发出逼人剑气刺去"
msgstr "$N手中$w直指$n$l，一招「秋墳鬼唱」發出逼人劍氣刺去"

msgid "火蝠身法"
msgstr "火蝠身法"

msgid "仿蝙蝠夜飞的身法，招名「寒蝠掠江」「轻蝠点梢」「夜蝠旋身」「火蝠曳空」，侧身一让，便叫来招扑了个空。天邪派与振远镖局都有高手使这门身法。"
msgstr "仿蝙蝠夜飛的身法，招名「寒蝠掠江」「輕蝠點梢」「夜蝠旋身」「火蝠曳空」，側身一讓，便叫來招撲了個空。天邪派與振遠鏢局都有高手使這門身法。"

msgid "你的体力太差了，不能练火蝠身法。"
msgstr "你的體力太差了，不能練火蝠身法。"

msgid "可是$p侧身一让，使出「寒蝠掠江」，$N这一招扑了个空。"
msgstr "可是$p側身一讓，使出「寒蝠掠江」，$N這一招撲了個空。"

msgid "$p身形微晃，使出「灵蝠轻逝」，有惊无险地避开了$N这一招。"
msgstr "$p身形微晃，使出「靈蝠輕逝」，有驚無險地避開了$N這一招。"

msgid "$p身随意转，一式「轻蝠点梢」，倏地往一旁挪开了三尺，避过了这一招。"
msgstr "$p身隨意轉，一式「輕蝠點梢」，倏地往一旁挪開了三尺，避過了這一招。"

msgid "却见$p足不点地，一招「夜蝠旋身」，往旁窜开数尺，躲了开去。"
msgstr "卻見$p足不點地，一招「夜蝠旋身」，往旁竄開數尺，躲了開去。"

msgid "只见$p一招「火蝠曳空」，身形向上拔起数尺高，闪了过去。"
msgstr "只見$p一招「火蝠曳空」，身形向上拔起數尺高，閃了過去。"

msgid "七宝天岚舞"
msgstr "七寶天嵐舞"

msgid "晚月庄的舞步身法，招名「蕙芳下凡」「双成献舞」「织女于归」「天女散花」「嫦娥奔月」，翩然起舞之间，已飘出数尺之外。只有女子才能练，又看灵性；勤练舞技，容貌也会更添光彩。"
msgstr "晚月莊的舞步身法，招名「蕙芳下凡」「雙成獻舞」「織女于歸」「天女散花」「嫦娥奔月」，翩然起舞之間，已飄出數尺之外。只有女子才能練，又看靈性；勤練舞技，容貌也會更添光彩。"

msgid "你的精神太差了，不能练七宝天岚舞。"
msgstr "你的精神太差了，不能練七寶天嵐舞。"

msgid "七宝天岚舞只有女性才能练。"
msgstr "七寶天嵐舞只有女性才能練。"

msgid "你的灵性不够，没有办法练七宝天岚舞。"
msgstr "你的靈性不夠，沒有辦法練七寶天嵐舞。"

msgid "由於你勤练舞技，你的容貌提高了"
msgstr "由於你勤練舞技，你的容貌提高了"

msgid "但$n一式「蕙芳下凡」随著轻轻一叹，顺著$N的招式飘出六尺之外！"
msgstr "但$n一式「蕙芳下凡」隨著輕輕一嘆，順著$N的招式飄出六尺之外！"

msgid "$n双脚微动翩然起舞，一招「双成献舞」，堪堪闪过$N的这招！"
msgstr "$n雙腳微動翩然起舞，一招「雙成獻舞」，堪堪閃過$N的這招！"

msgid "$n使出「织女于归」，突然幻化成一双倩影，$N从其中一人透体而过！"
msgstr "$n使出「織女于歸」，突然幻化成一雙倩影，$N從其中一人透體而過！"

msgid "$n一式「天女散花」，自水袖中散出一片花雨，$N被花影迷蒙了双眼，与$n擦肩而过"
msgstr "$n一式「天女散花」，自水袖中散出一片花雨，$N被花影迷濛了雙眼，與$n擦肩而過"

msgid "$n一招「嫦娥奔月」，轻轻一纵优雅的自$N头顶越过！"
msgstr "$n一招「嫦娥奔月」，輕輕一縱優雅的自$N頭頂越過！"

msgid "基本法术"
msgstr "基本法術"

msgid "神通一类法门的根底：灵力的上限看它，施展神通要用灵力。山烟寺的八识神通便激发在它上面。"
msgstr "神通一類法門的根底：靈力的上限看它，施展神通要用靈力。山煙寺的八識神通便激發在它上面。"

msgid "基本咒文"
msgstr "基本咒文"

msgid "念咒施法的根底：法力的上限看它，冥思积下的法力才有地方存。茅山道术、奇门遁甲这些法术都激发在它上面。"
msgstr "念咒施法的根底：法力的上限看它，冥思積下的法力才有地方存。茅山道術、奇門遁甲這些法術都激發在它上面。"

msgid "小天魔道"
msgstr "小天魔道"

msgid "道家旁门的一路学问，绝尘派的奇门遁甲以它为根基，小天魔道修为不够，便领悟不了更深的遁甲之术。它只能向师父学，或在实战中体会；每有长进，杀气也跟着重一分。"
msgstr "道家旁門的一路學問，絕塵派的奇門遁甲以它為根基，小天魔道修為不夠，便領悟不了更深的遁甲之術。它只能向師父學，或在實戰中體會；每有長進，殺氣也跟著重一分。"

msgid "奇门遁甲"
msgstr "奇門遁甲"

msgid "绝尘派的法术。口中念咒，大喝一声「疾！」，或化作黑气、金光、火焰、长虹、大雾遁去无踪，或以黑气、金光、火焰、海水、大木把敌人困在当中；战到危急，还能召来天将相助。须以小天魔道为根基。"
msgstr "絕塵派的法術。口中念咒，大喝一聲「疾！」，或化作黑氣、金光、火焰、長虹、大霧遁去無蹤，或以黑氣、金光、火焰、海水、大木把敵人困在當中；戰到危急，還能召來天將相助。須以小天魔道為根基。"

msgid "你的小天魔道修为不够，无法领悟更高深的奇门遁甲之术。"
msgstr "你的小天魔道修為不夠，無法領悟更高深的奇門遁甲之術。"

msgid "绝尘心法"
msgstr "絕塵心法"

msgid "绝尘派的本门内功。绝尘子本是释家中人，后得奇人指点，悟得道家真谛，佛道双修，自号绝尘，创下此派；这门心法只能向师父学，或在运功中慢慢精熟。"
msgstr "絕塵派的本門內功。絕塵子本是釋家中人，後得奇人指點，悟得道家真諦，佛道雙修，自號絕塵，創下此派；這門心法只能向師父學，或在運功中慢慢精熟。"

msgid "绝尘心法只能用学的或是从运用中增加熟练度。"
msgstr "絕塵心法只能用學的或是從運用中增加熟練度。"

msgid "金刚杖法"
msgstr "金剛杖法"

msgid "绝尘派所传的杖法，招式与山烟寺的流云杖法相同，是「天光乍现」「雨后初晴」「浮云写意」「游龙穿云」四式，起手一杖专扫下盘。练这门杖须有相当的膂力，膂力不足的人宜先把内力练足。"
msgstr "絕塵派所傳的杖法，招式與山煙寺的流雲杖法相同，是「天光乍現」「雨後初晴」「浮雲寫意」「游龍穿雲」四式，起手一杖專掃下盤。練這門杖須有相當的膂力，膂力不足的人宜先把內力練足。"

msgid "你必须先找一根木杖或者是类似的武器，才能练杖法。"
msgstr "你必須先找一根木杖或者是類似的武器，才能練杖法。"

msgid "你的体力不够练这门杖法，还是先休息休息吧。"
msgstr "你的體力不夠練這門杖法，還是先休息休息吧。"

msgid "你的膂力还不够，也许该练一练内力来增强力量。"
msgstr "你的膂力還不夠，也許該練一練內力來增強力量。"

msgid "$N使一招「天光乍现」，手中$w扫向$n下盘！"
msgstr "$N使一招「天光乍現」，手中$w掃向$n下盤！"

msgid "挫伤"
msgstr "挫傷"

msgid "$N挥起$w，一招「雨後初晴」攻向$n$l！"
msgstr "$N揮起$w，一招「雨後初晴」攻向$n$l！"

msgid "$N横过手中$w，使出「浮云写意」击向$n$l！"
msgstr "$N橫過手中$w，使出「浮雲寫意」擊向$n$l！"

msgid "$N使出一招「游龙穿云」，$w一挺撞向$n$l！"
msgstr "$N使出一招「游龍穿雲」，$w一挺撞向$n$l！"

msgid "流云杖法"
msgstr "流雲杖法"

msgid "山烟寺的杖法，招名「天光乍现」「雨后初晴」「浮云写意」「游龙穿云」，可攻可守。番坊日陀罗寺的龙若法王也传这门杖法。练这门杖须有相当的膂力。"
msgstr "山煙寺的杖法，招名「天光乍現」「雨後初晴」「浮雲寫意」「游龍穿雲」，可攻可守。番坊日陀羅寺的龍若法王也傳這門杖法。練這門杖須有相當的膂力。"

msgid "莲华心法"
msgstr "蓮華心法"

msgid "五百多年前北冥大泽的黑妖蛇族入侵，一群佛门高僧集思广益，悟出这套心法为百姓疗伤，主要用来迅速医治战斗中所受的皮肉创伤。运起功来既能医治自己，也能替别人疗伤；须以大乘佛法为根基，佛法修为跟不上，便领会不了更深的境界。"
msgstr "五百多年前北冥大澤的黑妖蛇族入侵，一群佛門高僧集思廣益，悟出這套心法為百姓療傷，主要用來迅速醫治戰鬥中所受的皮肉創傷。運起功來既能醫治自己，也能替別人療傷；須以大乘佛法為根基，佛法修為跟不上，便領會不了更深的境界。"

msgid "莲华心法只能用学的，或是从运用中增加熟练度。"
msgstr "蓮華心法只能用學的，或是從運用中增加熟練度。"

msgid "你的大乘佛法修为不够，无法领会更高深的莲华心法。"
msgstr "你的大乘佛法修為不夠，無法領會更高深的蓮華心法。"

msgid "婆萝蜜多心经"
msgstr "婆蘿蜜多心經"

msgid "从天竺传来的一部内功，性子是火性的：运起来浑身发热，专克阴寒。只能用学的，没有运功的法门；中原只有日陀罗寺的人会，独眼头陀那只眼就是练它练坏的。"
msgstr "從天竺傳來的一部內功，性子是火性的：運起來渾身發熱，專克陰寒。只能用學的，沒有運功的法門；中原只有日陀羅寺的人會，獨眼頭陀那隻眼就是練它練壞的。"

msgid "婆萝蜜多心经只能用学的。"
msgstr "婆蘿蜜多心經只能用學的。"

msgid "大乘佛法"
msgstr "大乘佛法"

msgid "佛门的根本学问，莲华心法、八识神通都以它为根基。杀气太重的人，修不了大乘佛法。"
msgstr "佛門的根本學問，蓮華心法、八識神通都以它為根基。殺氣太重的人，修不了大乘佛法。"

msgid "你的杀气太重，无法修炼大乘佛法。"
msgstr "你的殺氣太重，無法修煉大乘佛法。"

msgid "诵经"
msgstr "誦經"

msgid "佛门弟子的日课，晨钟暮鼓之间念诵经文。山烟寺、日陀罗寺的僧人都会这一门。"
msgstr "佛門弟子的日課，晨鐘暮鼓之間念誦經文。山煙寺、日陀羅寺的僧人都會這一門。"

msgid "八识神通"
msgstr "八識神通"

msgid "佛家一门十分神奇的神通法术，由六百年前的高僧空正大师传下。神通分为八识，各以人的一种隐藏潜力为动力，如今传下来的有三识：心识救醒昏迷濒死之人，游识一念之间便到你见过的人身边，空识把灵力化为潜能。须与高深的佛法相辅，佛法修为不够便学不了。"
msgstr "佛家一門十分神奇的神通法術，由六百年前的高僧空正大師傳下。神通分為八識，各以人的一種隱藏潛力為動力，如今傳下來的有三識：心識救醒昏迷瀕死之人，遊識一念之間便到你見過的人身邊，空識把靈力化為潛能。須與高深的佛法相輔，佛法修為不夠便學不了。"

msgid "你的佛法修为还不够高深，无法学习八识神通。"
msgstr "你的佛法修為還不夠高深，無法學習八識神通。"

msgid "基本鞭法"
msgstr "基本鞭法"

msgid "使鞭的根底，软鞭出手要收得回来。晚月庄的寒雪鞭法激发在它上面。"
msgstr "使鞭的根底，軟鞭出手要收得回來。晚月莊的寒雪鞭法激發在它上面。"

msgid "基本锤法"
msgstr "基本錘法"

msgid "使锤一类重兵器的根底，凭的是一身力气。"
msgstr "使錘一類重兵器的根底，憑的是一身力氣。"

msgid "基本斧法"
msgstr "基本斧法"

msgid "使斧的根底，大开大合，一斧下去要劈得开。"
msgstr "使斧的根底，大開大合，一斧下去要劈得開。"

msgid "基本匕法"
msgstr "基本匕法"

msgid "使匕首一类短刃的根底，贴身近打，出手要快。"
msgstr "使匕首一類短刃的根底，貼身近打，出手要快。"

msgid "基本叉法"
msgstr "基本叉法"

msgid "使钢叉一类长兵的根底。阴间的鬼卒，手里多是钢叉。"
msgstr "使鋼叉一類長兵的根底。陰間的鬼卒，手裡多是鋼叉。"

msgid "柔虹指"
msgstr "柔虹指"

msgid "晚月庄的指法，只有女子才能练，须空手。招名「菊楼采月」「雪桥翦梅」「柳亭簪花」「桃坟扑蝶」，身影忽前忽后，一转身指尖已点到要害。"
msgstr "晚月莊的指法，只有女子才能練，須空手。招名「菊樓採月」「雪橋翦梅」「柳亭簪花」「桃墳撲蝶」，身影忽前忽後，一轉身指尖已點到要害。"

msgid "你的内力不够了。"
msgstr "你的內力不夠了。"

msgid "你的精神无法集中了，休息一下再练吧。"
msgstr "你的精神無法集中了，休息一下再練吧。"

msgid "柔虹指是只有女子才能练的武功。"
msgstr "柔虹指是只有女子才能練的武功。"

msgid "练柔虹指必须空手。"
msgstr "練柔虹指必須空手。"

msgid "$N左手一挥，一招「菊楼采月」右手点向$n$l"
msgstr "$N左手一揮，一招「菊樓採月」右手點向$n$l"

msgid "右手食指"
msgstr "右手食指"

msgid "$N使一招「雪桥翦梅」，身影忽前忽後，突然一转身左手往$n的$l点去"
msgstr "$N使一招「雪橋翦梅」，身影忽前忽後，突然一轉身左手往$n的$l點去"

msgid "左手中指"
msgstr "左手中指"

msgid "$N身法稍顿，左手一扬使出「柳亭簪花」往$n的$l点去"
msgstr "$N身法稍頓，左手一揚使出「柳亭簪花」往$n的$l點去"

msgid "只见$N纤腰一摆，陡然滑出数尺，右手顺著来势一招「桃坟扑蝶」往$n的$l点去"
msgstr "只見$N纖腰一擺，陡然滑出數尺，右手順著來勢一招「桃墳撲蝶」往$n的$l點去"

msgid "寒雪鞭法"
msgstr "寒雪鞭法"

msgid "晚月庄的鞭法，从「寒风起兮」「漫天飞雪」到「狂风骤雪」「风雪交加」，鞭影如满天飞雪，虚虚实实地袭人。须有足够的内力才能练。"
msgstr "晚月莊的鞭法，從「寒風起兮」「漫天飛雪」到「狂風驟雪」「風雪交加」，鞭影如滿天飛雪，虛虛實實地襲人。須有足夠的內力才能練。"

msgid "你按著所学练了一遍寒雪鞭法。"
msgstr "你按著所學練了一遍寒雪鞭法。"

msgid "你的内力或气不够，没有办法练习寒雪鞭法。"
msgstr "你的內力或氣不夠，沒有辦法練習寒雪鞭法。"

msgid "你的内力不够，没有办法练寒雪鞭法, 多练些内力再来吧。"
msgstr "你的內力不夠，沒有辦法練寒雪鞭法, 多練些內力再來吧。"

msgid "你必须先找一条鞭子才能练鞭法。"
msgstr "你必須先找一條鞭子才能練鞭法。"

msgid "$N使一招「寒风起兮」，手中$w抖得笔直向$n的$l连刺数鞭"
msgstr "$N使一招「寒風起兮」，手中$w抖得筆直向$n的$l連刺數鞭"

msgid "$N身形一转，一招「漫天飞雪」$w幻出满天鞭影，虚虚实实地袭向$n的$l"
msgstr "$N身形一轉，一招「漫天飛雪」$w幻出滿天鞭影，虛虛實實地襲向$n的$l"

msgid "$N力贯$w，一招「雪花翩翩」点点鞭影飘浮不定地点向$n的$l"
msgstr "$N力貫$w，一招「雪花翩翩」點點鞭影飄浮不定地點向$n的$l"

msgid "$N手中$w一抖，一招「积雪三尺」以一个怪异的角度往$n下盘卷去"
msgstr "$N手中$w一抖，一招「積雪三尺」以一個怪異的角度往$n下盤捲去"

msgid "$N手中一紧，使招「狂风骤雪」，手里$w一鞭接著一鞭不停地抽向$n的$l"
msgstr "$N手中一緊，使招「狂風驟雪」，手裡$w一鞭接著一鞭不停地抽向$n的$l"

msgid "鞭伤"
msgstr "鞭傷"

msgid "$N一招「风雪交加」手中$w舞出一片鞭影扫向$n全身"
msgstr "$N一招「風雪交加」手中$w舞出一片鞭影掃向$n全身"

msgid "意寒功"
msgstr "意寒功"

msgid "三十年前以一柄拂尘横扫武林的前辈异人残心师太所创的内功心法，纯走阴柔之路，发出的内劲寒冷无比；传说她曾在沙牢山一掌冻住七只雪狼，堪称当今寒冰掌一路中最凌厉的奇功。交手时阴寒之气常叫对方打个寒噤，运起「意寒睨」，更能以冰冷如刀的眼神伤敌。"
msgstr "三十年前以一柄拂塵橫掃武林的前輩異人殘心師太所創的內功心法，純走陰柔之路，發出的內勁寒冷無比；傳說她曾在沙牢山一掌凍住七隻雪狼，堪稱當今寒冰掌一路中最凌厲的奇功。交手時陰寒之氣常叫對方打個寒噤，運起「意寒睨」，更能以冰冷如刀的眼神傷敵。"

msgid "$N的招式挟著一股阴寒无比的劲风使得$n不禁打了个寒噤。"
msgstr "$N的招式挾著一股陰寒無比的勁風使得$n不禁打了個寒噤。"

msgid "意寒功只能用学的，或是从运用中增加熟练度。"
msgstr "意寒功只能用學的，或是從運用中增加熟練度。"

msgid "雪影心法"
msgstr "雪影心法"

msgid "天山一脉的独门内功，只能向师父学，或在运功中慢慢精熟；雪影剑法必须以它为根基。"
msgstr "天山一脈的獨門內功，只能向師父學，或在運功中慢慢精熟；雪影劍法必須以它為根基。"

msgid "天山雪影心法只能用学的或是从运用中增加熟练度。"
msgstr "天山雪影心法只能用學的或是從運用中增加熟練度。"

msgid "雪影剑法"
msgstr "雪影劍法"

msgid "天山雪影剑，招名「回光幻电」「风霜碎影」「残阳照雪」「冰谷初虹」「长空雷隐」「断石狼烟」，剑光疾如闪电，身形飘忽如雪影。必须配合天山魔教的独门雪影心法才能练，内力不足也练不成。"
msgstr "天山雪影劍，招名「回光幻電」「風霜碎影」「殘陽照雪」「冰谷初虹」「長空雷隱」「斷石狼煙」，劍光疾如閃電，身形飄忽如雪影。必須配合天山魔教的獨門雪影心法才能練，內力不足也練不成。"

msgid "你按著所学练了一遍雪影剑法。"
msgstr "你按著所學練了一遍雪影劍法。"

msgid "你的内力或气不够，没有办法练习雪影剑法。"
msgstr "你的內力或氣不夠，沒有辦法練習雪影劍法。"

msgid "你的内力不够，没有办法练雪影剑法。"
msgstr "你的內力不夠，沒有辦法練雪影劍法。"

msgid "雪影剑法必须配合天山魔教的独门雪影心法才能练。"
msgstr "雪影劍法必須配合天山魔教的獨門雪影心法才能練。"

msgid "$N使一招「回光幻电」，手中$w幻一条疾光刺向$n的$l"
msgstr "$N使一招「回光幻電」，手中$w幻一條疾光刺向$n的$l"

msgid "$N使出天山雪影剑中的「风霜碎影」，$w连挥剑光霍霍斩向$n的$l"
msgstr "$N使出天山雪影劍中的「風霜碎影」，$w連揮劍光霍霍斬向$n的$l"

msgid "$N一招「残阳照雪」，纵身飘开数尺，手中$w斩向$n的$l"
msgstr "$N一招「殘陽照雪」，縱身飄開數尺，手中$w斬向$n的$l"

msgid "$N手中$w中宫直进，一式「冰谷初虹」对准$n的$l刺出一剑"
msgstr "$N手中$w中宮直進，一式「冰谷初虹」對準$n的$l刺出一劍"

msgid "$N纵身一跃，手中$w一招「长空雷隐」对准$n的$l斜斜刺出一剑"
msgstr "$N縱身一躍，手中$w一招「長空雷隱」對準$n的$l斜斜刺出一劍"

msgid "$N的$w凭空一指，一招「断石狼烟」刺向$n的$l"
msgstr "$N的$w憑空一指，一招「斷石狼煙」刺向$n的$l"

msgid "步玄七诀"
msgstr "步玄七訣"

msgid "四百年前「秃笔狂生」骆步玄的成名武功。他原是一介书生，未曾拜师学艺，十九岁起赴京应试，屡试不中，某年考完步出试场，偶一抬头望见街边书肆的一幅对子，竟悟出一套神奇的武功，从此闯荡江湖未逢敌手，五十岁回京定居，创立了步玄派。步玄七诀号称天下轻功「轻捷第一」，姿态潇洒有如书法，第一式「玄羽乱舞」能在短时间里加快身法；须配合步玄心法，又以音律之学为根底。"
msgstr "四百年前「禿筆狂生」駱步玄的成名武功。他原是一介書生，未曾拜師學藝，十九歲起赴京應試，屢試不中，某年考完步出試場，偶一抬頭望見街邊書肆的一幅對子，竟悟出一套神奇的武功，從此闖蕩江湖未逢敵手，五十歲回京定居，創立了步玄派。步玄七訣號稱天下輕功「輕捷第一」，姿態瀟灑有如書法，第一式「玄羽亂舞」能在短時間裡加快身法；須配合步玄心法，又以音律之學為根底。"

msgid "你的气或神不够，不能练步玄七诀。"
msgstr "你的氣或神不夠，不能練步玄七訣。"

msgid "步玄七诀必须配合步玄心法使用。"
msgstr "步玄七訣必須配合步玄心法使用。"

msgid "你的音律之学修为不够，无法领悟更高深的步玄七诀。"
msgstr "你的音律之學修為不夠，無法領悟更高深的步玄七訣。"

msgid "$n身影一转，轻易地避开了这一招。"
msgstr "$n身影一轉，輕易地避開了這一招。"

msgid "$n身法飘忽，左一点，右一顿，早已闪在一旁。"
msgstr "$n身法飄忽，左一點，右一頓，早已閃在一旁。"

msgid "但是$n身影一侧，在间不容发之际从容地避开了这一招。"
msgstr "但是$n身影一側，在間不容髮之際從容地避開了這一招。"

msgid "$n身形陡然拔高，使$N的攻势尽数落空。"
msgstr "$n身形陡然拔高，使$N的攻勢盡數落空。"

msgid "$n右足一点，身影向左滑开数尺，避了开去。"
msgstr "$n右足一點，身影向左滑開數尺，避了開去。"

msgid "步玄心法"
msgstr "步玄心法"

msgid "步玄派的本门内功，只能向师父学，或在运功中慢慢精熟；步玄七诀、小步玄剑都要以它为根基。"
msgstr "步玄派的本門內功，只能向師父學，或在運功中慢慢精熟；步玄七訣、小步玄劍都要以它為根基。"

msgid "步玄心法只能学，或是从运用中增加熟练度。"
msgstr "步玄心法只能學，或是從運用中增加熟練度。"

msgid "小步玄剑"
msgstr "小步玄劍"

msgid "步玄派的剑法，招名「暮雪三叹」「处子弄笛」「阳谷白练」，出剑急如骤雨。须先有相当火候的步玄心法，内力不足也练不成。"
msgstr "步玄派的劍法，招名「暮雪三嘆」「處子弄笛」「陽谷白練」，出劍急如驟雨。須先有相當火候的步玄心法，內力不足也練不成。"

msgid "你按著所学练了一遍小步玄剑。"
msgstr "你按著所學練了一遍小步玄劍。"

msgid "你的内力或气不够，没有办法练习小步玄剑。"
msgstr "你的內力或氣不夠，沒有辦法練習小步玄劍。"

msgid "你的步玄心法火候还不够。"
msgstr "你的步玄心法火候還不夠。"

msgid "你的内力不够，没有办法练小步玄剑。"
msgstr "你的內力不夠，沒有辦法練小步玄劍。"

msgid "$N使一招「暮雪三叹」，手中$w急如骤雨般地刺向$n$l"
msgstr "$N使一招「暮雪三嘆」，手中$w急如驟雨般地刺向$n$l"

msgid "$N身形一晃，一招「处子弄笛」向$n$l刺出一剑"
msgstr "$N身形一晃，一招「處子弄笛」向$n$l刺出一劍"

msgid "$N舞动$w，一招「阳谷白练」挟著闪闪剑光刺向$n的$l"
msgstr "$N舞動$w，一招「陽谷白練」挾著閃閃劍光刺向$n的$l"

msgid "$N手中$w一个圈转，使出「薰容逐电」中锋直进刺向$n的$l"
msgstr "$N手中$w一個圈轉，使出「薰容逐電」中鋒直進刺向$n的$l"

msgid "油流麻香手"
msgstr "油流麻香手"

msgid "花紫会的手上功夫，忽掌忽爪，招名多带市井气——「撺锅手」「撮灰手」「梁上君子」「随棍上身」，劲力一吐，能听见对方骨节作响。须空手练，内力太弱的人练不成。"
msgstr "花紫會的手上功夫，忽掌忽爪，招名多帶市井氣——「攛鍋手」「撮灰手」「梁上君子」「隨棍上身」，勁力一吐，能聽見對方骨節作響。須空手練，內力太弱的人練不成。"

msgid "练油流麻香手必须空手。"
msgstr "練油流麻香手必須空手。"

msgid "你的内力太弱，无法练油流麻香手。"
msgstr "你的內力太弱，無法練油流麻香手。"

msgid "你听到「喀啦」一声轻响，竟似是骨碎的声音！"
msgstr "你聽到「喀啦」一聲輕響，竟似是骨碎的聲音！"

msgid "$N劲力一吐，$n的$l发出「喀」地一声爆响！"
msgstr "$N勁力一吐，$n的$l發出「喀」地一聲爆響！"

msgid "只听见$n的$l「喀」地一声 ..."
msgstr "只聽見$n的$l「喀」地一聲 ..."

msgid "$N左掌微分，右手一长使出一招「毒龙扑舟」，抓向$n的$l"
msgstr "$N左掌微分，右手一長使出一招「毒龍撲舟」，抓向$n的$l"

msgid "$N倏地一个转身，双手一翻「撺锅手」直掼$n$l"
msgstr "$N倏地一個轉身，雙手一翻「攛鍋手」直摜$n$l"

msgid "$N身子微斜，随即跨出一步，左手忽掌忽爪使出「撮灰手」，拍向$n的$l"
msgstr "$N身子微斜，隨即跨出一步，左手忽掌忽爪使出「撮灰手」，拍向$n的$l"

msgid "$N使出「青蛇十段锦」，双手滑溜异常对准$n的$l抓去"
msgstr "$N使出「青蛇十段錦」，雙手滑溜異常對準$n的$l抓去"

msgid "$N左手虚晃，右掌飘飘，一招「梁上君子」击向$n$l"
msgstr "$N左手虛晃，右掌飄飄，一招「梁上君子」擊向$n$l"

msgid "$N使出「拨草寻履」，凌空跃起，冷不防在落地前对准$n$l踢出一脚"
msgstr "$N使出「撥草尋履」，凌空躍起，冷不防在落地前對準$n$l踢出一腳"

msgid "$N右手在$n$l划过，随後一招「随棍上身」左爪又向同一方位抓到"
msgstr "$N右手在$n$l劃過，隨後一招「隨棍上身」左爪又向同一方位抓到"

msgid "短歌刀法"
msgstr "短歌刀法"

msgid "招名全出自《短歌行》——「对酒当歌」「人生几何」「譬如朝露」「去日苦多」……弯刀似月，刀势常由下而上撩斩。官府的带刀侍卫、高门大户的护院多使这一路刀法。"
msgstr "招名全出自《短歌行》——「對酒當歌」「人生幾何」「譬如朝露」「去日苦多」……彎刀似月，刀勢常由下而上撩斬。官府的帶刀侍衛、高門大戶的護院多使這一路刀法。"

msgid "$N使一招「对酒当歌」，手中$w风似地向$n的$l斩去！"
msgstr "$N使一招「對酒當歌」，手中$w風似地向$n的$l斬去！"

msgid "$N弯刀似月，$w随著一招「人生几何」由下而上撩往$n的$l"
msgstr "$N彎刀似月，$w隨著一招「人生幾何」由下而上撩往$n的$l"

msgid "$N身形一转，一招「譬如朝露」$w如朝露闪烁，斩向$n的$l"
msgstr "$N身形一轉，一招「譬如朝露」$w如朝露閃爍，斬向$n的$l"

msgid "$N舞动$w，一招「去日苦多」往$n的$l斜斜砍出一刀"
msgstr "$N舞動$w，一招「去日苦多」往$n的$l斜斜砍出一刀"

msgid "$N手中$w一晃，一招「慨当以慷」迅捷无伦地劈向$n的$l"
msgstr "$N手中$w一晃，一招「慨當以慷」迅捷無倫地劈向$n的$l"

msgid "$N提气丹田，身型咋展，一招「忧思难忘」直劈$n$l"
msgstr "$N提氣丹田，身型咋展，一招「憂思難忘」直劈$n$l"

msgid "$N移步侧身，使一招「何以解忧」刀光霍霍斩向$n的$l"
msgstr "$N移步側身，使一招「何以解憂」刀光霍霍斬向$n的$l"

msgid "秋风步"
msgstr "秋風步"

msgid "招名取自《秋风辞》，从「秋风起兮白云飞」到「箫鼓鸣兮发棹歌」，身影一晃，便已避在数尺之外。练这门步法须有相当的内力；官府的侍卫、衙役常与短歌刀法一同修习。"
msgstr "招名取自《秋風辭》，從「秋風起兮白雲飛」到「簫鼓鳴兮發棹歌」，身影一晃，便已避在數尺之外。練這門步法須有相當的內力；官府的侍衛、衙役常與短歌刀法一同修習。"

msgid "$n一招「秋风起兮白云飞」轻轻巧巧地避了开去。"
msgstr "$n一招「秋風起兮白雲飛」輕輕巧巧地避了開去。"

msgid "只见$n身影一晃，一式「草木黄落兮雁南归」早已避在七尺之外。"
msgstr "只見$n身影一晃，一式「草木黃落兮雁南歸」早已避在七尺之外。"

msgid "$n使出「兰有秀兮菊有芳」，轻轻松松地闪过。"
msgstr "$n使出「蘭有秀兮菊有芳」，輕輕鬆鬆地閃過。"

msgid "$n左足一点，一招「怀佳人兮不能忘」腾空而起，避了开去。"
msgstr "$n左足一點，一招「懷佳人兮不能忘」騰空而起，避了開去。"

msgid "可是$n使一招「泛楼船兮济汾河」，身子轻轻飘了开去。"
msgstr "可是$n使一招「泛樓船兮濟汾河」，身子輕輕飄了開去。"

msgid "$n身影微动，已经藉一招「横中流兮扬素波」轻轻闪过。"
msgstr "$n身影微動，已經藉一招「橫中流兮揚素波」輕輕閃過。"

msgid "但是$n一招「箫鼓鸣兮发棹歌」使出，早已绕到$N身後！"
msgstr "但是$n一招「簫鼓鳴兮發棹歌」使出，早已繞到$N身後！"

msgid "但是$n身形飘忽，轻轻一纵，一招「欢乐极兮哀情多」，避开这一击。"
msgstr "但是$n身形飄忽，輕輕一縱，一招「歡樂極兮哀情多」，避開這一擊。"

msgid "$n身形往上一拔，一招「少壮几时兮奈老何」，一个转折落在数尺之外。"
msgstr "$n身形往上一拔，一招「少壯幾時兮奈老何」，一個轉折落在數尺之外。"

msgid "密宗大手印"
msgstr "密宗大手印"

msgid "密宗一路的掌法，招名「苦海端无涯」「地狱似有门」「天堂却无路」「万念皆是空」，虚实相生；招架时能以双掌夹住来刃，或以「粘」字诀引偏兵器。须空手练。"
msgstr "密宗一路的掌法，招名「苦海端無涯」「地獄似有門」「天堂卻無路」「萬念皆是空」，虛實相生；招架時能以雙掌夾住來刃，或以「粘」字訣引偏兵器。須空手練。"

msgid "练密宗大手印必须空手。"
msgstr "練密宗大手印必須空手。"

msgid "$N使出一招「苦海端无涯」，左掌虚幌，右掌穿出击向$n的$l"
msgstr "$N使出一招「苦海端無涯」，左掌虛幌，右掌穿出擊向$n的$l"

msgid "$N使出一招「地狱似有门」，左掌化虚为实击向$n的$l"
msgstr "$N使出一招「地獄似有門」，左掌化虛為實擊向$n的$l"

msgid "$N使出密宗大手印中的「天堂却无路」，一掌拍向$n的$l"
msgstr "$N使出密宗大手印中的「天堂卻無路」，一掌拍向$n的$l"

msgid "$N双掌一错，使出「密宗为独尊」，对准$n的$l连续拍出"
msgstr "$N雙掌一錯，使出「密宗為獨尊」，對準$n的$l連續拍出"

msgid "$N左掌立于胸前，右掌推出，一招「万念皆是空」击向$n$l"
msgstr "$N左掌立於胸前，右掌推出，一招「萬念皆是空」擊向$n$l"

msgid "$N使出「佛云以杀止杀」，身形凌空飞起，从空中当头向$n的$l出掌攻击"
msgstr "$N使出「佛云以殺止殺」，身形凌空飛起，從空中當頭向$n的$l出掌攻擊"

msgid "铁布衫"
msgstr "鐵布衫"

msgid "外门护体硬功：闭目凝神，气走全身，不躲不闪也能硬受来招。"
msgstr "外門護體硬功：閉目凝神，氣走全身，不躲不閃也能硬受來招。"

msgid "小无相功"
msgstr "小無相功"

msgid "逍遥派一路的内功，讲究文墨修养：读书识字的造诣跟不上，小无相功便无法再进。只能向人学，或在运功中慢慢精熟。"
msgstr "逍遙派一路的內功，講究文墨修養：讀書識字的造詣跟不上，小無相功便無法再進。只能向人學，或在運功中慢慢精熟。"

msgid "小无相功只能用学的或是从运用中增加熟练度。"
msgstr "小無相功只能用學的或是從運用中增加熟練度。"

msgid "你的文学素养不够无法提升小无相功的造诣。"
msgstr "你的文學素養不夠無法提升小無相功的造詣。"

msgid "禁中刀"
msgstr "禁中刀"

msgid "大内侍卫营的刀法，七式「值门」「出巡」「提灯」「锁宫」「拿下」「护驾」「天明」，一招一式都在宫门、长街、殿上。侍卫营总教头冯策的刀谱末页写着一句：「刀在鞘里的时候最多。」"
msgstr "大內侍衛營的刀法，七式「值門」「出巡」「提燈」「鎖宮」「拿下」「護駕」「天明」，一招一式都在宮門、長街、殿上。侍衛營總教頭馮策的刀譜末頁寫著一句：「刀在鞘裡的時候最多。」"

msgid "$N横刀当胸，一招「值门」$w刀背一磕，顺势削向$n的$l"
msgstr "$N橫刀當胸，一招「值門」$w刀背一磕，順勢削向$n的$l"

msgid "$N脚下一错，一招「出巡」$w贴着身子递出，直取$n的$l！"
msgstr "$N腳下一錯，一招「出巡」$w貼著身子遞出，直取$n的$l！"

msgid "$N刀尖一挑，一招「提灯」$w晃过$n眼前，刀锋却落向$n的$l"
msgstr "$N刀尖一挑，一招「提燈」$w晃過$n眼前，刀鋒卻落向$n的$l"

msgid "$N沉肩坠肘，一招「锁宫」$w自上而下劈向$n的$l"
msgstr "$N沉肩墜肘，一招「鎖宮」$w自上而下劈向$n的$l"

msgid "$N欺身而上，一招「拿下」$w刀柄撞向$n的$l，刀刃跟着就到"
msgstr "$N欺身而上，一招「拿下」$w刀柄撞向$n的$l，刀刃跟著就到"

msgid "$N退半步护住身后，一招「护驾」$w画了个半圆，扫过$n的$l"
msgstr "$N退半步護住身後，一招「護駕」$w畫了個半圓，掃過$n的$l"

msgid "$N大喝一声，一招「天明」$w自下而上斜劈，刀光照亮了$n的$l"
msgstr "$N大喝一聲，一招「天明」$w自下而上斜劈，刀光照亮了$n的$l"

msgid "关北马刀"
msgstr "關北馬刀"

msgid "关北槐阳王府骑兵的马上刀法，七式从「扬鞭」「回马」「斩缰」到「破阵」「归鞘」，刀自下而上撩出。刀谱每一页的边上都写着同一句话：「撩，不是砍。」"
msgstr "關北槐陽王府騎兵的馬上刀法，七式從「揚鞭」「回馬」「斬韁」到「破陣」「歸鞘」，刀自下而上撩出。刀譜每一頁的邊上都寫著同一句話：「撩，不是砍。」"

msgid "$N手中$w一扬，一招「扬鞭」自下而上撩向$n的$l！"
msgstr "$N手中$w一揚，一招「揚鞭」自下而上撩向$n的$l！"

msgid "$N身子一拧，一招「回马」$w反手撩出，刀光从$n的$l掠过"
msgstr "$N身子一擰，一招「回馬」$w反手撩出，刀光從$n的$l掠過"

msgid "$N矮身一刀，一招「斩缰」$w贴地撩向$n的$l"
msgstr "$N矮身一刀，一招「斬韁」$w貼地撩向$n的$l"

msgid "$N$w一抖，一招「卷沙」刀风卷起地上的沙土，斜斜撩往$n的$l"
msgstr "$N$w一抖，一招「捲沙」刀風捲起地上的沙土，斜斜撩往$n的$l"

msgid "$N踏步欺进，一招「踏雪」$w由肩上撩落，直取$n的$l"
msgstr "$N踏步欺進，一招「踏雪」$w由肩上撩落，直取$n的$l"

msgid "$N大喝一声，一招「破阵」$w连撩三刀，刀刀奔$n的$l"
msgstr "$N大喝一聲，一招「破陣」$w連撩三刀，刀刀奔$n的$l"

msgid "$N手腕一翻，一招「归鞘」$w收势时顺手一撩，刀背扫过$n的$l"
msgstr "$N手腕一翻，一招「歸鞘」$w收勢時順手一撩，刀背掃過$n的$l"

msgid "铁盾剑法"
msgstr "鐵盾劍法"

msgid "番坊铁盾会的剑法，传自流落东方的大秦剑手：盾在前，剑在后，左臂圆盾挡住来招，右手短剑从盾下刺出，七式自「盾墙」至「盾下一剑」。臂上没有盾，铁盾会不教；入了鬼笠馆的人，铁盾会也不教。"
msgstr "番坊鐵盾會的劍法，傳自流落東方的大秦劍手：盾在前，劍在後，左臂圓盾擋住來招，右手短劍從盾下刺出，七式自「盾牆」至「盾下一劍」。臂上沒有盾，鐵盾會不教；入了鬼笠館的人，鐵盾會也不教。"

msgid "你举着盾，把铁盾剑法练了一遍：盾在前，剑在后。"
msgstr "你舉著盾，把鐵盾劍法練了一遍：盾在前，劍在後。"

msgid "你的内力或气不够，没有办法练习铁盾剑法。"
msgstr "你的內力或氣不夠，沒有辦法練習鐵盾劍法。"

msgid "你得先拿一把剑——短剑最好。"
msgstr "你得先拿一把劍——短劍最好。"

msgid "盾呢？没盾的剑法不是我们的剑法。"
msgstr "盾呢？沒盾的劍法不是我們的劍法。"

msgid "你是鬼笠馆的人。铁盾会的剑法，不教鬼笠馆。"
msgstr "你是鬼笠館的人。鐵盾會的劍法，不教鬼笠館。"

msgid "$N左臂一抬，一招「盾墙」盾面迎上$n的$l，$w从盾沿底下刺出"
msgstr "$N左臂一抬，一招「盾牆」盾面迎上$n的$l，$w從盾沿底下刺出"

msgid "$N盾身一侧，一招「侧刺」$w贴着盾沿直刺$n的$l"
msgstr "$N盾身一側，一招「側刺」$w貼著盾沿直刺$n的$l"

msgid "$N踏前一步，一招「盾撞」整面盾撞向$n的$l"
msgstr "$N踏前一步，一招「盾撞」整面盾撞向$n的$l"

msgid "$N手腕一沉，一招「短锋」$w只探出半尺，点向$n的$l"
msgstr "$N手腕一沉，一招「短鋒」$w只探出半尺，點向$n的$l"

msgid "$N盾面一收，一招「回盾」盾沿磕开来势，$w顺势划向$n的$l"
msgstr "$N盾面一收，一招「回盾」盾沿磕開來勢，$w順勢劃向$n的$l"

msgid "$N盾后$w连刺三下，一招「连刺」剑剑奔$n的$l"
msgstr "$N盾後$w連刺三下，一招「連刺」劍劍奔$n的$l"

msgid "$N矮身藏在盾后，一招「盾下一剑」$w从盾底下猛地刺向$n的$l"
msgstr "$N矮身藏在盾後，一招「盾下一劍」$w從盾底下猛地刺向$n的$l"

msgid "鬼笠刀法"
msgstr "鬼笠刀法"

msgid "番坊倭人浪人武馆鬼笠馆的刀法，刀窄而弯，拔刀、横扫、下劈、纳刀、退步五式之外，另有一式「一刀」。门规与中原相反：一击之内定生死。铁盾会的弟子，鬼笠馆不教。"
msgstr "番坊倭人浪人武館鬼笠館的刀法，刀窄而彎，拔刀、橫掃、下劈、納刀、退步五式之外，另有一式「一刀」。門規與中原相反：一擊之內定生死。鐵盾會的弟子，鬼笠館不教。"

msgid "你出刀，收刀，把鬼笠刀法练了一遍——一刀，只出一次。"
msgstr "你出刀，收刀，把鬼笠刀法練了一遍——一刀，只出一次。"

msgid "你的内力或气不够，没有办法练习鬼笠刀法。"
msgstr "你的內力或氣不夠，沒有辦法練習鬼笠刀法。"

msgid "刀呢？没刀的刀法不是刀法。"
msgstr "刀呢？沒刀的刀法不是刀法。"

msgid "你是铁盾会的人。盾在前的，用不着刀。"
msgstr "你是鐵盾會的人。盾在前的，用不著刀。"

msgid "$N手按刀柄，一招「拔刀」$w出鞘的一瞬斜斜划向$n的$l"
msgstr "$N手按刀柄，一招「拔刀」$w出鞘的一瞬斜斜劃向$n的$l"

msgid "$N$w平举，一招「横扫」刀光齐腰扫向$n的$l"
msgstr "$N$w平舉，一招「橫掃」刀光齊腰掃向$n的$l"

msgid "$N双手握刀举过头顶，一招「下劈」$w直劈$n的$l"
msgstr "$N雙手握刀舉過頭頂，一招「下劈」$w直劈$n的$l"

msgid "$N$w收势回鞘，一招「纳刀」刀背顺势磕向$n的$l"
msgstr "$N$w收勢回鞘，一招「納刀」刀背順勢磕向$n的$l"

msgid "$N退了半步，一招「退步」$w在退势里反撩$n的$l"
msgstr "$N退了半步，一招「退步」$w在退勢裡反撩$n的$l"

msgid "$N双手握刀，一动不动，忽然一招「一刀」——$w从头顶直劈而下，一击之内定生死，直取$n的$l"
msgstr "$N雙手握刀，一動不動，忽然一招「一刀」——$w從頭頂直劈而下，一擊之內定生死，直取$n的$l"

msgid "挥拳"
msgstr "揮拳"

msgid "$N挥拳攻击$n的$l"
msgstr "$N揮拳攻擊$n的$l"

msgid "一抓"
msgstr "一抓"

msgid "$N往$n的$l一抓"
msgstr "$N往$n的$l一抓"

msgid "踢腿"
msgstr "踢腿"

msgid "$N往$n的$l狠狠地踢了一脚"
msgstr "$N往$n的$l狠狠地踢了一腳"

msgid "捶击"
msgstr "捶擊"

msgid "$N提起拳头往$n的$l捶去"
msgstr "$N提起拳頭往$n的$l捶去"

msgid "横拳"
msgstr "橫拳"

msgid "$N对准$n的$l用力挥出一拳"
msgstr "$N對準$n的$l用力揮出一拳"

msgid "斩"
msgstr "斬"

msgid "$N挥动$w，斩向$n的$l"
msgstr "$N揮動$w，斬向$n的$l"

msgid "砍"
msgstr "砍"

msgid "$N用$w往$n的$l砍去"
msgstr "$N用$w往$n的$l砍去"

msgid "砍伤"
msgstr "砍傷"

msgid "劈"
msgstr "劈"

msgid "$N的$w朝著$n的$l劈将过去"
msgstr "$N的$w朝著$n的$l劈將過去"

msgid "劈伤"
msgstr "劈傷"

msgid "乱砍"
msgstr "亂砍"

msgid "$N挥舞$w，对准$n的$l一阵乱砍"
msgstr "$N揮舞$w，對準$n的$l一陣亂砍"

msgid "刺"
msgstr "刺"

msgid "$N用$w往$n的$l刺去"
msgstr "$N用$w往$n的$l刺去"

msgid "捅"
msgstr "捅"

msgid "$N的$w往$n的$l狠狠地一捅"
msgstr "$N的$w往$n的$l狠狠地一捅"

msgid "抽"
msgstr "抽"

msgid "$N将$w一扬，往$n的$l抽去"
msgstr "$N將$w一揚，往$n的$l抽去"

msgid "戳"
msgstr "戳"

msgid "$N用$w往$n的$l直戳过去"
msgstr "$N用$w往$n的$l直戳過去"

msgid "射"
msgstr "射"

msgid "$N将$w对准$n的$l射了过去"
msgstr "$N將$w對準$n的$l射了過去"

msgid "砸"
msgstr "砸"

msgid "$N挥舞$w，往$n的$l用力一砸"
msgstr "$N揮舞$w，往$n的$l用力一砸"

msgid "当头砸"
msgstr "當頭砸"

msgid "$N高高举起$w，往$n的$l当头砸下"
msgstr "$N高高舉起$w，往$n的$l當頭砸下"

msgid "猛挥"
msgstr "猛揮"

msgid "$N手握$w，眼露凶光，猛地对准$n的$l挥了过去"
msgstr "$N手握$w，眼露兇光，猛地對準$n的$l揮了過去"

msgid "稳健"
msgstr "穩健"

msgid "爆发"
msgstr "爆發"

msgid "兽"
msgstr "獸"

msgid "当前 / 有效 / 最大"
msgstr "當前 / 有效 / 最大"

msgid "当前是眼下的数；有效是受伤压低的上限，歇着会慢慢长回来，疗伤更快；最大是你的本钱。"
msgstr "當前是眼下的數；有效是受傷壓低的上限，歇著會慢慢長回來，療傷更快；最大是你的本錢。"

msgid "学武功、自学、修行都耗精，歇着慢慢回来；归零就昏倒。"
msgstr "學武功、自學、修行都耗精，歇著慢慢回來；歸零就昏倒。"

msgid "挨打、练功、打坐都耗气，歇着慢慢回来；归零就昏倒。"
msgstr "挨打、練功、打坐都耗氣，歇著慢慢回來；歸零就昏倒。"

msgid "研读、冥思都耗神，歇着慢慢回来；归零就昏倒。"
msgstr "研讀、冥思都耗神，歇著慢慢回來；歸零就昏倒。"

msgid "打坐得来，运功和加力都要用它；上限看基本内功。"
msgstr "打坐得來，運功和加力都要用它；上限看基本內功。"

msgid "每一击多灌进这么多内力，打得更重，内力也耗得更快。"
msgstr "每一擊多灌進這麼多內力，打得更重，內力也耗得更快。"

msgid "施法要用。冥思得来，上限看基本咒文。"
msgstr "施法要用。冥思得來，上限看基本咒文。"

msgid "施展神通要用。修行得来，上限看基本法术。"
msgstr "施展神通要用。修行得來，上限看基本法術。"

msgid "杀气"
msgstr "殺氣"

msgid "杀人会涨，胆气也跟着壮；太重学不了佛道心法，还可能失控伤人。运功或捐香火能压下去。"
msgstr "殺人會漲，膽氣也跟著壯；太重學不了佛道心法，還可能失控傷人。運功或捐香火能壓下去。"

msgid "随时间消耗，吃东西补；见底后内力、法力、灵力不再恢复。"
msgstr "隨時間消耗，吃東西補；見底後內力、法力、靈力不再恢復。"

msgid "饮水"
msgstr "飲水"

msgid "随时间消耗，喝东西补；见底后什么都不再恢复。"
msgstr "隨時間消耗，喝東西補；見底後什麼都不再恢復。"

msgid "打架、办事得来；武功能练到多高看它。"
msgstr "打架、辦事得來；武功能練到多高看它。"

msgid "打架、办事得来，请教和自学要花它；没用掉的有上限。"
msgstr "打架、辦事得來，請教和自學要花它；沒用掉的有上限。"

msgid "综合评价"
msgstr "綜合評價"

msgid "江湖上对你的总评：办成差事会涨，认输会掉。"
msgstr "江湖上對你的總評：辦成差事會漲，認輸會掉。"

msgid "杀过的人"
msgstr "殺過的人"

msgid "你亲手杀过多少人。"
msgstr "你親手殺過多少人。"

msgid "负重"
msgstr "負重"

msgid "身上东西的总重和能背的上限，上限看膂力。"
msgstr "身上東西的總重和能背的上限，上限看膂力。"

msgid "体重"
msgstr "體重"

msgid "你自己的分量，也决定肚子能装多少吃喝。"
msgstr "你自己的分量，也決定肚子能裝多少吃喝。"

msgid "膂力"
msgstr "膂力"

msgid "力气：打得更重，背得更多，拿得动沉重的兵器。"
msgstr "力氣：打得更重，背得更多，拿得動沉重的兵器。"

msgid "敢不敢抢攻：自动对打时，胆识高的人出手更勤；不少师父也看它。"
msgstr "敢不敢搶攻：自動對打時，膽識高的人出手更勤；不少師父也看它。"

msgid "悟性"
msgstr "悟性"

msgid "天资：学武功更快，耗精更少，打架时也更容易长进。"
msgstr "天資：學武功更快，耗精更少，打架時也更容易長進。"

msgid "精神方面的体质：冥思和修行涨得更快，不少法门也看它。"
msgstr "精神方面的體質：冥思和修行漲得更快，不少法門也看它。"

msgid "临危不乱：对手抢攻前要过你这一关，定力越高他们越容易转为守势；打空时也不易露破绽，还压得住杀气。"
msgstr "臨危不亂：對手搶攻前要過你這一關，定力越高他們越容易轉為守勢；打空時也不易露破綻，還壓得住殺氣。"

msgid "容貌"
msgstr "容貌"

msgid "长相：有人看脸说话，也有师父看长相收人；容貌高，杀气重的人也不易对你翻脸。"
msgstr "長相：有人看臉說話，也有師父看長相收人；容貌高，殺氣重的人也不易對你翻臉。"

msgid "根骨"
msgstr "根骨"

msgid "体质：精气神恢复得更快，打坐涨内力更快，昏倒后醒得更早，酒量也大。"
msgstr "體質：精氣神恢復得更快，打坐漲內力更快，昏倒後醒得更早，酒量也大。"

msgid "福缘"
msgstr "福緣"

msgid "运气：容易遇上一般人碰不到的机缘，好事坏事都有。"
msgstr "運氣：容易遇上一般人碰不到的機緣，好事壞事都有。"

msgid "雪亭镇"
msgstr "雪亭鎮"

msgid "野羊山"
msgstr "野羊山"

msgid "青石村"
msgstr "青石村"

msgid "青石山路"
msgstr "青石山路"

msgid "老松岭"
msgstr "老松嶺"

msgid "铁链崖"
msgstr "鐵鏈崖"

msgid "晚月庄"
msgstr "晚月莊"

msgid "晚月山路"
msgstr "晚月山路"

msgid "日照山"
msgstr "日照山"

msgid "乔阴县城"
msgstr "喬陰縣城"

msgid "乔阴东郊"
msgstr "喬陰東郊"

msgid "天驼关"
msgstr "天駝關"

msgid "岚城"
msgstr "嵐城"

msgid "玉螺湖村"
msgstr "玉螺湖村"

msgid "京师"
msgstr "京師"

msgid "黑松山"
msgstr "黑松山"

msgid "槐阳城"
msgstr "槐陽城"

msgid "草原"
msgstr "草原"

msgid "工地"
msgstr "工地"

msgid "古冢"
msgstr "古冢"

msgid "阴间"
msgstr "陰間"

msgid "番坊"
msgstr "番坊"

msgid "封山剑派"
msgstr "封山劍派"

msgid "封山剑派是当今武林中最大的一支剑派。相传三位剑术名家在封山灵狐顶相互印证所学，创出封山剑法；招式不难学，难在剑意，讲究不抢先，等对手露出空子。七十年前一代掌门把乔阴柳家的家传拳法融进剑意，创出柳家拳，补上了剑派近身的短处。雪亭镇的淳风武馆是这一派的门户，镇上的后生多在那里学拳。"
msgstr "封山劍派是當今武林中最大的一支劍派。相傳三位劍術名家在封山靈狐頂相互印證所學，創出封山劍法；招式不難學，難在劍意，講究不搶先，等對手露出空子。七十年前一代掌門把喬陰柳家的家傳拳法融進劍意，創出柳家拳，補上了劍派近身的短處。雪亭鎮的淳風武館是這一派的門戶，鎮上的後生多在那裡學拳。"

msgid "雪亭镇的淳风武馆"
msgstr "雪亭鎮的淳風武館"

msgid "柳家拳没什么花样：先打实一拳，人就贴上去了；贴上去，重拳才够得着，一拳比一拳沉。"
msgstr "柳家拳沒什麼花樣：先打實一拳，人就貼上去了；貼上去，重拳才夠得著，一拳比一拳沉。"

msgid "最怕的是打空。一拳落了空，人就被拉开了，再重的拳头也只砸在风上——得重新打实一拳，才能再贴上去。"
msgstr "最怕的是打空。一拳落了空，人就被拉開了，再重的拳頭也只砸在風上——得重新打實一拳，才能再貼上去。"

msgid "所以这拳是抢来的。对面守得稳，你就先用快的、虚的去碰，碰着了再压上去。"
msgstr "所以這拳是搶來的。對面守得穩，你就先用快的、虛的去碰，碰著了再壓上去。"

msgid "想拜馆主为师？馆主只看{requires}，哪一样不到，他都会摇头。拳脚简单，一拳就是一拳，先跟我拆几招也好。"
msgstr "想拜館主為師？館主只看{requires}，哪一樣不到，他都會搖頭。拳腳簡單，一拳就是一拳，先跟我拆幾招也好。"

msgid "好，拆三回合，点到为止。"
msgstr "好，拆三回合，點到為止。"

msgid "看见没有？我一拳打实了就贴上来，接着那记重的才够得着你。柳家拳的拳，是这么抢来的。"
msgstr "看見沒有？我一拳打實了就貼上來，接著那記重的才夠得著你。柳家拳的拳，是這麼搶來的。"

msgid "三回合我一拳都没打实，就一直够不着你——柳家拳最怕的就是这个。你要学，先学怎么把第一拳打实。"
msgstr "三回合我一拳都沒打實，就一直夠不著你——柳家拳最怕的就是這個。你要學，先學怎麼把第一拳打實。"

msgid "你贴上来那一记，压得对，就是这个劲。"
msgstr "你貼上來那一記，壓得對，就是這個勁。"

msgid "你身上带着伤，拆什么招？先去桑邻药铺把伤治好。"
msgstr "你身上帶著傷，拆什麼招？先去桑鄰藥鋪把傷治好。"

msgid "你是别派的弟子，馆主吩咐过，不许和外人过招。"
msgstr "你是別派的弟子，館主吩咐過，不許和外人過招。"

msgid "记住：一回合不是一招，是几手的事。你出一手，我出一手；谁手上还有余力，谁就多出一手。"
msgstr "記住：一回合不是一招，是幾手的事。你出一手，我出一手；誰手上還有餘力，誰就多出一手。"

msgid "看我这一拳——打实了我就贴上来，紧跟着的那一记重的，你躲得开么？"
msgstr "看我這一拳——打實了我就貼上來，緊跟著的那一記重的，你躲得開麼？"

msgid "最后一回合。你要是能让我一拳打空，我就得退开重来；你要是也打实了一拳，就试试压上来。"
msgstr "最後一回合。你要是能讓我一拳打空，我就得退開重來；你要是也打實了一拳，就試試壓上來。"

msgid "爹爹的剑法，我只学了个皮毛。封山剑不抢先，先用引手逗对方出招——对方一剑刺空，或是被我架开，那一下就是空子，我这边就多出一剑来。"
msgstr "爹爹的劍法，我只學了個皮毛。封山劍不搶先，先用引手逗對方出招——對方一劍刺空，或是被我架開，那一下就是空子，我這邊就多出一劍來。"

msgid "多出来的那一剑最要紧：可以追着刺，也可以用「封」字诀把他封住，一封住，他好几手都出不来。"
msgstr "多出來的那一劍最要緊：可以追著刺，也可以用「封」字訣把他封住，一封住，他好幾手都出不來。"

msgid "可是贪不得。多出来的那一剑要是只顾着攻，对方的下一手就没人守了。爹爹说，封山的剑是等出来的。"
msgstr "可是貪不得。多出來的那一劍要是只顧著攻，對方的下一手就沒人守了。爹爹說，封山的劍是等出來的。"

msgid "你若想拜爹爹为师，他只看{requires}——不到的，他会说学剑的人要胆大心细。"
msgstr "你若想拜爹爹為師，他只看{requires}——不到的，他會說學劍的人要膽大心細。"

msgid "那……只拆三回合，不伤人。"
msgstr "那……只拆三回合，不傷人。"

msgid "方才你那一下刺空了，我手里就多出一剑，那记「封」就是这么来的。封山的剑，是等人露空子。"
msgstr "方才你那一下刺空了，我手裡就多出一劍，那記「封」就是這麼來的。封山的劍，是等人露空子。"

msgid "三回合你一招都没打空，我就一直没等到空子，只好跟你慢慢磨。封山的剑是等出来的，等不到，就只能这样。"
msgstr "三回合你一招都沒打空，我就一直沒等到空子，只好跟你慢慢磨。封山的劍是等出來的，等不到，就只能這樣。"

msgid "你也等到了我的空子，多出来的那一剑用得对。"
msgstr "你也等到了我的空子，多出來的那一劍用得對。"

msgid "你带着伤呢，爹爹不许我跟伤者动手。"
msgstr "你帶著傷呢，爹爹不許我跟傷者動手。"

msgid "你是别派的人，爹爹说过不能跟江湖人物比武过招。"
msgstr "你是別派的人，爹爹說過不能跟江湖人物比武過招。"

msgid "一回合里你出几手，我也出几手——你出完了，我才接着出。不急。"
msgstr "一回合裡你出幾手，我也出幾手——你出完了，我才接著出。不急。"

msgid "你尽管来刺。要是刺空了，我手上就多一剑；看清楚我是怎么追上来的。"
msgstr "你儘管來刺。要是刺空了，我手上就多一劍；看清楚我是怎麼追上來的。"

msgid "最后一回合。你也可以不急着出手，等我刺空了再说。"
msgstr "最後一回合。你也可以不急著出手，等我刺空了再說。"

msgid "封山剑法？小的不懂剑，只听来往的武师说：柳馆主的剑从不抢先，专等人家刺空了的那一下。"
msgstr "封山劍法？小的不懂劍，只聽來往的武師說：柳館主的劍從不搶先，專等人家刺空了的那一下。"

msgid "馆主的剑我看了五年。来踢馆的，十个有九个是自己刺空了，才挨那一下的。想拜他为师？他只看{requires}。"
msgstr "館主的劍我看了五年。來踢館的，十個有九個是自己刺空了，才挨那一下的。想拜他為師？他只看{requires}。"

msgid "柳淳风是个读书人，剑法嘛……文绉绉的，依老夫看没什么杀气。"
msgstr "柳淳風是個讀書人，劍法嘛……文縐縐的，依老夫看沒什麼殺氣。"

msgid "绘心师妹的剑最吓人的是那记「封」字诀，被封住了好几手都出不来。不过她说剑要等——等什么，我也说不上来。"
msgstr "繪心師妹的劍最嚇人的是那記「封」字訣，被封住了好幾手都出不來。不過她說劍要等——等什麼，我也說不上來。"

msgid "伤口"
msgstr "傷口"

msgid "这是剑伤，口子又直又深——封山剑的路数，多半是这位$RESPECT自己先刺空了，人家才补的这一剑。"
msgstr "這是劍傷，口子又直又深——封山劍的路數，多半是這位$RESPECT自己先刺空了，人家才補的這一劍。"

msgid "柳家拳？镇上后生练的都是这个。我瞧他们打架，先是一拳碰着人了，立马就贴上去，一拳比一拳重。"
msgstr "柳家拳？鎮上後生練的都是這個。我瞧他們打架，先是一拳碰著人了，立馬就貼上去，一拳比一拳重。"

msgid "李教头那身板，一拳打实了接着就是一记重的，叫什么虎吟。想拜柳馆主的，先去武馆找李教头拆拆招，拳脚简单，一拳就是一拳。"
msgstr "李教頭那身板，一拳打實了接著就是一記重的，叫什麼虎吟。想拜柳館主的，先去武館找李教頭拆拆招，拳腳簡單，一拳就是一拳。"

msgid "柳家拳好是好，就是练了脾气暴，李教头那些徒弟三天两头在街上跟人动手。"
msgstr "柳家拳好是好，就是練了脾氣暴，李教頭那些徒弟三天兩頭在街上跟人動手。"

msgid "柳家拳最怕打空。一拳落了空，人就离远了，再重的拳也够不着——小的挨过，知道。"
msgstr "柳家拳最怕打空。一拳落了空，人就離遠了，再重的拳也夠不著——小的挨過，知道。"

msgid "这是拳伤，一片青紫，底下还压着一记重的——柳家拳的路数，人贴上来才打得出这么重。"
msgstr "這是拳傷，一片青紫，底下還壓著一記重的——柳家拳的路數，人貼上來才打得出這麼重。"

msgid "这位$RESPECT身上没什么新伤，用不着看。"
msgstr "這位$RESPECT身上沒什麼新傷，用不著看。"

msgid "封山剑派北宗是封山剑派里的一支，剑法、拳脚和内功都与本宗同出一源。绮云镇口的公告上，至今还写着「封山剑派北宗所在的雪亭镇」。"
msgstr "封山劍派北宗是封山劍派裡的一支，劍法、拳腳和內功都與本宗同出一源。綺雲鎮口的公告上，至今還寫著「封山劍派北宗所在的雪亭鎮」。"

msgid "振远镖局"
msgstr "振遠鏢局"

msgid "振远镖局是京师第一大镖局，在京城一带几乎无人不知其名，绮云镇上也有振远的镖局。镖局里的人走镖凭的是一手春风快意刀。走镖危险，镖局收人先看胆识。"
msgstr "振遠鏢局是京師第一大鏢局，在京城一帶幾乎無人不知其名，綺雲鎮上也有振遠的鏢局。鏢局裡的人走鏢憑的是一手春風快意刀。走鏢危險，鏢局收人先看膽識。"

msgid "京师的振远总局"
msgstr "京師的振遠總局"

msgid "东方神教"
msgstr "東方神教"

msgid "东方神教是一个行事隐秘的教门，不立山门，也不收寻常弟子。教中人散在各处，平日看不出身份，外人对它的宗旨所知甚少。只听说教中高手使一路雪影剑法，身法轻疾。"
msgstr "東方神教是一個行事隱秘的教門，不立山門，也不收尋常弟子。教中人散在各處，平日看不出身份，外人對它的宗旨所知甚少。只聽說教中高手使一路雪影劍法，身法輕疾。"

msgid "天邪派"
msgstr "天邪派"

msgid "天邪派以水烟阁为大本营。水烟阁在雪亭镇西边青石官道尽头的山上，相传最早的主人是武术之神杞庸，后来成了历代武林盟主的行馆，每年正月十七在阁外虹台推选盟主。天邪神功与天邪神掌是这一派的根本，相传是杞庸见灵兽天邪虎而悟出；另有一路六阴追魂剑法，是三百年前一位前辈从废墟中得来的。门规甚严，拜师要么立誓恪守门规，要么接下三招。"
msgstr "天邪派以水煙閣為大本營。水煙閣在雪亭鎮西邊青石官道盡頭的山上，相傳最早的主人是武術之神杞庸，後來成了歷代武林盟主的行館，每年正月十七在閣外虹臺推選盟主。天邪神功與天邪神掌是這一派的根本，相傳是杞庸見靈獸天邪虎而悟出；另有一路六陰追魂劍法，是三百年前一位前輩從廢墟中得來的。門規甚嚴，拜師要麼立誓恪守門規，要麼接下三招。"

msgid "绝尘派"
msgstr "絕塵派"

msgid "绝尘派是绝尘子一手所创的门派。绝尘子原是佛门中人，后得奇人指点，悟得道家真谛，佛道双修，访遍名山大川后自号绝尘。他的修行之所在青石村的石室里，门上写着「非我弟子，莫入此门」。入门看慧根，也要有相当的江湖历练。"
msgstr "絕塵派是絕塵子一手所創的門派。絕塵子原是佛門中人，後得奇人指點，悟得道家真諦，佛道雙修，訪遍名山大川後自號絕塵。他的修行之所在青石村的石室裡，門上寫著「非我弟子，莫入此門」。入門看慧根，也要有相當的江湖歷練。"

msgid "青石村的石室"
msgstr "青石村的石室"

msgid "茅山派"
msgstr "茅山派"

msgid "茅山派自张天师开山立派，世代以降妖伏魔为己任，门户在茅山上的灵心观。门下修谷衣心法，排去体内的五谷秽气，炼成护体之气；修到小成，左眼眼珠会变成金色。法术以治鬼除魔为主，根基是天师正道。灵心观是出家人的道观，只收男弟子。"
msgstr "茅山派自張天師開山立派，世代以降妖伏魔為己任，門戶在茅山上的靈心觀。門下修谷衣心法，排去體內的五穀穢氣，煉成護體之氣；修到小成，左眼眼珠會變成金色。法術以治鬼除魔為主，根基是天師正道。靈心觀是出家人的道觀，只收男弟子。"

msgid "茅山的灵心观"
msgstr "茅山的靈心觀"

msgid "晚月庄是绮云镇以西林子深处的一座大宅院，朱漆大门，门口挂着灯笼，出现在乡野之间显得有些突兀。庄里多是女子，只收女弟子，庄主的琵琶闻名千里。武功以七宝天岚舞的身法、柔虹指和寒雪鞭法见长，内功意寒功纯走阴柔一路。"
msgstr "晚月莊是綺雲鎮以西林子深處的一座大宅院，朱漆大門，門口掛著燈籠，出現在鄉野之間顯得有些突兀。莊裡多是女子，只收女弟子，莊主的琵琶聞名千里。武功以七寶天嵐舞的身法、柔虹指和寒雪鞭法見長，內功意寒功純走陰柔一路。"

msgid "山烟寺在绮云镇南、泓水对岸的日照山上，整座寺由上好的桧木建成，金碧辉煌。寺中老方丈医术通神，受过恩惠的富豪出资修整，名气比京城的白象禅院还大。要入寺先得剃度出家，只收男子；武功以流云杖法和疗伤的莲华心法为主，佛法精深的还修八识神通。"
msgstr "山煙寺在綺雲鎮南、泓水對岸的日照山上，整座寺由上好的檜木建成，金碧輝煌。寺中老方丈醫術通神，受過恩惠的富豪出資修整，名氣比京城的白象禪院還大。要入寺先得剃度出家，只收男子；武功以流雲杖法和療傷的蓮華心法為主，佛法精深的還修八識神通。"

msgid "日照山的山烟寺"
msgstr "日照山的山煙寺"

msgid "逍遥派"
msgstr "逍遙派"

msgid "逍遥派的门户不在这一带，中原少见其门人。听说这一派收徒讲究人品文采，掌门是个风流倜傥的人物。"
msgstr "逍遙派的門戶不在這一帶，中原少見其門人。聽說這一派收徒講究人品文采，掌門是個風流倜儻的人物。"

msgid "天山派"
msgstr "天山派"

msgid "天山派的门户远在天山，中原少见其门人。晚月庄后门外的小径，据说就是通往天山的路。"
msgstr "天山派的門戶遠在天山，中原少見其門人。晚月莊後門外的小徑，據說就是通往天山的路。"

msgid "步玄派"
msgstr "步玄派"

msgid "步玄派是四百年前「秃笔狂生」骆步玄在京城创立的门派。骆步玄原是屡试不中的书生，一日在街边书肆望见一副对子，竟悟出一套武功，从此闯荡江湖。门下的步玄七诀号称天下轻功「轻捷第一」，使起来姿态有如书法；骆家至今是京城有名的武林世家。想入门的人，要先走一趟乔阴曼雩台东边的桃林。"
msgstr "步玄派是四百年前「禿筆狂生」駱步玄在京城創立的門派。駱步玄原是屢試不中的書生，一日在街邊書肆望見一副對子，竟悟出一套武功，從此闖蕩江湖。門下的步玄七訣號稱天下輕功「輕捷第一」，使起來姿態有如書法；駱家至今是京城有名的武林世家。想入門的人，要先走一趟喬陰曼雩臺東邊的桃林。"

msgid "乔阴县城的曼雩台"
msgstr "喬陰縣城的曼雩臺"

msgid "花紫会"
msgstr "花紫會"

msgid "花紫会是乞丐们的帮会，只收身上没几个钱的化子。龙头的信物是一只打着二十三个结的皮酒囊；龙头行踪诡秘，据说各处总有七八个替身。会中的武功有油流麻香手和伏蛟功。"
msgstr "花紫會是乞丐們的幫會，只收身上沒幾個錢的化子。龍頭的信物是一隻打著二十三個結的皮酒囊；龍頭行蹤詭秘，據說各處總有七八個替身。會中的武功有油流麻香手和伏蛟功。"

msgid "乔阴县城的福林大街"
msgstr "喬陰縣城的福林大街"

msgid "铁盾会是番坊里大秦人的剑会，门前立着两面比人还高的铁包边大盾，盾面上漆着展翅的鹰。大秦人的祖上从西边来，在这片海边落了脚。会里的剑手左手盾、右手短剑，两两对练；铁盾剑法盾在前、剑在后，没有盾的人不教。"
msgstr "鐵盾會是番坊裡大秦人的劍會，門前立著兩面比人還高的鐵包邊大盾，盾面上漆著展翅的鷹。大秦人的祖上從西邊來，在這片海邊落了腳。會裡的劍手左手盾、右手短劍，兩兩對練；鐵盾劍法盾在前、劍在後，沒有盾的人不教。"

msgid "番坊的铁盾会"
msgstr "番坊的鐵盾會"

msgid "鬼笠馆浪人"
msgstr "鬼笠館浪人"

msgid "鬼笠馆是番坊里倭人浪人开的武馆，门楣上挂着一顶破了边的斗笠，馆名就是这么来的。门规只有一句：「一击之内定生死」——刀出鞘，只出一次。鬼笠刀法的刀比中原的窄而弯，劈下去就收，不出第二刀。"
msgstr "鬼笠館是番坊裡倭人浪人開的武館，門楣上掛著一頂破了邊的斗笠，館名就是這麼來的。門規只有一句：「一擊之內定生死」——刀出鞘，只出一次。鬼笠刀法的刀比中原的窄而彎，劈下去就收，不出第二刀。"

msgid "番坊的鬼笠馆"
msgstr "番坊的鬼笠館"

msgid "日陀罗寺是番坊里一座不大的寺院，由两位天竺僧人所建，赭红的墙头长着草。院中一棵大榕树，是第一代师父从天竺带来的枝条插活的。入寺要先剃度出家，只收男子，所传的是莲华心法、流云杖法这些佛门功夫。"
msgstr "日陀羅寺是番坊裡一座不大的寺院，由兩位天竺僧人所建，赭紅的牆頭長著草。院中一棵大榕樹，是第一代師父從天竺帶來的枝條插活的。入寺要先剃度出家，只收男子，所傳的是蓮華心法、流雲杖法這些佛門功夫。"

msgid "番坊的日陀罗寺"
msgstr "番坊的日陀羅寺"

msgid "柳淳风"
msgstr "柳淳風"

msgid "风雨双侠"
msgstr "風雨雙俠"

msgid "柳淳风是个相当高大的中年儒生，若不是从他腰间挂著的「玄苏剑」你\n大概猜不到眼前这个温文儒雅的中年人竟是家大武馆的馆主。\n"
msgstr "柳淳風是個相當高大的中年儒生，若不是從他腰間掛著的「玄蘇劍」你\n大概猜不到眼前這個溫文儒雅的中年人竟是家大武館的館主。\n"

msgid "柳馆主"
msgstr "柳館主"

msgid "掌门人"
msgstr "掌門人"

msgid "竹书"
msgstr "竹書"

msgid "书在匣里。年轻时的糊涂话，留着给自己看。"
msgstr "書在匣裡。年輕時的糊塗話，留著給自己看。"

msgid "书在绘心那里。……她读得比我当年明白。"
msgstr "書在繪心那裡。……她讀得比我當年明白。"

msgid "竹林道尽头那块大黄石，照我教你的法子推。书取出来，带回来。"
msgstr "竹林道盡頭那塊大黃石，照我教你的法子推。書取出來，帶回來。"

msgid "看着窗外的竹影，半晌才开口。"
msgstr "看著窗外的竹影，半晌才開口。"

msgid "二十岁那年，我在天驼关的竹林里住过一冬，悟出一点架剑的道理，写成一卷，起名《悟疾风劲竹书》，留在竹林尽头的石室里。"
msgstr "二十歲那年，我在天駝關的竹林裡住過一冬，悟出一點架劍的道理，寫成一卷，起名《悟疾風勁竹書》，留在竹林盡頭的石室裡。"

msgid "石室的口子有一块大黄石堵着。硬推，没有几十年的内力推不动——我当年也推不动。"
msgstr "石室的口子有一塊大黃石堵著。硬推，沒有幾十年的內力推不動——我當年也推不動。"

msgid "那块石头不是那样推的。贴着它左下角那道青苔印，肩抵住，脚蹬石根；等风过竹林、石头自己松那一下，再发力。竹子是这么弯的，石头也是这么开的。"
msgstr "那塊石頭不是那樣推的。貼著它左下角那道青苔印，肩抵住，腳蹬石根；等風過竹林、石頭自己松那一下，再發力。竹子是這麼彎的，石頭也是這麼開的。"

msgid "书只有那一本。你替我取出来。"
msgstr "書只有那一本。你替我取出來。"

msgid "一卷旧书罢了。"
msgstr "一卷舊書罷了。"

msgid "本宗"
msgstr "本宗"

msgid "跟柳淳风守本宗：封山的剑不外传。\n他亲传你「点」字诀，你是掌门传人；柳绘心会离开武馆，带着「北宗」两个字去绮云镇。封山在虹台上的那一票跟着柳淳风——等盟主回来（已经入了虹台的席的，这一票不再跟着变）。\n这是封山这条线的大分裂，选了不能改。要跟师父吗？"
msgstr "跟柳淳風守本宗：封山的劍不外傳。\n他親傳你「點」字訣，你是掌門傳人；柳繪心會離開武館，帶著「北宗」兩個字去綺雲鎮。封山在虹臺上的那一票跟著柳淳風——等盟主回來（已經入了虹臺的席的，這一票不再跟著變）。\n這是封山這條線的大分裂，選了不能改。要跟師父嗎？"

msgid "虹台上的事还没完。等散了会再说。"
msgstr "虹臺上的事還沒完。等散了會再說。"

msgid "本宗的规矩，从今往后是你我两个人守。"
msgstr "本宗的規矩，從今往後是你我兩個人守。"

msgid "你选了。武馆的门不拦你——只是剑，我不能再教了。"
msgstr "你選了。武館的門不攔你——只是劍，我不能再教了。"

msgid "点了点头，像是早知道，又像是松了一口气。"
msgstr "點了點頭，像是早知道，又像是鬆了一口氣。"

msgid "好。那从今日起，「点」字诀归你。"
msgstr "好。那從今日起，「點」字訣歸你。"

msgid "平时使剑，内力聚在手臂上；「点」字诀把劲力聚在剑尖，以意使剑。刺出去的那一下，比你现在重得多——内力不够的时候别使，剑会脱手。"
msgstr "平時使劍，內力聚在手臂上；「點」字訣把勁力聚在劍尖，以意使劍。刺出去的那一下，比你現在重得多——內力不夠的時候別使，劍會脫手。"

msgid "拔出玄苏剑，剑尖在你面前的青砖上轻轻一点。砖没有裂，砖下的土陷下去一个指头深的坑。"
msgstr "拔出玄蘇劍，劍尖在你面前的青磚上輕輕一點。磚沒有裂，磚下的土陷下去一個指頭深的坑。"

msgid "封山这一辈，掌门的剑往后传给你。"
msgstr "封山這一輩，掌門的劍往後傳給你。"

msgid "绘心……她要走，我不拦。"
msgstr "繪心……她要走，我不攔。"

msgid "封山剑派只有一宗。"
msgstr "封山劍派只有一宗。"

msgid "点字诀"
msgstr "點字訣"

msgid "劲在剑尖，意在剑先。内力不够的时候别使。"
msgstr "勁在劍尖，意在劍先。內力不夠的時候別使。"

msgid "绘心自己悟的那一路，劲发得早了半分。你替我告诉她——不，不必说是我说的。"
msgstr "繪心自己悟的那一路，勁發得早了半分。你替我告訴她——不，不必說是我說的。"

msgid "「点」字诀是掌门一脉单传的。"
msgstr "「點」字訣是掌門一脈單傳的。"

msgid "武馆的事"
msgstr "武館的事"

msgid "镇上清净了。门户的名头不是谁都能借的——这一回，是你替武馆拿回来的。"
msgstr "鎮上清淨了。門戶的名頭不是誰都能借的——這一回，是你替武館拿回來的。"

msgid "镇西官道上那几个人，你去会一会。先看清他们凭的是什么，再动手。"
msgstr "鎮西官道上那幾個人，你去會一會。先看清他們憑的是什麼，再動手。"

msgid "放下手里的茶，看了你一眼。"
msgstr "放下手裡的茶，看了你一眼。"

msgid "既入了门，武馆的事你也该担一件。"
msgstr "既入了門，武館的事你也該擔一件。"

msgid "这几日有来投师的人说，在镇西的青石官道上交过「拜师钱」——十两银子，收钱的自称封山弟子。淳风武馆收徒，从来不收这个钱。"
msgstr "這幾日有來投師的人說，在鎮西的青石官道上交過「拜師錢」——十兩銀子，收錢的自稱封山弟子。淳風武館收徒，從來不收這個錢。"

msgid "我不便去。掌门出手打几个骗子，传出去是笑话。你是新面孔，他们不认得你——去看看他们凭的是什么。"
msgstr "我不便去。掌門出手打幾個騙子，傳出去是笑話。你是新面孔，他們不認得你——去看看他們憑的是什麼。"

msgid "武馆自家的事，不劳外人费心。"
msgstr "武館自家的事，不勞外人費心。"

msgid "腰牌"
msgstr "腰牌"

msgid "牌我收着。逄师弟什么时候自己来取，什么时候还他。"
msgstr "牌我收著。逄師弟什麼時候自己來取，什麼時候還他。"

msgid "他认了就好。牌给我吧。"
msgstr "他認了就好。牌給我吧。"

msgid "牌没带回来？……丢了也好，省得再有人拿它骗人。"
msgstr "牌沒帶回來？……丟了也好，省得再有人拿它騙人。"

msgid "门户的名头，不是谁都能借的。这件事你办得干净——从今日起，你是这一辈的大弟子。"
msgstr "門戶的名頭，不是誰都能借的。這件事你辦得乾淨——從今日起，你是這一輩的大弟子。"

msgid "还有一件事，李教头会同你说。"
msgstr "還有一件事，李教頭會同你說。"

msgid "接过腰牌翻过来，看见背面那个字，半晌没有说话。"
msgstr "接過腰牌翻過來，看見背面那個字，半晌沒有說話。"

msgid "逄……是逄义师弟的牌。同辈里他的剑不比我差，只是好赌。"
msgstr "逄……是逄義師弟的牌。同輩裡他的劍不比我差，只是好賭。"

msgid "牌是真的，人是假的——那就是牌从他手里流出去了。他这些年多半泡在绮云镇的赌场里。"
msgstr "牌是真的，人是假的——那就是牌從他手裡流出去了。他這些年多半泡在綺雲鎮的賭場裡。"

msgid "你去问他一句：牌是怎么到外人手里的。问明白了，再把牌带回来。"
msgstr "你去問他一句：牌是怎麼到外人手裡的。問明白了，再把牌帶回來。"

msgid "把腰牌递还给你。"
msgstr "把腰牌遞還給你。"

msgid "封山弟子人人有一块腰牌，正面一座山，背面是自己的姓。你的那块，等你的剑入了门再说。"
msgstr "封山弟子人人有一塊腰牌，正面一座山，背面是自己的姓。你的那塊，等你的劍入了門再說。"

msgid "逄义"
msgstr "逄義"

msgid "他肯认，就还是封山的人。"
msgstr "他肯認，就還是封山的人。"

msgid "逄师弟与我同辈，剑上的天分不在我之下。……好赌，多年不回武馆了。"
msgstr "逄師弟與我同輩，劍上的天分不在我之下。……好賭，多年不回武館了。"

msgid "淳风武馆是先父所创，在下辱承其名，虽忝掌封山门户，不敢忘了先人遗志。"
msgstr "淳風武館是先父所創，在下辱承其名，雖忝掌封山門戶，不敢忘了先人遺志。"

msgid "先人遗志"
msgstr "先人遺志"

msgid "先父临终之时将这武馆交到在下手中，需得好好照看。"
msgstr "先父臨終之時將這武館交到在下手中，需得好好照看。"

msgid "刘安禄"
msgstr "劉安祿"

msgid "刘兄弟在寒舍管事已经五年了，过去之事不须再提。"
msgstr "劉兄弟在寒舍管事已經五年了，過去之事不須再提。"

msgid "你既然知道我是柳馆主，怎麽不知道我是柳淳风？"
msgstr "你既然知道我是柳館主，怎麼不知道我是柳淳風？"

msgid "这里便是淳风武馆。"
msgstr "這裡便是淳風武館。"

msgid "隘口"
msgstr "隘口"

msgid "听说大内的人在黄石隘口挖出了东西，又被人抢了去。抢东西的若是往老松岭去了，多半是投老松寨。"
msgstr "聽說大內的人在黃石隘口挖出了東西，又被人搶了去。搶東西的若是往老松嶺去了，多半是投老松寨。"

msgid "老松寨的常老大，人称泼风刀王，什么钱都收。要过他的寨门，带够银子；有本事的，就在寨门外叫阵——硬闯的人，没几个回来。"
msgstr "老松寨的常老大，人稱潑風刀王，什麼錢都收。要過他的寨門，帶夠銀子；有本事的，就在寨門外叫陣——硬闖的人，沒幾個回來。"

msgid "黑衣道士"
msgstr "黑衣道士"

msgid "黑冠黑衣的道士？这一带没有道观。你若在老松岭遇上，小心些，那种人下手没有分寸。"
msgstr "黑冠黑衣的道士？這一帶沒有道觀。你若在老松嶺遇上，小心些，那種人下手沒有分寸。"

msgid "荐信"
msgstr "薦信"

msgid "老岑的信，你留着。末一行我不认得——他说过他在山里见过一座城，我只当是饿昏了的话。"
msgstr "老岑的信，你留著。末一行我不認得——他說過他在山裡見過一座城，我只當是餓昏了的話。"

msgid "接过信，看了很久，又折好还给你。"
msgstr "接過信，看了很久，又摺好還給你。"

msgid "老岑……二十多年前我在山里迷了路，三天没吃东西，是个砍柴的老人领我下的山。他不识几个字——这封信，他写了多久啊。"
msgstr "老岑……二十多年前我在山裡迷了路，三天沒吃東西，是個砍柴的老人領我下的山。他不識幾個字——這封信，他寫了多久啊。"

msgid "他托你来，武馆的门你随时进。拜不拜师，你自己定。"
msgstr "他託你來，武館的門你隨時進。拜不拜師，你自己定。"

msgid "末一行我不认得。他说过他在山里见过一座城，铃声满耳……我只当是饿昏了的话。你收好。"
msgstr "末一行我不認得。他說過他在山裡見過一座城，鈴聲滿耳……我只當是餓昏了的話。你收好。"

msgid "什么信？"
msgstr "什麼信？"

msgid "看了你一眼。"
msgstr "看了你一眼。"

msgid "信没了？……罢了，我再写一封。"
msgstr "信沒了？……罷了，我再寫一封。"

msgid "提笔又写了一封信，封好了交给你。"
msgstr "提筆又寫了一封信，封好了交給你。"

msgid "这回收好。潘军禅认信不认人。"
msgstr "這回收好。潘軍禪認信不認人。"

msgid "信已经给你了。去水烟阁找潘军禅，他是我的结拜义弟，见信如见我。"
msgstr "信已經給你了。去水煙閣找潘軍禪，他是我的結拜義弟，見信如見我。"

msgid "听你说完山洞里的事，沉默了半晌。"
msgstr "聽你說完山洞裡的事，沉默了半晌。"

msgid "洞里那个道士，是你杀的？……头一回手上沾血，夜里睡得着就好。睡不着，来武馆找我，我陪你坐一坐。"
msgstr "洞裡那個道士，是你殺的？……頭一回手上沾血，夜裡睡得著就好。睡不著，來武館找我，我陪你坐一坐。"

msgid "二十年前，振远镖局押一趟镖过老松岭，镖师随从一个都没回来。镖局丢了脸，陈剑秋到今天都不肯提。"
msgstr "二十年前，振遠鏢局押一趟鏢過老松嶺，鏢師隨從一個都沒回來。鏢局丟了臉，陳劍秋到今天都不肯提。"

msgid "那具骸骨若真是水烟阁的人，这事就该问水烟阁。我写一封信，你拿去给执法使潘军禅，他是我的结拜义弟。"
msgstr "那具骸骨若真是水煙閣的人，這事就該問水煙閣。我寫一封信，你拿去給執法使潘軍禪，他是我的結拜義弟。"

msgid "提笔写了一封信，封好了交给你。"
msgstr "提筆寫了一封信，封好了交給你。"

msgid "先去绮云镇问问陈剑秋，把镖单要来。上了山，别带着兵刃进阁。"
msgstr "先去綺雲鎮問問陳劍秋，把鏢單要來。上了山，別帶著兵刃進閣。"

msgid "还有一件：前夜老松岭上起了火，山下都看得见——是老松寨。那道士的同伙回来了，挨个问寨里的人：匣子在谁手里。夜里睡觉，把门闩上。"
msgstr "還有一件：前夜老松嶺上起了火，山下都看得見——是老松寨。那道士的同夥回來了，挨個問寨裡的人：匣子在誰手裡。夜裡睡覺，把門閂上。"

msgid "水烟阁在青石官道西头的山上，武者同盟的总坛。"
msgstr "水煙閣在青石官道西頭的山上，武者同盟的總壇。"

msgid "虹台上的事定了。封山守封山的规矩。"
msgstr "虹臺上的事定了。封山守封山的規矩。"

msgid "封山这一票，正月十七照你说的投。"
msgstr "封山這一票，正月十七照你說的投。"

msgid "把手里的茶盏放下，半晌没有说话。"
msgstr "把手裡的茶盞放下，半晌沒有說話。"

msgid "颜违许了北宗一个座。北宗的人上得了虹台，封山这一票，就跟着颜违走了。"
msgstr "顏違許了北宗一個座。北宗的人上得了虹臺，封山這一票，就跟著顏違走了。"

msgid "那一票不在我手里。你要说什么，去内院同绘心说。"
msgstr "那一票不在我手裡。你要說什麼，去內院同繪心說。"

msgid "等盟主回来。二十年了，虹台上那把石椅，封山不替任何人去坐。"
msgstr "等盟主回來。二十年了，虹臺上那把石椅，封山不替任何人去坐。"

msgid "……你是掌门传人。你要这一票投你自己，你开口。"
msgstr "……你是掌門傳人。你要這一票投你自己，你開口。"

msgid "封山这一票，等盟主回来。"
msgstr "封山這一票，等盟主回來。"

msgid "颜违要把那个「代」字去掉——他去他的。封山的剑不外传，封山的票也不跟着人走。"
msgstr "顏違要把那個「代」字去掉——他去他的。封山的劍不外傳，封山的票也不跟著人走。"

msgid "正月十七的事？湖上的事还没了，说那个早了。"
msgstr "正月十七的事？湖上的事還沒了，說那個早了。"

msgid "这一票"
msgstr "這一票"

msgid "请柳淳风把封山这一票交给你：正月十七虹台上，封山听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請柳淳風把封山這一票交給你：正月十七虹臺上，封山聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "虹台上已经入了席。票就是票了。"
msgstr "虹臺上已經入了席。票就是票了。"

msgid "那一票不在我手里。"
msgstr "那一票不在我手裡。"

msgid "说过了。封山听你的。"
msgstr "說過了。封山聽你的。"

msgid "看了你很久，点了点头。"
msgstr "看了你很久，點了點頭。"

msgid "好。封山听你的。"
msgstr "好。封山聽你的。"

msgid "……"
msgstr "……"

msgid "规矩是规矩。北宗的人，我不能再教了。"
msgstr "規矩是規矩。北宗的人，我不能再教了。"

msgid "这卷书，你不是已经给了绘心么。……拿回去还她。"
msgstr "這卷書，你不是已經給了繪心麼。……拿回去還她。"

msgid "把《悟疾风劲竹书》交给柳淳风。\n他会把它收进匣里，不再示人。书只有这一本，给出去就读不到了；柳绘心也读不到。\n要交给他吗？"
msgstr "把《悟疾風勁竹書》交給柳淳風。\n他會把它收進匣裡，不再示人。書只有這一本，給出去就讀不到了；柳繪心也讀不到。\n要交給他嗎？"

msgid "接过书，没有翻开，用袖口把封皮上的灰擦了。"
msgstr "接過書，沒有翻開，用袖口把封皮上的灰擦了。"

msgid "直竹贵地生……二十岁写的。那时候以为自己什么都懂。"
msgstr "直竹貴地生……二十歲寫的。那時候以為自己什麼都懂。"

msgid "年轻时的糊涂话，收起来罢。"
msgstr "年輕時的糊塗話，收起來罷。"

msgid "把书收进了案头的匣里。"
msgstr "把書收進了案頭的匣裡。"

msgid "绘心这些日子常往内院去，一去就是半天。你改日替我看一眼。"
msgstr "繪心這些日子常往內院去，一去就是半天。你改日替我看一眼。"

msgid "这卷书……你从竹林里取出来的？先留着读。武馆的事办完了，再同我说。"
msgstr "這卷書……你從竹林裡取出來的？先留著讀。武館的事辦完了，再同我說。"

msgid "把腰牌收进袖里。"
msgstr "把腰牌收進袖裡。"

msgid "找回来了？我替他收着。"
msgstr "找回來了？我替他收著。"

msgid "牌我替他收着。他什么时候戒了赌，什么时候自己来取。"
msgstr "牌我替他收著。他什麼時候戒了賭，什麼時候自己來取。"

msgid "牌是逄师弟的。你先去绮云镇问他一句，牌是怎么到外人手里的。"
msgstr "牌是逄師弟的。你先去綺雲鎮問他一句，牌是怎麼到外人手裡的。"

msgid "你跟了她。……也好。她一个人，我不放心。"
msgstr "你跟了她。……也好。她一個人，我不放心。"

msgid "武馆的门不拦你。剑，我不能再教了——规矩是规矩。"
msgstr "武館的門不攔你。劍，我不能再教了——規矩是規矩。"

msgid "刘兄弟的事，李教头回过我了。规矩是先父立的，我不能为他破。"
msgstr "劉兄弟的事，李教頭回過我了。規矩是先父立的，我不能為他破。"

msgid "五年前我留他，是我的事；今天你说破，是你的事。都没有错。"
msgstr "五年前我留他，是我的事；今天你說破，是你的事。都沒有錯。"

msgid "……说到规矩。我年轻时在天驼关的竹林里留过一卷书，写的也是这两个字。改日同你说。"
msgstr "……說到規矩。我年輕時在天駝關的竹林裡留過一卷書，寫的也是這兩個字。改日同你說。"

msgid "李教头说，那伙人认错了人。"
msgstr "李教頭說，那夥人認錯了人。"

msgid "看了你很久。"
msgstr "看了你很久。"

msgid "刘兄弟的来历，五年前我就知道。你替他担了这句话——往后，也替武馆担着。"
msgstr "劉兄弟的來歷，五年前我就知道。你替他擔了這句話——往後，也替武館擔著。"

msgid "你跟了绘心，就是北宗的人。本宗的门，我不能再为你开。"
msgstr "你跟了繪心，就是北宗的人。本宗的門，我不能再為你開。"

msgid "学剑之人必须胆大心细，依我看$RESPECT的资质似乎不宜？"
msgstr "學劍之人必須膽大心細，依我看$RESPECT的資質似乎不宜？"

msgid "很好，$RESPECT多加努力，他日必定有成。"
msgstr "很好，$RESPECT多加努力，他日必定有成。"

msgid "县城官兵"
msgstr "縣城官兵"

msgid "这是个正在执行公务的县城官兵，虽然和许多武林人物比起来，官兵\n们的武功实在稀松平常，但是他们是有组织、有纪律的战士，谁也不\n轻易地招惹他们。\n"
msgstr "這是個正在執行公務的縣城官兵，雖然和許多武林人物比起來，官兵\n們的武功實在稀鬆平常，但是他們是有組織、有紀律的戰士，誰也不\n輕易地招惹他們。\n"

msgid "县城官兵喝道：还不快放下武器束手就缚？\n"
msgstr "縣城官兵喝道：還不快放下武器束手就縛？\n"

msgid "县城官兵喝道：大胆刁民竟敢拒捕？反了！反了！\n"
msgstr "縣城官兵喝道：大膽刁民竟敢拒捕？反了！反了！\n"

msgid "於兰天武"
msgstr "於蘭天武"

msgid "大天邪"
msgstr "大天邪"

msgid "水烟阁传功使"
msgstr "水煙閣傳功使"

msgid "於兰天武是当今皇上的叔父，但是他毕生浸淫武学，甘愿抛弃荣华富\n以换取水烟阁传功使一职，以便阅读水烟阁中所藏的武学典籍，无论\n你有什麽武学上的疑难，他都能为你解答。\n"
msgstr "於蘭天武是當今皇上的叔父，但是他畢生浸淫武學，甘願拋棄榮華富\n以換取水煙閣傳功使一職，以便閱讀水煙閣中所藏的武學典籍，無論\n你有什麼武學上的疑難，他都能為你解答。\n"

msgid "武学之道....嗯....只可意会，不可言喻。\n"
msgstr "武學之道....嗯....只可意會，不可言喻。\n"

msgid "水烟阁乃是历届武林盟主的行馆，你有什麽事要见武林盟主？\n"
msgstr "水煙閣乃是歷屆武林盟主的行館，你有什麼事要見武林盟主？\n"

msgid "哦....老夫向来有个规矩，凡是想拜我为师的，得接我三招不死，你想试试？\n"
msgstr "哦....老夫向來有個規矩，凡是想拜我為師的，得接我三招不死，你想試試？\n"

msgid "皇上"
msgstr "皇上"

msgid "老夫在朝上一天，庾子建就不是一个人说了算。"
msgstr "老夫在朝上一天，庾子建就不是一個人說了算。"

msgid "昭儿？……他还小。朝廷的事，老夫不问了。"
msgstr "昭兒？……他還小。朝廷的事，老夫不問了。"

msgid "旋芒"
msgstr "旋芒"

msgid "在老夫手里。三百年前於兰家拔错了一把——决战那日，你来叫我，看老夫这一回拔得对不对。"
msgstr "在老夫手裡。三百年前於蘭家拔錯了一把——決戰那日，你來叫我，看老夫這一回拔得對不對。"

msgid "你拔的。好——於兰家这一回，不用再错一次。"
msgstr "你拔的。好——於蘭家這一回，不用再錯一次。"

msgid "萧家那孩子拿去了。他回了一趟岚城，比老夫配。"
msgstr "蕭家那孩子拿去了。他回了一趟嵐城，比老夫配。"

msgid "寒於氏的剑。於兰家的血里有寒於氏的一份——君违嫁过来的那一份。三百年前，我家的人拔错了一把剑。"
msgstr "寒於氏的劍。於蘭家的血裡有寒於氏的一份——君違嫁過來的那一份。三百年前，我家的人拔錯了一把劍。"

msgid "旋芒……先帝找了一辈子。老夫不找。"
msgstr "旋芒……先帝找了一輩子。老夫不找。"

msgid "找到城，叫我。风会知道怎么找到於兰家的人。"
msgstr "找到城，叫我。風會知道怎麼找到於蘭家的人。"

msgid "樵夫撞进去过，先帝的人没有。老夫不信那些。"
msgstr "樵夫撞進去過，先帝的人沒有。老夫不信那些。"

msgid "卫沧澜"
msgstr "衛滄瀾"

msgid "人送回水烟阁了。庾子建那道门，老夫往后还会去敲。"
msgstr "人送回水煙閣了。庾子建那道門，老夫往後還會去敲。"

msgid "卫沧澜出来了？好。……二十年，老夫在水烟阁等他回来，他就关在京城。"
msgstr "衛滄瀾出來了？好。……二十年，老夫在水煙閣等他回來，他就關在京城。"

msgid "虹台那边已经开了席。等散了会，老夫再去庾子建那里要人——这时候把人领出来，倒像是去抢那把椅子。"
msgstr "虹臺那邊已經開了席。等散了會，老夫再去庾子建那裡要人——這時候把人領出來，倒像是去搶那把椅子。"

msgid "放下手里的茶盏，站了起来。"
msgstr "放下手裡的茶盞，站了起來。"

msgid "卫沧澜？二十年前的武林盟主……庾子建府上那间客房，老夫知道。"
msgstr "衛滄瀾？二十年前的武林盟主……庾子建府上那間客房，老夫知道。"

msgid "昭儿的手诏召老夫回朝，也叫得开兵部尚书的门。你在这里等着。"
msgstr "昭兒的手詔召老夫回朝，也叫得開兵部尚書的門。你在這裡等著。"

msgid "於兰天武大步出了养心殿，两个侍卫捧着黄绫跟在后头。\n"
msgstr "於蘭天武大步出了養心殿，兩個侍衛捧著黃綾跟在後頭。\n"

msgid "过了一个多时辰，殿外一阵脚步响。於兰天武回来了，身后跟着一个白发的老人，腋下夹着一本诗集。\n"
msgstr "過了一個多時辰，殿外一陣腳步響。於蘭天武回來了，身後跟著一個白髮的老人，腋下夾著一本詩集。\n"

msgid "庾子建亲自开的门，一句话也没说。……老夫进门的时候，他还躬着身。"
msgstr "庾子建親自開的門，一句話也沒說。……老夫進門的時候，他還躬著身。"

msgid "卫沧澜朝你点点头：「老夫先回水烟阁。这条命是皇叔从尚书府要回来的，欠朝廷一份。」\n"
msgstr "衛滄瀾朝你點點頭：「老夫先回水煙閣。這條命是皇叔從尚書府要回來的，欠朝廷一份。」\n"

msgid "卫沧澜……二十年没有消息了。"
msgstr "衛滄瀾……二十年沒有消息了。"

msgid "$RESPECT若真的有心，不妨让我看看你的所学"
msgstr "$RESPECT若真的有心，不妨讓我看看你的所學"

msgid "如果想拜师的话，就请接受测试"
msgstr "如果想拜師的話，就請接受測試"

msgid "於兰天武点了点头，说道：很好，这是第一招...."
msgstr "於蘭天武點了點頭，說道：很好，這是第一招...."

msgid "於兰天武叹了口气，说道：连第一招都撑不过，真是自不量力...."
msgstr "於蘭天武嘆了口氣，說道：連第一招都撐不過，真是自不量力...."

msgid "於兰天武说道：这是第二招...."
msgstr "於蘭天武說道：這是第二招...."

msgid "於兰天武「哼」地一声，说道：便是有这许多不怕死的家伙...."
msgstr "於蘭天武「哼」地一聲，說道：便是有這許多不怕死的傢伙...."

msgid "於兰天武说道：第三招来了...."
msgstr "於蘭天武說道：第三招來了...."

msgid "於兰天武叹道：可惜，难道老夫一身武功竟无传人...."
msgstr "於蘭天武嘆道：可惜，難道老夫一身武功竟無傳人...."

msgid "於兰天武哈哈大笑，说道：今日老夫终於觅得一个可造之才！"
msgstr "於蘭天武哈哈大笑，說道：今日老夫終於覓得一個可造之才！"

msgid "接过黄笺，看了一遍，又看了一遍，半晌没有说话。"
msgstr "接過黃箋，看了一遍，又看了一遍，半晌沒有說話。"

msgid "昭儿的字……还是这么慢。"
msgstr "昭兒的字……還是這麼慢。"

msgid "三百年了，於兰家的人又要去碰那东西。老夫不回去，这孩子一个人扛不住。"
msgstr "三百年了，於蘭家的人又要去碰那東西。老夫不回去，這孩子一個人扛不住。"

msgid "把手诏折好，揣进怀里，站了起来。"
msgstr "把手詔摺好，揣進懷裡，站了起來。"

msgid "传功使的事，交给萧辟尘。——老夫回京。"
msgstr "傳功使的事，交給蕭辟塵。——老夫回京。"

msgid "萧辟尘"
msgstr "蕭辟塵"

msgid "小天邪"
msgstr "小天邪"

msgid "萧辟尘自幼生长於岚城之中，看起来仙风道骨，不食人间烟火。\n"
msgstr "蕭辟塵自幼生長於嵐城之中，看起來仙風道骨，不食人間煙火。\n"

msgid "{respect}既然使兵刃，在下空手接招未免不敬。"
msgstr "{respect}既然使兵刃，在下空手接招未免不敬。"

msgid "进招吧！"
msgstr "進招吧！"

msgid "既然{respect}不使兵刃，在下自然奉陪！"
msgstr "既然{respect}不使兵刃，在下自然奉陪！"

msgid "嗯... 既然{count}位都是空手，在下理当奉陪！"
msgstr "嗯... 既然{count}位都是空手，在下理當奉陪！"

msgid "我天邪派门规甚严，$RESPECT如果真的有心，且发个誓来。"
msgstr "我天邪派門規甚嚴，$RESPECT如果真的有心，且發個誓來。"

msgid "多说无益，若不发誓恪守门规，便是跪著求我也没用。"
msgstr "多說無益，若不發誓恪守門規，便是跪著求我也沒用。"

msgid "守门规"
msgstr "守門規"

msgid "这就是了。"
msgstr "這就是了。"

msgid "我回去过一回了。城还是那个样子，铃挂在钩上。……风记得我。"
msgstr "我回去過一回了。城還是那個樣子，鈴掛在鉤上。……風記得我。"

msgid "……这是我的铃。」他把铃接过去，翻来覆去看了很久，拇指在那个「尘」字上摸了一下，又还给你：「铃在，风认人。你带着它，比我带着它有用。"
msgstr "……這是我的鈴。」他把鈴接過去，翻來覆去看了很久，拇指在那個「塵」字上摸了一下，又還給你：「鈴在，風認人。你帶著它，比我帶著它有用。"

msgid "我四岁那年起了一场大风，醒来就在山外了，身边什么也没有。铃丢了，风就不认得我，我再也回不去。……风是从城里往外吹的。小时候我放风筝，线总是往外拽。"
msgstr "我四歲那年起了一場大風，醒來就在山外了，身邊什麼也沒有。鈴丟了，風就不認得我，我再也回不去。……風是從城裡往外吹的。小時候我放風箏，線總是往外拽。"

msgid "岚城……我是在那里长大的。别的，不说了。"
msgstr "嵐城……我是在那裡長大的。別的，不說了。"

msgid "风铃"
msgstr "風鈴"

msgid "铃舌上那个字是铃匠刻的。岚城的孩子，人人一只。"
msgstr "鈴舌上那個字是鈴匠刻的。嵐城的孩子，人人一隻。"

msgid "那只匣子……对着岚城的风才开。镜子里的上道，风从那头来。"
msgstr "那隻匣子……對著嵐城的風才開。鏡子裡的上道，風從那頭來。"

msgid "黄石隘口挖出来的那只石匣，后来在哪里？……先帝的人当年从山外收走过一只铃。我一直想，那是我的。"
msgstr "黃石隘口挖出來的那隻石匣，後來在哪裡？……先帝的人當年從山外收走過一隻鈴。我一直想，那是我的。"

msgid "风铃？水烟阁的檐下也挂着几只，风一大就响。"
msgstr "風鈴？水煙閣的簷下也掛著幾隻，風一大就響。"

msgid "在我背上。决战那日，它跟我下湖。"
msgstr "在我背上。決戰那日，它跟我下湖。"

msgid "是你。好。"
msgstr "是你。好。"

msgid "皇叔拔的？……也好。於兰家欠这把剑一回。"
msgstr "皇叔拔的？……也好。於蘭家欠這把劍一回。"

msgid "岚城有一把剑，叫旋芒。守剑的老人不卖，不赏，不问剑给谁做什么——只问谁拔。"
msgstr "嵐城有一把劍，叫旋芒。守劍的老人不賣，不賞，不問劍給誰做什麼——只問誰拔。"

msgid "旋芒？朝廷要找的那把剑。……小天邪不问这个。"
msgstr "旋芒？朝廷要找的那把劍。……小天邪不問這個。"

msgid "湖底"
msgstr "湖底"

msgid "湖底那颗头，三百年前是穿灵钉住的。这一回，我拿旋芒去。回不来，就回不来。"
msgstr "湖底那顆頭，三百年前是穿靈釘住的。這一回，我拿旋芒去。回不來，就回不來。"

msgid "湖底？玉螺湖底下的事，小天邪不问。"
msgstr "湖底？玉螺湖底下的事，小天邪不問。"

msgid "潘军禅"
msgstr "潘軍禪"

msgid "书 剑 侠"
msgstr "書 劍 俠"

msgid "水烟阁执法使"
msgstr "水煙閣執法使"

msgid "潘军禅是当今武林的一位传奇性人物，以他仅仅二十八岁的年龄竟能做到\n水烟阁执法使的职位，著实是一位不简单的人物。潘军禅是封山剑派掌门\n柳淳风的结拜义弟，但是他为人其实十分风趣，又好交朋友，丝毫不会摆\n出武林执法者的架子。\n"
msgstr "潘軍禪是當今武林的一位傳奇性人物，以他僅僅二十八歲的年齡竟能做到\n水煙閣執法使的職位，著實是一位不簡單的人物。潘軍禪是封山劍派掌門\n柳淳風的結拜義弟，但是他為人其實十分風趣，又好交朋友，絲毫不會擺\n出武林執法者的架子。\n"

msgid "柳大哥？他是我的结拜义兄。你有他的信？拿来我看。"
msgstr "柳大哥？他是我的結拜義兄。你有他的信？拿來我看。"

msgid "阁里那把是假的，真剑不在这儿。要找去年那个道士，往野羊山北麓去。"
msgstr "閣裡那把是假的，真劍不在這兒。要找去年那個道士，往野羊山北麓去。"

msgid "看了柳淳风的信，笑了。"
msgstr "看了柳淳風的信，笑了。"

msgid "柳大哥的朋友就是我的朋友。邪剑穿灵？阁里挂着的那把，是仿的。"
msgstr "柳大哥的朋友就是我的朋友。邪劍穿靈？閣裡掛著的那把，是仿的。"

msgid "真剑早就不在水烟阁了。挂一把假的，是鱼饵——钓那些冲着它来的人。"
msgstr "真劍早就不在水煙閣了。掛一把假的，是魚餌——釣那些衝著它來的人。"

msgid "去年就钓上来一个：黑衣黑冠的道士，夜里来试剑，发觉是假的就走了。我的人跟到野羊山北麓，跟丢了。那边没有道观，只有一片黑砖。"
msgstr "去年就釣上來一個：黑衣黑冠的道士，夜裡來試劍，發覺是假的就走了。我的人跟到野羊山北麓，跟丟了。那邊沒有道觀，只有一片黑磚。"

msgid "柳大哥让你来的？信呢？没有他的信，执法使的佩剑不是你问得的。信丢了，回武馆找他再写一封。"
msgstr "柳大哥讓你來的？信呢？沒有他的信，執法使的佩劍不是你問得的。信丟了，回武館找他再寫一封。"

msgid "执法使的佩剑，也是你问得的？"
msgstr "執法使的佩劍，也是你問得的？"

msgid "宝衣"
msgstr "寶衣"

msgid "晚月庄。守它的人不白给——我说过了。"
msgstr "晚月莊。守它的人不白給——我說過了。"

msgid "寒於宝衣？你倒问到点子上了。"
msgstr "寒於寶衣？你倒問到點子上了。"

msgid "当年三件东西各归一处，宝衣归月神族保管。月神族早没了，只剩晚月庄那些女子——自称人灵区冥的后人，庄里供着她的神像，池边立着凤凰护庄。"
msgstr "當年三件東西各歸一處，寶衣歸月神族保管。月神族早沒了，只剩晚月莊那些女子——自稱人靈區冥的後人，莊裡供著她的神像，池邊立著鳳凰護莊。"

msgid "衣在不在庄里，我不知道。守它的人不白给——你去了就明白。"
msgstr "衣在不在莊裡，我不知道。守它的人不白給——你去了就明白。"

msgid "还有——野羊山那边前夜出了事。一伙黑冠道士摸上山，抓走了寨里两个人，挨个问：那天闯道观的孩子是谁。他们在找你。"
msgstr "還有——野羊山那邊前夜出了事。一夥黑冠道士摸上山，抓走了寨裡兩個人，挨個問：那天闖道觀的孩子是誰。他們在找你。"

msgid "执刑使管的是刀，不管衣裳。"
msgstr "執刑使管的是刀，不管衣裳。"

msgid "山门"
msgstr "山門"

#~ msgid "山门的事办完了。正月十七之前，上山的人还会多。"
#~ msgstr "山門的事辦完了。正月十七之前，上山的人還會多。"

msgid "人跑了。拿错的那一个，我赔过礼了。"
msgstr "人跑了。拿錯的那一個，我賠過禮了。"

msgid "水烟阁的门，一年到头有人来打听盟主。这一回跑掉的，下回还会来——下回你认得他。"
msgstr "水煙閣的門，一年到頭有人來打聽盟主。這一回跑掉的，下回還會來——下回你認得他。"

msgid "眼力差了一点，胆子不差。你守过一回山门了——从今日起，你是这一辈的大弟子。"
msgstr "眼力差了一點，膽子不差。你守過一回山門了——從今日起，你是這一輩的大弟子。"

msgid "人拿下了？他身上掉出来的信，给我看看。"
msgstr "人拿下了？他身上掉出來的信，給我看看。"

msgid "人拿下了。身上的东西没捡着？……罢了，人押在刑堂里，我自己问。"
msgstr "人拿下了。身上的東西沒撿著？……罷了，人押在刑堂裡，我自己問。"

msgid "你守过一回山门了——从今日起，你是这一辈的大弟子。"
msgstr "你守過一回山門了——從今日起，你是這一輩的大弟子。"

msgid "人认出来了，还没拿下？去，别让他下了山。"
msgstr "人認出來了，還沒拿下？去，別讓他下了山。"

msgid "三个上山的人在阁前候着。问清来意，听他们怎么说盟主，看看路引——哪个不对，拿下。"
msgstr "三個上山的人在閣前候著。問清來意，聽他們怎麼說盟主，看看路引——哪個不對，拿下。"

msgid "把手里的卷宗一合，冲你招了招手。"
msgstr "把手裡的卷宗一合，衝你招了招手。"

#~ msgid "你来得正好。正月十七快到了，这些日子上山的人多：拜师的、送信的、看热闹的。"
#~ msgstr "你來得正好。正月十七快到了，這些日子上山的人多：拜師的、送信的、看熱鬧的。"

msgid "可这一个月，阁里丢了两份名帖，山下的客栈里也有人在打听——盟主还活着没有。"
msgstr "可這一個月，閣裡丟了兩份名帖，山下的客棧裡也有人在打聽——盟主還活著沒有。"

msgid "我认得的人太多，往门口一站，探子就不开口了。你是新面孔。去山门值一班：上山的人问清来意，哪个不对，拿下。"
msgstr "我認得的人太多，往門口一站，探子就不開口了。你是新面孔。去山門值一班：上山的人問清來意，哪個不對，拿下。"

msgid "拿错了人不要紧，我去赔礼。只是真的那个，就跑了。"
msgstr "拿錯了人不要緊，我去賠禮。只是真的那個，就跑了。"

msgid "山门有武士守着。执法使的事，不劳外人。"
msgstr "山門有武士守著。執法使的事，不勞外人。"

msgid "镖单"
msgstr "鏢單"

msgid "镖单在刑堂里锁着。振远的脸面，水烟阁替他们留着。"
msgstr "鏢單在刑堂裡鎖著。振遠的臉面，水煙閣替他們留著。"

msgid "交给陈总镖头了？……也好。他要查，就让他查到底。"
msgstr "交給陳總鏢頭了？……也好。他要查，就讓他查到底。"

msgid "手令丢了？我再写一张。"
msgstr "手令丟了？我再寫一張。"

msgid "镖单在你手里。给我锁进刑堂，还是带去京师给陈天星——你定。"
msgstr "鏢單在你手裡。給我鎖進刑堂，還是帶去京師給陳天星——你定。"

msgid "拿着手令去绮云镇的振远镖局，找陈剑秋。"
msgstr "拿著手令去綺雲鎮的振遠鏢局，找陳劍秋。"

msgid "镖单不在你身上？去绮云镇问陈剑秋，振远的底账里还有存根。"
msgstr "鏢單不在你身上？去綺雲鎮問陳劍秋，振遠的底賬裡還有存根。"

msgid "还有一件旧事。二十年前振远镖局替水烟阁押过一趟镖：盟主印一方，密件一匣，在老松岭丢了，一个人也没回来。"
msgstr "還有一件舊事。二十年前振遠鏢局替水煙閣押過一趟鏢：盟主印一方，密件一匣，在老松嶺丟了，一個人也沒回來。"

msgid "那张镖单还在振远手里。我写张手令，你去绮云镇找陈剑秋——他见了我的印，会拿出来。"
msgstr "那張鏢單還在振遠手裡。我寫張手令，你去綺雲鎮找陳劍秋——他見了我的印，會拿出來。"

msgid "拿到了，镖单该放在哪儿，你再定。"
msgstr "拿到了，鏢單該放在哪兒，你再定。"

msgid "还有一件旧事。二十年前振远镖局替水烟阁押过一趟镖：盟主印一方，密件一匣，在老松岭丢了。那张镖单，陈剑秋给过你。"
msgstr "還有一件舊事。二十年前振遠鏢局替水煙閣押過一趟鏢：盟主印一方，密件一匣，在老松嶺丟了。那張鏢單，陳劍秋給過你。"

msgid "镖单给我，我锁进刑堂：振远的脸面，水烟阁替他们留着，这件事到此为止。"
msgstr "鏢單給我，我鎖進刑堂：振遠的臉面，水煙閣替他們留著，這件事到此為止。"

msgid "陈天星不会这么想。京师的振远总局是他一手创的，他要知道当年那条路是谁点的。你把镖单带去给他，他会查到底——查出来的，未必只是振远的丑事。"
msgstr "陳天星不會這麼想。京師的振遠總局是他一手創的，他要知道當年那條路是誰點的。你把鏢單帶去給他，他會查到底——查出來的，未必只是振遠的醜事。"

msgid "镖单只有一张。你定。"
msgstr "鏢單只有一張。你定。"

msgid "镖单？先把山门的事办了。"
msgstr "鏢單？先把山門的事辦了。"

msgid "什么镖单？"
msgstr "什麼鏢單？"

msgid "盟主"
msgstr "盟主"

msgid "盟主的事，七长老做主了。执事有执事的公事。"
msgstr "盟主的事，七長老做主了。執事有執事的公事。"

msgid "等。他回来，或者不回来，椅子都是他的。"
msgstr "等。他回來，或者不回來，椅子都是他的。"

#~ msgid "盟主在厅里坐着。是你带回来的。"
#~ msgstr "盟主在廳裡坐著。是你帶回來的。"

msgid "京师的事了结了，盟主还是没有回来。七长老常下楼来看那把椅子——你出去走一走，他再下来的时候，你在厅里。"
msgstr "京師的事了結了，盟主還是沒有回來。七長老常下樓來看那把椅子——你出去走一走，他再下來的時候，你在廳裡。"

msgid "二十年前带走盟主的是兵部的白衣武官。线索在京师尚书府——我出不了水烟阁，你替我记着。"
msgstr "二十年前帶走盟主的是兵部的白衣武官。線索在京師尚書府——我出不了水煙閣，你替我記著。"

msgid "看了一眼厅侧坐着的那个白发老人，压低了声音。"
msgstr "看了一眼廳側坐著的那個白髮老人，壓低了聲音。"

#~ msgid "盟主回来了——是你从尚书府带出来的。他说，领头的白衣武官是庾子建的亲兵。"
#~ msgstr "盟主回來了——是你從尚書府帶出來的。他說，領頭的白衣武官是庾子建的親兵。"

msgid "陈天星查清了：那趟镖是兵部点名改走老松岭的。兵部知道盟主哪一天过岭。"
msgstr "陳天星查清了：那趟鏢是兵部點名改走老松嶺的。兵部知道盟主哪一天過嶺。"

msgid "人回来了，椅子还空着。七长老这几天常下楼来，站在那把椅子跟前。"
msgstr "人回來了，椅子還空著。七長老這幾天常下樓來，站在那把椅子跟前。"

msgid "你出去走一走；他再下来的时候，你在厅里。"
msgstr "你出去走一走；他再下來的時候，你在廳裡。"

msgid "那张镖单我锁起来了，可上面那条路我看过：本该走官道，却改走了老松岭——改路的人，知道盟主哪一天过岭。"
msgstr "那張鏢單我鎖起來了，可上面那條路我看過：本該走官道，卻改走了老松嶺——改路的人，知道盟主哪一天過嶺。"

msgid "合上卷宗，看了一眼大厅中央那张黝黑的太师椅。"
msgstr "合上卷宗，看了一眼大廳中央那張黝黑的太師椅。"

msgid "山门和镖单的事你都办过了。盟主的事，也该同你说了。"
msgstr "山門和鏢單的事你都辦過了。盟主的事，也該同你說了。"

msgid "二十年前，先帝召盟主进京。盟主带着阁里藏的一份旧记载上路，五长老押着盟主印随行，振远的镖走在前头。过了老松岭，一个人也没回来。"
msgstr "二十年前，先帝召盟主進京。盟主帶著閣裡藏的一份舊記載上路，五長老押著盟主印隨行，振遠的鏢走在前頭。過了老松嶺，一個人也沒回來。"

msgid "老松岭下的樵夫说，那天岭上来过一队穿白衣的武官。白衣，腰里挂的是兵部的刀。"
msgstr "老松嶺下的樵夫說，那天嶺上來過一隊穿白衣的武官。白衣，腰裡掛的是兵部的刀。"

msgid "京师的事有了结果，庾子建那边也有了说法——可盟主没有回来。椅子还空着。"
msgstr "京師的事有了結果，庾子建那邊也有了說法——可盟主沒有回來。椅子還空著。"

msgid "七长老这几天常下楼来，站在那把椅子跟前。你出去走一走；他再下来的时候，你在厅里。"
msgstr "七長老這幾天常下樓來，站在那把椅子跟前。你出去走一走；他再下來的時候，你在廳裡。"

msgid "二十年来，兵部尚书一直是庾子建。盟主要是还活着，线索在京师——尚书府。"
msgstr "二十年來，兵部尚書一直是庾子建。盟主要是還活著，線索在京師——尚書府。"

msgid "这件事我出不了水烟阁：执法使一动，七长老就要问为什么。你替我记着。"
msgstr "這件事我出不了水煙閣：執法使一動，七長老就要問為什麼。你替我記著。"

msgid "盟主的事……等山门和镖单的事办完了，我再同你说。"
msgstr "盟主的事……等山門和鏢單的事辦完了，我再同你說。"

msgid "盟主二十年没回来了。这件事，水烟阁不同外人说。"
msgstr "盟主二十年沒回來了。這件事，水煙閣不同外人說。"

msgid "椅子"
msgstr "椅子"

msgid "站潘军禅：等盟主回来。\n正月十七，天邪派在虹台上的那一票投旧盟主——卫沧澜回来了是他本人，没回来就是那把空椅子（已经入了虹台的席的，这一票不再跟着变）。潘军禅以执法使的名义升你执事；颜违会记下你，正月十七那天，他的人会多出一件事来。\n这是天邪这条线的大分裂，选了不能改。要站潘军禅吗？"
msgstr "站潘軍禪：等盟主回來。\n正月十七，天邪派在虹臺上的那一票投舊盟主——衛滄瀾回來了是他本人，沒回來就是那把空椅子（已經入了虹臺的席的，這一票不再跟著變）。潘軍禪以執法使的名義升你執事；顏違會記下你，正月十七那天，他的人會多出一件事來。\n這是天邪這條線的大分裂，選了不能改。要站潘軍禪嗎？"

msgid "椅子是盟主的。正月十七，天邪派那一票，你我一起投。"
msgstr "椅子是盟主的。正月十七，天邪派那一票，你我一起投。"

msgid "你站到七长老那边去了。执事的公事，照办就是。"
msgstr "你站到七長老那邊去了。執事的公事，照辦就是。"

msgid "看了你很久，才笑了一下——这一回的笑，和平时不一样。"
msgstr "看了你很久，才笑了一下——這一回的笑，和平時不一樣。"

msgid "好。门规里没有哪一条，写着盟主没死、椅子能换人。"
msgstr "好。門規裡沒有哪一條，寫著盟主沒死、椅子能換人。"

msgid "从今日起，你是水烟阁的执事。正月十七，天邪派那一票，等盟主。"
msgstr "從今日起，你是水煙閣的執事。正月十七，天邪派那一票，等盟主。"

msgid "七长老那里，往后说话小心些——他记性好。"
msgstr "七長老那裡，往後說話小心些——他記性好。"

msgid "盟主的椅子，空了二十年了。"
msgstr "盟主的椅子，空了二十年了。"

msgid "票是我唱的。唱完了，就是定了。"
msgstr "票是我唱的。唱完了，就是定了。"

msgid "天邪这一票，正月十七照你说的。"
msgstr "天邪這一票，正月十七照你說的。"

msgid "脸上没有什么表情。"
msgstr "臉上沒有什麼表情。"

msgid "你站了颜长老。天邪这一票，长老们说投他，就投他。"
msgstr "你站了顏長老。天邪這一票，長老們說投他，就投他。"

msgid "……执事要是想自己坐那把椅子，天邪这一票也是执事的。公事公办。"
msgstr "……執事要是想自己坐那把椅子，天邪這一票也是執事的。公事公辦。"

msgid "等盟主回来。我说过的话不改。"
msgstr "等盟主回來。我說過的話不改。"

msgid "你是执事。你要这一票，你开口。"
msgstr "你是執事。你要這一票，你開口。"

msgid "盟主回来了，就坐在厅里。天邪这一票，投他。"
msgstr "盟主回來了，就坐在廳裡。天邪這一票，投他。"

msgid "二十年没管过事又怎样？那把椅子是他的。"
msgstr "二十年沒管過事又怎樣？那把椅子是他的。"

msgid "望了一眼正厅那把空着的太师椅。"
msgstr "望了一眼正廳那把空著的太師椅。"

msgid "盟主没有回来。厅里是颜长老在管事——长老们的意思，天邪这一票投他。"
msgstr "盟主沒有回來。廳裡是顏長老在管事——長老們的意思，天邪這一票投他。"

msgid "我一个执法使，拦不住。"
msgstr "我一個執法使，攔不住。"

msgid "正月十七……盟主的事还没有着落，说虹台早了。"
msgstr "正月十七……盟主的事還沒有著落，說虹臺早了。"

msgid "请潘军禅把天邪派这一票交给你：正月十七虹台上，天邪听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請潘軍禪把天邪派這一票交給你：正月十七虹臺上，天邪聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "说过了。天邪听你的。"
msgstr "說過了。天邪聽你的。"

msgid "沉默了一会儿。"
msgstr "沉默了一會兒。"

msgid "好。天邪这一票，执事说了算。"
msgstr "好。天邪這一票，執事說了算。"

msgid "信我收下了。"
msgstr "信我收下了。"

msgid "信我收下了。山门的事，不劳你了。"
msgstr "信我收下了。山門的事，不勞你了。"

msgid "展开信看了一遍，半晌没有说话。"
msgstr "展開信看了一遍，半晌沒有說話。"

msgid "字是七长老身边账房的笔迹。……颜长老在数人头：哪几派来，椅子空不空，阁里谁跟谁走得近——数到我头上来了。"
msgstr "字是七長老身邊賬房的筆跡。……顏長老在數人頭：哪幾派來，椅子空不空，閣裡誰跟誰走得近——數到我頭上來了。"

msgid "数人头不犯门规。可派人扮成外人上山，数到自己阁里来——这件事，我记下了。"
msgstr "數人頭不犯門規。可派人扮成外人上山，數到自己閣裡來——這件事，我記下了。"

msgid "展开信看了一遍，脸上的笑没了。"
msgstr "展開信看了一遍，臉上的笑沒了。"

msgid "纸是兵部的公文纸，裁去了抬头。他们想知道两件事：椅子空着没有，卫盟主还在不在。"
msgstr "紙是兵部的公文紙，裁去了抬頭。他們想知道兩件事：椅子空著沒有，衛盟主還在不在。"

msgid "兵部的人扮成皮货商上水烟阁打听盟主——二十年来，这是头一回。有人在京师，替盟主的生死记着账。"
msgstr "兵部的人扮成皮貨商上水煙閣打聽盟主——二十年來，這是頭一回。有人在京師，替盟主的生死記著賬。"

msgid "镖单你已经给了陈总镖头。这一张存根，你自己留着。"
msgstr "鏢單你已經給了陳總鏢頭。這一張存根，你自己留著。"

msgid "刑堂里已经锁着一张了。"
msgstr "刑堂裡已經鎖著一張了。"

msgid "把镖单交给潘军禅，锁进水烟阁的刑堂。\n振远的脸面保住了，这件事到此为止——陈天星不会再查。\n镖单只有一张。交给他吗？"
msgstr "把鏢單交給潘軍禪，鎖進水煙閣的刑堂。\n振遠的臉面保住了，這件事到此為止——陳天星不會再查。\n鏢單只有一張。交給他嗎？"

msgid "接过镖单看了一遍，折好收进了袖里。"
msgstr "接過鏢單看了一遍，摺好收進了袖裡。"

msgid "锁进刑堂。振远的脸面，水烟阁替他们留着。"
msgstr "鎖進刑堂。振遠的臉面，水煙閣替他們留著。"

msgid "陈剑秋那里，我派人去说一声。二十年了，他也该睡个好觉。"
msgstr "陳劍秋那裡，我派人去說一聲。二十年了，他也該睡個好覺。"

msgid "振远的东西，你自己收好。"
msgstr "振遠的東西，你自己收好。"

msgid "执法使"
msgstr "執法使"

msgid "於兰前辈入了朝，萧师兄……没有回来。水烟阁不能没有收徒的人，我以执法使的名义代收。天邪派门规甚严，$RESPECT如果真的有心，且发个誓来。"
msgstr "於蘭前輩入了朝，蕭師兄……沒有回來。水煙閣不能沒有收徒的人，我以執法使的名義代收。天邪派門規甚嚴，$RESPECT如果真的有心，且發個誓來。"

msgid "执法使代收，也是照门规收。不发誓，不收。"
msgstr "執法使代收，也是照門規收。不發誓，不收。"

msgid "好。师父不在，执法使替他们看着你。"
msgstr "好。師父不在，執法使替他們看著你。"

msgid "冲你点了点头，没有笑。"
msgstr "衝你點了點頭，沒有笑。"

msgid "从楼上下来，走到大厅中央那张黝黑的太师椅跟前，伸手在扶手上按了一按。"
msgstr "從樓上下來，走到大廳中央那張黝黑的太師椅跟前，伸手在扶手上按了一按。"

msgid "这个「代」字，本座顶了这些日子，也该去掉了。正月十七九派上虹台，水烟阁要有一个真正坐这把椅子的人。"
msgstr "這個「代」字，本座頂了這些日子，也該去掉了。正月十七九派上虹臺，水煙閣要有一個真正坐這把椅子的人。"

msgid "二十年了，这把椅子一直空着。正月十七九派上虹台，水烟阁总得拿出个说法——椅子空着，武林就没有一个能说话的人。"
msgstr "二十年了，這把椅子一直空著。正月十七九派上虹臺，水煙閣總得拿出個說法——椅子空著，武林就沒有一個能說話的人。"

msgid "坐在厅侧的一张矮凳上，手里还拿着那本诗集，没有抬头。"
msgstr "坐在廳側的一張矮凳上，手裡還拿著那本詩集，沒有抬頭。"

msgid "盟主回来了，本座比谁都高兴。可一个二十年没管过事的人，正月十七上了虹台，九派问他这二十年武林是什么样子——他答得上来么？"
msgstr "盟主回來了，本座比誰都高興。可一個二十年沒管過事的人，正月十七上了虹臺，九派問他這二十年武林是什麼樣子——他答得上來麼？"

msgid "椅子空着，是因为盟主还没回来。"
msgstr "椅子空著，是因為盟主還沒回來。"

msgid "二十年了，执法使。人要是回得来，早就回来了。"
msgstr "二十年了，執法使。人要是回得來，早就回來了。"

msgid "九派里几派会来，阁里谁跟谁走得近——本座心里有数。山门上跑掉的那一个，没有白跑。"
msgstr "九派裡幾派會來，閣裡誰跟誰走得近——本座心裡有數。山門上跑掉的那一個，沒有白跑。"

msgid "上个月山门上那个探子，听说是从执法使眼皮底下走的？椅子空着，外人就敢上山来问盟主的死活。"
msgstr "上個月山門上那個探子，聽說是從執法使眼皮底下走的？椅子空著，外人就敢上山來問盟主的死活。"

msgid "上个月扮成皮货商上山来数人头的，是七长老账房里的人。"
msgstr "上個月扮成皮貨商上山來數人頭的，是七長老賬房裡的人。"

msgid "数人头不犯门规。正月十七几派来、椅子空不空，总得有人去数。"
msgstr "數人頭不犯門規。正月十七幾派來、椅子空不空，總得有人去數。"

msgid "上个月山门上拿下的那个，是兵部的人。京师有人替盟主的生死记着账。"
msgstr "上個月山門上拿下的那個，是兵部的人。京師有人替盟主的生死記著賬。"

msgid "所以更要早定。椅子空一天，朝廷就多一天的念想。"
msgstr "所以更要早定。椅子空一天，朝廷就多一天的念想。"

msgid "陈天星查清了：二十年前那趟镖，是兵部点名改走老松岭的。"
msgstr "陳天星查清了：二十年前那趟鏢，是兵部點名改走老松嶺的。"

msgid "查清了又如何？水烟阁不能为一趟镖跟朝廷耗二十年。正月十七之后，旧案到此为止。"
msgstr "查清了又如何？水煙閣不能為一趟鏢跟朝廷耗二十年。正月十七之後，舊案到此為止。"

msgid "镖单锁进了刑堂——执法使自己也知道，有些旧案，到此为止最好。"
msgstr "鏢單鎖進了刑堂——執法使自己也知道，有些舊案，到此為止最好。"

msgid "锁起来，是替振远留脸面，不是替谁结案。"
msgstr "鎖起來，是替振遠留臉面，不是替誰結案。"

msgid "盟主回来了。他坐不坐这把椅子，正月十七由他自己说，轮不到别人替他定。"
msgstr "盟主回來了。他坐不坐這把椅子，正月十七由他自己說，輪不到別人替他定。"

msgid "盟主一天没有消息，这把椅子就一天是盟主的。等他回来。"
msgstr "盟主一天沒有消息，這把椅子就一天是盟主的。等他回來。"

msgid "转过身来，看着你。"
msgstr "轉過身來，看著你。"

msgid "你是天邪这一辈的大弟子。正月十七，天邪派那一票该投给谁，你说一句。跟着本座，水烟阁的执事有你一个。"
msgstr "你是天邪這一輩的大弟子。正月十七，天邪派那一票該投給誰，你說一句。跟著本座，水煙閣的執事有你一個。"

msgid "七长老许得出口的，我许不出口。我只问你一句：门规里哪一条，写着盟主没死，椅子就能换人？"
msgstr "七長老許得出口的，我許不出口。我只問你一句：門規裡哪一條，寫著盟主沒死，椅子就能換人？"

msgid "绝尘子"
msgstr "絕塵子"

msgid "绝尘子本为释家人，后得奇人指点，得悟道家真谛，佛道双修，\n皆入化境。后访遍名山大川，自号绝尘，创此绝尘一派。\n"
msgstr "絕塵子本為釋家人，後得奇人指點，得悟道家真諦，佛道雙修，\n皆入化境。後訪遍名山大川，自號絕塵，創此絕塵一派。\n"

msgid "祖师"
msgstr "祖師"

msgid "绝尘子道：你为何无故滋事，误我清修！\n"
msgstr "絕塵子道：你為何無故滋事，誤我清修！\n"

msgid "绝尘子道：贫道向以遁世为乐，你何苦如此相逼？\n"
msgstr "絕塵子道：貧道向以遁世為樂，你何苦如此相逼？\n"

msgid "绝尘派是我所创，你有何指教？"
msgstr "絕塵派是我所創，你有何指教？"

msgid "入我派者，需有慧根。"
msgstr "入我派者，需有慧根。"

msgid "我便是绝尘子。"
msgstr "我便是絕塵子。"

msgid "绝尘派不问世事。"
msgstr "絕塵派不問世事。"

msgid "洞里的事，你都知道了。"
msgstr "洞裡的事，你都知道了。"

msgid "闭着眼睛听你说完，过了很久才睁开。"
msgstr "閉著眼睛聽你說完，過了很久才睜開。"

msgid "洞里有东西，老道知道。"
msgstr "洞裡有東西，老道知道。"

msgid "那道门拴着，阵守得住石室——老道就不管。"
msgstr "那道門拴著，陣守得住石室——老道就不管。"

msgid "又闭上了眼睛。"
msgstr "又閉上了眼睛。"

msgid "青石村？绝尘派不问世事。"
msgstr "青石村？絕塵派不問世事。"

msgid "绝尘派不问世事。村里人的事，你要管，自己去管。"
msgstr "絕塵派不問世事。村裡人的事，你要管，自己去管。"

msgid "睁开眼睛，打量了你一番。"
msgstr "睜開眼睛，打量了你一番。"

msgid "你走得出老道的阵。"
msgstr "你走得出老道的陣。"

msgid "……村里人的事，你要管，自己去管。"
msgstr "……村裡人的事，你要管，自己去管。"

msgid "正月十七的事，过去了。"
msgstr "正月十七的事，過去了。"

msgid "老道说话算话。正月十七，老道下山走一趟。"
msgstr "老道說話算話。正月十七，老道下山走一趟。"

msgid "虹台？绝尘派不问世事，向来不去。"
msgstr "虹臺？絕塵派不問世事，向來不去。"

msgid "眯着眼睛打量了你一番。"
msgstr "眯著眼睛打量了你一番。"

msgid "……你走得过老道的八卦阵。好，你要老道下山，老道就下山——投旧盟主，椅子照旧。"
msgstr "……你走得過老道的八卦陣。好，你要老道下山，老道就下山——投舊盟主，椅子照舊。"

msgid "虹台上那把椅子谁坐，跟老道没有关系。"
msgstr "虹臺上那把椅子誰坐，跟老道沒有關係。"

msgid "下山"
msgstr "下山"

msgid "请绝尘子下山：正月十七绝尘派来虹台，这一票投旧盟主。\n要这么说吗？"
msgstr "請絕塵子下山：正月十七絕塵派來虹臺，這一票投舊盟主。\n要這麼說嗎？"

msgid "说过了。老道下山。"
msgstr "說過了。老道下山。"

msgid "拂了拂袖子。"
msgstr "拂了拂袖子。"

msgid "好。老道走一趟。"
msgstr "好。老道走一趟。"

msgid "{title}{nickname}{name}要叛师！！！"
msgstr "{title}{nickname}{name}要叛師！！！"

msgid "入我派者，需有慧根。$RESPECT的资质不宜！"
msgstr "入我派者，需有慧根。$RESPECT的資質不宜！"

msgid "$RESPECT似乎尚缺江湖历练，不宜投入绝尘门下。"
msgstr "$RESPECT似乎尚缺江湖歷練，不宜投入絕塵門下。"

msgid "很好$RESPECT多加努力他日必定有成。"
msgstr "很好$RESPECT多加努力他日必定有成。"

msgid "这是一位来自天界的守护神，专门担任护法之责。\n"
msgstr "這是一位來自天界的守護神，專門擔任護法之責。\n"

msgid "天甲神兵"
msgstr "天甲神兵"

msgid "天乙神兵"
msgstr "天乙神兵"

msgid "天丙神兵"
msgstr "天丙神兵"

msgid "天丁神兵"
msgstr "天丁神兵"

msgid "天戊神兵"
msgstr "天戊神兵"

msgid "天己神兵"
msgstr "天己神兵"

msgid "天庚神兵"
msgstr "天庚神兵"

msgid "天辛神兵"
msgstr "天辛神兵"

msgid "天壬神兵"
msgstr "天壬神兵"

msgid "天癸神兵"
msgstr "天癸神兵"

msgid "一道金光由天而降，金光中走出一个身穿金色战袍的将官。"
msgstr "一道金光由天而降，金光中走出一個身穿金色戰袍的將官。"

msgid "$N说道：末将奉法主召唤，特来护法！"
msgstr "$N說道：末將奉法主召喚，特來護法！"

msgid "$N说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！"
msgstr "$N說道：末將奉法主召喚，現在已經完成護法任務，就此告辭！"

msgid "$N化成一道金光，冲上天际消失不见了。"
msgstr "$N化成一道金光，衝上天際消失不見了。"

msgid "林忌"
msgstr "林忌"

msgid "六指真人"
msgstr "六指真人"

msgid "林忌是一位道行十分高深的修道者，你发现他的眼珠一个是黑色的，一\n个是金色的，这正是「谷衣心法」修炼到极高境界的徵兆。\n"
msgstr "林忌是一位道行十分高深的修道者，你發現他的眼珠一個是黑色的，一\n個是金色的，這正是「谷衣心法」修煉到極高境界的徵兆。\n"

msgid "天师"
msgstr "天師"

msgid "道童"
msgstr "道童"

msgid "的眉头动了一下。"
msgstr "的眉頭動了一下。"

msgid "北麓的道观收孩子，说是收道童。茅山查了二十年，查到的孩子都没有回来过。"
msgstr "北麓的道觀收孩子，說是收道童。茅山查了二十年，查到的孩子都沒有回來過。"

msgid "晚月庄那个女人是逃出来的？……那她是第一个。六阴剑是逆灵宫的剑，教给孩子，是为了让他们替宫里杀人。"
msgstr "晚月莊那個女人是逃出來的？……那她是第一個。六陰劍是逆靈宮的劍，教給孩子，是為了讓他們替宮裡殺人。"

msgid "道童？"
msgstr "道童？"

msgid "茅山的家事，不劳你了。"
msgstr "茅山的家事，不勞你了。"

msgid "没有抬头。"
msgstr "沒有抬頭。"

msgid "书在藏经楼，他守着。他二十年不进这道门——进来一回，就不走了。"
msgstr "書在藏經樓，他守著。他二十年不進這道門——進來一回，就不走了。"

msgid "你们说留，就留吧。"
msgstr "你們說留，就留吧。"

msgid "书烧了。他回京城去了——那里还有他守着的人。"
msgstr "書燒了。他回京城去了——那裡還有他守著的人。"

msgid "书在这里，人也在这里。"
msgstr "書在這裡，人也在這裡。"

msgid "烧，问我「烧」；留，去问他「留」。你带它回来的——你说。"
msgstr "燒，問我「燒」；留，去問他「留」。你帶它回來的——你說。"

msgid "他会来的。书在我这里，他总要来看一眼。"
msgstr "他會來的。書在我這裡，他總要來看一眼。"

msgid "下回你进大殿，他就在门口了。"
msgstr "下回你進大殿，他就在門口了。"

msgid "他在京城兵部尚书府，二十年了。书在他手里。"
msgstr "他在京城兵部尚書府，二十年了。書在他手裡。"

msgid "把拂尘搁在香案上，半晌没有说话。"
msgstr "把拂塵擱在香案上，半晌沒有說話。"

msgid "少的那一函叫《上清符箓》，茅山的符都在里头。"
msgstr "少的那一函叫《上清符籙》，茅山的符都在裡頭。"

msgid "二十年前，京里兵部的庾大人夜夜见白衣人，派人上山，求茅山去镇宅。茅山不给官家看门——我不肯。"
msgstr "二十年前，京裡兵部的庾大人夜夜見白衣人，派人上山，求茅山去鎮宅。茅山不給官家看門——我不肯。"

msgid "我那师弟说，镇宅也是救人。夜里揣着那函书下了山，再没回来。"
msgstr "我那師弟說，鎮宅也是救人。夜裡揣著那函書下了山，再沒回來。"

msgid "「我守人」……他守的是谁，我不知道。他在京城兵部尚书府，二十年了。你替我去看一眼。"
msgstr "「我守人」……他守的是誰，我不知道。他在京城兵部尚書府，二十年了。你替我去看一眼。"

msgid "藏经楼二楼，红布桌上的镇教秘籍，你数过没有？"
msgstr "藏經樓二樓，紅布桌上的鎮教秘籍，你數過沒有？"

msgid "上去看看。"
msgstr "上去看看。"

msgid "金色的那只眼睛动了一下。"
msgstr "金色的那隻眼睛動了一下。"

msgid "尚书府的花匠？……你见过他。他还叫我师兄。"
msgstr "尚書府的花匠？……你見過他。他還叫我師兄。"

msgid "茅山的家事，本不该同外人说。你见过他，就算茅山的朋友。"
msgstr "茅山的家事，本不該同外人說。你見過他，就算茅山的朋友。"

msgid "藏经楼你上去看看。二楼红布桌上的镇教秘籍，你数一数。"
msgstr "藏經樓你上去看看。二樓紅布桌上的鎮教秘籍，你數一數。"

msgid "你替茅山戴过那顶冠，算茅山的朋友。茅山的家事，不瞒你。"
msgstr "你替茅山戴過那頂冠，算茅山的朋友。茅山的家事，不瞞你。"

msgid "我有个师弟，二十年前下了山。"
msgstr "我有個師弟，二十年前下了山。"

msgid "茅山的家事。"
msgstr "茅山的家事。"

msgid "烧"
msgstr "燒"

msgid "跟林忌：《上清符箓》投进殿前的香炉，镇教秘籍从此少一函——茅山宁可没有这本书。花匠下山回京城，守着庾清尘。\n林忌教你谷衣心法。正月十七虹台上，茅山这一票投颜违：主剿，北麓剿干净，不留根（已经入了虹台的席的，这一票不再跟着变）。\n终章之后北麓那座道观里的人还没有去处的，问林忌「剿」，官兵上山。\n要这么办吗？"
msgstr "跟林忌：《上清符籙》投進殿前的香爐，鎮教秘籍從此少一函——茅山寧可沒有這本書。花匠下山回京城，守著庾清塵。\n林忌教你谷衣心法。正月十七虹臺上，茅山這一票投顏違：主剿，北麓剿乾淨，不留根（已經入了虹臺的席的，這一票不再跟著變）。\n終章之後北麓那座道觀裡的人還沒有去處的，問林忌「剿」，官兵上山。\n要這麼辦嗎？"

msgid "书锁回去了。……师弟守着。"
msgstr "書鎖回去了。……師弟守著。"

msgid "烧了。灰是青的。"
msgstr "燒了。灰是青的。"

msgid "把《上清符箓》捧到殿前的香炉边，一页一页撕下来，投进去。"
msgstr "把《上清符籙》捧到殿前的香爐邊，一頁一頁撕下來，投進去。"

msgid "前半本的朱砂符烧起来是红的，后半本的黑字烧起来是青的。花匠站在殿门口，一直看到最后一页。\n"
msgstr "前半本的硃砂符燒起來是紅的，後半本的黑字燒起來是青的。花匠站在殿門口，一直看到最後一頁。\n"

msgid "茅山宁可没有这本书。"
msgstr "茅山寧可沒有這本書。"

msgid "师弟，回京城去吧。那孩子还要人看着。"
msgstr "師弟，回京城去吧。那孩子還要人看著。"

msgid "花匠朝林忌拜了一拜，什么也没说，转身下山去了。\n"
msgstr "花匠朝林忌拜了一拜，什麼也沒說，轉身下山去了。\n"

msgid "烧什么？"
msgstr "燒什麼？"

msgid "谷衣心法是我茅山派为对抗邪魔外道所创的内功心法。\n"
msgstr "谷衣心法是我茅山派為對抗邪魔外道所創的內功心法。\n"

msgid "我茅山派自张天师开山立派至今，世世代代皆以降妖伏魔为己任。\n"
msgstr "我茅山派自張天師開山立派至今，世世代代皆以降妖伏魔為己任。\n"

msgid "逆灵宫"
msgstr "逆靈宮"

msgid "看了你很久，叹了一口气。"
msgstr "看了你很久，嘆了一口氣。"

msgid "他们认出你了。冠摘了吧——戴着它，北麓上谁都认得你。"
msgstr "他們認出你了。冠摘了吧——戴著它，北麓上誰都認得你。"

msgid "你递出来的东西，茅山都用上了。这就够了。"
msgstr "你遞出來的東西，茅山都用上了。這就夠了。"

msgid "你露的破绽太多了。宫里迟早认出你——别再回那座道观。"
msgstr "你露的破綻太多了。宮裡遲早認出你——別再回那座道觀。"

msgid "时辰和路，茅山记下了。那一夜，北麓下湖的路上有茅山的人。"
msgstr "時辰和路，茅山記下了。那一夜，北麓下湖的路上有茅山的人。"

msgid "那就去吧。冠戴好——那一剑，只有你递得出去。"
msgstr "那就去吧。冠戴好——那一劍，只有你遞得出去。"

msgid "官兵上了北麓。宫里剩下的人，这一回一个也走不了。"
msgstr "官兵上了北麓。宮裡剩下的人，這一回一個也走不了。"

msgid "宫里剩下的人下了山，茅山看着。坛上的火，灭了。"
msgstr "宮裡剩下的人下了山，茅山看著。壇上的火，滅了。"

msgid "回北麓去，同宫里当家的说「下山」。"
msgstr "回北麓去，同宮裡當家的說「下山」。"

#~ msgid "宫里剩下的人，交官府去剿（问我「剿」），还是劝他们下山、交茅山看着（问我「招安」）——你定。正月十七之前，给我一个了断。"
#~ msgstr "宮裡剩下的人，交官府去剿（問我「剿」），還是勸他們下山、交茅山看著（問我「招安」）——你定。正月十七之前，給我一個了斷。"

msgid "唤首那一夜过去了。茅山没等到你的话。"
msgstr "喚首那一夜過去了。茅山沒等到你的話。"

msgid "倒戈，还是潜伏，你定。定了，来告诉我。"
msgstr "倒戈，還是潛伏，你定。定了，來告訴我。"

msgid "把拂尘搭在臂弯里，金色的那只眼睛望着北边。"
msgstr "把拂塵搭在臂彎裡，金色的那隻眼睛望著北邊。"

msgid "湖底的事了了，商玦没有回来。可北麓那座道观里还有人——坛上的火没有灭，他们管这叫续灯。"
msgstr "湖底的事了了，商玦沒有回來。可北麓那座道觀裡還有人——壇上的火沒有滅，他們管這叫續燈。"

msgid "茅山要一个了断。交给官府去剿，还是劝他们下山，交茅山看着。"
msgstr "茅山要一個了斷。交給官府去剿，還是勸他們下山，交茅山看著。"

#~ msgid "交官府去剿，问我「剿」；劝他们下山、交茅山看着，问我「招安」。正月十七之前，给我一个了断。"
#~ msgstr "交官府去剿，問我「剿」；勸他們下山、交茅山看著，問我「招安」。正月十七之前，給我一個了斷。"

msgid "湖上的事要紧。先去湖上。"
msgstr "湖上的事要緊。先去湖上。"

msgid "放下手里的拂尘，金色的那只眼睛看着你。"
msgstr "放下手裡的拂塵，金色的那隻眼睛看著你。"

msgid "钉子拔了，头在冰下醒了。他们等的那一夜，就是唤首：宫里倾巢下湖，商玦走在最前头。"
msgstr "釘子拔了，頭在冰下醒了。他們等的那一夜，就是喚首：宮裡傾巢下湖，商玦走在最前頭。"

msgid "你告诉我哪一夜、走哪条路，茅山的人就截在北麓下湖的路上——到了冰龙厅，他身边剩不下几个人。可那顶冠，从此就没用了。"
msgstr "你告訴我哪一夜、走哪條路，茅山的人就截在北麓下湖的路上——到了冰龍廳，他身邊剩不下幾個人。可那頂冠，從此就沒用了。"

msgid "或者你什么都不说。戴着冠跟他们下湖，站在他身后——第一剑，只有你递得出去。宫里要是已经起了疑心，这条路就走不得。"
msgstr "或者你什麼都不說。戴著冠跟他們下湖，站在他身後——第一劍，只有你遞得出去。宮裡要是已經起了疑心，這條路就走不得。"

msgid "倒戈，还是潜伏，你定。"
msgstr "倒戈，還是潛伏，你定。"

msgid "宫里的事快到头了。他们在等一夜——钉子拔了，湖上的事近了，那一夜才会来。"
msgstr "宮裡的事快到頭了。他們在等一夜——釘子拔了，湖上的事近了，那一夜才會來。"

msgid "到时候我要知道：哪一夜，走哪条路。"
msgstr "到時候我要知道：哪一夜，走哪條路。"

msgid "人放出去了。茅山的人在北麓底下接着，送他们各回各家。"
msgstr "人放出去了。茅山的人在北麓底下接著，送他們各回各家。"

msgid "宫里的事还没完——你戴着那顶冠，就还是他们的人。等我的话。"
msgstr "宮裡的事還沒完——你戴著那頂冠，就還是他們的人。等我的話。"

msgid "地牢里那三个人。钥匙在狱卒腰上——那人好酒，子时就歪在长凳上睡。开了门，人自己会走。"
msgstr "地牢裡那三個人。鑰匙在獄卒腰上——那人好酒，子時就歪在長凳上睡。開了門，人自己會走。"

msgid "把名单折好，压在香炉底下。"
msgstr "把名單摺好，壓在香爐底下。"

msgid "茅山截下了一车。可上一车已经上了山——地牢里新关了三个人。"
msgstr "茅山截下了一車。可上一車已經上了山——地牢裡新關了三個人。"

msgid "放他们出来。钥匙在狱卒腰上；那人好酒，子时就歪在石阶边的长凳上睡。开了门，人自己会走：货栈的侧门，夜里没人看。"
msgstr "放他們出來。鑰匙在獄卒腰上；那人好酒，子時就歪在石階邊的長凳上睡。開了門，人自己會走：貨棧的側門，夜裡沒人看。"

msgid "还有一样。账房案角那只铁匣，锁和牢门是一套。里头是名册的原本——人是谁送上山的，押的谁的印，都在上面。"
msgstr "還有一樣。賬房案角那隻鐵匣，鎖和牢門是一套。裡頭是名冊的原本——人是誰送上山的，押的誰的印，都在上面。"

msgid "带不带出来，你定。带出来，是一样物证；宫里也就少了一样东西。"
msgstr "帶不帶出來，你定。帶出來，是一樣物證；宮裡也就少了一樣東西。"

msgid "名单抄到了？给我。"
msgstr "名單抄到了？給我。"

msgid "看了你一眼，没有说话。"
msgstr "看了你一眼，沒有說話。"

msgid "禁书回了宫里，是你送回去的。……也罢。他当你是自己人，门你进得去。"
msgstr "禁書回了宮裡，是你送回去的。……也罷。他當你是自己人，門你進得去。"

msgid "进去，干活，听。他们在等什么，要多少人，人从哪里来。"
msgstr "進去，幹活，聽。他們在等什麼，要多少人，人從哪裡來。"

msgid "进去，先干活。管事派什么，你干什么；他们说什么，你听什么。"
msgstr "進去，先幹活。管事派什麼，你幹什麼；他們說什麼，你聽什麼。"

msgid "野羊山北麓那座黑砖道观，茅山盯了它两年。我要一个进得去的人，戴着他们的冠替我看、替我听。"
msgstr "野羊山北麓那座黑磚道觀，茅山盯了它兩年。我要一個進得去的人，戴著他們的冠替我看、替我聽。"

msgid "可你身上有东方神教的令。一个人只藏得住一重身份——这件事，我不能托你。"
msgstr "可你身上有東方神教的令。一個人只藏得住一重身份——這件事，我不能託你。"

msgid "野羊山北麓那座黑砖道观，茅山盯了它两年。他们拜的不是神，是劫；收的不是香火，是人。"
msgstr "野羊山北麓那座黑磚道觀，茅山盯了它兩年。他們拜的不是神，是劫；收的不是香火，是人。"

msgid "你进去过，还出来了。茅山的道士进不去——一身符水的味道，隔着三里地，他们就闻得出来。"
msgstr "你進去過，還出來了。茅山的道士進不去——一身符水的味道，隔著三里地，他們就聞得出來。"

msgid "我要一个进得去的人：戴着他们的冠，替我看，替我听。他们在等什么，要多少人，人从哪里来。"
msgstr "我要一個進得去的人：戴著他們的冠，替我看，替我聽。他們在等什麼，要多少人，人從哪裡來。"

msgid "这件事做了，就脱不了身。想好了，再问我「眼线」。"
msgstr "這件事做了，就脫不了身。想好了，再問我「眼線」。"

msgid "北麓那座道观？与你无关。"
msgstr "北麓那座道觀？與你無關。"

msgid "眼线"
msgstr "眼線"

msgid "答应下来，戴着黑冠回逆灵宫，做茅山的眼线。\n一个人只藏得住一重身份：接了这件事，东方神教那边的门，从此不再为你开。\n答应吗？"
msgstr "答應下來，戴著黑冠回逆靈宮，做茅山的眼線。\n一個人只藏得住一重身份：接了這件事，東方神教那邊的門，從此不再為你開。\n答應嗎？"

msgid "你已经答应过了。冠戴好。"
msgstr "你已經答應過了。冠戴好。"

msgid "金色的那只眼睛看了你很久。"
msgstr "金色的那隻眼睛看了你很久。"

msgid "你身上有东方神教的令。茅山不用替两家办事的眼线——不是信不过你，是信不过那块令。"
msgstr "你身上有東方神教的令。茅山不用替兩家辦事的眼線——不是信不過你，是信不過那塊令。"

msgid "好。"
msgstr "好。"

msgid "那一夜地牢里的人是你放走的。宫里记得那一夜——他们不知道是你，只知道有人。"
msgstr "那一夜地牢裡的人是你放走的。宮裡記得那一夜——他們不知道是你，只知道有人。"

msgid "戴着冠回去，管事会派你活。冠丢了，问我「黑冠」。"
msgstr "戴著冠回去，管事會派你活。冠丟了，問我「黑冠」。"

msgid "你身上那卷东西，是逆灵天书的残卷。拿着它的人死在后山了。它不能跟着你进去，也不能就这么留在外头。"
msgstr "你身上那卷東西，是逆靈天書的殘卷。拿著它的人死在後山了。它不能跟著你進去，也不能就這麼留在外頭。"

msgid "交给我，我当面烧了它。宫里会少一卷书，迟早有人问起——这就是你要担的。"
msgstr "交給我，我當面燒了它。宮裡會少一卷書，遲早有人問起——這就是你要擔的。"

msgid "你身上那卷东西，是逆灵天书的残卷。它不能跟着你进去，也不能就这么留在外头。"
msgstr "你身上那卷東西，是逆靈天書的殘卷。它不能跟著你進去，也不能就這麼留在外頭。"

msgid "交给我，我当面烧了它——可宫里会少一卷书，迟早有人问起。还给后山那个大弟子，他会当你是他的人——禁书也就回了宫里。"
msgstr "交給我，我當面燒了它——可宮裡會少一卷書，遲早有人問起。還給後山那個大弟子，他會當你是他的人——禁書也就回了宮裡。"

msgid "你定。"
msgstr "你定。"

msgid "那卷残卷不在你身上？……那就当它没回宫。宫里少了一卷书，迟早有人问起。"
msgstr "那卷殘卷不在你身上？……那就當它沒回宮。宮裡少了一卷書，遲早有人問起。"

msgid "……先听我把话说完。"
msgstr "……先聽我把話說完。"

msgid "黑冠"
msgstr "黑冠"

msgid "从香案底下取出一顶黑冠，递给你。"
msgstr "從香案底下取出一頂黑冠，遞給你。"

msgid "上个月茅山弟子在北麓截下来的。冠是真的，戴它的人回不来了。"
msgstr "上個月茅山弟子在北麓截下來的。冠是真的，戴它的人回不來了。"

msgid "冠在你身上。戴好，别摘——摘了，他们下一眼就认得你。"
msgstr "冠在你身上。戴好，別摘——摘了，他們下一眼就認得你。"

msgid "逆灵宫的道士戴的东西。问它做什么。"
msgstr "逆靈宮的道士戴的東西。問它做什麼。"

msgid "倒戈"
msgstr "倒戈"

msgid "前夜倒戈：把逆灵宫下湖的时辰和路交给茅山。\n终章冰龙厅里，商玦身边只剩两个道士；点将时多一拨茅山的人，林忌在湖畔。\n可黑冠从此没用，逆灵宫的门不再为你开。\n就这样吗？"
msgstr "前夜倒戈：把逆靈宮下湖的時辰和路交給茅山。\n終章冰龍廳裡，商玦身邊只剩兩個道士；點將時多一撥茅山的人，林忌在湖畔。\n可黑冠從此沒用，逆靈宮的門不再為你開。\n就這樣嗎？"

msgid "时辰和路，茅山记下了。"
msgstr "時辰和路，茅山記下了。"

msgid "你已经定了潜伏。冠戴好。"
msgstr "你已經定了潛伏。冠戴好。"

msgid "他们迟早认出你。时辰和路，茅山自己去找。"
msgstr "他們遲早認出你。時辰和路，茅山自己去找。"

msgid "湖上的事已经开始了，来不及了。"
msgstr "湖上的事已經開始了，來不及了。"

msgid "听你一字一句说完，把那条路在香案上用指头画了一遍。"
msgstr "聽你一字一句說完，把那條路在香案上用指頭畫了一遍。"

msgid "好。那一夜，北麓下湖的路上有茅山的人。"
msgstr "好。那一夜，北麓下湖的路上有茅山的人。"

msgid "冠可以摘了。他们很快就会知道，是谁说出去的。"
msgstr "冠可以摘了。他們很快就會知道，是誰說出去的。"

msgid "什么时辰？宫里还没到那一步。"
msgstr "什麼時辰？宮裡還沒到那一步。"

msgid "潜伏"
msgstr "潛伏"

msgid "潜伏到底：什么也不交出去，戴着黑冠跟商玦的队伍下湖。\n冰龙厅里第一剑是你的，商玦带着重伤开打——可他的四个道士会先扑你，也没有人会多来帮你（没人知道你的消息）。\n宫里已经满了三条疑点的，走不了这条路。\n就这样吗？"
msgstr "潛伏到底：什麼也不交出去，戴著黑冠跟商玦的隊伍下湖。\n冰龍廳裡第一劍是你的，商玦帶著重傷開打——可他的四個道士會先撲你，也沒有人會多來幫你（沒人知道你的消息）。\n宮裡已經滿了三條疑點的，走不了這條路。\n就這樣嗎？"

msgid "你已经定了。冠戴好——那一剑，只有你递得出去。"
msgstr "你已經定了。冠戴好——那一劍，只有你遞得出去。"

msgid "时辰和路已经交出去了。那顶冠，没用了。"
msgstr "時辰和路已經交出去了。那頂冠，沒用了。"

msgid "宫里已经起了疑心。这条路，走不得了。"
msgstr "宮裡已經起了疑心。這條路，走不得了。"

msgid "……好。"
msgstr "……好。"

msgid "冠戴好，什么也别说。他回头的时候，站在他身后的是你。"
msgstr "冠戴好，什麼也別說。他回頭的時候，站在他身後的是你。"

msgid "潜伏到哪一天？宫里还没到那一步。"
msgstr "潛伏到哪一天？宮裡還沒到那一步。"

msgid "名册"
msgstr "名冊"

msgid "名册就留在铁匣里？\n宫里什么也不会少，他们看不出你；你身上也就少了一样物证。\n就这样吗？"
msgstr "名冊就留在鐵匣裡？\n宮裡什麼也不會少，他們看不出你；你身上也就少了一樣物證。\n就這樣嗎？"

msgid "名册在程不平那里。他会一个一个对出来——那是他的本事。"
msgstr "名冊在程不平那裡。他會一個一個對出來——那是他的本事。"

msgid "京师的事定了。名册交给乔阴的程不平——他对得出那些押印，给那些人家里一个说法。"
msgstr "京師的事定了。名冊交給喬陰的程不平——他對得出那些押印，給那些人家裡一個說法。"

msgid "兵部的印在上面。带它上京：朝上揭发兵部的时候，它是一样物证。"
msgstr "兵部的印在上面。帶它上京：朝上揭發兵部的時候，它是一樣物證。"

msgid "名册留在匣里了。宫里什么也没少——他们看不出你。"
msgstr "名冊留在匣裡了。宮裡什麼也沒少——他們看不出你。"

msgid "……也好。宫里什么也不会少，他们就看不出你。"
msgstr "……也好。宮裡什麼也不會少，他們就看不出你。"

msgid "那上面的押印，你说给我听，我记下了。"
msgstr "那上面的押印，你說給我聽，我記下了。"

msgid "什么名册？"
msgstr "什麼名冊？"

msgid "虹台上的事定了。茅山照旧降妖伏魔。"
msgstr "虹臺上的事定了。茅山照舊降妖伏魔。"

msgid "茅山这一票，你说了算。"
msgstr "茅山這一票，你說了算。"

msgid "茅山这一票投旧盟主。北麓剩下的人交茅山看着——是师弟的主意。茅山认得他们的字了。"
msgstr "茅山這一票投舊盟主。北麓剩下的人交茅山看著——是師弟的主意。茅山認得他們的字了。"

msgid "这一票的事，去藏经楼问他。"
msgstr "這一票的事，去藏經樓問他。"

msgid "茅山主剿。这一票原该投颜违——他和朝廷走得近，北麓那座道观，他剿得动。"
msgstr "茅山主剿。這一票原該投顏違——他和朝廷走得近，北麓那座道觀，他剿得動。"

msgid "金色的那只眼睛看着你。"
msgstr "金色的那隻眼睛看著你。"

msgid "可那函书是你带回山的，也是你看着烧的。茅山欠你一回：这一票，你要，就是你的。"
msgstr "可那函書是你帶回山的，也是你看著燒的。茅山欠你一回：這一票，你要，就是你的。"

msgid "可禁书是你交到我手里烧的。茅山欠你一回：这一票，你要，就是你的。"
msgstr "可禁書是你交到我手裡燒的。茅山欠你一回：這一票，你要，就是你的。"

msgid "可那张名单是你从账房抄出来的，名单上的人茅山找回了好几个。茅山欠你一回：这一票，你要，就是你的。"
msgstr "可那張名單是你從賬房抄出來的，名單上的人茅山找回了好幾個。茅山欠你一回：這一票，你要，就是你的。"

msgid "茅山主剿。颜违和朝廷走得近，北麓那座道观，他剿得动。"
msgstr "茅山主剿。顏違和朝廷走得近，北麓那座道觀，他剿得動。"

msgid "这一票投他。"
msgstr "這一票投他。"

msgid "请林忌把茅山这一票交给你：正月十七虹台上，茅山听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請林忌把茅山這一票交給你：正月十七虹臺上，茅山聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "说过了。茅山听你的。"
msgstr "說過了。茅山聽你的。"

msgid "这一票，去藏经楼问我师弟。"
msgstr "這一票，去藏經樓問我師弟。"

msgid "好。茅山听你的。"
msgstr "好。茅山聽你的。"

msgid "剿"
msgstr "剿"

#~ msgid "把北麓那座道观交给官府去剿：林忌把门户和上山的路写给程不平，官兵上山，宫里剩下的人一个也走不了。\n正月十七虹台上，这件事就算了了，不能再改。\n就这样吗？"
#~ msgstr "把北麓那座道觀交給官府去剿：林忌把門戶和上山的路寫給程不平，官兵上山，宮裡剩下的人一個也走不了。\n正月十七虹臺上，這件事就算了了，不能再改。\n就這樣嗎？"

msgid "官兵已经上了北麓。宫里剩下的人，一个也走不了。"
msgstr "官兵已經上了北麓。宮裡剩下的人，一個也走不了。"

msgid "人已经下山了，茅山看着。"
msgstr "人已經下山了，茅山看著。"

msgid "师弟已经上了北麓。他去劝，就让他劝完。"
msgstr "師弟已經上了北麓。他去勸，就讓他勸完。"

msgid "你已经答应去劝他们下山了。回北麓去，同宫里当家的说「下山」。"
msgstr "你已經答應去勸他們下山了。回北麓去，同宮裡當家的說「下山」。"

msgid "提笔写了一封信，把北麓那座道观的门户、上山的绳路一一画在信后。"
msgstr "提筆寫了一封信，把北麓那座道觀的門戶、上山的繩路一一畫在信後。"

msgid "这封信今晚就到乔阴，程不平会转给兵部。"
msgstr "這封信今晚就到喬陰，程不平會轉給兵部。"

#~ msgid "官兵上了北麓，宫里剩下的人一个也走不了。正月十七虹台上，这件事就算了了。"
#~ msgstr "官兵上了北麓，宮裡剩下的人一個也走不了。正月十七虹臺上，這件事就算了了。"

msgid "书烧了，他们的字茅山不认得了——那就不必认得。"
msgstr "書燒了，他們的字茅山不認得了——那就不必認得。"

msgid "这封信今晚就到乔阴，程不平会转给兵部。官兵上了北麓，宫里剩下的人一个也走不了。"
msgstr "這封信今晚就到喬陰，程不平會轉給兵部。官兵上了北麓，宮裡剩下的人一個也走不了。"

msgid "剿什么？"
msgstr "剿什麼？"

msgid "招安"
msgstr "招安"

#~ msgid "劝宫里剩下的人下山，交茅山看管：回北麓，同宫里当家的（玄冥子还在，就是他；不在了，就是领诵的道士）说「下山」——你一直戴着他们的冠，这一说，他们就知道你是谁的人了。\n正月十七虹台上，这件事就算了了，不能再改。\n就这样吗？"
#~ msgstr "勸宮裡剩下的人下山，交茅山看管：回北麓，同宮裡當家的（玄冥子還在，就是他；不在了，就是領誦的道士）說「下山」——你一直戴著他們的冠，這一說，他們就知道你是誰的人了。\n正月十七虹臺上，這件事就算了了，不能再改。\n就這樣嗎？"

msgid "官兵已经上了北麓。来不及了。"
msgstr "官兵已經上了北麓。來不及了。"

msgid "想了很久，点了点头。"
msgstr "想了很久，點了點頭。"

msgid "好。宫里剩下的，大半是被拐上山的孩子，烧了一辈子香，不知道自己烧的是什么。"
msgstr "好。宮裡剩下的，大半是被拐上山的孩子，燒了一輩子香，不知道自己燒的是什麼。"

msgid "回北麓去，同宫里当家的说「下山」——玄冥子还在，就是他；不在了，就是那个领诵的。你戴着他们的冠，他们会听你说完。"
msgstr "回北麓去，同宮裡當家的說「下山」——玄冥子還在，就是他；不在了，就是那個領誦的。你戴著他們的冠，他們會聽你說完。"

msgid "人带下山，茅山看着。"
msgstr "人帶下山，茅山看著。"

msgid "招安什么？"
msgstr "招安什麼？"

msgid "接过那函书，在香案前坐下，一页一页翻过去。"
msgstr "接過那函書，在香案前坐下，一頁一頁翻過去。"

msgid "翻到后半本，手停住了。"
msgstr "翻到後半本，手停住了。"

msgid "……这是逆灵宫的字。"
msgstr "……這是逆靈宮的字。"

msgid "他抄了两年。烧掉的东西，他一页一页抄回来。"
msgstr "他抄了兩年。燒掉的東西，他一頁一頁抄回來。"

msgid "合上书，望着殿门外，很久没有说话。"
msgstr "合上書，望著殿門外，很久沒有說話。"

msgid "书留在我这里。他会来的。"
msgstr "書留在我這裡。他會來的。"

msgid "把逆灵天书的残卷交给林忌。\n他会当面烧了它，禁书不会再回逆灵宫——可宫里少了一卷书，那是一条疑点。玄冥子那边，这卷书就还不回去了。\n交给他吗？"
msgstr "把逆靈天書的殘卷交給林忌。\n他會當面燒了它，禁書不會再回逆靈宮——可宮裡少了一卷書，那是一條疑點。玄冥子那邊，這卷書就還不回去了。\n交給他嗎？"

msgid "接过残卷，翻也没翻，凑到香案的烛火上。"
msgstr "接過殘卷，翻也沒翻，湊到香案的燭火上。"

msgid "黑皮的书页卷起来，火苗是青的。"
msgstr "黑皮的書頁捲起來，火苗是青的。"

msgid "这东西不该回那里去。"
msgstr "這東西不該回那裡去。"

msgid "这东西在你手里，在我手里，都干净不了。先想好你要做什么。"
msgstr "這東西在你手裡，在我手裡，都乾淨不了。先想好你要做什麼。"

msgid "接过名单，一行一行看下去，半晌没有说话。"
msgstr "接過名單，一行一行看下去，半晌沒有說話。"

msgid "三十六口。……茅山会去截下一车。"
msgstr "三十六口。……茅山會去截下一車。"

msgid "你回去。他们看不出来，你就还是他们的人。"
msgstr "你回去。他們看不出來，你就還是他們的人。"

msgid "贫道是出家人，不便收女徒，得罪了。"
msgstr "貧道是出家人，不便收女徒，得罪了。"

msgid "嗯... 想入我茅山派？也好...."
msgstr "嗯... 想入我茅山派？也好...."

msgid "慢著，一个一个来。"
msgstr "慢著，一個一個來。"

msgid "这是一位来自阴界的守护神，专门担任护法之责。\n"
msgstr "這是一位來自陰界的守護神，專門擔任護法之責。\n"

msgid "子阴鬼卒"
msgstr "子陰鬼卒"

msgid "丑阴鬼卒"
msgstr "丑陰鬼卒"

msgid "寅阴鬼卒"
msgstr "寅陰鬼卒"

msgid "卯阴鬼卒"
msgstr "卯陰鬼卒"

msgid "辰阴鬼卒"
msgstr "辰陰鬼卒"

msgid "巳阴鬼卒"
msgstr "巳陰鬼卒"

msgid "午阴鬼卒"
msgstr "午陰鬼卒"

msgid "未阴鬼卒"
msgstr "未陰鬼卒"

msgid "申阴鬼卒"
msgstr "申陰鬼卒"

msgid "酉阴鬼卒"
msgstr "酉陰鬼卒"

msgid "戌阴鬼卒"
msgstr "戌陰鬼卒"

msgid "亥阴鬼卒"
msgstr "亥陰鬼卒"

msgid "一道蓝光从地底升起，蓝光中出现一个手执钢叉、面目狰狞的鬼卒。"
msgstr "一道藍光從地底升起，藍光中出現一個手執鋼叉、面目猙獰的鬼卒。"

msgid "$N的身形发出幽暗的蓝光，沈入地下不见了。"
msgstr "$N的身形發出幽暗的藍光，沈入地下不見了。"

msgid "观想虫"
msgstr "觀想蟲"

msgid "这是一只由修道人的杂念绮思所化的观想虫，会缠住人的魂魄。\n"
msgstr "這是一隻由修道人的雜念綺思所化的觀想蟲，會纏住人的魂魄。\n"

msgid "身体"
msgstr "身體"

msgid "前脚"
msgstr "前腳"

msgid "後脚"
msgstr "後腳"

msgid "尾巴"
msgstr "尾巴"

msgid "你杀死了你的观想虫，并且从中悟到了一些咒术的道理。"
msgstr "你殺死了你的觀想蟲，並且從中悟到了一些咒術的道理。"

msgid "你的观想虫被人杀死了！"
msgstr "你的觀想蟲被人殺死了！"

msgid "你觉得一阵天旋地转...."
msgstr "你覺得一陣天旋地轉...."

msgid "观想兽"
msgstr "觀想獸"

msgid "这是一只由修道人的杂念绮思所化的观想兽，会缠住人的魂魄。\n"
msgstr "這是一隻由修道人的雜念綺思所化的觀想獸，會纏住人的魂魄。\n"

msgid "你杀死了你的观想兽，并且从中悟到了一些咒术的道理。"
msgstr "你殺死了你的觀想獸，並且從中悟到了一些咒術的道理。"

msgid "你的观想兽被人杀死了！"
msgstr "你的觀想獸被人殺死了！"

msgid "僵尸"
msgstr "殭屍"

msgid "这是一具被人用符咒控制的僵尸，从它苍白的脸上看不出任何喜怒哀乐。\n"
msgstr "這是一具被人用符咒控制的殭屍，從它蒼白的臉上看不出任何喜怒哀樂。\n"

msgid "{name}的僵尸"
msgstr "{name}的殭屍"

msgid "$N告诉你：我...需...要...你...的...力...量..."
msgstr "$N告訴你：我...需...要...你...的...力...量..."

msgid "$N缓缓地倒了下来，化为一滩血水。"
msgstr "$N緩緩地倒了下來，化為一灘血水。"

msgid "蓝止萍"
msgstr "藍止萍"

msgid "回音仙子"
msgstr "回音仙子"

msgid "晚月庄主"
msgstr "晚月莊主"

msgid "蓝止萍是一个十分出色的美女，她弹的一手琵琶更是闻名千里，许多\n王侯子弟，富商豪客都为她天下无双的美貌与琴艺倾倒。\n"
msgstr "藍止萍是一個十分出色的美女，她彈的一手琵琶更是聞名千里，許多\n王侯子弟，富商豪客都為她天下無雙的美貌與琴藝傾倒。\n"

msgid "庄主"
msgstr "莊主"

msgid "蓝止萍嫣然一笑，一个转身迳自舞了起来，对眼前这场恶斗似乎全不放在心上。\n"
msgstr "藍止萍嫣然一笑，一個轉身逕自舞了起來，對眼前這場惡鬥似乎全不放在心上。\n"

msgid "蓝止萍脚步轻移，翩翩地转了几个圈，回眸一笑。\n"
msgstr "藍止萍腳步輕移，翩翩地轉了幾個圈，回眸一笑。\n"

msgid "蓝止萍用手扶了扶自己的发簪，像是怕被对手碰歪似地。\n"
msgstr "藍止萍用手扶了扶自己的髮簪，像是怕被對手碰歪似地。\n"

msgid "蓝止萍笑嘻嘻地拾起地上一片从魔鞭翩珑上落下的花瓣。\n"
msgstr "藍止萍笑嘻嘻地拾起地上一片從魔鞭翩瓏上落下的花瓣。\n"

msgid "你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。"
msgstr "你覺得臉上似乎沾上了什麼東西，伸手一摸卻什麼也沒有。"

msgid "男人都不是好东西，滚开！"
msgstr "男人都不是好東西，滾開！"

msgid "很好，只要你对本庄主忠心耿耿，好处是少不了的。"
msgstr "很好，只要你對本莊主忠心耿耿，好處是少不了的。"

msgid "$N暧昧地抚摸著$n的脸，说道：特别是像你这样的女孩 ...."
msgstr "$N曖昧地撫摸著$n的臉，說道：特別是像你這樣的女孩 ...."

msgid "看了你一眼，没有笑。"
msgstr "看了你一眼，沒有笑。"

msgid "从内书房那边走过来，走得很慢。"
msgstr "從內書房那邊走過來，走得很慢。"

msgid "跟在她娘后面，面巾还蒙着，剑在鞘里，手离剑柄远远的。"
msgstr "跟在她娘後面，面巾還蒙著，劍在鞘裡，手離劍柄遠遠的。"

msgid "那一夜，前厅死了两个丫头，内厅死了昭蓉。晚月庄有晚月庄的规矩：血债，要有人抵。"
msgstr "那一夜，前廳死了兩個丫頭，內廳死了昭蓉。晚月莊有晚月莊的規矩：血債，要有人抵。"

msgid "神教的杀手，在我庄里住了三年。内书房、宝衣，她都看过了。晚月庄的规矩：神教的人进了这道门，不能就这么出去。"
msgstr "神教的殺手，在我莊裡住了三年。內書房、寶衣，她都看過了。晚月莊的規矩：神教的人進了這道門，不能就這麼出去。"

msgid "令牌你还给了神教——她是神教的人，你也认了。"
msgstr "令牌你還給了神教——她是神教的人，你也認了。"

msgid "把手里那块黑木令牌攥得更紧了。"
msgstr "把手裡那塊黑木令牌攥得更緊了。"

msgid "人交给我。晚月庄不杀不还手的人——可她不能再待在庄里。怎么处置，是庄里的事。"
msgstr "人交給我。晚月莊不殺不還手的人——可她不能再待在莊裡。怎麼處置，是莊裡的事。"

msgid "她是我女儿。"
msgstr "她是我女兒。"

msgid "依庄规，问我「庄规」；要带她回来，去内书房问老人家「女儿」。"
msgstr "依莊規，問我「莊規」；要帶她回來，去內書房問老人家「女兒」。"

msgid "转身往内书房走，她女儿跟在后面。"
msgstr "轉身往內書房走，她女兒跟在後面。"

msgid "庄规"
msgstr "莊規"

msgid "依庄规：人交给蓝止萍处置——台上不杀，可她不能再待在庄里。\n晚月庄这一票投颜违（逐神教）（已经入了虹台的席的，这一票不再跟着变）；老妇从此不再开口。本庄弟子晋阶执事。\n要这么说吗？"
msgstr "依莊規：人交給藍止萍處置——臺上不殺，可她不能再待在莊裡。\n晚月莊這一票投顏違（逐神教）（已經入了虹臺的席的，這一票不再跟著變）；老婦從此不再開口。本莊弟子晉階執事。\n要這麼說嗎？"

msgid "你不是晚月庄的人了。这是晚月庄的事。"
msgstr "你不是晚月莊的人了。這是晚月莊的事。"

msgid "庄规是庄规。"
msgstr "莊規是莊規。"

msgid "你替她选了。晚月庄记着。"
msgstr "你替她選了。晚月莊記著。"

msgid "抬了抬手，叫两个弟子去内书房。"
msgstr "抬了抬手，叫兩個弟子去內書房。"

msgid "带走。"
msgstr "帶走。"

msgid "庄规是我立的，也是为这样的夜立的。往后庄门关得早一些——神教的人，不会再进来第二回。"
msgstr "莊規是我立的，也是為這樣的夜立的。往後莊門關得早一些——神教的人，不會再進來第二回。"

msgid "庄规？问这个做什么。"
msgstr "莊規？問這個做什麼。"

msgid "护法"
msgstr "護法"

msgid "做晚月庄的护法：不是弟子，不授辈分，本门的舞和指法不传；头衔换成「晚月庄护法」（本门再晋阶时换回本门的）。晚月庄的事，从此算你一份。\n要这么说吗？"
msgstr "做晚月莊的護法：不是弟子，不授輩分，本門的舞和指法不傳；頭銜換成「晚月莊護法」（本門再晉階時換回本門的）。晚月莊的事，從此算你一份。\n要這麼說嗎？"

msgid "你是晚月庄的护法。庄里的事，问我「庄里的事」。"
msgstr "你是晚月莊的護法。莊裡的事，問我「莊裡的事」。"

msgid "你是本庄的弟子。护法，是给庄外的人做的。"
msgstr "你是本莊的弟子。護法，是給莊外的人做的。"

msgid "晚月庄护法"
msgstr "晚月莊護法"

msgid "上上下下打量了你一眼。"
msgstr "上上下下打量了你一眼。"

msgid "男人都不是好东西。"
msgstr "男人都不是好東西。"

msgid "可你接住了瑷伦三鞭——她几百年没对男人抽过鞭子。宝衣的事，你也看着它有了着落。"
msgstr "可你接住了璦倫三鞭——她幾百年沒對男人抽過鞭子。寶衣的事，你也看著它有了著落。"

msgid "晚月庄不收男徒，这规矩不改。护法不是弟子：没有辈分，本庄的舞和指法也不传你。庄里的事，算你一份。"
msgstr "晚月莊不收男徒，這規矩不改。護法不是弟子：沒有輩分，本莊的舞和指法也不傳你。莊裡的事，算你一份。"

msgid "你离了晚月庄的门。护法，也就不必了。"
msgstr "你離了晚月莊的門。護法，也就不必了。"

msgid "看了你一会儿。"
msgstr "看了你一會兒。"

msgid "你接住了瑷伦三鞭，宝衣的事也看着它有了着落。"
msgstr "你接住了璦倫三鞭，寶衣的事也看著它有了著落。"

msgid "你不在晚月庄门下，晚月庄不抢人。做个护法吧：没有辈分，本庄的功夫不传；庄里的事，算你一份。"
msgstr "你不在晚月莊門下，晚月莊不搶人。做個護法吧：沒有輩分，本莊的功夫不傳；莊裡的事，算你一份。"

msgid "护法？接得住瑷伦三鞭再说。"
msgstr "護法？接得住璦倫三鞭再說。"

msgid "庄里的事"
msgstr "莊裡的事"

msgid "你已经不是晚月庄的人了。庄里的事，不劳你。"
msgstr "你已經不是晚月莊的人了。莊裡的事，不勞你。"

msgid "内书房那位老人家……让她静一静。"
msgstr "內書房那位老人家……讓她靜一靜。"

msgid "她在内书房。庄规你替她破了一回——晚月庄记着。"
msgstr "她在內書房。莊規你替她破了一回——晚月莊記著。"

msgid "那个蒙面的女人，你见过了，令牌也有了着落。下回进大厅，我有话说。"
msgstr "那個蒙面的女人，你見過了，令牌也有了著落。下回進大廳，我有話說。"

msgid "她的令牌在你手上？给谁，你自己定。"
msgstr "她的令牌在你手上？給誰，你自己定。"

msgid "老人家的心事……去问问那个蒙面的女人。"
msgstr "老人家的心事……去問問那個蒙面的女人。"

msgid "沧海龙吟跳回来了。宝衣……挡在了该挡的地方。"
msgstr "滄海龍吟跳回來了。寶衣……擋在了該擋的地方。"

msgid "内书房那位老人家，有一桩心事压了很多年——你去看看她。"
msgstr "內書房那位老人家，有一樁心事壓了很多年——你去看看她。"

msgid "宝衣回来了，池边的凤凰又亮了。晚月庄记你这一回。"
msgstr "寶衣回來了，池邊的鳳凰又亮了。晚月莊記你這一回。"

msgid "宝衣你带着。晚月庄自己守。"
msgstr "寶衣你帶著。晚月莊自己守。"

msgid "脸色淡了下来。"
msgstr "臉色淡了下來。"

msgid "沧海龙吟跳回来了，宝衣却在西厢那位手里。"
msgstr "滄海龍吟跳回來了，寶衣卻在西廂那位手裡。"

msgid "你去跟她要——她不会给。可晚月庄要让她知道，这件衣是谁的。"
msgstr "你去跟她要——她不會給。可晚月莊要讓她知道，這件衣是誰的。"

msgid "沧海龙吟跳回来了，区冥记得你。宝衣在瑷伦身上，庄里一切如旧。"
msgstr "滄海龍吟跳回來了，區冥記得你。寶衣在璦倫身上，莊裡一切如舊。"

msgid "沧海龙吟跳回来了，区冥记得你。宝衣还在你身上——东厢的瑷伦，等你一句话。"
msgstr "滄海龍吟跳回來了，區冥記得你。寶衣還在你身上——東廂的璦倫，等你一句話。"

msgid "沧海龙吟跳回来了，区冥记得你。宝衣的事，等它有了着落，你去东厢见瑷伦。"
msgstr "滄海龍吟跳回來了，區冥記得你。寶衣的事，等它有了著落，你去東廂見璦倫。"

msgid "步子在后院书房那幅湘绣图上，曲子在舞曲谱里。两样凑齐，去二楼佛堂，在区冥的神位前跳。"
msgstr "步子在後院書房那幅湘繡圖上，曲子在舞曲譜裡。兩樣湊齊，去二樓佛堂，在區冥的神位前跳。"

msgid "我们晚月庄是『以舞会友，以神换技』。可庄里失传过一支舞，叫沧海龙吟——寒谷龙舞里的一支，几十年没人跳过了。"
msgstr "我們晚月莊是『以舞會友，以神換技』。可莊裡失傳過一支舞，叫滄海龍吟——寒谷龍舞裡的一支，幾十年沒人跳過了。"

msgid "步子绣在后院书房那幅湘绣舞曲图上，昭仪天天对着它看；曲子在舞曲谱里，欣芳知道谱放在哪。"
msgstr "步子繡在後院書房那幅湘繡舞曲圖上，昭儀天天對著它看；曲子在舞曲譜裡，欣芳知道譜放在哪。"

msgid "两样凑齐了，到二楼佛堂，在区冥的神位前跳一回。跳成了，你就是晚月庄的大弟子。"
msgstr "兩樣湊齊了，到二樓佛堂，在區冥的神位前跳一回。跳成了，你就是晚月莊的大弟子。"

msgid "两样凑齐了，到二楼佛堂，在区冥的神位前跳一回。你是护法，跳成了也没有辈分——可区冥会记得你。"
msgstr "兩樣湊齊了，到二樓佛堂，在區冥的神位前跳一回。你是護法，跳成了也沒有輩分——可區冥會記得你。"

msgid "两样凑齐了，到二楼佛堂，在区冥的神位前跳一回。那是玄天玉女的步子，男人跳不成——请芳绫或者欣芳替你跳。"
msgstr "兩樣湊齊了，到二樓佛堂，在區冥的神位前跳一回。那是玄天玉女的步子，男人跳不成——請芳綾或者欣芳替你跳。"

msgid "晚月庄的事，不劳外人。"
msgstr "晚月莊的事，不勞外人。"

msgid "虹台上的事，晚月庄记着。"
msgstr "虹臺上的事，晚月莊記著。"

msgid "晚月庄这一票投颜违。神教的人进过庄门，往后庄门要关紧——颜违说了，他当了盟主就逐神教。"
msgstr "晚月莊這一票投顏違。神教的人進過莊門，往後莊門要關緊——顏違說了，他當了盟主就逐神教。"

msgid "这条庄规，是你陪我守下来的。这一票你要，就给你。"
msgstr "這條莊規，是你陪我守下來的。這一票你要，就給你。"

msgid "晚月庄这一票投旧盟主。庄里收着一个神教的人——官府管不到这里，颜违也别想管到这里来。"
msgstr "晚月莊這一票投舊盟主。莊裡收著一個神教的人——官府管不到這裡，顏違也別想管到這裡來。"

msgid "庄规你替她破了一回。……这一票你要，我也给。"
msgstr "莊規你替她破了一回。……這一票你要，我也給。"

msgid "晚月庄这一票，你说了算。"
msgstr "晚月莊這一票，你說了算。"

msgid "晚月庄这一票投颜违。说定了。"
msgstr "晚月莊這一票投顏違。說定了。"

msgid "寒於宝衣烧了。晚月庄守了几百年的东西，挡完那一口就没了。"
msgstr "寒於寶衣燒了。晚月莊守了幾百年的東西，擋完那一口就沒了。"

msgid "晚月庄这一票原该投旧盟主：封地照旧，官府管不到这里。可神教的人还在庄外转——颜违说了，他当了盟主就逐神教。"
msgstr "晚月莊這一票原該投舊盟主：封地照舊，官府管不到這裡。可神教的人還在莊外轉——顏違說了，他當了盟主就逐神教。"

msgid "你一句话，晚月庄这一票就投他。"
msgstr "你一句話，晚月莊這一票就投他。"

msgid "宝衣在西厢那位手里。神教迟早要拿它做文章。"
msgstr "寶衣在西廂那位手裡。神教遲早要拿它做文章。"

msgid "晚月庄这一票原该投旧盟主……颜违说了，他当了盟主就逐神教。你一句话，这一票就投他。"
msgstr "晚月莊這一票原該投舊盟主……顏違說了，他當了盟主就逐神教。你一句話，這一票就投他。"

msgid "宝衣在瑷伦手里——出过一回庄，是你送回来的。"
msgstr "寶衣在璦倫手裡——出過一回莊，是你送回來的。"

msgid "晚月庄这一票原该投旧盟主。你要，就给你。"
msgstr "晚月莊這一票原該投舊盟主。你要，就給你。"

msgid "宝衣还在瑷伦手里。是你替晚月庄守住的。"
msgstr "寶衣還在璦倫手裡。是你替晚月莊守住的。"

msgid "晚月庄这一票投旧盟主。"
msgstr "晚月莊這一票投舊盟主。"

msgid "封地照旧，官府管不到晚月庄——这就够了。"
msgstr "封地照舊，官府管不到晚月莊——這就夠了。"

msgid "改投"
msgstr "改投"

msgid "请蓝止萍改投颜违：他当了盟主就逐神教，晚月庄这一票不投旧盟主了。\n要这么说吗？"
msgstr "請藍止萍改投顏違：他當了盟主就逐神教，晚月莊這一票不投舊盟主了。\n要這麼說嗎？"

msgid "晚月庄这一票跟着庄规走，不改。"
msgstr "晚月莊這一票跟著莊規走，不改。"

msgid "晚月庄这一票，那天她留下来就定了，不改。"
msgstr "晚月莊這一票，那天她留下來就定了，不改。"

msgid "说过了。晚月庄投颜违。"
msgstr "說過了。晚月莊投顏違。"

msgid "好。晚月庄投颜违。"
msgstr "好。晚月莊投顏違。"

msgid "请蓝止萍把晚月庄这一票交给你：正月十七虹台上，晚月庄听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請藍止萍把晚月莊這一票交給你：正月十七虹臺上，晚月莊聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "说过了。晚月庄听你的。"
msgstr "說過了。晚月莊聽你的。"

msgid "微微一笑。"
msgstr "微微一笑。"

msgid "好。晚月庄听你的。"
msgstr "好。晚月莊聽你的。"

msgid "玄智和尚"
msgstr "玄智和尚"

msgid "住持"
msgstr "住持"

msgid "阿弥陀佛！出家人戒逞强恶斗！老衲不敢违反清规。"
msgstr "阿彌陀佛！出家人戒逞強惡鬥！老衲不敢違反清規。"

msgid "施主既然身负绝艺，老衲佩服便是，也不必较量了。"
msgstr "施主既然身負絕藝，老衲佩服便是，也不必較量了。"

msgid "剃度"
msgstr "剃度"

msgid "阿弥陀佛！你我同是出家人，何故跟老衲开这等玩笑？\n"
msgstr "阿彌陀佛！你我同是出家人，何故跟老衲開這等玩笑？\n"

msgid "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n"
msgstr "阿彌陀佛！女施主，這裡是寺廟，請你到尼庵去剃度吧。\n"

msgid "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下受戒。\n"
msgstr "阿彌陀佛！善哉！善哉！施主若真心皈依我佛，請跪下受戒。\n"

msgid "出家"
msgstr "出家"

msgid "看了你一眼，双手合十。"
msgstr "看了你一眼，雙手合十。"

msgid "阿弥陀佛。施主身上有神教的血腥气。流云轩的事，不劳施主。"
msgstr "阿彌陀佛。施主身上有神教的血腥氣。流雲軒的事，不勞施主。"

msgid "阿弥陀佛。流云轩的事，不劳施主了。"
msgstr "阿彌陀佛。流雲軒的事，不勞施主了。"

msgid "那樵夫的命，保住了。"
msgstr "那樵夫的命，保住了。"

msgid "低头看着自己的手。"
msgstr "低頭看著自己的手。"

msgid "那只手……老衲尽力了。"
msgstr "那隻手……老衲盡力了。"

msgid "那樵夫好了。药僧都跟老衲说了。"
msgstr "那樵夫好了。藥僧都跟老衲說了。"

msgid "寺规，施主破了。阿弥陀佛。"
msgstr "寺規，施主破了。阿彌陀佛。"

msgid "药喂下去了，寒气还在。"
msgstr "藥餵下去了，寒氣還在。"

msgid "老衲的药是凉性的底子……赶不出这股寒。阿弥陀佛。"
msgstr "老衲的藥是涼性的底子……趕不出這股寒。阿彌陀佛。"

msgid "药煎好了，拿去喂他。"
msgstr "藥煎好了，拿去餵他。"

msgid "附子在药圃，麝香找雪亭的杨掌柜，鬼臼在乔阴树王坟边。三味齐了交给药僧煎。"
msgstr "附子在藥圃，麝香找雪亭的楊掌櫃，鬼臼在喬陰樹王墳邊。三味齊了交給藥僧煎。"

msgid "乔阴来的樵夫，在树王坟边被鬼卒抓了一把。那不是寻常的伤——是阴间的寒气，钻进骨头里了。"
msgstr "喬陰來的樵夫，在樹王墳邊被鬼卒抓了一把。那不是尋常的傷——是陰間的寒氣，鑽進骨頭裡了。"

msgid "捻了很久的念珠。"
msgstr "捻了很久的念珠。"

msgid "老衲开个方子：附子回阳，麝香开窍，再要一味鬼臼，以毒攻毒。"
msgstr "老衲開個方子：附子回陽，麝香開竅，再要一味鬼臼，以毒攻毒。"

msgid "附子，寺东的药圃里有；麝香，雪亭镇桑邻药铺的杨掌柜那里有——他年轻时跟老衲学过医；鬼臼，就长在乔阴树王坟边的石缝里。那里有鬼卒，小心。"
msgstr "附子，寺東的藥圃裡有；麝香，雪亭鎮桑鄰藥鋪的楊掌櫃那裡有——他年輕時跟老衲學過醫；鬼臼，就長在喬陰樹王墳邊的石縫裡。那裡有鬼卒，小心。"

msgid "三味齐了，交给流云轩的药僧煎。"
msgstr "三味齊了，交給流雲軒的藥僧煎。"

msgid "阿弥陀佛。药僧说，施主肯帮流云轩的忙。帮手不必落发。"
msgstr "阿彌陀佛。藥僧說，施主肯幫流雲軒的忙。幫手不必落髮。"

msgid "流云轩里躺着一个乔阴来的樵夫。阿弥陀佛。"
msgstr "流雲軒裡躺著一個喬陰來的樵夫。阿彌陀佛。"

msgid "流云轩是老衲为人看病、存放药草的地方。"
msgstr "流雲軒是老衲為人看病、存放藥草的地方。"

msgid "头陀"
msgstr "頭陀"

msgid "他在流云轩。"
msgstr "他在流雲軒。"

msgid "捻了一颗念珠。"
msgstr "捻了一顆念珠。"

msgid "老衲该早十年开那道门。"
msgstr "老衲該早十年開那道門。"

msgid "他回番坊去了。金门外空了。……阿弥陀佛。"
msgstr "他回番坊去了。金門外空了。……阿彌陀佛。"

msgid "他在殿上。老衲看见了。"
msgstr "他在殿上。老衲看見了。"

msgid "他回金门外站着去了。十年了，他一直站在那里。"
msgstr "他回金門外站著去了。十年了，他一直站在那裡。"

msgid "他进了流云轩。……老衲知道。"
msgstr "他進了流雲軒。……老衲知道。"

msgid "拨了两颗念珠，没有再说。"
msgstr "撥了兩顆念珠，沒有再說。"

msgid "他不是本寺的人。"
msgstr "他不是本寺的人。"

msgid "十年前他到山门前来，老衲没让他进门。他也不走，就站在金门外，一站十年。"
msgstr "十年前他到山門前來，老衲沒讓他進門。他也不走，就站在金門外，一站十年。"

msgid "本寺的规矩：外人不进流云轩。"
msgstr "本寺的規矩：外人不進流雲軒。"

msgid "寺规"
msgstr "寺規"

msgid "照寺规：不让独眼头陀进流云轩。\n玄智守着老葛治：命保得住，一只手保不住。头陀转身回金门外，从此不理你。\n这是山烟寺这条线上的一个选择，选了不能改。要照寺规吗？"
msgstr "照寺規：不讓獨眼頭陀進流雲軒。\n玄智守著老葛治：命保得住，一隻手保不住。頭陀轉身回金門外，從此不理你。\n這是山煙寺這條線上的一個選擇，選了不能改。要照寺規嗎？"

msgid "阿弥陀佛。"
msgstr "阿彌陀佛。"

msgid "寺规就是寺规。"
msgstr "寺規就是寺規。"

msgid "寺规，施主已经破了。"
msgstr "寺規，施主已經破了。"

msgid "看了看你身后。"
msgstr "看了看你身後。"

msgid "人是施主领来的，老衲不拦。"
msgstr "人是施主領來的，老衲不攔。"

msgid "双手合十。"
msgstr "雙手合十。"

msgid "阿弥陀佛。外人不进流云轩——这是本寺三百年的规矩，老衲不能在老衲手里破了它。"
msgstr "阿彌陀佛。外人不進流雲軒——這是本寺三百年的規矩，老衲不能在老衲手裡破了它。"

msgid "那樵夫，老衲自己守。"
msgstr "那樵夫，老衲自己守。"

msgid "玄智方丈进了流云轩，三天三夜没有出来。\n"
msgstr "玄智方丈進了流雲軒，三天三夜沒有出來。\n"

msgid "命，老衲保住了。那只手……寒气在骨头里待得太久，老衲保不住。"
msgstr "命，老衲保住了。那隻手……寒氣在骨頭裡待得太久，老衲保不住。"

msgid "寺规？本寺的规矩，问知客僧。"
msgstr "寺規？本寺的規矩，問知客僧。"

msgid "阿弥陀佛。正月十七，过去了。"
msgstr "阿彌陀佛。正月十七，過去了。"

msgid "阿弥陀佛。山烟寺这一票，在施主手里。"
msgstr "阿彌陀佛。山煙寺這一票，在施主手裡。"

msgid "阿弥陀佛。山烟寺收了西来的经。容得下西来的经，也容得下别人——这一票投旧盟主。"
msgstr "阿彌陀佛。山煙寺收了西來的經。容得下西來的經，也容得下別人——這一票投舊盟主。"

msgid "朝流云轩的方向看了一眼。"
msgstr "朝流雲軒的方向看了一眼。"

msgid "那片叶子是施主带回来的。这一票，施主要，就是施主的。"
msgstr "那片葉子是施主帶回來的。這一票，施主要，就是施主的。"

msgid "阿弥陀佛。本寺一脉，守清规。神教的杀手横行，颜施主说要逐了他们——山烟寺这一票投颜施主。"
msgstr "阿彌陀佛。本寺一脈，守清規。神教的殺手橫行，顏施主說要逐了他們——山煙寺這一票投顏施主。"

msgid "拨了两颗念珠。"
msgstr "撥了兩顆念珠。"

msgid "可那片叶子，是施主陪着送回去的。这一票，施主要，就是施主的。"
msgstr "可那片葉子，是施主陪著送回去的。這一票，施主要，就是施主的。"

msgid "阿弥陀佛。山烟寺这一票，投旧盟主。"
msgstr "阿彌陀佛。山煙寺這一票，投舊盟主。"

msgid "阿弥陀佛。神教的杀手杀生无数，山烟寺原想借颜施主之手，逐了他们。"
msgstr "阿彌陀佛。神教的殺手殺生無數，山煙寺原想借顏施主之手，逐了他們。"

msgid "施主说，一代教主收回了教主令，正月十七神教不来搅局……施主若担保此事，山烟寺这一票便投旧盟主。容他们。"
msgstr "施主說，一代教主收回了教主令，正月十七神教不來攪局……施主若擔保此事，山煙寺這一票便投舊盟主。容他們。"

msgid "阿弥陀佛。神教的杀手在江湖上横行，颜施主说要逐了他们。"
msgstr "阿彌陀佛。神教的殺手在江湖上橫行，顏施主說要逐了他們。"

msgid "山烟寺这一票，投颜施主。"
msgstr "山煙寺這一票，投顏施主。"

msgid "阿弥陀佛。湖上的事未了，虹台的事且放一放。"
msgstr "阿彌陀佛。湖上的事未了，虹臺的事且放一放。"

msgid "请玄智和尚改投旧盟主：神教容得下，山烟寺这一票不投颜违了。\n要这么说吗？"
msgstr "請玄智和尚改投舊盟主：神教容得下，山煙寺這一票不投顏違了。\n要這麼說嗎？"

msgid "阿弥陀佛。经收下了，山烟寺本来就投旧盟主。"
msgstr "阿彌陀佛。經收下了，山煙寺本來就投舊盟主。"

msgid "阿弥陀佛。本寺一脉，说过了。这一票随守寺走。"
msgstr "阿彌陀佛。本寺一脈，說過了。這一票隨守寺走。"

msgid "阿弥陀佛。山烟寺投旧盟主，说过了。"
msgstr "阿彌陀佛。山煙寺投舊盟主，說過了。"

msgid "阿弥陀佛。便依施主。"
msgstr "阿彌陀佛。便依施主。"

msgid "收经"
msgstr "收經"

msgid "收经：独眼头陀受戒入寺，婆萝蜜多心经收进山烟寺。\n流云轩从此治得了鬼卒的寒；头陀在流云轩教婆萝蜜多心经，谁都能学（只这一门）。\n容得下西来的经，也容得下别人：正月十七虹台上，山烟寺这一票投旧盟主（已经入了虹台的席的，这一票不再跟着变）。\n守寺那条路就没了。要这么说吗？"
msgstr "收經：獨眼頭陀受戒入寺，婆蘿蜜多心經收進山煙寺。\n流雲軒從此治得了鬼卒的寒；頭陀在流雲軒教婆蘿蜜多心經，誰都能學（只這一門）。\n容得下西來的經，也容得下別人：正月十七虹臺上，山煙寺這一票投舊盟主（已經入了虹臺的席的，這一票不再跟著變）。\n守寺那條路就沒了。要這麼說嗎？"

msgid "阿弥陀佛。这是本寺的事。"
msgstr "阿彌陀佛。這是本寺的事。"

msgid "经在流云轩，他也在。"
msgstr "經在流雲軒，他也在。"

msgid "本寺一脉。说过了。"
msgstr "本寺一脈。說過了。"

msgid "看着香案上那片贝叶，捻了很久的念珠。"
msgstr "看著香案上那片貝葉，捻了很久的念珠。"

msgid "玄尘要是知道……他等这一天，等了三十年。"
msgstr "玄塵要是知道……他等這一天，等了三十年。"

msgid "收。"
msgstr "收。"

msgid "独眼头陀在佛前跪了下来。玄智伸出手掌，在他头顶轻轻地摩挲了几下。\n"
msgstr "獨眼頭陀在佛前跪了下來。玄智伸出手掌，在他頭頂輕輕地摩挲了幾下。\n"

msgid "你是头陀，发就留着。法名，你的师父给过了，老衲不改。从今天起，你是山烟寺的人。"
msgstr "你是頭陀，發就留著。法名，你的師父給過了，老衲不改。從今天起，你是山煙寺的人。"

msgid "流云轩，你去。阴间的寒，往后山烟寺赶得出去了。"
msgstr "流雲軒，你去。陰間的寒，往後山煙寺趕得出去了。"

msgid "头陀捧起那片贝叶，朝玄智拜了三拜，大步往流云轩去了。\n"
msgstr "頭陀捧起那片貝葉，朝玄智拜了三拜，大步往流雲軒去了。\n"

msgid "收什么经？"
msgstr "收什麼經？"

msgid "守寺"
msgstr "守寺"

msgid "守寺：本寺一脉，经交还龙若法王，头陀把它带回番坊，金门外从此空了。\n玄智肯把莲华心法（连同它的根基大乘佛法）教给不是本寺的人。流云轩照旧治不了鬼卒的寒。\n山烟寺守清规：正月十七虹台上，这一票投颜违（已经入了虹台的席的，这一票不再跟着变）。\n收经那条路就没了。要这么说吗？"
msgstr "守寺：本寺一脈，經交還龍若法王，頭陀把它帶回番坊，金門外從此空了。\n玄智肯把蓮華心法（連同它的根基大乘佛法）教給不是本寺的人。流雲軒照舊治不了鬼卒的寒。\n山煙寺守清規：正月十七虹臺上，這一票投顏違（已經入了虹臺的席的，這一票不再跟著變）。\n收經那條路就沒了。要這麼說嗎？"

msgid "经已经收了。"
msgstr "經已經收了。"

msgid "把香案上那片贝叶拾起来，双手递还给头陀。"
msgstr "把香案上那片貝葉拾起來，雙手遞還給頭陀。"

msgid "本寺一脉，三十年前不收，今天也不收。经，请带回给你的师父。替老衲谢他。"
msgstr "本寺一脈，三十年前不收，今天也不收。經，請帶回給你的師父。替老衲謝他。"

msgid "独眼头陀接过贝叶，看了玄智很久，一句话也没说，转身出了大殿。金门外那块他站了十年的地方，空了。\n"
msgstr "獨眼頭陀接過貝葉，看了玄智很久，一句話也沒說，轉身出了大殿。金門外那塊他站了十年的地方，空了。\n"

msgid "看着殿门，忽然问你："
msgstr "看著殿門，忽然問你："

msgid "玄尘师弟……他还好？"
msgstr "玄塵師弟……他還好？"

msgid "你说他在青石村后山，守着一个阵。玄智点了点头，没有再问。\n"
msgstr "你說他在青石村後山，守著一個陣。玄智點了點頭，沒有再問。\n"

msgid "寺规就是寺规。外人不进流云轩，外来的经，也不进。……阿弥陀佛。"
msgstr "寺規就是寺規。外人不進流雲軒，外來的經，也不進。……阿彌陀佛。"

msgid "守什么？"
msgstr "守什麼？"

msgid "请玄智和尚把山烟寺这一票交给你：正月十七虹台上，山烟寺听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請玄智和尚把山煙寺這一票交給你：正月十七虹臺上，山煙寺聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "阿弥陀佛。说过了，山烟寺听施主的。"
msgstr "阿彌陀佛。說過了，山煙寺聽施主的。"

msgid "阿弥陀佛。山烟寺听施主的。"
msgstr "阿彌陀佛。山煙寺聽施主的。"

msgid "$N双手合十，恭恭敬敬地跪了下来。"
msgstr "$N雙手合十，恭恭敬敬地跪了下來。"

msgid "$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。"
msgstr "$n伸出手掌，在$N頭頂輕輕地摩挲了幾下，將$N的頭髮盡數剃去。"

msgid "从今以後你的法名叫做{name}。"
msgstr "從今以後你的法名叫做{name}。"

msgid "阿弥陀佛，女施主不要跟老纳开玩笑。"
msgstr "阿彌陀佛，女施主不要跟老納開玩笑。"

msgid "阿弥陀佛，施主愿入佛门，请先到小寺剃度出家。"
msgstr "阿彌陀佛，施主願入佛門，請先到小寺剃度出家。"

msgid "阿弥陀佛，善哉！善哉！"
msgstr "阿彌陀佛，善哉！善哉！"

msgid "陆得财"
msgstr "陸得財"

msgid "黑水伏蛟"
msgstr "黑水伏蛟"

msgid "陆得财是一个浑身脏兮兮的老丐，一副无精打采要死不活的样子，可是\n武林中人人都识得他身上打著二十三个结的皮酒囊，这不但是「花紫会\n」龙头的信物，更是名镇漠南的「黑水伏蛟」独门兵器，只不过陆得财\n行踪诡密，据说各处随时都有七、八的他的替身在四处活动，所以你也\n很难确定眼前这个陆得财到底是不是真的。\n"
msgstr "陸得財是一個渾身髒兮兮的老丐，一副無精打采要死不活的樣子，可是\n武林中人人都識得他身上打著二十三個結的皮酒囊，這不但是「花紫會\n」龍頭的信物，更是名鎮漠南的「黑水伏蛟」獨門兵器，只不過陸得財\n行蹤詭密，據說各處隨時都有七、八的他的替身在四處活動，所以你也\n很難確定眼前這個陸得財到底是不是真的。\n"

msgid "龙头"
msgstr "龍頭"

msgid "我们花紫会只收化子，$RESPECT您还是回去享福吧。\n"
msgstr "我們花紫會只收化子，$RESPECT您還是回去享福吧。\n"

msgid "契我收过了。这一叠，烧了干净。"
msgstr "契我收過了。這一疊，燒了乾淨。"

msgid "契我收下。八户人家的事，叫花子记着；别的，不劳你。"
msgstr "契我收下。八戶人家的事，叫花子記著；別的，不勞你。"

msgid "接过那叠契，一张一张数过去，数到第八张，揣进了怀里。"
msgstr "接過那疊契，一張一張數過去，數到第八張，揣進了懷裡。"

msgid "八户。明天她们就回家。"
msgstr "八戶。明天她們就回家。"

msgid "龙头要见见你这个人。"
msgstr "龍頭要見見你這個人。"

msgid "把腰里的皮酒囊解下来，往你面前一递。"
msgstr "把腰裡的皮酒囊解下來，往你面前一遞。"

msgid "数数。——二十二个。我是龙头的一个替身。"
msgstr "數數。——二十二個。我是龍頭的一個替身。"

msgid "真龙头的酒囊二十三个结，替身的都少几个。龙头在哪，替身一个传一个，一个只认得下一个：雪亭镇广场上那个结最少，从他问起，问「龙头」。"
msgstr "真龍頭的酒囊二十三個結，替身的都少幾個。龍頭在哪，替身一個傳一個，一個只認得下一個：雪亭鎮廣場上那個結最少，從他問起，問「龍頭」。"

msgid "陆得财守在福林大街上，手里摩挲着腰间的皮酒囊。\n"
msgstr "陸得財守在福林大街上，手裡摩挲著腰間的皮酒囊。\n"

msgid "叫花子跟官府的人，没有正事说。"
msgstr "叫花子跟官府的人，沒有正事說。"

msgid "你不是花紫会这边的人了。叫花子的事，不劳你。"
msgstr "你不是花紫會這邊的人了。叫花子的事，不勞你。"

msgid "槐阳那八户的契，烧了。龙头那边，你从雪亭镇广场那个问起。"
msgstr "槐陽那八戶的契，燒了。龍頭那邊，你從雪亭鎮廣場那個問起。"

msgid "契到手了？递给我。"
msgstr "契到手了？遞給我。"

msgid "福林酒楼二楼，那个姓胡的管事。契揣在他怀里——手要轻。"
msgstr "福林酒樓二樓，那個姓胡的管事。契揣在他懷裡——手要輕。"

msgid "抠了抠脚，眯着眼看你。"
msgstr "摳了摳腳，眯著眼看你。"

msgid "县衙那面鼓，是你敲的？叫花子都听见了。"
msgstr "縣衙那面鼓，是你敲的？叫花子都聽見了。"

msgid "兵部有个收民夫的管事，姓胡，这几天住在福林酒楼二楼。他怀里揣着一叠卖身契——槐阳城外八户人家，男人去关北挖河没回来，就拿女人孩子抵。"
msgstr "兵部有個收民夫的管事，姓胡，這幾天住在福林酒樓二樓。他懷裡揣著一疊賣身契——槐陽城外八戶人家，男人去關北挖河沒回來，就拿女人孩子抵。"

msgid "你去把契摸回来。不会偷？我教你两手（请教「偷窃」）。"
msgstr "你去把契摸回來。不會偷？我教你兩手（請教「偷竊」）。"

msgid "失了手，他喊着扑上来，巡捕也记你一笔——乔阴的巡捕认得贼。"
msgstr "失了手，他喊著撲上來，巡捕也記你一筆——喬陰的巡捕認得賊。"

msgid "差事？……县衙门口那面鼓都没敲过的人，接不了叫花子的差事。"
msgstr "差事？……縣衙門口那面鼓都沒敲過的人，接不了叫花子的差事。"

msgid "认这些年管事的人：真龙头把皮酒囊系到陆得财腰上，回京师的墙根接着看庾家。\n乔阴照旧——巷子里没有官差，巡捕照旧抓贼。正月十七，花紫会这一票投旧盟主（已经入了虹台的席的，票照入席时的算。）。\n要认他吗？"
msgstr "認這些年管事的人：真龍頭把皮酒囊繫到陸得財腰上，回京師的牆根接著看庾家。\n喬陰照舊——巷子裡沒有官差，巡捕照舊抓賊。正月十七，花紫會這一票投舊盟主（已經入了虹臺的席的，票照入席時的算。）。\n要認他嗎？"

msgid "二十三个结了。……叫花子的巷子，还是叫花子的。"
msgstr "二十三個結了。……叫花子的巷子，還是叫花子的。"

msgid "你认了京城墙根下那个。……叫花子不认两个龙头，乔阴的事就不劳你了。"
msgstr "你認了京城牆根下那個。……叫花子不認兩個龍頭，喬陰的事就不勞你了。"

msgid "把皮酒囊捧在手上，没有动。"
msgstr "把皮酒囊捧在手上，沒有動。"

msgid "真龙头看了他半天，把自己腰里那只二十三个结的皮酒囊解下来，系到了陆得财腰上。\n"
msgstr "真龍頭看了他半天，把自己腰裡那隻二十三個結的皮酒囊解下來，繫到了陸得財腰上。\n"

msgid "「京师的墙根，还得有人看着庾家。」他说完，头也不回地往南门去了。\n"
msgstr "「京師的牆根，還得有人看著庾家。」他說完，頭也不回地往南門去了。\n"

msgid "……二十年，我没让一个官差进过乔阴的巷子。往后也不让。"
msgstr "……二十年，我沒讓一個官差進過喬陰的巷子。往後也不讓。"

msgid "我是龙头的一个替身。雪亭镇广场上那个结最少，从他问起。"
msgstr "我是龍頭的一個替身。雪亭鎮廣場上那個結最少，從他問起。"

msgid "嘿嘿，你说呢？"
msgstr "嘿嘿，你說呢？"

msgid "嘿，正月十七？叫花子早忘了。"
msgstr "嘿，正月十七？叫花子早忘了。"

msgid "花紫会这一票，正月十七照你说的。"
msgstr "花紫會這一票，正月十七照你說的。"

msgid "拍了拍腰里那只二十三个结的皮酒囊。"
msgstr "拍了拍腰裡那隻二十三個結的皮酒囊。"

msgid "花紫会这一票？投旧盟主。叫花子最怕官——颜违当了盟主，官差就要进乔阴的巷子了。"
msgstr "花紫會這一票？投舊盟主。叫花子最怕官——顏違當了盟主，官差就要進喬陰的巷子了。"

msgid "这只酒囊是你替我认下的。你要这一票，开口就是。"
msgstr "這隻酒囊是你替我認下的。你要這一票，開口就是。"

msgid "嘿嘿一笑，抠了抠脚。"
msgstr "嘿嘿一笑，摳了摳腳。"

msgid "花紫会这一票？投旧盟主呗。"
msgstr "花紫會這一票？投舊盟主唄。"

msgid "颜违跟朝廷走得近，他当了盟主，官差就要进乔阴的巷子了——叫花子最怕官。"
msgstr "顏違跟朝廷走得近，他當了盟主，官差就要進喬陰的巷子了——叫花子最怕官。"

msgid "虹台？叫花子不管那么远的事。"
msgstr "虹臺？叫花子不管那麼遠的事。"

msgid "请陆得财把花紫会这一票交给你：正月十七虹台上，花紫会听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請陸得財把花紫會這一票交給你：正月十七虹臺上，花紫會聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "说过了。花紫会听你的。"
msgstr "說過了。花紫會聽你的。"

msgid "好。花紫会这一票，你说了算。"
msgstr "好。花紫會這一票，你說了算。"

msgid "骆云舟"
msgstr "駱雲舟"

msgid "骆云舟生於京城有名的武林世家，他的本名是骆建炎，但是因为生性喜爱\n四处游荡，遂自号「云舟」，四处游山玩水，结交豪杰异人。数年前继承\n其父骆易而成为步玄派的新任掌门，但是喜爱飘泊的个性仍然不改，令门\n中耆宿头痛不已。\n"
msgstr "駱雲舟生於京城有名的武林世家，他的本名是駱建炎，但是因為生性喜愛\n四處遊蕩，遂自號「雲舟」，四處遊山玩水，結交豪傑異人。數年前繼承\n其父駱易而成為步玄派的新任掌門，但是喜愛飄泊的個性仍然不改，令門\n中耆宿頭痛不已。\n"

msgid "你还是先走一趟东边的桃林吧。\n"
msgstr "你還是先走一趟東邊的桃林吧。\n"

msgid "很好，$RESPECT多加努力，他日必定有成。\n"
msgstr "很好，$RESPECT多加努力，他日必定有成。\n"

msgid "风泉"
msgstr "風泉"

msgid "步玄的事，不劳你了。"
msgstr "步玄的事，不勞你了。"

msgid "剑灵认过你了。步玄的人，见过它就算。"
msgstr "劍靈認過你了。步玄的人，見過它就算。"

msgid "夜里来曼雩台，问我「问剑」。"
msgstr "夜裡來曼雩臺，問我「問劍」。"

msgid "把腰上那柄湛蓝的剑解下来，横在膝上。"
msgstr "把腰上那柄湛藍的劍解下來，橫在膝上。"

msgid "风泉之剑。步玄历代掌门传下来的，剑里住着一个剑灵。"
msgstr "風泉之劍。步玄歷代掌門傳下來的，劍裡住著一個劍靈。"

msgid "照规矩，它只在拿剑的人死了才出来——可步玄还有一条老规矩：见过剑灵的人，才算步玄的人。"
msgstr "照規矩，它只在拿劍的人死了才出來——可步玄還有一條老規矩：見過劍靈的人，才算步玄的人。"

msgid "夜里来曼雩台，问我「问剑」。我把剑插在石台上，它就出来了。"
msgstr "夜裡來曼雩臺，問我「問劍」。我把劍插在石臺上，它就出來了。"

msgid "上下打量了你一眼，笑了。"
msgstr "上下打量了你一眼，笑了。"

msgid "桃林里那几张字条，你一张一张走出来了？——走得出桃林的，就是桃林的客。"
msgstr "桃林裡那幾張字條，你一張一張走出來了？——走得出桃林的，就是桃林的客。"

msgid "名帖的事办得怎样了？……有空的话，桃林走一趟，咱们说话。"
msgstr "名帖的事辦得怎樣了？……有空的話，桃林走一趟，咱們說話。"

msgid "风泉之剑，步玄历代掌门的信物。剑里的事——先走一趟东边的桃林再说。"
msgstr "風泉之劍，步玄歷代掌門的信物。劍裡的事——先走一趟東邊的桃林再說。"

msgid "问剑"
msgstr "問劍"

msgid "剑灵在「剑神如意」之前收了剑——它认你了。"
msgstr "劍靈在「劍神如意」之前收了劍——它認你了。"

msgid "步玄认你。"
msgstr "步玄認你。"

msgid "伸手把石缝里的剑拔了出来，又插了回去。"
msgstr "伸手把石縫裡的劍拔了出來，又插了回去。"

msgid "四句念完了，剑灵回了剑。今夜到此——明晚天黑了再来。"
msgstr "四句念完了，劍靈回了劍。今夜到此——明晚天黑了再來。"

msgid "剑在石台上。天黑以后它就出来——跟它切磋，赶在「剑神如意」之前。"
msgstr "劍在石臺上。天黑以後它就出來——跟它切磋，趕在「劍神如意」之前。"

msgid "走到台边那块青石前，把风泉之剑往石缝里一插，剑身「嗡」地响了一声。"
msgstr "走到臺邊那塊青石前，把風泉之劍往石縫裡一插，劍身「嗡」地響了一聲。"

msgid "天黑了，剑灵就站在这块石头前。跟它切磋——它念一句，强一分。"
msgstr "天黑了，劍靈就站在這塊石頭前。跟它切磋——它念一句，強一分。"

msgid "念到第四句「剑神如意」之前打中它，就算过了。念完了，今夜就到此，明晚再来。"
msgstr "念到第四句「劍神如意」之前打中它，就算過了。念完了，今夜就到此，明晚再來。"

msgid "问剑？"
msgstr "問劍？"

msgid "骆家"
msgstr "駱家"

msgid "骆家的事，不劳你了。"
msgstr "駱家的事，不勞你了。"

msgid "大哥去了关北。他写信来，说那边的风比曼雩台还大。……最后一笔，没甩出格子。"
msgstr "大哥去了關北。他寫信來，說那邊的風比曼雩臺還大。……最後一筆，沒甩出格子。"

msgid "大哥的供状在京城。骆家的门匾，我回去摘了——摘下来，背面是父亲的字。"
msgstr "大哥的供狀在京城。駱家的門匾，我回去摘了——摘下來，背面是父親的字。"

msgid "大哥在台上抄谱。你问他去——他话少，比从前多了一点。"
msgstr "大哥在臺上抄譜。你問他去——他話少，比從前多了一點。"

msgid "我进京一趟。西街相国府见——大哥在那里。"
msgstr "我進京一趟。西街相國府見——大哥在那裡。"

msgid "听你说完，扇子停在半空，很久没有动。"
msgstr "聽你說完，扇子停在半空，很久沒有動。"

msgid "那三句是他写的。……他写的时候就知道。"
msgstr "那三句是他寫的。……他寫的時候就知道。"

msgid "父亲带我们练剑那年，他说剑是莽夫的东西，字才是骆家的。骆家的字，写到兵部的抄本上去了。"
msgstr "父親帶我們練劍那年，他說劍是莽夫的東西，字才是駱家的。駱家的字，寫到兵部的抄本上去了。"

msgid "站起来，把风泉之剑挂回腰上。"
msgstr "站起來，把風泉之劍掛回腰上。"

msgid "十年没回京城了。我进京一趟——西街相国府见，大哥在韦相国那里。"
msgstr "十年沒回京城了。我進京一趟——西街相國府見，大哥在韋相國那裡。"

msgid "他读了？……他没回信。他从来不回。"
msgstr "他讀了？……他沒回信。他從來不回。"

msgid "愣了一下，摇摇头，又写了一封。"
msgstr "愣了一下，搖搖頭，又寫了一封。"

msgid "丢了就丢了。这一封，别再丢了。"
msgstr "丟了就丟了。這一封，別再丟了。"

msgid "信在你那里。他在庾子建府上的客厅——庾子建倒了，就去相国府找他。"
msgstr "信在你那裡。他在庾子建府上的客廳——庾子建倒了，就去相國府找他。"

msgid "沉默了一会儿，用扇子敲了敲手心。"
msgstr "沉默了一會兒，用扇子敲了敲手心。"

msgid "韦相国叫我「骆家的二小子」，没叫错。我上头还有一个大哥，骆建章。"
msgstr "韋相國叫我「駱家的二小子」，沒叫錯。我上頭還有一個大哥，駱建章。"

msgid "父亲带我们练剑，他不肯，说剑是莽夫的东西。他写得一手好字——比父亲的好，比我的好得多。"
msgstr "父親帶我們練劍，他不肯，說劍是莽夫的東西。他寫得一手好字——比父親的好，比我的好得多。"

msgid "十年前他进了兵部尚书庾子建的府，做书启。我们兄弟俩，十年没说过一句话。"
msgstr "十年前他進了兵部尚書庾子建的府，做書啟。我們兄弟倆，十年沒說過一句話。"

msgid "从袖子里抽出一张笺，提笔写了很久，写完折成一个小方块，最后一笔照旧甩出了格子。"
msgstr "從袖子裡抽出一張箋，提筆寫了很久，寫完折成一個小方塊，最後一筆照舊甩出了格子。"

msgid "你进京的时候，替我把这封信交给他。他在庾子建的客厅里写字——庾子建要是倒了，他多半在韦相国那里。"
msgstr "你進京的時候，替我把這封信交給他。他在庾子建的客廳裡寫字——庾子建要是倒了，他多半在韋相國那裡。"

msgid "骆家的事？……等你进了京，咱们再说。"
msgstr "駱家的事？……等你進了京，咱們再說。"

msgid "骆家在京城住了五代。我是二小子。"
msgstr "駱家在京城住了五代。我是二小子。"

msgid "京城"
msgstr "京城"

msgid "名帖给过你了。韦相国那老头子脾气怪，可是不收银子，也不怕庾子建——京城里这样的人，数得过来。"
msgstr "名帖給過你了。韋相國那老頭子脾氣怪，可是不收銀子，也不怕庾子建——京城裡這樣的人，數得過來。"

msgid "把扇子一收，看了你半晌。"
msgstr "把扇子一收，看了你半晌。"

msgid "你要进京告兵部尚书？——好。我家在京城住了五代，别的没有，认得几个不收银子的人。"
msgstr "你要進京告兵部尚書？——好。我家在京城住了五代，別的沒有，認得幾個不收銀子的人。"

msgid "从袖子里抽出一张大红名帖，提笔写了一行，字写得飞快，最后一笔甩出了格子。"
msgstr "從袖子裡抽出一張大紅名帖，提筆寫了一行，字寫得飛快，最後一筆甩出了格子。"

msgid "拿着，去西街的相国府，叩门递帖。韦相国是我父亲的老师。他那府里寒酸得很——别笑。"
msgstr "拿著，去西街的相國府，叩門遞帖。韋相國是我父親的老師。他那府裡寒酸得很——別笑。"

msgid "又看了你一眼。"
msgstr "又看了你一眼。"

msgid "等这件事办完了，桃林走一趟，咱们说话。"
msgstr "等這件事辦完了，桃林走一趟，咱們說話。"

msgid "京城？我家在京城，我不爱回去。那里的人说话，十句有九句是给别人听的。"
msgstr "京城？我家在京城，我不愛回去。那裡的人說話，十句有九句是給別人聽的。"

msgid "虹台上的事，骆家记下了。"
msgstr "虹臺上的事，駱家記下了。"

msgid "步玄这一票，听你的。"
msgstr "步玄這一票，聽你的。"

msgid "把扇子在掌心敲了两下。"
msgstr "把扇子在掌心敲了兩下。"

msgid "骆家跟朝廷翻了脸。步玄这一票投旧盟主——兵部的旧案，查到底。"
msgstr "駱家跟朝廷翻了臉。步玄這一票投舊盟主——兵部的舊案，查到底。"

msgid "大哥那张供状，是你陪着他写的。这一票，你要，就是你的。"
msgstr "大哥那張供狀，是你陪著他寫的。這一票，你要，就是你的。"

msgid "骆家还是京城的世家，京城的意思，是颜违。步玄这一票投他。"
msgstr "駱家還是京城的世家，京城的意思，是顏違。步玄這一票投他。"

msgid "朝台上抄谱的大哥看了一眼。"
msgstr "朝臺上抄譜的大哥看了一眼。"

msgid "可大哥是你让我带回来的。骆家欠你一份情：这一票，你要，就是你的。"
msgstr "可大哥是你讓我帶回來的。駱家欠你一份情：這一票，你要，就是你的。"

msgid "骆家是京城的世家，这一票原该随朝廷——投颜违。"
msgstr "駱家是京城的世家，這一票原該隨朝廷——投顏違。"

msgid "可庾子建是你在朝上揭发的，骆家的名帖也是你拿去敲开相国府的门。骆家欠你一份情：这一票，你要，就是你的。"
msgstr "可庾子建是你在朝上揭發的，駱家的名帖也是你拿去敲開相國府的門。駱家欠你一份情：這一票，你要，就是你的。"

msgid "骆家在京城住了五代，京城的意思，是颜违。"
msgstr "駱家在京城住了五代，京城的意思，是顏違。"

msgid "步玄这一票投他。我不爱回去，可我姓骆。"
msgstr "步玄這一票投他。我不愛回去，可我姓駱。"

msgid "请骆云舟把步玄派这一票交给你：正月十七虹台上，步玄听你的——你要站出来，这一票就是你的；不站，就由你说投谁。\n要这么说吗？"
msgstr "請駱雲舟把步玄派這一票交給你：正月十七虹臺上，步玄聽你的——你要站出來，這一票就是你的；不站，就由你說投誰。\n要這麼說嗎？"

msgid "说过了。步玄听你的。"
msgstr "說過了。步玄聽你的。"

msgid "把扇子一收，笑了。"
msgstr "把扇子一收，笑了。"

