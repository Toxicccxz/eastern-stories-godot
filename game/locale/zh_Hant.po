msgid "$N低头闭目，开始施展游识神通 ...."
msgstr "$N低頭閉目，開始施展遊識神通 ...."

msgid "战斗中无法使用游识神通！"
msgstr "戰鬥中無法使用遊識神通！"

msgid "你的灵力不够！"
msgstr "你的靈力不夠！"

msgid "游识神通只能对自己使用！"
msgstr "遊識神通只能對自己使用！"

msgid "你感受到对方的灵力，但是不够强烈。"
msgstr "你感受到對方的靈力，但是不夠強烈。"

msgid "你因为不够熟练而失败了。"
msgstr "你因為不夠熟練而失敗了。"

msgid "$N口中喃喃地念著咒文，忽然大喝一声“疾！”"
msgstr "$N口中喃喃地念著咒文，忽然大喝一聲「疾！」"

msgid "只见一道黑气罩在$n身上！"
msgstr "只見一道黑氣罩在$n身上！"

msgid "只见一道金光罩在$n身上！"
msgstr "只見一道金光罩在$n身上！"

msgid "只见一团火焰罩在$n身上！"
msgstr "只見一團火焰罩在$n身上！"

msgid "只听在一声海啸，海水将$n团团围住！"
msgstr "只聽在一聲海嘯，海水將$n團團圍住！"

msgid "只见空中落下无数大木，正把$n困在中央！"
msgstr "只見空中落下無數大木，正把$n困在中央！"

msgid "只见$N化作一道黑气，然后消失得无影无踪！"
msgstr "只見$N化作一道黑氣，然後消失得無影無蹤！"

msgid "只见$N化作一道金光，然后消失得无影无踪！"
msgstr "只見$N化作一道金光，然後消失得無影無蹤！"

msgid "只见$N化作一团火焰，然后消失得无影无踪！"
msgstr "只見$N化作一團火焰，然後消失得無影無蹤！"

msgid "只见$N化作一道长虹，然后消失得无影无踪！"
msgstr "只見$N化作一道長虹，然後消失得無影無蹤！"

msgid "只见$N化作一团大雾，然后消失得无影无踪！"
msgstr "只見$N化作一團大霧，然後消失得無影無蹤！"

msgid "但是$n纵身一跃，脱离了围困。"
msgstr "但是$n縱身一躍，脫離了圍困。"

msgid "困"
msgstr "困"

msgid "遁"
msgstr "遁"

msgid "这个法术只能在战斗中使用！"
msgstr "這個法術只能在戰鬥中使用！"

msgid "$n正自顾不暇，放胆进攻吧。"
msgstr "$n正自顧不暇，放膽進攻吧。"

msgid "「缺」字诀"
msgstr "「缺」字訣"

msgid "'缺'字诀只能在战斗中使用。"
msgstr "'缺'字訣只能在戰鬥中使用。"

msgid "你要对谁使用'缺'字诀？"
msgstr "你要對誰使用'缺'字訣？"

msgid "你已经在运用中了。"
msgstr "你已經在運用中了。"

msgid "$N剑招陡变，空门大开，诱使$n进招，"
msgstr "$N劍招陡變，空門大開，誘使$n進招，"

msgid "可是$n看破了$N的企图，并没有上当。"
msgstr "可是$n看破了$N的企圖，並沒有上當。"

msgid "$N突然对$n发出奋力一击！"
msgstr "$N突然對$n發出奮力一擊！"

msgid "「玄羽乱舞」"
msgstr "「玄羽亂舞」"

msgid "「玄羽乱舞」只能在战斗中使用。"
msgstr "「玄羽亂舞」只能在戰鬥中使用。"

msgid "你的气不够！"
msgstr "你的氣不夠！"

msgid "你的真气不够！"
msgstr "你的真氣不夠！"

msgid "$N使出步玄七诀第一式「玄羽乱舞」，身法陡然加快！"
msgstr "$N使出步玄七訣第一式「玄羽亂舞」，身法陡然加快！"

msgid "$N的身形转了几转，倏地停住了脚步。"
msgstr "$N的身形轉了幾轉，倏地停住了腳步。"

msgid "$N迅捷无伦地在$n身旁绕了一圈 ..."
msgstr "$N迅捷無倫地在$n身旁繞了一圈 ..."

msgid "但是$N找不到机会出手！"
msgstr "但是$N找不到機會出手！"

msgid "$N眼睛忽然睁开，喃喃地说道：杀....死....$n...."
msgstr "$N眼睛忽然睜開，喃喃地說道：殺....死....$n...."

msgid "你要在这张符上写谁的名字？"
msgstr "你要在這張符上寫誰的名字？"

msgid "心识神通"
msgstr "心識神通"

msgid "$N一手放在$n的天灵盖上，一手贴在$n的後心，闭上眼睛缓缓低吟 ..."
msgstr "$N一手放在$n的天靈蓋上，一手貼在$n的後心，閉上眼睛緩緩低吟 ..."

msgid "你要对谁使用心识神通？"
msgstr "你要對誰使用心識神通？"

msgid "召护法"
msgstr "召護法"

msgid "只有战斗中才能召唤天将！"
msgstr "只有戰鬥中才能召喚天將！"

msgid "你的精神无法集中！"
msgstr "你的精神無法集中！"

msgid "$N喃喃地念了几句咒语。"
msgstr "$N喃喃地念了幾句咒語。"

msgid "但是什麽也没有发生。"
msgstr "但是什麼也沒有發生。"

msgid "( 你上一个动作还没有完成，不能施用外功。)"
msgstr "( 你上一個動作還沒有完成，不能施用外功。)"

msgid "你请先用 enable 指令选择你要使用的外功。"
msgstr "你請先用 enable 指令選擇你要使用的外功。"

msgid "你所使用的外功中没有这种功能。"
msgstr "你所使用的外功中沒有這種功能。"

msgid "「点」字诀"
msgstr "「點」字訣"

msgid "「点」字诀只能对战斗中的对手使用。"
msgstr "「點」字訣只能對戰鬥中的對手使用。"

msgid "$N使出封山剑法「点」字诀，可是内力不继，剑尖一颤，手中的剑险些脱手飞出！"
msgstr "$N使出封山劍法「點」字訣，可是內力不繼，劍尖一顫，手中的劍險些脫手飛出！"

msgid "$N使出封山剑法「点」字诀，劲力尽数聚在剑尖，一剑直刺$n！"
msgstr "$N使出封山劍法「點」字訣，勁力盡數聚在劍尖，一劍直刺$n！"

msgid "用 {force} 点内力把劲力聚在剑尖，这一剑伤得更重；内力不够，剑会险些脱手，白白耽误几手"
msgstr "用 {force} 點內力把勁力聚在劍尖，這一劍傷得更重；內力不夠，劍會險些脫手，白白耽誤幾手"

msgid "召天将"
msgstr "召天將"

msgid "战斗时不能画符！"
msgstr "戰鬥時不能畫符！"

msgid "你的精神太差了，无法画符。"
msgstr "你的精神太差了，無法畫符。"

msgid "你所学的法术没有这种符。"
msgstr "你所學的法術沒有這種符。"

msgid "紫光"
msgstr "紫光"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团紫光射向$n！"
msgstr "$N口中喃喃地念著咒文，左手一揮，手中聚起一團紫光射向$n！"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，拖出一条长长的七彩光气，光气绕了回转过来又从$N顶门注入$P的体内！"
msgstr "結果「嗤」地一聲，紫光從$p身上透體而過，拖出一條長長的七彩光氣，光氣繞了迴轉過來又從$N頂門注入$P的體內！"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，无声无息地钻入地下！"
msgstr "結果「嗤」地一聲，紫光從$p身上透體而過，無聲無息地鑽入地下！"

msgid "白光"
msgstr "白光"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团白光射向$n！"
msgstr "$N口中喃喃地念著咒文，左手一揮，手中聚起一團白光射向$n！"

msgid "结果「嗤」地一声，白光从$p身上透体而过，拖出一条长长的黑气直射到两三丈外的地下！"
msgstr "結果「嗤」地一聲，白光從$p身上透體而過，拖出一條長長的黑氣直射到兩三丈外的地下！"

msgid "结果「嗤」地一声，白光从$p身上透体而过，无声无息地钻入地下！"
msgstr "結果「嗤」地一聲，白光從$p身上透體而過，無聲無息地鑽入地下！"

msgid "青光"
msgstr "青光"

msgid "你失败了！"
msgstr "你失敗了！"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团青光射向$n！"
msgstr "$N口中喃喃地念著咒文，左手一揮，手中聚起一團青光射向$n！"

msgid "结果「嗤」地一声，青光从$p身上透体而过，拖出一条长长的血箭直射到两三丈外的地下！"
msgstr "結果「嗤」地一聲，青光從$p身上透體而過，拖出一條長長的血箭直射到兩三丈外的地下！"

msgid "结果「嗤」地一声，青光从$p身上透体而过，无声无息地钻入地下！"
msgstr "結果「嗤」地一聲，青光從$p身上透體而過，無聲無息地鑽入地下！"

msgid "投降？现在没有人在打你啊....？"
msgstr "投降？現在沒有人在打你啊....？"

msgid "$n向$N求饶，但是$N大声说道：{rude}废话少说，纳命来！"
msgstr "$n向$N求饒，但是$N大聲說道：{rude}廢話少說，納命來！"

msgid "$N说道：「不打了，不打了，我投降....。」"
msgstr "$N說道：「不打了，不打了，我投降....。」"

msgid "「逐」字诀"
msgstr "「逐」字訣"

msgid "「逐」字诀只能对战斗中的对手使用。"
msgstr "「逐」字訣只能對戰鬥中的對手使用。"

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p已显吃力。"
msgstr "$N使出封山劍法「逐」字訣，劍法一緊，劍光罩向$n，$p已顯吃力。"

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p从容化解"
msgstr "$N使出封山劍法「逐」字訣，劍法一緊，劍光罩向$n，$p從容化解"

msgid "空识神通"
msgstr "空識神通"

msgid "$N盘膝而座，开始运用空识神通静思入定 ..."
msgstr "$N盤膝而座，開始運用空識神通靜思入定 ..."

msgid "空识神通只能对自己使用。"
msgstr "空識神通只能對自己使用。"

msgid "你觉得脑中一片混乱，你的潜能降低了！"
msgstr "你覺得腦中一片混亂，你的潛能降低了！"

msgid "你的潜能提高了！"
msgstr "你的潛能提高了！"

msgid "可是你只觉得一无所获。"
msgstr "可是你只覺得一無所獲。"

