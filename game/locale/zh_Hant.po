msgid "雪亭镇的头几天"
msgstr "雪亭鎮的頭幾天"

msgid "你在饮风客栈醒来，店小二笑着招呼了你。"
msgstr "你在飲風客棧醒來，店小二笑著招呼了你。"

msgid "跟店小二打听「楼上」。"
msgstr "跟店小二打聽「樓上」。"

msgid "店小二说楼上客房闹老鼠，请你上去收拾。"
msgstr "店小二說樓上客房鬧老鼠，請你上去收拾。"

msgid "上楼收拾老鼠。"
msgstr "上樓收拾老鼠。"

msgid "楼上的老鼠都收拾干净了。"
msgstr "樓上的老鼠都收拾乾淨了。"

msgid "下楼找店小二。"
msgstr "下樓找店小二。"

msgid "店小二谢了你一根烤鸡腿。"
msgstr "店小二謝了你一根烤雞腿。"

msgid "去淳风武馆拜柳淳风为师。"
msgstr "去淳風武館拜柳淳風為師。"

msgid "你拜入了封山剑派。"
msgstr "你拜入了封山劍派。"

msgid "向柳淳风请教基本剑法。"
msgstr "向柳淳風請教基本劍法。"

msgid "你跟柳淳风学了基本剑法。"
msgstr "你跟柳淳風學了基本劍法。"

msgid "去武馆和弟子切磋一场，胜了算。"
msgstr "去武館和弟子切磋一場，勝了算。"

msgid "你第一次在切磋中胜过了武馆弟子。"
msgstr "你第一次在切磋中勝過了武館弟子。"

msgid "到武学页打坐，把内力练到 10。"
msgstr "到武學頁打坐，把內力練到 10。"

msgid "你的内力练到了 10。"
msgstr "你的內力練到了 10。"

msgid "再切磋，再打坐：内力练到 25。"
msgstr "再切磋，再打坐：內力練到 25。"

msgid "你的内力练到了 25。"
msgstr "你的內力練到了 25。"

msgid "向李教头讨教一场，然后打坐到内力 50。"
msgstr "向李教頭討教一場，然後打坐到內力 50。"

msgid "你的内力练到了 50，够学封山剑法了。"
msgstr "你的內力練到了 50，夠學封山劍法了。"

msgid "向柳淳风请教封山剑法；教练场的木人也等着你。"
msgstr "向柳淳風請教封山劍法；教練場的木人也等著你。"

msgid "你学会了封山剑法。"
msgstr "你學會了封山劍法。"

msgid "去雪亭驿找杜宽，问问「送信」；门外的悬赏榜也看一眼。"
msgstr "去雪亭驛找杜寬，問問「送信」；門外的懸賞榜也看一眼。"

msgid "你揭了雪亭驿门外的一张悬赏。"
msgstr "你揭了雪亭驛門外的一張懸賞。"

msgid "出镇南行，过卧龙岗，去绮云镇看看。"
msgstr "出鎮南行，過臥龍崗，去綺雲鎮看看。"

msgid "你第一次来到绮云镇。雪亭镇的头几天到此为止，往后的路自己走。"
msgstr "你第一次來到綺雲鎮。雪亭鎮的頭幾天到此為止，往後的路自己走。"

msgid "雪亭驿的信"
msgstr "雪亭驛的信"

msgid "杜宽托你把一封信送到绮云镇振远镖局陈剑秋手里，回来给一两脚钱。"
msgstr "杜寬託你把一封信送到綺雲鎮振遠鏢局陳劍秋手裡，回來給一兩腳錢。"

msgid "出镇往南过卧龙岗，到绮云镇的振远镖局把信交给陈剑秋。"
msgstr "出鎮往南過臥龍崗，到綺雲鎮的振遠鏢局把信交給陳劍秋。"

msgid "你把信交给了陈剑秋。"
msgstr "你把信交給了陳劍秋。"

msgid "回雪亭驿找杜宽拿脚钱。"
msgstr "回雪亭驛找杜寬拿腳錢。"

msgid "杜宽付了你一两脚钱，说往后有信还找你。"
msgstr "杜寬付了你一兩腳錢，說往後有信還找你。"

msgid "门房的来历"
msgstr "門房的來歷"

msgid "魏无极说淳风武馆的门房刘安禄是野羊山寨的二寨主，人称血手刘三。"
msgstr "魏無極說淳風武館的門房劉安祿是野羊山寨的二寨主，人稱血手劉三。"

msgid "去淳风武馆问问柳淳风「刘安禄」。"
msgstr "去淳風武館問問柳淳風「劉安祿」。"

msgid "柳淳风只说刘兄弟在武馆管事五年了，过去之事不须再提。门房的来历，雪亭镇上只有他一个人清楚。"
msgstr "柳淳風只說劉兄弟在武館管事五年了，過去之事不須再提。門房的來歷，雪亭鎮上只有他一個人清楚。"

msgid "樵夫骂野羊山那群道士该千刀万剐，说他们施了妖法。"
msgstr "樵夫罵野羊山那群道士該千刀萬剮，說他們施了妖法。"

msgid "刘安禄动起手来说漏了嘴：「想我堂堂……呃……连我这个小小的门房都可以收拾你！」"
msgstr "劉安祿動起手來說漏了嘴：「想我堂堂……呃……連我這個小小的門房都可以收拾你！」"

msgid "刘安禄亮出了血手刘三的身份：野羊山寨的二寨主，一手快刀判若两人。"
msgstr "劉安祿亮出了血手劉三的身份：野羊山寨的二寨主，一手快刀判若兩人。"

msgid "你向雪亭镇书院的魏无极打听学费。"
msgstr "你向雪亭鎮書院的魏無極打聽學費。"

msgid "你交给魏无极学费，他点头说从今天起你随时可以去问他读书识字的学问。"
msgstr "你交給魏無極學費，他點頭說從今天起你隨時可以去問他讀書識字的學問。"

msgid "你在兵器储藏室底下的地下密室里拾到一面牛皮盾。"
msgstr "你在兵器儲藏室底下的地下密室裡拾到一面牛皮盾。"

msgid "玉佩"
msgstr "玉佩"

msgid "你向青石村的村长打听玉佩。"
msgstr "你向青石村的村長打聽玉佩。"

msgid "你给雪亭镇的醉汉送酒，他悄声说：玉佩他卖给沈老板了，那东西不吉祥。"
msgstr "你給雪亭鎮的醉漢送酒，他悄聲說：玉佩他賣給沈老闆了，那東西不吉祥。"

msgid "你又给醉汉送酒，他悄声说：听说沈记商行有在卖蒙汗药。"
msgstr "你又給醉漢送酒，他悄聲說：聽說沈記商行有在賣蒙汗藥。"

msgid "你向沈记商行的沈万年问起玉佩，得到了那块刻著行气口诀的玉佩。"
msgstr "你向沈記商行的沈萬年問起玉佩，得到了那塊刻著行氣口訣的玉佩。"

msgid "你向沈万年打听蒙汗药，他悄声说一份只要十两银子，保证有效。"
msgstr "你向沈萬年打聽蒙汗藥，他悄聲說一份只要十兩銀子，保證有效。"

msgid "你付给沈万年十两银子，他塞给你一包蒙汗药。"
msgstr "你付給沈萬年十兩銀子，他塞給你一包蒙汗藥。"

msgid "你依着路牌穿过了山路尽头的迷阵。"
msgstr "你依著路牌穿過了山路盡頭的迷陣。"

msgid "你跳入溪水中仔细寻找，竟从水中找出一把追风剑。"
msgstr "你跳入溪水中仔細尋找，竟從水中找出一把追風劍。"

msgid "山洞里的骸骨"
msgstr "山洞裡的骸骨"

msgid "你在瀑布旁的山洞里埋好了那具骸骨，洞顶石壁「喀喇」一响，坠下一本过招要旨。"
msgstr "你在瀑布旁的山洞裡埋好了那具骸骨，洞頂石壁「喀喇」一響，墜下一本過招要旨。"

msgid "树上的刀痕"
msgstr "樹上的刀痕"

msgid "你顺着松树上的刀痕，在崖上林径尽头的灌木后找到了一条小径，通往老松寨。"
msgstr "你順著松樹上的刀痕，在崖上林徑盡頭的灌木後找到了一條小徑，通往老松寨。"

msgid "买路钱"
msgstr "買路錢"

msgid "你向卧龙岗的强盗问起买路钱。"
msgstr "你向臥龍崗的強盜問起買路錢。"

msgid "你交给卧龙岗的强盗十两金子，他收下钱，说今天做个善人，放你一条生路。"
msgstr "你交給臥龍崗的強盜十兩金子，他收下錢，說今天做個善人，放你一條生路。"

msgid "你在怡红院二楼向李师师请教学艺。"
msgstr "你在怡紅院二樓向李師師請教學藝。"

msgid "你留给李师师一件信物，她说：能做相公的老师，真是三生有幸。"
msgstr "你留給李師師一件信物，她說：能做相公的老師，真是三生有幸。"

msgid "你在香茗坊二楼和弈者下了一盘棋。"
msgstr "你在香茗坊二樓和弈者下了一盤棋。"

msgid "你得到了弈者的棋子，一种较轻的暗器。"
msgstr "你得到了弈者的棋子，一種較輕的暗器。"

msgid "忘忧草"
msgstr "忘憂草"

msgid "你向振远镖局的陈剑秋问起陈天星。"
msgstr "你向振遠鏢局的陳劍秋問起陳天星。"

msgid "你向陈剑秋问起忘忧草。"
msgstr "你向陳劍秋問起忘憂草。"

msgid "你向乔阴县城的乾瘪老太婆打听忘忧草。"
msgstr "你向喬陰縣城的乾癟老太婆打聽忘憂草。"

msgid "你向乔阴县城的游客打听忘忧草。"
msgstr "你向喬陰縣城的遊客打聽忘憂草。"

msgid "护草神兽倒下后，你在神秘洞穴里得到一棵发着晶莹光芒的忘忧草。"
msgstr "護草神獸倒下後，你在神秘洞穴裡得到一棵發著晶瑩光芒的忘憂草。"

msgid "你把忘忧草交给陈剑秋，他大喜过望，提笔写好一封信交给你，嘱咐你路上小心，把信直接交给陈师叔。"
msgstr "你把忘憂草交給陳劍秋，他大喜過望，提筆寫好一封信交給你，囑咐你路上小心，把信直接交給陳師叔。"

msgid "你在京师振远总局向陈天星请教拜师。"
msgstr "你在京師振遠總局向陳天星請教拜師。"

msgid "你向傍厅的蓝雨梅问起芳绫。"
msgstr "你向傍廳的藍雨梅問起芳綾。"

msgid "你向蓝筱薇问起竹蜻蜓。"
msgstr "你向藍筱薇問起竹蜻蜓。"

msgid "你把一根竹子交给蓝筱薇，她看了看说是根玉竹，便灵巧地削凿起来。"
msgstr "你把一根竹子交給藍筱薇，她看了看說是根玉竹，便靈巧地削鑿起來。"

msgid "蓝筱薇把做好的竹蜻蜓递给了你。"
msgstr "藍筱薇把做好的竹蜻蜓遞給了你。"

msgid "你把竹蜻蜓送给禁闭房里的芳绫，她开心地把玩，在你耳边小声说：『庄内前厅某处藏有一宝物手镯哦！』"
msgstr "你把竹蜻蜓送給禁閉房裡的芳綾，她開心地把玩，在你耳邊小聲說：『莊內前廳某處藏有一寶物手鐲哦！』"

msgid "你从内厅的碧纱橱里取出一串玛瑙手镯。"
msgstr "你從內廳的碧紗櫥裡取出一串瑪瑙手鐲。"

msgid "晚月庄的舞步"
msgstr "晚月莊的舞步"

msgid "你记下了一曲舞步『西出阳关』。"
msgstr "你記下了一曲舞步『西出陽關』。"

msgid "你记下了一曲舞步『有凤来仪』。"
msgstr "你記下了一曲舞步『有鳳來儀』。"

msgid "你在一间密室里拾到一卷丝罗巾，上面绣着一幅幅翩然起舞的美女图。"
msgstr "你在一間密室裡拾到一卷絲羅巾，上面繡著一幅幅翩然起舞的美女圖。"

msgid "你在翠湘阁向莫欣芳问起舞曲谱。"
msgstr "你在翠湘閣向莫欣芳問起舞曲譜。"

msgid "你在密室的石床后面找到了一本舞曲谱。"
msgstr "你在密室的石床後面找到了一本舞曲譜。"

msgid "无名老妇"
msgstr "無名老婦"

msgid "你向内书房的无名老妇问起她的心事：那个蒙面的杀手，是她的私生女。"
msgstr "你向內書房的無名老婦問起她的心事：那個蒙面的殺手，是她的私生女。"

msgid "你向无名老妇问起令牌：令牌在她女儿身上。"
msgstr "你向無名老婦問起令牌：令牌在她女兒身上。"

msgid "你得到了一个黑木做的杀手令牌，上面刻著火焰的图腾标志。"
msgstr "你得到了一個黑木做的殺手令牌，上面刻著火焰的圖騰標誌。"

msgid "你把杀手令牌交给无名老妇，她叹了口气，给了你一本寒雪鞭法密笈作为感谢。"
msgstr "你把殺手令牌交給無名老婦，她嘆了口氣，給了你一本寒雪鞭法密笈作為感謝。"

msgid "密函"
msgstr "密函"

msgid "你得到了芙云身上的一封密函，信用蜡封著，上面有一个奇怪的图案。"
msgstr "你得到了芙雲身上的一封密函，信用蠟封著，上面有一個奇怪的圖案。"

msgid "山药蛋"
msgstr "山藥蛋"

msgid "你在青石峪遇见一位采药老者，他心疼你饿得面黄肌瘦，从小布包里拿出个山药蛋塞到你手里。"
msgstr "你在青石峪遇見一位採藥老者，他心疼你餓得面黃肌瘦，從小布包裡拿出個山藥蛋塞到你手裡。"

msgid "草堂的书"
msgstr "草堂的書"

msgid "你在隐士的草堂里趁人不备，从矮几上抓起一本书藏入怀中。"
msgstr "你在隱士的草堂裡趁人不備，從矮几上抓起一本書藏入懷中。"

msgid "桃木箱"
msgstr "桃木箱"

msgid "你向福林酒楼里的武官打听传闻。"
msgstr "你向福林酒樓裡的武官打聽傳聞。"

msgid "你在树王坟内部找到一个刻工精细的桃木箱。"
msgstr "你在樹王墳內部找到一個刻工精細的桃木箱。"

msgid "你把桃木箱还给武官，他说出门在外没带太多银两，送你一本古书「白杨经」作为报答。"
msgstr "你把桃木箱還給武官，他說出門在外沒帶太多銀兩，送你一本古書「白楊經」作為報答。"

msgid "荷包"
msgstr "荷包"

msgid "你在福林酒楼二楼向贵公子问起他的心事。"
msgstr "你在福林酒樓二樓向貴公子問起他的心事。"

msgid "你向曲桥上的官家小姐提起游晋，她吞吞吐吐地托你把一个紫罗鸳鸯荷包交给游公子。"
msgstr "你向曲橋上的官家小姐提起游晉，她吞吞吐吐地託你把一個紫羅鴛鴦荷包交給游公子。"

msgid "骆云舟死后，风泉之剑掉落在地，又飘了起来，一个人形忽然浮现，手中正握著风泉之剑。"
msgstr "駱雲舟死後，風泉之劍掉落在地，又飄了起來，一個人形忽然浮現，手中正握著風泉之劍。"

msgid "你得到了步玄派历代相传的掌门信物——风泉之剑。"
msgstr "你得到了步玄派歷代相傳的掌門信物——風泉之劍。"

msgid "你向骆云舟拜师，他说：你还是先走一趟东边的桃林吧。"
msgstr "你向駱雲舟拜師，他說：你還是先走一趟東邊的桃林吧。"

msgid "你读着树上的字条找路，走出了曼雩台东边的桃林。"
msgstr "你讀著樹上的字條找路，走出了曼雩臺東邊的桃林。"

msgid "你在绝壁上的山洞里得到一条金丝编成、刻满咒文的缚仙绳。"
msgstr "你在絕壁上的山洞裡得到一條金絲編成、刻滿咒文的縛仙繩。"

msgid "你在云台向紫衣童子问起仙人。"
msgstr "你在雲臺向紫衣童子問起仙人。"

msgid "你在丹炉里得到了仙丹。"
msgstr "你在丹爐裡得到了仙丹。"

msgid "你在寒谷尽头采到一株寒谷幽兰，淡淡的香气似乎在哪里闻到过。"
msgstr "你在寒谷盡頭採到一株寒谷幽蘭，淡淡的香氣似乎在哪裡聞到過。"

msgid "军营"
msgstr "軍營"

msgid "你向大队长打听黄石隘口，他讲起二十多年前先帝调大将军们驻守隘口的往事。"
msgstr "你向大隊長打聽黃石隘口，他講起二十多年前先帝調大將軍們駐守隘口的往事。"

msgid "你向大队长问起允许。"
msgstr "你向大隊長問起允許。"

msgid "你前后交给大队长三十两银子，他把你列入名册，说从今天起你可以自由出入营区。"
msgstr "你前後交給大隊長三十兩銀子，他把你列入名冊，說從今天起你可以自由出入營區。"

msgid "印鉴"
msgstr "印鑑"

msgid "你在将军营帐向严廷殷打听印鉴。"
msgstr "你在將軍營帳向嚴廷殷打聽印鑑。"

msgid "你向大队长打听兵器库。"
msgstr "你向大隊長打聽兵器庫。"

msgid "你向军师赫造基打听兵器库。"
msgstr "你向軍師赫造基打聽兵器庫。"

msgid "你交给军师赫造基八两银子，他告诉你一项秘密：在那片光滑的山壁前发誓「我爱……」，或许可以发现奇特的事。"
msgstr "你交給軍師赫造基八兩銀子，他告訴你一項秘密：在那片光滑的山壁前發誓「我愛……」，或許可以發現奇特的事。"

msgid "你在光滑的山壁前发了誓，一阵强光轰隆过后，来到一处兵器库，见到一名后备兵。"
msgstr "你在光滑的山壁前發了誓，一陣強光轟隆過後，來到一處兵器庫，見到一名後備兵。"

msgid "你交给后备兵三两黄金，他说你不愧是武林中人，一眼就看出端倪，用一方印鉴和你交换。"
msgstr "你交給後備兵三兩黃金，他說你不愧是武林中人，一眼就看出端倪，用一方印鑑和你交換。"

msgid "你把那方印鉴交给严廷殷，他喝道别想拿这种东西来骗他，把你赶到了营火区。"
msgstr "你把那方印鑑交給嚴廷殷，他喝道別想拿這種東西來騙他，把你趕到了營火區。"

msgid "后备兵见被你识破，只好认栽，换给你一方泛著黄光的印鉴。"
msgstr "後備兵見被你識破，只好認栽，換給你一方泛著黃光的印鑑。"

msgid "你把印鉴交给严廷殷，他连声道谢，送你一把古剑作为报酬。"
msgstr "你把印鑑交給嚴廷殷，他連聲道謝，送你一把古劍作為報酬。"

msgid "你在洞内石室的书柜里找到一个铜制的书匣。"
msgstr "你在洞內石室的書櫃裡找到一個銅製的書匣。"

msgid "书匣里是一本《悟疾风劲竹书》，书末署名柳淳风。"
msgstr "書匣裡是一本《悟疾風勁竹書》，書末署名柳淳風。"

msgid "你在瓜地里摘西瓜，被瓜农逮了个正着。"
msgstr "你在瓜地裡摘西瓜，被瓜農逮了個正著。"

msgid "你在湖底的水下岩洞里撞见了浑身长满白鳞的冰龙。"
msgstr "你在湖底的水下岩洞裡撞見了渾身長滿白鱗的冰龍。"

msgid "小娟"
msgstr "小娟"

msgid "你向玉螺湖村的采花妞打听小娟。"
msgstr "你向玉螺湖村的採花妞打聽小娟。"

msgid "你向黑松堡的女佣人打听小娟。"
msgstr "你向黑松堡的女傭人打聽小娟。"

msgid "你在黑松堡地牢的刑房里见到了刘老农的女儿小娟，她已被折磨得遍体鳞伤。"
msgstr "你在黑松堡地牢的刑房裡見到了劉老農的女兒小娟，她已被折磨得遍體鱗傷。"

msgid "小娟从绳索里挣脱出来，跟着你走了。"
msgstr "小娟從繩索裡掙脫出來，跟著你走了。"

msgid "你从刘老农那里得到了一柄銮鱼衡冰。"
msgstr "你從劉老農那裡得到了一柄鑾魚衡冰。"

msgid "小娟死在了你的手里。"
msgstr "小娟死在了你的手裡。"

msgid "刘老农得知你杀了他的女儿，悲愤欲绝，要找你拼命。"
msgstr "劉老農得知你殺了他的女兒，悲憤欲絕，要找你拼命。"

msgid "你赏了太白酒楼的店小二十两银子，他笑着道谢。"
msgstr "你賞了太白酒樓的店小二十兩銀子，他笑著道謝。"

msgid "你向京师的行人问起买官。"
msgstr "你向京師的行人問起買官。"

msgid "你塞给尚书府的门房三两黄金，他说：这位大人，里面请！"
msgstr "你塞給尚書府的門房三兩黃金，他說：這位大人，裡面請！"

msgid "出城令牌"
msgstr "出城令牌"

msgid "你向京师守城兵问起出城。"
msgstr "你向京師守城兵問起出城。"

msgid "你在废园的草丛里找到一块遗失多年的出城令牌。"
msgstr "你在廢園的草叢裡找到一塊遺失多年的出城令牌。"

msgid "你把令牌交给京师守城兵，他连忙说：原来是官府中人。"
msgstr "你把令牌交給京師守城兵，他連忙說：原來是官府中人。"

msgid "官府悬赏"
msgstr "官府懸賞"

msgid "你在雪亭驿门外揭下了一张官府悬赏告示，照告示上说的地方去找那个恶人。"
msgstr "你在雪亭驛門外揭下了一張官府懸賞告示，照告示上說的地方去找那個惡人。"

msgid "你第一次领到了雪亭驿的悬赏。告示上隔些时候就会贴出新的。"
msgstr "你第一次領到了雪亭驛的懸賞。告示上隔些時候就會貼出新的。"

msgid "入门"
msgstr "入門"

msgid "初入江湖"
msgstr "初入江湖"

msgid "走近一个人、一件东西，脚下会出现「交互」和该按的键（键盘、手柄各画各的）。按那个键或点它，能做的事都列在交互窗口里；只有一件事可做的，直接就做了。"
msgstr "走近一個人、一件東西，腳下會出現「互動」和該按的鍵（鍵盤、手把各畫各的）。按那個鍵或點它，能做的事都列在互動視窗裡；只有一件事可做的，直接就做了。"

msgid "不知道往哪里去，就找人「打听」。镇上的人知道这里的事和附近的传闻，有些话题问出来就是一条路。你见过、听过的事都记在菜单的「任务」页，状态卡上的「目标」一行写着眼下最要紧的那件。"
msgstr "不知道往哪裡去，就找人「打聽」。鎮上的人知道這裡的事和附近的傳聞，有些話題問出來就是一條路。你見過、聽過的事都記在選單的「任務」頁，狀態卡上的「目標」一行寫著眼下最要緊的那件。"

msgid "菜单有八页：角色、武学、背包、任务、地图、声望、百科、系统。地图页是一张沙盘，走过的地方都立着模型；说明卡上列着师父、商店、悬赏榜，点一行就给你指路。"
msgstr "選單有八頁：角色、武學、背包、任務、地圖、聲望、百科、系統。地圖頁是一張沙盤，走過的地方都立著模型；說明卡上列著師父、商店、懸賞榜，點一行就給你指路。"

msgid "系统页里有三个存档位。换地图、打完一仗也会自动存一份，死了可以回到那里。"
msgstr "系統頁裡有三個存檔位。換地圖、打完一仗也會自動存一份，死了可以回到那裡。"

msgid "先做什么"
msgstr "先做什麼"

msgid "先在镇上走一圈，和人说说话。饮风客栈的店小二卖吃喝；想学武，就去淳风武馆看看，那里的人肯指点新人。"
msgstr "先在鎮上走一圈，和人說說話。飲風客棧的店小二賣吃喝；想學武，就去淳風武館看看，那裡的人肯指點新人。"

msgid "打不过的人别硬碰：交互窗口和动手前的确认页都会写出对方比你强还是弱。"
msgstr "打不過的人別硬碰：互動視窗和動手前的確認頁都會寫出對方比你強還是弱。"

msgid "地理"
msgstr "地理"

msgid "雪亭镇在群山之中。镇北的山坳往北是野羊山，往东通青石村。出镇往西，顺着青石官道上山，是天邪派的水烟阁。镇东的大路通到茅山，茅山派的灵心观就在山上；这条路上有岔路往南进老松岭的松林，传说老松寨就在附近，过往的旅客都要格外小心。"
msgstr "雪亭鎮在群山之中。鎮北的山坳往北是野羊山，往東通青石村。出鎮往西，順著青石官道上山，是天邪派的水煙閣。鎮東的大路通到茅山，茅山派的靈心觀就在山上；這條路上有岔路往南進老松嶺的松林，傳說老松寨就在附近，過往的旅客都要格外小心。"

msgid "镇南的大街通到绮云镇；往西南走是天驼关。"
msgstr "鎮南的大街通到綺雲鎮；往西南走是天駝關。"

msgid "绮云镇往西是晚月庄，庄里多是女子。往南过了渡口是日照山，山烟寺就在山上；过渡口往东走，就到乔阴县城。"
msgstr "綺雲鎮往西是晚月莊，莊裡多是女子。往南過了渡口是日照山，山煙寺就在山上；過渡口往東走，就到喬陰縣城。"

msgid "人身上最要紧的是「精」「气」「神」三样。"
msgstr "人身上最要緊的是「精」「氣」「神」三樣。"

msgid "学东西的本钱。请教、自学、修行都耗精。"
msgstr "學東西的本錢。請教、自學、修行都耗精。"

msgid "身体的力气。挨打掉的是气，练功、打坐也耗气。"
msgstr "身體的力氣。挨打掉的是氣，練功、打坐也耗氣。"

msgid "心神。研读、冥思都耗神，迷药和蒙汗药伤的也是神。"
msgstr "心神。研讀、冥思都耗神，迷藥和蒙汗藥傷的也是神。"

msgid "当前、有效、最大"
msgstr "當前、有效、最大"

msgid "角色页上每样有三个数。「当前」是眼下还剩多少，歇一歇就回来；「有效」是受伤压低的上限，当前最多只回到这里；「最大」是你的本钱。"
msgstr "角色頁上每樣有三個數。「當前」是眼下還剩多少，歇一歇就回來；「有效」是受傷壓低的上限，當前最多只回到這裡；「最大」是你的本錢。"

msgid "比如气写着当前 67、有效 82、最大 100：说明你受了些伤，歇着最多回到 82。那 18 点伤要等当前回满了才慢慢长回来，用药或疗伤更快。"
msgstr "比如氣寫著當前 67、有效 82、最大 100：說明你受了些傷，歇著最多回到 82。那 18 點傷要等當前回滿了才慢慢長回來，用藥或療傷更快。"

msgid "三样里哪一样的当前打光了，人就昏倒；伤到连有效也撑不住，就会送命。"
msgstr "三樣裡哪一樣的當前打光了，人就昏倒；傷到連有效也撐不住，就會送命。"

msgid "「最大」不是一成不变的：内力的上限越高，气的本钱越厚；法力、灵力的上限高了，神和精的本钱也跟着长。"
msgstr "「最大」不是一成不變的：內力的上限越高，氣的本錢越厚；法力、靈力的上限高了，神和精的本錢也跟著長。"

msgid "受伤与歇息"
msgstr "受傷與歇息"

msgid "不打架的时候，精气神会自己慢慢回来：先回当前，当前回满了，伤才慢慢好。战斗中不回。回复要时间走：菜单和交互窗口开着时时间停住，什么都不回。"
msgstr "不打架的時候，精氣神會自己慢慢回來：先回當前，當前回滿了，傷才慢慢好。戰鬥中不回。回復要時間走：選單和互動視窗開著時時間停住，什麼都不回。"

msgid "想歇就歇：请教页和武学页上的「歇到回满」让你坐下来，时间照走（快得多），精气神回满就起身；连续修炼练到一半没了力气，也会自己这样歇一歇再接着练。世界不会等你：歇着时有人来找麻烦，你会被惊起，照常开打；口渴没水的时候歇着也回不来。"
msgstr "想歇就歇：請教頁和武學頁上的「歇到回滿」讓你坐下來，時間照走（快得多），精氣神回滿就起身；連續修煉練到一半沒了力氣，也會自己這樣歇一歇再接著練。世界不會等你：歇著時有人來找麻煩，你會被驚起，照常開打；口渴沒水的時候歇著也回不來。"

msgid "想快一点：金疮药敷上能治伤；学了内功的人可以运功恢复精、气、神，有的内功还能运功疗伤，耗的都是内力。战斗中不能疗伤。"
msgstr "想快一點：金瘡藥敷上能治傷；學了內功的人可以運功恢復精、氣、神，有的內功還能運功療傷，耗的都是內力。戰鬥中不能療傷。"

msgid "昏倒以后过一会儿自己会醒。昏着的时候任人宰割，所以别在仇人眼前耗到最后一口气。"
msgstr "昏倒以後過一會兒自己會醒。昏著的時候任人宰割，所以別在仇人眼前耗到最後一口氣。"

msgid "中了毒、喝醉了，身上会一阵阵发作。蛇药解蛇毒，酒要等它自己醒。"
msgstr "中了毒、喝醉了，身上會一陣陣發作。蛇藥解蛇毒，酒要等它自己醒。"

msgid "吃喝"
msgstr "吃喝"

msgid "食物和饮水随时间慢慢消耗，角色页上看得到还剩多少。一开始都是满的。"
msgstr "食物和飲水隨時間慢慢消耗，角色頁上看得到還剩多少。一開始都是滿的。"

msgid "食物吃光了，内力、法力、灵力就不再恢复；水喝光了，什么都不再恢复。"
msgstr "食物吃光了，內力、法力、靈力就不再恢復；水喝光了，什麼都不再恢復。"

msgid "客栈、饭馆和集市都卖吃喝。牛皮酒袋能灌清水，路上渴了拿出来喝。酒也能解渴，只是喝多了会醉。"
msgstr "客棧、飯館和集市都賣吃喝。牛皮酒袋能灌清水，路上渴了拿出來喝。酒也能解渴，只是喝多了會醉。"

msgid "肚子能装多少看你的体重。吃剩的肉骨头别扔，喂给狗，它会跟着你走。"
msgstr "肚子能裝多少看你的體重。吃剩的肉骨頭別扔，餵給狗，它會跟著你走。"

msgid "人生来有八项天赋，新入江湖时都是 30。天赋很少变动，勤练武艺偶尔会长一点。"
msgstr "人生來有八項天賦，新入江湖時都是 30。天賦很少變動，勤練武藝偶爾會長一點。"

msgid "力气。打得更重，背得更多，拿得动沉重的兵器。"
msgstr "力氣。打得更重，背得更多，拿得動沉重的兵器。"

msgid "敢不敢抢攻。自动对打时，胆识高的人出手更勤；不少师父收徒也看它。"
msgstr "敢不敢搶攻。自動對打時，膽識高的人出手更勤；不少師父收徒也看它。"

msgid "天资。学武功更快、耗精更少，打架时也更容易长进。"
msgstr "天資。學武功更快、耗精更少，打架時也更容易長進。"

msgid "精神方面的体质。冥思、修行长得快，不少法门也看它。"
msgstr "精神方面的體質。冥思、修行長得快，不少法門也看它。"

msgid "临危不乱。对手想抢攻要先过你这一关；打空了也不容易露破绽，还压得住杀气。"
msgstr "臨危不亂。對手想搶攻要先過你這一關；打空了也不容易露破綻，還壓得住殺氣。"

msgid "长相。有人看脸说话，也有师父看长相收人。"
msgstr "長相。有人看臉說話，也有師父看長相收人。"

msgid "体质。精气神恢复得快，打坐长内力快，昏倒后醒得早，酒量也大。"
msgstr "體質。精氣神恢復得快，打坐長內力快，昏倒後醒得早，酒量也大。"

msgid "运气。容易遇上一般人碰不到的机缘，好事坏事都有。"
msgstr "運氣。容易遇上一般人碰不到的機緣，好事壞事都有。"

msgid "药物、装备带来的变化只算眼下；学东西看的是天赋本身。天赋不好也不必灰心：它只在武功还浅的时候看得出来，功夫练深了，差别就小了。"
msgstr "藥物、裝備帶來的變化只算眼下；學東西看的是天賦本身。天賦不好也不必灰心：它只在武功還淺的時候看得出來，功夫練深了，差別就小了。"

msgid "学武"
msgstr "學武"

msgid "武功分两层。基本拳脚、基本剑法、基本内功这些「基本功夫」是根基；柳家拳、封山剑法这些「特殊武功」要在武学页「激发」到对应的基本功夫上才用得出来。真打起来，看的是两者合起来的等级。"
msgstr "武功分兩層。基本拳腳、基本劍法、基本內功這些「基本功夫」是根基；柳家拳、封山劍法這些「特殊武功」要在武學頁「激發」到對應的基本功夫上才用得出來。真打起來，看的是兩者合起來的等級。"

msgid "向师父或肯教你的人请教，每次耗精和一点潜能，第一次学一门新功夫耗的精加倍。学到的不能超过教你的人，也受实战经验限制：等级越高，要的实战经验越多。请教页写着你能学到几级、卡在哪里。"
msgstr "向師父或肯教你的人請教，每次耗精和一點潛能，第一次學一門新功夫耗的精加倍。學到的不能超過教你的人，也受實戰經驗限制：等級越高，要的實戰經驗越多。請教頁寫著你能學到幾級、卡在哪裡。"

msgid "激发好的特殊武功可以在武学页练习，耗气。它最多练到和底下的基本功夫一样高，再往上，得先把基本功夫学上去。"
msgstr "激發好的特殊武功可以在武學頁練習，耗氣。它最多練到和底下的基本功夫一樣高，再往上，得先把基本功夫學上去。"

msgid "基本拳脚、基本剑法、基本刀法、基本杖法、基本招架、基本轻功、基本内功这七门，到了 40 级就能自己琢磨着往上练，耗精和潜能，不必找人。特殊武功不能自学。"
msgstr "基本拳腳、基本劍法、基本刀法、基本杖法、基本招架、基本輕功、基本內功這七門，到了 40 級就能自己琢磨著往上練，耗精和潛能，不必找人。特殊武功不能自學。"

msgid "得了拳谱、刀谱、经书，会读书识字就能研读。研读耗神、不花潜能；读书识字越高，每次读懂的越多。"
msgstr "得了拳譜、刀譜、經書，會讀書識字就能研讀。研讀耗神、不花潛能；讀書識字越高，每次讀懂的越多。"

msgid "实战经验与潜能"
msgstr "實戰經驗與潛能"

msgid "打架、办差事、走完一段经历，都能得到实战经验和潜能。实战经验决定武功能学多高；潜能是请教和自学的花销，没用掉的有上限，攒满了就该去学了。"
msgstr "打架、辦差事、走完一段經歷，都能得到實戰經驗和潛能。實戰經驗決定武功能學多高；潛能是請教和自學的花銷，沒用掉的有上限，攢滿了就該去學了。"

msgid "打中比自己强的对手时，偶尔也能长一点功夫。"
msgstr "打中比自己強的對手時，偶爾也能長一點功夫。"

msgid "请教、练习、打坐、冥思、修行都能「连续」做下去：精、气、神不够了就自己歇一歇，回满了接着练，练到潜能用完、功夫长了一级或做不下去的一步才停，并告诉你为什么。"
msgstr "請教、練習、打坐、冥思、修行都能「連續」做下去：精、氣、神不夠了就自己歇一歇，回滿了接著練，練到潛能用完、功夫長了一級或做不下去的一步才停，並告訴你為什麼。"

msgid "拜师与门派"
msgstr "拜師與門派"

msgid "门派是学武的正路。拜师大致有三种：有的师父看你的天赋和功夫够不够，有的要你立誓，有的要你先过一场考验。交互窗口里还够不上的「拜师」会灰掉，写着还差什么；拜师页列出条件和你自己的数。"
msgstr "門派是學武的正路。拜師大致有三種：有的師父看你的天賦和功夫夠不夠，有的要你立誓，有的要你先過一場考驗。互動視窗裡還夠不上的「拜師」會灰掉，寫著還差什麼；拜師頁列出條件和你自己的數。"

msgid "一个人同时只能有一位师父。师父教本门功夫最用心；别的人肯教，多半要你先替他做点事，或者付些钱。"
msgstr "一個人同時只能有一位師父。師父教本門功夫最用心；別的人肯教，多半要你先替他做點事，或者付些錢。"

msgid "改投别派之前会先问你。背叛师门要扣综合评价，往后的师父也不那么信你，教到一定程度就不肯再教；杀了自己的师父，也算背叛。"
msgstr "改投別派之前會先問你。背叛師門要扣綜合評價，往後的師父也不那麼信你，教到一定程度就不肯再教；殺了自己的師父，也算背叛。"

msgid "门派、帮会与山寨"
msgstr "門派、幫會與山寨"

msgid "门派重师门伦理和辈分，以入门先后排序，大多不许弟子再投别家。帮会、教派不以传授武功为主，帮规偏重要你去做事，进出也比门派容易。山寨、镖局、庄院规模小，入伙不易，入了以后有活干、有报酬。"
msgstr "門派重師門倫理和輩分，以入門先後排序，大多不許弟子再投別家。幫會、教派不以傳授武功為主，幫規偏重要你去做事，進出也比門派容易。山寨、鏢局、莊院規模小，入夥不易，入了以後有活幹、有報酬。"

msgid "角色页名字前方括号里写的是你的身份。一开始都是普通百姓；入了门派、出了家，身份会跟着变，往后的作为也会改它。"
msgstr "角色頁名字前方括號裡寫的是你的身份。一開始都是普通百姓；入了門派、出了家，身份會跟著變，往後的作為也會改它。"

msgid "见过门人的门派收在百科「门派」里；各家怎么看你，写在声望页。"
msgstr "見過門人的門派收在百科「門派」裡；各家怎麼看你，寫在聲望頁。"

msgid "内力是武者的第二条命，打人和挨打都看它。"
msgstr "內力是武者的第二條命，打人和挨打都看它。"

msgid "学了基本内功，再把一门特殊内功激发上去，就能在武学页打坐：耗气，把气炼成内力存起来。存过了上限再坐下去，上限就慢慢往上长；能长多高，看基本内功的等级。连续打坐可以定一个数，练到就停。"
msgstr "學了基本內功，再把一門特殊內功激發上去，就能在武學頁打坐：耗氣，把氣煉成內力存起來。存過了上限再坐下去，上限就慢慢往上長；能長多高，看基本內功的等級。連續打坐可以定一個數，練到就停。"

msgid "每一击多灌进一些内力，打得更重，内力也耗得更快。战斗里取「攻」的姿态，会顺手把加力开到一半。"
msgstr "每一擊多灌進一些內力，打得更重，內力也耗得更快。戰鬥裡取「攻」的姿態，會順手把加力開到一半。"

msgid "各门内功的本事不一样：有的能恢复精、气、神，有的能疗伤，有的能压下杀气、提升战斗力。百科「武学」里每门内功都写着它能运哪些。运功耗内力，战斗里也能用。"
msgstr "各門內功的本事不一樣：有的能恢復精、氣、神，有的能療傷，有的能壓下殺氣、提升戰鬥力。百科「武學」裡每門內功都寫著它能運哪些。運功耗內力，戰鬥裡也能用。"

msgid "法力与灵力"
msgstr "法力與靈力"

msgid "法门在江湖上分两路。一路念咒施法，茅山道术、奇门遁甲都属这一路，耗的是法力；一路是出自修行者自身的神通，佛门的八识神通属这一路，耗的是灵力。"
msgstr "法門在江湖上分兩路。一路念咒施法，茅山道術、奇門遁甲都屬這一路，耗的是法力；一路是出自修行者自身的神通，佛門的八識神通屬這一路，耗的是靈力。"

msgid "学了基本咒文才用得上。在武学页冥思，耗神，把法力一点点聚起来；上限看基本咒文。"
msgstr "學了基本咒文才用得上。在武學頁冥思，耗神，把法力一點點聚起來；上限看基本咒文。"

msgid "学了基本法术才用得上。在武学页修行，耗精，把精炼成灵力；上限看基本法术。"
msgstr "學了基本法術才用得上。在武學頁修行，耗精，把精煉成靈力；上限看基本法術。"

msgid "两样都和内力一样：存过了上限再练，上限就长。灵性高的人长得快。还没学这一路的时候，角色页和武学页都不显示它们。"
msgstr "兩樣都和內力一樣：存過了上限再練，上限就長。靈性高的人長得快。還沒學這一路的時候，角色頁和武學頁都不顯示它們。"

msgid "战斗"
msgstr "戰鬥"

msgid "动手有两种。「切磋」点到为止，谁先实实在在打中对方一下就算赢，事后谁也不记仇；只是拿着兵刃切磋，一样会见血。「攻击」是死斗，打到一方送命为止；乱杀无辜，往后的日子就不好过了。"
msgstr "動手有兩種。「切磋」點到為止，誰先實實在在打中對方一下就算贏，事後誰也不記仇；只是拿著兵刃切磋，一樣會見血。「攻擊」是死鬥，打到一方送命為止；亂殺無辜，往後的日子就不好過了。"

msgid "动手之前会先问你一句，写明对方比你强还是弱：稳赢、占优、五五开、吃亏、必败。"
msgstr "動手之前會先問你一句，寫明對方比你強還是弱：穩贏、佔優、五五開、吃虧、必敗。"

msgid "出招"
msgstr "出招"

msgid "战斗时世界停住，回合等你出招。一回合你有两手，对手看身手有一到两手；你点一招就结算一手，接着轮到对手。"
msgstr "戰鬥時世界停住，回合等你出招。一回合你有兩手，對手看身手有一到兩手；你點一招就結算一手，接著輪到對手。"

msgid "招式分快、重、虚、守四种：快克重，重克守，守克虚，虚克快。重招占两手，打实了伤得重，还能打掉对手一手；落空了就露出空门。"
msgstr "招式分快、重、虛、守四種：快克重，重克守，守克虛，虛克快。重招佔兩手，打實了傷得重，還能打掉對手一手；落空了就露出空門。"

msgid "姿态有三种：攻，伤得重、自己也好打；守，招架高、伤得轻；游走，闪躲高、命中低。点「改为自动」就让它自己打下去。"
msgstr "姿態有三種：攻，傷得重、自己也好打；守，招架高、傷得輕；遊走，閃躲高、命中低。點「改為自動」就讓它自己打下去。"

msgid "识招"
msgstr "識招"

msgid "一路招式看熟两回，就认得它是快是重、怕什么；自家门派的招一学就认得。见过的招都记在百科「武学」的见识录里。"
msgstr "一路招式看熟兩回，就認得它是快是重、怕什麼；自家門派的招一學就認得。見過的招都記在百科「武學」的見識錄裡。"

msgid "有些门派的功夫能多挣一手：封山剑法等对手打空，柳家拳贴身打实。"
msgstr "有些門派的功夫能多掙一手：封山劍法等對手打空，柳家拳貼身打實。"

msgid "一伙人"
msgstr "一夥人"

msgid "见人就打的一伙，只要有一个够得着你，就会一起上。人多的时候，先想好再进门。"
msgstr "見人就打的一夥，只要有一個夠得著你，就會一起上。人多的時候，先想好再進門。"

msgid "认输、逃跑与生死"
msgstr "認輸、逃跑與生死"

msgid "逃跑不耗什么，脱离战斗，人还留在原地。"
msgstr "逃跑不耗什麼，脫離戰鬥，人還留在原地。"

msgid "认输：要你命的人还站着时，他不让你降；否则就此停手，扣一些综合评价。"
msgstr "認輸：要你命的人還站著時，他不讓你降；否則就此停手，扣一些綜合評價。"

msgid "对手被你打倒时，会停下来问你「了结」还是「放过」，放过的人不记仇。设置里可以改成直接了结。有些人往后还用得着，只能打倒，杀不死。"
msgstr "對手被你打倒時，會停下來問你「了結」還是「放過」，放過的人不記仇。設定裡可以改成直接了結。有些人往後還用得著，只能打倒，殺不死。"

msgid "死了以后"
msgstr "死了以後"

msgid "人死了变成鬼魂，从鬼门关走一趟阴间，回到阳世。死一回只扣一点实战经验，武功和潜能都不动，杀气清零。"
msgstr "人死了變成鬼魂，從鬼門關走一趟陰間，回到陽世。死一回只扣一點實戰經驗，武功和潛能都不動，殺氣清零。"

msgid "身上的东西都留在尸体上，尸体不会腐烂，等你回去取。不想走阴间，也可以回到上次的自动存档。"
msgstr "身上的東西都留在屍體上，屍體不會腐爛，等你回去取。不想走陰間，也可以回到上次的自動存檔。"

msgid "兵器与护具"
msgstr "兵器與護具"

msgid "伤人靠的首先是功夫，其次才是兵器。剑用剑法、刀用刀法，空手用拳脚；兵器的种类不同，伤法也不同，割伤、刺伤、砸伤各不一样。"
msgstr "傷人靠的首先是功夫，其次才是兵器。劍用劍法、刀用刀法，空手用拳腳；兵器的種類不同，傷法也不同，割傷、刺傷、砸傷各不一樣。"

msgid "越重的兵器伤得越重，但要称手：拿不拿得动看膂力。锤和杖砸下去，能把对手的兵器打飞，甚至砸断。另一只手也能拿兵器，它的分量一样算数。"
msgstr "越重的兵器傷得越重，但要稱手：拿不拿得動看膂力。錘和杖砸下去，能把對手的兵器打飛，甚至砸斷。另一隻手也能拿兵器，它的分量一樣算數。"

msgid "护具有衣服、盔甲、帽子、项链、护腕、腰带、鞋、戒指，还有盾。一身衣服连裤子算一件。护得越好越重，重兵器和重盔甲都会拖慢你的轻功，物品说明上写着拖多少。"
msgstr "護具有衣服、盔甲、帽子、項鍊、護腕、腰帶、鞋、戒指，還有盾。一身衣服連褲子算一件。護得越好越重，重兵器和重盔甲都會拖慢你的輕功，物品說明上寫著拖多少。"

msgid "背包页选中一件，右边就是它的样子和说明。"
msgstr "背包頁選中一件，右邊就是它的樣子和說明。"

msgid "杀气与名声"
msgstr "殺氣與名聲"

msgid "杀人会长杀气，胆气也跟着壮。杀气太重，学不了佛道两家的心法，还可能失手伤人。运功压制或到庙里捐香火，能把它压下去。"
msgstr "殺人會長殺氣，膽氣也跟著壯。殺氣太重，學不了佛道兩家的心法，還可能失手傷人。運功壓制或到廟裡捐香火，能把它壓下去。"

msgid "江湖上对你的总评。办成差事会涨，认输会掉，背叛师门扣得最狠。"
msgstr "江湖上對你的總評。辦成差事會漲，認輸會掉，背叛師門扣得最狠。"

msgid "打过交道的势力，在声望页各有一张卡，写着那一家对你的看法；哪一家都还不认得你时，那里是空的。"
msgstr "打過交道的勢力，在聲望頁各有一張卡，寫著那一家對你的看法；哪一家都還不認得你時，那裡是空的。"

msgid "角色页还记着你亲手杀过多少人。"
msgstr "角色頁還記著你親手殺過多少人。"

msgid "银两与行路"
msgstr "銀兩與行路"

msgid "钱有黄金、白银、铜钱三种：一两银子是一百文，一两黄金是一百两银子。付钱先用大的；钱庄能兑换。"
msgstr "錢有黃金、白銀、銅錢三種：一兩銀子是一百文，一兩黃金是一百兩銀子。付錢先用大的；錢莊能兌換。"

msgid "当铺按八折收你的东西，不做典当和赎回。不值钱的东西丢下就没了，丢之前会先问你一句；办事要用的东西丢不掉。"
msgstr "當鋪按八折收你的東西，不做典當和贖回。不值錢的東西丟下就沒了，丟之前會先問你一句；辦事要用的東西丟不掉。"

msgid "城里的悬赏榜上贴着差事，办成了有赏，也算一段历练。"
msgstr "城裡的懸賞榜上貼著差事，辦成了有賞，也算一段歷練。"

msgid "七座城镇和五个门派的山门都停着车。在车旁「坐车」，在沙盘上挑一站；只去你走到过、路也走通了的地方。车钱十几到五十几文，路上要花些时辰。"
msgstr "七座城鎮和五個門派的山門都停著車。在車旁「坐車」，在沙盤上挑一站；只去你走到過、路也走通了的地方。車錢十幾到五十幾文，路上要花些時辰。"

msgid "传说"
msgstr "傳說"

msgid "主题故事"
msgstr "主題故事"

msgid "这个时代，东方世界已经有了相当高水准的文明。由于东方大陆实在太大，航海技术并不受重视。我们的故事，就从一个山中小镇——雪亭镇说起。"
msgstr "這個時代，東方世界已經有了相當高水準的文明。由於東方大陸實在太大，航海技術並不受重視。我們的故事，就從一個山中小鎮——雪亭鎮說起。"

msgid "时间是天朝佑圣元年，岁次甲子，年仅十六岁的皇帝刚刚登基，雪亭镇上熙来攘往，一队身着白衣的朝廷武官和两名老者在镇前的广场中坐着，四面来来往往的人当中，有不少显然是武林中人，正探头探脑地向着广场张望。"
msgstr "時間是天朝佑聖元年，歲次甲子，年僅十六歲的皇帝剛剛登基，雪亭鎮上熙來攘往，一隊身著白衣的朝廷武官和兩名老者在鎮前的廣場中坐著，四面來來往往的人當中，有不少顯然是武林中人，正探頭探腦地向著廣場張望。"

msgid "正纷扰间，一匹快马冲进了广场，两名老者立即站了起来。"
msgstr "正紛擾間，一匹快馬衝進了廣場，兩名老者立即站了起來。"

msgid "马上乘客一跃而下，快步走到老者身前，躬身说道：「禀将军，时辰已到，白道长命下官回禀，方位是在……」，说着压低了声音。"
msgstr "馬上乘客一躍而下，快步走到老者身前，躬身說道：「稟將軍，時辰已到，白道長命下官回稟，方位是在……」，說著壓低了聲音。"

msgid "不料一名老者忽然说道：「大声点，让众位兄弟都听见了。」"
msgstr "不料一名老者忽然說道：「大聲點，讓眾位兄弟都聽見了。」"

msgid "那人一怔，随即大声说道：「方位是在西南二十四里，黄石隘口。」"
msgstr "那人一怔，隨即大聲說道：「方位是在西南二十四里，黃石隘口。」"

msgid "只见坐着的白衣武官相互交头接耳，四周围观的人纷纷向外走去，看似杂乱无章，其实倒有一大半正往西南走去，两名老者不动声色，只静静地瞧着众人的动向。"
msgstr "只見坐著的白衣武官相互交頭接耳，四周圍觀的人紛紛向外走去，看似雜亂無章，其實倒有一大半正往西南走去，兩名老者不動聲色，只靜靜地瞧著眾人的動向。"

msgid "过了约一盏茶的时间，其中一名老者做了个手势，所有白衣武官倏地站起，然后跟着两名老者身后缓缓地往西南方向离去。"
msgstr "過了約一盞茶的時間，其中一名老者做了個手勢，所有白衣武官倏地站起，然後跟著兩名老者身後緩緩地往西南方向離去。"

msgid "广场西边一家小客栈里，一个年约十四岁的少年问店里的小二道：「这些人神秘得紧，却不知到底在玩什么把戏？」"
msgstr "廣場西邊一家小客棧裡，一個年約十四歲的少年問店裡的小二道：「這些人神秘得緊，卻不知到底在玩什麼把戲？」"

msgid "小二抄起脖子上的毛巾，抹了抹脸，说道：「小哥您有所不知，这些个爷儿们可是大内来的高手，这次是奉了咱们皇上的命令，要去岚城找一把叫做什么『旋芒宝剑』的，那骑马的官爷所称的白道长，便是咱们这附近有名的太乙观观主……」"
msgstr "小二抄起脖子上的毛巾，抹了抹臉，說道：「小哥您有所不知，這些個爺兒們可是大內來的高手，這次是奉了咱們皇上的命令，要去嵐城找一把叫做什麼『旋芒寶劍』的，那騎馬的官爺所稱的白道長，便是咱們這附近有名的太乙觀觀主……」"

msgid "少年奇道：「岚城？那是什么地方？怎么我从小到大不曾听过有这个地方？」"
msgstr "少年奇道：「嵐城？那是什麼地方？怎麼我從小到大不曾聽過有這個地方？」"

msgid "小二「嘿」的一声，说道：「说起岚城这地方，那你可问对人啦，咱这儿的说书先生可是我的哥儿们，那岚城说穿了只不过是古书上的一处地方，据说这城是仙人住着，一般的凡夫俗眼可瞧不见这座城，只不过古时候一个樵夫不小心撞了进去，这才留下了记载，不过后来好像除了这位砍柴的老兄进去过之外，再也没有人到过这岚城，我说小哥哪，要找这个岚城是他们朝廷大官跟江湖好汉的事儿，您还是来小店听听说书先生的书儿比较轻松。」"
msgstr "小二「嘿」的一聲，說道：「說起嵐城這地方，那你可問對人啦，咱這兒的說書先生可是我的哥兒們，那嵐城說穿了只不過是古書上的一處地方，據說這城是仙人住著，一般的凡夫俗眼可瞧不見這座城，只不過古時候一個樵夫不小心撞了進去，這才留下了記載，不過後來好像除了這位砍柴的老兄進去過之外，再也沒有人到過這嵐城，我說小哥哪，要找這個嵐城是他們朝廷大官跟江湖好漢的事兒，您還是來小店聽聽說書先生的書兒比較輕鬆。」"

msgid "少年听着出了神，怔怔地望着外面的天空，一朵朵的浮云飘来飘去，他的心思也不由自主地飞了起来。"
msgstr "少年聽著出了神，怔怔地望著外面的天空，一朵朵的浮雲飄來飄去，他的心思也不由自主地飛了起來。"

msgid "历史"
msgstr "歷史"

msgid "自古以来，人类由茹毛饮血逐渐进步，慢慢有了部落，大约在一千年前，强大的邬赤族领袖商句征服了烟车河流域的游牧民族，建立了一个以「金色乌鸦」为图腾的国家，这金色乌鸦代表的是太阳，商句将一面绣着金色乌鸦的大旗树立在图干山的山顶上，统治着山脚下绵延好几百里的土地。"
msgstr "自古以來，人類由茹毛飲血逐漸進步，慢慢有了部落，大約在一千年前，強大的鄔赤族領袖商句征服了煙車河流域的游牧民族，建立了一個以「金色烏鴉」為圖騰的國家，這金色烏鴉代表的是太陽，商句將一面繡著金色烏鴉的大旗樹立在圖干山的山頂上，統治著山腳下綿延好幾百里的土地。"

msgid "第三年冬天，大雪一连下了五个月，牛羊冻死的不计其数，商句召集了所有的父老，对他们说道：「守护我们的金色乌鸦已经离开了这片土地，这场大雪便是告诉我们离开故乡的时间到了，我决定带着子民向南越过大漠，一直到看得到太阳的地方，年老和有病的人可以留下来，我会将一半的牛羊留给他们。」"
msgstr "第三年冬天，大雪一連下了五個月，牛羊凍死的不計其數，商句召集了所有的父老，對他們說道：「守護我們的金色烏鴉已經離開了這片土地，這場大雪便是告訴我們離開故鄉的時間到了，我決定帶著子民向南越過大漠，一直到看得到太陽的地方，年老和有病的人可以留下來，我會將一半的牛羊留給他們。」"

msgid "于是他们收拾了帐棚，留下了一半的牛羊给不愿离开家乡的老人，踏上了寻找金色乌鸦的旅程，大漠十分辽阔，即使是商句自己也没有把握能安全地穿越，他在出发后的第四个月甚至亲手写下了遗书，交给自己的儿子。他们在大漠里整整走了一年，然后来到了一座大山之前，商句病倒了，他对他的儿子於兰攸说道：「越过这座大山，北风就吹不到了，在那里一定可以看得到太阳，现在我把这面大旗交给你，希望你记着我们离开故乡的目的，好好带领大家。」说完，商句就闭上眼睛死了。"
msgstr "於是他們收拾了帳棚，留下了一半的牛羊給不願離開家鄉的老人，踏上了尋找金色烏鴉的旅程，大漠十分遼闊，即使是商句自己也沒有把握能安全地穿越，他在出發後的第四個月甚至親手寫下了遺書，交給自己的兒子。他們在大漠裡整整走了一年，然後來到了一座大山之前，商句病倒了，他對他的兒子於蘭攸說道：「越過這座大山，北風就吹不到了，在那裡一定可以看得到太陽，現在我把這面大旗交給你，希望你記著我們離開故鄉的目的，好好帶領大家。」說完，商句就閉上眼睛死了。"

msgid "於兰攸含泪埋葬了父亲，并且在他的墓旁守候了一年，才开始带着大家翻越那座大山，大山地势非常险峻，他们一共越过了六座高耸的山峰，才来到一片平原，只见绿草如茵，中间散布着几株大树，没有半点冰雪的踪迹，最令人惊异的是，他们的面前耸立着一株高耸入云的大树，树上正栖息着一只巨大的金色乌鸦。"
msgstr "於蘭攸含淚埋葬了父親，並且在他的墓旁守候了一年，才開始帶著大家翻越那座大山，大山地勢非常險峻，他們一共越過了六座高聳的山峰，才來到一片平原，只見綠草如茵，中間散佈著幾株大樹，沒有半點冰雪的蹤跡，最令人驚異的是，他們的面前聳立著一株高聳入雲的大樹，樹上正棲息著一隻巨大的金色烏鴉。"

msgid "虽然金色乌鸦在大家的心目中一直是太阳的象徵，但那也只是祖先们流传下来的神话，想不到在经过长途的跋涉之后，竟然真的见到了，那只金色乌鸦见到了於兰攸，忽然变成一个穿着金色长袍的少女缓缓地从树上降了下来，对着於兰攸说道：「你们终于来了，这片土地是我的父亲允诺要赐给你们的，我们是勇士『寒於』的后裔，掌管光明的太阳神族，如果你们能答应永远守护这株圣木，太阳将会永远照耀这片土地。」"
msgstr "雖然金色烏鴉在大家的心目中一直是太陽的象徵，但那也只是祖先們流傳下來的神話，想不到在經過長途的跋涉之後，竟然真的見到了，那隻金色烏鴉見到了於蘭攸，忽然變成一個穿著金色長袍的少女緩緩地從樹上降了下來，對著於蘭攸說道：「你們終於來了，這片土地是我的父親允諾要賜給你們的，我們是勇士『寒於』的後裔，掌管光明的太陽神族，如果你們能答應永遠守護這株聖木，太陽將會永遠照耀這片土地。」"

msgid "金色乌鸦变成的少女名字叫做「君违」，后来嫁给了於兰攸做妻子，君违教导众人耕种、纺纱，并且为她的丈夫制定各种典章制度，从此以后於兰攸和他的族人们一直遵守和金色乌鸦的约定，守护着圣木。因为金色乌鸦的守护，过了七百年风调雨顺的时光，人口增加得很快，在向外拓垦的同时，又陆续和西方擅长狩猎与铸造的歧族人、东方擅长音乐与占卜的敖族、南方擅长经商与建筑的娄族互相融合，终于成为这个世界上最大的国家，所有远方的小国都称呼我们为「天朝」，由于於兰氏的帝王具有太阳神族的血统，因此也有「天子」的称号。"
msgstr "金色烏鴉變成的少女名字叫做「君違」，後來嫁給了於蘭攸做妻子，君違教導眾人耕種、紡紗，並且為她的丈夫制定各種典章制度，從此以後於蘭攸和他的族人們一直遵守和金色烏鴉的約定，守護著聖木。因為金色烏鴉的守護，過了七百年風調雨順的時光，人口增加得很快，在向外拓墾的同時，又陸續和西方擅長狩獵與鑄造的歧族人、東方擅長音樂與占卜的敖族、南方擅長經商與建築的婁族互相融合，終於成為這個世界上最大的國家，所有遠方的小國都稱呼我們為「天朝」，由於於蘭氏的帝王具有太陽神族的血統，因此也有「天子」的稱號。"

msgid "但是就在距今约三百年前，发生了一件可怕的事，当时的皇宫之中，一群武士意外地在一处地窖里发现了一张羊皮，这张羊皮就是当初率领大家穿越大漠的君主商句所写的遗书，这份遗书不但提到了金色乌鸦，而且还提到许多后来发生的大事，简直就是一张神奇预言，发现这张羊皮的武士首领恰好是当时皇帝的叔父於兰淳焉，於兰淳焉是一位伟大的武士，曾经数度打败企图夺取圣木的北方蛮族，他见到遗书上提到，金色乌鸦出现之后每七百年，就会有一个可怕的妖魔出现，大杀苍生，以应金色乌鸦神通所欠的劫数，这个妖魔只有上古的宝剑「穿灵」才能镇住，而这把宝剑所藏的位置正是圣木的核心。"
msgstr "但是就在距今約三百年前，發生了一件可怕的事，當時的皇宮之中，一群武士意外地在一處地窖裡發現了一張羊皮，這張羊皮就是當初率領大家穿越大漠的君主商句所寫的遺書，這份遺書不但提到了金色烏鴉，而且還提到許多後來發生的大事，簡直就是一張神奇預言，發現這張羊皮的武士首領恰好是當時皇帝的叔父於蘭淳焉，於蘭淳焉是一位偉大的武士，曾經數度打敗企圖奪取聖木的北方蠻族，他見到遺書上提到，金色烏鴉出現之後每七百年，就會有一個可怕的妖魔出現，大殺蒼生，以應金色烏鴉神通所欠的劫數，這個妖魔只有上古的寶劍「穿靈」才能鎮住，而這把寶劍所藏的位置正是聖木的核心。"

msgid "於兰淳焉和皇帝商量的结果，决定劈开圣木取出宝剑，以防备妖魔出现，那圣木足足有一百个人合抱那么粗，一大群士兵用斧头砍了足足三天才将圣木砍倒，一阵天摇地动之后，穿灵宝剑终于出现在树洞中央，可是当於兰淳焉将宝剑拔起之后，一条黑影迅速地从地面窜了出来，原本明亮的天空一下子变暗了，百姓们都惊慌失措，只听到天空中传来阵阵低沉的吼声，过了足足一个时辰才又恢复光明。"
msgstr "於蘭淳焉和皇帝商量的結果，決定劈開聖木取出寶劍，以防備妖魔出現，那聖木足足有一百個人合抱那麼粗，一大群士兵用斧頭砍了足足三天才將聖木砍倒，一陣天搖地動之後，穿靈寶劍終於出現在樹洞中央，可是當於蘭淳焉將寶劍拔起之後，一條黑影迅速地從地面竄了出來，原本明亮的天空一下子變暗了，百姓們都驚慌失措，只聽到天空中傳來陣陣低沉的吼聲，過了足足一個時辰才又恢復光明。"

msgid "当天晚上，一只金色乌鸦出现在皇宫之中，说道：「你们今天做了一件大大的错事，将勇士寒於用宝剑镇压了五千年的『侮天鬼』放了出来，我的妹妹『璃虹』正在天上巡行，已经被这侮天鬼捉去了，侮天鬼现在正在四处寻找他的头颅，一旦被他找到，即使是集我全部族人的力量也无法镇服他，现在唯一的办法是找到另一把宝剑『旋芒』以及『寒於宝衣』，唯有这三件神器才能制服得了侮天鬼，寒於宝衣现在归月神族保管，旋芒宝剑却下落不明，侮天鬼的头颅被我的族人用强力法术封住，谅那妖魔两三百年内找不到，但是日子一久只怕终究隐藏不住，因此若你们三百年之内不能出现一个勇士消灭这妖魔，就真的大祸临头了。」"
msgstr "當天晚上，一隻金色烏鴉出現在皇宮之中，說道：「你們今天做了一件大大的錯事，將勇士寒於用寶劍鎮壓了五千年的『侮天鬼』放了出來，我的妹妹『璃虹』正在天上巡行，已經被這侮天鬼捉去了，侮天鬼現在正在四處尋找他的頭顱，一旦被他找到，即使是集我全部族人的力量也無法鎮服他，現在唯一的辦法是找到另一把寶劍『旋芒』以及『寒於寶衣』，唯有這三件神器才能制服得了侮天鬼，寒於寶衣現在歸月神族保管，旋芒寶劍卻下落不明，侮天鬼的頭顱被我的族人用強力法術封住，諒那妖魔兩三百年內找不到，但是日子一久只怕終究隱藏不住，因此若你們三百年之內不能出現一個勇士消滅這妖魔，就真的大禍臨頭了。」"

msgid "金色乌鸦的名字叫做「杞庸」，他化身成一个金袍少年住在皇宫中教武士们各种剑术武功三十年，渐渐地这些武术慢慢流传到了民间，更有许多聪明才智之士加以变化出许多不同的武术，而演变出各种不同的门派，转眼间已过了将近三百年，这期间虽然偶尔有些旱灾水灾，但仍算风调雨顺，想是那侮天鬼只急着找回头颅，却并不多事杀戮，但是人们却渐渐将这件事忘了，不少人还将之斥为无稽之谈，荒谬之说，直到先帝即位，事情才又有了变化。"
msgstr "金色烏鴉的名字叫做「杞庸」，他化身成一個金袍少年住在皇宮中教武士們各種劍術武功三十年，漸漸地這些武術慢慢流傳到了民間，更有許多聰明才智之士加以變化出許多不同的武術，而演變出各種不同的門派，轉眼間已過了將近三百年，這期間雖然偶爾有些旱災水災，但仍算風調雨順，想是那侮天鬼只急著找回頭顱，卻並不多事殺戮，但是人們卻漸漸將這件事忘了，不少人還將之斥為無稽之談，荒謬之說，直到先帝即位，事情才又有了變化。"

msgid "先帝秉性聪慧，自幼即博览群书，尤其对先人留下的史籍更是详加考据，先帝曾仔细推敲商句遗书中最后两句话，推断那可能是指引旋芒宝剑所在的关键，虽然对祖先所留下来有关金色乌鸦的传说也是半信半疑，但是仍然陆续派出了许多武士探查，结果意外地发现了古书中「烟霞霓岚」四座仙城中的烟城，根据武士所带回来的消息，旋芒宝剑目前乃是属于岚城中一位仙人所有，只是这岚城「寻风而至，寻风而逝」，烟城百姓也是只闻其名，不知其所，先帝直到病危之中仍念念不忘寻找岚城之事。"
msgstr "先帝秉性聰慧，自幼即博覽群書，尤其對先人留下的史籍更是詳加考據，先帝曾仔細推敲商句遺書中最後兩句話，推斷那可能是指引旋芒寶劍所在的關鍵，雖然對祖先所留下來有關金色烏鴉的傳說也是半信半疑，但是仍然陸續派出了許多武士探查，結果意外地發現了古書中「煙霞霓嵐」四座仙城中的煙城，根據武士所帶回來的消息，旋芒寶劍目前乃是屬於嵐城中一位仙人所有，只是這嵐城「尋風而至，尋風而逝」，煙城百姓也是只聞其名，不知其所，先帝直到病危之中仍念念不忘尋找嵐城之事。"

msgid "神话"
msgstr "神話"

msgid "早在我们的先人来到这片土地之前，这里曾经是集天地万物浊气所形成的妖魔们盘踞的炼狱，到处都是终年燃烧着的土地与深不见底的沼泽，直到我们的始祖——也就是勇士「寒於氏」来到这里，他有一件水火不侵的宝衣，和两把神异的利剑「穿灵」与「旋芒」，寒於氏和妖魔大战了一十七日，妖魔的鲜血浇熄了燃烧的土地，尸体填平了无底的沼泽，当寒於氏斩下最后一只妖魔「侮天鬼」的头颅之后，他也力尽而死。"
msgstr "早在我們的先人來到這片土地之前，這裡曾經是集天地萬物濁氣所形成的妖魔們盤踞的煉獄，到處都是終年燃燒著的土地與深不見底的沼澤，直到我們的始祖——也就是勇士「寒於氏」來到這裡，他有一件水火不侵的寶衣，和兩把神異的利劍「穿靈」與「旋芒」，寒於氏和妖魔大戰了一十七日，妖魔的鮮血澆熄了燃燒的土地，屍體填平了無底的沼澤，當寒於氏斬下最後一隻妖魔「侮天鬼」的頭顱之後，他也力盡而死。"

msgid "寒於氏死后，元神却没有消失，他的魂魄化成了十三个精灵，每一个精灵各拥有寒於氏的一种神通，掌管着这个世界的万物，其中的第十三个精灵「区冥氏」就是我们人类最早的祖先。区冥氏不像她其他的十二个姊姊是不死的，但是她所拥有的神通是寒於氏最引以为傲的「再生」能力，区冥氏活到一百七十岁的时候，召集了她所有的姊妹，交代她们好好照顾自己的子女之后，便闭上眼睛死了。"
msgstr "寒於氏死後，元神卻沒有消失，他的魂魄化成了十三個精靈，每一個精靈各擁有寒於氏的一種神通，掌管著這個世界的萬物，其中的第十三個精靈「區冥氏」就是我們人類最早的祖先。區冥氏不像她其他的十二個姊姊是不死的，但是她所擁有的神通是寒於氏最引以為傲的「再生」能力，區冥氏活到一百七十歲的時候，召集了她所有的姊妹，交代她們好好照顧自己的子女之後，便閉上眼睛死了。"

msgid "区冥氏一共有一百个子女，后来分别成为世界上各个种族的祖先。"
msgstr "區冥氏一共有一百個子女，後來分別成為世界上各個種族的祖先。"

msgid "勇士寒於的魂魄所化成的十三个精灵，分别是太阳神「金乌」、月神「银蟾」、风神「大鹏」、雨神「天龙」、雷神「泽兽」、火神「凤凰」、山鬼「赤魈」、林鬼「青蛛」、川鬼「浊鱼」、原鬼「旱魃」、天灵「穹氤」、地灵「域摩」、人灵「区冥」，共有「六神」、「四鬼」、「三灵」。其中特别值得一提的是最后的三灵，她们所拥有的神通汇集了寒於氏的精、气、神，若是善加利用，威力将远远凌驾其他十位精灵之上。"
msgstr "勇士寒於的魂魄所化成的十三個精靈，分別是太陽神「金烏」、月神「銀蟾」、風神「大鵬」、雨神「天龍」、雷神「澤獸」、火神「鳳凰」、山鬼「赤魈」、林鬼「青蛛」、川鬼「濁魚」、原鬼「旱魃」、天靈「穹氤」、地靈「域摩」、人靈「區冥」，共有「六神」、「四鬼」、「三靈」。其中特別值得一提的是最後的三靈，她們所擁有的神通匯集了寒於氏的精、氣、神，若是善加利用，威力將遠遠凌駕其他十位精靈之上。"

msgid "许多人都相信，区冥氏死了之后会不断地经由「转世」而继续复活，但是她的能力却全部分给了所有子女，因此人类能够凌驾于其他的虫鱼鸟兽之上，造就出伟大的成就，人类死亡之后，也会像区冥一样地转世再生，但是只有区冥能够保持每一生每一世的记忆，虽然再生的区冥氏所具有的能力和一般人类没有两样，但是她所累积的智慧是无人可及的。"
msgstr "許多人都相信，區冥氏死了之後會不斷地經由「轉世」而繼續復活，但是她的能力卻全部分給了所有子女，因此人類能夠凌駕於其他的蟲魚鳥獸之上，造就出偉大的成就，人類死亡之後，也會像區冥一樣地轉世再生，但是只有區冥能夠保持每一生每一世的記憶，雖然再生的區冥氏所具有的能力和一般人類沒有兩樣，但是她所累積的智慧是無人可及的。"

msgid "法门源流"
msgstr "法門源流"

msgid "所有的魔法依照能量来源的不同可分为两类：「法术」与「咒文」。"
msgstr "所有的魔法依照能量來源的不同可分為兩類：「法術」與「咒文」。"

msgid "所谓「法术」是指来自施法者自身的修为，以及自身所操控的能量所造成的魔法效果，这类魔法通常被视为高深的学问，并且是可以研究出「为什么？」的，法术的效果通常显著、直接、而且难以抗拒，尤其是当施术者的能力十分强大的时候。法术最初的起源是来自对于「咒文」力量的怀疑，并且在企图找出其力量根源的过程中逐步经由实验所建立起来的理论系统。"
msgstr "所謂「法術」是指來自施法者自身的修為，以及自身所操控的能量所造成的魔法效果，這類魔法通常被視為高深的學問，並且是可以研究出「為什麼？」的，法術的效果通常顯著、直接、而且難以抗拒，尤其是當施術者的能力十分強大的時候。法術最初的起源是來自對於「咒文」力量的懷疑，並且在企圖找出其力量根源的過程中逐步經由實驗所建立起來的理論系統。"

msgid "所谓「咒文」是指根据某种咒语、动作、仪式而与存在于宇宙中某种超然存在的生物或意志沟通，而藉其力量引发的魔法效果，这类魔法的历史比法术更早，而且这些「超然存在」的实体通常被人称为「神」、「魔鬼」、「精灵」等等，咒文宗教上的意义大于学术上的意义，但是又似乎并不完全是宗教上的力量（即：不管你信不信，或多或少都能产生实际的效果，而非单纯心理现象），一般使用咒文者很难探究「为什么」这样的咒文会引发这样的效果，咒文的来源全部都是来自古老的记载或无意中的发现。"
msgstr "所謂「咒文」是指根據某種咒語、動作、儀式而與存在於宇宙中某種超然存在的生物或意志溝通，而藉其力量引發的魔法效果，這類魔法的歷史比法術更早，而且這些「超然存在」的實體通常被人稱為「神」、「魔鬼」、「精靈」等等，咒文宗教上的意義大於學術上的意義，但是又似乎並不完全是宗教上的力量（即：不管你信不信，或多或少都能產生實際的效果，而非單純心理現象），一般使用咒文者很難探究「為什麼」這樣的咒文會引發這樣的效果，咒文的來源全部都是來自古老的記載或無意中的發現。"

msgid "虽然有不少魔法到底是属于「法术」系或「咒文」系仍然存有争议，但是人们已经找到一种简单的方法来区分他们，那就是「法术」消耗的能量是「灵力」、「咒文」消耗能量是「法力」（由于咒文的历史远较法术来得更早，因此在当时普遍使用的「魔法」、「法力」等名词都是指咒文系魔法而言，沿用至今）。"
msgstr "雖然有不少魔法到底是屬於「法術」系或「咒文」系仍然存有爭議，但是人們已經找到一種簡單的方法來區分他們，那就是「法術」消耗的能量是「靈力」、「咒文」消耗能量是「法力」（由於咒文的歷史遠較法術來得更早，因此在當時普遍使用的「魔法」、「法力」等名詞都是指咒文系魔法而言，沿用至今）。"

msgid "「神通」，长期钻研佛法的高僧常常会因自己本身的修为，产生具有神奇力量的神通，如天眼通、大力神通等，愈是具有大智慧、大慈悲的高僧其神通愈强，这类的法术通常需要百分之百的精神集中，才能施展，但是所需耗费的灵力较少，而且大多是属于防御或辅助性质的功能。"
msgstr "「神通」，長期鑽研佛法的高僧常常會因自己本身的修為，產生具有神奇力量的神通，如天眼通、大力神通等，愈是具有大智慧、大慈悲的高僧其神通愈強，這類的法術通常需要百分之百的精神集中，才能施展，但是所需耗費的靈力較少，而且大多是屬於防禦或輔助性質的功能。"

msgid "「道法」，道家讲究清静无为，法天自然，因此道法修行到了某一个程度，就能够利用天地阴阳生化的道理，吸取天地之精华纳为己用，道法所涵盖的范围极广，但是受到天时、地利、与施法者本身的状态影响很大，但是只要这几个条件能够配合，道法的威力是无可抵御的。"
msgstr "「道法」，道家講究清靜無為，法天自然，因此道法修行到了某一個程度，就能夠利用天地陰陽生化的道理，吸取天地之精華納為己用，道法所涵蓋的範圍極廣，但是受到天時、地利、與施法者本身的狀態影響很大，但是只要這幾個條件能夠配合，道法的威力是無可抵禦的。"

msgid "「仙术」，这是一门相当古老的修行法门，讲究炼气与长生不死之术，修炼仙术的人并不膜拜任何神祇，只集中于修炼自己的肉身，使之达到不朽的境地，进而羽化成仙，仙术除了在炼气方面相当杰出之外，还有许多炼丹的法门，但是一般人想要学习仙术并不容易，因为除了要有慧根之外，要找到愿意传授仙术的仙人也是一项非常艰困的修炼。"
msgstr "「仙術」，這是一門相當古老的修行法門，講究煉氣與長生不死之術，修煉仙術的人並不膜拜任何神祇，只集中於修煉自己的肉身，使之達到不朽的境地，進而羽化成仙，仙術除了在煉氣方面相當傑出之外，還有許多煉丹的法門，但是一般人想要學習仙術並不容易，因為除了要有慧根之外，要找到願意傳授仙術的仙人也是一項非常艱困的修煉。"

msgid "「密法」，佛家的一门分支，以手印与咒文为主，详细情形并不清楚，但是密法是一门攻守兼备，系统精严的法术，使用密法的人通常也擅长使用法器战斗，他们的修行是以降妖伏魔为主，密法修行至高深处时，也能拥有某些类似「罗汉神通」的能力，和佛家是殊途同归的正道。"
msgstr "「密法」，佛家的一門分支，以手印與咒文為主，詳細情形並不清楚，但是密法是一門攻守兼備，系統精嚴的法術，使用密法的人通常也擅長使用法器戰鬥，他們的修行是以降妖伏魔為主，密法修行至高深處時，也能擁有某些類似「羅漢神通」的能力，和佛家是殊途同歸的正道。"

msgid "「奇门」，又称茅山术，由于偏重治鬼与符箓咒术，往往被道家斥为旁门左道，但是奇门法术入门较易，且于临敌之际有其实用性在，加之不若正统道家那般虚无缥缈，因此一直拥有为数众多的人修习，虽然威力不如道法，但是近世经一位高人整理发扬，已经隐然有与正统道家分庭抗礼之势。"
msgstr "「奇門」，又稱茅山術，由於偏重治鬼與符籙咒術，往往被道家斥為旁門左道，但是奇門法術入門較易，且於臨敵之際有其實用性在，加之不若正統道家那般虛無縹緲，因此一直擁有為數眾多的人修習，雖然威力不如道法，但是近世經一位高人整理發揚，已經隱然有與正統道家分庭抗禮之勢。"

msgid "「魔道」，这类法术的修炼者以精怪居多，人类亦有少数，分为天魔、地魔、人魔三种，由于修炼法门往往必须杀伤生命，被多数人强烈憎恨，但是魔道威力集道法与仙术之所长，又为求利己不择手段，不但进境迅速兼且危险，以致于各家法术之中均有克制魔道的研究与法术，可说是树敌最多的一门。"
msgstr "「魔道」，這類法術的修煉者以精怪居多，人類亦有少數，分為天魔、地魔、人魔三種，由於修煉法門往往必須殺傷生命，被多數人強烈憎恨，但是魔道威力集道法與仙術之所長，又為求利己不擇手段，不但進境迅速兼且危險，以致於各家法術之中均有克制魔道的研究與法術，可說是樹敵最多的一門。"

msgid "道士"
msgstr "道士"

msgid "道士是一群以修炼成仙，而达到「与天地同休，与日月同寿」之境界的修道人，和其他的宗教比较起来，道士对于「人」的地位看得相当崇高，认为天、地、人在宇宙中的地位是相等的，因此，道教的教主是一个「人」，而不是高高在上、和凡人之间有不可跨越之鸿沟的「神」。"
msgstr "道士是一群以修煉成仙，而達到「與天地同休，與日月同壽」之境界的修道人，和其他的宗教比較起來，道士對於「人」的地位看得相當崇高，認為天、地、人在宇宙中的地位是相等的，因此，道教的教主是一個「人」，而不是高高在上、和凡人之間有不可跨越之鴻溝的「神」。"

msgid "道士的能力偏重于炼气，武术方面以内功、剑术见长，正统道家除炼气之外并不修习任何法术，但是许多道士往往会涉猎一些除妖降魔用的法术，以作为入山修炼时防身之用，有些支派的道士更发展成专研法术而舍弃修炼成仙的目的。"
msgstr "道士的能力偏重於煉氣，武術方面以內功、劍術見長，正統道家除煉氣之外並不修習任何法術，但是許多道士往往會涉獵一些除妖降魔用的法術，以作為入山修煉時防身之用，有些支派的道士更發展成專研法術而捨棄修煉成仙的目的。"

msgid "时间是天朝佑圣元年，岁次甲子，年仅十六岁的皇帝刚刚登基，雪亭镇上熙来攘往，一队身著白衣的朝廷武官和两名老者在镇前的广场中坐著，四面来来往往的人当中，有不少显然是武林中人，正探头探脑地向著广场张望。"
msgstr "時間是天朝佑聖元年，歲次甲子，年僅十六歲的皇帝剛剛登基，雪亭鎮上熙來攘往，一隊身著白衣的朝廷武官和兩名老者在鎮前的廣場中坐著，四面來來往往的人當中，有不少顯然是武林中人，正探頭探腦地向著廣場張望。"

msgid "马上乘客一跃而下，快步走到老者身前，躬身说道：「禀将军，时辰已到，白道长命下官回禀，方位是在....」，说著压低了声音。"
msgstr "馬上乘客一躍而下，快步走到老者身前，躬身說道：「稟將軍，時辰已到，白道長命下官回稟，方位是在....」，說著壓低了聲音。"

msgid "广场西边一家小客栈里，一个年约十四岁的少年问店里的小二道：「这些人神秘得紧，却不知到底在玩什麽把戏？」"
msgstr "廣場西邊一家小客棧裡，一個年約十四歲的少年問店裡的小二道：「這些人神秘得緊，卻不知到底在玩什麼把戲？」"

msgid "小二抄起脖子上的毛巾，抹了抹脸，说道：「小哥您有所不知，这些个爷儿们可是大内来的高手，这次是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的，那骑马的官爷所称的白道长，便是咱们这附近有名的太乙观观主....」"
msgstr "小二抄起脖子上的毛巾，抹了抹臉，說道：「小哥您有所不知，這些個爺兒們可是大內來的高手，這次是奉了咱們皇上的命令，要去嵐城找一把叫做什麼『旋芒寶劍』的，那騎馬的官爺所稱的白道長，便是咱們這附近有名的太乙觀觀主....」"

msgid "少年奇道：「岚城？那是什麽地方？怎麽我从小到大不曾听过有这个地方？」"
msgstr "少年奇道：「嵐城？那是什麼地方？怎麼我從小到大不曾聽過有這個地方？」"

msgid "少年听著出了神，怔怔地望著外面的天空，一朵朵的浮云飘来飘去，他的心思也不由自主地飞了起来。"
msgstr "少年聽著出了神，怔怔地望著外面的天空，一朵朵的浮雲飄來飄去，他的心思也不由自主地飛了起來。"

msgid "那少年，便是你。"
msgstr "那少年，便是你。"

msgid "寻剑令"
msgstr "尋劍令"

msgid "大内高手在找一把剑。去西南二十四里的黄石隘口，看他们找什么。"
msgstr "大內高手在找一把劍。去西南二十四里的黃石隘口，看他們找什麼。"

msgid "在黄石隘口看着官队挖出石匣、又被黑衣道士抢走"
msgstr "在黃石隘口看著官隊挖出石匣、又被黑衣道士搶走"

msgid "跟店小二打听广场上的「官爷」。"
msgstr "跟店小二打聽廣場上的「官爺」。"

msgid "店小二说外头广场上来了大内的官爷，叫你去瞧瞧。"
msgstr "店小二說外頭廣場上來了大內的官爺，叫你去瞧瞧。"

msgid "去镇前的广场，看看官爷们在做什么。"
msgstr "去鎮前的廣場，看看官爺們在做什麼。"

msgid "冯策叫信使大声报了方位：西南二十四里，黄石隘口。"
msgstr "馮策叫信使大聲報了方位：西南二十四里，黃石隘口。"

msgid "在广场上当面向大内的总教头问了寻剑的事"
msgstr "在廣場上當面向大內的總教頭問了尋劍的事"

msgid "围观的江湖客悄悄告诉你：官爷们要去西南二十四里的黄石隘口。"
msgstr "圍觀的江湖客悄悄告訴你：官爺們要去西南二十四里的黃石隘口。"

msgid "在广场上向围观的江湖人打听了官队的去处"
msgstr "在廣場上向圍觀的江湖人打聽了官隊的去處"

msgid "去西南二十四里的黄石隘口，看他们找什么。"
msgstr "去西南二十四里的黃石隘口，看他們找什麼。"

msgid "你到了黄石隘口。官队正在山壁下挖土，白道长守在坑边。"
msgstr "你到了黃石隘口。官隊正在山壁下挖土，白道長守在坑邊。"

msgid "看官队在山壁下挖什么。"
msgstr "看官隊在山壁下挖什麼。"

msgid "官队挖出一只刻着风纹的石匣；一个黑衣黑冠的道士从崖上掠下，抢了匣子就逃，掉下一块布条。白道长说匣里是岚城的风铃。"
msgstr "官隊挖出一隻刻著風紋的石匣；一個黑衣黑冠的道士從崖上掠下，搶了匣子就逃，掉下一塊布條。白道長說匣裡是嵐城的風鈴。"

msgid "拾起黑衣道士掉下的布条。"
msgstr "拾起黑衣道士掉下的布條。"

msgid "布条上刻着老松寨的记号：黑衣道士往老松岭去了。"
msgstr "布條上刻著老松寨的記號：黑衣道士往老松嶺去了。"

msgid "伪墓"
msgstr "偽墓"

msgid "追到黑衣道士，弄清老松寨和那口墓。"
msgstr "追到黑衣道士，弄清老松寨和那口墓。"

msgid "查明了瀑布山洞里的墓是假的"
msgstr "查明了瀑布山洞裡的墓是假的"

msgid "顺着布条上的记号去老松岭，沿松树上的刀痕找老松寨。"
msgstr "順著布條上的記號去老松嶺，沿松樹上的刀痕找老松寨。"

msgid "松树上的刀痕指向灌木后的一条小径：老松寨藏在林子深处。"
msgstr "松樹上的刀痕指向灌木後的一條小徑：老松寨藏在林子深處。"

msgid "过老松寨的寨门：留下买路钱、叫阵，或者打进去。"
msgstr "過老松寨的寨門：留下買路錢、叫陣，或者打進去。"

msgid "你给了寨门的喽罗十两银子买路钱，寨里的人不再拦你。"
msgstr "你給了寨門的嘍羅十兩銀子買路錢，寨裡的人不再攔你。"

msgid "给老松寨的喽罗付了买路钱"
msgstr "給老松寨的嘍羅付了買路錢"

msgid "你在寨门外叫阵，喽罗放你进去：常老大在聚义厅等你。"
msgstr "你在寨門外叫陣，嘍羅放你進去：常老大在聚義廳等你。"

msgid "在老松寨的寨门外叫阵"
msgstr "在老松寨的寨門外叫陣"

msgid "你打倒了寨门的喽罗，硬闯进了老松寨。"
msgstr "你打倒了寨門的嘍羅，硬闖進了老松寨。"

msgid "硬闯了老松寨的寨门"
msgstr "硬闖了老松寨的寨門"

msgid "到聚义厅找常老大，问黑衣道士的去向。"
msgstr "到聚義廳找常老大，問黑衣道士的去向。"

msgid "常老大说那道士拿一块金牌买了路，往东边的瀑布去了。"
msgstr "常老大說那道士拿一塊金牌買了路，往東邊的瀑布去了。"

msgid "你打倒了常老大。他跌坐在熊皮上骂道：那道士拿金牌买的路，往东边的瀑布去了，找他去！"
msgstr "你打倒了常老大。他跌坐在熊皮上罵道：那道士拿金牌買的路，往東邊的瀑布去了，找他去！"

msgid "打倒了老松寨的常老大"
msgstr "打倒了老松寨的常老大"

msgid "从瀑布后面进山洞，找黑衣道士。"
msgstr "從瀑布後面進山洞，找黑衣道士。"

msgid "瀑布后的山洞尽头有一具骸骨和一面刻字的石壁。"
msgstr "瀑布後的山洞盡頭有一具骸骨和一面刻字的石壁。"

msgid "拦住黑衣道士。"
msgstr "攔住黑衣道士。"

msgid "黑衣道士落败，石匣还锁着，留在洞里。"
msgstr "黑衣道士落敗，石匣還鎖著，留在洞裡。"

msgid "看看洞里的石壁和那具骸骨。"
msgstr "看看洞裡的石壁和那具骸骨。"

msgid "石壁上的字自称「南危水」，说埋骨于此——可骸骨身量矮小、骨龄不过三十，身边没有剑；字迹深浅如一，是活人慢慢刻的。这不是南危水的墓。"
msgstr "石壁上的字自稱「南危水」，說埋骨於此——可骸骨身量矮小、骨齡不過三十，身邊沒有劍；字跡深淺如一，是活人慢慢刻的。這不是南危水的墓。"

msgid "处置那具骸骨：安葬他，或者带走他身边的腰牌。"
msgstr "處置那具骸骨：安葬他，或者帶走他身邊的腰牌。"

msgid "你把无名人安葬了，腰牌随他入土。洞顶落下一本《过招要旨》。"
msgstr "你把無名人安葬了，腰牌隨他入土。洞頂落下一本《過招要旨》。"

msgid "安葬了瀑布山洞里的无名人"
msgstr "安葬了瀑布山洞裡的無名人"

msgid "你拿走了骸骨身边的水烟阁腰牌：金乌徽，背面一个「岭」字。"
msgstr "你拿走了骸骨身邊的水煙閣腰牌：金烏徽，背面一個「嶺」字。"

msgid "拿走了瀑布山洞骸骨身边的腰牌"
msgstr "拿走了瀑布山洞骸骨身邊的腰牌"

msgid "旧案"
msgstr "舊案"

msgid "去水烟阁，问清五长老的死。"
msgstr "去水煙閣，問清五長老的死。"

msgid "查清了二十年前水烟阁五长老的旧案"
msgstr "查清了二十年前水煙閣五長老的舊案"

msgid "回雪亭镇淳风武馆，把山洞里的事告诉柳淳风。"
msgstr "回雪亭鎮淳風武館，把山洞裡的事告訴柳淳風。"

msgid "柳淳风写了一封引荐信，让你去水烟阁找他的结拜义弟、执法使潘军禅；他说二十年前失在老松岭的那趟镖是振远镖局押的。"
msgstr "柳淳風寫了一封引薦信，讓你去水煙閣找他的結拜義弟、執法使潘軍禪；他說二十年前失在老松嶺的那趟鏢是振遠鏢局押的。"

msgid "去绮云镇振远镖局，问陈剑秋二十年前的失镖。"
msgstr "去綺雲鎮振遠鏢局，問陳劍秋二十年前的失鏢。"

msgid "陈剑秋拿出二十年前的镖单：押的是水烟阁盟主印一方、密件一匣，失镖于老松岭，无一人生还。振远至今不提这桩丢人事。"
msgstr "陳劍秋拿出二十年前的鏢單：押的是水煙閣盟主印一方、密件一匣，失鏢於老松嶺，無一人生還。振遠至今不提這樁丟人事。"

msgid "上水烟阁的山，看葬剑亭里的碑。"
msgstr "上水煙閣的山，看葬劍亭裡的碑。"

msgid "葬剑亭碑：第四代七长老以奸计害人，被众武者合力击杀，甲辰年立亭为后人殷鉴。"
msgstr "葬劍亭碑：第四代七長老以奸計害人，被眾武者合力擊殺，甲辰年立亭為後人殷鑑。"

msgid "看虹谷石台的碑。"
msgstr "看虹谷石臺的碑。"

msgid "虹谷石台碑：乙丑年，第六代阁主关雨楼立——正是失镖那年。字是用手指在岩石上写的，和山洞石壁上的刻字是一个手法。"
msgstr "虹谷石臺碑：乙丑年，第六代閣主關雨樓立——正是失鏢那年。字是用手指在岩石上寫的，和山洞石壁上的刻字是一個手法。"

msgid "上楼找五长老南危水，拿证据问他山洞里的骸骨。"
msgstr "上樓找五長老南危水，拿證據問他山洞裡的骸骨。"

msgid "南危水承认了：山洞里死的是他的随从阿岭，伏击的是白衣武官，盟主卫沧澜被带走。他装死二十年，是怕哥哥槐阳王知道朝廷伏击了自己的弟弟会反。"
msgstr "南危水承認了：山洞裡死的是他的隨從阿嶺，伏擊的是白衣武官，盟主衛滄瀾被帶走。他裝死二十年，是怕哥哥槐陽王知道朝廷伏擊了自己的弟弟會反。"

msgid "拿着引荐信到前厅找执法使潘军禅，问「邪剑穿灵」。"
msgstr "拿著引薦信到前廳找執法使潘軍禪，問「邪劍穿靈」。"

msgid "潘军禅说那把邪剑穿灵是仿剑、是鱼饵：去年一个黑衣道士来试过它，往野羊山北麓去了。"
msgstr "潘軍禪說那把邪劍穿靈是仿劍、是魚餌：去年一個黑衣道士來試過它，往野羊山北麓去了。"

msgid "替南危水保密（他欠你一个人情，到了关北替你引见他哥哥槐阳王），还是告诉七长老颜违（颜违借这件事坐稳代盟主，南危水不会再和你同路）？"
msgstr "替南危水保密（他欠你一個人情，到了關北替你引見他哥哥槐陽王），還是告訴七長老顏違（顏違借這件事坐穩代盟主，南危水不會再和你同路）？"

msgid "你替南危水保了密。他说，到了关北，他替你引见槐阳王。"
msgstr "你替南危水保了密。他說，到了關北，他替你引見槐陽王。"

msgid "替水烟阁五长老南危水保住了二十年的秘密"
msgstr "替水煙閣五長老南危水保住了二十年的秘密"

msgid "你把南危水的事告诉了七长老颜违。颜违当日便以代盟主自居；南危水闭门不出，水烟阁来信告诉了关北。"
msgstr "你把南危水的事告訴了七長老顏違。顏違當日便以代盟主自居；南危水閉門不出，水煙閣來信告訴了關北。"

msgid "把五长老南危水装死二十年的事告诉了七长老颜违"
msgstr "把五長老南危水裝死二十年的事告訴了七長老顏違"

msgid "进野羊山北麓的黑道观，找到失踪的大寨主。"
msgstr "進野羊山北麓的黑道觀，找到失蹤的大寨主。"

msgid "查清了逆灵宫纳供的真相"
msgstr "查清了逆靈宮納供的真相"

msgid "黑衣道士往野羊山北麓去了。去打听北麓的道观：野羊寨的黄霸在山路边的土地庙里；淳风武馆的门房刘安禄也知道——若他肯说。"
msgstr "黑衣道士往野羊山北麓去了。去打聽北麓的道觀：野羊寨的黃霸在山路邊的土地廟裡；淳風武館的門房劉安祿也知道——若他肯說。"

msgid "刘安禄说了：野羊寨的大寨主霍铮是他拜过把子的大哥，半年前被北麓黑砖道观的道士带走，再没回来；那伙人自称逆灵宫。三寨主黄霸接了寨子，每年给道观纳供；他不肯伺候那群道士，才下山做了门房。纳供的车这几天上山，到山路转角，道士从北边山壁的裂口把东西吊上去——道观就在裂口上头。"
msgstr "劉安祿說了：野羊寨的大寨主霍錚是他拜過把子的大哥，半年前被北麓黑磚道觀的道士帶走，再沒回來；那夥人自稱逆靈宮。三寨主黃霸接了寨子，每年給道觀納供；他不肯伺候那群道士，才下山做了門房。納供的車這幾天上山，到山路轉角，道士從北邊山壁的裂口把東西吊上去——道觀就在裂口上頭。"

msgid "黄霸说了：两年前北麓起了一座黑砖道观，自称逆灵宫，寨里折了一半弟兄；半年前大寨主霍铮、二寨主一前一后没了下落，寨子落到他手里。他打不过那些道士，每年纳供换野羊寨还在山上。今年的车已经上去了，这会儿该到了山路转角。"
msgstr "黃霸說了：兩年前北麓起了一座黑磚道觀，自稱逆靈宮，寨裡折了一半弟兄；半年前大寨主霍錚、二寨主一前一後沒了下落，寨子落到他手裡。他打不過那些道士，每年納供換野羊寨還在山上。今年的車已經上去了，這會兒該到了山路轉角。"

msgid "去野羊山的山路转角，看黄霸的纳供车。"
msgstr "去野羊山的山路轉角，看黃霸的納供車。"

msgid "两个黑衣道士守着一辆盖着油布的车。车上的箱子一只只吊进北边山壁的裂口里——他们不走山路。"
msgstr "兩個黑衣道士守著一輛蓋著油布的車。車上的箱子一隻隻吊進北邊山壁的裂口裡——他們不走山路。"

msgid "逆灵宫就在裂口上头。找到失踪的大寨主霍铮。跟着纳供车上去、打倒押车道士攀绳，或者戴上黑衣道士的黑冠——黄霸那里有一顶。"
msgstr "逆靈宮就在裂口上頭。找到失蹤的大寨主霍錚。跟著納供車上去、打倒押車道士攀繩，或者戴上黑衣道士的黑冠——黃霸那裡有一頂。"

msgid "你进了逆灵宫。"
msgstr "你進了逆靈宮。"

msgid "站稳脚跟，看看这是哪里。"
msgstr "站穩腳跟，看看這是哪裡。"

msgid "你缩在供品箱子中间，和纳供一起被吊上了裂口。绞盘旁的道士只当你是箱子。"
msgstr "你縮在供品箱子中間，和納供一起被吊上了裂口。絞盤旁的道士只當你是箱子。"

msgid "混在野羊寨的供品里进了逆灵宫"
msgstr "混在野羊寨的供品裡進了逆靈宮"

msgid "你打倒了押车道士，攀着他们的绳子上了裂口。"
msgstr "你打倒了押車道士，攀著他們的繩子上了裂口。"

msgid "打倒押车道士闯进了逆灵宫"
msgstr "打倒押車道士闖進了逆靈宮"

msgid "你戴上黑冠，押车道士只当你是宫里的人，让你自己攀了上去。"
msgstr "你戴上黑冠，押車道士只當你是宮裡的人，讓你自己攀了上去。"

msgid "戴着黑冠走进了逆灵宫"
msgstr "戴著黑冠走進了逆靈宮"

msgid "顺着货道往北，进黑砖山门，看看这座道观。戴着黑冠的，道士当你是自己人。"
msgstr "順著貨道往北，進黑磚山門，看看這座道觀。戴著黑冠的，道士當你是自己人。"

msgid "黑砖的前院：黑幡垂地，香炉里烧的不是香。前殿的门关着，东边的矮房是货栈。"
msgstr "黑磚的前院：黑幡垂地，香爐裡燒的不是香。前殿的門關著，東邊的矮房是貨棧。"

msgid "前殿的门关着。推开殿门进前殿，找到霍铮。"
msgstr "前殿的門關著。推開殿門進前殿，找到霍錚。"

msgid "前殿里没有神像。五个黑冠道士面壁诵逆灵天书，领诵的敲着木鱼，谁进来都不抬头。殿西有门，殿北的门关着。"
msgstr "前殿裡沒有神像。五個黑冠道士面壁誦逆靈天書，領誦的敲著木魚，誰進來都不抬頭。殿西有門，殿北的門關著。"

msgid "殿西是丹房和账房。账房的案上摊着纳供的账册，翻一翻。"
msgstr "殿西是丹房和賬房。賬房的案上攤著納供的賬冊，翻一翻。"

msgid "纳供的不只是金帛，是人：野羊寨三名「入丹房」；关北民夫七名，三名入丹房、四名留用；傅家坡七岁的孩童一名，「留用，待子时」。"
msgstr "納供的不只是金帛，是人：野羊寨三名「入丹房」；關北民夫七名，三名入丹房、四名留用；傅家坡七歲的孩童一名，「留用，待子時」。"

msgid "案上还有一叠盖着朱印的文书。"
msgstr "案上還有一疊蓋著朱印的文書。"

msgid "一叠盖着兵部大印的文书：「着逆灵宫代为收管」关北的河工、野羊山的「匪徒」。兵部的印，盖在一座黑道观的账上。"
msgstr "一疊蓋著兵部大印的文書：「著逆靈宮代為收管」關北的河工、野羊山的「匪徒」。兵部的印，蓋在一座黑道觀的賬上。"

msgid "丹房西南角有石阶往下。下地牢，找霍铮。"
msgstr "丹房西南角有石階往下。下地牢，找霍錚。"

msgid "霍铮锁在西边的牢房里，瘦得脱了形，骂声还在；北边那间是傅家坡的石头，七岁，头上两个小抓揪；东边两个关北来的民夫。三扇铁栅门的钥匙在大弟子玄冥子腰上。"
msgstr "霍錚鎖在西邊的牢房裡，瘦得脫了形，罵聲還在；北邊那間是傅家坡的石頭，七歲，頭上兩個小抓揪；東邊兩個關北來的民夫。三扇鐵柵門的鑰匙在大弟子玄冥子腰上。"

msgid "牢门开不了，钥匙在大弟子玄冥子腰上。前殿北门后的后殿有诵经声——钥匙该在那里。"
msgstr "牢門開不了，鑰匙在大弟子玄冥子腰上。前殿北門後的後殿有誦經聲——鑰匙該在那裡。"

msgid "后殿没有神像，只有一座黑石坛。商玦行「唤首」：黑焰里现出一个无头的黑影，摸索着找什么。商玦把地牢钥匙丢给了玄冥子——「子时开坛，带祭品上来」——退进黑门，玄冥子跟着走了。坛底爬出两个鬼卒。"
msgstr "後殿沒有神像，只有一座黑石壇。商玦行「喚首」：黑焰裡現出一個無頭的黑影，摸索著找什麼。商玦把地牢鑰匙丟給了玄冥子——「子時開壇，帶祭品上來」——退進黑門，玄冥子跟著走了。壇底爬出兩個鬼卒。"

msgid "坛底爬出来的鬼卒拦在你面前。打退它们。"
msgstr "壇底爬出來的鬼卒攔在你面前。打退它們。"

msgid "鬼卒散成黑烟。坛后的黑门开着；地牢的钥匙在狱卒手里了。"
msgstr "鬼卒散成黑煙。壇後的黑門開著；地牢的鑰匙在獄卒手裡了。"

msgid "两件事只来得及做一件：回地牢，狱卒手里有钥匙了，救霍铮和石头；或者穿过黑门追商玦。"
msgstr "兩件事只來得及做一件：回地牢，獄卒手裡有鑰匙了，救霍錚和石頭；或者穿過黑門追商玦。"

msgid "你打开了牢门。霍铮和石头跟你走了，关北的民夫自己逃回关北。商玦带着逆灵天书从后山下了崖，玄冥子跟着走了。"
msgstr "你打開了牢門。霍錚和石頭跟你走了，關北的民夫自己逃回關北。商玦帶著逆靈天書從後山下了崖，玄冥子跟著走了。"

msgid "从逆灵宫的地牢里救出了霍铮和石头"
msgstr "從逆靈宮的地牢裡救出了霍錚和石頭"

msgid "你穿过黑门和宫主的居所，追到了后山的崖径。等你再下地牢，狱卒已经动了手。"
msgstr "你穿過黑門和宮主的居所，追到了後山的崖徑。等你再下地牢，獄卒已經動了手。"

msgid "穿过黑门追到了逆灵宫的后山"
msgstr "穿過黑門追到了逆靈宮的後山"

msgid "带霍铮回野羊山的土地庙。"
msgstr "帶霍錚回野羊山的土地廟。"

msgid "黄霸跪下让位，霍铮派弟兄送石头回傅家坡。野羊寨欠你一条命。"
msgstr "黃霸跪下讓位，霍錚派弟兄送石頭回傅家坡。野羊寨欠你一條命。"

msgid "追上商玦。"
msgstr "追上商玦。"

msgid "商玦割断绳索下了崖。玄冥子断后，和你一战，倒在崖径上；逆灵天书的残卷落在他身边。"
msgstr "商玦割斷繩索下了崖。玄冥子斷後，和你一戰，倒在崖徑上；逆靈天書的殘卷落在他身邊。"

msgid "寒於宝衣在晚月庄。守它的人不白给。"
msgstr "寒於寶衣在晚月莊。守它的人不白給。"

msgid "找到了寒於宝衣"
msgstr "找到了寒於寶衣"

msgid "寒於的宝衣在哪？水烟阁的潘军禅、南危水知道旧事。"
msgstr "寒於的寶衣在哪？水煙閣的潘軍禪、南危水知道舊事。"

msgid "潘军禅说了：当年三件东西各归一处，宝衣归月神族保管。月神族早没了，只剩晚月庄——她们自称人灵区冥的后人，庄里供着神像，池边立着凤凰护庄。守它的人不白给。"
msgstr "潘軍禪說了：當年三件東西各歸一處，寶衣歸月神族保管。月神族早沒了，只剩晚月莊——她們自稱人靈區冥的後人，莊裡供著神像，池邊立著鳳凰護莊。守它的人不白給。"

msgid "南危水说了：寒於的宝衣当年归月神族保管，月神族的后人在晚月庄，供着人灵区冥的神像。守衣的人几百年没换过。"
msgstr "南危水說了：寒於的寶衣當年歸月神族保管，月神族的後人在晚月莊，供著人靈區冥的神像。守衣的人幾百年沒換過。"

msgid "去晚月庄。绮云镇西出镇的石板路尽头。"
msgstr "去晚月莊。綺雲鎮西出鎮的石板路盡頭。"

msgid "晚月庄的前厅。庄里来的都是找宝衣的人：逍遥派的芙云、天山派的梦玉楼、书房里的老妇和那个蒙面杀手，还有西厢的客人。"
msgstr "晚月莊的前廳。莊裡來的都是找寶衣的人：逍遙派的芙雲、天山派的夢玉樓、書房裡的老婦和那個蒙面殺手，還有西廂的客人。"

msgid "西厢的客人安妮儿也在等宝衣。去问她。"
msgstr "西廂的客人安妮兒也在等寶衣。去問她。"

msgid "安妮儿——东方神教的一代教主——在西厢住了三年。她说她等一件东西，也等一个配得上它的人。"
msgstr "安妮兒——東方神教的一代教主——在西廂住了三年。她說她等一件東西，也等一個配得上它的人。"

msgid "东厢的瑷伦是守衣人。问她宝衣。"
msgstr "東廂的璦倫是守衣人。問她寶衣。"

msgid "瑷伦认了：衣在庄里，她守着，守了几百年——三十七岁的脸。宝衣不白给：接她三鞭，站着不倒，再谈。"
msgstr "璦倫認了：衣在莊裡，她守著，守了幾百年——三十七歲的臉。寶衣不白給：接她三鞭，站著不倒，再談。"

msgid "接瑷伦三鞭。倒了可以歇好再来。"
msgstr "接璦倫三鞭。倒了可以歇好再來。"

msgid "你接下了瑷伦的三鞭。她收起鞭子，问你一句：你拿它去做什么。"
msgstr "你接下了璦倫的三鞭。她收起鞭子，問你一句：你拿它去做什麼。"

msgid "瑷伦问：你拿它去做什么？——为了斩鬼、交给安妮儿，还是不知道。"
msgstr "璦倫問：你拿它去做什麼？——為了斬鬼、交給安妮兒，還是不知道。"

msgid "你说：为了斩鬼。瑷伦点头：寒於留它，本来就是为这个。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr "你說：為了斬鬼。璦倫點頭：寒於留它，本來就是為這個。衣在第二密室的冰匣裡，匣只認「有鳳來儀」。"

msgid "对守衣人说，要拿寒於宝衣去斩鬼"
msgstr "對守衣人說，要拿寒於寶衣去斬鬼"

msgid "你说：交给安妮儿。瑷伦的脸冷了下来，却不拦：拿得走就拿。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr "你說：交給安妮兒。璦倫的臉冷了下來，卻不攔：拿得走就拿。衣在第二密室的冰匣裡，匣只認「有鳳來儀」。"

msgid "对守衣人说，要把寒於宝衣交给安妮儿"
msgstr "對守衣人說，要把寒於寶衣交給安妮兒"

msgid "你说：不知道。瑷伦说，不知道比胡说一个好。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr "你說：不知道。璦倫說，不知道比胡說一個好。衣在第二密室的冰匣裡，匣只認「有鳳來儀」。"

msgid "对守衣人说，还不知道拿寒於宝衣做什么"
msgstr "對守衣人說，還不知道拿寒於寶衣做什麼"

msgid "宝衣在第二密室的冰匣里，匣只认「有凤来仪」：女子自己跳，男子请内厅的筱薇或禁闭房的芳绫替跳。第二密室从内厅穿堂南边的花门进，或在第一密室跳「有凤来仪」。"
msgstr "寶衣在第二密室的冰匣裡，匣只認「有鳳來儀」：女子自己跳，男子請內廳的筱薇或禁閉房的芳綾替跳。第二密室從內廳穿堂南邊的花門進，或在第一密室跳「有鳳來儀」。"

msgid "冰匣开了。一件月白的衣落在地上，寒气扑面。"
msgstr "冰匣開了。一件月白的衣落在地上，寒氣撲面。"

msgid "宝衣到手。交回瑷伦守到决战；交给安妮儿，或者带着它走出晚月庄的大门——宝衣一离开瑷伦，庄就没了护佑，当夜会出事：东方神教派来的杀手会摸进前厅，见人就动手——要打一场；打不过，退出前厅，她不追。"
msgstr "寶衣到手。交回璦倫守到決戰；交給安妮兒，或者帶著它走出晚月莊的大門——寶衣一離開璦倫，莊就沒了護佑，當夜會出事：東方神教派來的殺手會摸進前廳，見人就動手——要打一場；打不過，退出前廳，她不追。"

#~ msgid "你把宝衣交给了安妮儿。她说：月神族守了几百年，守给我的。你配得上——东方神教记得你。"
#~ msgstr "你把寶衣交給了安妮兒。她說：月神族守了幾百年，守給我的。你配得上——東方神教記得你。"

msgid "把寒於宝衣交给了东方神教的安妮儿"
msgstr "把寒於寶衣交給了東方神教的安妮兒"

msgid "你把宝衣交回瑷伦。她披上它：我守到决战那日。到时候你来叫我，我跟你下湖底。"
msgstr "你把寶衣交回璦倫。她披上它：我守到決戰那日。到時候你來叫我，我跟你下湖底。"

msgid "把寒於宝衣留给了守衣人瑷伦"
msgstr "把寒於寶衣留給了守衣人璦倫"

#~ msgid "你带着宝衣走出了晚月庄的大门。庄失去了护佑。"
#~ msgstr "你帶著寶衣走出了晚月莊的大門。莊失去了護佑。"

msgid "带走了寒於宝衣"
msgstr "帶走了寒於寶衣"

msgid "人证"
msgstr "人證"

msgid "兵部的印是真的，令不是先帝的。要动兵部的人，须有人在堂上说。"
msgstr "兵部的印是真的，令不是先帝的。要動兵部的人，須有人在堂上說。"

msgid "把寻剑令的真相递到了乔阴县的公堂上"
msgstr "把尋劍令的真相遞到了喬陰縣的公堂上"

msgid "带着逆灵宫那叠盖兵部印的文书去乔阴县衙，击门口的大皮鼓。没带文书，侍卫不开门——文书还躺在逆灵宫的账房。"
msgstr "帶著逆靈宮那疊蓋兵部印的文書去喬陰縣衙，擊門口的大皮鼓。沒帶文書，侍衛不開門——文書還躺在逆靈宮的賬房。"

msgid "带刀侍卫从内院出来：是你击鼓申冤吗？——衙门的大门开了。"
msgstr "帶刀侍衛從內院出來：是你擊鼓申冤嗎？——衙門的大門開了。"

msgid "进大堂，把兵部文书给县官程不平看。"
msgstr "進大堂，把兵部文書給縣官程不平看。"

msgid "程不平看得出文书是真的，可要动兵部的人，须有人证——印是谁盖的，人去了哪，得有人在堂上说。他指了一个人：福林酒楼里日日发呆、丢了箱子的武官，姓陈。"
msgstr "程不平看得出文書是真的，可要動兵部的人，須有人證——印是誰蓋的，人去了哪，得有人在堂上說。他指了一個人：福林酒樓裡日日發呆、丟了箱子的武官，姓陳。"

msgid "福林酒楼里丢了箱子的武官姓陈。给他看兵部的印。"
msgstr "福林酒樓裡丟了箱子的武官姓陳。給他看兵部的印。"

msgid "陈显祖见了兵部的印脸色就变：他是二十年前老松岭那队白衣武官里的逃兵。当年念给全队听的寻剑令抄本一直藏在他的桃木箱里——箱子丢在树王坟的树洞里。"
msgstr "陳顯祖見了兵部的印臉色就變：他是二十年前老松嶺那隊白衣武官裡的逃兵。當年念給全隊聽的尋劍令抄本一直藏在他的桃木箱裡——箱子丟在樹王墳的樹洞裡。"

msgid "寻剑令的抄本在陈显祖的桃木箱里。箱子在树王坟的树洞里——洞里不干净。箱子已经还了他的，问他要抄本。"
msgstr "尋劍令的抄本在陳顯祖的桃木箱裡。箱子在樹王墳的樹洞裡——洞裡不乾淨。箱子已經還了他的，問他要抄本。"

msgid "寻剑令的抄本到手：「寻剑，不得扰民一户」，一句。底下是当年全队的名字。"
msgstr "尋劍令的抄本到手：「尋劍，不得擾民一戶」，一句。底下是當年全隊的名字。"

msgid "县衙的带刀侍卫是槐阳王的人。问他兵部的令。"
msgstr "縣衙的帶刀侍衛是槐陽王的人。問他兵部的令。"

msgid "槐阳王也收到过兵部「征三千民夫修官道寻剑」的令。老王爷拒了。"
msgstr "槐陽王也收到過兵部「徵三千民夫修官道尋劍」的令。老王爺拒了。"

msgid "护送陈显祖进衙门作证（问他「作证」），或放他带箱子走（「走吧」）。"
msgstr "護送陳顯祖進衙門作證（問他「作證」），或放他帶箱子走（「走吧」）。"

msgid "你把陈显祖护送进了乔阴县衙。福林大街上庾家的人动了手——他活着站上了公堂。"
msgstr "你把陳顯祖護送進了喬陰縣衙。福林大街上庾家的人動了手——他活著站上了公堂。"

msgid "护送陈显祖上了乔阴县的公堂"
msgstr "護送陳顯祖上了喬陰縣的公堂"

msgid "你放陈显祖带着箱子走了。抄本和文书留在你手里。"
msgstr "你放陳顯祖帶著箱子走了。抄本和文書留在你手裡。"

msgid "放陈显祖带着箱子走了"
msgstr "放陳顯祖帶著箱子走了"

msgid "堂审。带着抄本和兵部文书回大堂见程不平。"
msgstr "堂審。帶著抄本和兵部文書回大堂見程不平。"

msgid "程不平录了供，写信给叔父槐阳王：假印和失踪的人都往关北去了。兵部的海捕文书也到了县衙——说你是逆灵宫的同党。程不平压着，压不了几天；文书往雪亭去了，你住的那家客栈。"
msgstr "程不平錄了供，寫信給叔父槐陽王：假印和失蹤的人都往關北去了。兵部的海捕文書也到了縣衙——說你是逆靈宮的同黨。程不平壓著，壓不了幾天；文書往雪亭去了，你住的那家客棧。"

msgid "关北"
msgstr "關北"

msgid "假印和失踪的人都往关北去了。先在天驼关把印的事问清楚，再出关去槐阳城，把程不平的信递给槐阳王；然后借兵踏平工地，或者带郭承夜里潜进去。卢卡说他们那边也传说一个找头的鬼。"
msgstr "假印和失蹤的人都往關北去了。先在天駝關把印的事問清楚，再出關去槐陽城，把程不平的信遞給槐陽王；然後借兵踏平工地，或者帶郭承夜裡潛進去。盧卡說他們那邊也傳說一個找頭的鬼。"

msgid "在关北救出了兵部工地上的民夫"
msgstr "在關北救出了兵部工地上的民夫"

msgid "带着程不平的信去天驼关军营，给镇国大将军严廷殷看（军营要大队长的名册）。"
msgstr "帶著程不平的信去天駝關軍營，給鎮國大將軍嚴廷殷看（軍營要大隊長的名冊）。"

msgid "严廷殷看了信：兵部的印是真的，令不是先帝的——这话他不敢说。他的印丢过一回，找回来了；那三天的事，军师比他清楚。"
msgstr "嚴廷殷看了信：兵部的印是真的，令不是先帝的——這話他不敢說。他的印丟過一回，找回來了；那三天的事，軍師比他清楚。"

msgid "程不平的信在你身上"
msgstr "程不平的信在你身上"

msgid "信丢了的话，回乔阴县衙问程不平「兵部文书」，他会再写一封"
msgstr "信丟了的話，回喬陰縣衙問程不平「兵部文書」，他會再寫一封"

msgid "军师赫造基知道印的事。他卖秘密——八两银子。"
msgstr "軍師赫造基知道印的事。他賣秘密——八兩銀子。"

msgid "赫造基收了八两银子：真印丢的那几天他拓了模子，卖了一份给兵部来的人。留着的那一份印模，他给了你。"
msgstr "赫造基收了八兩銀子：真印丟的那幾天他拓了模子，賣了一份給兵部來的人。留著的那一份印模，他給了你。"

msgid "拿印模比一比兵部文书上的印（印模的「比印」）。真印泛黄光，假的没上朱。"
msgstr "拿印模比一比兵部文書上的印（印模的「比印」）。真印泛黃光，假的沒上朱。"

msgid "印模上的朱砂正红、泛黄光；兵部文书上那方「镇国大将军」印暗红发黑。字口一笔不差，只差一个颜色：兵部的文书是真的，镇国大将军的印是照模子浇的，令是兵部添的。"
msgstr "印模上的硃砂正紅、泛黃光；兵部文書上那方「鎮國大將軍」印暗紅發黑。字口一筆不差，只差一個顏色：兵部的文書是真的，鎮國大將軍的印是照模子澆的，令是兵部添的。"

msgid "出关：天驼关谷地东壁的关门。有信、名册上有你、留五两过路钱，或者打过去。"
msgstr "出關：天駝關谷地東壁的關門。有信、名冊上有你、留五兩過路錢，或者打過去。"

msgid "关门兵放了行。门后的军道绕过骆驼东峰往北折。"
msgstr "關門兵放了行。門後的軍道繞過駱駝東峰往北折。"

msgid "顺着军道往北，出了山就是关北。"
msgstr "順著軍道往北，出了山就是關北。"

msgid "黄土变成了草。路边一方青石界碑：「关北封国界」。往北，一座土黄的城墙横在草地尽头——槐阳城。"
msgstr "黃土變成了草。路邊一方青石界碑：「關北封國界」。往北，一座土黃的城牆橫在草地盡頭——槐陽城。"

msgid "进槐阳城。城门旁有一张王府的告示，看看。"
msgstr "進槐陽城。城門旁有一張王府的告示，看看。"

msgid "王府的告示：「兵部征夫令，本府不奉。有持兵部文书到关北拿人者，以盗论。」告示上的印色正红——和逆灵宫那叠文书上的不一样。"
msgstr "王府的告示：「兵部徵夫令，本府不奉。有持兵部文書到關北拿人者，以盜論。」告示上的印色正紅——和逆靈宮那疊文書上的不一樣。"

msgid "王府在大街北头。门军认程不平的信；把信递给槐阳王程朔。"
msgstr "王府在大街北頭。門軍認程不平的信；把信遞給槐陽王程朔。"

msgid "程朔读了信：兵部的印是真的，令不是先帝的——他早说了。失踪的人在草原东边兵部的工地上挖一座古冢，挖不动的让道士的车接走。两条路：借他的兵踏平，或者让郭承带你夜里进去。"
msgstr "程朔讀了信：兵部的印是真的，令不是先帝的——他早說了。失蹤的人在草原東邊兵部的工地上挖一座古冢，挖不動的讓道士的車接走。兩條路：借他的兵踏平，或者讓郭承帶你夜裡進去。"

msgid "借槐阳王的兵踏平工地（问程朔「借兵」：救下所有人，但兵部会说关北反了），或带骁将郭承夜里潜入（在校场问郭承「潜入」：救一半，王府干净）。"
msgstr "借槐陽王的兵踏平工地（問程朔「借兵」：救下所有人，但兵部會說關北反了），或帶驍將郭承夜裡潛入（在校場問郭承「潛入」：救一半，王府乾淨）。"

msgid "你借了槐阳王的兵。程朔：「踏平了，兵部的文书第二天就到京师：槐阳王反了。」郭承领六骑听你的。"
msgstr "你借了槐陽王的兵。程朔：「踏平了，兵部的文書第二天就到京師：槐陽王反了。」郭承領六騎聽你的。"

msgid "借了槐阳王的兵，要踏平兵部的工地"
msgstr "借了槐陽王的兵，要踏平兵部的工地"

msgid "你和郭承约好了夜里潜入工地。「救得几个算几个，救不完的别回头。王府不知道这件事。」"
msgstr "你和郭承約好了夜裡潛入工地。「救得幾個算幾個，救不完的別回頭。王府不知道這件事。」"

msgid "和王府骁将郭承约好夜里潜入工地"
msgstr "和王府驍將郭承約好夜裡潛入工地"

msgid "去草原东边兵部的工地（出马市东门，过帐篷营地和草原）。借了兵的，郭承跟着你，白天就去；约好潜入的，先在营地的篝火边等到天黑。"
msgstr "去草原東邊兵部的工地（出馬市東門，過帳篷營地和草原）。借了兵的，郭承跟著你，白天就去；約好潛入的，先在營地的篝火邊等到天黑。"

msgid "草原东边的工地：一道木栅栏，三顶帐篷，两溜民夫棚，土堆得像小山。白衣的武官守着门，监工吕隼拿着名册。"
msgstr "草原東邊的工地：一道木柵欄，三頂帳篷，兩溜民夫棚，土堆得像小山。白衣的武官守著門，監工呂隼拿著名冊。"

msgid "踏平工地：打倒白衣武官、队长裴照和监工吕隼，打开民夫棚前的枷锁。"
msgstr "踏平工地：打倒白衣武官、隊長裴照和監工呂隼，打開民夫棚前的枷鎖。"

msgid "王府的六骑冲进了工地。白衣武官倒了，裴照倒了，吕隼趴在他的名册上。你打开了八副枷锁，八个民夫回营地去了；古冢口的道士丢下车跑了。兵部的文书明天就到京师：槐阳王反了。"
msgstr "王府的六騎衝進了工地。白衣武官倒了，裴照倒了，呂隼趴在他的名冊上。你打開了八副枷鎖，八個民夫回營地去了；古冢口的道士丟下車跑了。兵部的文書明天就到京師：槐陽王反了。"

msgid "夜里跟着郭承潜进工地，到民夫棚解枷。救得几个算几个，救不完的别回头。"
msgstr "夜裡跟著郭承潛進工地，到民夫棚解枷。救得幾個算幾個，救不完的別回頭。"

msgid "夜里的工地只有两个守夜的。你和郭承解开了四副枷锁——王石头、刘拐子、巴图、胡阿大跑了；第四副铁销响了，守夜的武官扑上来。打完，郭承说：走。另外四个人的名字，你在名册上见过：老魏、周二牛、陈满仓、马三。"
msgstr "夜裡的工地只有兩個守夜的。你和郭承解開了四副枷鎖——王石頭、劉拐子、巴圖、胡阿大跑了；第四副鐵銷響了，守夜的武官撲上來。打完，郭承說：走。另外四個人的名字，你在名冊上見過：老魏、周二牛、陳滿倉、馬三。"

msgid "回马市问大秦剑手卢卡「会首」——他们那边也传说一个找自己脑袋的鬼。"
msgstr "回馬市問大秦劍手盧卡「會首」——他們那邊也傳說一個找自己腦袋的鬼。"

msgid "卢卡说他的会首安敦在番坊，番坊的人知道那个鬼的事。番坊在海边：从玉螺湖村出忘情谷，走海崖道。"
msgstr "盧卡說他的會首安敦在番坊，番坊的人知道那個鬼的事。番坊在海邊：從玉螺湖村出忘情谷，走海崖道。"

msgid "卢卡说他的会首安敦在番坊，会首的祖上三百年前见过那个鬼的头是怎么封的。番坊在海边：从玉螺湖村出忘情谷，顺着小路往南，走海崖道下去。"
msgstr "盧卡說他的會首安敦在番坊，會首的祖上三百年前見過那個鬼的頭是怎麼封的。番坊在海邊：從玉螺湖村出忘情谷，順著小路往南，走海崖道下去。"

msgid "从拜火祠取回了三百年前老兵刻下封法的铜牒"
msgstr "從拜火祠取回了三百年前老兵刻下封法的銅牒"

msgid "去番坊找大秦人的会首安敦——卢卡说他们知道鬼的头在哪。出忘情谷，顺着小路往南，走海崖道。"
msgstr "去番坊找大秦人的會首安敦——盧卡說他們知道鬼的頭在哪。出忘情谷，順著小路往南，走海崖道。"

msgid "林子到头，崖下第一次看见了海。海崖道顺着崖往南下去，崖脚是番坊的码头。"
msgstr "林子到頭，崖下第一次看見了海。海崖道順著崖往南下去，崖腳是番坊的碼頭。"

msgid "找大秦人的会首安敦——市集北头，门口立着两面大盾的铁盾会，院子北头会首的屋。"
msgstr "找大秦人的會首安敦——市集北頭，門口立著兩面大盾的鐵盾會，院子北頭會首的屋。"

msgid "铁盾会的会首安敦见了你：他的祖上三百年前替皇叔於兰淳焉打过北方的蛮族，其中一个老兵见过那个鬼的头是怎么封的。"
msgstr "鐵盾會的會首安敦見了你：他的祖上三百年前替皇叔於蘭淳焉打過北方的蠻族，其中一個老兵見過那個鬼的頭是怎麼封的。"

msgid "安敦的祖上把看见的刻在一片铜牒上，传到了他手里——问他「铜牒」。"
msgstr "安敦的祖上把看見的刻在一片銅牒上，傳到了他手裡——問他「銅牒」。"

msgid "铜牒存在拜火祠的火前，三十年了。祠规「火前不说谎」：取牒要过一场问话，三句。大秦人自己过不了——三十年前他们为了这块地在火前说过一句谎。"
msgstr "銅牒存在拜火祠的火前，三十年了。祠規「火前不說謊」：取牒要過一場問話，三句。大秦人自己過不了——三十年前他們為了這塊地在火前說過一句謊。"

msgid "市舶司要清走大秦人，鬼笠馆的浪人想要他们的地。站大秦人（问安敦「站大秦人」：拜火祠过问话取牒，再替他们挡住冯禄），还是站浪人（去日陀罗寺南墙小门外的鬼笠馆，问早川「站浪人」，过他一刀，让浪人替你偷牒——浪人会作证，市舶司就把大秦人清出番坊）？"
msgstr "市舶司要清走大秦人，鬼笠館的浪人想要他們的地。站大秦人（問安敦「站大秦人」：拜火祠過問話取牒，再替他們擋住馮祿），還是站浪人（去日陀羅寺南牆小門外的鬼笠館，問早川「站浪人」，過他一刀，讓浪人替你偷牒——浪人會作證，市舶司就把大秦人清出番坊）？"

msgid "你站了大秦人。安敦：「三句真话，牒是你的。读了，再还我们一个人情：冯禄来的时候，站在门口。」"
msgstr "你站了大秦人。安敦：「三句真話，牒是你的。讀了，再還我們一個人情：馮祿來的時候，站在門口。」"

msgid "在番坊站到了大秦人一边"
msgstr "在番坊站到了大秦人一邊"

msgid "你站了浪人。早川只说了一句：「要铜牒？过我一刀。」"
msgstr "你站了浪人。早川只說了一句：「要銅牒？過我一刀。」"

msgid "在番坊站到了浪人一边"
msgstr "在番坊站到了浪人一邊"

msgid "拜火祠（市集东头的黑石房子）：站到火前，答穆护三句真话，取铜牒。问的是你自己做过的事——撒一句谎，火蹿起来，当天不再问。"
msgstr "拜火祠（市集東頭的黑石房子）：站到火前，答穆護三句真話，取銅牒。問的是你自己做過的事——撒一句謊，火躥起來，當天不再問。"

msgid "火静了。穆护从火坛底下取出铜牒，放在你手里——还是温的。「火前拿的，谁也不能说你偷。」"
msgstr "火靜了。穆護從火壇底下取出銅牒，放在你手裡——還是溫的。「火前拿的，誰也不能說你偷。」"

msgid "回铁盾会：冯禄带着他雇的四个浪人到了院门口。站到门口去，对质那纸文书——有印模的，按在印旁边对一对印色；没有的，只能动手。"
msgstr "回鐵盾會：馮祿帶著他僱的四個浪人到了院門口。站到門口去，對質那紙文書——有印模的，按在印旁邊對一對印色；沒有的，只能動手。"

msgid "冯禄退走了。大秦人留下了，安敦说：「你欠我们的人情，我们记着；我们欠你的，也记着。」"
msgstr "馮祿退走了。大秦人留下了，安敦說：「你欠我們的人情，我們記著；我們欠你的，也記著。」"

msgid "鬼笠馆（日陀罗寺南墙的小门外，坡道底下）：找馆主早川直义，过他一刀——一击之内定生死。"
msgstr "鬼笠館（日陀羅寺南牆的小門外，坡道底下）：找館主早川直義，過他一刀——一擊之內定生死。"

msgid "早川收刀入鞘：「过了。今夜，拜火祠——火坛前站着，别出声。」"
msgstr "早川收刀入鞘：「過了。今夜，拜火祠——火壇前站著，別出聲。」"

msgid "等到天黑（鬼笠馆的板地能歇到天黑），去拜火祠的火坛前站着，别出声。浪人替你偷牒。"
msgstr "等到天黑（鬼笠館的板地能歇到天黑），去拜火祠的火壇前站著，別出聲。浪人替你偷牒。"

msgid "黑影把铜牒塞进你手里，走了。祠里传出祭司的骂声。第二天，冯禄的文书有了浪人作证——铁盾会空了，安敦被押上了船，卢卡剩在码头上。"
msgstr "黑影把銅牒塞進你手裡，走了。祠裡傳出祭司的罵聲。第二天，馮祿的文書有了浪人作證——鐵盾會空了，安敦被押上了船，盧卡剩在碼頭上。"

msgid "读铜牒——三百年前的老兵刻下的，那个鬼的头是怎么封的。"
msgstr "讀銅牒——三百年前的老兵刻下的，那個鬼的頭是怎麼封的。"

msgid "「头在湖底冰下，以穿灵为钉；钉在，鬼不得全；钉拔，鬼成形；要灭它，三器齐；要再封，须有人留下。」——三百年前的老兵刻的。那把剑是钉子。"
msgstr "「頭在湖底冰下，以穿靈為釘；釘在，鬼不得全；釘拔，鬼成形；要滅它，三器齊；要再封，須有人留下。」——三百年前的老兵刻的。那把劍是釘子。"

msgid "湖底封物"
msgstr "湖底封物"

msgid "铜牒说：头在湖底冰下，以穿灵为钉。那把剑钉着鬼的头——在玉螺湖底。渔夫说湖里不太平，别碰那把剑。"
msgstr "銅牒說：頭在湖底冰下，以穿靈為釘。那把劍釘著鬼的頭——在玉螺湖底。漁夫說湖裡不太平，別碰那把劍。"

msgid "下到玉螺湖底，看清了三百年的封物"
msgstr "下到玉螺湖底，看清了三百年的封物"

msgid "回玉螺湖村，下湖底，看清封物。别拔那把剑。"
msgstr "回玉螺湖村，下湖底，看清封物。別拔那把劍。"

msgid "你到了湖底。从湖心潜下来的，身后的入口结上了冰；从忘情谷下冰阶来的，一下阶就是冰龙的厅。"
msgstr "你到了湖底。從湖心潛下來的，身後的入口結上了冰；從忘情谷下冰階來的，一下階就是冰龍的廳。"

msgid "玄冰上站不住人。顶住寒气，穿过冰龙的厅——它们是守者，不先动手就不打。"
msgstr "玄冰上站不住人。頂住寒氣，穿過冰龍的廳——它們是守者，不先動手就不打。"

msgid "六条白鳞冰龙抬头看了你一眼，又盘了回去。"
msgstr "六條白鱗冰龍抬頭看了你一眼，又盤了回去。"

msgid "冰龙厅的水潭底下透着白光。潜下去。"
msgstr "冰龍廳的水潭底下透著白光。潛下去。"

msgid "潭底的黑石台阶下是一间冰室：黑石封坛，冰里的头，钉着它的剑，柱里的人。"
msgstr "潭底的黑石臺階下是一間冰室：黑石封壇，冰裡的頭，釘著它的劍，柱裡的人。"

msgid "看清封物：冰里的头、钉着它的剑、冰柱里的人。听她说——把铜牒念给冰柱里的人听。"
msgstr "看清封物：冰裡的頭、釘著它的劍、冰柱裡的人。聽她說——把銅牒念給冰柱裡的人聽。"

msgid "璃虹：钉拔，它成形，先回这附近的村子；要灭它，三器齐——穿灵、旋芒、宝衣；要再封，须有人留下。"
msgstr "璃虹：釘拔，它成形，先回這附近的村子；要滅它，三器齊——穿靈、旋芒、寶衣；要再封，須有人留下。"

msgid "商玦劝你拔剑。拔，剑到手、鬼醒；不拔，带着封法去京师和岚城，终章再回来。"
msgstr "商玦勸你拔劍。拔，劍到手、鬼醒；不拔，帶著封法去京師和嵐城，終章再回來。"

msgid "你拔出了穿灵。冰里的头睁开了眼，璃虹从冰里跌了出来，商玦笑着散成了黑烟。上岸——天黑之前。"
msgstr "你拔出了穿靈。冰裡的頭睜開了眼，璃虹從冰裡跌了出來，商玦笑著散成了黑煙。上岸——天黑之前。"

msgid "在玉螺湖底拔出了穿灵"
msgstr "在玉螺湖底拔出了穿靈"

msgid "你没有动那把剑。璃虹给了你一片她的羽：再封的时候，放回坛上。"
msgstr "你沒有動那把劍。璃虹給了你一片她的羽：再封的時候，放回壇上。"

msgid "在玉螺湖底看清了封物，没有动它"
msgstr "在玉螺湖底看清了封物，沒有動它"

msgid "天黑了。鬼卒从湖里上来——守住村子：湖畔、村口、稻田边。（湖畔的木船边能等到天黑。）"
msgstr "天黑了。鬼卒從湖裡上來——守住村子：湖畔、村口、稻田邊。（湖畔的木船邊能等到天黑。）"

msgid "天亮了。村子烧了一半，渔夫死在岸边，璃虹在田老财家的东房里躺着。钉没了，它每一夜都在长。"
msgstr "天亮了。村子燒了一半，漁夫死在岸邊，璃虹在田老財家的東房裡躺著。釘沒了，它每一夜都在長。"

msgid "原令"
msgstr "原令"

msgid "璃虹说三器齐才灭得了它：穿灵、旋芒、宝衣。旋芒在岚城，岚城寻风而至——先帝找了它一辈子，寻剑的档案和那道寻剑令的原本都在皇城。去京师。"
msgstr "璃虹說三器齊才滅得了它：穿靈、旋芒、寶衣。旋芒在嵐城，嵐城尋風而至——先帝找了它一輩子，尋劍的檔案和那道尋劍令的原本都在皇城。去京師。"

msgid "拿到了寻剑令的原本"
msgstr "拿到了尋劍令的原本"

msgid "进皇城。三条路：校武场的武举、相国府的公文，或者尚书府里有人知道的一条暗路。"
msgstr "進皇城。三條路：校武場的武舉、相國府的公文，或者尚書府裡有人知道的一條暗路。"

msgid "校武场三场全胜，殿试授了御前侍卫腰牌。退朝时福安凑过来：皇上说，今夜养心殿。"
msgstr "校武場三場全勝，殿試授了御前侍衛腰牌。退朝時福安湊過來：皇上說，今夜養心殿。"

msgid "在京师校武场中了武状元"
msgstr "在京師校武場中了武狀元"

msgid "你随韦相国上了早朝。庾子建当殿驳了奏本，皇上「容朕想想」。退朝时福安追出来：皇上请相国的随员到养心殿说话。"
msgstr "你隨韋相國上了早朝。庾子建當殿駁了奏本，皇上「容朕想想」。退朝時福安追出來：皇上請相國的隨員到養心殿說話。"

msgid "随韦相国上了早朝"
msgstr "隨韋相國上了早朝"

msgid "你从冷宫的井里爬了上来。"
msgstr "你從冷宮的井裡爬了上來。"

msgid "从冷宫的枯井潜进了皇城"
msgstr "從冷宮的枯井潛進了皇城"

msgid "见皇帝：福安说，养心殿。"
msgstr "見皇帝：福安說，養心殿。"

msgid "养心殿里，十六岁的皇帝说：御书房里有父皇的匣子。"
msgstr "養心殿裡，十六歲的皇帝說：御書房裡有父皇的匣子。"

msgid "御书房：把先帝的原令和兵部的抄本放在一起。"
msgstr "御書房：把先帝的原令和兵部的抄本放在一起。"

msgid "原令只一句：寻剑，不得扰民一户。抄本上多出来的三句，是拿着假印的人加的。皇帝给了你一页樵夫的旧记载：风停处即是城。"
msgstr "原令只一句：尋劍，不得擾民一戶。抄本上多出來的三句，是拿著假印的人加的。皇帝給了你一頁樵夫的舊記載：風停處即是城。"

msgid "怎么办：在养心殿朝上揭发（要原令加两样人证物证，关北踏平了工地的要三样）、去尚书府私了，或请皇上先解皇叔的通缉。"
msgstr "怎麼辦：在養心殿朝上揭發（要原令加兩樣人證物證，關北踏平了工地的要三樣）、去尚書府私了，或請皇上先解皇叔的通緝。"

msgid "太和殿上，原令和抄本并排摊开。庾子建拔了刀，冯策站在你身边。他下了狱。"
msgstr "太和殿上，原令和抄本並排攤開。庾子建拔了刀，馮策站在你身邊。他下了獄。"

msgid "在太和殿上揭发了兵部尚书庾子建"
msgstr "在太和殿上揭發了兵部尚書庾子建"

msgid "原令进了庾子建的火盆。你换来了先帝推敲遗书的手稿。他留在朝上。"
msgstr "原令進了庾子建的火盆。你換來了先帝推敲遺書的手稿。他留在朝上。"

msgid "把先帝的原令交给了庾子建"
msgstr "把先帝的原令交給了庾子建"

msgid "皇帝亲笔写了手诏，东二门的布告撤了。手诏要送到水烟阁。"
msgstr "皇帝親筆寫了手詔，東二門的佈告撤了。手詔要送到水煙閣。"

msgid "请皇帝撤了皇叔於兰天武的通缉"
msgstr "請皇帝撤了皇叔於蘭天武的通緝"

msgid "把手诏送到水烟阁，交给皇叔於兰天武。"
msgstr "把手詔送到水煙閣，交給皇叔於蘭天武。"

msgid "於兰天武读了手诏，把传功使交给萧辟尘，回京了。"
msgstr "於蘭天武讀了手詔，把傳功使交給蕭辟塵，回京了。"

msgid "樵夫说：风停处即是城。岚城寻风而至，寻风而逝——天驼关石林里那面镜子后头，有一条原作没修完的路。"
msgstr "樵夫說：風停處即是城。嵐城尋風而至，尋風而逝——天駝關石林裡那面鏡子後頭，有一條原作沒修完的路。"

msgid "找到了岚城"
msgstr "找到了嵐城"

msgid "读懂风，找到岚城。天驼关石林那面镜子里，上道通到哪里？"
msgstr "讀懂風，找到嵐城。天駝關石林那面鏡子裡，上道通到哪裡？"

msgid "风停了。"
msgstr "風停了。"

msgid "白石街尽头的风铃阁。"
msgstr "白石街盡頭的風鈴閣。"

msgid "风铃阁里，十口大铃，有的响，有的不响。"
msgstr "風鈴閣裡，十口大鈴，有的響，有的不響。"

msgid "见岚翁，问他旋芒。"
msgstr "見嵐翁，問他旋芒。"

msgid "岚翁：剑在云台。他不卖，不赏，只问谁拔。"
msgstr "嵐翁：劍在雲臺。他不賣，不賞，只問誰拔。"

msgid "云台：谁拔旋芒——你自己（十铃里要响六口，先接岚翁的接风三刃）、皇叔（要他已经入朝）、萧辟尘（要带着他的风铃）。"
msgstr "雲臺：誰拔旋芒——你自己（十鈴裡要響六口，先接嵐翁的接風三刃）、皇叔（要他已經入朝）、蕭辟塵（要帶著他的風鈴）。"

msgid "风散了，剑落进你手里。岚翁说：十口铃里有人信你，剑就认你。"
msgstr "風散了，劍落進你手裡。嵐翁說：十口鈴裡有人信你，劍就認你。"

msgid "在岚城的云台上拔了旋芒"
msgstr "在嵐城的雲臺上拔了旋芒"

msgid "风把於兰天武送上云台。三百年前於兰家拔错了一把剑，这一把，他拔了。"
msgstr "風把於蘭天武送上雲臺。三百年前於蘭家拔錯了一把劍，這一把，他拔了。"

msgid "在岚城的云台上，看着旋芒落进皇叔於兰天武手里"
msgstr "在嵐城的雲臺上，看著旋芒落進皇叔於蘭天武手裡"

msgid "铃挂回了萧家的钩上，风把萧辟尘送回了家。剑落进他手里。"
msgstr "鈴掛回了蕭家的鉤上，風把蕭辟塵送回了家。劍落進他手裡。"

msgid "在岚城的云台上，看着旋芒落进萧辟尘手里"
msgstr "在嵐城的雲臺上，看著旋芒落進蕭辟塵手裡"

msgid "回到湖底"
msgstr "回到湖底"

msgid "穿灵、旋芒、宝衣。三器凑没凑齐，湖底那颗头都在等。拔钉，斩鬼，或者再封它。"
msgstr "穿靈、旋芒、寶衣。三器湊沒湊齊，湖底那顆頭都在等。拔釘，斬鬼，或者再封它。"

msgid "从玉螺湖底回到了雪亭镇，听了宣诏"
msgstr "從玉螺湖底回到了雪亭鎮，聽了宣詔"

msgid "回到湖底。拔钉，斩鬼，或者再封它。"
msgstr "回到湖底。拔釘，斬鬼，或者再封它。"

msgid "湖面平得像一块铁，结着一层黑冰。冰底下的光一下一下地暗下去。"
msgstr "湖面平得像一塊鐵，結著一層黑冰。冰底下的光一下一下地暗下去。"

msgid "点将：三器在谁手里，来了几拨人。备好了，在湖畔「等到天黑」。"
msgstr "點將：三器在誰手裡，來了幾撥人。備好了，在湖畔「等到天黑」。"

msgid "你在岸边等到了天黑。"
msgstr "你在岸邊等到了天黑。"

msgid "穿灵在你手里"
msgstr "穿靈在你手裡"

msgid "穿灵钉在封坛上"
msgstr "穿靈釘在封壇上"

msgid "旋芒在你手里"
msgstr "旋芒在你手裡"

msgid "交给了庾子建"
msgstr "交給了庾子建"

msgid "旋芒在皇叔手里，他在岸边"
msgstr "旋芒在皇叔手裡，他在岸邊"

msgid "旋芒在萧辟尘手里，他在岸边"
msgstr "旋芒在蕭辟塵手裡，他在岸邊"

msgid "宝衣在你身上"
msgstr "寶衣在你身上"

msgid "带上它，下湖前穿上"
msgstr "帶上它，下湖前穿上"

msgid "宝衣在瑷伦身上"
msgstr "寶衣在璦倫身上"

msgid "她在晚月庄东厢等你去叫（问她「湖底」）"
msgstr "她在晚月莊東廂等你去叫（問她「湖底」）"

msgid "宝衣在安妮儿身上，她在岸边"
msgstr "寶衣在安妮兒身上，她在岸邊"

msgid "帮手"
msgstr "幫手"

msgid "野羊寨（霍铮）守村口"
msgstr "野羊寨（霍錚）守村口"

msgid "关北的骑兵（郭承）守湖畔"
msgstr "關北的騎兵（郭承）守湖畔"

msgid "铁盾会的盾守稻田边"
msgstr "鐵盾會的盾守稻田邊"

msgid "冰龙没有动过，在冰龙厅"
msgstr "冰龍沒有動過，在冰龍廳"

msgid "大内侍卫营（冯策）随你下湖"
msgstr "大內侍衛營（馮策）隨你下湖"

msgid "东方神教（安妮儿）守潭口"
msgstr "東方神教（安妮兒）守潭口"

msgid "水烟阁（南危水）守潭口"
msgstr "水煙閣（南危水）守潭口"

msgid "水烟阁（卫沧澜）守潭口"
msgstr "水煙閣（衛滄瀾）守潭口"

msgid "水烟阁（潘军禅）守潭口"
msgstr "水煙閣（潘軍禪）守潭口"

msgid "封山（柳淳风）守渡口"
msgstr "封山（柳淳風）守渡口"

msgid "北宗（柳绘心）守渡口"
msgstr "北宗（柳繪心）守渡口"

msgid "晚月庄（蓝止萍）守岸"
msgstr "晚月莊（藍止萍）守岸"

msgid "晚月庄（老妇母女）守岸"
msgstr "晚月莊（老婦母女）守岸"

msgid "铁卫营（严廷殷）守官道"
msgstr "鐵衛營（嚴廷殷）守官道"

msgid "茅山（林忌）截住了北麓下湖的路"
msgstr "茅山（林忌）截住了北麓下湖的路"

msgid "岸上：庾子建来要剑"
msgstr "岸上：庾子建來要劍"

msgid "三器都在，帮手也够：能灭它"
msgstr "三器都在，幫手也夠：能滅它"

msgid "这一回只能再封"
msgstr "這一回只能再封"

msgid "天黑了，鬼卒爬上了岸。没人守的地方你自己守；划到湖心，潜下去。"
msgstr "天黑了，鬼卒爬上了岸。沒人守的地方你自己守；劃到湖心，潛下去。"

msgid "你潜下了湖。岸上的人替你守着。"
msgstr "你潛下了湖。岸上的人替你守著。"

msgid "冰龙厅：商玦在水潭边等你。"
msgstr "冰龍廳：商玦在水潭邊等你。"

msgid "商玦倒在冰龙厅的水潭边。"
msgstr "商玦倒在冰龍廳的水潭邊。"

msgid "水潭底下就是封坛。潜下去。"
msgstr "水潭底下就是封壇。潛下去。"

msgid "你回到了湖底。坛心的冰里，那颗头睁着眼。"
msgstr "你回到了湖底。壇心的冰裡，那顆頭睜著眼。"

msgid "封坛：侮天鬼。（钉还钉着的，先拔出穿灵；拔过了的，到坛心「迎上去」。）"
msgstr "封壇：侮天鬼。（釘還釘著的，先拔出穿靈；拔過了的，到壇心「迎上去」。）"

msgid "侮天鬼散成一团黑焰，退回了那颗头底下。"
msgstr "侮天鬼散成一團黑焰，退回了那顆頭底下。"

msgid "最后一下：三器齐、人够，可以钉下去灭了它——宝衣会烧掉；也可以把穿灵交给一个肯留下的人，再封。"
msgstr "最後一下：三器齊、人夠，可以釘下去滅了它——寶衣會燒掉；也可以把穿靈交給一個肯留下的人，再封。"

msgid "旋芒斩它，宝衣挡它的黑焰，穿灵钉它的头。侮天鬼灭了，宝衣烧成了灰。"
msgstr "旋芒斬它，寶衣擋它的黑焰，穿靈釘它的頭。侮天鬼滅了，寶衣燒成了灰。"

msgid "在玉螺湖底灭了侮天鬼"
msgstr "在玉螺湖底滅了侮天鬼"

msgid "瑷伦把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr "璦倫把穿靈釘回那顆頭上，留在了冰裡。侮天鬼再封了。"

msgid "在玉螺湖底再封了侮天鬼，瑷伦留在了冰里"
msgstr "在玉螺湖底再封了侮天鬼，璦倫留在了冰裡"

msgid "璃虹把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr "璃虹把穿靈釘回那顆頭上，留在了冰裡。侮天鬼再封了。"

msgid "在玉螺湖底再封了侮天鬼，璃虹留在了冰里"
msgstr "在玉螺湖底再封了侮天鬼，璃虹留在了冰裡"

msgid "南危水把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr "南危水把穿靈釘回那顆頭上，留在了冰裡。侮天鬼再封了。"

msgid "在玉螺湖底再封了侮天鬼，南危水留在了冰里"
msgstr "在玉螺湖底再封了侮天鬼，南危水留在了冰裡"

msgid "萧辟尘把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr "蕭辟塵把穿靈釘回那顆頭上，留在了冰裡。侮天鬼再封了。"

msgid "在玉螺湖底再封了侮天鬼，萧辟尘留在了冰里"
msgstr "在玉螺湖底再封了侮天鬼，蕭辟塵留在了冰裡"

msgid "你把穿灵钉回那颗头上，自己留在了冰里。"
msgstr "你把穿靈釘回那顆頭上，自己留在了冰裡。"

msgid "在玉螺湖底再封了侮天鬼，自己留在了冰里"
msgstr "在玉螺湖底再封了侮天鬼，自己留在了冰裡"

msgid "回雪亭镇。广场上，那队白衣武官又来了。"
msgstr "回雪亭鎮。廣場上，那隊白衣武官又來了。"

msgid "雪亭镇的广场上，宣了诏。"
msgstr "雪亭鎮的廣場上，宣了詔。"

msgid "淳风武馆的门房换了个年轻人。刘安禄在野羊山上当他的二寨主，逢年过节下山喝一回酒。"
msgstr "淳風武館的門房換了個年輕人。劉安祿在野羊山上當他的二寨主，逢年過節下山喝一回酒。"

msgid "淳风武馆的门房还是那张桌子。刘安禄的事，镇上没人再提。"
msgstr "淳風武館的門房還是那張桌子。劉安祿的事，鎮上沒人再提。"

msgid "淳风武馆的门房空了一冬。刘安禄走的那天没有人送，柳淳风在门里站了很久。"
msgstr "淳風武館的門房空了一冬。劉安祿走的那天沒有人送，柳淳風在門裡站了很久。"

msgid "淳风武馆的门房还是那张桌子。刘安禄的来历，武馆里只有三个人知道。"
msgstr "淳風武館的門房還是那張桌子。劉安祿的來歷，武館裡只有三個人知道。"

msgid "淳风武馆照旧每天卯时开门，「剑不外传」四个字还挂在正厅。绮云镇口多了一块「北宗」的木牌，柳淳风从没去看过，也从没叫人摘。"
msgstr "淳風武館照舊每天卯時開門，「劍不外傳」四個字還掛在正廳。綺雲鎮口多了一塊「北宗」的木牌，柳淳風從沒去看過，也從沒叫人摘。"

msgid "淳风武馆的内院开了一道侧门，镇上的孩子从那里进出。柳淳风书房朝着内院的那扇窗，一冬天都没有关。"
msgstr "淳風武館的內院開了一道側門，鎮上的孩子從那裡進出。柳淳風書房朝著內院的那扇窗，一冬天都沒有關。"

msgid "开春，你回了一趟山里，在老岑的坟前把信末那一行念给他听：风停处，替我再看一眼。——看过了。"
msgstr "開春，你回了一趟山裡，在老岑的墳前把信末那一行念給他聽：風停處，替我再看一眼。——看過了。"

msgid "广场上的人散了。卖馄饨的说，那天的官爷，跟三年前来的是同一拨。"
msgstr "廣場上的人散了。賣餛飩的說，那天的官爺，跟三年前來的是同一撥。"

msgid "振远的绮云分局照旧走镖。陈天星那本总账烧了，二十年前那笔抚恤银，振远没有人再提。"
msgstr "振遠的綺雲分局照舊走鏢。陳天星那本總賬燒了，二十年前那筆撫卹銀，振遠沒有人再提。"

msgid "振远的绮云分局关了门。陈剑秋天天坐在柜台后面，不接镖，也不走。"
msgstr "振遠的綺雲分局關了門。陳劍秋天天坐在櫃檯後面，不接鏢，也不走。"

msgid "瀑布后的山洞里，那座无名的坟前多了一块碑，碑上没有字。"
msgstr "瀑布後的山洞裡，那座無名的墳前多了一塊碑，碑上沒有字。"

msgid "瀑布后的山洞空了。那块腰牌后来回到了水烟阁，挂在葬剑亭里。"
msgstr "瀑布後的山洞空了。那塊腰牌後來回到了水煙閣，掛在葬劍亭裡。"

msgid "老松寨的寨门还在，买路钱一年比一年收得少。"
msgstr "老松寨的寨門還在，買路錢一年比一年收得少。"

msgid "五长老的椅子空着，说是等一个回不来的人。正月十七还没到，阁里没人提虹台。"
msgstr "五長老的椅子空著，說是等一個回不來的人。正月十七還沒到，閣裡沒人提虹臺。"

msgid "卫沧澜回来了，坐在正厅侧的矮凳上，不肯坐那把太师椅。没有人再提「代盟主」三个字；正月十七的虹台，九派要上去推选。"
msgstr "衛滄瀾回來了，坐在正廳側的矮凳上，不肯坐那把太師椅。沒有人再提「代盟主」三個字；正月十七的虹臺，九派要上去推選。"

msgid "南危水说，正月十七他要上虹台，只说一句：老松岭的那个人，替我死了。"
msgstr "南危水說，正月十七他要上虹臺，只說一句：老松嶺的那個人，替我死了。"

msgid "七长老颜违以代盟主自居。他说正月十七一过，「代」字就该去掉了，二十年的旧案，到此为止。"
msgstr "七長老顏違以代盟主自居。他說正月十七一過，「代」字就該去掉了，二十年的舊案，到此為止。"

msgid "传功使的位置空着。弟子们说，萧师父回城里去了。"
msgstr "傳功使的位置空著。弟子們說，蕭師父回城裡去了。"

msgid "东厢的门关着。庄里的人说，守衣人去守另一件东西了。"
msgstr "東廂的門關著。莊裡的人說，守衣人去守另一件東西了。"

msgid "瑷伦回了东厢，宝衣挂在墙上。她说，几百年了，该歇一歇。"
msgstr "璦倫回了東廂，寶衣掛在牆上。她說，幾百年了，該歇一歇。"

msgid "瑷伦回了东厢，墙上挂衣的钉子空着。她说，衣裳烧了，守衣人也该歇了。"
msgstr "璦倫回了東廂，牆上掛衣的釘子空著。她說，衣裳燒了，守衣人也該歇了。"

msgid "安妮儿把宝衣带回了东方神教。神教的香案上，多了一盏长明灯。"
msgstr "安妮兒把寶衣帶回了東方神教。神教的香案上，多了一盞長明燈。"

msgid "安妮儿把宝衣带回了晚月庄的西厢。西厢的门一直关着——神教的事，她不再过问。"
msgstr "安妮兒把寶衣帶回了晚月莊的西廂。西廂的門一直關著——神教的事，她不再過問。"

msgid "安妮儿回了东方神教，带回去的是一捧灰。神教的香案上，多了一只小瓷坛、一盏长明灯。"
msgstr "安妮兒回了東方神教，帶回去的是一捧灰。神教的香案上，多了一隻小瓷罈、一盞長明燈。"

msgid "安妮儿带回西厢的是一捧灰。西厢的门一直关着，窗下多了一只小瓷坛。"
msgstr "安妮兒帶回西廂的是一捧灰。西廂的門一直關著，窗下多了一隻小瓷罈。"

msgid "安妮儿收回了教主令。西厢的灯从此夜夜亮着，神教的人进进出出；朱鸿雪派出去的差事，只剩该死的人。"
msgstr "安妮兒收回了教主令。西廂的燈從此夜夜亮著，神教的人進進出出；朱鴻雪派出去的差事，只剩該死的人。"

msgid "庄里少了一件东西，多了一个故事。池边的人说，护庄的光，那年暗了一暗。"
msgstr "莊裡少了一件東西，多了一個故事。池邊的人說，護莊的光，那年暗了一暗。"

msgid "宝衣出过一回庄，又被人送了回来。池边的人说，护庄的光，那年暗了一暗，又亮了。"
msgstr "寶衣出過一回莊，又被人送了回來。池邊的人說，護莊的光，那年暗了一暗，又亮了。"

msgid "后院书房那幅湘绣图前，又有人在学沧海龙吟了。"
msgstr "後院書房那幅湘繡圖前，又有人在學滄海龍吟了。"

msgid "内书房的老妇再没有开过口。蓝止萍说，庄规是庄规；那一年起，晚月庄的门关得比从前早。"
msgstr "內書房的老婦再沒有開過口。藍止萍說，莊規是莊規；那一年起，晚月莊的門關得比從前早。"

msgid "内书房里多了一个人，不再蒙面。庄里的人说，每天傍晚，老妇擦她的鞭子，她女儿擦她的剑。"
msgstr "內書房裡多了一個人，不再蒙面。莊裡的人說，每天傍晚，老婦擦她的鞭子，她女兒擦她的劍。"

msgid "野羊寨的旗子又插回了山顶。霍铮说，逆灵宫的黑砖，拆下来正好砌寨墙。"
msgstr "野羊寨的旗子又插回了山頂。霍錚說，逆靈宮的黑磚，拆下來正好砌寨牆。"

msgid "黄霸还在土地庙里收他的供。北麓的黑砖道观，没人敢上去看一眼。"
msgstr "黃霸還在土地廟裡收他的供。北麓的黑磚道觀，沒人敢上去看一眼。"

msgid "有人说在北边的雪里见过商玦：一身黑衣结着霜，说话还像念经。"
msgstr "有人說在北邊的雪裡見過商玦：一身黑衣結著霜，說話還像念經。"

msgid "灵心观藏经楼的二楼，镇教秘籍还是六函，第七函的位置空着。林忌说，茅山宁可没有那一函。"
msgstr "靈心觀藏經樓的二樓，鎮教秘籍還是六函，第七函的位置空著。林忌說，茅山寧可沒有那一函。"

msgid "京师尚书府的花园里，那个老花匠又在浇他的花。庾清尘去哪里，他就跟到哪里。"
msgstr "京師尚書府的花園裡，那個老花匠又在澆他的花。庾清塵去哪裡，他就跟到哪裡。"

msgid "藏经楼二楼的第七函回来了。花匠在书架边搭了一张竹床，夜里点着灯，教山上的小道士认北麓的字。"
msgstr "藏經樓二樓的第七函回來了。花匠在書架邊搭了一張竹床，夜裡點著燈，教山上的小道士認北麓的字。"

msgid "北麓下来的孩子在灵心观后山开了一片地。花匠一页一页念给他们听：烧了一辈子的香，坛上写的原来是这些。"
msgstr "北麓下來的孩子在靈心觀後山開了一片地。花匠一頁一頁念給他們聽：燒了一輩子的香，壇上寫的原來是這些。"

msgid "日照山的流云轩里，多了一个独眼的头陀。被鬼卒抓伤的人抬上山来，他一掌按下去，寒气冒成一缕白烟。"
msgstr "日照山的流雲軒裡，多了一個獨眼的頭陀。被鬼卒抓傷的人抬上山來，他一掌按下去，寒氣冒成一縷白煙。"

msgid "头陀在流云轩教人婆萝蜜多心经。玄智说，西来的经和本寺的经放在一个经柜里，没有打架。"
msgstr "頭陀在流雲軒教人婆蘿蜜多心經。玄智說，西來的經和本寺的經放在一個經櫃裡，沒有打架。"

msgid "日照山金门外，那块地方空了。山烟寺还是三百年前的山烟寺：外人不进流云轩，外来的经，也不进。"
msgstr "日照山金門外，那塊地方空了。山煙寺還是三百年前的山煙寺：外人不進流雲軒，外來的經，也不進。"

msgid "被鬼卒抓伤的人抬上山来，玄智守着，三天三夜。有的救回来了，有的没有。"
msgstr "被鬼卒抓傷的人抬上山來，玄智守著，三天三夜。有的救回來了，有的沒有。"

msgid "乔阴的老葛每年秋天挑一担柴上日照山，放在金门边上，说是还那一掌的情。"
msgstr "喬陰的老葛每年秋天挑一擔柴上日照山，放在金門邊上，說是還那一掌的情。"

msgid "乔阴的老葛用左手砍柴，砍得慢。逢人就说：命是山烟寺的方丈守回来的。"
msgstr "喬陰的老葛用左手砍柴，砍得慢。逢人就說：命是山煙寺的方丈守回來的。"

msgid "黑衣人"
msgstr "黑衣人"

msgid "那一夜，茅山的人截在北麓下湖的路上。黑砖道观里再没人提起那个新来的道士——只有门房记得，他戴冠的样子不太像。"
msgstr "那一夜，茅山的人截在北麓下湖的路上。黑磚道觀裡再沒人提起那個新來的道士——只有門房記得，他戴冠的樣子不太像。"

msgid "冰龙厅里那第一剑，是从商玦背后来的。活着回到北麓的道士说，刺他的人戴着宫里的冠。"
msgstr "冰龍廳裡那第一劍，是從商玦背後來的。活著回到北麓的道士說，刺他的人戴著宮裡的冠。"

msgid "北麓的道士还在找一个戴过黑冠的人。他们说他是茅山的眼线；茅山说，没这回事。"
msgstr "北麓的道士還在找一個戴過黑冠的人。他們說他是茅山的眼線；茅山說，沒這回事。"

msgid "程不平对着一本黑皮的名册，把上面的押印一个一个对了出来。槐阳城外有几户人家，收到了县衙的一封信。"
msgstr "程不平對著一本黑皮的名冊，把上面的押印一個一個對了出來。槐陽城外有幾戶人家，收到了縣衙的一封信。"

msgid "程不平的卷宗送上了京城。陈显祖回了乡，桃木箱里只剩一件旧官服。"
msgstr "程不平的卷宗送上了京城。陳顯祖回了鄉，桃木箱裡只剩一件舊官服。"

msgid "陈显祖带着他的箱子走了，没人知道去了哪里。福林酒楼的说书人，把这件事编成了一段新书。"
msgstr "陳顯祖帶著他的箱子走了，沒人知道去了哪裡。福林酒樓的說書人，把這件事編成了一段新書。"

msgid "县衙门口的大皮鼓，又有人敢去敲了。"
msgstr "縣衙門口的大皮鼓，又有人敢去敲了。"

msgid "福林大街的巷子口站着一个官差，叫花子从他跟前过，点个头。真龙头坐在街当中，数着酒囊上的结。"
msgstr "福林大街的巷子口站著一個官差，叫花子從他跟前過，點個頭。真龍頭坐在街當中，數著酒囊上的結。"

msgid "乔阴的巷子里还是没有官差。陆得财腰里那只皮酒囊，二十三个结。"
msgstr "喬陰的巷子裡還是沒有官差。陸得財腰裡那隻皮酒囊，二十三個結。"

msgid "乔阴县衙的公案上，又摊开了庾子建的卷宗：小屋那封信，天驼关那本账。京城没有回话，程不平也没有收卷。"
msgstr "喬陰縣衙的公案上，又攤開了庾子建的卷宗：小屋那封信，天駝關那本賬。京城沒有回話，程不平也沒有收卷。"

msgid "乔阴县衙的卷宗里，压着骆建章的一张供状：兵部抄本上多出来的三句，是谁口述的。"
msgstr "喬陰縣衙的卷宗裡，壓著駱建章的一張供狀：兵部抄本上多出來的三句，是誰口述的。"

msgid "曼雩台上多了一张书案。骆建章给弟弟抄谱，骆云舟在台边练剑；兄弟俩还是不怎么说话。"
msgstr "曼雩臺上多了一張書案。駱建章給弟弟抄譜，駱雲舟在臺邊練劍；兄弟倆還是不怎麼說話。"

msgid "曼雩台上还是骆云舟一个人。他说，大哥的字比他的剑直。"
msgstr "曼雩臺上還是駱雲舟一個人。他說，大哥的字比他的劍直。"

msgid "天驼关的关门照旧，出关留五两。官道上再没有人卖路引；严廷殷换了一个不会茅山术的军师。"
msgstr "天駝關的關門照舊，出關留五兩。官道上再沒有人賣路引；嚴廷殷換了一個不會茅山術的軍師。"

msgid "天驼关的关门抬着，过关不要钱。严廷殷回了京城，再没回来；将军营帐里坐着李信，案上压着一本账的抄本。"
msgstr "天駝關的關門抬著，過關不要錢。嚴廷殷回了京城，再沒回來；將軍營帳裡坐著李信，案上壓著一本賬的抄本。"

msgid "京城的诏书到了槐阳：槐阳王不反。城门上那张「槐阳反」的告示，郭承亲手撕了。"
msgstr "京城的詔書到了槐陽：槐陽王不反。城門上那張「槐陽反」的告示，郭承親手撕了。"

msgid "槐阳城门上那张告示还贴着：槐阳反。程朔说，随他们说。"
msgstr "槐陽城門上那張告示還貼著：槐陽反。程朔說，隨他們說。"

msgid "槐阳王府照旧不问兵部的事。草原上没救出来的四个人，后来有两个自己走了回来。"
msgstr "槐陽王府照舊不問兵部的事。草原上沒救出來的四個人，後來有兩個自己走了回來。"

msgid "铁盾会的院子里又练起了盾。卢卡说，等他攒够了钱，要回海那边去看一看。"
msgstr "鐵盾會的院子裡又練起了盾。盧卡說，等他攢夠了錢，要回海那邊去看一看。"

msgid "铁盾会的院子空了。鬼笠馆的浪人占了那块地，早川直义从此不再出刀。"
msgstr "鐵盾會的院子空了。鬼笠館的浪人佔了那塊地，早川直義從此不再出刀。"

msgid "拜火祠的火，一年到头没有灭过。"
msgstr "拜火祠的火，一年到頭沒有滅過。"

msgid "傅家坡的草顶重新铺过了。渔夫的网挂在他家门口，没有人去收。"
msgstr "傅家坡的草頂重新鋪過了。漁夫的網掛在他家門口，沒有人去收。"

msgid "玉螺湖的渔夫照旧撒网。湖底那盏灯，再没有人见过。"
msgstr "玉螺湖的漁夫照舊撒網。湖底那盞燈，再沒有人見過。"

msgid "石头长高了一截，天天往湖边跑。"
msgstr "石頭長高了一截，天天往湖邊跑。"

msgid "庾子建在天牢里过了冬。少年皇帝第一次在早朝上，说了一整句话。"
msgstr "庾子建在天牢裡過了冬。少年皇帝第一次在早朝上，說了一整句話。"

msgid "京城里都说，是兵部尚书带回了那把剑。皇帝在早朝上，一句话也没有说。"
msgstr "京城裡都說，是兵部尚書帶回了那把劍。皇帝在早朝上，一句話也沒有說。"

msgid "庾子建还在兵部。他派人去过一回玉螺湖，回来的人说，湖面上什么也没有。"
msgstr "庾子建還在兵部。他派人去過一回玉螺湖，回來的人說，湖面上什麼也沒有。"

msgid "於兰天武回了朝，把旋芒挂在养心殿的墙上，对少年皇帝说：剑是用来记事的。"
msgstr "於蘭天武回了朝，把旋芒掛在養心殿的牆上，對少年皇帝說：劍是用來記事的。"

msgid "於兰天武回了朝，站在少年皇帝身后。"
msgstr "於蘭天武回了朝，站在少年皇帝身後。"

msgid "骆建章流放关北。出城那天，他替押解的差人写了一封家书，最后一笔没有甩出格子。"
msgstr "駱建章流放關北。出城那天，他替押解的差人寫了一封家書，最後一筆沒有甩出格子。"

msgid "朝上那天，骆建章的供状和原令摆在一处。西街骆家五代的门匾，后来是骆云舟自己摘的。"
msgstr "朝上那天，駱建章的供狀和原令擺在一處。西街駱家五代的門匾，後來是駱雲舟自己摘的。"

msgid "骆建章的供状进了刑部的案底，乔阴县衙也有一份；庾子建还在兵部。西街骆家的大门，从此没有官家的人来敲。"
msgstr "駱建章的供狀進了刑部的案底，喬陰縣衙也有一份；庾子建還在兵部。西街駱家的大門，從此沒有官家的人來敲。"

msgid "骆建章那张供状，韦相国一直收在袖子里；庾子建还在兵部。西街骆家的大门，从此没有官家的人来敲。"
msgstr "駱建章那張供狀，韋相國一直收在袖子裡；庾子建還在兵部。西街駱家的大門，從此沒有官家的人來敲。"

msgid "玉螺湖底"
msgstr "玉螺湖底"

msgid "冰下封坛一片空。三百年的冰化了一半，水是清的。冰龙还在，只是不再抬头。"
msgstr "冰下封壇一片空。三百年的冰化了一半，水是清的。冰龍還在，只是不再抬頭。"

msgid "冰下封坛的冰柱里，瑷伦披着宝衣站着，眼睛睁着。三百年后，会有人来叫醒她。"
msgstr "冰下封壇的冰柱裡，璦倫披著寶衣站著，眼睛睜著。三百年後，會有人來叫醒她。"

msgid "冰下封坛的冰柱里，璃虹的光又亮了。她说过：第一个带着铜来的，是你。"
msgstr "冰下封壇的冰柱裡，璃虹的光又亮了。她說過：第一個帶著銅來的，是你。"

msgid "冰下封坛的冰柱里，南危水手按剑柄，像还在等什么人。"
msgstr "冰下封壇的冰柱裡，南危水手按劍柄，像還在等什麼人。"

msgid "冰下封坛的冰柱里，萧辟尘握着旋芒。岚城的风，每年会吹到湖面上一回。"
msgstr "冰下封壇的冰柱裡，蕭辟塵握著旋芒。嵐城的風，每年會吹到湖面上一回。"

msgid "冰下封坛的冰柱里，站着一个年轻人。没有人知道他的名字。"
msgstr "冰下封壇的冰柱裡，站著一個年輕人。沒有人知道他的名字。"

msgid "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖水清得能看见底。我说，那是人家的功劳，那碗茶不收钱。」"
msgstr "店小二擦著桌子：「小哥您有所不知——前幾天有個人從湖那邊回來，說湖水清得能看見底。我說，那是人家的功勞，那碗茶不收錢。」"

msgid "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖底冰里站着一个人。我说，那是替咱们守着的，逢年过节，要给他留一碗酒。」"
msgstr "店小二擦著桌子：「小哥您有所不知——前幾天有個人從湖那邊回來，說湖底冰裡站著一個人。我說，那是替咱們守著的，逢年過節，要給他留一碗酒。」"

msgid "店小二擦着桌子：「前些日子有个客官从这儿走出去，就再没回来。楼上那间房，我一直给他留着。」"
msgstr "店小二擦著桌子：「前些日子有個客官從這兒走出去，就再沒回來。樓上那間房，我一直給他留著。」"

msgid "终"
msgstr "終"

msgid "那少年，留在了冰里。"
msgstr "那少年，留在了冰裡。"

msgid "以《东方故事 2》（Eastern Stories 2）为底。"
msgstr "以《東方故事 2》（Eastern Stories 2）為底。"

msgid "谢谢 ES2 的作者们，和 MUD 年代守着它的巫师们。"
msgstr "謝謝 ES2 的作者們，和 MUD 年代守著它的巫師們。"

msgid "也谢谢你，走到了这里。"
msgstr "也謝謝你，走到了這裡。"

msgid "正月十七，九派过半，推你做了武林盟主。那天虹台上，你答了三件事。"
msgstr "正月十七，九派過半，推你做了武林盟主。那天虹臺上，你答了三件事。"

msgid "正月十七，九派过半，颜违做了武林盟主。他说二十年的旧案，到此为止。"
msgstr "正月十七，九派過半，顏違做了武林盟主。他說二十年的舊案，到此為止。"

msgid "正月十七，颜违没能过半。卫沧澜走到石椅前，坐了回去。"
msgstr "正月十七，顏違沒能過半。衛滄瀾走到石椅前，坐了回去。"

msgid "正月十七，颜违没能过半，那把石椅还空着。"
msgstr "正月十七，顏違沒能過半，那把石椅還空著。"

msgid "那天一早，你在山道上截住了神教的杀手，山烟寺的轿子上了山。"
msgstr "那天一早，你在山道上截住了神教的殺手，山煙寺的轎子上了山。"

msgid "那天一早，你回葬剑亭扑灭了逆灵宫余孽放的火。"
msgstr "那天一早，你回葬劍亭撲滅了逆靈宮餘孽放的火。"

msgid "那天一早，你下山解了封山的围。"
msgstr "那天一早，你下山解了封山的圍。"

msgid "那天一早，你从山下的茶棚里请回了骆云舟。"
msgstr "那天一早，你從山下的茶棚裡請回了駱雲舟。"

msgid "山烟寺的轿子在山道上让神教截了，玄智和尚没能上山。"
msgstr "山煙寺的轎子在山道上讓神教截了，玄智和尚沒能上山。"

msgid "葬剑亭的火烧了半个时辰，林忌提着剑一路追下了北麓。"
msgstr "葬劍亭的火燒了半個時辰，林忌提著劍一路追下了北麓。"

msgid "封山的人在官道上让人堵到了天黑。"
msgstr "封山的人在官道上讓人堵到了天黑。"

msgid "骆云舟在山下的茶棚里，陪兵部的人喝了一整天的茶。"
msgstr "駱雲舟在山下的茶棚裡，陪兵部的人喝了一整天的茶。"

msgid "旋芒供在了葬剑亭，用黄绫裹着，九派来往的人都看得见。"
msgstr "旋芒供在了葬劍亭，用黃綾裹著，九派來往的人都看得見。"

msgid "你把旋芒还给了风。岚城云台的旋风里，它又转了起来。"
msgstr "你把旋芒還給了風。嵐城雲臺的旋風裡，它又轉了起來。"

msgid "旋芒还在你身上。九派的人说起它，都说那是斩过湖底那颗头的剑。"
msgstr "旋芒還在你身上。九派的人說起它，都說那是斬過湖底那顆頭的劍。"

msgid "那天一早，山下出了事，你没有下石阶。"
msgstr "那天一早，山下出了事，你沒有下石階。"

msgid "虹台上，陈剑秋当着九派说了一句「那本账烧了」，就再没有开口。"
msgstr "虹臺上，陳劍秋當著九派說了一句「那本賬燒了」，就再沒有開口。"

msgid "虹台上，陈剑秋坐在振远的旗下，没有提那本烧掉的账。"
msgstr "虹臺上，陳劍秋坐在振遠的旗下，沒有提那本燒掉的賬。"

msgid "虹台上，陈剑秋替振远要了一个说法。他身后的绮云分局，门还关着。"
msgstr "虹臺上，陳劍秋替振遠要了一個說法。他身後的綺雲分局，門還關著。"

msgid "虹台上，陈剑秋坐在振远的旗下，没有提那本账。他身后的绮云分局，门还关着。"
msgstr "虹臺上，陳劍秋坐在振遠的旗下，沒有提那本賬。他身後的綺雲分局，門還關著。"

msgid "虹台上，蓝止萍坐在晚月庄的旗下。神教的人在台下转了一圈，没有一个走近晚月庄那一席。"
msgstr "虹臺上，藍止萍坐在晚月莊的旗下。神教的人在臺下轉了一圈，沒有一個走近晚月莊那一席。"

msgid "虹台上，晚月庄的旗后面站着一个老妇人和她的女儿。九派里有人认得那把细剑，没有人说破。"
msgstr "虹臺上，晚月莊的旗後面站著一個老婦人和她的女兒。九派裡有人認得那把細劍，沒有人說破。"

msgid "虹台上，花紫会的旗下坐着一个打二十三个结的老叫花子，一直看着台下官道上的官差。"
msgstr "虹臺上，花紫會的旗下坐著一個打二十三個結的老叫花子，一直看著臺下官道上的官差。"

msgid "虹台上，陆得财坐在花紫会的旗下抠着脚。腰里那只皮酒囊，多了一个结。"
msgstr "虹臺上，陸得財坐在花紫會的旗下摳著腳。腰裡那隻皮酒囊，多了一個結。"

msgid "饮风客栈的店小二逢人便说：新盟主在小店住过，就住楼上那间。"
msgstr "飲風客棧的店小二逢人便說：新盟主在小店住過，就住樓上那間。"

msgid "柳淳风说，盟主回来了，封山总算等到了这一天。"
msgstr "柳淳風說，盟主回來了，封山總算等到了這一天。"

msgid "北宗在虹台上有了一个座。柳淳风关了武馆的门，一天没有出来。"
msgstr "北宗在虹臺上有了一個座。柳淳風關了武館的門，一天沒有出來。"

msgid "封山的人那天没能上山。柳淳风回来，只说了一句：明年再去。"
msgstr "封山的人那天沒能上山。柳淳風回來，只說了一句：明年再去。"

msgid "北宗的人那天没能上山。柳淳风在武馆里听说了，一句话也没有说。"
msgstr "北宗的人那天沒能上山。柳淳風在武館裡聽說了，一句話也沒有說。"

msgid "饮风客栈照旧开门。店小二说，正月十七那天，镇上的人都在等山上的消息。"
msgstr "飲風客棧照舊開門。店小二說，正月十七那天，鎮上的人都在等山上的消息。"

msgid "正厅的太师椅上，坐着颜违。山门的告示上写着：老松岭旧案，到此为止。"
msgstr "正廳的太師椅上，坐著顏違。山門的告示上寫著：老松嶺舊案，到此為止。"

msgid "正厅的太师椅上，坐着卫沧澜。二十年的空椅子，有了人。"
msgstr "正廳的太師椅上，坐著衛滄瀾。二十年的空椅子，有了人。"

msgid "正厅的太师椅空着。阁里的人说，那是盟主的椅子——盟主就是你，可你很少回来坐。"
msgstr "正廳的太師椅空著。閣裡的人說，那是盟主的椅子——盟主就是你，可你很少回來坐。"

msgid "正厅的太师椅空着。颜违照旧代理，「代」字没能去掉。"
msgstr "正廳的太師椅空著。顏違照舊代理，「代」字沒能去掉。"

msgid "正厅的太师椅空着，等一个回不来的人。"
msgstr "正廳的太師椅空著，等一個回不來的人。"

msgid "老松岭的旧案重新翻了出来，水烟阁的人往京城去了几回。"
msgstr "老松嶺的舊案重新翻了出來，水煙閣的人往京城去了幾回。"

msgid "水烟阁同朝廷走近了。兵部来了人，在山门外喝了一回茶。"
msgstr "水煙閣同朝廷走近了。兵部來了人，在山門外喝了一回茶。"

msgid "绮云镇 · 场院"
msgstr "綺雲鎮 · 場院"

#~ msgid "九派逐了东方神教。棺材铺后面的场院关了门，朱鸿雪不知去向。"
#~ msgstr "九派逐了東方神教。棺材鋪後面的場院關了門，朱鴻雪不知去向。"

msgid "神教照旧在棺材铺后面的场院里派差事。九派说，只要不犯到他们头上。"
msgstr "神教照舊在棺材鋪後面的場院裡派差事。九派說，只要不犯到他們頭上。"

msgid "虹台上没有人提神教的事。朱鸿雪照旧派她的差事。"
msgstr "虹臺上沒有人提神教的事。朱鴻雪照舊派她的差事。"

msgid "安妮儿闭了西厢的门。神教的事，她不再同人说起。"
msgstr "安妮兒閉了西廂的門。神教的事，她不再同人說起。"

msgid "朱鸿雪记住了，那天山道上截住她的人的，是你。"
msgstr "朱鴻雪記住了，那天山道上截住她的人的，是你。"

msgid "野羊山北麓"
msgstr "野羊山北麓"

msgid "北麓的道观空了，官兵封了山门。"
msgstr "北麓的道觀空了，官兵封了山門。"

msgid "下了山的道士在茅山的田里种地，坛上的火灭了。"
msgstr "下了山的道士在茅山的田裡種地，壇上的火滅了。"

msgid "九派的人上了北麓。道观里剩下的人，一个也没走脱。"
msgstr "九派的人上了北麓。道觀裡剩下的人，一個也沒走脫。"

msgid "茅山的人上了北麓，把肯下山的领了回去。"
msgstr "茅山的人上了北麓，把肯下山的領了回去。"

msgid "官兵上了北麓，把道观里剩下的人领下了山。卫沧澜说，这一回欠朝廷的。"
msgstr "官兵上了北麓，把道觀裡剩下的人領下了山。衛滄瀾說，這一回欠朝廷的。"

msgid "北麓的道观里，续灯的火一直没灭。"
msgstr "北麓的道觀裡，續燈的火一直沒滅。"

msgid "林忌那天一路追到北麓，追回了两个放火的孩子。"
msgstr "林忌那天一路追到北麓，追回了兩個放火的孩子。"

msgid "乔阴 · 天驼关 · 京师"
msgstr "喬陰 · 天駝關 · 京師"

msgid "你是封山剑派的弟子，师父是柳淳风。"
msgstr "你是封山劍派的弟子，師父是柳淳風。"

msgid "你是封山剑派北宗的人，和柳绘心同辈。"
msgstr "你是封山劍派北宗的人，和柳繪心同輩。"

msgid "柳淳风认得老岑的信：淳风武馆的门，你随时进。"
msgstr "柳淳風認得老岑的信：淳風武館的門，你隨時進。"

msgid "柳淳风替你给水烟阁的潘军禅写过一封信。"
msgstr "柳淳風替你給水煙閣的潘軍禪寫過一封信。"

msgid "雪亭镇上没人再敢借淳风武馆的名头收钱。是你清的。"
msgstr "雪亭鎮上沒人再敢借淳風武館的名頭收錢。是你清的。"

msgid "逄义认了那块腰牌。他欠武馆一句交代。"
msgstr "逄義認了那塊腰牌。他欠武館一句交代。"

msgid "武馆的人都知道，是你说破了门房的来历。"
msgstr "武館的人都知道，是你說破了門房的來歷。"

msgid "刘安禄的来历，你替他瞒着。他欠你一句话。"
msgstr "劉安祿的來歷，你替他瞞著。他欠你一句話。"

msgid "你和血手刘三动过刀，放了他一条路。"
msgstr "你和血手劉三動過刀，放了他一條路。"

msgid "《悟疾风劲竹书》在柳淳风的匣里。是你从竹林里取回来给他的。"
msgstr "《悟疾風勁竹書》在柳淳風的匣裡。是你從竹林裡取回來給他的。"

msgid "柳绘心读到了父亲年轻时写的书。是你给她的。"
msgstr "柳繪心讀到了父親年輕時寫的書。是你給她的。"

msgid "柳淳风认你是掌门传人，「点」字诀是他亲传的。北宗的牌子挂在绮云镇口。"
msgstr "柳淳風認你是掌門傳人，「點」字訣是他親傳的。北宗的牌子掛在綺雲鎮口。"

msgid "你跟柳绘心立了北宗。柳淳风不再教你，武馆的门还开着。"
msgstr "你跟柳繪心立了北宗。柳淳風不再教你，武館的門還開著。"

msgid "正月十七，封山那一票听你的。"
msgstr "正月十七，封山那一票聽你的。"

msgid "你是振远镖局的人。"
msgstr "你是振遠鏢局的人。"

msgid "陈剑秋把二十年前那张镖单交给了你。这件事，振远至今不提。"
msgstr "陳劍秋把二十年前那張鏢單交給了你。這件事，振遠至今不提。"

msgid "那张镖单，是你替陈天星带到京师的。他要查到底。"
msgstr "那張鏢單，是你替陳天星帶到京師的。他要查到底。"

msgid "陈天星查清了二十年前那趟镖：是兵部点名改走的老松岭。"
msgstr "陳天星查清了二十年前那趟鏢：是兵部點名改走的老松嶺。"

msgid "你替振远押过一趟镖，从绮云镇一路押到京师总局。"
msgstr "你替振遠押過一趟鏢，從綺雲鎮一路押到京師總局。"

msgid "碎石小路上劫镖的后生，你交给了官府。"
msgstr "碎石小路上劫鏢的後生，你交給了官府。"

msgid "碎石小路上劫镖的后生，你放他走了。他爹是二十年前死在老松岭的趟子手。"
msgstr "碎石小路上劫鏢的後生，你放他走了。他爹是二十年前死在老松嶺的趟子手。"

msgid "陈天星给了你一张振远的名帖：持帖者，振远的朋友。"
msgstr "陳天星給了你一張振遠的名帖：持帖者，振遠的朋友。"

msgid "潘军禅把镖单锁进了刑堂，振远的脸面保住了。陈剑秋松了一口气。"
msgstr "潘軍禪把鏢單鎖進了刑堂，振遠的臉面保住了。陳劍秋鬆了一口氣。"

msgid "陈剑秋说：查到底。正月十七，振远那一票投旧盟主。"
msgstr "陳劍秋說：查到底。正月十七，振遠那一票投舊盟主。"

msgid "陈天星翻了振远二十年的总账：绮云分局开张的本钱，是兵部给的抚恤银。"
msgstr "陳天星翻了振遠二十年的總賬：綺雲分局開張的本錢，是兵部給的撫卹銀。"

msgid "你劝住了陈天星：那本总账烧了，抚恤银的事，振远不再提。陈剑秋许你学春风快意刀。"
msgstr "你勸住了陳天星：那本總賬燒了，撫卹銀的事，振遠不再提。陳劍秋許你學春風快意刀。"

msgid "你跟陈天星查到底：振远的总账押去了乔阴县衙。绮云分局关了门，陈剑秋还坐在柜台后面。"
msgstr "你跟陳天星查到底：振遠的總賬押去了喬陰縣衙。綺雲分局關了門，陳劍秋還坐在櫃檯後面。"

msgid "正月十七，振远那一票听你的。"
msgstr "正月十七，振遠那一票聽你的。"

msgid "你是天邪派的弟子。"
msgstr "你是天邪派的弟子。"

msgid "潘军禅给你看过那柄「邪剑穿灵」：它是鱼饵。"
msgstr "潘軍禪給你看過那柄「邪劍穿靈」：它是魚餌。"

msgid "南危水把二十年的事托给了你。你没有告诉别人。"
msgstr "南危水把二十年的事託給了你。你沒有告訴別人。"

msgid "颜违记得，五长老的事是你告诉他的。他从那天起代行盟主之职。"
msgstr "顏違記得，五長老的事是你告訴他的。他從那天起代行盟主之職。"

msgid "盟主卫沧澜是你从尚书府带出来的。"
msgstr "盟主衛滄瀾是你從尚書府帶出來的。"

msgid "於兰天武的通缉是你解的。他回了京。"
msgstr "於蘭天武的通緝是你解的。他回了京。"

msgid "你在水烟阁的山门值过一班，拿下了一个打听盟主的探子。"
msgstr "你在水煙閣的山門值過一班，拿下了一個打聽盟主的探子。"

msgid "你在水烟阁的山门拿错了人，真的探子趁乱下了山。"
msgstr "你在水煙閣的山門拿錯了人，真的探子趁亂下了山。"

msgid "二十年前那张镖单锁在水烟阁的刑堂里。是你交给潘军禅的。"
msgstr "二十年前那張鏢單鎖在水煙閣的刑堂裡。是你交給潘軍禪的。"

msgid "潘军禅告诉你：二十年前带走盟主的，是一队挂兵部刀的白衣武官。"
msgstr "潘軍禪告訴你：二十年前帶走盟主的，是一隊掛兵部刀的白衣武官。"

msgid "你站在颜违一边。你是水烟阁的执事；潘军禅从此只同你谈公事。"
msgstr "你站在顏違一邊。你是水煙閣的執事；潘軍禪從此只同你談公事。"

msgid "正月十七，天邪派那一票投颜违。"
msgstr "正月十七，天邪派那一票投顏違。"

msgid "正月十七，你站在潘军禅一边：等盟主回来。你是水烟阁的执事；颜违记下了你。"
msgstr "正月十七，你站在潘軍禪一邊：等盟主回來。你是水煙閣的執事；顏違記下了你。"

msgid "正月十七，天邪派那一票听你的。"
msgstr "正月十七，天邪派那一票聽你的。"

msgid "你是绝尘派的弟子。"
msgstr "你是絕塵派的弟子。"

msgid "你是过阵的客：走得出绝尘子的八卦阵。"
msgstr "你是過陣的客：走得出絕塵子的八卦陣。"

msgid "你把阿牛和小翠从青石村北边闹鬼的山洞里领了出来。村长终于把那句话说完了：国之将亡，必有妖孽。"
msgstr "你把阿牛和小翠從青石村北邊鬧鬼的山洞裡領了出來。村長終於把那句話說完了：國之將亡，必有妖孽。"

msgid "绝尘子知道洞里有东西。阵守得住石室，他就不管——绝尘派不问世事。"
msgstr "絕塵子知道洞裡有東西。陣守得住石室，他就不管——絕塵派不問世事。"

msgid "首徒了尘不这么想。他说话的时候，一直看着佛像下的师父。"
msgstr "首徒了塵不這麼想。他說話的時候，一直看著佛像下的師父。"

msgid "绝尘子答应了：正月十七下山走一趟。"
msgstr "絕塵子答應了：正月十七下山走一趟。"

msgid "你是茅山派的弟子。"
msgstr "你是茅山派的弟子。"

msgid "林忌认你做茅山的朋友，许你上了藏经楼。"
msgstr "林忌認你做茅山的朋友，許你上了藏經樓。"

msgid "林忌的师弟在京师兵部尚书府种了二十年花；你找到了他。"
msgstr "林忌的師弟在京師兵部尚書府種了二十年花；你找到了他。"

msgid "《上清符箓》在你手里：前半是茅山的符，后半是逆灵宫的字。"
msgstr "《上清符籙》在你手裡：前半是茅山的符，後半是逆靈宮的字。"

msgid "花匠上了灵心观，在殿门里叫了林忌一声师兄。"
msgstr "花匠上了靈心觀，在殿門裡叫了林忌一聲師兄。"

msgid "《上清符箓》投进了灵心观的香炉。茅山宁可没有那一函。"
msgstr "《上清符籙》投進了靈心觀的香爐。茅山寧可沒有那一函。"

msgid "《上清符箓》锁回了藏经楼二楼，花匠守着它；他教茅山道术，谁都教。林忌对你冷了一分。"
msgstr "《上清符籙》鎖回了藏經樓二樓，花匠守著它；他教茅山道術，誰都教。林忌對你冷了一分。"

msgid "北麓剩下的人，花匠拿着符箓念下了山。"
msgstr "北麓剩下的人，花匠拿著符籙念下了山。"

msgid "林忌托你戴着黑冠回了逆灵宫，替茅山看，替茅山听。"
msgstr "林忌託你戴著黑冠回了逆靈宮，替茅山看，替茅山聽。"

msgid "那卷残卷，林忌当着你的面烧了。"
msgstr "那卷殘卷，林忌當著你的面燒了。"

msgid "残卷你还给了玄冥子。林忌没再提它，看你的眼神冷了一分。"
msgstr "殘卷你還給了玄冥子。林忌沒再提它，看你的眼神冷了一分。"

msgid "逆灵宫的祭品名单，是你抄出来递给茅山的。"
msgstr "逆靈宮的祭品名單，是你抄出來遞給茅山的。"

msgid "地牢里新关的三个人，是你放出来的。"
msgstr "地牢裡新關的三個人，是你放出來的。"

msgid "逆灵宫那本祭品名册的原本，你从铁匣里带了出来。"
msgstr "逆靈宮那本祭品名冊的原本，你從鐵匣裡帶了出來。"

msgid "正月十七，茅山那一票听你的。"
msgstr "正月十七，茅山那一票聽你的。"

msgid "北麓那座道观，你交给了官府去剿。"
msgstr "北麓那座道觀，你交給了官府去剿。"

msgid "逆灵宫剩下的人下了山，茅山看着。是你去劝的。"
msgstr "逆靈宮剩下的人下了山，茅山看著。是你去勸的。"

msgid "你是晚月庄的弟子。"
msgstr "你是晚月莊的弟子。"

msgid "你是晚月庄的护法：不是弟子，庄里的事算你一份。"
msgstr "你是晚月莊的護法：不是弟子，莊裡的事算你一份。"

msgid "失传的沧海龙吟，又在区冥的神位前跳了一回。"
msgstr "失傳的滄海龍吟，又在區冥的神位前跳了一回。"

msgid "寒於宝衣留在晚月庄。瑷伦替你守到决战。"
msgstr "寒於寶衣留在晚月莊。璦倫替你守到決戰。"

msgid "宝衣是你带出庄的。那一夜，庄里死了人。"
msgstr "寶衣是你帶出莊的。那一夜，莊裡死了人。"

msgid "宝衣又是你送回来的。瑷伦又是守衣人。"
msgstr "寶衣又是你送回來的。璦倫又是守衣人。"

msgid "晚月庄守了几百年的宝衣，你交给了外人。"
msgstr "晚月莊守了幾百年的寶衣，你交給了外人。"

msgid "正月十七，晚月庄那一票改投颜违：逐神教。"
msgstr "正月十七，晚月莊那一票改投顏違：逐神教。"

msgid "正月十七，晚月庄那一票听你的。"
msgstr "正月十七，晚月莊那一票聽你的。"

msgid "无名老妇说：令牌在我这里。她还活着。"
msgstr "無名老婦說：令牌在我這裡。她還活著。"

msgid "蓝止萍说：庄规是你陪我守下来的。"
msgstr "藍止萍說：莊規是你陪我守下來的。"

msgid "无名老妇说：你把我女儿带回来了。"
msgstr "無名老婦說：你把我女兒帶回來了。"

msgid "蓝止萍说：庄规，你替她破了一回。"
msgstr "藍止萍說：莊規，你替她破了一回。"

msgid "你是山烟寺的弟子。"
msgstr "你是山煙寺的弟子。"

msgid "你是流云轩的帮手：帮手不必落发。"
msgstr "你是流雲軒的幫手：幫手不必落髮。"

msgid "你替流云轩采齐了玄智的三味药，喂了乔阴的樵夫老葛——寒气还是退不下去。"
msgstr "你替流雲軒採齊了玄智的三味藥，餵了喬陰的樵夫老葛——寒氣還是退不下去。"

msgid "你领金门外的独眼头陀进了流云轩，老葛当场好了。玄智记下了：你不守寺规。"
msgstr "你領金門外的獨眼頭陀進了流雲軒，老葛當場好了。玄智記下了：你不守寺規。"

msgid "你照了寺规。玄智守了老葛三天三夜，命保住了，右手废了。"
msgstr "你照了寺規。玄智守了老葛三天三夜，命保住了，右手廢了。"

msgid "玄智和尚信了你的担保。正月十七，山烟寺那一票投旧盟主。"
msgstr "玄智和尚信了你的擔保。正月十七，山煙寺那一票投舊盟主。"

msgid "龙若法王说起了三十年前的事，给了你婆萝蜜多心经的一页贝叶：「收不收，是山烟寺的事。」"
msgstr "龍若法王說起了三十年前的事，給了你婆蘿蜜多心經的一頁貝葉：「收不收，是山煙寺的事。」"

msgid "山烟寺收了西来的经：独眼头陀受戒入寺，流云轩从此治得了鬼卒的寒。"
msgstr "山煙寺收了西來的經：獨眼頭陀受戒入寺，流雲軒從此治得了鬼卒的寒。"

msgid "山烟寺守了本寺一脉：经交还了龙若法王，金门外空了。"
msgstr "山煙寺守了本寺一脈：經交還了龍若法王，金門外空了。"

msgid "正月十七，山烟寺那一票听你的。"
msgstr "正月十七，山煙寺那一票聽你的。"

msgid "你是步玄派的弟子。"
msgstr "你是步玄派的弟子。"

msgid "你走出了桃林，骆云舟认你做桃林的客。"
msgstr "你走出了桃林，駱雲舟認你做桃林的客。"

msgid "你在曼雩台上问过了剑：风泉剑灵在「剑神如意」之前收了剑。"
msgstr "你在曼雩臺上問過了劍：風泉劍靈在「劍神如意」之前收了劍。"

msgid "骆云舟托你给他十年没说过话的大哥骆建章送一封家书。"
msgstr "駱雲舟託你給他十年沒說過話的大哥駱建章送一封家書。"

msgid "骆建章读了弟弟的信，说他还是那么写字，最后一笔甩出格子。"
msgstr "駱建章讀了弟弟的信，說他還是那麼寫字，最後一筆甩出格子。"

msgid "兵部抄本上多出来的三句是骆建章落的笔；他认了。"
msgstr "兵部抄本上多出來的三句是駱建章落的筆；他認了。"

msgid "骆云舟十年来第一次回京城，兄弟俩在相国府的厅上见了面。"
msgstr "駱雲舟十年來第一次回京城，兄弟倆在相國府的廳上見了面。"

msgid "骆建章写了供状：兵部抄本上那三句，是庾子建口述的。骆家和朝廷翻了脸。"
msgstr "駱建章寫了供狀：兵部抄本上那三句，是庾子建口述的。駱家和朝廷翻了臉。"

msgid "骆建章在刑部照实供了，判了流放。骆家和朝廷翻了脸。"
msgstr "駱建章在刑部照實供了，判了流放。駱家和朝廷翻了臉。"

msgid "骆云舟带大哥回了乔阴，抄本的事不再提；骆家照旧是京城的世家。"
msgstr "駱雲舟帶大哥回了喬陰，抄本的事不再提；駱家照舊是京城的世家。"

msgid "骆云舟把骆家的名帖给了你。"
msgstr "駱雲舟把駱家的名帖給了你。"

msgid "正月十七，步玄派那一票听你的。"
msgstr "正月十七，步玄派那一票聽你的。"

msgid "你是花紫会的人。"
msgstr "你是花紫會的人。"

msgid "你替花紫会从兵部的胡管事身上摸回了槐阳八户的卖身契。"
msgstr "你替花紫會從兵部的胡管事身上摸回了槐陽八戶的賣身契。"

msgid "乔阴的陆得财是龙头的替身。你数着皮酒囊上的结，一个一个问了过去。"
msgstr "喬陰的陸得財是龍頭的替身。你數著皮酒囊上的結，一個一個問了過去。"

msgid "你在京师尚书府的后墙根下见到了真龙头：二十三个结。"
msgstr "你在京師尚書府的後牆根下見到了真龍頭：二十三個結。"

#~ msgid "尚书府小屋那封密信，你交给了真龙头。庾家不敢清乔阴的巷子。"
#~ msgstr "尚書府小屋那封密信，你交給了真龍頭。庾家不敢清喬陰的巷子。"

msgid "密信你交给了官府。叫花子不再跟你说正事。"
msgstr "密信你交給了官府。叫花子不再跟你說正事。"

msgid "你照真龙头的话，夜里从尚书府的狗洞把卫沧澜领了出来。"
msgstr "你照真龍頭的話，夜裡從尚書府的狗洞把衛滄瀾領了出來。"

msgid "你在福林大街认了二十三个结：真龙头坐回了乔阴，花紫会吃上了官饭，巡捕不再抓花紫会的人。陆得财出了北门。"
msgstr "你在福林大街認了二十三個結：真龍頭坐回了喬陰，花紫會吃上了官飯，巡捕不再抓花紫會的人。陸得財出了北門。"

msgid "你在福林大街认了这些年管事的陆得财：真龙头把皮酒囊系到他腰上，回了京师的墙根。乔阴的巷子里照旧没有官差。"
msgstr "你在福林大街認了這些年管事的陸得財：真龍頭把皮酒囊繫到他腰上，回了京師的牆根。喬陰的巷子裡照舊沒有官差。"

msgid "正月十七，花紫会那一票听你的。"
msgstr "正月十七，花紫會那一票聽你的。"

msgid "官府"
msgstr "官府"

msgid "乔阴知县程不平替你写过一封信。"
msgstr "喬陰知縣程不平替你寫過一封信。"

msgid "陈显祖是你护送进县衙作的证。"
msgstr "陳顯祖是你護送進縣衙作的證。"

msgid "天驼关的严廷殷看过程不平的信。"
msgstr "天駝關的嚴廷殷看過程不平的信。"

msgid "你是今科的武状元。"
msgstr "你是今科的武狀元。"

msgid "兵部尚书庾子建是你在朝上揭发的。"
msgstr "兵部尚書庾子建是你在朝上揭發的。"

msgid "你和庾子建私了了。兵部记着这份情，也记着这笔账。"
msgstr "你和庾子建私了了。兵部記著這份情，也記著這筆賬。"

msgid "大内侍卫营的冯策说过：算老夫一个。"
msgstr "大內侍衛營的馮策說過：算老夫一個。"

msgid "逆灵宫的余孽，是你交给官府的。"
msgstr "逆靈宮的餘孽，是你交給官府的。"

msgid "振远的总账是陈天星押进乔阴县衙的。程不平收下了，兵部的抚恤银记在了案上。"
msgstr "振遠的總賬是陳天星押進喬陰縣衙的。程不平收下了，兵部的撫卹銀記在了案上。"

msgid "尚书府小屋那封密信，是你交到程不平手上的。"
msgstr "尚書府小屋那封密信，是你交到程不平手上的。"

msgid "你是乔阴县的捕快，腰里挂着程不平给的黑漆腰牌。"
msgstr "你是喬陰縣的捕快，腰裡掛著程不平給的黑漆腰牌。"

msgid "雪亭路口、绮云镇口那两个打着官府告示收过路费的，是你拿下的。"
msgstr "雪亭路口、綺雲鎮口那兩個打著官府告示收過路費的，是你拿下的。"

msgid "他们身上的路引盖着天驼关铁卫营的大印。程不平说：印在严将军手里。"
msgstr "他們身上的路引蓋著天駝關鐵衛營的大印。程不平說：印在嚴將軍手裡。"

msgid "武举的第一场，程不平的荐书替你免了。"
msgstr "武舉的第一場，程不平的薦書替你免了。"

msgid "尚书府小屋那封密信，你给了花紫会。程不平不再跟你说案子。"
msgstr "尚書府小屋那封密信，你給了花紫會。程不平不再跟你說案子。"

msgid "严廷殷认了路引上的印。印丢的那三天，副将李信记了一本账：盖印的是军师赫造基，兵部还拓了个模子去盖民夫令。"
msgstr "嚴廷殷認了路引上的印。印丟的那三天，副將李信記了一本賬：蓋印的是軍師赫造基，兵部還拓了個模子去蓋民夫令。"

msgid "你跟严廷殷整肃了天驼关：军师是你在将军营帐里拿下的，那本账没有上京。铁卫营欠你一回。"
msgstr "你跟嚴廷殷整肅了天駝關：軍師是你在將軍營帳裡拿下的，那本賬沒有上京。鐵衛營欠你一回。"

msgid "你跟严廷殷整肃了天驼关：军师还在将军营帐里，等你去拿。"
msgstr "你跟嚴廷殷整肅了天駝關：軍師還在將軍營帳裡，等你去拿。"

msgid "你跟李信揭发了天驼关：那本账上了京，严廷殷被召回，李信守关，过关不再收钱。"
msgstr "你跟李信揭發了天駝關：那本賬上了京，嚴廷殷被召回，李信守關，過關不再收錢。"

msgid "小屋那封信和天驼关那本账放在一起，程不平又开了一回庾子建的堂。"
msgstr "小屋那封信和天駝關那本賬放在一起，程不平又開了一回庾子建的堂。"

msgid "卫沧澜是皇叔拿着手诏从尚书府要回来的。"
msgstr "衛滄瀾是皇叔拿著手詔從尚書府要回來的。"

msgid "安妮儿说，她在等一个配得上宝衣的人。"
msgstr "安妮兒說，她在等一個配得上寶衣的人。"

msgid "安妮儿说你配得上。东方神教记得你。"
msgstr "安妮兒說你配得上。東方神教記得你。"

msgid "晚月庄那块杀手令牌，是你还给神教的。朱鸿雪说：令回来了就好。"
msgstr "晚月莊那塊殺手令牌，是你還給神教的。朱鴻雪說：令回來了就好。"

msgid "宝衣出了庄，没进安妮儿的门。她记下了你的名字。"
msgstr "寶衣出了莊，沒進安妮兒的門。她記下了你的名字。"

msgid "你放过了神教的那个杀手。"
msgstr "你放過了神教的那個殺手。"

msgid "你接了朱鸿雪的令。"
msgstr "你接了朱鴻雪的令。"

msgid "你把西厢的话照实告诉了朱鸿雪：那件衣，安妮儿不打算交给神教。"
msgstr "你把西廂的話照實告訴了朱鴻雪：那件衣，安妮兒不打算交給神教。"

msgid "你替安妮儿瞒下了西厢的话。她欠你一回。"
msgstr "你替安妮兒瞞下了西廂的話。她欠你一回。"

msgid "朱鸿雪给过你一块黑木令。神教的杀手认得它。"
msgstr "朱鴻雪給過你一塊黑木令。神教的殺手認得它。"

msgid "你手上沾了神教教主的血。朱鸿雪的令，到此为止。"
msgstr "你手上沾了神教教主的血。朱鴻雪的令，到此為止。"

#~ msgid "朱鸿雪给过你三个名字，都是靠近湖底封物的人。"
#~ msgstr "朱鴻雪給過你三個名字，都是靠近湖底封物的人。"

msgid "你替朱鸿雪杀了玉螺湖凿冰的老冰匠。"
msgstr "你替朱鴻雪殺了玉螺湖鑿冰的老冰匠。"

msgid "你劝玉螺湖的老冰匠搬走了，拿他的冰凿去向朱鸿雪交了差。"
msgstr "你勸玉螺湖的老冰匠搬走了，拿他的冰鑿去向朱鴻雪交了差。"

msgid "你拿老冰匠的冰凿骗过朱鸿雪，她当面揭穿了你。"
msgstr "你拿老冰匠的冰鑿騙過朱鴻雪，她當面揭穿了你。"

msgid "朱鸿雪换给你一块赤铜令。"
msgstr "朱鴻雪換給你一塊赤銅令。"

msgid "你站到了安妮儿一边。一代教主收回了教主令，给了你一块黄金令牌。"
msgstr "你站到了安妮兒一邊。一代教主收回了教主令，給了你一塊黃金令牌。"

msgid "你站到了朱鸿雪一边。她给了你一块黄金令牌；西厢的门，从此对你关着。"
msgstr "你站到了朱鴻雪一邊。她給了你一塊黃金令牌；西廂的門，從此對你關著。"

msgid "你进过那座黑砖道观。"
msgstr "你進過那座黑磚道觀。"

msgid "你见过「唤首」。他们知道有生人进过后殿。"
msgstr "你見過「喚首」。他們知道有生人進過後殿。"

msgid "地牢里的人是你放走的。逆灵宫在找那天闯道观的孩子。"
msgstr "地牢裡的人是你放走的。逆靈宮在找那天闖道觀的孩子。"

msgid "玄冥子欠你一条命。他说过：带着残卷来后山找他。"
msgstr "玄冥子欠你一條命。他說過：帶著殘卷來後山找他。"

msgid "玄冥子说你是他的人。"
msgstr "玄冥子說你是他的人。"

msgid "管事道士许你在货栈的通铺上睡——他们当你是新来的道士。"
msgstr "管事道士許你在貨棧的通鋪上睡——他們當你是新來的道士。"

msgid "子时在后殿外，巡殿的道士撞见过你。"
msgstr "子時在後殿外，巡殿的道士撞見過你。"

msgid "宫里在找一本不见了的名册。"
msgstr "宮裡在找一本不見了的名冊。"

msgid "玄冥子托你从宫主的书案底下取出天书的下半部；他教你的，是六阴剑。"
msgstr "玄冥子託你從宮主的書案底下取出天書的下半部；他教你的，是六陰劍。"

msgid "你把唤首前夜下湖的时辰和路交给了茅山。宫里迟早会知道是谁。"
msgstr "你把喚首前夜下湖的時辰和路交給了茅山。宮裡遲早會知道是誰。"

msgid "唤首那一夜你戴着冠下湖——冰龙厅里那第一剑，是你从背后刺的。"
msgstr "喚首那一夜你戴著冠下湖——冰龍廳裡那第一劍，是你從背後刺的。"

msgid "黑冠还戴在你头上：唤首那一夜，你跟他们下湖。"
msgstr "黑冠還戴在你頭上：喚首那一夜，你跟他們下湖。"

msgid "你被识破了。黑冠不再管用，北麓有人在找你。"
msgstr "你被識破了。黑冠不再管用，北麓有人在找你。"

msgid "北麓那座道观，官兵上去了。宫里剩下的人一个也没走脱。"
msgstr "北麓那座道觀，官兵上去了。宮裡剩下的人一個也沒走脫。"

msgid "宫里剩下的人跟你下了山。坛上的火灭了。"
msgstr "宮裡剩下的人跟你下了山。壇上的火滅了。"

msgid "拜了柳淳风，淳风武馆的事就是你的事。"
msgstr "拜了柳淳風，淳風武館的事就是你的事。"

msgid "你已经不是封山的人了。淳风武馆的事，到此为止。"
msgstr "你已經不是封山的人了。淳風武館的事，到此為止。"

msgid "问柳淳风「武馆的事」。"
msgstr "問柳淳風「武館的事」。"

msgid "柳淳风说，镇西的青石官道上有人打着淳风武馆的旗号，向来投师的人收十两「拜师钱」。"
msgstr "柳淳風說，鎮西的青石官道上有人打著淳風武館的旗號，向來投師的人收十兩「拜師錢」。"

msgid "去镇西的青石官道，会一会那几个收「拜师钱」的「封山弟子」。"
msgstr "去鎮西的青石官道，會一會那幾個收「拜師錢」的「封山弟子」。"

msgid "为首的罗七倒了，两个帮闲一哄而散。他胸前那块腰牌却是真的：背面刻着一个「逄」字，系绳上拴着绮云镇赌场的竹筹。"
msgstr "為首的羅七倒了，兩個幫閒一哄而散。他胸前那塊腰牌卻是真的：背面刻著一個「逄」字，繫繩上拴著綺雲鎮賭場的竹籌。"

msgid "腰牌是从绮云镇的赌场流出来的。去赌场找那个姓逄的，问他「腰牌」。"
msgstr "腰牌是從綺雲鎮的賭場流出來的。去賭場找那個姓逄的，問他「腰牌」。"

msgid "逄义——柳淳风的同辈师弟——认了：牌是他赌输了押给罗七的。"
msgstr "逄義——柳淳風的同輩師弟——認了：牌是他賭輸了押給羅七的。"

msgid "把腰牌带回淳风武馆，交给柳淳风。"
msgstr "把腰牌帶回淳風武館，交給柳淳風。"

msgid "柳淳风收下了这件事。「门户的名头，不是谁都能借的。」"
msgstr "柳淳風收下了這件事。「門戶的名頭，不是誰都能借的。」"

msgid "清了打着淳风武馆旗号收拜师钱的人"
msgstr "清了打著淳風武館旗號收拜師錢的人"

msgid "大弟子"
msgstr "大弟子"

msgid "罗七在镇上嚷过：武馆的门房是野羊山的血手刘三。李火狮在等一句话，问他「门房」——说破，武馆从此没有他的位置；替他瞒，这句话从此算在你头上。"
msgstr "羅七在鎮上嚷過：武館的門房是野羊山的血手劉三。李火獅在等一句話，問他「門房」——說破，武館從此沒有他的位置；替他瞞，這句話從此算在你頭上。"

msgid "你对李火狮说了实话：门房刘安禄就是野羊山的血手刘三。武馆不留匪。"
msgstr "你對李火獅說了實話：門房劉安祿就是野羊山的血手劉三。武館不留匪。"

msgid "说破了淳风武馆门房的来历"
msgstr "說破了淳風武館門房的來歷"

msgid "你对李火狮说：那伙骗子认错了人。武馆里没人再提这件事。"
msgstr "你對李火獅說：那夥騙子認錯了人。武館裡沒人再提這件事。"

msgid "替淳风武馆的门房瞒下了来历"
msgstr "替淳風武館的門房瞞下了來歷"

msgid "问柳淳风「竹书」。"
msgstr "問柳淳風「竹書」。"

msgid "柳淳风二十岁那年在天驼关的竹林里住过一冬，写了一卷《悟疾风劲竹书》，留在竹林尽头、大黄石后面的石室里。"
msgstr "柳淳風二十歲那年在天駝關的竹林裡住過一冬，寫了一卷《悟疾風勁竹書》，留在竹林盡頭、大黃石後面的石室裡。"

msgid "去天驼关的竹林道，照柳淳风教的法子推开尽头的大黄石，从石室的书柜里取出那卷书。"
msgstr "去天駝關的竹林道，照柳淳風教的法子推開盡頭的大黃石，從石室的書櫃裡取出那卷書。"

msgid "《悟疾风劲竹书》到手了。薄薄一卷，末尾署着柳淳风的名字。"
msgstr "《悟疾風勁竹書》到手了。薄薄一卷，末尾署著柳淳風的名字。"

msgid "书只有一本：交给柳淳风，他会收进匣里；交给柳绘心，她头一回读到父亲年轻时写的字。给出去就读不到了——想读，先读。"
msgstr "書只有一本：交給柳淳風，他會收進匣裡；交給柳繪心，她頭一回讀到父親年輕時寫的字。給出去就讀不到了——想讀，先讀。"

msgid "《悟疾风劲竹书》在你身上"
msgstr "《悟疾風勁竹書》在你身上"

msgid "书不在你身上了——是被人摸走了，还是给了别人？找回来再交"
msgstr "書不在你身上了——是被人摸走了，還是給了別人？找回來再交"

msgid "你把书交给了柳淳风。他没有翻开，收进了案头的匣里：年轻时的糊涂话。"
msgstr "你把書交給了柳淳風。他沒有翻開，收進了案頭的匣裡：年輕時的糊塗話。"

msgid "把《悟疾风劲竹书》带回来交给了柳淳风"
msgstr "把《悟疾風勁竹書》帶回來交給了柳淳風"

msgid "你把书交给了柳绘心。她头一回读到父亲二十岁时写的字：直竹贵地生。"
msgstr "你把書交給了柳繪心。她頭一回讀到父親二十歲時寫的字：直竹貴地生。"

msgid "把《悟疾风劲竹书》带回来交给了柳绘心"
msgstr "把《悟疾風勁竹書》帶回來交給了柳繪心"

msgid "柳绘心这些日子常往武馆的内院去。过些时候再回淳风武馆，到内院看看。"
msgstr "柳繪心這些日子常往武館的內院去。過些時候再回淳風武館，到內院看看。"

msgid "内院里，柳绘心在教外人学封山剑——镇上交不起拜师钱的孩子。柳淳风撞见了。"
msgstr "內院裡，柳繪心在教外人學封山劍——鎮上交不起拜師錢的孩子。柳淳風撞見了。"

msgid "封山要分南北了。跟柳淳风守本宗（问他「本宗」）：剑不外传，他亲传「点」字诀，你是掌门传人，柳绘心离开武馆。跟柳绘心立北宗（问她「北宗」）：剑往外传，她教你「点」字诀，你转入北宗，柳淳风不再教你。"
msgstr "封山要分南北了。跟柳淳風守本宗（問他「本宗」）：劍不外傳，他親傳「點」字訣，你是掌門傳人，柳繪心離開武館。跟柳繪心立北宗（問她「北宗」）：劍往外傳，她教你「點」字訣，你轉入北宗，柳淳風不再教你。"

msgid "你跟了柳淳风：封山只有一宗，剑不外传。他把「点」字诀传给了你。柳绘心带着「北宗」两个字去了绮云镇。"
msgstr "你跟了柳淳風：封山只有一宗，劍不外傳。他把「點」字訣傳給了你。柳繪心帶著「北宗」兩個字去了綺雲鎮。"

msgid "在封山的南北之争里守了本宗"
msgstr "在封山的南北之爭裡守了本宗"

msgid "掌门传人"
msgstr "掌門傳人"

msgid "你跟了柳绘心：北宗的剑往外传。她把自己悟的「点」字诀教给了你。柳淳风不再教你。"
msgstr "你跟了柳繪心：北宗的劍往外傳。她把自己悟的「點」字訣教給了你。柳淳風不再教你。"

msgid "和柳绘心立了封山剑派北宗"
msgstr "和柳繪心立了封山劍派北宗"

msgid "拜了天邪派，水烟阁的门就由你守一回。"
msgstr "拜了天邪派，水煙閣的門就由你守一回。"

msgid "你已经不是天邪派的人了。水烟阁的事，到此为止。"
msgstr "你已經不是天邪派的人了。水煙閣的事，到此為止。"

msgid "去水烟阁正厅，问执法使潘军禅「山门」。"
msgstr "去水煙閣正廳，問執法使潘軍禪「山門」。"

#~ msgid "潘军禅说，正月十七快到了，上山的人多；这一个月，有人在打听盟主的事。他要一个新面孔去山门值一班。"
#~ msgstr "潘軍禪說，正月十七快到了，上山的人多；這一個月，有人在打聽盟主的事。他要一個新面孔去山門值一班。"

msgid "到水烟阁前值守：三个上山的人在门外候着。问清他们的「来意」，听他们怎么说「盟主」，看看「路引」——认出那个来打听盟主的探子，把他「拿下」。拿错了人，真的探子会趁乱走掉。"
msgstr "到水煙閣前值守：三個上山的人在門外候著。問清他們的「來意」，聽他們怎麼說「盟主」，看看「路引」——認出那個來打聽盟主的探子，把他「拿下」。拿錯了人，真的探子會趁亂走掉。"

msgid "山门的一班值完了。"
msgstr "山門的一班值完了。"

msgid "回正厅向潘军禅回话（问他「山门」；搜到了信，把信交给他）。"
msgstr "回正廳向潘軍禪回話（問他「山門」；搜到了信，把信交給他）。"

msgid "潘军禅听完了山门的事。「水烟阁的门，你守过一回了。」"
msgstr "潘軍禪聽完了山門的事。「水煙閣的門，你守過一回了。」"

msgid "替水烟阁在山门值过一班"
msgstr "替水煙閣在山門值過一班"

msgid "问潘军禅「镖单」。二十年前那张镖单只有一张：交给潘军禅，锁进刑堂，振远的脸面水烟阁替他们留着，这件事到此为止；带去京师振远总局交给陈天星，他要查到底——查出来的，未必只是振远的丑事。镖单不在身上的，去绮云镇振远镖局问陈剑秋。"
msgstr "問潘軍禪「鏢單」。二十年前那張鏢單只有一張：交給潘軍禪，鎖進刑堂，振遠的臉面水煙閣替他們留著，這件事到此為止；帶去京師振遠總局交給陳天星，他要查到底——查出來的，未必只是振遠的醜事。鏢單不在身上的，去綺雲鎮振遠鏢局問陳劍秋。"

msgid "你把镖单交给了潘军禅。他锁进了刑堂：振远的脸面，水烟阁替他们留着。"
msgstr "你把鏢單交給了潘軍禪。他鎖進了刑堂：振遠的臉面，水煙閣替他們留著。"

msgid "把二十年前的镖单交给潘军禅锁进了刑堂"
msgstr "把二十年前的鏢單交給潘軍禪鎖進了刑堂"

msgid "你把镖单带去京师，交给了陈天星。他要查到底。"
msgstr "你把鏢單帶去京師，交給了陳天星。他要查到底。"

msgid "把二十年前的镖单带去京师交给了陈天星"
msgstr "把二十年前的鏢單帶去京師交給了陳天星"

msgid "陈天星在翻振远总局二十年前的底账。出了振远总局再进去，听他查到了什么。"
msgstr "陳天星在翻振遠總局二十年前的底賬。出了振遠總局再進去，聽他查到了什麼。"

msgid "陈天星查清了：二十年前那趟镖本该走官道，是兵部来人点名改走老松岭的。"
msgstr "陳天星查清了：二十年前那趟鏢本該走官道，是兵部來人點名改走老松嶺的。"

msgid "回正厅问潘军禅「盟主」。"
msgstr "回正廳問潘軍禪「盟主」。"

msgid "潘军禅说，二十年前带走盟主的是一队白衣武官——腰里挂的是兵部的刀。"
msgstr "潘軍禪說，二十年前帶走盟主的是一隊白衣武官——腰裡掛的是兵部的刀。"

msgid "二十年前带走盟主的是白衣武官。线索在京师尚书府。"
msgstr "二十年前帶走盟主的是白衣武官。線索在京師尚書府。"

msgid "京师那边的事有了结果。"
msgstr "京師那邊的事有了結果。"

msgid "七长老颜违这些日子常下楼来，站在水烟阁正厅那把黝黑的太师椅跟前。去正厅；已经在厅里的，出去走一走再进来。"
msgstr "七長老顏違這些日子常下樓來，站在水煙閣正廳那把黝黑的太師椅跟前。去正廳；已經在廳裡的，出去走一走再進來。"

msgid "正厅里，颜违要在正月十七之前把那把椅子定下来；潘军禅说，等盟主。"
msgstr "正廳裡，顏違要在正月十七之前把那把椅子定下來；潘軍禪說，等盟主。"

msgid "天邪派在虹台上的那一票，看你。站颜违（问他「椅子」）：正月十七由他坐那把椅子，他许你水烟阁执事，二十年的旧案到此为止，潘军禅从此只同你谈公事。站潘军禅（问他「椅子」）：等盟主回来，他以执法使的名义升你执事，颜违会记下你。"
msgstr "天邪派在虹臺上的那一票，看你。站顏違（問他「椅子」）：正月十七由他坐那把椅子，他許你水煙閣執事，二十年的舊案到此為止，潘軍禪從此只同你談公事。站潘軍禪（問他「椅子」）：等盟主回來，他以執法使的名義升你執事，顏違會記下你。"

msgid "你站到了颜违一边：正月十七，天邪派那一票投他。他许你做了水烟阁的执事。"
msgstr "你站到了顏違一邊：正月十七，天邪派那一票投他。他許你做了水煙閣的執事。"

msgid "在水烟阁正厅站到了颜违一边"
msgstr "在水煙閣正廳站到了顏違一邊"

msgid "执事"
msgstr "執事"

msgid "你站到了潘军禅一边：等盟主回来。他以执法使的名义升你做了执事。颜违记下了你。"
msgstr "你站到了潘軍禪一邊：等盟主回來。他以執法使的名義升你做了執事。顏違記下了你。"

msgid "在水烟阁正厅站到了潘军禅一边：等盟主回来"
msgstr "在水煙閣正廳站到了潘軍禪一邊：等盟主回來"

msgid "戴着黑冠回逆灵宫，替茅山的林忌做眼线。"
msgstr "戴著黑冠回逆靈宮，替茅山的林忌做眼線。"

#~ msgid "疑点满了三条。宫里认出你，只是早晚的事——下回戴着冠进前院，就是那一天：那一仗你打不过，不必打，出了前院的门就算逃过了。黑冠不会再替你遮掩；递出去的名单、带走的名册，茅山照样用得上，剑谱也还在你手里。"
#~ msgstr "疑點滿了三條。宮裡認出你，只是早晚的事——下回戴著冠進前院，就是那一天：那一仗你打不過，不必打，出了前院的門就算逃過了。黑冠不會再替你遮掩；遞出去的名單、帶走的名冊，茅山照樣用得上，劍譜也還在你手裡。"

msgid "疑点"
msgstr "疑點"

msgid "残卷没回宫：宫里少了一卷书，迟早有人问起"
msgstr "殘卷沒回宮：宮裡少了一卷書，遲早有人問起"

msgid "那一夜丢了人：地牢空了，他们记得那天闯进来的人"
msgstr "那一夜丟了人：地牢空了，他們記得那天闖進來的人"

msgid "子时在后殿外被撞见过"
msgstr "子時在後殿外被撞見過"

msgid "子时在后殿外又被撞见了一回"
msgstr "子時在後殿外又被撞見了一回"

msgid "名册不见了：账房的铁匣里少了一本名册，管事迟早会发现"
msgstr "名冊不見了：賬房的鐵匣裡少了一本名冊，管事遲早會發現"

msgid "进门之前，先把第三章留下的事了结。身上带着逆灵天书残卷的：还给后山崖径上的玄冥子（他要是还活着），他当你是他的人，宫里没人会问起那卷书；交给林忌，他当面烧了，可宫里少了一卷书——那是一条疑点。救过人的，听林忌（或霍铮）把话说完。黑冠丢了的，问林忌「黑冠」。"
msgstr "進門之前，先把第三章留下的事了結。身上帶著逆靈天書殘卷的：還給後山崖徑上的玄冥子（他要是還活著），他當你是他的人，宮裡沒人會問起那卷書；交給林忌，他當面燒了，可宮裡少了一卷書——那是一條疑點。救過人的，聽林忌（或霍錚）把話說完。黑冠丟了的，問林忌「黑冠」。"

msgid "你把残卷还给了玄冥子。他说：「你是我的人。」宫里不会有人问起那一夜。"
msgstr "你把殘卷還給了玄冥子。他說：「你是我的人。」宮裡不會有人問起那一夜。"

msgid "把逆灵天书的残卷还给了玄冥子"
msgstr "把逆靈天書的殘卷還給了玄冥子"

msgid "你把残卷交给了林忌。他当面烧了：「这东西不该回那里去。」宫里少了一卷书。"
msgstr "你把殘卷交給了林忌。他當面燒了：「這東西不該回那裡去。」宮裡少了一卷書。"

msgid "把逆灵天书的残卷交给林忌烧了"
msgstr "把逆靈天書的殘卷交給林忌燒了"

msgid "茅山要一个进得去的人。你答应戴着黑冠，再进一回逆灵宫。"
msgstr "茅山要一個進得去的人。你答應戴著黑冠，再進一回逆靈宮。"

msgid "替茅山戴着黑冠回了逆灵宫"
msgstr "替茅山戴著黑冠回了逆靈宮"

msgid "戴着黑冠回逆灵宫。白天到账房（前殿往西，丹房再往北）问管事道士「干活」。"
msgstr "戴著黑冠回逆靈宮。白天到賬房（前殿往西，丹房再往北）問管事道士「幹活」。"

msgid "管事道士派了三样活：丹房添炭、货栈点箱、前殿跟诵。"
msgstr "管事道士派了三樣活：丹房添炭、貨棧點箱、前殿跟誦。"

msgid "干完管事派的三样活，回账房问他「干活」。跟诵是领诵念上句、你接下句：前殿的道士诵的就是这几句，听熟了再去。"
msgstr "幹完管事派的三樣活，回賬房問他「幹活」。跟誦是領誦念上句、你接下句：前殿的道士誦的就是這幾句，聽熟了再去。"

msgid "三样活干完了。管事许你在货栈的通铺上留宿。"
msgstr "三樣活幹完了。管事許你在貨棧的通鋪上留宿。"

msgid "在逆灵宫干了三样杂活，管事许你留宿"
msgstr "在逆靈宮幹了三樣雜活，管事許你留宿"

msgid "丹房添炭"
msgstr "丹房添炭"

msgid "货栈点箱"
msgstr "貨棧點箱"

msgid "前殿跟诵"
msgstr "前殿跟誦"

msgid "领诵念上句，你接下句"
msgstr "領誦念上句，你接下句"

msgid "子时，前殿北门后的后殿有人说话。货栈的通铺可以睡到子时。前殿有巡殿的道士来回走——躲开他的眼睛（他看前面，不看身后；香炉和经案挡得住他），摸到北门边「听」。被他撞见了，会被押回前院站到天亮，那是一条疑点。"
msgstr "子時，前殿北門後的後殿有人說話。貨棧的通鋪可以睡到子時。前殿有巡殿的道士來回走——躲開他的眼睛（他看前面，不看身後；香爐和經案擋得住他），摸到北門邊「聽」。被他撞見了，會被押回前院站到天亮，那是一條疑點。"

msgid "你在北门外听见了他们等的那一夜，和「名单在账房」。"
msgstr "你在北門外聽見了他們等的那一夜，和「名單在賬房」。"

msgid "名单在账房。夜里管事伏在案头睡觉，到账房的大案上「抄名单」，别吵醒他。"
msgstr "名單在賬房。夜裡管事伏在案頭睡覺，到賬房的大案上「抄名單」，別吵醒他。"

msgid "你在账房的大案上抄下了那张名单。"
msgstr "你在賬房的大案上抄下了那張名單。"

msgid "把抄来的名单递出去：交给灵心观的林忌（救过霍铮的，也可以交给土地庙的霍铮）。"
msgstr "把抄來的名單遞出去：交給靈心觀的林忌（救過霍錚的，也可以交給土地廟的霍錚）。"

msgid "名单递出去了。下回路过野羊山的山路转角，路边会多一辆翻倒的纳供车。"
msgstr "名單遞出去了。下回路過野羊山的山路轉角，路邊會多一輛翻倒的納供車。"

msgid "把逆灵宫的祭品名单递给了茅山"
msgstr "把逆靈宮的祭品名單遞給了茅山"

msgid "名单上的人，茅山会去找。宫里的事还没完——回灵心观问林忌「逆灵宫」。"
msgstr "名單上的人，茅山會去找。宮裡的事還沒完——回靈心觀問林忌「逆靈宮」。"

msgid "林忌说了地牢里新关的三个人，和账房铁匣里那本名册的原本。"
msgstr "林忌說了地牢裡新關的三個人，和賬房鐵匣裡那本名冊的原本。"

msgid "地牢里新关了三个人。牢门的钥匙在狱卒腰上：给他一袋酒（或者往石阶边他那只酒坛里下蒙汗药），他醉倒了，钥匙就是你的；子时他歪在长凳上打盹，钥匙挂在头顶的铁钉上；第三章那把钥匙还在身上的，也开得了。狱卒醒着的时候，谁也近不了牢门。开了门，他们自己从货栈的侧门走。"
msgstr "地牢裡新關了三個人。牢門的鑰匙在獄卒腰上：給他一袋酒（或者往石階邊他那隻酒罈裡下蒙汗藥），他醉倒了，鑰匙就是你的；子時他歪在長凳上打盹，鑰匙掛在頭頂的鐵釘上；第三章那把鑰匙還在身上的，也開得了。獄卒醒著的時候，誰也近不了牢門。開了門，他們自己從貨棧的側門走。"

msgid "地牢里新关的三个人，从货栈的侧门走了。"
msgstr "地牢裡新關的三個人，從貨棧的側門走了。"

msgid "放走了逆灵宫地牢里新关的三个人"
msgstr "放走了逆靈宮地牢裡新關的三個人"

msgid "西牢房：槐阳来的妇人"
msgstr "西牢房：槐陽來的婦人"

msgid "北牢房：货郎"
msgstr "北牢房：貨郎"

msgid "东牢房：采药人"
msgstr "東牢房：採藥人"

msgid "账房的铁匣里锁着祭品名册的原本，锁和牢门是一套。夜里管事伏在案头睡着的时候，用地牢的钥匙打开它。带走（先确认）：它是物证——朝上揭发兵部时算一样，京师的事已经定了的，乔阴的程不平对得出上面的押印；可宫里少了一本名册，那是一条疑点。不带：回灵心观问林忌「名册」，告诉他你没动它。"
msgstr "賬房的鐵匣裡鎖著祭品名冊的原本，鎖和牢門是一套。夜裡管事伏在案頭睡著的時候，用地牢的鑰匙打開它。帶走（先確認）：它是物證——朝上揭發兵部時算一樣，京師的事已經定了的，喬陰的程不平對得出上面的押印；可宮裡少了一本名冊，那是一條疑點。不帶：回靈心觀問林忌「名冊」，告訴他你沒動它。"

msgid "你带走了祭品名册的原本。宫里少了一本名册。"
msgstr "你帶走了祭品名冊的原本。宮裡少了一本名冊。"

msgid "从逆灵宫的账房带走了祭品名册的原本"
msgstr "從逆靈宮的賬房帶走了祭品名冊的原本"

msgid "名册留在了铁匣里。宫里什么也没少。"
msgstr "名冊留在了鐵匣裡。宮裡什麼也沒少。"

msgid "把祭品名册的原本留在了逆灵宫的铁匣里"
msgstr "把祭品名冊的原本留在了逆靈宮的鐵匣裡"

msgid "后山崖径上的玄冥子有一件事要托你——问他「天书」。（子时，前殿的北门从里面闩着；他知道怎么拨开。巡殿的道士看前不看后。）"
msgstr "後山崖徑上的玄冥子有一件事要託你——問他「天書」。（子時，前殿的北門從裡面閂著；他知道怎麼撥開。巡殿的道士看前不看後。）"

msgid "你从宫主居所的暗格里取出《逆灵天书》的下半部，交给了玄冥子。他给了你一册六阴剑谱，说了他等的是哪一夜。"
msgstr "你從宮主居所的暗格裡取出《逆靈天書》的下半部，交給了玄冥子。他給了你一冊六陰劍譜，說了他等的是哪一夜。"

msgid "替玄冥子取来了《逆灵天书》的下半部"
msgstr "替玄冥子取來了《逆靈天書》的下半部"

msgid "后山崖径上没有玄冥子——《逆灵天书》的下半部，没有人托你去取。"
msgstr "後山崖徑上沒有玄冥子——《逆靈天書》的下半部，沒有人託你去取。"

msgid "宫里等的那一夜，林忌要知道：他们哪一夜动、走哪条路。钉子拔了、湖上的事近了（第十章之后），回灵心观问林忌「逆灵宫」。湖底的事已经了了的，宫里剩下的人还在——也问他「逆灵宫」。"
msgstr "宮裡等的那一夜，林忌要知道：他們哪一夜動、走哪條路。釘子拔了、湖上的事近了（第十章之後），回靈心觀問林忌「逆靈宮」。湖底的事已經了了的，宮裡剩下的人還在——也問他「逆靈宮」。"

msgid "林忌问你宫里哪一夜动、走哪条路：唤首那一夜，逆灵宫倾巢下湖。"
msgstr "林忌問你宮裡哪一夜動、走哪條路：喚首那一夜，逆靈宮傾巢下湖。"

msgid "湖底的事了了，商玦没有回来。宫里剩下的人还在续灯——林忌要一个了断。"
msgstr "湖底的事了了，商玦沒有回來。宮裡剩下的人還在續燈——林忌要一個了斷。"

msgid "收网，看你。前夜倒戈（问林忌「倒戈」）：把下湖的时辰和路交给茅山——终章冰龙厅里商玦身边只剩两个道士，点将时多一拨茅山的人；可黑冠从此没用，逆灵宫的门不再为你开。潜伏到底（问林忌「潜伏」，疑点不到三条才行）：你戴着冠跟商玦的队伍下湖，冰龙厅里第一剑是你的，商玦带着重伤开打——可他的四个道士会先扑你，也没有人会多来帮你（没人知道你的消息）。终章在湖畔等到天黑之前要定下来。"
msgstr "收網，看你。前夜倒戈（問林忌「倒戈」）：把下湖的時辰和路交給茅山——終章冰龍廳裡商玦身邊只剩兩個道士，點將時多一撥茅山的人；可黑冠從此沒用，逆靈宮的門不再為你開。潛伏到底（問林忌「潛伏」，疑點不到三條才行）：你戴著冠跟商玦的隊伍下湖，冰龍廳裡第一劍是你的，商玦帶著重傷開打——可他的四個道士會先撲你，也沒有人會多來幫你（沒人知道你的消息）。終章在湖畔等到天黑之前要定下來。"

msgid "前夜，你把下湖的时辰和路交给了林忌。黑冠从此没用了。"
msgstr "前夜，你把下湖的時辰和路交給了林忌。黑冠從此沒用了。"

msgid "唤首前夜，把逆灵宫下湖的时辰和路交给了茅山"
msgstr "喚首前夜，把逆靈宮下湖的時辰和路交給了茅山"

msgid "你没有把时辰交出去。黑冠还戴在你头上：唤首那一夜，你跟着他们下湖。"
msgstr "你沒有把時辰交出去。黑冠還戴在你頭上：喚首那一夜，你跟著他們下湖。"

msgid "戴着黑冠潜伏到底，跟逆灵宫下了湖"
msgstr "戴著黑冠潛伏到底，跟逆靈宮下了湖"

#~ msgid "唤首那一夜过去了。你什么也没有交出去，也没有跟他们下湖。"
#~ msgstr "喚首那一夜過去了。你什麼也沒有交出去，也沒有跟他們下湖。"

msgid "终章：茅山的人截在北麓下湖的路上，林忌在湖畔。冰龙厅里，商玦身边只剩两个道士。"
msgstr "終章：茅山的人截在北麓下湖的路上，林忌在湖畔。冰龍廳裡，商玦身邊只剩兩個道士。"

#~ msgid "冰龙厅里，商玦身边只剩两个道士——另外两个，茅山在北麓截下了。"
#~ msgstr "冰龍廳裡，商玦身邊只剩兩個道士——另外兩個，茅山在北麓截下了。"

msgid "终章：戴着黑冠下湖。冰龙厅里你站在商玦身后——第一剑是你的。他的四个道士会先扑你。"
msgstr "終章：戴著黑冠下湖。冰龍廳裡你站在商玦身後——第一劍是你的。他的四個道士會先撲你。"

#~ msgid "冰龙厅里，第一剑是你从背后刺的。商玦带着那一剑的伤，同你打完了这一场。"
#~ msgstr "冰龍廳裡，第一劍是你從背後刺的。商玦帶著那一劍的傷，同你打完了這一場。"

#~ msgid "宫里剩下的人，林忌要一个了断。交官府去剿（问林忌「剿」，先确认）：官兵上北麓，一个也走不了——正月十七投颜违的那一边，说的就是这个。劝他们下山、交茅山看管（问林忌「招安」，再回北麓同宫里当家的说「下山」）：玄冥子还在，就是他；不在了，是领诵的道士。没有了断的，正月十七那一天他们会自己找上门来。"
#~ msgstr "宮裡剩下的人，林忌要一個了斷。交官府去剿（問林忌「剿」，先確認）：官兵上北麓，一個也走不了——正月十七投顏違的那一邊，說的就是這個。勸他們下山、交茅山看管（問林忌「招安」，再回北麓同宮裡當家的說「下山」）：玄冥子還在，就是他；不在了，是領誦的道士。沒有了斷的，正月十七那一天他們會自己找上門來。"

msgid "你把北麓那座道观交给了官府。官兵上了山，宫里剩下的人一个也没走脱。"
msgstr "你把北麓那座道觀交給了官府。官兵上了山，宮裡剩下的人一個也沒走脫。"

msgid "把逆灵宫的余孽交给官府去剿"
msgstr "把逆靈宮的餘孽交給官府去剿"

msgid "宫里剩下的人下了山，交茅山看管。坛上的火灭了。"
msgstr "宮裡剩下的人下了山，交茅山看管。壇上的火滅了。"

msgid "劝逆灵宫的余孽下山，交茅山看管"
msgstr "勸逆靈宮的餘孽下山，交茅山看管"

msgid "接了朱鸿雪的令，替东方神教办事。"
msgstr "接了朱鴻雪的令，替東方神教辦事。"

msgid "晚月庄的西厢住着一个人，住了三年——东方神教的一代教主安妮儿。朱鸿雪要知道她在等谁：去晚月庄西厢问安妮儿「等谁」。"
msgstr "晚月莊的西廂住著一個人，住了三年——東方神教的一代教主安妮兒。朱鴻雪要知道她在等誰：去晚月莊西廂問安妮兒「等誰」。"

msgid "安妮儿说了她在等什么。末了一句：「你可以照实说。」"
msgstr "安妮兒說了她在等什麼。末了一句：「你可以照實說。」"

msgid "回绮云镇棺材铺后的场院，把西厢的话告诉朱鸿雪。照实说（「照实说」）：那件衣，安妮儿不打算交给神教——朱鸿雪会记住这句话。或者替她瞒（「替她瞒」）：只说她在等一个故人——安妮儿欠你一回，朱鸿雪信你这一回。"
msgstr "回綺雲鎮棺材鋪後的場院，把西廂的話告訴朱鴻雪。照實說（「照實說」）：那件衣，安妮兒不打算交給神教——朱鴻雪會記住這句話。或者替她瞞（「替她瞞」）：只說她在等一個故人——安妮兒欠你一回，朱鴻雪信你這一回。"

msgid "你把安妮儿的话照实告诉了朱鸿雪：那件衣，她不打算交给神教。"
msgstr "你把安妮兒的話照實告訴了朱鴻雪：那件衣，她不打算交給神教。"

msgid "把西厢的话照实告诉了朱鸿雪"
msgstr "把西廂的話照實告訴了朱鴻雪"

msgid "你替安妮儿瞒了下来，只说她在等一个故人。朱鸿雪信了你这一回。"
msgstr "你替安妮兒瞞了下來，只說她在等一個故人。朱鴻雪信了你這一回。"

msgid "替安妮儿瞒下了西厢的话"
msgstr "替安妮兒瞞下了西廂的話"

msgid "神教的令不发新的，只从上一个持令人手里接。朱鸿雪派去玉螺湖的人上个月没回来，令在他身上：入夜之后去玉螺湖畔的芦苇丛找他（湖边夜里有鬼卒），拿回那块黑木令，再问朱鸿雪「令牌」。"
msgstr "神教的令不發新的，只從上一個持令人手裡接。朱鴻雪派去玉螺湖的人上個月沒回來，令在他身上：入夜之後去玉螺湖畔的蘆葦叢找他（湖邊夜裡有鬼卒），拿回那塊黑木令，再問朱鴻雪「令牌」。"

msgid "朱鸿雪把黑木令放回你手里：「现在它是你的。」带着它，神教的杀手认你是自己人。"
msgstr "朱鴻雪把黑木令放回你手裡：「現在它是你的。」帶著它，神教的殺手認你是自己人。"

msgid "从玉螺湖畔的芦苇丛里接回了一块黑木令"
msgstr "從玉螺湖畔的蘆葦叢裡接回了一塊黑木令"

msgid "黑木令在你身上了。朱鸿雪还有差事交给持令的人：回绮云镇的场院，问朱鸿雪「差事」。"
msgstr "黑木令在你身上了。朱鴻雪還有差事交給持令的人：回綺雲鎮的場院，問朱鴻雪「差事」。"

#~ msgid "朱鸿雪说了三个名字：湖边量水的黑冠道士、黄石隘口画图的兵部画吏、玉螺湖村凿冰的老冰匠——都是靠近湖底封物的人。"
#~ msgstr "朱鴻雪說了三個名字：湖邊量水的黑冠道士、黃石隘口畫圖的兵部畫吏、玉螺湖村鑿冰的老冰匠——都是靠近湖底封物的人。"

#~ msgid "朱鸿雪的三个名字，都是靠近湖底封物的人。玉螺湖村稻田西头的湖岸上，白天有个黑冠道士在量水——逆灵宫的人，打倒他。天驼关黄石隘口的山壁下，兵部的画吏在画当年石匣出土的地方——打倒了，放他走就算。第三个是玉螺湖村年年凿冰的老冰匠，在柳树下的湖岸边：怎么办，看你。"
#~ msgstr "朱鴻雪的三個名字，都是靠近湖底封物的人。玉螺湖村稻田西頭的湖岸上，白天有個黑冠道士在量水——逆靈宮的人，打倒他。天駝關黃石隘口的山壁下，兵部的畫吏在畫當年石匣出土的地方——打倒了，放他走就算。第三個是玉螺湖村年年鑿冰的老冰匠，在柳樹下的湖岸邊：怎麼辦，看你。"

msgid "湖边量水的道士、隘口画图的画吏，都了了。"
msgstr "湖邊量水的道士、隘口畫圖的畫吏，都了了。"

msgid "湖边量水的黑冠道士"
msgstr "湖邊量水的黑冠道士"

msgid "白天在玉螺湖村稻田西头的湖岸上"
msgstr "白天在玉螺湖村稻田西頭的湖岸上"

msgid "黄石隘口的兵部画吏"
msgstr "黃石隘口的兵部畫吏"

msgid "在天驼关黄石隘口的山壁下"
msgstr "在天駝關黃石隘口的山壁下"

msgid "凿冰的老冰匠"
msgstr "鑿冰的老冰匠"

msgid "在玉螺湖村柳树下的湖岸边"
msgstr "在玉螺湖村柳樹下的湖岸邊"

msgid "第三个名字是玉螺湖村凿冰的老冰匠。他只是看见过冰下的光，讲给村里的孩子听。做（问他「动手」）：朱鸿雪升你赤铜令——村里少一个人，安妮儿会知道。不做（问他「搬走」）：劝他离开玉螺湖，带他的冰凿回去交差——朱鸿雪信不信，看你西厢那一桩有没有瞒过她。"
msgstr "第三個名字是玉螺湖村鑿冰的老冰匠。他只是看見過冰下的光，講給村裡的孩子聽。做（問他「動手」）：朱鴻雪升你赤銅令——村裡少一個人，安妮兒會知道。不做（問他「搬走」）：勸他離開玉螺湖，帶他的冰鑿回去交差——朱鴻雪信不信，看你西廂那一樁有沒有瞞過她。"

msgid "老冰匠倒在了湖岸上。玉螺湖村少了一个人。"
msgstr "老冰匠倒在了湖岸上。玉螺湖村少了一個人。"

msgid "替朱鸿雪杀了玉螺湖凿冰的老冰匠"
msgstr "替朱鴻雪殺了玉螺湖鑿冰的老冰匠"

msgid "老冰匠背起包袱离开了玉螺湖。他的冰凿在你手里。"
msgstr "老冰匠背起包袱離開了玉螺湖。他的冰鑿在你手裡。"

msgid "劝玉螺湖的老冰匠搬走，拿他的冰凿去交差"
msgstr "勸玉螺湖的老冰匠搬走，拿他的冰鑿去交差"

msgid "三个名字都了了。回绮云镇的场院，问朱鸿雪「交差」。"
msgstr "三個名字都了了。回綺雲鎮的場院，問朱鴻雪「交差」。"

msgid "朱鸿雪收回了黑木令，换给你一块赤铜令。"
msgstr "朱鴻雪收回了黑木令，換給你一塊赤銅令。"

msgid "从朱鸿雪手里换来了一块赤铜令"
msgstr "從朱鴻雪手裡換來了一塊赤銅令"

msgid "朱鸿雪说，名单上还有最后一个名字。出了场院走一走，再回场院去。"
msgstr "朱鴻雪說，名單上還有最後一個名字。出了場院走一走，再回場院去。"

msgid "场院里，朱鸿雪念出了名单上最后一个名字。安妮儿就站在厅里。"
msgstr "場院裡，朱鴻雪念出了名單上最後一個名字。安妮兒就站在廳裡。"

#~ msgid "神教只能有一个教主。站安妮儿（问她「教主」）：她收回教主令，给你黄金令牌，教你天山雪影剑和雪影心法；朱鸿雪认输，不走，往后只派该死的人的差事；终章她来湖畔守潭口，正月十七神教不去虹台搅局。站朱鸿雪（问她「教主」）：她给你黄金令牌，教同一套武功；安妮儿回西厢闭门，不再同你说神教的事；正月十七那天，神教的杀手会在山道上截一派的轿子。"
#~ msgstr "神教只能有一個教主。站安妮兒（問她「教主」）：她收回教主令，給你黃金令牌，教你天山雪影劍和雪影心法；朱鴻雪認輸，不走，往後只派該死的人的差事；終章她來湖畔守潭口，正月十七神教不去虹臺攪局。站朱鴻雪（問她「教主」）：她給你黃金令牌，教同一套武功；安妮兒回西廂閉門，不再同你說神教的事；正月十七那天，神教的殺手會在山道上截一派的轎子。"

msgid "你站到了安妮儿一边。她收回了教主令，把一块黄金令牌放进你手里：天山的剑，到西厢去学。"
msgstr "你站到了安妮兒一邊。她收回了教主令，把一塊黃金令牌放進你手裡：天山的劍，到西廂去學。"

msgid "在绮云镇的场院里站到了安妮儿一边"
msgstr "在綺雲鎮的場院裡站到了安妮兒一邊"

msgid "你站到了朱鸿雪一边。她把一块黄金令牌放进你手里：神教只有一个教主。"
msgstr "你站到了朱鴻雪一邊。她把一塊黃金令牌放進你手裡：神教只有一個教主。"

msgid "在绮云镇的场院里站到了朱鸿雪一边"
msgstr "在綺雲鎮的場院裡站到了朱鴻雪一邊"

msgid "替振远镖局押一趟镖到京师；二十年前那趟镖的旧账，查到底还是到此为止。"
msgstr "替振遠鏢局押一趟鏢到京師；二十年前那趟鏢的舊賬，查到底還是到此為止。"

msgid "你离了振远镖局。镖局的事，到此为止。"
msgstr "你離了振遠鏢局。鏢局的事，到此為止。"

msgid "绮云镇的振远镖局有一趟镖要走京师总局，人手不够。去镖局见陈剑秋，问他「走镖」。"
msgstr "綺雲鎮的振遠鏢局有一趟鏢要走京師總局，人手不夠。去鏢局見陳劍秋，問他「走鏢」。"

msgid "陈剑秋把一趟红货交给了你：两箱，京师振远总局收，交给总镖头陈天星。趟子手老周推车。"
msgstr "陳劍秋把一趟紅貨交給了你：兩箱，京師振遠總局收，交給總鏢頭陳天星。趟子手老周推車。"

msgid "老周推着镖车跟你走（在镖局里问他「上路」）。出绮云镇往北到雪亭镇，沿青石官道往西南，过碎石小路，从铁索下到天驼关，再沿黄土大道往南到京师。车马行不拉镖车。镖车落在后头的，回去叫老周「上路」。"
msgstr "老周推著鏢車跟你走（在鏢局裡問他「上路」）。出綺雲鎮往北到雪亭鎮，沿青石官道往西南，過碎石小路，從鐵索下到天駝關，再沿黃土大道往南到京師。車馬行不拉鏢車。鏢車落在後頭的，回去叫老周「上路」。"

msgid "碎石小路上有人劫镖。领头的蒙面后生倒在路边，刀扔在一旁。"
msgstr "碎石小路上有人劫鏢。領頭的蒙面後生倒在路邊，刀扔在一旁。"

msgid "劫镖的后生坐在路边，不看你（问他「爹」）。交官府（「交官府」）：劫镖是大罪，过了铁索就是天驼关，守关的官兵押他去京师，官府的赏金振远转给你；放他走（「走吧」）：他留下他爹最后的一封家信，劫镖的人从此不见官。"
msgstr "劫鏢的後生坐在路邊，不看你（問他「爹」）。交官府（「交官府」）：劫鏢是大罪，過了鐵索就是天駝關，守關的官兵押他去京師，官府的賞金振遠轉給你；放他走（「走吧」）：他留下他爹最後的一封家信，劫鏢的人從此不見官。"

msgid "你把劫镖的后生交给了天驼关的官兵。"
msgstr "你把劫鏢的後生交給了天駝關的官兵。"

msgid "把碎石小路上劫镖的后生交了官"
msgstr "把碎石小路上劫鏢的後生交了官"

msgid "你放劫镖的后生走了。他留下了他爹贺长庚最后的一封家信。"
msgstr "你放劫鏢的後生走了。他留下了他爹賀長庚最後的一封家信。"

msgid "放走了碎石小路上劫镖的后生"
msgstr "放走了碎石小路上劫鏢的後生"

msgid "镖车还要到京师：东街北头的振远总局，老周推车进门，镖就交到了总镖头陈天星手里。"
msgstr "鏢車還要到京師：東街北頭的振遠總局，老周推車進門，鏢就交到了總鏢頭陳天星手裡。"

msgid "镖交到了京师振远总局。陈天星写了一张振远的名帖给你：京师有些门，要帖子才敲得开。"
msgstr "鏢交到了京師振遠總局。陳天星寫了一張振遠的名帖給你：京師有些門，要帖子才敲得開。"

msgid "替振远押了一趟镖到京师总局"
msgstr "替振遠押了一趟鏢到京師總局"

msgid "镖头"
msgstr "鏢頭"

msgid "贺长庚的家信在你身上。交给京师振远总局的陈天星。"
msgstr "賀長庚的家信在你身上。交給京師振遠總局的陳天星。"

msgid "陈天星看了家信：兵部的人在岭上等着，镖头说照走。"
msgstr "陳天星看了家信：兵部的人在嶺上等著，鏢頭說照走。"

msgid "把贺长庚的家信交给了陈天星"
msgstr "把賀長庚的家信交給了陳天星"

msgid "二十年前那趟镖，振远的总账里还有一笔没对上。去京师东街北头的振远总局，问陈天星「旧账」。"
msgstr "二十年前那趟鏢，振遠的總賬裡還有一筆沒對上。去京師東街北頭的振遠總局，問陳天星「舊賬」。"

msgid "陈天星翻完了振远二十年的总账：绮云分局开张的本钱，是那趟镖之后兵部送来的「抚恤银」。"
msgstr "陳天星翻完了振遠二十年的總賬：綺雲分局開張的本錢，是那趟鏢之後兵部送來的「撫卹銀」。"

msgid "绮云分局开张的本钱是兵部的抚恤银，陈剑秋知道。回绮云镇的振远镖局，问陈剑秋「旧账」。"
msgstr "綺雲分局開張的本錢是兵部的撫卹銀，陳劍秋知道。回綺雲鎮的振遠鏢局，問陳劍秋「舊賬」。"

msgid "陈剑秋认了：那年振远死了十一个人，兵部给钱，他拿了。"
msgstr "陳劍秋認了：那年振遠死了十一個人，兵部給錢，他拿了。"

msgid "账本在陈天星手里，他要告；陈剑秋要瞒。到此为止（在绮云镇问陈剑秋「到此为止」）：账本烧了，抚恤银的事振远不再提，正月十七振远那一票投颜违；陈剑秋教你春风快意刀，陈天星往后见你只谈生意。查到底（在京师问陈天星「查到底」）：账本押去乔阴县衙，告兵部也告振远自己，陈剑秋关了绮云分局的门；振远那一票投旧盟主，京师的事还没定的，这本账算揭发的一样人证物证。"
msgstr "賬本在陳天星手裡，他要告；陳劍秋要瞞。到此為止（在綺雲鎮問陳劍秋「到此為止」）：賬本燒了，撫卹銀的事振遠不再提，正月十七振遠那一票投顏違；陳劍秋教你春風快意刀，陳天星往後見你只談生意。查到底（在京師問陳天星「查到底」）：賬本押去喬陰縣衙，告兵部也告振遠自己，陳劍秋關了綺雲分局的門；振遠那一票投舊盟主，京師的事還沒定的，這本賬算揭發的一樣人證物證。"

msgid "你站到了陈剑秋一边：那本总账烧了，二十年前的抚恤银，振远不再提。陈剑秋许你学春风快意刀。"
msgstr "你站到了陳劍秋一邊：那本總賬燒了，二十年前的撫卹銀，振遠不再提。陳劍秋許你學春風快意刀。"

msgid "劝陈剑秋把振远的旧账烧了：到此为止"
msgstr "勸陳劍秋把振遠的舊賬燒了：到此為止"

msgid "你站到了陈天星一边：振远的总账押去了乔阴县衙。绮云分局关了门。"
msgstr "你站到了陳天星一邊：振遠的總賬押去了喬陰縣衙。綺雲分局關了門。"

msgid "跟陈天星把振远的旧账送进了乔阴县衙：查到底"
msgstr "跟陳天星把振遠的舊賬送進了喬陰縣衙：查到底"

msgid "晚月庄失传的舞、带出庄的宝衣，和内书房那位老妇的女儿。"
msgstr "晚月莊失傳的舞、帶出莊的寶衣，和內書房那位老婦的女兒。"

msgid "你离了晚月庄。庄里的事，到此为止。"
msgstr "你離了晚月莊。莊裡的事，到此為止。"

msgid "庄主蓝止萍在晚月庄的前厅。问她「庄里的事」。"
msgstr "莊主藍止萍在晚月莊的前廳。問她「莊裡的事」。"

msgid "蓝止萍说：晚月庄失传过一支舞，叫沧海龙吟。步子绣在后院书房的湘绣舞曲图上，曲子在舞曲谱里；两样凑齐，到二楼佛堂，在区冥的神位前跳一回。"
msgstr "藍止萍說：晚月莊失傳過一支舞，叫滄海龍吟。步子繡在後院書房的湘繡舞曲圖上，曲子在舞曲譜裡；兩樣湊齊，到二樓佛堂，在區冥的神位前跳一回。"

#~ msgid "沧海龙吟的步子在后院书房墙上的湘绣舞曲图里（昭仪天天对着它看），曲子在舞曲谱里（翠湘阁的莫欣芳知道谱放在哪）。看过那幅图，把舞曲谱拿到手。"
#~ msgstr "滄海龍吟的步子在後院書房牆上的湘繡舞曲圖裡（昭儀天天對著它看），曲子在舞曲譜裡（翠湘閣的莫欣芳知道譜放在哪）。看過那幅圖，把舞曲譜拿到手。"

msgid "图上的姿势，谱上的曲子，你都记下了：沧海龙吟。"
msgstr "圖上的姿勢，譜上的曲子，你都記下了：滄海龍吟。"

msgid "到二楼的佛堂，在区冥的神位前跳沧海龙吟。女子自己跳；男子请人替跳：禁闭房的芳绫（问她「替跳」，她跟你走），或翠湘阁的莫欣芳（在神位前「请人替跳」，她从回廊那头过来）。"
msgstr "到二樓的佛堂，在區冥的神位前跳滄海龍吟。女子自己跳；男子請人替跳：禁閉房的芳綾（問她「替跳」，她跟你走），或翠湘閣的莫欣芳（在神位前「請人替跳」，她從迴廊那頭過來）。"

msgid "沧海龙吟在区冥的神位前跳成了。神像的眉间亮了一下。"
msgstr "滄海龍吟在區冥的神位前跳成了。神像的眉間亮了一下。"

msgid "在区冥的神位前跳回了失传的沧海龙吟"
msgstr "在區冥的神位前跳回了失傳的滄海龍吟"

msgid "宝衣的事，要等主线第四章「宝衣」有了着落。到那时，再回东厢见瑷伦。"
msgstr "寶衣的事，要等主線第四章「寶衣」有了著落。到那時，再回東廂見璦倫。"

msgid "宝衣挡完了湖底那一口黑焰，烧成了灰。"
msgstr "寶衣擋完了湖底那一口黑焰，燒成了灰。"

msgid "宝衣在瑷伦身上。庄里一切如旧。"
msgstr "寶衣在璦倫身上。莊裡一切如舊。"

msgid "宝衣在西厢的安妮儿手里。"
msgstr "寶衣在西廂的安妮兒手裡。"

msgid "宝衣还在你身上。东厢的瑷伦失了衣。"
msgstr "寶衣還在你身上。東廂的璦倫失了衣。"

msgid "宝衣还在你身上。东厢的瑷伦失了衣，她问你一句：还回来吗？还回来（问她「还衣」）：她又是守衣人，凤凰回到小花池，决战那日她穿着它跟你下湖——宝衣就不在你身上了，下湖没有它挡寒气。留在身上（问她「留着」）：宝衣照旧跟着你，庄里照旧没有护佑。"
msgstr "寶衣還在你身上。東廂的璦倫失了衣，她問你一句：還回來嗎？還回來（問她「還衣」）：她又是守衣人，鳳凰回到小花池，決戰那日她穿著它跟你下湖——寶衣就不在你身上了，下湖沒有它擋寒氣。留在身上（問她「留著」）：寶衣照舊跟著你，莊裡照舊沒有護佑。"

msgid "你把寒於宝衣还给了瑷伦。她又是守衣人。"
msgstr "你把寒於寶衣還給了璦倫。她又是守衣人。"

msgid "把带出庄的寒於宝衣送回了晚月庄"
msgstr "把帶出莊的寒於寶衣送回了晚月莊"

msgid "宝衣留在了你身上。瑷伦不再问。"
msgstr "寶衣留在了你身上。璦倫不再問。"

msgid "对守衣人说，寒於宝衣留在自己身上"
msgstr "對守衣人說，寒於寶衣留在自己身上"

msgid "宝衣在湖底烧成了灰。还不还，都不必再说了。"
msgstr "寶衣在湖底燒成了灰。還不還，都不必再說了。"

msgid "内书房的无名老妇有一桩心事。去问她「心事」。"
msgstr "內書房的無名老婦有一樁心事。去問她「心事」。"

msgid "无名老妇说了她的女儿：那个蒙面的杀手。她要你去问问她，为什么走到了这一步。"
msgstr "無名老婦說了她的女兒：那個蒙面的殺手。她要你去問問她，為什麼走到了這一步。"

msgid "老妇的女儿在哪，要看第四章有没有那一夜。"
msgstr "老婦的女兒在哪，要看第四章有沒有那一夜。"

msgid "宝衣没有出庄，那一夜没有来。她还在内书房里，蒙着面。"
msgstr "寶衣沒有出莊，那一夜沒有來。她還在內書房裡，蒙著面。"

msgid "那一夜之后，她再没有进过庄门。"
msgstr "那一夜之後，她再沒有進過莊門。"

msgid "老妇的女儿就是内书房里那个蒙面的杀手。问她「娘」。动手也行——这一步她只会倒下，不会死。"
msgstr "老婦的女兒就是內書房裡那個蒙面的殺手。問她「娘」。動手也行——這一步她只會倒下，不會死。"

msgid "她说了来历：北麓的道观、六阴剑、东方神教，和朱鸿雪派她回晚月庄的缘故。"
msgstr "她說了來歷：北麓的道觀、六陰劍、東方神教，和朱鴻雪派她回晚月莊的緣故。"

msgid "那一夜之后，她藏在庄后山路尽头的竹林里，入夜才在（白天去，竹林里没有人）。走进竹林找到她，问她「娘」。动手也行——这一步她只会倒下，不会死。"
msgstr "那一夜之後，她藏在莊後山路盡頭的竹林裡，入夜才在（白天去，竹林裡沒有人）。走進竹林找到她，問她「娘」。動手也行——這一步她只會倒下，不會死。"

msgid "她说了来历：北麓的道观、六阴剑、东方神教，和朱鸿雪派她回晚月庄的缘故。她回了内书房，在她娘身边。"
msgstr "她說了來歷：北麓的道觀、六陰劍、東方神教，和朱鴻雪派她回晚月莊的緣故。她回了內書房，在她娘身邊。"

msgid "她的杀手令牌在你手上。两个人要它：内书房的老妇要它为证——递给她，她知道女儿还活着，给你一份谢礼（只给一次）；绮云镇的朱鸿雪要它回神教——问她「还令」，神教的令只从上一个持令人手里接。给了一边，另一边就没有了。"
msgstr "她的殺手令牌在你手上。兩個人要它：內書房的老婦要它為證——遞給她，她知道女兒還活著，給你一份謝禮（只給一次）；綺雲鎮的朱鴻雪要它回神教——問她「還令」，神教的令只從上一個持令人手裡接。給了一邊，另一邊就沒有了。"

msgid "你把令牌递给了老妇。她攥着它，知道女儿还活着。"
msgstr "你把令牌遞給了老婦。她攥著它，知道女兒還活著。"

msgid "把蒙面杀手的令牌交给了她娘"
msgstr "把蒙面殺手的令牌交給了她娘"

msgid "你把令牌还给了朱鸿雪。神教的令，回了神教。"
msgstr "你把令牌還給了朱鴻雪。神教的令，回了神教。"

msgid "把晚月庄那块杀手令牌还给了东方神教"
msgstr "把晚月莊那塊殺手令牌還給了東方神教"

msgid "下回进晚月庄的大厅，蓝止萍有话要说——老妇和她女儿会从内书房出来。两条路：依庄规（问蓝止萍「庄规」）——人交给蓝止萍处置，晚月庄这一票投颜违，老妇从此不再开口；带她回来（问老妇「女儿」）——她留在内书房陪她娘，晚月庄这一票投旧盟主，蓝止萍从此对你冷一分。两边都先问你一声；选了不能改。"
msgstr "下回進晚月莊的大廳，藍止萍有話要說——老婦和她女兒會從內書房出來。兩條路：依莊規（問藍止萍「莊規」）——人交給藍止萍處置，晚月莊這一票投顏違，老婦從此不再開口；帶她回來（問老婦「女兒」）——她留在內書房陪她娘，晚月莊這一票投舊盟主，藍止萍從此對你冷一分。兩邊都先問你一聲；選了不能改。"

msgid "你依了庄规。她跟着蓝止萍的人走了，没有回头。"
msgstr "你依了莊規。她跟著藍止萍的人走了，沒有回頭。"

msgid "依晚月庄的庄规，把老妇的女儿交给了蓝止萍"
msgstr "依晚月莊的莊規，把老婦的女兒交給了藍止萍"

msgid "你把她带了回来。内书房里多了一个人，不再蒙面。老妇替你向庄主讨了一个执事。"
msgstr "你把她帶了回來。內書房裡多了一個人，不再蒙面。老婦替你向莊主討了一個執事。"

msgid "把老妇的女儿带回了晚月庄"
msgstr "把老婦的女兒帶回了晚月莊"

msgid "替花紫会摸回槐阳八户的卖身契；数着皮酒囊上的结，找到真龙头；尚书府小屋那封密信，给花紫会还是给官府；夜里从狗洞偷出卫沧澜；认二十三个结，还是认这些年管事的人。"
msgstr "替花紫會摸回槐陽八戶的賣身契；數著皮酒囊上的結，找到真龍頭；尚書府小屋那封密信，給花紫會還是給官府；夜裡從狗洞偷出衛滄瀾；認二十三個結，還是認這些年管事的人。"

msgid "叫花子不再跟你说正事。花紫会的事，到此为止。"
msgstr "叫花子不再跟你說正事。花紫會的事，到此為止。"

msgid "乔阴福林大街上的陆得财有一件差事。去问他「差事」。"
msgstr "喬陰福林大街上的陸得財有一件差事。去問他「差事」。"

msgid "陆得财托你一件差事：福林酒楼二楼那个兵部的胡管事，怀里揣着槐阳城外八户人家的卖身契。摸回来。"
msgstr "陸得財託你一件差事：福林酒樓二樓那個兵部的胡管事，懷裡揣著槐陽城外八戶人家的賣身契。摸回來。"

msgid "兵部收民夫的胡管事在福林酒楼二楼雅座喝酒，那叠卖身契揣在他怀里。选中他「偷窃」，挑「随手摸一样」——他身上只有那叠契。失了手，他喊着扑上来，乔阴的巡捕从此记你一笔（街上撞见就抓，罪名、行贿照旧）。不会偷的，先跟陆得财学两手「偷窃」。"
msgstr "兵部收民夫的胡管事在福林酒樓二樓雅座喝酒，那疊賣身契揣在他懷裡。選中他「偷竊」，挑「隨手摸一樣」——他身上只有那疊契。失了手，他喊著撲上來，喬陰的巡捕從此記你一筆（街上撞見就抓，罪名、行賄照舊）。不會偷的，先跟陸得財學兩手「偷竊」。"

msgid "那叠卖身契到了你手里。"
msgstr "那疊賣身契到了你手裡。"

msgid "卖身契在你身上。回福林大街，递给陆得财。"
msgstr "賣身契在你身上。回福林大街，遞給陸得財。"

msgid "陆得财数完了八张契：明天她们就回家。他把皮酒囊递给你数——二十二个结。他是龙头的一个替身。"
msgstr "陸得財數完了八張契：明天她們就回家。他把皮酒囊遞給你數——二十二個結。他是龍頭的一個替身。"

msgid "从兵部的管事身上摸回了槐阳八户的卖身契"
msgstr "從兵部的管事身上摸回了槐陽八戶的賣身契"

msgid "五结弟子"
msgstr "五結弟子"

msgid "真龙头的皮酒囊上二十三个结，替身的都少几个；替身一个只认得下一个。雪亭镇广场墙根下那个老乞丐也叫陆得财，结最少——问他「龙头」。"
msgstr "真龍頭的皮酒囊上二十三個結，替身的都少幾個；替身一個只認得下一個。雪亭鎮廣場牆根下那個老乞丐也叫陸得財，結最少——問他「龍頭」。"

msgid "雪亭的陆得财，二十个结。他指了下一个：绮云镇的渡口。"
msgstr "雪亭的陸得財，二十個結。他指了下一個：綺雲鎮的渡口。"

msgid "下一个在绮云镇的渡口，坐在船帮上钓鱼，比雪亭那个多一个结。问他「龙头」。"
msgstr "下一個在綺雲鎮的渡口，坐在船幫上釣魚，比雪亭那個多一個結。問他「龍頭」。"

msgid "绮云的陆得财，二十一个结。他说下一个就是龙头：京师东街，尚书府的后墙根底下。"
msgstr "綺雲的陸得財，二十一個結。他說下一個就是龍頭：京師東街，尚書府的後牆根底下。"

msgid "京师东街，尚书府的后墙根底下，坐着一个打二十三个结的叫花子。问他「龙头」。"
msgstr "京師東街，尚書府的後牆根底下，坐著一個打二十三個結的叫花子。問他「龍頭」。"

msgid "墙根下的陆得财，二十三个结。他是真龙头，在这堵墙底下看了庾家二十年；乔阴那个替他管着花紫会。"
msgstr "牆根下的陸得財，二十三個結。他是真龍頭，在這堵牆底下看了庾家二十年；喬陰那個替他管著花紫會。"

msgid "真龙头要尚书府后院小屋里那封庾子建亲笔的密信（问他「密信」）；乔阴的程不平也要它，拿去当物证。玉螺湖底那件事之后，逆灵宫的信使才坐进小屋，信在他身上：进了小屋就是一场仗，他见人就动手，打不过就退出屋外。交给花紫会（问真龙头「密信」）：真龙头拿它压着庾家，官府那条线就断了；京师的事还没定的，这封信也不能拿去朝上揭发了。交给官府（问乔阴县衙的程不平「密信」）：揭发时照样算一样，花紫会这条线就断了。"
msgstr "真龍頭要尚書府後院小屋裡那封庾子建親筆的密信（問他「密信」）；喬陰的程不平也要它，拿去當物證。玉螺湖底那件事之後，逆靈宮的信使才坐進小屋，信在他身上：進了小屋就是一場仗，他見人就動手，打不過就退出屋外。交給花紫會（問真龍頭「密信」）：真龍頭拿它壓著庾家，官府那條線就斷了；京師的事還沒定的，這封信也不能拿去朝上揭發了。交給官府（問喬陰縣衙的程不平「密信」）：揭發時照樣算一樣，花紫會這條線就斷了。"

#~ msgid "你把密信交给了真龙头。他把它塞进了皮酒囊的网绳里：这封信在一天，庾家就不敢清乔阴的巷子。"
#~ msgstr "你把密信交給了真龍頭。他把它塞進了皮酒囊的網繩裡：這封信在一天，庾家就不敢清喬陰的巷子。"

msgid "把尚书府小屋里的密信交给了花紫会的真龙头"
msgstr "把尚書府小屋裡的密信交給了花紫會的真龍頭"

msgid "你把密信交给了乔阴知县程不平。叫花子从此不跟你说正事。"
msgstr "你把密信交給了喬陰知縣程不平。叫花子從此不跟你說正事。"

msgid "把尚书府小屋里的密信交给了乔阴知县程不平"
msgstr "把尚書府小屋裡的密信交給了喬陰知縣程不平"

msgid "真龙头还有一件事要托你：尚书府客房里关着的那个老人。到京师东街尚书府的后墙根，问他「盟主」。他说了狗洞的：夜里（入夜到子时）拨开墙根东头那捆柴草，从狗洞钻进后院；护院挑着灯在院子里绕圈，别跟他们照面——撞见了就被推出大门，下回再来。进了客房，跟那老人说「走」。卫沧澜已经出了尚书府的，问真龙头一句「盟主」就是。"
msgstr "真龍頭還有一件事要託你：尚書府客房裡關著的那個老人。到京師東街尚書府的後牆根，問他「盟主」。他說了狗洞的：夜裡（入夜到子時）撥開牆根東頭那捆柴草，從狗洞鑽進後院；護院挑著燈在院子裡繞圈，別跟他們照面——撞見了就被推出大門，下回再來。進了客房，跟那老人說「走」。衛滄瀾已經出了尚書府的，問真龍頭一句「盟主」就是。"

msgid "卫沧澜照叫花子指的路，从后院的狗洞出了尚书府。真龙头说：人出来了，他也该回乔阴了——福林大街见。"
msgstr "衛滄瀾照叫花子指的路，從後院的狗洞出了尚書府。真龍頭說：人出來了，他也該回喬陰了——福林大街見。"

msgid "夜里从尚书府的狗洞偷出了卫沧澜"
msgstr "夜裡從尚書府的狗洞偷出了衛滄瀾"

msgid "卫沧澜已经出了尚书府。真龙头说：人出来了，他也该回乔阴了——福林大街见。"
msgstr "衛滄瀾已經出了尚書府。真龍頭說：人出來了，他也該回喬陰了——福林大街見。"

msgid "真龙头回了乔阴，坐在福林大街当中。去福林大街——陆得财在街上的时候，两个人要碰面。真龙头要带花紫会吃官饭：给官府做眼线，换叫花子不再被巡捕抓；陆得财二十年没让一个官差进过乔阴的巷子。认二十三个结，问真龙头「龙头」：花紫会投颜违，巡捕不再抓花紫会的人，你的偷窃案底勾销，陆得财走了就不回来。认这些年管事的人，问陆得财「龙头」：真龙头回京师的墙根，乔阴照旧，花紫会投旧盟主。已经入了虹台的席的，票照入席时的算。"
msgstr "真龍頭回了喬陰，坐在福林大街當中。去福林大街——陸得財在街上的時候，兩個人要碰面。真龍頭要帶花紫會吃官飯：給官府做眼線，換叫花子不再被巡捕抓；陸得財二十年沒讓一個官差進過喬陰的巷子。認二十三個結，問真龍頭「龍頭」：花紫會投顏違，巡捕不再抓花紫會的人，你的偷竊案底勾銷，陸得財走了就不回來。認這些年管事的人，問陸得財「龍頭」：真龍頭回京師的牆根，喬陰照舊，花紫會投舊盟主。已經入了虹臺的席的，票照入席時的算。"

msgid "你认了二十三个结。陆得财把怀里的东西都放在真龙头脚边，出了北门。花紫会吃上了官饭。"
msgstr "你認了二十三個結。陸得財把懷裡的東西都放在真龍頭腳邊，出了北門。花紫會吃上了官飯。"

msgid "在福林大街认了二十三个结：花紫会跟真龙头吃官饭"
msgstr "在福林大街認了二十三個結：花紫會跟真龍頭吃官飯"

msgid "九结弟子"
msgstr "九結弟子"

msgid "你认了这些年管事的陆得财。真龙头把皮酒囊系到他腰上，回了京师的墙根。乔阴的巷子里，照旧没有官差。"
msgstr "你認了這些年管事的陸得財。真龍頭把皮酒囊繫到他腰上，回了京師的牆根。喬陰的巷子裡，照舊沒有官差。"

msgid "在福林大街认了这些年管事的陆得财"
msgstr "在福林大街認了這些年管事的陸得財"

msgid "做乔阴县的捕快：拿下官道上挂着官府告示收过路费的人，路引上是天驼关的印；严廷殷的印丢过三天，李信记着那三天的账——跟严廷殷整肃，还是跟李信揭发。"
msgstr "做喬陰縣的捕快：拿下官道上掛著官府告示收過路費的人，路引上是天駝關的印；嚴廷殷的印丟過三天，李信記著那三天的賬——跟嚴廷殷整肅，還是跟李信揭發。"

msgid "程不平不再跟你说案子。官府的事，到此为止。"
msgstr "程不平不再跟你說案子。官府的事，到此為止。"

msgid "武举的荐书：带着捕快腰牌去京师校武场，问葛升「武举」，第一场免考"
msgstr "武舉的薦書：帶著捕快腰牌去京師校武場，問葛升「武舉」，第一場免考"

msgid "小屋的密信"
msgstr "小屋的密信"

msgid "在尚书府后院小屋里逆灵宫的信使身上；交给程不平（问他「密信」），给了花紫会，官府这条线就断了"
msgstr "在尚書府後院小屋裡逆靈宮的信使身上；交給程不平（問他「密信」），給了花紫會，官府這條線就斷了"

msgid "乔阴知县程不平还缺一个捕快。去县衙大堂问他「捕快」。花紫会的人、惯窃，他不收。"
msgstr "喬陰知縣程不平還缺一個捕快。去縣衙大堂問他「捕快」。花紫會的人、慣竊，他不收。"

msgid "程不平给了你一块乔阴捕快腰牌：不给俸禄，不教功夫，只给案子。"
msgstr "程不平給了你一塊喬陰捕快腰牌：不給俸祿，不教功夫，只給案子。"

msgid "头一件案子：雪亭镇往西，青石官道的路口，有个汉子倚着一块「官府告示」收过路费，黄金一两。乔阴县衙没贴过那样的告示——拿下他（选中他「攻击」），他身上有东西。"
msgstr "頭一件案子：雪亭鎮往西，青石官道的路口，有個漢子倚著一塊「官府告示」收過路費，黃金一兩。喬陰縣衙沒貼過那樣的告示——拿下他（選中他「攻擊」），他身上有東西。"

msgid "雪亭路口收钱的钱贵挨了打，扔下一叠路引跑了。"
msgstr "雪亭路口收錢的錢貴挨了打，扔下一疊路引跑了。"

msgid "还有一个：绮云镇口那块官府公告底下，有人照着公告收「入镇黄金一两」。拿下他（选中他「攻击」）。"
msgstr "還有一個：綺雲鎮口那塊官府公告底下，有人照著公告收「入鎮黃金一兩」。拿下他（選中他「攻擊」）。"

msgid "绮云镇口收钱的牛四也挨了打，路引掉了一地。"
msgstr "綺雲鎮口收錢的牛四也挨了打，路引掉了一地。"

msgid "两个收过路费的身上都搜出了路引。带着路引回乔阴县衙，问程不平「路引」。"
msgstr "兩個收過路費的身上都搜出了路引。帶著路引回喬陰縣衙，問程不平「路引」。"

msgid "程不平认出路引上的印：天驼关铁卫营的大印，严将军的印。"
msgstr "程不平認出路引上的印：天駝關鐵衛營的大印，嚴將軍的印。"

msgid "拿下了官道上挂着官府告示收过路费的人，搜出了盖着天驼关大印的路引"
msgstr "拿下了官道上掛著官府告示收過路費的人，搜出了蓋著天駝關大印的路引"

msgid "路引上是天驼关铁卫营的大印。带着路引去天驼关军营最里头的将军营帐（进营要大队长的名册），问镇国大将军严廷殷「路引」。程不平的信还没给他看的，先给他看信。"
msgstr "路引上是天駝關鐵衛營的大印。帶著路引去天駝關軍營最裡頭的將軍營帳（進營要大隊長的名冊），問鎮國大將軍嚴廷殷「路引」。程不平的信還沒給他看的，先給他看信。"

msgid "严廷殷认了路引上的印：是他的印，丢过三天的那一方。那三天的事，他叫你去问副将李信。"
msgstr "嚴廷殷認了路引上的印：是他的印，丟過三天的那一方。那三天的事，他叫你去問副將李信。"

msgid "副将李信在副将营帐（将军营帐外头那一间）。问他「印鉴」：印丢的那三天，他记着。"
msgstr "副將李信在副將營帳（將軍營帳外頭那一間）。問他「印鑑」：印丟的那三天，他記著。"

msgid "李信拿出一本薄册子：印丢的那三天，盖出去的是私授的官职十二个、空白的路引四百张，还让兵部拓了个模子去——关北征民夫的令，盖的是照模子浇的印。盖印的是军师赫造基。"
msgstr "李信拿出一本薄冊子：印丟的那三天，蓋出去的是私授的官職十二個、空白的路引四百張，還讓兵部拓了個模子去——關北徵民夫的令，蓋的是照模子澆的印。蓋印的是軍師赫造基。"

msgid "带着路引回将军营帐，问军师赫造基「路引」，当面对一对李信的账。第六章他那桩八两银子的秘密（拓模）还没买的，先买下——他认的是买过模子的人。"
msgstr "帶著路引回將軍營帳，問軍師赫造基「路引」，當面對一對李信的賬。第六章他那樁八兩銀子的秘密（拓模）還沒買的，先買下——他認的是買過模子的人。"

msgid "赫造基认了：印丢的那三天在后备兵手里，他借来替兵部盖了一夜官职的札子和路引。要告他，就连将军一起告——印是将军丢的。"
msgstr "赫造基認了：印丟的那三天在後備兵手裡，他借來替兵部蓋了一夜官職的札子和路引。要告他，就連將軍一起告——印是將軍丟的。"

msgid "跟李信揭发（在副将营帐问他「揭发」）：账本上京，严廷殷被召回，李信守关，天驼关从此不收过路费；第九章还没定的，这本账算揭发的一样物证。跟严廷殷整肃（在将军营帐问他「整肃」）：军师由你在营里拿下，路引停了，天驼关照旧是他的，关北的事不往朝上报——铁卫营欠你一回，终章替你守官道。"
msgstr "跟李信揭發（在副將營帳問他「揭發」）：賬本上京，嚴廷殷被召回，李信守關，天駝關從此不收過路費；第九章還沒定的，這本賬算揭發的一樣物證。跟嚴廷殷整肅（在將軍營帳問他「整肅」）：軍師由你在營裡拿下，路引停了，天駝關照舊是他的，關北的事不往朝上報——鐵衛營欠你一回，終章替你守官道。"

msgid "你跟严廷殷整肃：军师交给你在营里拿下，天驼关的事天驼关了。"
msgstr "你跟嚴廷殷整肅：軍師交給你在營裡拿下，天駝關的事天駝關了。"

msgid "在天驼关跟严廷殷整肃，那三天的账不上京"
msgstr "在天駝關跟嚴廷殷整肅，那三天的賬不上京"

msgid "你跟李信揭发：李信的账抄一份上了京，严廷殷被召回京城，李信守关。天驼关从此不收过路费。"
msgstr "你跟李信揭發：李信的賬抄一份上了京，嚴廷殷被召回京城，李信守關。天駝關從此不收過路費。"

msgid "在天驼关跟李信揭发，那三天的账上了京"
msgstr "在天駝關跟李信揭發，那三天的賬上了京"

msgid "军师赫造基就在将军营帐里。问他「路引」，他知道瞒不住了；再选中他「攻击」，拿下他（他只会被击倒）。"
msgstr "軍師赫造基就在將軍營帳裡。問他「路引」，他知道瞞不住了；再選中他「攻擊」，拿下他（他只會被擊倒）。"

msgid "赫造基倒在将军营帐里，两个铁卫营的兵把他捆了，关进后营。官道上的路引从此停了。严廷殷说：铁卫营欠你一回。"
msgstr "赫造基倒在將軍營帳裡，兩個鐵衛營的兵把他捆了，關進後營。官道上的路引從此停了。嚴廷殷說：鐵衛營欠你一回。"

msgid "尚书府的客房里还关着卫沧澜。皇叔入了朝的，去皇城养心殿问於兰天武「卫沧澜」：他拿着手诏去尚书府要人。卫沧澜已经出了尚书府的，这一步就过了；第九章没有请皇叔回朝的，官府插不上手。"
msgstr "尚書府的客房裡還關著衛滄瀾。皇叔入了朝的，去皇城養心殿問於蘭天武「衛滄瀾」：他拿著手詔去尚書府要人。衛滄瀾已經出了尚書府的，這一步就過了；第九章沒有請皇叔回朝的，官府插不上手。"

msgid "於兰天武拿着手诏去了尚书府，庾子建亲自开的门。卫沧澜回了水烟阁——他说，这条命欠朝廷一份。"
msgstr "於蘭天武拿著手詔去了尚書府，庾子建親自開的門。衛滄瀾回了水煙閣——他說，這條命欠朝廷一份。"

msgid "请皇叔拿手诏从尚书府要回了卫沧澜"
msgstr "請皇叔拿手詔從尚書府要回了衛滄瀾"

msgid "卫沧澜已经出了尚书府。"
msgstr "衛滄瀾已經出了尚書府。"

msgid "皇叔没有回朝。卫沧澜的事，官府插不上手。"
msgstr "皇叔沒有回朝。衛滄瀾的事，官府插不上手。"

msgid "藏经楼少了一函镇教秘籍；林忌的师弟，二十年前带着它下了山。书回了山，后半本是逆灵宫的字——烧，还是收回藏经楼。"
msgstr "藏經樓少了一函鎮教秘籍；林忌的師弟，二十年前帶著它下了山。書回了山，後半本是逆靈宮的字——燒，還是收回藏經樓。"

msgid "你离了茅山。灵心观的事，到此为止。"
msgstr "你離了茅山。靈心觀的事，到此為止。"

msgid "灵心观藏经楼的二楼，红布桌上放着茅山的镇教秘籍。林忌在灵心观的大殿——问他「师弟」，再上二楼看看那张桌子。"
msgstr "靈心觀藏經樓的二樓，紅布桌上放著茅山的鎮教秘籍。林忌在靈心觀的大殿——問他「師弟」，再上二樓看看那張桌子。"

msgid "镇教秘籍少了一函。红布上压着一张发黄的字条：书我带走。师兄守山，我守人。"
msgstr "鎮教秘籍少了一函。紅布上壓著一張發黃的字條：書我帶走。師兄守山，我守人。"

msgid "回灵心观的大殿，再问林忌「师弟」。"
msgstr "回靈心觀的大殿，再問林忌「師弟」。"

msgid "林忌说：少的那一函叫《上清符箓》。二十年前兵部的庾大人求茅山镇宅，他不肯，他的师弟揣着书下了山，进了京城的兵部尚书府，再没回来。"
msgstr "林忌說：少的那一函叫《上清符籙》。二十年前兵部的庾大人求茅山鎮宅，他不肯，他的師弟揣著書下了山，進了京城的兵部尚書府，再沒回來。"

msgid "数出藏经楼的镇教秘籍少了一函"
msgstr "數出藏經樓的鎮教秘籍少了一函"

msgid "侍者"
msgstr "侍者"

msgid "林忌的师弟二十年前进了京师的兵部尚书府。尚书府的花园里有个花匠（进府要先打点大门的门房）——问他「师兄」。"
msgstr "林忌的師弟二十年前進了京師的兵部尚書府。尚書府的花園裡有個花匠（進府要先打點大門的門房）——問他「師兄」。"

msgid "尚书府的花匠就是林忌的师弟。他镇了二十年宅，教过庾清尘；这两年小屋里来了逆灵宫的人，他们烧掉的东西，他一页页抄在了《上清符箓》的空白处。"
msgstr "尚書府的花匠就是林忌的師弟。他鎮了二十年宅，教過庾清塵；這兩年小屋裡來了逆靈宮的人，他們燒掉的東西，他一頁頁抄在了《上清符籙》的空白處。"

msgid "问尚书府的花匠「符箓」。"
msgstr "問尚書府的花匠「符籙」。"

msgid "花匠把《上清符箓》交给了你：前半是茅山的符，后半是逆灵宫的字。"
msgstr "花匠把《上清符籙》交給了你：前半是茅山的符，後半是逆靈宮的字。"

msgid "从尚书府的花匠手里接过了《上清符箓》"
msgstr "從尚書府的花匠手裡接過了《上清符籙》"

msgid "把《上清符箓》带回灵心观的大殿，交给林忌（「给」他）。"
msgstr "把《上清符籙》帶回靈心觀的大殿，交給林忌（「給」他）。"

msgid "林忌一页一页翻过去，翻到后半本停住了：是逆灵宫的字。他说，师弟会来的。"
msgstr "林忌一頁一頁翻過去，翻到後半本停住了：是逆靈宮的字。他說，師弟會來的。"

msgid "林忌说师弟会来。花匠随后自己上了山——二十年没进过的大殿，下回你进殿，他就站在殿门里。"
msgstr "林忌說師弟會來。花匠隨後自己上了山——二十年沒進過的大殿，下回你進殿，他就站在殿門裡。"

msgid "花匠站在殿门里，叫了林忌一声师兄。林忌说烧：连书带字投进香炉，茅山宁可没有它。花匠说留：锁回藏经楼，茅山才认得逆灵宫的字。"
msgstr "花匠站在殿門裡，叫了林忌一聲師兄。林忌說燒：連書帶字投進香爐，茅山寧可沒有它。花匠說留：鎖回藏經樓，茅山才認得逆靈宮的字。"

msgid "烧（问林忌「烧」）：书投进香炉，花匠回京城守着庾清尘；林忌教你谷衣心法，虹台上茅山投颜违（主剿）。留（问花匠「留」）：书锁回藏经楼二楼，花匠留在山上守书，教茅山道术，谁都教；林忌从此对你冷一分，虹台上茅山投旧盟主（北麓的人交茅山看着）。两边茅山的弟子都晋护法。"
msgstr "燒（問林忌「燒」）：書投進香爐，花匠回京城守著庾清塵；林忌教你谷衣心法，虹臺上茅山投顏違（主剿）。留（問花匠「留」）：書鎖回藏經樓二樓，花匠留在山上守書，教茅山道術，誰都教；林忌從此對你冷一分，虹臺上茅山投舊盟主（北麓的人交茅山看著）。兩邊茅山的弟子都晉護法。"

msgid "《上清符箓》投进了殿前的香炉。茅山宁可没有这本书；花匠下山回京城去了。"
msgstr "《上清符籙》投進了殿前的香爐。茅山寧可沒有這本書；花匠下山回京城去了。"

msgid "看着林忌把《上清符箓》投进了香炉"
msgstr "看著林忌把《上清符籙》投進了香爐"

msgid "《上清符箓》锁回了藏经楼二楼，花匠留在山上守书。护法的名分，是花匠替你向林忌讨的。"
msgstr "《上清符籙》鎖回了藏經樓二樓，花匠留在山上守書。護法的名分，是花匠替你向林忌討的。"

msgid "把《上清符箓》收回了藏经楼"
msgstr "把《上清符籙》收回了藏經樓"

msgid "北麓那座道观里还剩着人。湖上的事了了（终章之后），问林忌「剿」：官兵上山，一个也走不了。北麓的人已经有了去处的，这一步就过了。"
msgstr "北麓那座道觀裡還剩著人。湖上的事了了（終章之後），問林忌「剿」：官兵上山，一個也走不了。北麓的人已經有了去處的，這一步就過了。"

msgid "北麓那座道观里剩下的人，有了去处。"
msgstr "北麓那座道觀裡剩下的人，有了去處。"

msgid "北麓那座道观里还剩着人。湖上的事了了（终章之后），问藏经楼二楼的花匠「北麓」：他拿着书上北麓去念他们自己的经——你上北麓，在绞盘边看他念完。北麓的人已经有了去处的，这一步就过了。"
msgstr "北麓那座道觀裡還剩著人。湖上的事了了（終章之後），問藏經樓二樓的花匠「北麓」：他拿著書上北麓去念他們自己的經——你上北麓，在絞盤邊看他念完。北麓的人已經有了去處的，這一步就過了。"

msgid "乔阴"
msgstr "喬陰"

msgid "风泉之剑里住着剑灵；见过它的人，才算步玄的人。骆云舟的大哥在兵部尚书府写了十年字，兵部抄本上多出来的三句是他落的笔——让他上堂作证，还是保住骆家。"
msgstr "風泉之劍裡住著劍靈；見過它的人，才算步玄的人。駱雲舟的大哥在兵部尚書府寫了十年字，兵部抄本上多出來的三句是他落的筆——讓他上堂作證，還是保住駱家。"

msgid "你离了步玄派。曼雩台上的事，到此为止。"
msgstr "你離了步玄派。曼雩臺上的事，到此為止。"

msgid "问乔阴曼雩台的骆云舟「风泉」，再问他「问剑」：他把风泉之剑插在台边的青石上。天黑以后（夜晚、午夜）剑灵站在石前——跟它切磋，在它念到第四句「剑神如意」之前打中它。"
msgstr "問喬陰曼雩臺的駱雲舟「風泉」，再問他「問劍」：他把風泉之劍插在臺邊的青石上。天黑以後（夜晚、午夜）劍靈站在石前——跟它切磋，在它念到第四句「劍神如意」之前打中它。"

msgid "剑灵在「剑神如意」之前收了剑。骆云舟说：步玄认你。"
msgstr "劍靈在「劍神如意」之前收了劍。駱雲舟說：步玄認你。"

msgid "在曼雩台上问过了剑，见过了风泉剑灵"
msgstr "在曼雩臺上問過了劍，見過了風泉劍靈"

msgid "今夜的四句念完了，剑灵回了剑——明晚天黑再来"
msgstr "今夜的四句念完了，劍靈回了劍——明晚天黑再來"

msgid "问骆云舟「骆家」。他的家事在京城，要等主线第九章（进京）开了。"
msgstr "問駱雲舟「駱家」。他的家事在京城，要等主線第九章（進京）開了。"

msgid "骆云舟是骆家的二小子。大哥骆建章没去练剑，写得一手好字，在兵部尚书庾子建的府上做了十年书启；兄弟俩十年没说过话。他写了一封家书，托你送进京。"
msgstr "駱雲舟是駱家的二小子。大哥駱建章沒去練劍，寫得一手好字，在兵部尚書庾子建的府上做了十年書啟；兄弟倆十年沒說過話。他寫了一封家書，託你送進京。"

msgid "等主线第九章：湖底的事了了，才进得了京"
msgstr "等主線第九章：湖底的事了了，才進得了京"

#~ msgid "把家书送进京（「给」骆建章）：他在兵部尚书府的客厅里写字——进府先打点大门的门房；见过韦相国的，问相国「骆建章」，他写个条子给门房。庾子建下了狱，骆建章就在西街的相国府。"
#~ msgstr "把家書送進京（「給」駱建章）：他在兵部尚書府的客廳裡寫字——進府先打點大門的門房；見過韋相國的，問相國「駱建章」，他寫個條子給門房。庾子建下了獄，駱建章就在西街的相國府。"

msgid "骆建章读完了信：「他还是那么写字，最后一笔甩出格子。」抄本的事，他一句没提。"
msgstr "駱建章讀完了信：「他還是那麼寫字，最後一筆甩出格子。」抄本的事，他一句沒提。"

msgid "第九章御书房樟木匣里的兵部抄本，比先帝的原令多出三句。带着它问骆建章「抄本」，或者问韦相国「抄本的字」。"
msgstr "第九章御書房樟木匣裡的兵部抄本，比先帝的原令多出三句。帶著它問駱建章「抄本」，或者問韋相國「抄本的字」。"

msgid "骆建章认了：二十年前他在兵部做抄手，原令存档的底子是他抄的；兵部抄本是庾子建口述、他落的笔——多出来的是哪三句，他写的时候就知道。"
msgstr "駱建章認了：二十年前他在兵部做抄手，原令存檔的底子是他抄的；兵部抄本是庾子建口述、他落的筆——多出來的是哪三句，他寫的時候就知道。"

msgid "认出了兵部抄本上骆家的字"
msgstr "認出了兵部抄本上駱家的字"

msgid "带着兵部抄本"
msgstr "帶著兵部抄本"

msgid "抄本在皇城御书房的樟木匣里：先走主线第九章"
msgstr "抄本在皇城御書房的樟木匣裡：先走主線第九章"

msgid "回乔阴的曼雩台，把大哥的话告诉骆云舟（问他「骆家」）。"
msgstr "回喬陰的曼雩臺，把大哥的話告訴駱雲舟（問他「駱家」）。"

msgid "骆云舟听完，扇子停在半空。十年没回京城，他说，进京一趟。"
msgstr "駱雲舟聽完，扇子停在半空。十年沒回京城，他說，進京一趟。"

msgid "骆云舟进京了。去西街的相国府：兄弟俩在正厅上见面，韦相国坐在上首。（话听了一半就走开的：作证问骆云舟「作证」，保住骆家问骆建章「回家」。）"
msgstr "駱雲舟進京了。去西街的相國府：兄弟倆在正廳上見面，韋相國坐在上首。（話聽了一半就走開的：作證問駱雲舟「作證」，保住駱家問駱建章「回家」。）"

msgid "骆云舟要大哥上堂，把抄本上那三句是谁口述的说出来；大哥要跟他回乔阴，抄本的事不提。韦执中坐在上首，一句话也没说。"
msgstr "駱雲舟要大哥上堂，把抄本上那三句是誰口述的說出來；大哥要跟他回喬陰，抄本的事不提。韋執中坐在上首，一句話也沒說。"

msgid "作证（问骆云舟「作证」）：大哥写供状，说出抄本那三句是庾子建口述——第九章还没定的，朝上揭发多一样人证；庾子建已经下狱的，大哥照实供，判流放；私了过或先解了皇叔通缉的，乔阴的案子重开。骆家和朝廷翻脸，虹台上步玄投旧盟主。保住骆家（问骆建章「回家」）：骆云舟带大哥回乔阴，抄本的事不提，大哥在曼雩台抄谱；骆家照旧是京城的世家，虹台上步玄投颜违。两边步玄的弟子都晋执事。"
msgstr "作證（問駱雲舟「作證」）：大哥寫供狀，說出抄本那三句是庾子建口述——第九章還沒定的，朝上揭發多一樣人證；庾子建已經下獄的，大哥照實供，判流放；私了過或先解了皇叔通緝的，喬陰的案子重開。駱家和朝廷翻臉，虹臺上步玄投舊盟主。保住駱家（問駱建章「回家」）：駱雲舟帶大哥回喬陰，抄本的事不提，大哥在曼雩臺抄譜；駱家照舊是京城的世家，虹臺上步玄投顏違。兩邊步玄的弟子都晉執事。"

msgid "骆建章写了供状，按了手印：兵部抄本上多出来的三句，是庾子建口述、他落的笔。骆家和朝廷翻了脸。"
msgstr "駱建章寫了供狀，按了手印：兵部抄本上多出來的三句，是庾子建口述、他落的筆。駱家和朝廷翻了臉。"

msgid "陪骆建章写下了兵部抄本的供状"
msgstr "陪駱建章寫下了兵部抄本的供狀"

msgid "骆云舟带大哥回了乔阴。抄本的事，骆家不再提；曼雩台上多了一张书案。"
msgstr "駱雲舟帶大哥回了喬陰。抄本的事，駱家不再提；曼雩臺上多了一張書案。"

msgid "让骆云舟带大哥回了乔阴"
msgstr "讓駱雲舟帶大哥回了喬陰"

msgid "流云轩里躺着一个被鬼卒抓伤的乔阴樵夫，玄智的药赶不出那股寒；金门外站了十年的独眼头陀开口了：「我能。」他那部火性的经，三十年前从番坊来过一回，山烟寺没有收——这一回，收不收。"
msgstr "流雲軒裡躺著一個被鬼卒抓傷的喬陰樵夫，玄智的藥趕不出那股寒；金門外站了十年的獨眼頭陀開口了：「我能。」他那部火性的經，三十年前從番坊來過一回，山煙寺沒有收——這一回，收不收。"

msgid "你离了山烟寺。流云轩的事，到此为止。"
msgstr "你離了山煙寺。流雲軒的事，到此為止。"

msgid "流云轩里躺着一个乔阴来的樵夫，伤口是冷的。去山烟寺大雄宝殿问玄智方丈「流云轩」，请他开方子。"
msgstr "流雲軒裡躺著一個喬陰來的樵夫，傷口是冷的。去山煙寺大雄寶殿問玄智方丈「流雲軒」，請他開方子。"

msgid "玄智开了方子：附子回阳，麝香开窍，鬼臼以毒攻毒。三味齐了，交给流云轩的药僧煎。"
msgstr "玄智開了方子：附子回陽，麝香開竅，鬼臼以毒攻毒。三味齊了，交給流雲軒的藥僧煎。"

msgid "等主线第五章：寒於宝衣的事了了，才有这个病人"
msgstr "等主線第五章：寒於寶衣的事了了，才有這個病人"

msgid "第一味：附子。在山烟寺东边的药圃里「采」。"
msgstr "第一味：附子。在山煙寺東邊的藥圃裡「採」。"

msgid "你在药圃东边那一畦挖出了一块附子。"
msgstr "你在藥圃東邊那一畦挖出了一塊附子。"

msgid "第二味：麝香。雪亭镇桑邻药铺的杨掌柜年轻时跟玄智学过医，问他「山烟寺」。"
msgstr "第二味：麝香。雪亭鎮桑鄰藥鋪的楊掌櫃年輕時跟玄智學過醫，問他「山煙寺」。"

msgid "杨掌柜看了方子，包了一小包麝香给你，没收钱。"
msgstr "楊掌櫃看了方子，包了一小包麝香給你，沒收錢。"

msgid "第三味：鬼臼，长在乔阴树王坟边的石缝里。那里站着一个鬼卒——打发了它，在石缝边「采」。"
msgstr "第三味：鬼臼，長在喬陰樹王墳邊的石縫裡。那裡站著一個鬼卒——打發了它，在石縫邊「採」。"

msgid "你在树王坟边的石缝里采到了一株鬼臼。"
msgstr "你在樹王墳邊的石縫裡採到了一株鬼臼。"

msgid "三味齐了。回流云轩，问药僧「煎药」。"
msgstr "三味齊了。回流雲軒，問藥僧「煎藥」。"

msgid "药僧把三味药煎成了一碗黑褐色的汤药。"
msgstr "藥僧把三味藥煎成了一碗黑褐色的湯藥。"

msgid "把汤药喂给老葛（「给」流云轩里躺着的樵夫）。"
msgstr "把湯藥餵給老葛（「給」流雲軒裡躺著的樵夫）。"

msgid "药喂下去了，老葛肚子里是热的，可那条胳膊还是冷，冷到骨头缝里——寒气退不下去。"
msgstr "藥餵下去了，老葛肚子裡是熱的，可那條胳膊還是冷，冷到骨頭縫裡——寒氣退不下去。"

msgid "替流云轩采齐了玄智的三味药，喂了乔阴的樵夫"
msgstr "替流雲軒採齊了玄智的三味藥，餵了喬陰的樵夫"

msgid "知客"
msgstr "知客"

msgid "玄智的药赶不出那股寒。金门外站了十年、从不说话的独眼头陀，问他「病人」。让他治（问头陀「领路」）：领他进流云轩，老葛当场就好——可寺规不许外人进流云轩，玄智会记你不守寺规。照寺规（问大雄宝殿的玄智「寺规」）：方丈自己守着老葛，命保得住，一只手保不住；头陀从此不理你。"
msgstr "玄智的藥趕不出那股寒。金門外站了十年、從不說話的獨眼頭陀，問他「病人」。讓他治（問頭陀「領路」）：領他進流雲軒，老葛當場就好——可寺規不許外人進流雲軒，玄智會記你不守寺規。照寺規（問大雄寶殿的玄智「寺規」）：方丈自己守著老葛，命保得住，一隻手保不住；頭陀從此不理你。"

msgid "你领独眼头陀进了流云轩。他一掌按在老葛的伤口上，寒气冒成一缕白烟——老葛当场坐了起来。玄智记下了：你不守寺规。"
msgstr "你領獨眼頭陀進了流雲軒。他一掌按在老葛的傷口上，寒氣冒成一縷白煙——老葛當場坐了起來。玄智記下了：你不守寺規。"

msgid "领金门外的独眼头陀进了流云轩，治好了乔阴的樵夫"
msgstr "領金門外的獨眼頭陀進了流雲軒，治好了喬陰的樵夫"

msgid "你照了寺规。玄智在流云轩守了老葛三天三夜：命保住了，右手废了。头陀转身回了金门外。"
msgstr "你照了寺規。玄智在流雲軒守了老葛三天三夜：命保住了，右手廢了。頭陀轉身回了金門外。"

msgid "照山烟寺的寺规，没让外人进流云轩"
msgstr "照山煙寺的寺規，沒讓外人進流雲軒"

msgid "独眼头陀那门火性的内功，他练的那部经，不是山烟寺的东西。它从番坊来：去番坊日陀罗寺问龙若法王「头陀」。"
msgstr "獨眼頭陀那門火性的內功，他練的那部經，不是山煙寺的東西。它從番坊來：去番坊日陀羅寺問龍若法王「頭陀」。"

msgid "龙若法王说起了三十年前：师父从天竺背来的两部经，当年不肯开经匣的住持，追出山门的玄尘，十年前派回去的头陀和他那只眼。他给了你一片贝叶：「收不收，是山烟寺的事。」"
msgstr "龍若法王說起了三十年前：師父從天竺背來的兩部經，當年不肯開經匣的住持，追出山門的玄塵，十年前派回去的頭陀和他那隻眼。他給了你一片貝葉：「收不收，是山煙寺的事。」"

msgid "照了寺规的：先回流云轩，药僧有话要说"
msgstr "照了寺規的：先回流雲軒，藥僧有話要說"

msgid "回日照山，把龙若法王的贝叶拿给金门外的独眼头陀看（问他「经」）。"
msgstr "回日照山，把龍若法王的貝葉拿給金門外的獨眼頭陀看（問他「經」）。"

msgid "独眼头陀认出了叶边师父的字。十年里第一次，他跨进了金门，往大雄宝殿去了。"
msgstr "獨眼頭陀認出了葉邊師父的字。十年裡第一次，他跨進了金門，往大雄寶殿去了。"

msgid "头陀上了大雄宝殿。去大殿：玄智、头陀、你。（话听了一半就走开的：收经问玄智「收经」，守寺问玄智「守寺」。）"
msgstr "頭陀上了大雄寶殿。去大殿：玄智、頭陀、你。（話聽了一半就走開的：收經問玄智「收經」，守寺問玄智「守寺」。）"

msgid "头陀把贝叶放在佛前，只问一句：收，还是不收。玄智说起三十年前走掉的玄尘师弟，回过头来问你。"
msgstr "頭陀把貝葉放在佛前，只問一句：收，還是不收。玄智說起三十年前走掉的玄塵師弟，回過頭來問你。"

msgid "收经（问玄智「收经」）：头陀受戒入寺，流云轩从此治得了鬼卒的寒，头陀在流云轩教婆萝蜜多心经，谁都能学；容得下西来的经，也容得下别人，虹台上山烟寺投旧盟主。守寺（问玄智「守寺」）：本寺一脉，经交还龙若，头陀回番坊，金门外空了；玄智肯教外人莲华心法；虹台上山烟寺投颜违。两边山烟寺的弟子都晋首座。"
msgstr "收經（問玄智「收經」）：頭陀受戒入寺，流雲軒從此治得了鬼卒的寒，頭陀在流雲軒教婆蘿蜜多心經，誰都能學；容得下西來的經，也容得下別人，虹臺上山煙寺投舊盟主。守寺（問玄智「守寺」）：本寺一脈，經交還龍若，頭陀回番坊，金門外空了；玄智肯教外人蓮華心法；虹臺上山煙寺投顏違。兩邊山煙寺的弟子都晉首座。"

msgid "山烟寺收了西来的经。独眼头陀在佛前受了戒，去了流云轩；鬼卒的寒，往后山烟寺赶得出去了。"
msgstr "山煙寺收了西來的經。獨眼頭陀在佛前受了戒，去了流雲軒；鬼卒的寒，往後山煙寺趕得出去了。"

msgid "把番坊的婆萝蜜多心经带回日照山，山烟寺收了经"
msgstr "把番坊的婆蘿蜜多心經帶回日照山，山煙寺收了經"

msgid "首座"
msgstr "首座"

msgid "山烟寺守了本寺一脉。玄智把贝叶交还头陀，头陀回了番坊，金门外那块地方空了。"
msgstr "山煙寺守了本寺一脈。玄智把貝葉交還頭陀，頭陀回了番坊，金門外那塊地方空了。"

msgid "陪山烟寺守住了本寺一脉，把西来的经送回了番坊"
msgstr "陪山煙寺守住了本寺一脈，把西來的經送回了番坊"

#~ msgid "青石村北边那个拴着铁链的山洞，村长说「绝对不可以打开」。现在洞里真的有东西了，村里的孩子又钻了进去。山洞后面就是八卦阵，阵后面是不问世事的绝尘子。"
#~ msgstr "青石村北邊那個拴著鐵鏈的山洞，村長說「絕對不可以打開」。現在洞裡真的有東西了，村裡的孩子又鑽了進去。山洞後面就是八卦陣，陣後面是不問世事的絕塵子。"

msgid "你离了绝尘派。青石村的事，到此为止。"
msgstr "你離了絕塵派。青石村的事，到此為止。"

msgid "青石村北边那个山洞，门上拴着手臂粗的铁链，村里人说闹鬼。拴门的是村长：去他家（广场南边那间石屋）问他「山洞」。"
msgstr "青石村北邊那個山洞，門上拴著手臂粗的鐵鏈，村裡人說鬧鬼。拴門的是村長：去他家（廣場南邊那間石屋）問他「山洞」。"

msgid "村长说：那道门是他拴的。妇人家的阿牛背着妹妹，又钻进去了。"
msgstr "村長說：那道門是他拴的。婦人家的阿牛背著妹妹，又鑽進去了。"

msgid "等主线第五章：寒於宝衣的事了了，鬼卒才出来"
msgstr "等主線第五章：寒於寶衣的事了了，鬼卒才出來"

msgid "开了洞口那道拴着铁链的木门进洞，打发洞里的鬼卒，找到阿牛，问他「回家」，领他回村北路口找他娘。"
msgstr "開了洞口那道拴著鐵鏈的木門進洞，打發洞裡的鬼卒，找到阿牛，問他「回家」，領他回村北路口找他娘。"

msgid "你把阿牛和小翠领出了山洞，交给了他们的娘。"
msgstr "你把阿牛和小翠領出了山洞，交給了他們的娘。"

msgid "洞口那个鬼卒"
msgstr "洞口那個鬼卒"

msgid "洞底那个鬼卒"
msgstr "洞底那個鬼卒"

msgid "孩子回家了。去告诉村长，再问他「山洞」。"
msgstr "孩子回家了。去告訴村長，再問他「山洞」。"

msgid "村长这回把那句话说完了：「国之将亡，必有妖孽。」"
msgstr "村長這回把那句話說完了：「國之將亡，必有妖孽。」"

msgid "洞的北口就是去八卦阵的荒山路。回石室大厅，问绝尘子「青石村」。"
msgstr "洞的北口就是去八卦陣的荒山路。回石室大廳，問絕塵子「青石村」。"

msgid "绝尘子说，洞里有东西，他知道。阵守得住石室，他就不管——绝尘派不问世事。"
msgstr "絕塵子說，洞裡有東西，他知道。陣守得住石室，他就不管——絕塵派不問世事。"

msgid "把青石村的孩子从闹鬼的山洞里领了出来"
msgstr "把青石村的孩子從鬧鬼的山洞裡領了出來"

msgid "不是绝尘派的弟子：进大厅要再走一回八卦阵（从东边的石室进去）"
msgstr "不是絕塵派的弟子：進大廳要再走一回八卦陣（從東邊的石室進去）"

msgid "大厅里还有一个人：绝尘子的首徒了尘。他一直在看你。问他「山洞」。"
msgstr "大廳裡還有一個人：絕塵子的首徒了塵。他一直在看你。問他「山洞」。"

msgid "了尘说：师父知道洞里有东西。阵守得住石室，他就不管。"
msgstr "了塵說：師父知道洞裡有東西。陣守得住石室，他就不管。"

msgid "了尘说起师父的时候，一直看着佛像下的绝尘子，话没有说完。问他「师父」。"
msgstr "了塵說起師父的時候，一直看著佛像下的絕塵子，話沒有說完。問他「師父」。"

#~ msgid "了尘说起了三十年前的事。"
#~ msgstr "了塵說起了三十年前的事。"

msgid "正月十七 · 虹台大会"
msgstr "正月十七 · 虹臺大會"

msgid "正月十七，九派在水烟阁外的虹台推选武林盟主。九派各一票，过半才换人；那天山下会出事，你只管得了一件。"
msgstr "正月十七，九派在水煙閣外的虹臺推選武林盟主。九派各一票，過半才換人；那天山下會出事，你只管得了一件。"

msgid "已表态"
msgstr "已表態"

msgid "投颜违"
msgstr "投顏違"

msgid "过半（五派）才换盟主"
msgstr "過半（五派）才換盟主"

msgid "听你的"
msgstr "聽你的"

msgid "五派听你的，你才站得出来"
msgstr "五派聽你的，你才站得出來"

msgid "那天山下：神教的杀手会截山烟寺的轿子（不管，山烟寺不来）"
msgstr "那天山下：神教的殺手會截山煙寺的轎子（不管，山煙寺不來）"

msgid "那天山下：逆灵宫的余孽会烧葬剑亭（不管，茅山不来）"
msgstr "那天山下：逆靈宮的餘孽會燒葬劍亭（不管，茅山不來）"

msgid "那天山下：颜违的人会堵封山的路（不管，封山不来）"
msgstr "那天山下：顏違的人會堵封山的路（不管，封山不來）"

msgid "那天山下：兵部会「请」骆云舟喝茶（不管，步玄派不来）"
msgstr "那天山下：兵部會「請」駱雲舟喝茶（不管，步玄派不來）"

msgid "那天山下：照现在的样子，太平"
msgstr "那天山下：照現在的樣子，太平"

msgid "封山剑派：还没表态"
msgstr "封山劍派：還沒表態"

msgid "封山剑派：等盟主回来"
msgstr "封山劍派：等盟主回來"

msgid "封山剑派：投颜违——颜违许了北宗一个座"
msgstr "封山劍派：投顏違——顏違許了北宗一個座"

msgid "封山剑派：听你的"
msgstr "封山劍派：聽你的"

msgid "天邪派：还没表态"
msgstr "天邪派：還沒表態"

msgid "天邪派：投颜违"
msgstr "天邪派：投顏違"

msgid "天邪派：等盟主回来"
msgstr "天邪派：等盟主回來"

msgid "天邪派：听你的"
msgstr "天邪派：聽你的"

msgid "振远镖局：还没表态"
msgstr "振遠鏢局：還沒表態"

msgid "振远镖局：投颜违——旧案到此为止"
msgstr "振遠鏢局：投顏違——舊案到此為止"

msgid "振远镖局：投旧盟主——旧案查到底"
msgstr "振遠鏢局：投舊盟主——舊案查到底"

msgid "振远镖局：听你的"
msgstr "振遠鏢局：聽你的"

msgid "茅山派：还没表态"
msgstr "茅山派：還沒表態"

msgid "茅山派：投颜违——主剿"
msgstr "茅山派：投顏違——主剿"

msgid "茅山派：投旧盟主——北麓的人交茅山看着"
msgstr "茅山派：投舊盟主——北麓的人交茅山看著"

msgid "茅山派：听你的"
msgstr "茅山派：聽你的"

msgid "晚月庄：还没表态"
msgstr "晚月莊：還沒表態"

msgid "晚月庄：投旧盟主——封地照旧"
msgstr "晚月莊：投舊盟主——封地照舊"

msgid "晚月庄：投颜违——逐神教"
msgstr "晚月莊：投顏違——逐神教"

msgid "晚月庄：听你的"
msgstr "晚月莊：聽你的"

msgid "山烟寺：还没表态"
msgstr "山煙寺：還沒表態"

msgid "山烟寺：投颜违——逐神教"
msgstr "山煙寺：投顏違——逐神教"

msgid "山烟寺：投旧盟主——容神教"
msgstr "山煙寺：投舊盟主——容神教"

msgid "山烟寺：投旧盟主——收了西来的经"
msgstr "山煙寺：投舊盟主——收了西來的經"

msgid "山烟寺：听你的"
msgstr "山煙寺：聽你的"

msgid "步玄派：还没表态"
msgstr "步玄派：還沒表態"

msgid "步玄派：投颜违——京城随朝廷"
msgstr "步玄派：投顏違——京城隨朝廷"

msgid "步玄派：投旧盟主——兵部的旧案查到底"
msgstr "步玄派：投舊盟主——兵部的舊案查到底"

msgid "步玄派：听你的"
msgstr "步玄派：聽你的"

msgid "花紫会：还没表态"
msgstr "花紫會：還沒表態"

msgid "花紫会：投颜违——吃官饭"
msgstr "花紫會：投顏違——吃官飯"

msgid "花紫会：投旧盟主——怕官"
msgstr "花紫會：投舊盟主——怕官"

msgid "花紫会：听你的"
msgstr "花紫會：聽你的"

msgid "绝尘派：还没表态"
msgstr "絕塵派：還沒表態"

msgid "绝尘派：不问世事，不来"
msgstr "絕塵派：不問世事，不來"

msgid "绝尘派：下山来，投旧盟主"
msgstr "絕塵派：下山來，投舊盟主"

#~ msgid "正月十七，九派在水烟阁外的虹台推选武林盟主：颜违、旧盟主（卫沧澜回来了就是他，没回来就是那把空椅子），或者你。湖底的事了了，才会开会。各派的票跟着你做过的事走——封山、天邪看那两条线走到哪一边。"
#~ msgstr "正月十七，九派在水煙閣外的虹臺推選武林盟主：顏違、舊盟主（衛滄瀾回來了就是他，沒回來就是那把空椅子），或者你。湖底的事了了，才會開會。各派的票跟著你做過的事走——封山、天邪看那兩條線走到哪一邊。"

msgid "湖底的事了了。正月十七的虹台大会，照旧要开。"
msgstr "湖底的事了了。正月十七的虹臺大會，照舊要開。"

msgid "回雪亭镇的饮风客栈。店小二那里有一封给你的帖子。"
msgstr "回雪亭鎮的飲風客棧。店小二那裡有一封給你的帖子。"

msgid "饮风客栈的店小二递来一张请柬：正月十七，水烟阁外虹台。"
msgstr "飲風客棧的店小二遞來一張請柬：正月十七，水煙閣外虹臺。"

#~ msgid "上虹台之前，九派可以各走一趟：问各派掌门「虹台」，听他们这一票投谁、为什么；话里留了余地的，还可以请他改一改（先确认）。封山剑派——雪亭镇淳风武馆的柳淳风（跟了北宗的，问内院的柳绘心）；天邪派——水烟阁正厅的潘军禅；振远镖局——绮云镇的陈剑秋；茅山派——灵心观的林忌；晚月庄——庄主蓝止萍；山烟寺——住持玄智和尚；步玄派——乔阴县城的骆云舟；花紫会——乔阴的陆得财；绝尘派——青石村的绝尘子。虹台在水烟阁葬剑亭往南的石阶上；人到了，在擎天柱前「入席」（先确认：入了席就不能再游说、改票）。"
#~ msgstr "上虹臺之前，九派可以各走一趟：問各派掌門「虹臺」，聽他們這一票投誰、為什麼；話裡留了餘地的，還可以請他改一改（先確認）。封山劍派——雪亭鎮淳風武館的柳淳風（跟了北宗的，問內院的柳繪心）；天邪派——水煙閣正廳的潘軍禪；振遠鏢局——綺雲鎮的陳劍秋；茅山派——靈心觀的林忌；晚月莊——莊主藍止萍；山煙寺——住持玄智和尚；步玄派——喬陰縣城的駱雲舟；花紫會——喬陰的陸得財；絕塵派——青石村的絕塵子。虹臺在水煙閣葬劍亭往南的石階上；人到了，在擎天柱前「入席」（先確認：入了席就不能再遊說、改票）。"

msgid "正月十七，你上了虹台。"
msgstr "正月十七，你上了虹臺。"

msgid "正月十七，虹台上：山下出了事，你只来得及管一件——没管的那一派上不了虹台。九派到齐了唱票，过半（五票）才换盟主。灭了侮天鬼、又有五派听你的，你也可以站出来。人走开了，回擎天柱前「入席」接着开。"
msgstr "正月十七，虹臺上：山下出了事，你只來得及管一件——沒管的那一派上不了虹臺。九派到齊了唱票，過半（五票）才換盟主。滅了侮天鬼、又有五派聽你的，你也可以站出來。人走開了，回擎天柱前「入席」接著開。"

msgid "虹台上散了会。"
msgstr "虹臺上散了會。"

msgid "一把粗制滥造的长剑，把手部份用布缠绕了好几圈以防止武器脱手。\n"
msgstr "一把粗製濫造的長劍，把手部份用布纏繞了好幾圈以防止武器脫手。\n"

msgid "短剑"
msgstr "短劍"

msgid "一把粗制滥造的短剑，把手部份用布缠绕了好几圈以防止武器脱手。\n"
msgstr "一把粗製濫造的短劍，把手部份用布纏繞了好幾圈以防止武器脫手。\n"

msgid "皮衣"
msgstr "皮衣"

msgid "太阴八卦袍"
msgstr "太陰八卦袍"

msgid "一具已经腐朽的骸骨"
msgstr "一具已經腐朽的骸骨"

msgid "一具已经腐朽的骸骨，靠着石壁坐着，骨头上还挂着几片烂成灰褐色的衣料。身量矮小，牙齿齐全，骨龄不过三十；手边没有剑，也没有刀。石壁上的字自称南危水，说埋骨于此——可水烟阁的五长老南危水，是个高大的老人。\n"
msgstr "一具已經腐朽的骸骨，靠著石壁坐著，骨頭上還掛著幾片爛成灰褐色的衣料。身量矮小，牙齒齊全，骨齡不過三十；手邊沒有劍，也沒有刀。石壁上的字自稱南危水，說埋骨於此——可水煙閣的五長老南危水，是個高大的老人。\n"

msgid "具"
msgstr "具"

msgid "鬼头刀"
msgstr "鬼頭刀"

msgid "这是一把沈重的鬼头刀，刀柄上雕著 一个丑陋可怖的鬼头正裂开了嘴大笑。\n"
msgstr "這是一把沈重的鬼頭刀，刀柄上雕著 一個醜陋可怖的鬼頭正裂開了嘴大笑。\n"

msgid "狼皮披风"
msgstr "狼皮披風"

msgid "竹管"
msgstr "竹管"

msgid "一根约两寸多长的竹管，上面戳了三个小孔，也许可以用来吹奏？\n"
msgstr "一根約兩寸多長的竹管，上面戳了三個小孔，也許可以用來吹奏？\n"

msgid "过招要旨"
msgstr "過招要旨"

msgid "这是一本介绍过招时如何拆招卸力的书籍。\n对练武人来说是本不可多得的珍宝。\n"
msgstr "這是一本介紹過招時如何拆招卸力的書籍。\n對練武人來說是本不可多得的珍寶。\n"

msgid "夜行衣"
msgstr "夜行衣"

msgid "这是一件夜行人用来掩藏行踪的黑色紧身衣。\n"
msgstr "這是一件夜行人用來掩藏行蹤的黑色緊身衣。\n"

msgid "飞刀"
msgstr "飛刀"

msgid "飞刀是一种十分轻、锐利的匕首，用来当作暗器使用。\n"
msgstr "飛刀是一種十分輕、銳利的匕首，用來當作暗器使用。\n"

msgid "土匪探哨"
msgstr "土匪探哨"

msgid "这人满脸匪气，一付百无聊赖的模样，令人望而生厌。\n"
msgstr "這人滿臉匪氣，一付百無聊賴的模樣，令人望而生厭。\n"

msgid "土匪"
msgstr "土匪"

msgid "这家伙长得高高瘦瘦，脸色苍白，一付无精打采的样子。\n"
msgstr "這傢伙長得高高瘦瘦，臉色蒼白，一付無精打采的樣子。\n"

msgid "这家伙又矮又胖，圆滚滚的眼珠子在满脸肥肉中骨碌碌地转来转去。\n"
msgstr "這傢伙又矮又胖，圓滾滾的眼珠子在滿臉肥肉中骨碌碌地轉來轉去。\n"

msgid "黑冠巨蟒"
msgstr "黑冠巨蟒"

msgid "一只乌黑油亮的巨蟒，头上生著一个大肉瘤。\n"
msgstr "一隻烏黑油亮的巨蟒，頭上生著一個大肉瘤。\n"

msgid "躯干"
msgstr "軀幹"

msgid "这个老头子正对著你龇牙裂嘴，他看起来已经完全疯了。\n"
msgstr "這個老頭子正對著你齜牙裂嘴，他看起來已經完全瘋了。\n"

msgid "一只凶猛的狼狗，一只独眼正恶狠狠地瞪著你。\n"
msgstr "一隻兇猛的狼狗，一隻獨眼正惡狠狠地瞪著你。\n"

msgid "后脚"
msgstr "後腳"

msgid "狼狗用一只独眼恶狠狠地瞪著你。\n"
msgstr "狼狗用一隻獨眼惡狠狠地瞪著你。\n"

msgid "一只翩翩起舞的小蝴蝶哦! \n"
msgstr "一隻翩翩起舞的小蝴蝶哦! \n"

msgid "翅膀"
msgstr "翅膀"

msgid "蝴蝶拍动著翅膀! \n"
msgstr "蝴蝶拍動著翅膀! \n"

msgid "蝴蝶停在花上吸花蜜。 \n"
msgstr "蝴蝶停在花上吸花蜜。 \n"

msgid "土匪喽罗"
msgstr "土匪嘍羅"

msgid "这家伙满脸横肉，一付凶神恶煞的模样，令人望而生畏。\n"
msgstr "這傢伙滿臉橫肉，一付凶神惡煞的模樣，令人望而生畏。\n"

msgid "土匪喽罗横刀拦住去路，喝道：站住！要过老松寨，留下十两银子买路钱！\n"
msgstr "土匪嘍羅橫刀攔住去路，喝道：站住！要過老松寨，留下十兩銀子買路錢！\n"

msgid "十两银子，一个子儿不能少。拿来！"
msgstr "十兩銀子，一個子兒不能少。拿來！"

msgid "老松寨是常老大的寨子，泼风刀王常老大，听过没有？想进去，先留下买路钱。"
msgstr "老松寨是常老大的寨子，潑風刀王常老大，聽過沒有？想進去，先留下買路錢。"

msgid "前些天是来过一个黑衣黑冠的道士，拿一块金牌买了路，往里头去了。你要问，问寨主去——先留下买路钱。"
msgstr "前些天是來過一個黑衣黑冠的道士，拿一塊金牌買了路，往裡頭去了。你要問，問寨主去——先留下買路錢。"

msgid "叫阵"
msgstr "叫陣"

msgid "叫阵是跟常老大单打独斗——寨里的人不插手，但常老大的泼风刀下，没几个人站得住。要叫阵吗？"
msgstr "叫陣是跟常老大單打獨鬥——寨裡的人不插手，但常老大的潑風刀下，沒幾個人站得住。要叫陣嗎？"

msgid "叫过了还叫？聚义厅在东头，常老大等着你。"
msgstr "叫過了還叫？聚義廳在東頭，常老大等著你。"

msgid "好大的口气！"
msgstr "好大的口氣！"

msgid "朝寨子里扯着嗓子喊：有人叫阵——！"
msgstr "朝寨子裡扯著嗓子喊：有人叫陣——！"

msgid "进去吧，聚义厅在东头。常老大一个人等你，寨里的弟兄不插手。"
msgstr "進去吧，聚義廳在東頭。常老大一個人等你，寨裡的弟兄不插手。"

msgid "钱已经交过了，进去吧。"
msgstr "錢已經交過了，進去吧。"

msgid "土匪喽罗掂了掂银子，咧嘴一笑：算你识相。进去吧，寨里的弟兄不会难为你。\n"
msgstr "土匪嘍羅掂了掂銀子，咧嘴一笑：算你識相。進去吧，寨裡的弟兄不會難為你。\n"

msgid "土匪喽罗往地上啐了一口：打发叫花子呢？十两银子，少一个子儿都不行！\n"
msgstr "土匪嘍羅往地上啐了一口：打發叫花子呢？十兩銀子，少一個子兒都不行！\n"

msgid "这家伙眼神凶恶，一双精光四射的眼珠正盯著你的脖子。\n"
msgstr "這傢伙眼神兇惡，一雙精光四射的眼珠正盯著你的脖子。\n"

msgid "\n土匪首领阴恻恻地说道：这种三脚猫的功夫也敢上老松寨来撒野？！\n"
msgstr "\n土匪首領陰惻惻地說道：這種三腳貓的功夫也敢上老松寨來撒野？！\n"

msgid "\n土匪首领说道：去你的，老子今天要剁下你的头来练练毒爪！\n"
msgstr "\n土匪首領說道：去你的，老子今天要剁下你的頭來練練毒爪！\n"

msgid "\n土匪首领虎吼一声，欺身上前。\n"
msgstr "\n土匪首領虎吼一聲，欺身上前。\n"

msgid "那道士的事，寨主自己会说。聚义厅在东头。"
msgstr "那道士的事，寨主自己會說。聚義廳在東頭。"

msgid "泼风刀王"
msgstr "潑風刀王"

msgid "老松寨寨主"
msgstr "老松寨寨主"

msgid "黑衣黑冠的道士？来过。拿一块金牌子买的路——金子打的，比你那十两银子值钱多了。"
msgstr "黑衣黑冠的道士？來過。拿一塊金牌子買的路——金子打的，比你那十兩銀子值錢多了。"

msgid "他问我瀑布后头的山洞怎么走。老子这寨子什么钱都收，收了钱就指路：往东过石桥，瀑布旁边有藤蔓，荡过去就是。"
msgstr "他問我瀑布後頭的山洞怎麼走。老子這寨子什麼錢都收，收了錢就指路：往東過石橋，瀑布旁邊有藤蔓，蕩過去就是。"

msgid "他抱着个石匣子，宝贝得很。你要找他，也往瀑布去吧，老子不拦你。"
msgstr "他抱著個石匣子，寶貝得很。你要找他，也往瀑布去吧，老子不攔你。"

msgid "你是什么东西，也敢问老子的事？"
msgstr "你是什麼東西，也敢問老子的事？"

msgid "石匣"
msgstr "石匣"

msgid "石匣？那道士抱着的那个？老子没兴趣，老子只收钱。"
msgstr "石匣？那道士抱著的那個？老子沒興趣，老子只收錢。"

msgid "老松寨是老子的寨子。进寨的规矩只有一条：什么钱都收。"
msgstr "老松寨是老子的寨子。進寨的規矩只有一條：什麼錢都收。"

msgid "这个男人看起来鬼鬼祟祟的，想必不是什么好东西。\n"
msgstr "這個男人看起來鬼鬼祟祟的，想必不是什麼好東西。\n"

msgid "哈哈哈哈哈哈。"
msgstr "哈哈哈哈哈哈。"

msgid "金银花蛇"
msgstr "金銀花蛇"

msgid "一支昂首吐信的毒蛇正虎视眈眈地盯著你。\n"
msgstr "一支昂首吐信的毒蛇正虎視眈眈地盯著你。\n"

msgid "你觉得被咬中的地方一阵麻痒！"
msgstr "你覺得被咬中的地方一陣麻癢！"

msgid "粗布衣"
msgstr "粗布衣"

msgid "蓑衣"
msgstr "蓑衣"

msgid "草鞋"
msgstr "草鞋"

msgid "铁斧"
msgstr "鐵斧"

msgid "这是一把沈重的铁斧，用来砍柴。\n"
msgstr "這是一把沈重的鐵斧，用來砍柴。\n"

msgid "铁锤"
msgstr "鐵錘"

msgid "这是一把沈重的铁锤，打造的相当坚实。\n"
msgstr "這是一把沈重的鐵錘，打造的相當堅實。\n"

msgid "功德箱"
msgstr "功德箱"

msgid "这是寺庙接受善男信女捐献香油钱的功德箱，你可以把想捐的钱\n放进去。\n"
msgstr "這是寺廟接受善男信女捐獻香油錢的功德箱，你可以把想捐的錢\n放進去。\n"

msgid "竹剑"
msgstr "竹劍"

msgid "这是一把练习剑法用的竹剑，剑尖处用布包了起来以免误伤同伴。\n"
msgstr "這是一把練習劍法用的竹劍，劍尖處用布包了起來以免誤傷同伴。\n"

msgid "粉红绸衫"
msgstr "粉紅綢衫"

msgid "这件粉红色的绸衫上面绣著几只黄鹊，闻起来还有一股淡香。\n"
msgstr "這件粉紅色的綢衫上面繡著幾隻黃鵲，聞起來還有一股淡香。\n"

msgid "绣花小鞋"
msgstr "繡花小鞋"

msgid "残破刀谱"
msgstr "殘破刀譜"

msgid "这似乎是一本什么刀谱的前几页，虽然并没有关于招式的详细解说，可是\n前面有关刀法的总纲与精义倒是不少。\n"
msgstr "這似乎是一本什麼刀譜的前幾頁，雖然並沒有關於招式的詳細解說，可是\n前面有關刀法的總綱與精義倒是不少。\n"

msgid "这是一位来雪亭镇的外地旅客.\n"
msgstr "這是一位來雪亭鎮的外地旅客.\n"

msgid "一只浑身脏兮兮的野狗。\n"
msgstr "一隻渾身髒兮兮的野狗。\n"

msgid "野狗用鼻子闻了闻你的脚。\n"
msgstr "野狗用鼻子聞了聞你的腳。\n"

msgid "野狗在你的脚边挨挨擦擦的，想讨东西吃。\n"
msgstr "野狗在你的腳邊挨挨擦擦的，想討東西吃。\n"

msgid "野狗对著你摇了摇尾巴。\n"
msgstr "野狗對著你搖了搖尾巴。\n"

msgid "野狗用后腿抓了抓自己的耳朵。\n"
msgstr "野狗用後腿抓了抓自己的耳朵。\n"

msgid "高兴地汪汪叫了起来。"
msgstr "高興地汪汪叫了起來。"

msgid "庙祝"
msgstr "廟祝"

msgid "这个老人看起来七十多岁了，看著他佝偻的身影，你忽然觉得心情沈重了下来。\n"
msgstr "這個老人看起來七十多歲了，看著他佝僂的身影，你忽然覺得心情沈重了下來。\n"

msgid "这位$RESPECT，捐点香火钱积点阴德吧。"
msgstr "這位$RESPECT，捐點香火錢積點陰德吧。"

msgid "多谢这位$RESPECT，神明一定会保佑你的。"
msgstr "多謝這位$RESPECT，神明一定會保佑你的。"

msgid "醉汉"
msgstr "醉漢"

msgid "一个喝得醉醺醺的年轻人.....\n"
msgstr "一個喝得醉醺醺的年輕人.....\n"

msgid "酒..... 给我酒...."
msgstr "酒..... 給我酒...."

msgid "去去去去去.. 我又不是收破烂的..."
msgstr "去去去去去.. 我又不是收破爛的..."

msgid "真没诚意, 剩么一点... "
msgstr "真沒誠意, 剩麼一點... "

msgid "多谢, 不过我还有酒... "
msgstr "多謝, 不過我還有酒... "

msgid "听说沈记商行有在卖蒙汗药...\n"
msgstr "聽說沈記商行有在賣蒙汗藥...\n"

msgid "嗯.. 你是想问我玉佩的事吧? 我卖给沈老板了, 那东西不吉祥...\n"
msgstr "嗯.. 你是想問我玉佩的事吧? 我賣給沈老闆了, 那東西不吉祥...\n"

msgid "多谢啦....."
msgstr "多謝啦....."

msgid "这个人不但自己收破烂，身上也穿得破烂不堪。\n"
msgstr "這個人不但自己收破爛，身上也穿得破爛不堪。\n"

msgid "收破烂的吆喝道：收～破～烂～哪～\n"
msgstr "收破爛的吆喝道：收～破～爛～哪～\n"

msgid "收破烂的嘴里嘟哝著，不知道说些什么。\n"
msgstr "收破爛的嘴裡嘟噥著，不知道說些什麼。\n"

msgid "收破烂的伸手捉住了身上的虱子，一脚踩得扁扁的。 \n"
msgstr "收破爛的伸手捉住了身上的蝨子，一腳踩得扁扁的。 \n"

msgid "$RESPECT饶命！小的这就离开！"
msgstr "$RESPECT饒命！小的這就離開！"

msgid "多谢这位$RESPECT！"
msgstr "多謝這位$RESPECT！"

msgid "门房"
msgstr "門房"

msgid "刘安禄是淳风武馆的门房，除了馆主柳淳风没有人知道他的出身来历，只知\n到他的武艺不弱，一手快刀在这一带罕有敌手。\n"
msgstr "劉安祿是淳風武館的門房，除了館主柳淳風沒有人知道他的出身來歷，只知\n到他的武藝不弱，一手快刀在這一帶罕有敵手。\n"

msgid "刘安禄说道：你当这里是什么地方，敢来这里撒野？\n"
msgstr "劉安祿說道：你當這裡是什麼地方，敢來這裡撒野？\n"

msgid "刘安禄说道：想我堂堂....呃....连我这个淳风武馆的小小的门房都可以收拾你！\n"
msgstr "劉安祿說道：想我堂堂....呃....連我這個淳風武館的小小的門房都可以收拾你！\n"

msgid "刘安禄忽然挥出一刀，招数精奇，但是刀到中途忽然像是想起什么，急忙收招。\n"
msgstr "劉安祿忽然揮出一刀，招數精奇，但是刀到中途忽然像是想起什麼，急忙收招。\n"

msgid "刘安禄说道：你快走吧，就算我输了你啦....\n"
msgstr "劉安祿說道：你快走吧，就算我輸了你啦....\n"

msgid "看见你，放下了手里的扫帚。"
msgstr "看見你，放下了手裡的掃帚。"

msgid "李教头同我说了。……那句话是你替我挡的。"
msgstr "李教頭同我說了。……那句話是你替我擋的。"

msgid "我欠你一句话。哪天你用得着野羊山的人，开口。"
msgstr "我欠你一句話。哪天你用得著野羊山的人，開口。"

msgid "背着一个青布包袱，望着往野羊山去的那条路。"
msgstr "背著一個青布包袱，望著往野羊山去的那條路。"

msgid "话是你说的。我不怨你——五年前我就该走。"
msgstr "話是你說的。我不怨你——五年前我就該走。"

msgid "馆主留我到今天，是他的情分；武馆的规矩，是老馆主的。两样都没错。"
msgstr "館主留我到今天，是他的情分；武館的規矩，是老館主的。兩樣都沒錯。"

msgid "刘老三"
msgstr "劉老三"

msgid "刘安禄的来历不简单。当面问出这个名字，是把事情挑明——他未必肯善罢甘休。要问吗？"
msgstr "劉安祿的來歷不簡單。當面問出這個名字，是把事情挑明——他未必肯善罷甘休。要問嗎？"

msgid "……老子认了，还问什么。你要问野羊寨的事，问大寨主。"
msgstr "……老子認了，還問什麼。你要問野羊寨的事，問大寨主。"

msgid "老子就是血手刘三，血手刘三就是你老子！纳命来！"
msgstr "老子就是血手劉三，血手劉三就是你老子！納命來！"

msgid "我...不知道！"
msgstr "我...不知道！"

msgid "刘安禄眼中突然放出异样的光芒，颤声说道：看来...你都知道了？"
msgstr "劉安祿眼中突然放出異樣的光芒，顫聲說道：看來...你都知道了？"

msgid "刘安禄大喝一声，叫道：既然如此，老子今天豁出去了，纳命来！"
msgstr "劉安祿大喝一聲，叫道：既然如此，老子今天豁出去了，納命來！"

msgid "刘安禄使开单刀，招数精奇，沈猛狠辣，和刚才简直判若两人！"
msgstr "劉安祿使開單刀，招數精奇，沈猛狠辣，和剛才簡直判若兩人！"

msgid "血手刘三"
msgstr "血手劉三"

msgid "大寨主"
msgstr "大寨主"

msgid "刘安禄沉默了半晌，低声道：野羊寨的大寨主霍铮，是我拜过把子的大哥。"
msgstr "劉安祿沉默了半晌，低聲道：野羊寨的大寨主霍錚，是我拜過把子的大哥。"

msgid "半年前，北麓那座黑砖道观的道士上山要人。大哥跟他们走了，再没回来。那伙人自称逆灵宫。"
msgstr "半年前，北麓那座黑磚道觀的道士上山要人。大哥跟他們走了，再沒回來。那夥人自稱逆靈宮。"

msgid "黄霸——老三——把寨子接了过去，每年给道观纳供，金帛、牲口，要什么送什么。我不肯伺候那群臭道士，就下了山。"
msgstr "黃霸——老三——把寨子接了過去，每年給道觀納供，金帛、牲口，要什麼送什麼。我不肯伺候那群臭道士，就下了山。"

msgid "纳供的车这几天就上山。到了山路转角，道士从北边山壁的裂口把东西吊上去——道观就在裂口上头。你要去，替我看一眼大哥。"
msgstr "納供的車這幾天就上山。到了山路轉角，道士從北邊山壁的裂口把東西吊上去——道觀就在裂口上頭。你要去，替我看一眼大哥。"

msgid "……大哥的事，等你知道野羊山北麓是个什么地方再说。"
msgstr "……大哥的事，等你知道野羊山北麓是個什麼地方再說。"

msgid "大寨主？我是淳风武馆的门房，哪来的什么大寨主。"
msgstr "大寨主？我是淳風武館的門房，哪來的什麼大寨主。"

msgid "野羊山寨二寨主"
msgstr "野羊山寨二寨主"

msgid "刘安禄望着北边，低声道：大哥……\n"
msgstr "劉安祿望著北邊，低聲道：大哥……\n"

msgid "刘安禄叫道：老子已经认输了，你还要怎样！\n"
msgstr "劉安祿叫道：老子已經認輸了，你還要怎樣！\n"

msgid "你看到一位身材高大的汉子，正在辛苦地操练著。\n"
msgstr "你看到一位身材高大的漢子，正在辛苦地操練著。\n"

msgid "拳法教练"
msgstr "拳法教練"

msgid "李火狮是个孔武有力的大块头，他正在训练他的弟子们习练「柳家拳\n法」。\n"
msgstr "李火獅是個孔武有力的大塊頭，他正在訓練他的弟子們習練「柳家拳\n法」。\n"

msgid "这里当然是淳风武馆，不然还是哪里？\n"
msgstr "這裡當然是淳風武館，不然還是哪裡？\n"

msgid "在下姓李，名字就叫火狮，人称李教头的便是我。\n"
msgstr "在下姓李，名字就叫火獅，人稱李教頭的便是我。\n"

msgid "柳家拳法"
msgstr "柳家拳法"

msgid "哦....说来惭愧，小弟这套拳法还没学得到家, 柳馆主就教我在这里传艺。\n"
msgstr "哦....說來慚愧，小弟這套拳法還沒學得到家, 柳館主就教我在這裡傳藝。\n"

msgid "话是你说的，馆主也认了。老刘回了野羊山——这扇门，他不会再进了。"
msgstr "話是你說的，館主也認了。老劉回了野羊山——這扇門，他不會再進了。"

msgid "话是你说的，馆主也认了。武馆的规矩，谁也不能例外。……老刘走的时候，把门房的钥匙擦得干干净净。"
msgstr "話是你說的，館主也認了。武館的規矩，誰也不能例外。……老劉走的時候，把門房的鑰匙擦得乾乾淨淨。"

msgid "你说认错了人，我就当是认错了人。弟子们那边，我去压。"
msgstr "你說認錯了人，我就當是認錯了人。弟子們那邊，我去壓。"

msgid "老刘前些日子不辞而别，门房的桌子空着。偏偏那几个骗子又在镇上嚷，说他是野羊山的二寨主。"
msgstr "老劉前些日子不辭而別，門房的桌子空著。偏偏那幾個騙子又在鎮上嚷，說他是野羊山的二寨主。"

msgid "弟子们都在猜。有人说该报官，有人说该上野羊山问个明白。"
msgstr "弟子們都在猜。有人說該報官，有人說該上野羊山問個明白。"

msgid "馆主不开口。骗子是你打发的——老刘到底是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr "館主不開口。騙子是你打發的——老劉到底是什麼人，你給大夥一句話：說破，還是替他瞞下來。"

msgid "那天你和老刘在门口动了刀，弟子们都看见了——那套刀法，不是一个门房使得出来的。"
msgstr "那天你和老劉在門口動了刀，弟子們都看見了——那套刀法，不是一個門房使得出來的。"

msgid "偏偏那几个骗子又在镇上嚷，说他是野羊山的血手刘三。"
msgstr "偏偏那幾個騙子又在鎮上嚷，說他是野羊山的血手劉三。"

msgid "馆主不开口。你和他交过手，你最清楚——他是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr "館主不開口。你和他交過手，你最清楚——他是什麼人，你給大夥一句話：說破，還是替他瞞下來。"

msgid "那几个骗子在镇上嚷，说咱们门房老刘是野羊山的二寨主，叫什么血手刘三。"
msgstr "那幾個騙子在鎮上嚷，說咱們門房老劉是野羊山的二寨主，叫什麼血手劉三。"

msgid "老刘在武馆五年，扫地、守门、记账，没出过一回错。可弟子们听见了，就得有个说法：武馆不留匪，这是老馆主立的规矩。"
msgstr "老劉在武館五年，掃地、守門、記賬，沒出過一回錯。可弟子們聽見了，就得有個說法：武館不留匪，這是老館主立的規矩。"

msgid "馆主不开口。骗子是你打发的，话是你听见的——他是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr "館主不開口。騙子是你打發的，話是你聽見的——他是什麼人，你給大夥一句話：說破，還是替他瞞下來。"

msgid "门房老刘？在武馆五年了，话不多，人勤快。"
msgstr "門房老劉？在武館五年了，話不多，人勤快。"

msgid "说破门房的来历"
msgstr "說破門房的來歷"

msgid "告诉李火狮：门房刘安禄就是野羊山的血手刘三。\n武馆不留匪——这句话出口，武馆从此没有他的位置，弟子们会记得是你说的。\n要说破吗？"
msgstr "告訴李火獅：門房劉安祿就是野羊山的血手劉三。\n武館不留匪——這句話出口，武館從此沒有他的位置，弟子們會記得是你說的。\n要說破嗎？"

msgid "你已经说过了。"
msgstr "你已經說過了。"

msgid "你前头说的是认错了人。话出了口，就别改了。"
msgstr "你前頭說的是認錯了人。話出了口，就別改了。"

msgid "的脸沉了下来。"
msgstr "的臉沉了下來。"

msgid "……血手刘三。五年，我天天和他一张桌子吃饭。"
msgstr "……血手劉三。五年，我天天和他一張桌子吃飯。"

msgid "规矩是老馆主立的，我去回馆主。你做得对——只是往后弟子们看你，眼神会不一样。"
msgstr "規矩是老館主立的，我去回館主。你做得對——只是往後弟子們看你，眼神會不一樣。"

msgid "说破什么？"
msgstr "說破什麼？"

msgid "替门房瞒下来"
msgstr "替門房瞞下來"

msgid "告诉李火狮：那伙骗子认错了人。\n武馆里没人再提这件事，刘安禄欠你一句话；可这句话从此算在你头上，日后再有人认出他，弟子们先问的是你。\n要替他瞒吗？"
msgstr "告訴李火獅：那夥騙子認錯了人。\n武館裡沒人再提這件事，劉安祿欠你一句話；可這句話從此算在你頭上，日後再有人認出他，弟子們先問的是你。\n要替他瞞嗎？"

msgid "认错了人。我已经同弟子们说过了。"
msgstr "認錯了人。我已經同弟子們說過了。"

msgid "话已经出了口，瞒不回去了。"
msgstr "話已經出了口，瞞不回去了。"

msgid "盯着你看了一会儿，慢慢点了点头。"
msgstr "盯著你看了一會兒，慢慢點了點頭。"

msgid "认错了人。好，我就这么同弟子们说。"
msgstr "認錯了人。好，我就這麼同弟子們說。"

msgid "你担着这句话，就担到底。"
msgstr "你擔著這句話，就擔到底。"

msgid "瞒什么？"
msgstr "瞞什麼？"

msgid "点了点头。"
msgstr "點了點頭。"

msgid "进招吧。"
msgstr "進招吧。"

msgid "馆主吩咐过，不许和来这里的客人过招。"
msgstr "館主吩咐過，不許和來這裡的客人過招。"

msgid "对不起，这位$RESPECT，您不是我们武馆的弟子。"
msgstr "對不起，這位$RESPECT，您不是我們武館的弟子。"

msgid "李火狮不愿意教你拳法。"
msgstr "李火獅不願意教你拳法。"

msgid "你看到一位面色黝黑的农夫。\n"
msgstr "你看到一位面色黝黑的農夫。\n"

msgid "农夫叫道：杀人哪！杀人哪！\n"
msgstr "農夫叫道：殺人哪！殺人哪！\n"

msgid "农夫叫道：有土匪哪！光天化日下打劫哪！\n"
msgstr "農夫叫道：有土匪哪！光天化日下打劫哪！\n"

msgid "一只浑身脏兮兮的野狗，一双眼睛正恶狠狠地瞪著你。\n"
msgstr "一隻渾身髒兮兮的野狗，一雙眼睛正惡狠狠地瞪著你。\n"

msgid "教书先生"
msgstr "教書先生"

msgid "魏无极是个博学多闻的教书先生，他年轻时曾经中过举人，但是\n因为生性喜爱自由而不愿做官，魏无极以教书为业，如果你付他\n一笔学费，就可以成为他的弟子学习读书识字。\n"
msgstr "魏無極是個博學多聞的教書先生，他年輕時曾經中過舉人，但是\n因為生性喜愛自由而不願做官，魏無極以教書為業，如果你付他\n一筆學費，就可以成為他的弟子學習讀書識字。\n"

msgid "学费"
msgstr "學費"

msgid "嗯 ... 读书识字是做人的第一步。"
msgstr "嗯 ... 讀書識字是做人的第一步。"

msgid "学好了读书识字的本领，胜过于百万的家财。"
msgstr "學好了讀書識字的本領，勝過於百萬的家財。"

msgid "所以说学问是金钱买不到的。"
msgstr "所以說學問是金錢買不到的。"

msgid "虽然学问是无价的，不过如果你有心的话 ..."
msgstr "雖然學問是無價的，不過如果你有心的話 ..."

msgid "只要五两银子。"
msgstr "只要五兩銀子。"

msgid "手头紧？街东头的谷场正缺短工，干一回给一两。"
msgstr "手頭緊？街東頭的穀場正缺短工，幹一回給一兩。"

msgid "对，读书识字。"
msgstr "對，讀書識字。"

msgid "哦 ... 你是说野羊山寨的二寨主，人称血手刘三的刘安禄吗？"
msgstr "哦 ... 你是說野羊山寨的二寨主，人稱血手劉三的劉安祿嗎？"

msgid "他又出来做恶了？"
msgstr "他又出來做惡了？"

msgid "你带我去见他，让我跟他说几句话。"
msgstr "你帶我去見他，讓我跟他說幾句話。"

msgid "点了点头，说道：哦，向你这么有心的学生还真是不多见，好好努力将来必定前途无量，谢了。"
msgstr "點了點頭，說道：哦，向你這麼有心的學生還真是不多見，好好努力將來必定前途無量，謝了。"

msgid "点了点头，说道：很好，从今天起你随时可以来问我有关读书识字的任何问题。"
msgstr "點了點頭，說道：很好，從今天起你隨時可以來問我有關讀書識字的任何問題。"

msgid "你的诚意不够，这钱还是拿回去吧。"
msgstr "你的誠意不夠，這錢還是拿回去吧。"

msgid "咦？我不记得收过你这个学生啊...."
msgstr "咦？我不記得收過你這個學生啊...."

msgid "你看到一个粗壮的大汉，身上穿著普通樵夫的衣服。\n"
msgstr "你看到一個粗壯的大漢，身上穿著普通樵夫的衣服。\n"

msgid "樵夫说道：野羊山那群臭道士真是该千刀万剐....\n"
msgstr "樵夫說道：野羊山那群臭道士真是該千刀萬剮....\n"

msgid "樵夫说道：不知道那些牛鼻子施了什么妖法，前天回家差点迷了路。\n"
msgstr "樵夫說道：不知道那些牛鼻子施了什麼妖法，前天回家差點迷了路。\n"

msgid "樵夫说道：唉....日子越来越不好过罗。\n"
msgstr "樵夫說道：唉....日子越來越不好過羅。\n"

msgid "雪亭驿长"
msgstr "雪亭驛長"

msgid "杜宽担任雪亭驿的驿长已经有十几年了，虽然期间有几次升迁的\n机会，但是他都因为舍不得离开这个小山村而放弃了，雪亭镇的\n居民对杜宽的风评相当不错，常常会来到驿站跟他聊天。\n"
msgstr "杜寬擔任雪亭驛的驛長已經有十幾年了，雖然期間有幾次升遷的\n機會，但是他都因為捨不得離開這個小山村而放棄了，雪亭鎮的\n居民對杜寬的風評相當不錯，常常會來到驛站跟他聊天。\n"

msgid "驿站"
msgstr "驛站"

msgid "是啊... 这里就是雪亭驿，你要寄信吗？"
msgstr "是啊... 這裡就是雪亭驛，你要寄信嗎？"

msgid "官府的信差都改走飞鸢栈道了，咱这儿如今只剩百姓的信。"
msgstr "官府的信差都改走飛鳶棧道了，咱這兒如今只剩百姓的信。"

msgid "送信"
msgstr "送信"

msgid "往后有信，还找你。"
msgstr "往後有信，還找你。"

msgid "送到了？好，说好的脚钱。往后有信，还找你。"
msgstr "送到了？好，說好的腳錢。往後有信，還找你。"

msgid "信丢了？……还好驿里留着底子，我再誊一封。这回别再弄丢了，陈镖头的镖局就在绮云镇街上。"
msgstr "信丟了？……還好驛裡留著底子，我再謄一封。這回別再弄丟了，陳鏢頭的鏢局就在綺雲鎮街上。"

msgid "信送到了么？陈镖头的镖局就在绮云镇街上。"
msgstr "信送到了麼？陳鏢頭的鏢局就在綺雲鎮街上。"

msgid "正好有封信，要送到绮云镇振远镖局陈镖头手里。驿里就我一个走不开——你若肯跑这一趟，回来给你一两脚钱。出镇往南过卧龙岗，岗上有强人，别跟他们纠缠，走你的路就是。"
msgstr "正好有封信，要送到綺雲鎮振遠鏢局陳鏢頭手裡。驛裡就我一個走不開——你若肯跑這一趟，回來給你一兩腳錢。出鎮往南過臥龍崗，崗上有強人，別跟他們糾纏，走你的路就是。"

msgid "悬赏"
msgstr "懸賞"

msgid "门外那张榜是乔阴府发的悬赏。榜上的恶人要是教你拿住了，赏银照榜发——拿不住也别逞强。"
msgstr "門外那張榜是喬陰府發的懸賞。榜上的惡人要是教你拿住了，賞銀照榜發——拿不住也別逞強。"

msgid "老鼠"
msgstr "老鼠"

msgid "一只贼头贼脑的大老鼠。\n"
msgstr "一隻賊頭賊腦的大老鼠。\n"

msgid "店小二"
msgstr "店小二"

msgid "这位店小二正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n"
msgstr "這位店小二正笑咪咪地忙著，還不時拿起掛在脖子上的抹布擦臉。\n"

msgid "小二哥"
msgstr "小二哥"

msgid "笑咪咪地说道：这位$RESPECT，进来喝杯茶，歇歇腿吧。"
msgstr "笑咪咪地說道：這位$RESPECT，進來喝杯茶，歇歇腿吧。"

msgid "用脖子上的毛巾抹了抹手，说道：这位$RESPECT，请进请进。"
msgstr "用脖子上的毛巾抹了抹手，說道：這位$RESPECT，請進請進。"

msgid "这位$RESPECT，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。"
msgstr "這位$RESPECT，進來喝幾盅小店的紅酒吧，這幾天才從窖子裡開封的喲。"

msgid "鸡腿骨头别扔，东街那两条野狗见了骨头就跟人走，怪得很。"
msgstr "雞腿骨頭別扔，東街那兩條野狗見了骨頭就跟人走，怪得很。"

msgid "哟，可算清净了！来，刚烤好的鸡腿，小店的一点心意。"
msgstr "喲，可算清淨了！來，剛烤好的雞腿，小店的一點心意。"

msgid "唉，别提了。楼上几间客房闹老鼠，客人嫌吵，掌柜的又舍不得请人。这位$RESPECT要是肯上去收拾收拾，小店请您吃顿热的。"
msgstr "唉，別提了。樓上幾間客房鬧老鼠，客人嫌吵，掌櫃的又捨不得請人。這位$RESPECT要是肯上去收拾收拾，小店請您吃頓熱的。"

msgid "楼上"
msgstr "樓上"

msgid "白衣人"
msgstr "白衣人"

msgid "多亏了您！……他们把您楼上那屋翻了个底朝天，问那只匣子问了三遍，小的说不知道。"
msgstr "多虧了您！……他們把您樓上那屋翻了個底朝天，問那隻匣子問了三遍，小的說不知道。"

msgid "掌柜的说了：楼上那间屋给您留着，往后不收钱。您是咱们雪亭的人。"
msgstr "掌櫃的說了：樓上那間屋給您留著，往後不收錢。您是咱們雪亭的人。"

msgid "捂着青了半边的脸，压低了声音。"
msgstr "捂著青了半邊的臉，壓低了聲音。"

msgid "两个白衣的官爷，拿着一张画像，说您是什么逆灵宫的同党……就在里头翻呢！掌柜的拦了一下，挨了一脚。"
msgstr "兩個白衣的官爺，拿著一張畫像，說您是什麼逆靈宮的同黨……就在裡頭翻呢！掌櫃的攔了一下，挨了一腳。"

msgid "白衣人？前些日子广场上那队官爷，都是穿白的。"
msgstr "白衣人？前些日子廣場上那隊官爺，都是穿白的。"

msgid "官爷"
msgstr "官爺"

msgid "外头广场上来了官爷，一队白衣的武官，还有两位老者坐着，说是大内来的高手。这位$RESPECT要是闲，去瞧瞧热闹也好。"
msgstr "外頭廣場上來了官爺，一隊白衣的武官，還有兩位老者坐著，說是大內來的高手。這位$RESPECT要是閒，去瞧瞧熱鬧也好。"

msgid "小哥您有所不知，这些个爷儿们是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的。他们等的白道长，便是咱们这附近有名的太乙观观主。"
msgstr "小哥您有所不知，這些個爺兒們是奉了咱們皇上的命令，要去嵐城找一把叫做什麼『旋芒寶劍』的。他們等的白道長，便是咱們這附近有名的太乙觀觀主。"

msgid "$RESPECT，您来的那天傍晚说是来投淳风武馆的，饭没吃完就困得睁不开眼，是小的扶您上的楼。这封信落在桌上了，小的一直替您收着呢。"
msgstr "$RESPECT，您來的那天傍晚說是來投淳風武館的，飯沒吃完就困得睜不開眼，是小的扶您上的樓。這封信落在桌上了，小的一直替您收著呢。"

msgid "从柜台底下摸出一封折了又折的信，递给你。"
msgstr "從櫃檯底下摸出一封折了又折的信，遞給你。"

msgid "对了，外头广场上来了官爷，一队白衣的武官，还有两位老者坐着，说是大内来的高手。$RESPECT要是闲，去瞧瞧热闹也好。"
msgstr "對了，外頭廣場上來了官爺，一隊白衣的武官，還有兩位老者坐著，說是大內來的高手。$RESPECT要是閒，去瞧瞧熱鬧也好。"

msgid "这些个爷儿们是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的。他们等的白道长，便是咱们这附近有名的太乙观观主。"
msgstr "這些個爺兒們是奉了咱們皇上的命令，要去嵐城找一把叫做什麼『旋芒寶劍』的。他們等的白道長，便是咱們這附近有名的太乙觀觀主。"

msgid "请柬"
msgstr "請柬"

msgid "请柬早给您了。正月十七，水烟阁外头的虹台——您可别忘了。"
msgstr "請柬早給您了。正月十七，水煙閣外頭的虹臺——您可別忘了。"

msgid "哟，您可回来了！前两天水烟阁差人送来一张帖子，指名道姓给您的。"
msgstr "喲，您可回來了！前兩天水煙閣差人送來一張帖子，指名道姓給您的。"

msgid "从柜台底下摸出一张大红帖子，在围裙上擦了擦手，双手递给你。"
msgstr "從櫃檯底下摸出一張大紅帖子，在圍裙上擦了擦手，雙手遞給你。"

msgid "请柬？没有您的信啊。"
msgstr "請柬？沒有您的信啊。"

msgid "看见你进门，眼睛一亮，从柜台后头钻了出来。"
msgstr "看見你進門，眼睛一亮，從櫃檯後頭鑽了出來。"

msgid "$RESPECT，您可回来了！前两天水烟阁差人送来一张帖子，指名道姓给您的。"
msgstr "$RESPECT，您可回來了！前兩天水煙閣差人送來一張帖子，指名道姓給您的。"

msgid "正月十七，水烟阁外头的虹台，九派选盟主——小的长这么大，还没见过咱们雪亭的人拿这种帖子。"
msgstr "正月十七，水煙閣外頭的虹臺，九派選盟主——小的長這麼大，還沒見過咱們雪亭的人拿這種帖子。"

msgid "钱庄老板"
msgstr "錢莊老闆"

msgid "安惜迩是个看起来相当斯文的年轻人，不过有时候会有些心不在焉的\n样子，雪亭镇的居民对安惜迩都觉得有点神秘莫测的感觉，为什么他\n年纪轻轻就身为一家大钱庄的老板，还有他一身稀奇古怪的武功，所\n幸安惜迩似乎天性恬淡，甚至有些隐者的风骨，只要旁人不去惹他，\n他也绝不会去招惹旁人。\n"
msgstr "安惜邇是個看起來相當斯文的年輕人，不過有時候會有些心不在焉的\n樣子，雪亭鎮的居民對安惜邇都覺得有點神秘莫測的感覺，為什麼他\n年紀輕輕就身為一家大錢莊的老闆，還有他一身稀奇古怪的武功，所\n幸安惜邇似乎天性恬淡，甚至有些隱者的風骨，只要旁人不去惹他，\n他也絕不會去招惹旁人。\n"

msgid "安惜迩似笑非笑地望著你，脸上的神气古理古怪，不知道在想些什么？\n"
msgstr "安惜邇似笑非笑地望著你，臉上的神氣古理古怪，不知道在想些什麼？\n"

msgid "安惜迩的身影晃了一下，似乎在你身上各处大穴摸了一下，不过也许是你的错觉。\n"
msgstr "安惜邇的身影晃了一下，似乎在你身上各處大穴摸了一下，不過也許是你的錯覺。\n"

msgid "安惜迩神情忽然严肃了起来，不过好像是在想自己的事，与你无关。\n"
msgstr "安惜邇神情忽然嚴肅了起來，不過好像是在想自己的事，與你無關。\n"

msgid "安惜迩忽然呵呵呵地笑了起来，却不知道在笑些什么....\n"
msgstr "安惜邇忽然呵呵呵地笑了起來，卻不知道在笑些什麼....\n"

msgid "咦... 要打就真打吧，光是较量多没意思？"
msgstr "咦... 要打就真打吧，光是較量多沒意思？"

msgid "王铁匠正用铁钳夹住一块红热的铁块放进炉中。\n"
msgstr "王鐵匠正用鐵鉗夾住一塊紅熱的鐵塊放進爐中。\n"

msgid "小人姓王，单名一个恒字，可是小人西瓜大的字识不到一担，只有王字会写。\n"
msgstr "小人姓王，單名一個恆字，可是小人西瓜大的字識不到一擔，只有王字會寫。\n"

msgid "这里是小人糊口的铺子，小人一家五口都住在后边的屋子。\n"
msgstr "這裡是小人餬口的鋪子，小人一家五口都住在後邊的屋子。\n"

msgid "锄头"
msgstr "鋤頭"

msgid "锄头... 抱歉，锄头已经卖光了...\n"
msgstr "鋤頭... 抱歉，鋤頭已經賣光了...\n"

msgid "铲子"
msgstr "鏟子"

msgid "对不起，小人店里的铲子都给人订走了。\n"
msgstr "對不起，小人店裡的鏟子都給人訂走了。\n"

msgid "铁锤？小人做的铁锤坚固又耐用，一把只要三百文钱。\n"
msgstr "鐵錘？小人做的鐵錘堅固又耐用，一把只要三百文錢。\n"

msgid "杨掌柜"
msgstr "楊掌櫃"

msgid "杨掌柜是这附近相当有名的大善人，常常施舍草药给付不起药钱的穷人\n。此外他的医术也不错，年轻时曾经跟著山烟寺的玄智和尚学医，一般\n的伤寒小病直接问他开药吃比医生还灵。\n"
msgstr "楊掌櫃是這附近相當有名的大善人，常常施捨草藥給付不起藥錢的窮人\n。此外他的醫術也不錯，年輕時曾經跟著山煙寺的玄智和尚學醫，一般\n的傷寒小病直接問他開藥吃比醫生還靈。\n"

msgid "治伤"
msgstr "治傷"

msgid "这位$RESPECT，您看起来气色很好啊，不像有受伤的样子。"
msgstr "這位$RESPECT，您看起來氣色很好啊，不像有受傷的樣子。"

msgid "哦....我看看....只是些皮肉小伤，您买包金创药回去敷敷就没事了。"
msgstr "哦....我看看....只是些皮肉小傷，您買包金創藥回去敷敷就沒事了。"

msgid "开药"
msgstr "開藥"

msgid "麝香给你了。替我问玄智师父好。"
msgstr "麝香給你了。替我問玄智師父好。"

msgid "玄智师父开的方子？我看看——附子、麝香、鬼臼。"
msgstr "玄智師父開的方子？我看看——附子、麝香、鬼臼。"

msgid "脸色沉了下来。"
msgstr "臉色沉了下來。"

msgid "鬼臼以毒攻毒……这是阴寒入骨的方子。乔阴那边，又不太平了？"
msgstr "鬼臼以毒攻毒……這是陰寒入骨的方子。喬陰那邊，又不太平了？"

msgid "从药柜最上头一格取下一个小罐，用桑皮纸包了一小包，递给你。"
msgstr "從藥櫃最上頭一格取下一個小罐，用桑皮紙包了一小包，遞給你。"

msgid "师父要的东西，不收钱。我年轻时跟着他学医三年，他教的头一句：药是凉的，人心得是热的。"
msgstr "師父要的東西，不收錢。我年輕時跟著他學醫三年，他教的頭一句：藥是涼的，人心得是熱的。"

msgid "山烟寺？我年轻时曾经跟著山烟寺的玄智和尚学医。玄智师父的医术，天底下没几个人比得上。"
msgstr "山煙寺？我年輕時曾經跟著山煙寺的玄智和尚學醫。玄智師父的醫術，天底下沒幾個人比得上。"

msgid "柳绘心是淳风武馆馆主柳淳风的独生女。\n"
msgstr "柳繪心是淳風武館館主柳淳風的獨生女。\n"

msgid "柳绘心秀眉微蹙，说道：喂！我哪里得罪你了？干嘛这样跟我拼死拼活？\n"
msgstr "柳繪心秀眉微蹙，說道：喂！我哪裡得罪你了？幹嘛這樣跟我拼死拼活？\n"

msgid "柳绘心不住地望著窗外：你还是快走吧，我没空陪你练功夫！\n"
msgstr "柳繪心不住地望著窗外：你還是快走吧，我沒空陪你練功夫！\n"

msgid "我每天夜里读一页。爹爹年轻的时候，字写得比现在放得开。"
msgstr "我每天夜裡讀一頁。爹爹年輕的時候，字寫得比現在放得開。"

msgid "爹爹把它锁起来了，是不是？……他什么都锁起来。"
msgstr "爹爹把它鎖起來了，是不是？……他什麼都鎖起來。"

msgid "爹爹在天驼关写过一卷书，我只听李教头提过一句。他从来不让我看。"
msgstr "爹爹在天駝關寫過一卷書，我只聽李教頭提過一句。他從來不讓我看。"

msgid "北宗"
msgstr "北宗"

msgid "跟柳绘心立北宗：封山的剑往外传。\n你转入封山剑派北宗，和她同辈；她把自己悟出来的「点」字诀教给你。柳淳风不再教你武功，「掌门传人」的名分没有了。这不算叛师：评价不清零，也不记背叛。封山在虹台上的那一票，会被颜违拿「给北宗一个座」来换（已经入了虹台的席的，这一票不再跟着变）。\n这是封山这条线的大分裂，选了不能改。要跟她吗？"
msgstr "跟柳繪心立北宗：封山的劍往外傳。\n你轉入封山劍派北宗，和她同輩；她把自己悟出來的「點」字訣教給你。柳淳風不再教你武功，「掌門傳人」的名分沒有了。這不算叛師：評價不清零，也不記背叛。封山在虹臺上的那一票，會被顏違拿「給北宗一個座」來換（已經入了虹臺的席的，這一票不再跟著變）。\n這是封山這條線的大分裂，選了不能改。要跟她嗎？"

msgid "北宗现在有两个人了。"
msgstr "北宗現在有兩個人了。"

msgid "你选了爹爹那一边。我不怪你。"
msgstr "你選了爹爹那一邊。我不怪你。"

msgid "的眼圈红了一下，很快又忍了回去。"
msgstr "的眼圈紅了一下，很快又忍了回去。"

msgid "那北宗就有两个人了。"
msgstr "那北宗就有兩個人了。"

msgid "「点」字诀爹爹没教过我，是我自己看他练剑悟的：劲不在手臂上，在剑尖上。你看——"
msgstr "「點」字訣爹爹沒教過我，是我自己看他練劍悟的：勁不在手臂上，在劍尖上。你看——"

msgid "的细剑平平递出，剑尖在廊柱上一点，柱子背面迸出一小块木屑。"
msgstr "的細劍平平遞出，劍尖在廊柱上一點，柱子背面迸出一小塊木屑。"

msgid "内力不够的时候别使，剑会脱手。我脱过好几回。"
msgstr "內力不夠的時候別使，劍會脫手。我脫過好幾回。"

msgid "爹爹不会再教你了。对不起。……可是阿桂他们，往后也算你的师弟师妹。"
msgstr "爹爹不會再教你了。對不起。……可是阿桂他們，往後也算你的師弟師妹。"

msgid "北宗？绮云镇口的公告上还这么写呢。爹爹说那是旧名。"
msgstr "北宗？綺雲鎮口的公告上還這麼寫呢。爹爹說那是舊名。"

msgid "劲不在手臂上，在剑尖上。内力不够别使，剑会脱手。"
msgstr "勁不在手臂上，在劍尖上。內力不夠別使，劍會脫手。"

msgid "爹爹练剑的时候，我在窗后头看过。"
msgstr "爹爹練劍的時候，我在窗後頭看過。"

msgid "正月十七的事过去了。北宗的剑，照旧教人。"
msgstr "正月十七的事過去了。北宗的劍，照舊教人。"

msgid "北宗这一票，正月十七照你说的投。"
msgstr "北宗這一票，正月十七照你說的投。"

msgid "颜违许了北宗一个座。北宗能在虹台上坐下来，是你陪我走出来的——这一票投颜违，是说好了的。"
msgstr "顏違許了北宗一個座。北宗能在虹臺上坐下來，是你陪我走出來的——這一票投顏違，是說好了的。"

msgid "把剑在膝上横过来，想了想。"
msgstr "把劍在膝上橫過來，想了想。"

msgid "可你要是想自己站出来，这一票我给你。"
msgstr "可你要是想自己站出來，這一票我給你。"

msgid "虹台？那是爹爹的事。"
msgstr "虹臺？那是爹爹的事。"

msgid "请柳绘心把北宗这一票交给你：正月十七虹台上，封山的座听你的——颜违许的那个座还是北宗的，这一票不再投他。\n要这么说吗？"
msgstr "請柳繪心把北宗這一票交給你：正月十七虹臺上，封山的座聽你的——顏違許的那個座還是北宗的，這一票不再投他。\n要這麼說嗎？"

msgid "封山那一票在爹爹手里。你去问他。"
msgstr "封山那一票在爹爹手裡。你去問他。"

msgid "说过了。北宗听你的。"
msgstr "說過了。北宗聽你的。"

msgid "笑了一下。"
msgstr "笑了一下。"

msgid "好。北宗的座，听你的。"
msgstr "好。北宗的座，聽你的。"

msgid "这是爹爹收起来的那一卷……你从哪里拿来的？还回去吧。"
msgstr "這是爹爹收起來的那一卷……你從哪裡拿來的？還回去吧。"

msgid "把《悟疾风劲竹书》交给柳绘心。\n她会头一回读到父亲年轻时写的字。书只有这一本，给出去就读不到了；柳淳风不会再见到它。\n要交给她吗？"
msgstr "把《悟疾風勁竹書》交給柳繪心。\n她會頭一回讀到父親年輕時寫的字。書只有這一本，給出去就讀不到了；柳淳風不會再見到它。\n要交給她嗎？"

msgid "接过书，翻开第一页，手停住了。"
msgstr "接過書，翻開第一頁，手停住了。"

msgid "「直竹贵地生，风吹动不止」……这是爹爹的字。他从来没给我看过。"
msgstr "「直竹貴地生，風吹動不止」……這是爹爹的字。他從來沒給我看過。"

msgid "「起迄中空立，随风飘不定」——原来他年轻的时候，也想过剑可以是弯的。"
msgstr "「起迄中空立，隨風飄不定」——原來他年輕的時候，也想過劍可以是彎的。"

msgid "把书抱在怀里。"
msgstr "把書抱在懷裡。"

msgid "你……过两日到内院来。我给你看一样东西。别告诉爹爹。"
msgstr "你……過兩日到內院來。我給你看一樣東西。別告訴爹爹。"

msgid "这上头是……爹爹的名字？你先去见过爹爹再说吧。"
msgstr "這上頭是……爹爹的名字？你先去見過爹爹再說吧。"

msgid "北宗就我们两个人，打坏了谁教阿桂他们？"
msgstr "北宗就我們兩個人，打壞了誰教阿桂他們？"

msgid "师姐！别整天想著练功嘛，我们去花园摘花儿玩嘛？"
msgstr "師姐！別整天想著練功嘛，我們去花園摘花兒玩嘛？"

msgid "我才不要，你们去找李教头练吧！"
msgstr "我才不要，你們去找李教頭練吧！"

msgid "爹爹说过，不能跟你们这些江湖人物比武过招。"
msgstr "爹爹說過，不能跟你們這些江湖人物比武過招。"

msgid "一个满脸风霜之色的老乞丐。\n"
msgstr "一個滿臉風霜之色的老乞丐。\n"

msgid "乞丐说道：好心的大爷哪～ 赏我要饭的几文钱吧～\n"
msgstr "乞丐說道：好心的大爺哪～ 賞我要飯的幾文錢吧～\n"

msgid "乞丐懒洋洋地打了个哈欠。\n"
msgstr "乞丐懶洋洋地打了個哈欠。\n"

msgid "乞丐伸手捉住了身上的虱子，骂道：老子身上没几两肉，全叫你们给咬糜了。 \n"
msgstr "乞丐伸手捉住了身上的蝨子，罵道：老子身上沒幾兩肉，全叫你們給咬糜了。 \n"

msgid "多谢这位$RESPECT，您好心一定会有好报的！"
msgstr "多謝這位$RESPECT，您好心一定會有好報的！"

msgid "逄义是封山派中和柳淳风同辈的弟子，但是生性好赌的他并不受师父\n及同门师兄弟的喜爱，因此辈分虽高，却未曾担任门中任何重要职务\n。逄义经常外出，美其名曰：旅行，实则避债，碍于门规又不敢做那\n打家劫舍的勾当，因此经常四处寻找赚钱发财的机会。\n"
msgstr "逄義是封山派中和柳淳風同輩的弟子，但是生性好賭的他並不受師父\n及同門師兄弟的喜愛，因此輩分雖高，卻未曾擔任門中任何重要職務\n。逄義經常外出，美其名曰：旅行，實則避債，礙於門規又不敢做那\n打家劫舍的勾當，因此經常四處尋找賺錢發財的機會。\n"

msgid "赚钱"
msgstr "賺錢"

msgid "真的？哪里有钱赚？"
msgstr "真的？哪裡有錢賺？"

msgid "发财"
msgstr "發財"

msgid "发财我倒不敢想，只要有人肯雇用我，手边有几百两银子就好了。"
msgstr "發財我倒不敢想，只要有人肯僱用我，手邊有幾百兩銀子就好了。"

msgid "是的，一天一百两银子，只要不违背侠义道，我可以做任何事。"
msgstr "是的，一天一百兩銀子，只要不違背俠義道，我可以做任何事。"

msgid "柳淳风是在下同门师兄。"
msgstr "柳淳風是在下同門師兄。"

msgid "阁下如果也爱好此道，不如改天兄弟陪阁下玩几手？"
msgstr "閣下如果也愛好此道，不如改天兄弟陪閣下玩幾手？"

msgid "牌你带回去交给师兄。我没脸拿。"
msgstr "牌你帶回去交給師兄。我沒臉拿。"

msgid "手里的骰子掉在了桌上。"
msgstr "手裡的骰子掉在了桌上。"

msgid "……是我的牌。"
msgstr "……是我的牌。"

msgid "上个月手气背，欠了场子里一个姓罗的十二两。他不要银子，只要这块牌，说是拿去「挂两天」。我当他要个彩头。"
msgstr "上個月手氣背，欠了場子裡一個姓羅的十二兩。他不要銀子，只要這塊牌，說是拿去「掛兩天」。我當他要個彩頭。"

msgid "他拿去雪亭收拜师钱？打的是师兄的旗号？"
msgstr "他拿去雪亭收拜師錢？打的是師兄的旗號？"

msgid "半天没说话，把面前剩的几个筹码推开了。"
msgstr "半天沒說話，把面前剩的幾個籌碼推開了。"

msgid "门规我没犯过——不偷不抢，不打家劫舍。可牌是我押出去的，这一条赖不掉。你带回去交给师兄，就说逄义认了。"
msgstr "門規我沒犯過——不偷不搶，不打家劫舍。可牌是我押出去的，這一條賴不掉。你帶回去交給師兄，就說逄義認了。"

msgid "什么腰牌？在下的腰牌好好地……"
msgstr "什麼腰牌？在下的腰牌好好地……"

msgid "摸了摸腰间，没有说下去。"
msgstr "摸了摸腰間，沒有說下去。"

msgid "你现在正站在雪亭镇南边的一家小客栈里，这家客栈虽小，却是方圆\n五百里内最负盛名的一家，客栈的主人据说是一位云游四海的仙人，如果\n你的福缘深厚的话，也许可以在这里遇到他。除此之外，来自各地的旅人\n都喜欢聚集在这里交换旅途上的见闻，你也可以在这里打听到许多有趣的\n消息。靠近门口的地方有一块乌木雕成的招牌。\n西北边有一个红木门，门上泛著一层白色的光晕，一种令人感觉\n很有力量，又很柔和的光芒。\n"
msgstr "你現在正站在雪亭鎮南邊的一家小客棧裡，這家客棧雖小，卻是方圓\n五百里內最負盛名的一家，客棧的主人據說是一位雲遊四海的仙人，如果\n你的福緣深厚的話，也許可以在這裡遇到他。除此之外，來自各地的旅人\n都喜歡聚集在這裡交換旅途上的見聞，你也可以在這裡打聽到許多有趣的\n消息。靠近門口的地方有一塊烏木雕成的招牌。\n西北邊有一個紅木門，門上泛著一層白色的光暈，一種令人感覺\n很有力量，又很柔和的光芒。\n"

msgid "这里是雪亭镇镇前广场的空地，地上整齐地铺著大石板。广场中央有\n一个木头搭的架子，经过多年的风吹日晒雨淋，看来非常破旧。四周建筑\n林立。往西你可以看到一间客栈，看来生意似乎很好。\n"
msgstr "這裡是雪亭鎮鎮前廣場的空地，地上整齊地鋪著大石板。廣場中央有\n一個木頭搭的架子，經過多年的風吹日曬雨淋，看來非常破舊。四周建築\n林立。往西你可以看到一間客棧，看來生意似乎很好。\n"

msgid "这里是雪亭镇的街道，往北是一个热闹的广场，南边是条小路通往\n一座林子，东边则有一条小径沿著山腰通往山上，往西是一条比较窄的\n街道，参差不齐的瓦屋之间传来几声犬吠。\n"
msgstr "這裡是雪亭鎮的街道，往北是一個熱鬧的廣場，南邊是條小路通往\n一座林子，東邊則有一條小徑沿著山腰通往山上，往西是一條比較窄的\n街道，參差不齊的瓦屋之間傳來幾聲犬吠。\n"

msgid "这是一条普通的黄土小径，弯弯曲曲往东一路盘旋上山，北边有\n一间城隍庙，往西则是雪亭镇的街道。\n"
msgstr "這是一條普通的黃土小徑，彎彎曲曲往東一路盤旋上山，北邊有\n一間城隍廟，往西則是雪亭鎮的街道。\n"

msgid "这是一条普通的黄土小径，小径往西南通往一处山间的平地，从这\n里可以望见不少房屋错落在平地上，往北则一路上山。\n"
msgstr "這是一條普通的黃土小徑，小徑往西南通往一處山間的平地，從這\n裡可以望見不少房屋錯落在平地上，往北則一路上山。\n"

msgid "这是一条说宽不宽，说窄倒也不窄的山路，路面用几块生满青苔的\n大石铺成，西面是一段坡地，从这里可以望见西边有几间房屋错落在林\n木间，东面则是山壁，山路往西衔接一条黄土小径，往北则是通往山\n上的石阶。\n"
msgstr "這是一條說寬不寬，說窄倒也不窄的山路，路面用幾塊生滿青苔的\n大石鋪成，西面是一段坡地，從這裡可以望見西邊有幾間房屋錯落在林\n木間，東面則是山壁，山路往西銜接一條黃土小徑，往北則是通往山\n上的石階。\n"

msgid "这是一间十分老旧的城隍庙，在你面前的神桌上供奉著一尊红脸的城\n隍，庙虽老旧，但是神案四周已被香火薰成乌黑的颜色，显示这里必定相\n当受到信徒的敬仰。\n"
msgstr "這是一間十分老舊的城隍廟，在你面前的神桌上供奉著一尊紅臉的城\n隍，廟雖老舊，但是神案四周已被香火薰成烏黑的顏色，顯示這裡必定相\n當受到信徒的敬仰。\n"

msgid "你现在正走在雪亭镇的街道上，东边不远处有一间高大的院子，门\n口立著一根粗大的旗杆，旗子上写著「淳风武馆」，往南只听得人声鼎\n沸，是个五十尺见方的广场，人来人往相当热闹。往北可望见一座牌坊\n，年代久远，上面的字迹早已看不出是什么字，出了牌坊就是镇外。\n"
msgstr "你現在正走在雪亭鎮的街道上，東邊不遠處有一間高大的院子，門\n口立著一根粗大的旗杆，旗子上寫著「淳風武館」，往南只聽得人聲鼎\n沸，是個五十尺見方的廣場，人來人往相當熱鬧。往北可望見一座牌坊\n，年代久遠，上面的字跡早已看不出是什麼字，出了牌坊就是鎮外。\n"

msgid "你现在正走在雪亭镇的大街，往南直走不远处是镇上的广场，在你\n的东边是一间大宅院，不过正门不在这个方向，往西是一家打铁铺子，\n叮叮当当的声音大老远可以听得到，街道往北边一直通往镇外。\n"
msgstr "你現在正走在雪亭鎮的大街，往南直走不遠處是鎮上的廣場，在你\n的東邊是一間大宅院，不過正門不在這個方向，往西是一家打鐵鋪子，\n叮叮噹噹的聲音大老遠可以聽得到，街道往北邊一直通往鎮外。\n"

msgid "这里是雪亭镇的大街，东边有一栋陈旧的建筑，看起来像是什么店\n铺，但是并没有任何招牌，只有一扇门上面写著一个大大的「当\n」字，往西是一间药铺，大街往南北两个方向延伸。\n"
msgstr "這裡是雪亭鎮的大街，東邊有一棟陳舊的建築，看起來像是什麼店\n鋪，但是並沒有任何招牌，只有一扇門上面寫著一個大大的「當\n」字，往西是一間藥鋪，大街往南北兩個方向延伸。\n"

msgid "这里是雪亭镇的大街，一条小巷子通往东边，西边则是一间驿站，\n由于雪亭镇来往的商旅、官员并不很多，因此虽然是官府的驿站，也接\n受百姓的信件，大街往北是一处山坳，从这里远远地可以望见北方的野\n羊山，出了山坳就是一条碎石路通往山上。\n"
msgstr "這裡是雪亭鎮的大街，一條小巷子通往東邊，西邊則是一間驛站，\n由於雪亭鎮來往的商旅、官員並不很多，因此雖然是官府的驛站，也接\n受百姓的信件，大街往北是一處山坳，從這裡遠遠地可以望見北方的野\n羊山，出了山坳就是一條碎石路通往山上。\n"

msgid "这里是一处山坳，往南就是雪亭镇，一条蜿蜒的小径往东通往另一\n个邻近的小山村，一块官府立的告示牌立在路旁，上面写著有关野羊山\n土匪出没的警告标志。\n"
msgstr "這裡是一處山坳，往南就是雪亭鎮，一條蜿蜒的小徑往東通往另一\n個鄰近的小山村，一塊官府立的告示牌立在路旁，上面寫著有關野羊山\n土匪出沒的警告標誌。\n"

msgid "这是一间谷物加工厂，这里是谷子脱壳成米的地方。米厂老板是一个一\n看就知道是十分精明的干瘦的中年人，老是带着一脸奸笑。你可以看到\n许多人正在忙忙碌碌的工作着，门口挂著一块牌子，往西是通往\n雪亭镇大街的大门。\n"
msgstr "這是一間穀物加工廠，這裡是穀子脫殼成米的地方。米廠老闆是一個一\n看就知道是十分精明的乾瘦的中年人，老是帶著一臉奸笑。你可以看到\n許多人正在忙忙碌碌的工作著，門口掛著一塊牌子，往西是通往\n雪亭鎮大街的大門。\n"

msgid "这是一间素来以公平信用著称的钱庄，钱庄的老板还是个曾经中过\n举人的读书人，你可以看到钱庄里里外外都打扫得乾乾净净，一个胖胖\n的中年人坐在柜台后面，柜台上放著一块牌子，往东是通往雪亭\n镇大街的大门。\n"
msgstr "這是一間素來以公平信用著稱的錢莊，錢莊的老闆還是個曾經中過\n舉人的讀書人，你可以看到錢莊裡裡外外都打掃得乾乾淨淨，一個胖胖\n的中年人坐在櫃檯後面，櫃檯上放著一塊牌子，往東是通往雪亭\n鎮大街的大門。\n"

msgid "这是一家中等规模的当铺，老旧的柜台上放著一张木牌，屋\n里的光线不是很亮，往东的出口被一块蓝色布帘遮著，上面有「非请莫\n入」的字样，西边有一扇木雕门通往大街。\n"
msgstr "這是一家中等規模的當鋪，老舊的櫃檯上放著一張木牌，屋\n裡的光線不是很亮，往東的出口被一塊藍色布簾遮著，上面有「非請莫\n入」的字樣，西邊有一扇木雕門通往大街。\n"

msgid "你现在正站在一间大宅院的入口，两只巨大的石狮镇守在大门的两\n侧，一阵阵吆喝与刀剑碰撞的声音从院子中传来。通过红漆大门\n往东可以望见许多身穿灰衣的汉子正在操练。\n"
msgstr "你現在正站在一間大宅院的入口，兩隻巨大的石獅鎮守在大門的兩\n側，一陣陣吆喝與刀劍碰撞的聲音從院子中傳來。通過紅漆大門\n往東可以望見許多身穿灰衣的漢子正在操練。\n"

msgid "你现在正站在一个宽敞的教练场中，地上铺著黄色的细砂，许多人\n正在这里努力地操练著，北边是一间高大的兵器厅，往东则是武馆师父\n们休息的大厅。\n"
msgstr "你現在正站在一個寬敞的教練場中，地上鋪著黃色的細砂，許多人\n正在這裡努力地操練著，北邊是一間高大的兵器廳，往東則是武館師父\n們休息的大廳。\n"

msgid "这里是淳风武馆的正厅，五张太师椅一字排开面对著门口，这是武\n馆中四位大师傅与馆主柳淳风的座位，和一般武馆不同的是，墙上竟然\n挂著几幅风骨颇为不俗的书画，显示这里的主人并非大字不识的粗汉，\n而是文武双全的高人。\n"
msgstr "這裡是淳風武館的正廳，五張太師椅一字排開面對著門口，這是武\n館中四位大師傅與館主柳淳風的座位，和一般武館不同的是，牆上竟然\n掛著幾幅風骨頗為不俗的書畫，顯示這裡的主人並非大字不識的粗漢，\n而是文武雙全的高人。\n"

msgid "这里是雪亭镇的街道，你的北边有一家客栈，从这里就可以听到客\n栈里人们饮酒谈笑的声音，街道往东不远处有个转角往北，如果你往东\n直走就是上山的小径了，往西则可以走到车马来往络绎不绝的官道。\n"
msgstr "這裡是雪亭鎮的街道，你的北邊有一家客棧，從這裡就可以聽到客\n棧裡人們飲酒談笑的聲音，街道往東不遠處有個轉角往北，如果你往東\n直走就是上山的小徑了，往西則可以走到車馬來往絡繹不絕的官道。\n"

msgid "这是一条宽敞坚实的青石板铺成的大道，路上车马的痕迹已经在路\n面上留下一条条明显的凹痕，往东是一条较小的街道通往雪亭镇，大路\n从这里往北可达水烟阁，往西南穿过黄石隘口则通往戍守京畿重地的天\n驼关。\n"
msgstr "這是一條寬敞堅實的青石板鋪成的大道，路上車馬的痕跡已經在路\n面上留下一條條明顯的凹痕，往東是一條較小的街道通往雪亭鎮，大路\n從這裡往北可達水煙閣，往西南穿過黃石隘口則通往戍守京畿重地的天\n駝關。\n"

msgid "这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从这\n里往北通往水烟阁，往东则是衔接雪亭镇街道的路口。\n"
msgstr "這是一條寬敞堅實的青石板大道，大道兩旁種著整齊的花木，從這\n裡往北通往水煙閣，往東則是銜接雪亭鎮街道的路口。\n"

msgid "这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从这\n里往西通往水烟阁，往南则是衔接雪亭镇街道的路口。\n"
msgstr "這是一條寬敞堅實的青石板大道，大道兩旁種著整齊的花木，從這\n裡往西通往水煙閣，往南則是銜接雪亭鎮街道的路口。\n"

msgid "这里是一间宽敞的书院，虽然房子看起来很老旧了，但是打扫得很\n整洁。墙壁上挂著一幅山水画，意境颇为不俗。书院的大门开在北边，\n西边有一扇木门通往边厢。\n"
msgstr "這裡是一間寬敞的書院，雖然房子看起來很老舊了，但是打掃得很\n整潔。牆壁上掛著一幅山水畫，意境頗為不俗。書院的大門開在北邊，\n西邊有一扇木門通往邊廂。\n"

msgid "这里是一间打铁铺子，从火炉中冒出的火光将墙壁映得通红，屋子\n的角落里堆满了各式铁器的完成品或未完成品，像是锄头、铁锤、铲子\n等，叮叮当当的声音敲得满屋子响。\n"
msgstr "這裡是一間打鐵鋪子，從火爐中冒出的火光將牆壁映得通紅，屋子\n的角落裡堆滿了各式鐵器的完成品或未完成品，像是鋤頭、鐵錘、鏟子\n等，叮叮噹噹的聲音敲得滿屋子響。\n"

msgid "这里是一间规模不小的药铺，奇怪的是，在这里你闻不到一丝药铺\n应有的药味，有的只是一股淡淡的檀香，令人觉得心旷神怡，药铺的柜\n台就在店铺靠北的一面，柜台后是一个巨大的药柜， 上面的\n小抽屉只怕有七、八百个之多，但是全部没有贴标签，药铺的出口在东\n边，柜台上贴著一张发黄的纸片。\n"
msgstr "這裡是一間規模不小的藥鋪，奇怪的是，在這裡你聞不到一絲藥鋪\n應有的藥味，有的只是一股淡淡的檀香，令人覺得心曠神怡，藥鋪的櫃\n臺就在店鋪靠北的一面，櫃檯後是一個巨大的藥櫃， 上面的\n小抽屜只怕有七、八百個之多，但是全部沒有貼標籤，藥鋪的出口在東\n邊，櫃檯上貼著一張發黃的紙片。\n"

msgid "这里是负责雪亭镇官府文书跟军令往来的雪亭驿，但是因为出了雪\n亭镇往北的野羊山近年来有盗匪盘据，官府的信差最近都改走东边的飞\n鸢栈道，所以雪亭驿来往的人就少了，驿站的官员索性就开始接一些百\n姓的信件，一方面打发时间，一方面也有点事做以免被上级裁撤。驿站\n大门口上悬著一块木牌，上面写了些字。\n"
msgstr "這裡是負責雪亭鎮官府文書跟軍令往來的雪亭驛，但是因為出了雪\n亭鎮往北的野羊山近年來有盜匪盤據，官府的信差最近都改走東邊的飛\n鳶棧道，所以雪亭驛來往的人就少了，驛站的官員索性就開始接一些百\n姓的信件，一方面打發時間，一方面也有點事做以免被上級裁撤。驛站\n大門口上懸著一塊木牌，上面寫了些字。\n"

msgid "这里是丰登当铺的储藏室，有时候当铺里的大朝奉会把铺里存不下\n的死当货物拿出来拍卖，不过你现在只能看见一个个锁著的箱子。往西\n边穿过一道布帘可以回到当铺店面。\n"
msgstr "這裡是豐登當鋪的儲藏室，有時候當鋪裡的大朝奉會把鋪裡存不下\n的死當貨物拿出來拍賣，不過你現在只能看見一個個鎖著的箱子。往西\n邊穿過一道布簾可以回到當鋪店面。\n"

msgid "饮风客栈二楼"
msgstr "飲風客棧二樓"

msgid "你现在来到了饮风客栈的二楼，这家客栈有个很奇怪的规矩，就是只留宿\n名头够大的客人，如果你只是一个无名小卒，不论出再多银两都租不到一间空\n房，墙边有一道楼梯通往一楼的茶座。\n"
msgstr "你現在來到了飲風客棧的二樓，這家客棧有個很奇怪的規矩，就是只留宿\n名頭夠大的客人，如果你只是一個無名小卒，不論出再多銀兩都租不到一間空\n房，牆邊有一道樓梯通往一樓的茶座。\n"

msgid "这是一间打扫得相当乾净的客房，虽然所有的家俱看起来都相当朴\n素，比不上县城里几家著名的大酒馆，但是自有一种敦厚亲切的感觉，\n你在这里相信可以安心的休息。\n"
msgstr "這是一間打掃得相當乾淨的客房，雖然所有的家俱看起來都相當樸\n素，比不上縣城裡幾家著名的大酒館，但是自有一種敦厚親切的感覺，\n你在這裡相信可以安心的休息。\n"

msgid "这里是淳风武馆中的天井，往西走可以回到正厅，往北边是书房，\n南边是招待客人的厢房，往东一条长廊通往武馆内院，天井中种满了许\n多奇花异草，中央立著一根石柱，上面似乎刻著字。\n"
msgstr "這裡是淳風武館中的天井，往西走可以回到正廳，往北邊是書房，\n南邊是招待客人的廂房，往東一條長廊通往武館內院，天井中種滿了許\n多奇花異草，中央立著一根石柱，上面似乎刻著字。\n"

msgid "这里是淳风武馆的内院，平常武馆弟子没有馆主的允许是不敢到这\n里来的，往东是柳家的祠堂，馆主和家眷的卧房分别位于往北一条走道\n的两旁，厨房以及柴房、仆役的卧房都在往南的走道两旁，往西则是天\n井。\n"
msgstr "這裡是淳風武館的內院，平常武館弟子沒有館主的允許是不敢到這\n裡來的，往東是柳家的祠堂，館主和家眷的臥房分別位於往北一條走道\n的兩旁，廚房以及柴房、僕役的臥房都在往南的走道兩旁，往西則是天\n井。\n"

msgid "这里是一间布置得相当雅致的厢房，从窗子可以看到北边的天井跟\n南边的庭园中各式各样的奇花异草，以及他们所带来的淡淡香气，厢房\n的东面墙上还挂著一幅仕女图，画中是一位宫装美妇，往西\n是通往天井的出口。\n"
msgstr "這裡是一間佈置得相當雅緻的廂房，從窗子可以看到北邊的天井跟\n南邊的庭園中各式各樣的奇花異草，以及他們所帶來的淡淡香氣，廂房\n的東面牆上還掛著一幅仕女圖，畫中是一位宮裝美婦，往西\n是通往天井的出口。\n"

msgid "这里是一间整理得相当乾净的书房，红木桌椅上铺著蓝绸巾，显得\n十分考究，西面的立著一个书架，上面放著一排排的古书，往南走出房\n门可以看到天井。\n"
msgstr "這裡是一間整理得相當乾淨的書房，紅木桌椅上鋪著藍綢巾，顯得\n十分考究，西面的立著一個書架，上面放著一排排的古書，往南走出房\n門可以看到天井。\n"

msgid "这是一间堆满各式兵器、刀械的储藏室，各式武器都依照种类、长\n短、依次放在一起，并且擦拭得一尘不染，储藏室的出口在你的南边，\n面对出口的左手边有一个架子。\n"
msgstr "這是一間堆滿各式兵器、刀械的儲藏室，各式武器都依照種類、長\n短、依次放在一起，並且擦拭得一塵不染，儲藏室的出口在你的南邊，\n面對出口的左手邊有一個架子。\n"

msgid "这里是一间窄小的密室，你的面前只有一个破旧的小床跟一\n些乾草。\n"
msgstr "這裡是一間窄小的密室，你的面前只有一個破舊的小床跟一\n些乾草。\n"

msgid "短工"
msgstr "短工"

msgid "钱庄"
msgstr "錢莊"

msgid "红漆大门"
msgstr "紅漆大門"

msgid "木雕门"
msgstr "木雕門"

msgid "房门"
msgstr "房門"

msgid "往左推"
msgstr "往左推"

msgid "这个架子上空荡荡的，什么都没有。\n"
msgstr "這個架子上空蕩蕩的，什麼都沒有。\n"

msgid "你将架子往左推...，忽然「喀」一声架子又移回原位。"
msgstr "你將架子往左推...，忽然「喀」一聲架子又移回原位。"

msgid "地板忽然发出轧轧的声音，一块地面缓缓移动著，露出一个向下的阶梯。"
msgstr "地板忽然發出軋軋的聲音，一塊地面緩緩移動著，露出一個向下的階梯。"

msgid "地板忽然发出轧轧的声音，一块地面缓缓移动著，将向下的通道盖住了。"
msgstr "地板忽然發出軋軋的聲音，一塊地面緩緩移動著，將向下的通道蓋住了。"

msgid "你现在正走在一条林间的小路，往北不远处走出这座林子就是雪亭\n镇，小路两旁长满了许多高耸的松树，雪亭镇的居民都把这里叫做「老\n松林」，据说林子里有株树龄上千的老松树，颇有灵验。\n"
msgstr "你現在正走在一條林間的小路，往北不遠處走出這座林子就是雪亭\n鎮，小路兩旁長滿了許多高聳的松樹，雪亭鎮的居民都把這裡叫做「老\n松林」，據說林子裡有株樹齡上千的老松樹，頗有靈驗。\n"

msgid "你现在正走在一条林间的小路上，小路两旁长满了高耸的松树，从\n林间传来阵阵鸟叫声，小路往南北两个方向延伸出去。\n"
msgstr "你現在正走在一條林間的小路上，小路兩旁長滿了高聳的松樹，從\n林間傳來陣陣鳥叫聲，小路往南北兩個方向延伸出去。\n"

msgid "你现在正走在一条林间的小路上，小路往东似乎通往一处空地，林\n子到了这里变得静悄悄的，小路两旁的松树也比西边的矮小，看起来有\n点营养不良的样子。\n"
msgstr "你現在正走在一條林間的小路上，小路往東似乎通往一處空地，林\n子到了這裡變得靜悄悄的，小路兩旁的松樹也比西邊的矮小，看起來有\n點營養不良的樣子。\n"

msgid "这是一块林间空地，四周的树木花草像是被人修剪过一般，环绕著\n空地围成一个整齐的圆形，空地中央一株巨大的松树像平地上撑\n起一把大伞，树上针叶茂密得遮去了大半的阳光，空地四周有三条小路\n分别通往东、西、南三个方向，往南的小路旁竖著一个牌子。\n"
msgstr "這是一塊林間空地，四周的樹木花草像是被人修剪過一般，環繞著\n空地圍成一個整齊的圓形，空地中央一株巨大的松樹像平地上撐\n起一把大傘，樹上針葉茂密得遮去了大半的陽光，空地四周有三條小路\n分別通往東、西、南三個方向，往南的小路旁豎著一個牌子。\n"

msgid "你现在正走在一片松树林中的小路上，小路往北通往一处空地，一\n株巨大无朋的松树矗立在空地中央，小路往南是一条长长的下坡道，这\n条路上足迹很多，显然常有人经过。\n"
msgstr "你現在正走在一片松樹林中的小路上，小路往北通往一處空地，一\n株巨大無朋的松樹矗立在空地中央，小路往南是一條長長的下坡道，這\n條路上足跡很多，顯然常有人經過。\n"

msgid "下坡道"
msgstr "下坡道"

msgid "这是一条笔直的坡道，北高南低，道路两旁长满了许多松树，从松\n林间隐约可以听到东边传来流水的声音。\n"
msgstr "這是一條筆直的坡道，北高南低，道路兩旁長滿了許多松樹，從松\n林間隱約可以聽到東邊傳來流水的聲音。\n"

msgid "你现在正走在一条松树林中的小路，这里的松树树干上都有著一些\n奇怪的记号，像是被人用刀子划过，小路的西边是一块空地，往东不远\n可以看到一条山涧，上面横跨著一座小石桥。\n"
msgstr "你現在正走在一條松樹林中的小路，這裡的松樹樹幹上都有著一些\n奇怪的記號，像是被人用刀子劃過，小路的西邊是一塊空地，往東不遠\n可以看到一條山澗，上面橫跨著一座小石橋。\n"

msgid "你现在正站在一座长满青苔的古桥上，桥下是一条山涧，几股清泉\n在乱石之中向山下奔流，桥北边不远处有一个瀑布 ，从山\n壁上犹如一条白练般垂了下来，瀑布两旁的石壁十分陡峭，高度和山涧\n旁的松林相差了近三、四十丈。\n"
msgstr "你現在正站在一座長滿青苔的古橋上，橋下是一條山澗，幾股清泉\n在亂石之中向山下奔流，橋北邊不遠處有一個瀑布 ，從山\n壁上猶如一條白練般垂了下來，瀑布兩旁的石壁十分陡峭，高度和山澗\n旁的松林相差了近三、四十丈。\n"

msgid "你现在正走在一条松树林间的小路，西边有一座小石桥横跨在一条\n山涧上，往东不远处似乎是林子的出口，一条破旧的栈道沿著山壁通往\n山上，你发现地上有一些湿漉漉的脚印，但是因为脚印太\n多，分不出是往哪里去。\n"
msgstr "你現在正走在一條松樹林間的小路，西邊有一座小石橋橫跨在一條\n山澗上，往東不遠處似乎是林子的出口，一條破舊的棧道沿著山壁通往\n山上，你發現地上有一些溼漉漉的腳印，但是因為腳印太\n多，分不出是往哪裡去。\n"

msgid "你现在正站在瀑布前的一个小水潭里，水潭大约深可及胸，淹不死\n人，一条白练般的瀑布从数百丈高的悬崖上冲激而下，溅\n得你全身湿透，水潭三面都被高耸的山壁所包围，只有南面沿\n著一条山涧可以出去。\n"
msgstr "你現在正站在瀑布前的一個小水潭裡，水潭大約深可及胸，淹不死\n人，一條白練般的瀑布從數百丈高的懸崖上衝激而下，濺\n得你全身溼透，水潭三面都被高聳的山壁所包圍，只有南面沿\n著一條山澗可以出去。\n"

msgid "你现在正站在一个深不见底的水潭边上，从潭底不时有气泡冒上来\n，散发著一股诡异的香味，水潭边长满了黄色叶子的怪草，四周陡峭的\n山壁近乎直立，抬头只见一个半圆形的天空，唯一的出路大概只有往北\n山泉流入水潭的缺口。\n"
msgstr "你現在正站在一個深不見底的水潭邊上，從潭底不時有氣泡冒上來\n，散發著一股詭異的香味，水潭邊長滿了黃色葉子的怪草，四周陡峭的\n山壁近乎直立，抬頭只見一個半圓形的天空，唯一的出路大概只有往北\n山泉流入水潭的缺口。\n"

msgid "你现在正站在一条山涧中的岩石上，几股泉水正从你脚边流过，水\n花溅得四处飞散，南边是一个深不见底的水潭，两边的山壁看起\n来又高又陡，看来要爬上岸边实在很不容易，你的北方有一座小石桥高\n高地跨过两边的山壁，可是桥的高度太高，即使是轻功绝顶的高手也跃\n不上去。\n"
msgstr "你現在正站在一條山澗中的岩石上，幾股泉水正從你腳邊流過，水\n花濺得四處飛散，南邊是一個深不見底的水潭，兩邊的山壁看起\n來又高又陡，看來要爬上岸邊實在很不容易，你的北方有一座小石橋高\n高地跨過兩邊的山壁，可是橋的高度太高，即使是輕功絕頂的高手也躍\n不上去。\n"

msgid "你现在正站在一条山涧中的岩石上，一座小石桥正高高地从你的头\n顶横跨过山涧两边的石壁，一个瀑布就在你的北方不远处，从一\n处更高的悬崖上垂了下来。\n"
msgstr "你現在正站在一條山澗中的岩石上，一座小石橋正高高地從你的頭\n頂橫跨過山澗兩邊的石壁，一個瀑布就在你的北方不遠處，從一\n處更高的懸崖上垂了下來。\n"

msgid "你现在正站在一个松树林里，嗯....这是一个松树林....你所知就\n这么多，茂密的松树遮蔽了整个天空，使你连方向都弄不清楚，最好在\n天黑之前赶紧找道路径出去吧。\n"
msgstr "你現在正站在一個松樹林裡，嗯....這是一個松樹林....你所知就\n這麼多，茂密的松樹遮蔽了整個天空，使你連方向都弄不清楚，最好在\n天黑之前趕緊找道路徑出去吧。\n"

msgid "你现在正站在一个松树林间的小空地上，你的北边、东边、南边都\n是茂密的松树，唯独西边是个悬崖，当你探头一看，立刻不由\n自主地倒抽一口凉气，在这里可得千万小心，一不小心跌了下去肯定是\n粉身碎骨。\n"
msgstr "你現在正站在一個松樹林間的小空地上，你的北邊、東邊、南邊都\n是茂密的松樹，唯獨西邊是個懸崖，當你探頭一看，立刻不由\n自主地倒抽一口涼氣，在這裡可得千萬小心，一不小心跌了下去肯定是\n粉身碎骨。\n"

msgid "你现在正栖身在一个山壁上勉强足以容纳一个人休息的岩穴中，从\n这里无论是要往上爬或往下爬都有一段不算短的距离，最好先歇一歇，\n喘口气再走。\n"
msgstr "你現在正棲身在一個山壁上勉強足以容納一個人休息的岩穴中，從\n這裡無論是要往上爬或往下爬都有一段不算短的距離，最好先歇一歇，\n喘口氣再走。\n"

msgid "你现在正攀附在一株大松树的树干上，从这里可以很清楚地望见树\n下的一切动静，而不被人发觉，似乎是个干偷鸡摸狗勾当的好地方。\n"
msgstr "你現在正攀附在一株大松樹的樹幹上，從這裡可以很清楚地望見樹\n下的一切動靜，而不被人發覺，似乎是個幹偷雞摸狗勾當的好地方。\n"

msgid "你现在正攀附在一株大松树的树干上，这里离地面已经有七、八丈\n高，如果不小心跌了下去，不断条腿也得去半条命，松树上结了许多球\n果，不过大部分都离树干很远，你构不到。\n"
msgstr "你現在正攀附在一株大松樹的樹幹上，這裡離地面已經有七、八丈\n高，如果不小心跌了下去，不斷條腿也得去半條命，松樹上結了許多球\n果，不過大部分都離樹幹很遠，你構不到。\n"

msgid "大松树顶"
msgstr "大松樹頂"

msgid "哇....你终于爬上这株松树的树顶了，一阵阵凉风从四面八方吹来\n，使你觉得心旷神怡，虽然你的经验告诉你在这种地方往下看是十分不\n智的，但是你还是忍不住看了一眼，这里离地面至少也有十五、六丈高\n，一阵晕眩警告你最好在跌下去以前离开这个地方。\n"
msgstr "哇....你終於爬上這株松樹的樹頂了，一陣陣涼風從四面八方吹來\n，使你覺得心曠神怡，雖然你的經驗告訴你在這種地方往下看是十分不\n智的，但是你還是忍不住看了一眼，這裡離地面至少也有十五、六丈高\n，一陣暈眩警告你最好在跌下去以前離開這個地方。\n"

msgid "你现在正站在一个岩石的通道之中，在你南边有一片亮晶晶的帘幕\n，从帘幕后面传来阵阵轰隆隆的水声，通道两边的石壁上安置\n著许多铜铸的烛台，照亮了这个岩穴，往北似乎有亮光。\n"
msgstr "你現在正站在一個岩石的通道之中，在你南邊有一片亮晶晶的簾幕\n，從簾幕後面傳來陣陣轟隆隆的水聲，通道兩邊的石壁上安置\n著許多銅鑄的燭臺，照亮了這個岩穴，往北似乎有亮光。\n"

msgid "    你现在正站在一个阴森森的山洞之中, 一条昂首吐信的金银花蛇,\n爬伏在一块突出的大青石上, 令人望而生畏, 也许你该回头逃跑了。\n"
msgstr "    你現在正站在一個陰森森的山洞之中, 一條昂首吐信的金銀花蛇,\n爬伏在一塊突出的大青石上, 令人望而生畏, 也許你該回頭逃跑了。\n"

msgid "你现在正站在一块突出的大青石上, 虽然有点滑, 你还是能站稳,\n往四周看, 除了长满了青苔的石壁, 好象无路可走了。\n"
msgstr "你現在正站在一塊突出的大青石上, 雖然有點滑, 你還是能站穩,\n往四周看, 除了長滿了青苔的石壁, 好象無路可走了。\n"

msgid "你现在正站在一个岩石通道之中，从南边隐隐传来哗哗的水声，岩\n壁上生著厚厚的青苔，一股恶臭从北边传来，像是什么野兽，也许你该\n回头出去了。\n"
msgstr "你現在正站在一個岩石通道之中，從南邊隱隱傳來嘩嘩的水聲，岩\n壁上生著厚厚的青苔，一股惡臭從北邊傳來，像是什麼野獸，也許你該\n回頭出去了。\n"

msgid "你现在已经到达山洞的深处了, 四面八方都是些黑漆漆的小石洞,\n简直不知道该往那里走, 要不是北面还有一点光线, 你都要彻底绝望了。\n"
msgstr "你現在已經到達山洞的深處了, 四面八方都是些黑漆漆的小石洞,\n簡直不知道該往那裡走, 要不是北面還有一點光線, 你都要徹底絕望了。\n"

msgid "你现在已经到达山洞的深处了, 耶...东面就是洞口了, 还可以听\n见外面瀑布的水声, 仔细的观察石壁, 可以发现上面有一些用利\n剑雕刻的字....\n"
msgstr "你現在已經到達山洞的深處了, 耶...東面就是洞口了, 還可以聽\n見外面瀑布的水聲, 仔細的觀察石壁, 可以發現上面有一些用利\n劍雕刻的字....\n"

msgid "这里只见一个木头搭成的大门，门框上挂著四、五的不知道是什么\n动物的头骨跟一些铁链，外面再铺上一层乾枯的松枝，在这样一个森林\n里还真不容易发觉。\n"
msgstr "這裡只見一個木頭搭成的大門，門框上掛著四、五的不知道是什麼\n動物的頭骨跟一些鐵鏈，外面再鋪上一層乾枯的松枝，在這樣一個森林\n裡還真不容易發覺。\n"

msgid "这里应该是老松寨了，虽然围绕著你的墙都是木头搭成的，但是仔\n细一看，在许多险要的位置都放了不少沙包石堆，后面显然是埋伏人手\n的好地方，如果有人贸然从大门口攻进来，肯定会吃大亏的，大寨的门\n在你的西边，东边越过一排木桩之后就是大厅。\n"
msgstr "這裡應該是老松寨了，雖然圍繞著你的牆都是木頭搭成的，但是仔\n細一看，在許多險要的位置都放了不少沙包石堆，後面顯然是埋伏人手\n的好地方，如果有人貿然從大門口攻進來，肯定會吃大虧的，大寨的門\n在你的西邊，東邊越過一排木樁之後就是大廳。\n"

msgid "这里就是老松寨的大厅了，靠北边的地面上铺了一张巨大的熊皮，\n上面摆了三张椅子，大厅四周散落著几个取暖用的火盆，几个上了锁的\n木箱子，比较奇特的是中央掘了一个大坑，坑里是许多头骨浸在\n一种发著恶臭的黄水之中。\n"
msgstr "這裡就是老松寨的大廳了，靠北邊的地面上鋪了一張巨大的熊皮，\n上面擺了三張椅子，大廳四周散落著幾個取暖用的火盆，幾個上了鎖的\n木箱子，比較奇特的是中央掘了一個大坑，坑裡是許多頭骨浸在\n一種發著惡臭的黃水之中。\n"

msgid "瀑布清水"
msgstr "瀑布清水"

msgid "湖水"
msgstr "湖水"

msgid "泉水"
msgstr "泉水"

msgid "大门"
msgstr "大門"

msgid "灌木丛"
msgstr "灌木叢"

msgid "你听到你身后有几个声音大叫：把门关上！把门关上！一个也不许让他们溜走！"
msgstr "你聽到你身後有幾個聲音大叫：把門關上！把門關上！一個也不許讓他們溜走！"

msgid "接著「轰」地一声，通往外面的大门已经被一块大石堵死了。"
msgstr "接著「轟」地一聲，通往外面的大門已經被一塊大石堵死了。"

msgid "你听到一阵轧轧的轮盘绞动声，堵住门口的大石慢慢地被移开了。"
msgstr "你聽到一陣軋軋的輪盤絞動聲，堵住門口的大石慢慢地被移開了。"

msgid "爬树"
msgstr "爬樹"

msgid "一株又高又大的松树，当你抬头往上看的时候似乎有个人影\n在树梢之间移动，不过也许是风吹动所造成的错觉。\n"
msgstr "一株又高又大的松樹，當你抬頭往上看的時候似乎有個人影\n在樹梢之間移動，不過也許是風吹動所造成的錯覺。\n"

msgid "你手脚并用，敏捷地爬上了空地中央的大松树。"
msgstr "你手腳並用，敏捷地爬上了空地中央的大松樹。"

msgid "往下爬"
msgstr "往下爬"

msgid "你顺著粗大的树干，慢慢地爬了下来。"
msgstr "你順著粗大的樹幹，慢慢地爬了下來。"

msgid "抓住藤蔓"
msgstr "抓住藤蔓"

msgid "其中有一根藤蔓距离你比较近，你可以试著抓住藤蔓，看看\n能不能像泰山一样荡过去，看看瀑布后面有什么？\n对了，提醒你一点，这座石桥下面是高约百丈的山涧深谷....。\n"
msgstr "其中有一根藤蔓距離你比較近，你可以試著抓住藤蔓，看看\n能不能像泰山一樣蕩過去，看看瀑布後面有什麼？\n對了，提醒你一點，這座石橋下面是高約百丈的山澗深谷....。\n"

msgid "你爬上石桥的护栏，伸手往不远处的一根藤蔓抓去...."
msgstr "你爬上石橋的護欄，伸手往不遠處的一根藤蔓抓去...."

msgid "只听见一声杀猪般的惨叫，你已经往山涧中坠了下去。"
msgstr "只聽見一聲殺豬般的慘叫，你已經往山澗中墜了下去。"

msgid "你听到有人高声惊叫，一条人影从上方掉了下来，「扑通」一声跌进潭中。"
msgstr "你聽到有人高聲驚叫，一條人影從上方掉了下來，「撲通」一聲跌進潭中。"

msgid "你手脚俐落地攀附著藤蔓，慢慢地爬下山涧....。"
msgstr "你手腳俐落地攀附著藤蔓，慢慢地爬下山澗....。"

msgid "忽然一条人影从南边的帘幕穿了出来。"
msgstr "忽然一條人影從南邊的簾幕穿了出來。"

msgid "山涧石壁"
msgstr "山澗石壁"

msgid "攀爬石壁"
msgstr "攀爬石壁"

msgid "两边的山壁看起来又高又陡，看来要爬上岸边实在很不容易。\n"
msgstr "兩邊的山壁看起來又高又陡，看來要爬上岸邊實在很不容易。\n"

msgid "你一付不信邪的表情，开始小心翼翼地攀著石壁爬了上去。"
msgstr "你一付不信邪的表情，開始小心翼翼地攀著石壁爬了上去。"

msgid "向下的山壁"
msgstr "向下的山壁"

msgid "从这个勉强容身的岩穴往下爬，还有一段不算短的距离。\n"
msgstr "從這個勉強容身的岩穴往下爬，還有一段不算短的距離。\n"

msgid "你试了试脚边的岩石稳不稳，开始小心翼翼地往山涧中攀了下去。"
msgstr "你試了試腳邊的岩石穩不穩，開始小心翼翼地往山澗中攀了下去。"

msgid "向上的山壁"
msgstr "向上的山壁"

msgid "往上爬"
msgstr "往上爬"

msgid "从这个勉强容身的岩穴往上爬，还有一段不算短的距离。\n"
msgstr "從這個勉強容身的岩穴往上爬，還有一段不算短的距離。\n"

msgid "你试了试脚边的岩石稳不稳，开始小心翼翼地往上攀爬。"
msgstr "你試了試腳邊的岩石穩不穩，開始小心翼翼地往上攀爬。"

msgid "大青石"
msgstr "大青石"

msgid "一块比人还高的钟乳石, 虽然长满了青苔, 但爬上去\n应该不会太困难。\n"
msgstr "一塊比人還高的鐘乳石, 雖然長滿了青苔, 但爬上去\n應該不會太困難。\n"

msgid "你慢慢地攀上大青石。"
msgstr "你慢慢地攀上大青石。"

msgid "你迅速地爬下大青石。"
msgstr "你迅速地爬下大青石。"

msgid "石壁"
msgstr "石壁"

msgid "埋葬骸骨"
msgstr "埋葬骸骨"

msgid "老夫南危水, 乃是昔年水烟阁五长老中第一高手,\n一生醉心武学, 集天邪、封山两派之所长, 为营救盟主遭小人暗算,\n埋骨于此。男子汉大丈夫死不足惜, 只可恨一身武学尚无传人!\n葬我遗骨者老夫将赠以过招要旨, 唉......\n"
msgstr "老夫南危水, 乃是昔年水煙閣五長老中第一高手,\n一生醉心武學, 集天邪、封山兩派之所長, 為營救盟主遭小人暗算,\n埋骨於此。男子漢大丈夫死不足惜, 只可恨一身武學尚無傳人!\n葬我遺骨者老夫將贈以過招要旨, 唉......\n"

msgid "你小心翼翼地埋好了那具骸骨。"
msgstr "你小心翼翼地埋好了那具骸骨。"

msgid "你听见山洞顶部的石壁「喀喇」地一声响，一本书坠落下来。"
msgstr "你聽見山洞頂部的石壁「喀喇」地一聲響，一本書墜落下來。"

msgid "你只看见山洞顶部纷纷扬扬飘下几张纸片来。"
msgstr "你只看見山洞頂部紛紛揚揚飄下幾張紙片來。"

msgid "你听得「轰」的一声响，已经从这摔了下去"
msgstr "你聽得「轟」的一聲響，已經從這摔了下去"

msgid "你定下心神一看，其实这个悬崖没有想像中那么恐怖，也许还\n可以从这里爬下山涧，只是这世界上大概没有这种白痴愿意干\n这种傻事吧。\n"
msgstr "你定下心神一看，其實這個懸崖沒有想像中那麼恐怖，也許還\n可以從這裡爬下山澗，只是這世界上大概沒有這種白痴願意幹\n這種傻事吧。\n"

msgid "你一付认真的表情，开始小心翼翼地攀著石壁爬了上去。"
msgstr "你一付認真的表情，開始小心翼翼地攀著石壁爬了上去。"

msgid "「官府告示：此处常有歹人出没。」\n"
msgstr "「官府告示：此處常有歹人出沒。」\n"

msgid "路牌"
msgstr "路牌"

msgid "一块旧木牌，刻着三行字：\n「往西，雪亭镇。」\n「往东，小石桥。」\n「往南，下坡道。」\n"
msgstr "一塊舊木牌，刻著三行字：\n「往西，雪亭鎮。」\n「往東，小石橋。」\n「往南，下坡道。」\n"

msgid "刀痕"
msgstr "刀痕"

msgid "顺着刀痕找"
msgstr "順著刀痕找"

msgid "这几株松树的树干上都有刀划的记号，一道一道，深浅不一，像是有人怕走错了路，沿途留下的。记号一路往东，到那丛灌木跟前就断了。\n"
msgstr "這幾株松樹的樹幹上都有刀劃的記號，一道一道，深淺不一，像是有人怕走錯了路，沿途留下的。記號一路往東，到那叢灌木跟前就斷了。\n"

msgid "你顺着树上的刀痕往东找去，拨开那丛灌木，后面果然有一条踩得结实的小径，通往林子深处。"
msgstr "你順著樹上的刀痕往東找去，撥開那叢灌木，後面果然有一條踩得結實的小徑，通往林子深處。"

msgid "刀痕指的就是灌木后面那条小径。"
msgstr "刀痕指的就是灌木後面那條小徑。"

msgid "脚印"
msgstr "腳印"

msgid "一些杂乱的脚印，不但有人的脚印，看起来还有不少马蹄印。\n"
msgstr "一些雜亂的腳印，不但有人的腳印，看起來還有不少馬蹄印。\n"

msgid "瀑布"
msgstr "瀑布"

msgid "这个瀑布从数百丈高的山壁上冲激而下，流入一个山涧底的小水潭\n，水潭两边的石壁垂下许多的藤蔓，你注意到瀑布后面似乎\n有什么东西在发著光。\n"
msgstr "這個瀑布從數百丈高的山壁上衝激而下，流入一個山澗底的小水潭\n，水潭兩邊的石壁垂下許多的藤蔓，你注意到瀑布後面似乎\n有什麼東西在發著光。\n"

msgid "这个瀑布水势并不是很大，但是高度却极高，水珠溅在你的脸上\n打得隐隐生疼。你注意到瀑布后面似乎有什么东西在发著光。\n"
msgstr "這個瀑布水勢並不是很大，但是高度卻極高，水珠濺在你的臉上\n打得隱隱生疼。你注意到瀑布後面似乎有什麼東西在發著光。\n"

msgid "山壁"
msgstr "山壁"

msgid "水潭四周的山壁都有数百丈高，想要爬上去「肯定」是休想。\n"
msgstr "水潭四周的山壁都有數百丈高，想要爬上去「肯定」是休想。\n"

msgid "这里的山壁比北边高度稍低了点，但是对凡人而言想要爬上去仍然\n还有一段差距。\n"
msgstr "這裡的山壁比北邊高度稍低了點，但是對凡人而言想要爬上去仍然\n還有一段差距。\n"

msgid "帘幕"
msgstr "簾幕"

msgid "这片帘幕似乎是用一种极薄的丝绸织成的，后面还传来阵阵水声。\n"
msgstr "這片簾幕似乎是用一種極薄的絲綢織成的，後面還傳來陣陣水聲。\n"

msgid "大金槌"
msgstr "大金槌"

msgid "一把极其沈重的大槌，要挥动这样的武器非得有过人的膂力不可。\n"
msgstr "一把極其沈重的大槌，要揮動這樣的武器非得有過人的膂力不可。\n"

msgid "熊皮短靴"
msgstr "熊皮短靴"

msgid "钢刀"
msgstr "鋼刀"

msgid "一把沈重的钢刀，磨得又利又快，看起来相当具杀伤力。\n"
msgstr "一把沈重的鋼刀，磨得又利又快，看起來相當具殺傷力。\n"

msgid "短斧"
msgstr "短斧"

msgid "这种斧头的刃长柄短，是专门用来做兵器的斧头，近战具有相当强的\n杀伤力。\n"
msgstr "這種斧頭的刃長柄短，是專門用來做兵器的斧頭，近戰具有相當強的\n殺傷力。\n"

msgid "黄霸"
msgstr "黃霸"

msgid "日月槌"
msgstr "日月槌"

msgid "野羊山三寨主（代寨主）"
msgstr "野羊山三寨主（代寨主）"

msgid "黄霸原是关外一个山寨的寨主，后来因为逃避官府追捕而到也羊山\n避祸，他的成名武器是一对各重四十斤的大金槌，内功跟横练功夫\n也都有不错的造诣。\n大寨主、二寨主先后没了下落，如今野羊寨的事都是他说了算——只是每年得往北麓的道观纳供。\n"
msgstr "黃霸原是關外一個山寨的寨主，後來因為逃避官府追捕而到也羊山\n避禍，他的成名武器是一對各重四十斤的大金槌，內功跟橫練功夫\n也都有不錯的造詣。\n大寨主、二寨主先後沒了下落，如今野羊寨的事都是他說了算——只是每年得往北麓的道觀納供。\n"

msgid "纳供"
msgstr "納供"

msgid "说过的话老子不说第二遍。车在山路转角，去不去随你。"
msgstr "說過的話老子不說第二遍。車在山路轉角，去不去隨你。"

msgid "哼了一声。"
msgstr "哼了一聲。"

msgid "你倒打听得清楚。两年前北麓来了那群黑衣黑冠的道士，一座黑砖道观说起就起，自称逆灵宫。寨里折了一半弟兄。"
msgstr "你倒打聽得清楚。兩年前北麓來了那群黑衣黑冠的道士，一座黑磚道觀說起就起，自稱逆靈宮。寨裡折了一半弟兄。"

msgid "半年前大寨主霍铮、二寨主一前一后没了下落，寨子就落到老子手里。老子打不过他们——每年纳供，金帛、牲口，他们要什么给什么，换这山上还有野羊寨。"
msgstr "半年前大寨主霍錚、二寨主一前一後沒了下落，寨子就落到老子手裡。老子打不過他們——每年納供，金帛、牲口，他們要什麼給什麼，換這山上還有野羊寨。"

msgid "把酒碗往桌上一顿。"
msgstr "把酒碗往桌上一頓。"

msgid "今年的车今天就上去了，这会儿该到了山路转角。你要去，别说是老子说的。"
msgstr "今年的車今天就上去了，這會兒該到了山路轉角。你要去，別說是老子說的。"

msgid "寨里的事，外人少打听。"
msgstr "寨裡的事，外人少打聽。"

msgid "前些日子茅山灵心观来了个小道士，说是替他们的林忌真人打听北麓那座道观——问寨里有没有人进去过，还出得来。"
msgstr "前些日子茅山靈心觀來了個小道士，說是替他們的林忌真人打聽北麓那座道觀——問寨裡有沒有人進去過，還出得來。"

msgid "老子说有一个。……你要是不想再跟那群牛鼻子打交道，就当老子没说。"
msgstr "老子說有一個。……你要是不想再跟那群牛鼻子打交道，就當老子沒說。"

msgid "茅山？牛鼻子道士，老子不认得。"
msgstr "茅山？牛鼻子道士，老子不認得。"

msgid "黄霸脸色一沉：北麓那座黑砖道观？少打听。要问，问纳供。"
msgstr "黃霸臉色一沉：北麓那座黑磚道觀？少打聽。要問，問納供。"

msgid "大哥在里屋。要见他，自己进去。"
msgstr "大哥在裡屋。要見他，自己進去。"

msgid "没了。野羊山现在姓黄。"
msgstr "沒了。野羊山現在姓黃。"

msgid "霍铮？半年前让道观的人带走了。你问这个做什么。"
msgstr "霍錚？半年前讓道觀的人帶走了。你問這個做什麼。"

msgid "霍铮"
msgstr "霍錚"

msgid "黑衣"
msgstr "黑衣"

msgid "就那一顶，老子又不开成衣铺。"
msgstr "就那一頂，老子又不開成衣鋪。"

msgid "从墙角的箱子里翻出一顶黑冠，往你怀里一扔。"
msgstr "從牆角的箱子裡翻出一頂黑冠，往你懷裡一扔。"

msgid "去年抓过一个落单的道士，衣冠都在这儿，人早喂了岩蛭。黑衣你自己有，戴上这顶冠，那群牛鼻子分不出你是谁。"
msgstr "去年抓過一個落單的道士，衣冠都在這兒，人早餵了岩蛭。黑衣你自己有，戴上這頂冠，那群牛鼻子分不出你是誰。"

msgid "见了霍铮——要是他还活着——说一声，黄霸没忘了他。"
msgstr "見了霍錚——要是他還活著——說一聲，黃霸沒忘了他。"

msgid "眯眼看了你一会儿，从墙角的箱子里翻出一顶黑冠，往你怀里一扔。"
msgstr "眯眼看了你一會兒，從牆角的箱子裡翻出一頂黑冠，往你懷裡一扔。"

msgid "刘老三让你来的？去年抓过一个落单的道士，衣冠都在这儿。黑衣你自己有，戴上这顶冠，那群牛鼻子分不出你是谁。"
msgstr "劉老三讓你來的？去年抓過一個落單的道士，衣冠都在這兒。黑衣你自己有，戴上這頂冠，那群牛鼻子分不出你是誰。"

msgid "黑衣？老子穿的是布衣。少打听。"
msgstr "黑衣？老子穿的是布衣。少打聽。"

msgid "野羊山寨主"
msgstr "野羊山寨主"

msgid "黄霸把酒碗往桌上一顿：野羊山，老子说了算。\n"
msgstr "黃霸把酒碗往桌上一頓：野羊山，老子說了算。\n"

msgid "黄霸嘟囔道：大寨主没了。没了就没了。\n"
msgstr "黃霸嘟囔道：大寨主沒了。沒了就沒了。\n"

msgid "野羊山三寨主"
msgstr "野羊山三寨主"

msgid "黄霸给里屋送了一碗酒进去，出来时抹了把脸。\n"
msgstr "黃霸給裡屋送了一碗酒進去，出來時抹了把臉。\n"

msgid "黄霸嘟囔道：大哥回来了。好，好。\n"
msgstr "黃霸嘟囔道：大哥回來了。好，好。\n"

msgid "看了你一眼，又低头喝酒。"
msgstr "看了你一眼，又低頭喝酒。"

msgid "逆灵宫的事老子听说了。大寨主没了，寨子是老子的——你也别想拿这个压老子。"
msgstr "逆靈宮的事老子聽說了。大寨主沒了，寨子是老子的——你也別想拿這個壓老子。"

msgid "手里的酒碗啪地掉在地上。"
msgstr "手裡的酒碗啪地掉在地上。"

msgid "大哥……大哥你还活着！"
msgstr "大哥……大哥你還活著！"

msgid "活着。老三，寨子你管得不错——供也纳得不错。"
msgstr "活著。老三，寨子你管得不錯——供也納得不錯。"

msgid "扑通一声跪下了。"
msgstr "撲通一聲跪下了。"

msgid "大哥，寨子是你的。老子从今天起还是三寨主，你要打要杀，老子不还手。"
msgstr "大哥，寨子是你的。老子從今天起還是三寨主，你要打要殺，老子不還手。"

msgid "起来。杀你不如杀道士。"
msgstr "起來。殺你不如殺道士。"

msgid "这娃娃是傅家坡的，派两个弟兄送他回家，少一根头发老子找你。"
msgstr "這娃娃是傅家坡的，派兩個弟兄送他回家，少一根頭髮老子找你。"

msgid "两个寨兵领着石头出了庙门。石头回头看了你一眼，没有说话。"
msgstr "兩個寨兵領著石頭出了廟門。石頭回頭看了你一眼，沒有說話。"

msgid "兄弟，野羊寨欠你一条命。以后野羊山的路，你横着走。"
msgstr "兄弟，野羊寨欠你一條命。以後野羊山的路，你橫著走。"

msgid "霍铮骂骂咧咧地进了土地庙的里屋，叫黄霸拿酒来。"
msgstr "霍錚罵罵咧咧地進了土地廟的裡屋，叫黃霸拿酒來。"

msgid "一个眼神凶恶的土匪，脸上好几条长长的刀疤，看起来就知道不好惹。\n"
msgstr "一個眼神兇惡的土匪，臉上好幾條長長的刀疤，看起來就知道不好惹。\n"

msgid "这个土匪看起来相当强悍，至少你从他的动作就可以看得出来他显然\n是练过武功的硬手，并不是泛泛之辈。\n"
msgstr "這個土匪看起來相當強悍，至少你從他的動作就可以看得出來他顯然\n是練過武功的硬手，並不是泛泛之輩。\n"

msgid "一条色作浅灰，带著白色斑点的水蛭模样怪虫，口中露出六对白森森\n的牙齿，看起来恶心极了。\n"
msgstr "一條色作淺灰，帶著白色斑點的水蛭模樣怪蟲，口中露出六對白森森\n的牙齒，看起來噁心極了。\n"

msgid "你现在正走在一条崎岖的山路上，凹凹凸凸的山石刺得你的脚底隐\n隐生疼，山路往南不远处通往一个山腰的台地，这一带最大的镇甸就位\n在台地上，东边跟西边都是陡峭的山壁，山路往北通往层层叠叠的群山\n之中。\n"
msgstr "你現在正走在一條崎嶇的山路上，凹凹凸凸的山石刺得你的腳底隱\n隱生疼，山路往南不遠處通往一個山腰的臺地，這一帶最大的鎮甸就位\n在臺地上，東邊跟西邊都是陡峭的山壁，山路往北通往層層疊疊的群山\n之中。\n"

msgid "你现在正走在一条崎岖的山路上，路面到处生满了及膝的杂草丛，\n显示这里已经有一段时间没有车马经过了，从这里往北就是野羊山的地\n界，野羊山有一座山寨，住著许多凶恶的盗匪，你最好绕道而行。\n"
msgstr "你現在正走在一條崎嶇的山路上，路面到處生滿了及膝的雜草叢，\n顯示這裡已經有一段時間沒有車馬經過了，從這裡往北就是野羊山的地\n界，野羊山有一座山寨，住著許多兇惡的盜匪，你最好繞道而行。\n"

msgid "你现在正走在一条崎岖的山路上，东边的路旁一个山壁的裂缝里有\n一间小庙，从这里看过去黑漆漆的似乎没有人照顾，山路往北是一段陡\n峭的上坡，往西南的山路就平缓得多。\n"
msgstr "你現在正走在一條崎嶇的山路上，東邊的路旁一個山壁的裂縫裡有\n一間小廟，從這裡看過去黑漆漆的似乎沒有人照顧，山路往北是一段陡\n峭的上坡，往西南的山路就平緩得多。\n"

msgid "你现在正站在一间小土地庙中，这座庙的南北两面都是利用了山壁\n而建的，只有东面一面土墙，墙上嵌著一个小小的神龛，里面供著一尊\n残破不堪的土地爷爷，庙门在你的西边。\n"
msgstr "你現在正站在一間小土地廟中，這座廟的南北兩面都是利用了山壁\n而建的，只有東面一面土牆，牆上嵌著一個小小的神龕，裡面供著一尊\n殘破不堪的土地爺爺，廟門在你的西邊。\n"

msgid "你现在正走在一条崎岖山路的转角处，山路望东通往野羊山上，从\n这里可以望见东边不远处有一个石屋立在岩壁边上，看起来像是冈哨或\n什么的，北边的山壁有一个裂口，不过离地约有三到四丈， 往\n南的山路是段陡峭的下坡，如果你要下山，大概就是这条路了。\n"
msgstr "你現在正走在一條崎嶇山路的轉角處，山路望東通往野羊山上，從\n這裡可以望見東邊不遠處有一個石屋立在岩壁邊上，看起來像是岡哨或\n什麼的，北邊的山壁有一個裂口，不過離地約有三到四丈， 往\n南的山路是段陡峭的下坡，如果你要下山，大概就是這條路了。\n"

msgid "这里是一段狭窄的山路，往东不远处的岩壁边上有一座石屋，路旁\n生满了及腰的长草，山风吹过一起一伏的有如波浪一般，南北两边有许\n多大石，看起来倒是个埋伏的好地点，往西是一个山路的转角。\n"
msgstr "這裡是一段狹窄的山路，往東不遠處的岩壁邊上有一座石屋，路旁\n生滿了及腰的長草，山風吹過一起一伏的有如波浪一般，南北兩邊有許\n多大石，看起來倒是個埋伏的好地點，往西是一個山路的轉角。\n"

msgid "这里是一处岩石斜坡，斜坡上到处布满乱石及杂草，东边的岩壁边\n有一间石屋，往西跟往北则可以回到铺满碎石的山路。\n"
msgstr "這裡是一處岩石斜坡，斜坡上到處佈滿亂石及雜草，東邊的岩壁邊\n有一間石屋，往西跟往北則可以回到鋪滿碎石的山路。\n"

msgid "你现在正走在一条崎岖的山路上，往北是一个峡谷，通过「飞火崖\n」的正下方，从这里可以看到一条五、六丈宽的石梁魏颤颤地跨过峡谷\n，山路往西南转过，南边则是一片岩石斜坡。\n"
msgstr "你現在正走在一條崎嶇的山路上，往北是一個峽谷，通過「飛火崖\n」的正下方，從這裡可以看到一條五、六丈寬的石梁魏顫顫地跨過峽谷\n，山路往西南轉過，南邊則是一片岩石斜坡。\n"

msgid "你现在正走在一条狭长的峡谷之中，东西两边都是高不可攀的峭壁\n，一根五、六丈宽的石梁正横跨在你头顶的谷口，看起来摇摇欲坠，万\n一掉下来只怕当场就会被压成一个肉饼，往南就是峡谷的出口，峡谷谷\n底的地面看起来像是乾涸的山涧，弯弯曲曲往北通入峡谷深处。\n"
msgstr "你現在正走在一條狹長的峽谷之中，東西兩邊都是高不可攀的峭壁\n，一根五、六丈寬的石梁正橫跨在你頭頂的谷口，看起來搖搖欲墜，萬\n一掉下來只怕當場就會被壓成一個肉餅，往南就是峽谷的出口，峽谷谷\n底的地面看起來像是乾涸的山澗，彎彎曲曲往北通入峽谷深處。\n"

msgid "你现在正走在一条狭长的深谷之中，东西两面都是高不可攀的峭壁\n，往南沿著谷底一条乾涸的山涧可以通往峡谷的出口，北边的峭壁从这\n里斜斜向上宛如从天上掉下来倒插进地面，形势更是危峻，连天空都被\n北边的峭壁遮去了七、八分。\n"
msgstr "你現在正走在一條狹長的深谷之中，東西兩面都是高不可攀的峭壁\n，往南沿著谷底一條乾涸的山澗可以通往峽谷的出口，北邊的峭壁從這\n裡斜斜向上宛如從天上掉下來倒插進地面，形勢更是危峻，連天空都被\n北邊的峭壁遮去了七、八分。\n"

msgid "你现在正走在一条峡谷的谷底，这里的峭壁斜度之大让你胆颤心惊\n，只消有人在这里一声大喝将上面的土石震了下来，只怕立刻就得被活\n埋，东边的峭壁上有一个黑漆漆的洞穴，里面似乎有什么东西蠕蠕而动\n，峡谷往西南和西北两边各有狭窄的出口。\n"
msgstr "你現在正走在一條峽谷的谷底，這裡的峭壁斜度之大讓你膽顫心驚\n，只消有人在這裡一聲大喝將上面的土石震了下來，只怕立刻就得被活\n埋，東邊的峭壁上有一個黑漆漆的洞穴，裡面似乎有什麼東西蠕蠕而動\n，峽谷往西南和西北兩邊各有狹窄的出口。\n"

msgid "这个岩洞的内部似乎远比你想像得大，岩壁上有一条条的深沟彷佛\n是被什么蛀虫给蛀出来的，可是有什么虫会去啃咬这又硬又厚的岩壁呢\n？洞穴的出口在你的西边透著微光，东北边跟西北边各有一个洞穴，黑\n暗中似乎有什么东西在蠕蠕而动。\n"
msgstr "這個岩洞的內部似乎遠比你想像得大，岩壁上有一條條的深溝彷彿\n是被什麼蛀蟲給蛀出來的，可是有什麼蟲會去啃咬這又硬又厚的岩壁呢\n？洞穴的出口在你的西邊透著微光，東北邊跟西北邊各有一個洞穴，黑\n暗中似乎有什麼東西在蠕蠕而動。\n"

msgid "你现在正在一个黑漆漆的岩洞中摸索前进，西南边隐隐有些光亮，\n想必是洞穴的出口，东边似乎有些滴水的声音，不过你得走过去才能听\n得仔细，你感觉脚边有一些东西在蠕蠕而动，举脚又有些黏黏的，一阵\n恶心的感觉压迫著你的胃。\n"
msgstr "你現在正在一個黑漆漆的岩洞中摸索前進，西南邊隱隱有些光亮，\n想必是洞穴的出口，東邊似乎有些滴水的聲音，不過你得走過去才能聽\n得仔細，你感覺腳邊有一些東西在蠕蠕而動，舉腳又有些黏黏的，一陣\n噁心的感覺壓迫著你的胃。\n"

msgid "这里一片黑漆漆，你必须全靠摸索才能不至于撞到岩壁，你听到东\n边传来阵阵滴水的声音，可是伸手一摸却仍是冷冰冰、又乾又硬的岩石\n，地上布满了许多又黏又稠的不知名东西，使你每一步都走得异常艰辛\n。\n"
msgstr "這裡一片黑漆漆，你必須全靠摸索才能不至於撞到岩壁，你聽到東\n邊傳來陣陣滴水的聲音，可是伸手一摸卻仍是冷冰冰、又乾又硬的岩石\n，地上佈滿了許多又黏又稠的不知名東西，使你每一步都走得異常艱辛\n。\n"

msgid "这里是一处阴暗的岩洞，等你走近这个岩洞才发现原来是死路，东\n北边隐隐透出几道微光，想必是洞穴的出口，地上一滩滩暗黄色的黏稠\n物不知道士什么东西，闻起来竟一点味道也没有。\n"
msgstr "這裡是一處陰暗的岩洞，等你走近這個岩洞才發現原來是死路，東\n北邊隱隱透出幾道微光，想必是洞穴的出口，地上一灘灘暗黃色的黏稠\n物不知道士什麼東西，聞起來竟一點味道也沒有。\n"

msgid "裂口"
msgstr "裂口"

msgid "北边的山壁上一道黑黝黝的裂口，离地约有三四丈，站在路上够不着。裂口边缘的岩石磨得发亮，像是常有东西从那里吊上吊下。\n"
msgstr "北邊的山壁上一道黑黝黝的裂口，離地約有三四丈，站在路上夠不著。裂口邊緣的岩石磨得發亮，像是常有東西從那裡吊上吊下。\n"

msgid "油布"
msgstr "油布"

msgid "钻进车里"
msgstr "鑽進車裡"

msgid "油布底下是供品的箱子。钻进去，就只能跟着箱子一起被吊上裂口，中途下不来。"
msgstr "油布底下是供品的箱子。鑽進去，就只能跟著箱子一起被吊上裂口，中途下不來。"

msgid "钻进去"
msgstr "鑽進去"

msgid "你掀开油布一角，缩进两只箱子中间。油布落下来，眼前一黑。\n"
msgstr "你掀開油布一角，縮進兩隻箱子中間。油布落下來，眼前一黑。\n"

msgid "过了一会儿，车板一震，绳子绷紧了——你和箱子一起离了地，在半空里晃了半天，咚的一声落在硬地上。\n"
msgstr "過了一會兒，車板一震，繩子繃緊了——你和箱子一起離了地，在半空裡晃了半天，咚的一聲落在硬地上。\n"

msgid "车停在那里，油布底下空空的，绳子松着——没人拉绳，钻进去也上不去。\n"
msgstr "車停在那裡，油布底下空空的，繩子松著——沒人拉繩，鑽進去也上不去。\n"

msgid "绳索"
msgstr "繩索"

msgid "攀绳上去"
msgstr "攀繩上去"

msgid "你抓住垂下的麻绳，手脚并用地攀上裂口。岩壁磨得发亮，上头有绞盘吱吱的响声。\n"
msgstr "你抓住垂下的麻繩，手腳並用地攀上裂口。岩壁磨得發亮，上頭有絞盤吱吱的響聲。\n"

msgid "你戴着黑冠，押车的道士只当你是宫里的人，没人拦你。你抓住麻绳，手脚并用地攀上裂口。\n"
msgstr "你戴著黑冠，押車的道士只當你是宮裡的人，沒人攔你。你抓住麻繩，手腳並用地攀上裂口。\n"

msgid "押车道士盯着你，手按在剑柄上：「此处无路，施主请回。」\n"
msgstr "押車道士盯著你，手按在劍柄上：「此處無路，施主請回。」\n"

msgid "裂口离地三四丈，壁上光溜溜的，没有绳子上不去。\n"
msgstr "裂口離地三四丈，壁上光溜溜的，沒有繩子上不去。\n"

msgid "鹿皮小靴"
msgstr "鹿皮小靴"

msgid "紫玉宝剑"
msgstr "紫玉寶劍"

msgid "这是一把宝剑，隐含神秘力量。\n"
msgstr "這是一把寶劍，隱含神秘力量。\n"

msgid "布裙"
msgstr "布裙"

msgid "只有女生才可穿哦!你变态呀! \n"
msgstr "只有女生才可穿哦!你變態呀! \n"

msgid "绿罗裙"
msgstr "綠羅裙"

msgid "长鞭"
msgstr "長鞭"

msgid "绵裙"
msgstr "綿裙"

msgid "柳玉刀"
msgstr "柳玉刀"

msgid "这是一柄纤细的柳玉刀，轻薄短小。\n"
msgstr "這是一柄纖細的柳玉刀，輕薄短小。\n"

msgid "绣花鞋"
msgstr "繡花鞋"

msgid "银翅金簪"
msgstr "銀翅金簪"

msgid "支"
msgstr "支"

msgid "青绫绸裙"
msgstr "青綾綢裙"

msgid "玉竹剑"
msgstr "玉竹劍"

msgid "这是一把用竹子作成的玉竹剑，手工细腻别致。\n"
msgstr "這是一把用竹子作成的玉竹劍，手工細膩別緻。\n"

msgid "这是一封用蜡密封起来的信件，上面有一奇怪的图案。\n"
msgstr "這是一封用蠟密封起來的信件，上面有一奇怪的圖案。\n"

msgid "封"
msgstr "封"

msgid "用火烧"
msgstr "用火燒"

msgid "你看见密函上出现几行字 : \n"
msgstr "你看見密函上出現幾行字 : \n"

msgid "师父: \n      展信愉悦 \n    徒儿在晚月庄作客已有一阵子了!\n在这徒儿无意中发现晚月庄的秘密。\n一、原来晚月庄主是同性恋，她似乎在对男人失望之馀，\n    对比自己年轻的姑娘由恨转而成一种变相畸型的爱。\n二、在密室之中藏有一秘笈。以及庄内有一处有神奇宝物\n    玛瑙手镯。在另一神秘的地方有通往庄主秘密情人的\n    密室入口。\n三、在庄内小花池中有火神族的神像。小花池似乎有神奇\n    的力量在里头。\n"
msgstr "師父: \n      展信愉悅 \n    徒兒在晚月莊作客已有一陣子了!\n在這徒兒無意中發現晚月莊的秘密。\n一、原來晚月莊主是同性戀，她似乎在對男人失望之餘，\n    對比自己年輕的姑娘由恨轉而成一種變相畸型的愛。\n二、在密室之中藏有一秘笈。以及莊內有一處有神奇寶物\n    瑪瑙手鐲。在另一神秘的地方有通往莊主秘密情人的\n    密室入口。\n三、在莊內小花池中有火神族的神像。小花池似乎有神奇\n    的力量在裡頭。\n"

msgid "你身上没有火没法烧。\n"
msgstr "你身上沒有火沒法燒。\n"

msgid "杀手令牌"
msgstr "殺手令牌"

msgid "一个黑木作的杀手令牌，上面刻著火焰的图腾标志。\n"
msgstr "一個黑木作的殺手令牌，上面刻著火焰的圖騰標誌。\n"

msgid "宫保鸡丁"
msgstr "宮保雞丁"

msgid "这是一道香辣可口的佳肴。\n"
msgstr "這是一道香辣可口的佳餚。\n"

msgid "只"
msgstr "隻"

msgid "水饺"
msgstr "水餃"

msgid "这是一个手工细腻的水饺，看起来很好吃。\n"
msgstr "這是一個手工細膩的水餃，看起來很好吃。\n"

msgid "女儿红"
msgstr "女兒紅"

msgid "这是一坛香味浓郁的陈年老酒，是存给待嫁女儿喝的酒。\n你闻了闻，好香好香哦!你有点想喝它\n"
msgstr "這是一罈香味濃郁的陳年老酒，是存給待嫁女兒喝的酒。\n你聞了聞，好香好香哦!你有點想喝它\n"

msgid "坛"
msgstr "罈"

msgid "脆皮烤鸭"
msgstr "脆皮烤鴨"

msgid "这是一只看了都会流口水的、香喷喷的烤鸭。\n"
msgstr "這是一隻看了都會流口水的、香噴噴的烤鴨。\n"

msgid "火摺"
msgstr "火摺"

msgid "这是一个可以生火的火摺"
msgstr "這是一個可以生火的火摺"

msgid "腰带"
msgstr "腰帶"

msgid "耳环"
msgstr "耳環"

msgid "这是一串用宝石镶串成的闪亮耳环。\n"
msgstr "這是一串用寶石鑲串成的閃亮耳環。\n"

msgid "串"
msgstr "串"

msgid "钻石胸针"
msgstr "鑽石胸針"

msgid "这是一个用钻石镶成的美丽胸饰。\n"
msgstr "這是一個用鑽石鑲成的美麗胸飾。\n"

msgid "宝蓝缎衫"
msgstr "寶藍緞衫"

msgid "碧玉红裎带"
msgstr "碧玉紅裎帶"

msgid "这是一条丝绸制的彩带，质感佳，上绣有彩霞江水纹。\n"
msgstr "這是一條絲綢製的彩帶，質感佳，上繡有彩霞江水紋。\n"

msgid "珍珠项链"
msgstr "珍珠項鍊"

msgid "丝罗巾"
msgstr "絲羅巾"

msgid "这卷罗巾由上等丝绸编成，绣了一幅幅美女图。个个体态轻盈，翩然\n起舞。每一曲舞步姿态美妙迷人，旁题著舞曲名称与步法。\n"
msgstr "這卷羅巾由上等絲綢編成，繡了一幅幅美女圖。個個體態輕盈，翩然\n起舞。每一曲舞步姿態美妙迷人，旁題著舞曲名稱與步法。\n"

msgid "卷"
msgstr "卷"

msgid "冰玉戒指"
msgstr "冰玉戒指"

msgid "青纱裙"
msgstr "青紗裙"

msgid "护身符"
msgstr "護身符"

msgid "雪花糕"
msgstr "雪花糕"

msgid "这是一块精致可口的小点心，似雪花般柔软。\n"
msgstr "這是一塊精緻可口的小點心，似雪花般柔軟。\n"

msgid "块"
msgstr "塊"

msgid "竹子"
msgstr "竹子"

msgid "这是一根玉竹，还有一些竹叶在上面。\n"
msgstr "這是一根玉竹，還有一些竹葉在上面。\n"

msgid "绣花针"
msgstr "繡花針"

msgid "一种上等铁做成的绣花针\n"
msgstr "一種上等鐵做成的繡花針\n"

msgid "花针"
msgstr "花針"

msgid "一种铁做成的绣花针\n"
msgstr "一種鐵做成的繡花針\n"

msgid "红桂花"
msgstr "紅桂花"

msgid "才摘的桂花，发出阵阵淡淡的幽香。\n"
msgstr "才摘的桂花，發出陣陣淡淡的幽香。\n"

msgid "粒"
msgstr "粒"

msgid "小花蕊"
msgstr "小花蕊"

msgid "这是一朵金黄色的奇特花蕊，有一种淡淡香气。\n"
msgstr "這是一朵金黃色的奇特花蕊，有一種淡淡香氣。\n"

msgid "朵"
msgstr "朵"

msgid "株"
msgstr "株"

msgid "玉瓷茶杯"
msgstr "玉瓷茶杯"

msgid "这是一杯香味浓郁上等好茶。是招待贵宾品茗的。\n你闻了闻，好香好香哦!\n"
msgstr "這是一杯香味濃郁上等好茶。是招待貴賓品茗的。\n你聞了聞，好香好香哦!\n"

msgid "杯"
msgstr "杯"

msgid "金轩茶"
msgstr "金軒茶"

msgid "竹蜻蜓"
msgstr "竹蜻蜓"

msgid "这是一个竹蜻蜓，手工相当细腻。\n"
msgstr "這是一個竹蜻蜓，手工相當細膩。\n"

msgid "玛瑙手镯"
msgstr "瑪瑙手鐲"

msgid "一个由玛瑙作成的美丽手镯。\n再仔细玩看，似乎有其它作用。\n"
msgstr "一個由瑪瑙作成的美麗手鐲。\n再仔細玩看，似乎有其它作用。\n"

msgid "祈祷"
msgstr "祈禱"

msgid "你双手合掌，虔诚的祈祷。\n手上的镯子嗡嗡作响。 突然一阵烟雾.... \n"
msgstr "你雙手合掌，虔誠的祈禱。\n手上的鐲子嗡嗡作響。 突然一陣煙霧.... \n"

msgid "舞曲谱"
msgstr "舞曲譜"

msgid "这是一卷由上等丝绸编成，以湘绣作成的舞曲图。上有记载一些舞曲 \n每一曲都有它独特的风格与内涵。一幅幅玄天玉女翩然起舞，十分壮观。\n\n  曲目： \n \n  广陵散 \n  春宫怨 \n \n对你而言基本舞步你可以参悟，至于较高深步法似乎需人指导了。 \n"
msgstr "這是一卷由上等絲綢編成，以湘繡作成的舞曲圖。上有記載一些舞曲 \n每一曲都有它獨特的風格與內涵。一幅幅玄天玉女翩然起舞，十分壯觀。\n\n  曲目： \n \n  廣陵散 \n  春宮怨 \n \n對你而言基本舞步你可以參悟，至於較高深步法似乎需人指導了。 \n"

msgid "跳「春宫怨」"
msgstr "跳「春宮怨」"

msgid "你双手合掌，脚步轻盈。一曲『 春宫怨 』......\n"
msgstr "你雙手合掌，腳步輕盈。一曲『 春宮怨 』......\n"

msgid "这似乎是一本寒雪鞭法的前几页，虽然并没有关於招式的详细解说，可是\n前面有关鞭法的总纲与精义倒是不少。\n"
msgstr "這似乎是一本寒雪鞭法的前幾頁，雖然並沒有關於招式的詳細解說，可是\n前面有關鞭法的總綱與精義倒是不少。\n"

msgid "黄金令牌"
msgstr "黃金令牌"

msgid "一个闪闪发亮的黄金令牌，上有一些图腾标志。\n"
msgstr "一個閃閃發亮的黃金令牌，上有一些圖騰標誌。\n"

msgid "戒刀"
msgstr "戒刀"

msgid "这是一把僧人练武用的戒刀，份量大约四、五斤重。\n"
msgstr "這是一把僧人練武用的戒刀，份量大約四、五斤重。\n"

msgid "灰布僧衣"
msgstr "灰布僧衣"

msgid "黑眼罩"
msgstr "黑眼罩"

msgid "副"
msgstr "副"

msgid "僧鞋"
msgstr "僧鞋"

msgid "青布僧衣"
msgstr "青布僧衣"

msgid "菜刀"
msgstr "菜刀"

msgid "一把不很利的菜刀, 不过拿来切菜砍肉还是绰绰有馀的。\n"
msgstr "一把不很利的菜刀, 不過拿來切菜砍肉還是綽綽有餘的。\n"

msgid "竹扫把"
msgstr "竹掃把"

msgid "一把快秃了头的竹扫把。\n"
msgstr "一把快禿了頭的竹掃把。\n"

msgid "馒头"
msgstr "饅頭"

msgid "一个香喷喷、热腾腾的大馒头。\n"
msgstr "一個香噴噴、熱騰騰的大饅頭。\n"

msgid "一棵翠绿色的小草，发着晶莹的光芒和醉人的香味。\n"
msgstr "一棵翠綠色的小草，發著晶瑩的光芒和醉人的香味。\n"

msgid "棵"
msgstr "棵"

msgid "乌檀木刀"
msgstr "烏檀木刀"

msgid "这是一把黑黝黝的乌檀木刀，闻起来有一股淡淡的香气。\n"
msgstr "這是一把黑黝黝的烏檀木刀，聞起來有一股淡淡的香氣。\n"

msgid "这是时下读书人常看的书籍。\n"
msgstr "這是時下讀書人常看的書籍。\n"

msgid "「嘉德文选」"
msgstr "「嘉德文選」"

msgid "「九韬」"
msgstr "「九韜」"

msgid "「太公辩」"
msgstr "「太公辯」"

msgid "「梁父文集」"
msgstr "「梁父文集」"

msgid "「说律」"
msgstr "「說律」"

msgid "「古文志」"
msgstr "「古文志」"

msgid "「乡书」"
msgstr "「鄉書」"

msgid "「佾风斋诗集」"
msgstr "「佾風齋詩集」"

msgid "「寒士列传」"
msgstr "「寒士列傳」"

msgid "「水龙图注」"
msgstr "「水龍圖注」"

msgid "轻罗绸衫"
msgstr "輕羅綢衫"

msgid "这是一件有钱人家的小姐穿著的衣物，手工相当细致。\n"
msgstr "這是一件有錢人家的小姐穿著的衣物，手工相當細緻。\n"

msgid "银簪"
msgstr "銀簪"

msgid "平安符"
msgstr "平安符"

msgid "一个用红线绑著的平安符，据说可以避邪。\n"
msgstr "一個用紅線綁著的平安符，據說可以避邪。\n"

msgid "玉带冠"
msgstr "玉帶冠"

msgid "这是一顶镶著美玉的帽冠。\n"
msgstr "這是一頂鑲著美玉的帽冠。\n"

msgid "大饼"
msgstr "大餅"

msgid "一个香喷喷、热腾腾的大烧饼。\n"
msgstr "一個香噴噴、熱騰騰的大燒餅。\n"

msgid "糖葫芦"
msgstr "糖葫蘆"

msgid "一串看起来就让人垂涎欲滴的糖渍葫芦。\n"
msgstr "一串看起來就讓人垂涎欲滴的糖漬葫蘆。\n"

msgid "红龟"
msgstr "紅龜"

msgid "一个大红龟，上面盖了个印子：保境安民。\n"
msgstr "一個大紅龜，上面蓋了個印子：保境安民。\n"

msgid "圆溜溜的山药蛋，忒新鲜。\n"
msgstr "圓溜溜的山藥蛋，忒新鮮。\n"

msgid "从寿衣撕下的布条"
msgstr "從壽衣撕下的布條"

msgid "这条布条是从一件寿衣上撕下来的，上面密密麻麻写了许多字。\n"
msgstr "這條布條是從一件壽衣上撕下來的，上面密密麻麻寫了許多字。\n"

msgid "一个刻工相刚精细的桃木箱，也许是用来装首饰用的。\n"
msgstr "一個刻工相剛精細的桃木箱，也許是用來裝首飾用的。\n"

msgid "翻看"
msgstr "翻看"

msgid "箱底的夹层空了，抄本已经在你手里。\n"
msgstr "箱底的夾層空了，抄本已經在你手裡。\n"

msgid "你翻看桃木箱：首饰早没了，底板却比箱壁厚得不像话。你抠开底板——夹层里是一卷发黄的纸。\n"
msgstr "你翻看桃木箱：首飾早沒了，底板卻比箱壁厚得不像話。你摳開底板——夾層裡是一卷發黃的紙。\n"

msgid "仙丹"
msgstr "仙丹"

msgid "这是一粒仙丹，服食可位列仙班。\n"
msgstr "這是一粒仙丹，服食可位列仙班。\n"

msgid "缚仙绳"
msgstr "縛仙繩"

msgid "这是一条由上等金丝编成的绳索, 可缚禽兽鬼怪。上刻有无数咒文，发出耀目金光.\n"
msgstr "這是一條由上等金絲編成的繩索, 可縛禽獸鬼怪。上刻有無數咒文，發出耀目金光.\n"

msgid "缚"
msgstr "縛"

msgid "你双手合掌，随风而起，落于仙鹤背上......\n"
msgstr "你雙手合掌，隨風而起，落於仙鶴背上......\n"

msgid "你要缚何物? \n"
msgstr "你要縛何物? \n"

msgid "寒谷幽兰"
msgstr "寒谷幽蘭"

msgid "一株寒谷幽兰，散发着淡淡的香气, 你似乎在晚月庄闻到过.\n"
msgstr "一株寒谷幽蘭，散發著淡淡的香氣, 你似乎在晚月莊聞到過.\n"

msgid "「白杨经」"
msgstr "「白楊經」"

msgid "这是一本讲述吐纳、养生之法的古书，现在已经不多见了。\n"
msgstr "這是一本講述吐納、養生之法的古書，現在已經不多見了。\n"

msgid "紫罗鸳鸯荷包"
msgstr "紫羅鴛鴦荷包"

msgid "一个绣工十分精细的紫色丝绸荷包，上面绣著一对鸳鸯。\n"
msgstr "一個繡工十分精細的紫色絲綢荷包，上面繡著一對鴛鴦。\n"

msgid "这是隐士们常看的书籍。\n"
msgstr "這是隱士們常看的書籍。\n"

msgid "「笑傲江湖」"
msgstr "「笑傲江湖」"

msgid "「天龙八部」"
msgstr "「天龍八部」"

