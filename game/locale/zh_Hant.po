msgstr "天邪派——顏違。"

msgid "天邪派——卫盟主。"
msgstr "天邪派——衛盟主。"

msgid "天邪派——旧盟主。"
msgstr "天邪派——舊盟主。"

msgid "天邪派——投你。"
msgstr "天邪派——投你。"

msgid "天邪派——没有来，不算。"
msgstr "天邪派——沒有來，不算。"

