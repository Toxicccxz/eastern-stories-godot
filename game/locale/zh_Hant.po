msgstr "你歇了{time}，站了起來。"

msgid "你歇了{time}，忽然有人来袭，你一跃而起！"
msgstr "你歇了{time}，忽然有人來襲，你一躍而起！"

msgid "你歇了{time}，身上一阵难受，歇不下去了。"
msgstr "你歇了{time}，身上一陣難受，歇不下去了。"

msgid "你歇了{time}，口干舌燥，再歇也回不过来：先找水喝。"
msgstr "你歇了{time}，口乾舌燥，再歇也回不過來：先找水喝。"

msgid "你歇了{time}，听见动静，站了起来。"
msgstr "你歇了{time}，聽見動靜，站了起來。"

msgid "你歇了{time}。"
msgstr "你歇了{time}。"

