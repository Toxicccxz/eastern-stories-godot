msgid "你闭目凝神，神游物外，开始修习茅山道术中的法术...."
msgstr ""

msgid "可是你心思一乱，变出了一只面目狰狞的$N！"
msgstr ""

msgid "你的魂魄正被$N缠住，快把它除掉吧！"
msgstr ""

msgid "你的魂魄还没有全部收回，赶快杀死你的$N吧！"
msgstr ""

msgid "天师正道"
msgstr "Путь Небесных наставников"

msgid "道家的主要学问，茅山派大多数武功、法术都要以它为基础。天师正道修行不够就强练道家武功法术，很容易走火入魔、坠入魔道；杀气太重的人，也修不了它。"
msgstr ""

msgid "法术类技能必须用学的或是从实战中获取经验。"
msgstr ""

msgid "你的杀气太重，无法修炼天师正道。"
msgstr ""

msgid "谷衣心法"
msgstr "Метод зернового покрова"

msgid "道家的一门内功。人食五谷，肉身都带五谷秽气，谷衣心法把秽气排出体外，修成一层护体之气，叫作「谷衣」——神仙所修称「丹衣」，妖魔所修称「血衣」「土衣」。心法共分十层，练到第五层「小成」左眼珠变成金色，第十层「大成」两眼皆金；运起来能疗伤，也能以「灵神诀」把内力化为法力。"
msgstr ""

msgid "谷衣心法只能用学的，或是从运用中增加熟练度。"
msgstr ""

msgid "你的魔力不够，无法提升谷衣心法的造诣。"
msgstr ""

msgid "天师剑法"
msgstr "Меч Небесного наставника"

msgid "茅山派的剑法，招名「三清归真」「众士护佑」「群魔辟易」「西出紫关」，取道家护法驱魔之意。练这门剑须有相当的内力。"
msgstr ""

msgid "你按著所学练了一遍天师剑法。"
msgstr ""

msgid "你的内力或气不够，没有办法练习天师剑法。"
msgstr ""

msgid "你的内力不够，没有办法练天师剑法。"
msgstr ""

msgid "$N一招「三清归真」，手中$w挽起几个剑花，刺向$n的$l"
msgstr ""

msgid "$N身形一变，一招「众士护佑」，$w罩向$n的$l"
msgstr ""

msgid "$N挥动$w，一招「天人合一」挟著闪闪剑光袭向$n的$l"
msgstr ""

msgid "$N手中$w一抡，使出「群魔辟易」往$n的$l恶狠狠的砍去"
msgstr ""

msgid "$N一招「西出紫关」，$w一带，轻轻划向$n$l"
msgstr ""

msgid "$N身剑合一，幻化成一道光华，一招「乾坤一掷」扑向$n"
msgstr ""

msgid "读书识字"
msgstr "Грамота"

msgid "认字读书的本事。不识字就读不了任何书谱；识字越深，研读书册时长进越快。勤学苦读，悟性也会慢慢提高，有些讲究文墨的心法也要它做底子。"
msgstr ""

msgid "由於你的勤学苦读，你的悟性提高了。"
msgstr ""

msgid "音律"
msgstr "Музыка"

msgid "宫商声律的学问。音律之学有成，灵性会随之提高；步玄派的步玄七诀以音律为根底，音律修为不够，便领悟不了更深的诀窍。"
msgstr ""

msgid "由於你学习音律之学有成，你的灵性提高了"
msgstr ""

msgid "乐器"
msgstr "Игра на инструментах"

msgid "吹拉弹拨的技艺，与音律之学互为表里。步玄派掌门骆云舟也传这一门。"
msgstr ""

msgid "基本行动"
msgstr "Основы движения"

msgid "赶路奔走的根底。脚下快的人追得上人，也甩得开追兵；倒乱七星步、步玄七诀、火蝠身法这类身法，都能激发为行动。"
msgstr ""

msgid "基本杖法"
msgstr "Основы боя посохом"

msgid "使杖、使棍的根底。山烟寺的流云杖法、绝尘派的金刚杖法都激发在它上面。"
msgstr ""

msgid "基本暗器"
msgstr "Основы скрытого оружия"

msgid "暗器出手的功夫，准头与劲道都看它。晚月庄、花紫会的人多精于此道。"
msgstr ""

msgid "听风辨器之术"
msgstr "Искусство слышать ветер"

msgid "临敌时凭风声辨出兵刃来路的本事，专门用来对付看不见的敌人：鬼魂、隐形的妖物，或是在光线昏暗的地方交手。"
msgstr ""

msgid "顺手牵羊的手上功夫，下手越熟越不易被人察觉，运气好坏也有几分关系。花紫会龙头陆得财懂这一手，街上的飞贼也靠它吃饭。"
msgstr ""

msgid "天邪神掌"
msgstr "Великая ладонь Тяньсе"

msgid "模拟灵兽天邪虎神态的掌法，与天邪神功相配而成，招式有「大天罗式」「小天罗式」「雪阳三连月」「灵动五方鼓」「风雷七星断」。须空手练，天邪神功火候不足、内力太弱都练不成。"
msgstr ""

msgid "你的内力不够了，休息一下再练吧。"
msgstr ""

msgid "练天邪神掌必须空手。"
msgstr ""

msgid "你的天邪神功火候不足，无法练天邪掌法。"
msgstr ""

msgid "你的内力太弱，无法练天邪掌法。"
msgstr ""

msgid "$N使出一招「大天罗式」，右掌穿出击向$n的$l"
msgstr ""

msgid "$N使出一招「大天罗式」，左掌化虚为实击向$n的$l"
msgstr ""

msgid "$N使出天邪掌法「小天罗式」，如鬼魅般欺至$n身前，一掌拍向$n的$l"
msgstr ""

msgid "$N双掌一错，使出「雪阳三连月」，对准$n的$l连续拍出三掌"
msgstr ""

msgid "$N左掌画了个圈圈，右掌推出，一招「灵动五方鼓」击向$n$l"
msgstr ""

msgid "$N使出「风雷七星断」，身形散作七处同时向$n的$l出掌攻击"
msgstr ""

msgid "$N吐气扬声，一招「气撼九重天」双掌并力推出"
msgstr ""

msgid "六阴追魂剑法"
msgstr "Меч шести инь, ловец душ"

msgid "本是道家魔道的武功。三百年前一位天邪派前辈在首穷山一处废墟中得到六阴剑谱，谱分天殇、追魂、绝识三部，他年轻时练武伤了经脉，只练成追魂一部，另外两部至今下落不明。天邪派所传的追魂剑经三百多年演变，戾气消去不少而劲道更增，虽已失传了不少阴毒招式，仍是武林中赫赫有名的剑法。"
msgstr ""

msgid "你按著所学练了一遍六阴追魂剑法。"
msgstr ""

msgid "你的内力或气不够，没有办法练习六阴追魂剑。"
msgstr ""

msgid "你的内力不够，没有办法练六阴追魂剑。"
msgstr ""

msgid "你突然觉得一股恶气冲上心头，只觉得想杀人...."
msgstr ""

msgid "$N使一招「群魔乱舞」，手中$w狂风骤雨般地向$n的$l连攻数剑"
msgstr ""

msgid "$N身形一转，一招「厉鬼缠身」$w斩向$n的$l"
msgstr ""

msgid "$N舞动$w，一招「百鬼夜行」挟著闪闪剑光刺向$n的$l"
msgstr ""

msgid "$N手中$w一抖，使出「饿鬼拦路」往$n的$l刺出一剑"
msgstr ""

msgid "$N手中$w剑光暴长，一招「鬼影幢幢」往$n$l刺去"
msgstr ""

msgid "$N手中$w直指$n$l，一招「秋坟鬼唱」发出逼人剑气刺去"
msgstr ""

msgid "火蝠身法"
msgstr "Шаг огненной летучей мыши"

msgid "仿蝙蝠夜飞的身法，招名「寒蝠掠江」「轻蝠点梢」「夜蝠旋身」「火蝠曳空」，侧身一让，便叫来招扑了个空。天邪派与振远镖局都有高手使这门身法。"
msgstr ""

msgid "你的体力太差了，不能练火蝠身法。"
msgstr ""

msgid "可是$p侧身一让，使出「寒蝠掠江」，$N这一招扑了个空。"
msgstr ""

msgid "$p身形微晃，使出「灵蝠轻逝」，有惊无险地避开了$N这一招。"
msgstr ""

msgid "$p身随意转，一式「轻蝠点梢」，倏地往一旁挪开了三尺，避过了这一招。"
msgstr ""

msgid "却见$p足不点地，一招「夜蝠旋身」，往旁窜开数尺，躲了开去。"
msgstr ""

msgid "只见$p一招「火蝠曳空」，身形向上拔起数尺高，闪了过去。"
msgstr ""

msgid "七宝天岚舞"
msgstr "Танец небесной дымки"

msgid "晚月庄的舞步身法，招名「蕙芳下凡」「双成献舞」「织女于归」「天女散花」「嫦娥奔月」，翩然起舞之间，已飘出数尺之外。只有女子才能练，又看灵性；勤练舞技，容貌也会更添光彩。"
msgstr ""

msgid "你的精神太差了，不能练七宝天岚舞。"
msgstr ""

msgid "七宝天岚舞只有女性才能练。"
msgstr ""

msgid "你的灵性不够，没有办法练七宝天岚舞。"
msgstr ""

msgid "由於你勤练舞技，你的容貌提高了"
msgstr ""

msgid "但$n一式「蕙芳下凡」随著轻轻一叹，顺著$N的招式飘出六尺之外！"
msgstr ""

msgid "$n双脚微动翩然起舞，一招「双成献舞」，堪堪闪过$N的这招！"
msgstr ""

msgid "$n使出「织女于归」，突然幻化成一双倩影，$N从其中一人透体而过！"
msgstr ""

msgid "$n一式「天女散花」，自水袖中散出一片花雨，$N被花影迷蒙了双眼，与$n擦肩而过"
msgstr ""

msgid "$n一招「嫦娥奔月」，轻轻一纵优雅的自$N头顶越过！"
msgstr ""

msgid "基本法术"
msgstr "Основы чародейства"

msgid "神通一类法门的根底：灵力的上限看它，施展神通要用灵力。山烟寺的八识神通便激发在它上面。"
msgstr ""

msgid "基本咒文"
msgstr "Основы заклинаний"

msgid "念咒施法的根底：法力的上限看它，冥思积下的法力才有地方存。茅山道术、奇门遁甲这些法术都激发在它上面。"
msgstr ""

msgid "小天魔道"
msgstr "Малый путь Небесного демона"

msgid "道家旁门的一路学问，绝尘派的奇门遁甲以它为根基，小天魔道修为不够，便领悟不了更深的遁甲之术。它只能向师父学，或在实战中体会；每有长进，杀气也跟着重一分。"
msgstr ""

msgid "奇门遁甲"
msgstr "Искусство чудесных врат"

msgid "绝尘派的法术。口中念咒，大喝一声「疾！」，或化作黑气、金光、火焰、长虹、大雾遁去无踪，或以黑气、金光、火焰、海水、大木把敌人困在当中；战到危急，还能召来天将相助。须以小天魔道为根基。"
msgstr ""

msgid "你的小天魔道修为不够，无法领悟更高深的奇门遁甲之术。"
msgstr ""

msgid "绝尘心法"
msgstr "Метод Цзюэчэнь"

msgid "绝尘派的本门内功。绝尘子本是释家中人，后得奇人指点，悟得道家真谛，佛道双修，自号绝尘，创下此派；这门心法只能向师父学，或在运功中慢慢精熟。"
msgstr ""

msgid "绝尘心法只能用学的或是从运用中增加熟练度。"
msgstr ""

msgid "金刚杖法"
msgstr "Алмазный посох"

msgid "绝尘派所传的杖法，招式与山烟寺的流云杖法相同，是「天光乍现」「雨后初晴」「浮云写意」「游龙穿云」四式，起手一杖专扫下盘。练这门杖须有相当的膂力，膂力不足的人宜先把内力练足。"
msgstr ""

msgid "你必须先找一根木杖或者是类似的武器，才能练杖法。"
msgstr ""

msgid "你的体力不够练这门杖法，还是先休息休息吧。"
msgstr ""

msgid "你的膂力还不够，也许该练一练内力来增强力量。"
msgstr ""

msgid "$N使一招「天光乍现」，手中$w扫向$n下盘！"
msgstr ""

msgid "挫伤"
msgstr ""

msgid "$N挥起$w，一招「雨後初晴」攻向$n$l！"
msgstr ""

msgid "$N横过手中$w，使出「浮云写意」击向$n$l！"
msgstr ""

msgid "$N使出一招「游龙穿云」，$w一挺撞向$n$l！"
msgstr ""

msgid "流云杖法"
msgstr "Посох плывущих облаков"

msgid "山烟寺的杖法，招名「天光乍现」「雨后初晴」「浮云写意」「游龙穿云」，可攻可守。番坊日陀罗寺的龙若法王也传这门杖法。练这门杖须有相当的膂力。"
msgstr ""

msgid "莲华心法"
msgstr "Метод лотоса"

msgid "五百多年前北冥大泽的黑妖蛇族入侵，一群佛门高僧集思广益，悟出这套心法为百姓疗伤，主要用来迅速医治战斗中所受的皮肉创伤。运起功来既能医治自己，也能替别人疗伤；须以大乘佛法为根基，佛法修为跟不上，便领会不了更深的境界。"
msgstr ""

msgid "莲华心法只能用学的，或是从运用中增加熟练度。"
msgstr ""

msgid "你的大乘佛法修为不够，无法领会更高深的莲华心法。"
msgstr ""

msgid "婆萝蜜多心经"
msgstr "Сутра сердца"

msgid "从天竺传来的一部内功，性子是火性的：运起来浑身发热，专克阴寒。只能用学的，没有运功的法门；中原只有日陀罗寺的人会，独眼头陀那只眼就是练它练坏的。"
msgstr ""

msgid "婆萝蜜多心经只能用学的。"
msgstr ""

msgid "大乘佛法"
msgstr "Учение Махаяны"

msgid "佛门的根本学问，莲华心法、八识神通都以它为根基。杀气太重的人，修不了大乘佛法。"
msgstr ""

msgid "你的杀气太重，无法修炼大乘佛法。"
msgstr ""

msgid "诵经"
msgstr "Чтение сутр"

msgid "佛门弟子的日课，晨钟暮鼓之间念诵经文。山烟寺、日陀罗寺的僧人都会这一门。"
msgstr ""

msgid "八识神通"
msgstr "Дар восьми сознаний"

msgid "佛家一门十分神奇的神通法术，由六百年前的高僧空正大师传下。神通分为八识，各以人的一种隐藏潜力为动力，如今传下来的有三识：心识救醒昏迷濒死之人，游识一念之间便到你见过的人身边，空识把灵力化为潜能。须与高深的佛法相辅，佛法修为不够便学不了。"
msgstr ""

msgid "你的佛法修为还不够高深，无法学习八识神通。"
msgstr ""

msgid "基本鞭法"
msgstr "Основы боя плетью"

msgid "使鞭的根底，软鞭出手要收得回来。晚月庄的寒雪鞭法激发在它上面。"
msgstr ""

msgid "基本锤法"
msgstr "Основы боя молотом"

msgid "使锤一类重兵器的根底，凭的是一身力气。"
msgstr ""

msgid "基本斧法"
msgstr "Основы боя топором"

msgid "使斧的根底，大开大合，一斧下去要劈得开。"
msgstr ""

msgid "基本匕法"
msgstr "Основы боя кинжалом"

msgid "使匕首一类短刃的根底，贴身近打，出手要快。"
msgstr ""

msgid "基本叉法"
msgstr "Основы боя трезубцем"

msgid "使钢叉一类长兵的根底。阴间的鬼卒，手里多是钢叉。"
msgstr ""

msgid "柔虹指"
msgstr "Палец мягкой радуги"

msgid "晚月庄的指法，只有女子才能练，须空手。招名「菊楼采月」「雪桥翦梅」「柳亭簪花」「桃坟扑蝶」，身影忽前忽后，一转身指尖已点到要害。"
msgstr ""

msgid "你的内力不够了。"
msgstr ""

msgid "你的精神无法集中了，休息一下再练吧。"
msgstr ""

msgid "柔虹指是只有女子才能练的武功。"
msgstr ""

msgid "练柔虹指必须空手。"
msgstr ""

msgid "$N左手一挥，一招「菊楼采月」右手点向$n$l"
msgstr ""

msgid "右手食指"
msgstr ""

msgid "$N使一招「雪桥翦梅」，身影忽前忽後，突然一转身左手往$n的$l点去"
msgstr ""

msgid "左手中指"
msgstr ""

msgid "$N身法稍顿，左手一扬使出「柳亭簪花」往$n的$l点去"
msgstr ""

msgid "只见$N纤腰一摆，陡然滑出数尺，右手顺著来势一招「桃坟扑蝶」往$n的$l点去"
msgstr ""

msgid "寒雪鞭法"
msgstr "Плеть холодного снега"

msgid "晚月庄的鞭法，从「寒风起兮」「漫天飞雪」到「狂风骤雪」「风雪交加」，鞭影如满天飞雪，虚虚实实地袭人。须有足够的内力才能练。"
msgstr ""

msgid "你按著所学练了一遍寒雪鞭法。"
msgstr ""

msgid "你的内力或气不够，没有办法练习寒雪鞭法。"
msgstr ""

msgid "你的内力不够，没有办法练寒雪鞭法, 多练些内力再来吧。"
msgstr ""

msgid "你必须先找一条鞭子才能练鞭法。"
msgstr ""

msgid "$N使一招「寒风起兮」，手中$w抖得笔直向$n的$l连刺数鞭"
msgstr ""

msgid "$N身形一转，一招「漫天飞雪」$w幻出满天鞭影，虚虚实实地袭向$n的$l"
msgstr ""

msgid "$N力贯$w，一招「雪花翩翩」点点鞭影飘浮不定地点向$n的$l"
msgstr ""

msgid "$N手中$w一抖，一招「积雪三尺」以一个怪异的角度往$n下盘卷去"
msgstr ""

msgid "$N手中一紧，使招「狂风骤雪」，手里$w一鞭接著一鞭不停地抽向$n的$l"
msgstr ""

msgid "鞭伤"
msgstr ""

msgid "$N一招「风雪交加」手中$w舞出一片鞭影扫向$n全身"
msgstr ""

msgid "意寒功"
msgstr "Искусство ледяной воли"

msgid "三十年前以一柄拂尘横扫武林的前辈异人残心师太所创的内功心法，纯走阴柔之路，发出的内劲寒冷无比；传说她曾在沙牢山一掌冻住七只雪狼，堪称当今寒冰掌一路中最凌厉的奇功。交手时阴寒之气常叫对方打个寒噤，运起「意寒睨」，更能以冰冷如刀的眼神伤敌。"
msgstr ""

msgid "$N的招式挟著一股阴寒无比的劲风使得$n不禁打了个寒噤。"
msgstr ""

msgid "意寒功只能用学的，或是从运用中增加熟练度。"
msgstr ""

msgid "雪影心法"
msgstr "Метод снежной тени"

msgid "天山一脉的独门内功，只能向师父学，或在运功中慢慢精熟；雪影剑法必须以它为根基。"
msgstr ""

msgid "天山雪影心法只能用学的或是从运用中增加熟练度。"
msgstr ""

msgid "雪影剑法"
msgstr "Меч снежной тени"

msgid "天山雪影剑，招名「回光幻电」「风霜碎影」「残阳照雪」「冰谷初虹」「长空雷隐」「断石狼烟」，剑光疾如闪电，身形飘忽如雪影。必须配合天山魔教的独门雪影心法才能练，内力不足也练不成。"
msgstr ""

msgid "你按著所学练了一遍雪影剑法。"
msgstr ""

msgid "你的内力或气不够，没有办法练习雪影剑法。"
msgstr ""

msgid "你的内力不够，没有办法练雪影剑法。"
msgstr ""

msgid "雪影剑法必须配合天山魔教的独门雪影心法才能练。"
msgstr ""

msgid "$N使一招「回光幻电」，手中$w幻一条疾光刺向$n的$l"
msgstr ""

msgid "$N使出天山雪影剑中的「风霜碎影」，$w连挥剑光霍霍斩向$n的$l"
msgstr ""

msgid "$N一招「残阳照雪」，纵身飘开数尺，手中$w斩向$n的$l"
msgstr ""

msgid "$N手中$w中宫直进，一式「冰谷初虹」对准$n的$l刺出一剑"
msgstr ""

msgid "$N纵身一跃，手中$w一招「长空雷隐」对准$n的$l斜斜刺出一剑"
