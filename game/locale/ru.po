msgid "快"
msgstr "Скорость"

msgid "重"
msgstr "Мощь"

msgid "虚"
msgstr "Финт"

msgid "守"
msgstr "Защита"

msgid "平"
msgstr "Равновесие"

msgid "快：命中高、伤害低；克重招。"
msgstr "Скорость: попадает часто, урон мал; бьёт Мощь."

msgid "重：伤害高、命中低；克守招。"
msgstr "Мощь: урон велик, попадает реже; бьёт Защиту."

msgid "虚：对方难以招架、伤害低，打中就打断对方的蓄势；克快招。"
msgstr "Финт: противнику трудно его отбить, урон мал; попадание срывает противнику подготовку удара; бьёт Скорость."

msgid "守：这一回合自己更难被打中，伤害低；克虚招。"
msgstr "Защита: в этом раунде по вам труднее попасть, урон мал; бьёт Финт."

msgid "平：没有偏向。"
msgstr "Равновесие: без уклона."

msgid "隙"
msgstr "Брешь"

msgid "压"
msgstr "Натиск"

msgid "连"
msgstr "Связка"

msgid "对方打空得 1 手"
msgstr "Промах противника: +1 ход"

msgid "近身打中得 1 手"
msgstr "Попадание вплотную: +1 ход"

msgid "换招连打得 1 手"
msgstr "Смена приёма в связке: +1 ход"

msgid "够不着"
msgstr "Не достать"

msgid "攻"
msgstr "Атака"

msgid "游走"
msgstr "Манёвр"

msgid "攻：伤害高，闪躲、招架低；有内功时加力到上限的一半。"
msgstr "Атака: урон высокий, уклонение и парирование низкие; с внутренним искусством Усиление — до половины предела."

msgid "守：招架高，伤害低。"
msgstr "Защита: парирование высокое, урон низкий."

msgid "游走：闪躲高，命中低。"
msgstr "Манёвр: уклонение высокое, меткость низкая."

msgid "稳赢"
msgstr "Верная победа"

msgid "占优"
msgstr "Перевес"

msgid "五五开"
msgstr "Равные силы"

msgid "吃亏"
msgstr "Не в вашу пользу"

msgid "必败"
msgstr "Верное поражение"

msgid "稳赢：{pronoun}远不是你的对手。"
msgstr "Верная победа: противник вам не соперник."

msgid "占优：你比{pronoun}强一些。"
msgstr "Перевес: вы немного сильнее."

msgid "五五开：{pronoun}和你不相上下。"
msgstr "Равные силы: вы друг другу ровня."

msgid "吃亏：{pronoun}比你强，打起来要吃亏。"
msgstr "Не в вашу пользу: противник сильнее, бой обойдётся дорого."

msgid "必败：{pronoun}远比你强，别打。"
msgstr "Верное поражение: противник намного сильнее. Не вступайте в бой."

msgid "{pronoun}这边有 {count} 个人一起上。"
msgstr "Их {count}, и нападут они разом."

msgid "{pronoun}的闪躲比你高得多，你很难打中。"
msgstr "Противник уклоняется куда лучше вас — попасть будет трудно."

msgid "{pronoun}有兵刃在手，你空手难以近身。"
msgstr "У противника в руках оружие — голыми руками к нему не подобраться."

msgid "{pronoun}的经验比你多得多，你的拳脚落不实。"
msgstr "Противник куда опытнее — ваши удары не достигнут цели."

msgid "{pronoun}下手太重，你撑不了几回合。"
msgstr "Противник бьёт слишком сильно — долго вам не продержаться."

msgid "你有兵刃在手，{pronoun}空手挡不住。"
msgstr "У вас в руках оружие — противнику голыми руками вас не сдержать."

msgid "切磋稳赢：{pronoun}的招式你一眼看穿。"
msgstr "Поединок, верная победа: вы видите каждый приём насквозь."

msgid "切磋占优：你多半先打中{pronoun}。"
msgstr "Поединок, перевес: скорее всего, вы попадёте первыми."

msgid "切磋五五开：谁先打中谁赢。"
msgstr "Поединок, равные силы: кто первым попадёт, тот и победит."

msgid "切磋吃亏：{pronoun}多半先打中你。"
msgstr "Поединок, не в вашу пользу: скорее всего, противник попадёт первым."

msgid "切磋必输：{pronoun}的招式你接不住。"
msgstr "Поединок, верное поражение: таких приёмов вам не отбить."

msgid "{name}打了个隔，不过依然烂醉如泥。"
msgstr "{name}{:им} икает, но всё так же {~:пьяны|пьян|пьяна} в стельку."

msgid "你觉得脑中昏昏沉沉，身子轻飘飘地，大概是醉了。"
msgstr "В голове у вас туман, тело будто невесомое — кажется, вы пьяны."

msgid "{name}摇头晃脑地站都站不稳，显然是喝醉了。"
msgstr "{name}{:им} шатается и едва стоит на ногах — явно {~:пьяны|пьян|пьяна}."

msgid "你觉得一阵酒意上冲，眼皮有些沉重了。"
msgstr "Хмель ударяет вам в голову, веки тяжелеют."

msgid "{name}脸上已经略显酒意了。"
msgstr "{name}{:им} уже слегка {~:захмелели|захмелел|захмелела}."

msgid "你中的意寒掌毒发作了！"
msgstr "Яд Леденящей ладони в вашем теле даёт о себе знать!"

msgid "意寒掌毒"
msgstr "Яд Леденящей ладони"

msgid "你中的火玫瑰毒发作了！"
msgstr "Яд огненной розы в вашем теле даёт о себе знать!"

msgid "火玫瑰毒"
msgstr "Яд огненной розы"

msgid "你觉得脑中昏昏沉沉，心中空荡荡的，直想躺下来睡一觉。"
msgstr "В голове у вас туман, на душе пусто — так и хочется лечь и уснуть."

msgid "{name}摇头晃脑地站都站不稳，显然是蒙汗药的药力发作了。"
msgstr "{name}{:им} шатается и едва стоит на ногах — видно, подействовало сонное зелье."

msgid "你中的蛇毒发作了！"
msgstr "Змеиный яд в вашем теле даёт о себе знать!"

msgid "蛇毒"
msgstr "Змеиный яд"

