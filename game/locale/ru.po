msgstr "{npc} подбирает {item}{:вин}."

msgid "你捡起%s。"
msgstr "Вы подбираете %s{:вин}."

msgid "你附近没有这样东西。"
msgstr "Рядом с вами такого нет."

msgid "{container}里什麽也没有，先装些水酒才能溶化药粉。"
msgstr "В {container}{:пред} пусто: сперва налейте воды или вина, чтобы растворить порошок."

msgid "你将一些{powder}倒进{container}，摇晃了几下。"
msgstr "Вы подсыпаете {powder}{:вин} в {container}{:вин} и несколько раз встряхиваете."

msgid "$N和$n仇人相见分外眼红，立刻打了起来！"
msgstr "$N и $n{:им} — заклятые враги: при встрече сразу вспыхивает бой!"

msgid "$N对著$n大喝：「可恶，又是你！」"
msgstr "$N {N:кричите|кричит} $n{:дат}: «Проклятье, опять ты!»"

msgid "$N和$n一碰面，二话不说就打了起来！"
msgstr "$N {N:сталкиваетесь|сталкивается} с $n{:твор} — и без лишних слов завязывается драка!"

msgid "$N一眼瞥见$n，「哼」的一声冲了过来！"
msgstr "$N, завидев $n{:вин}, с презрительным «Хм!» {N:бросаетесь|бросается} вперёд!"

msgid "$N一见到$n，愣了一愣，大叫：「我宰了你！」"
msgstr "$N, увидев $n{:вин}, на миг {N:застываете|застывает}, а потом {N:кричите|кричит}: «Я тебя прикончу!»"

msgid "$N喝道：「$n，我们的帐还没算完，看招！」"
msgstr "$N {N:кричите|кричит}: «$n{:им}, наши счёты ещё не сведены — получай!»"

msgid "$N喝道：「$n，看招！」"
msgstr "$N {N:кричите|кричит}: «$n{:им}, получай!»"

msgid "道："
msgstr ": «"

msgid "{npc}发现了你！"
msgstr "{npc} замечает вас!"

msgid "{npc}发现了你，大喝一声！"
msgstr "{npc} замечает вас и издаёт грозный окрик!"

msgid "%s用一种异样的眼神扫视著在场的每一个人。"
msgstr "%s странным взглядом обводит всех вокруг."

msgid "{npc}对著你喝道：{self}看你实在很不顺眼，去死吧。"
msgstr "{npc} кричит вам: «Видеть тебя не могу — сдохни!»"

msgid "{npc}对著你喝道：喂！{rude}，{self}正想找人打架，陪我玩两手吧！"
msgstr "{npc} кричит вам: «Эй, {rude}! Руки чешутся подраться — давай-ка разомнёмся!»"

msgid "刀剑无眼，持兵刃比试可能真的受伤。"
msgstr "У клинка глаз нет: в поединке с оружием можно и вправду пораниться."

msgid "你用一种异样的眼神扫视著在场的每一个人。"
msgstr "Вы странным взглядом обводите всех вокруг."

msgid "你对著{npc}喝道：{self}看你实在很不顺眼，去死吧。"
msgstr "Вы кричите {npc}{:дат}: «Видеть тебя не могу — сдохни!»"

msgid "你对著{npc}喝道：喂！{rude}，{self}正想找人打架，陪我玩两手吧！"
msgstr "Вы кричите {npc}{:дат}: «Эй, {rude}! Руки чешутся подраться — давай-ка разомнёмся!»"

msgid "%s突然转过头来瞪你一眼。"
msgstr "%s вдруг оборачивается и сверлит вас взглядом."

msgid "{npc}拔刀上前，和你并肩而立！"
msgstr "{npc} выхватывает клинок и встаёт с вами плечом к плечу!"

msgid "%s慢慢睁开眼睛，清醒了过来。"
msgstr "%s медленно открывает глаза и приходит в себя."

msgid "{npc}的测试：第 {n} / {total} 招"
msgstr "Испытание от {npc}{:род}: удар {n} из {total}"

msgid "{npc}：第 {n} / {total} 句"
msgstr "{npc}: реплика {n} из {total}"

msgid "{name}走了过来。"
msgstr "{name} подходит."

msgid "你忽然觉得身上一轻，{item}不见了！"
msgstr "Вы вдруг чувствуете странную лёгкость — {item}{:род} как не бывало!"

msgid "你昏迷不醒的时候，身上的{item}被人拿走了！"
msgstr "Пока вы лежали без чувств, кто-то забрал у вас {item}{:вин}!"

msgid "你一回头，正好发现{npc}的手正抓著你身上的{item}！"
msgstr "Вы оборачиваетесь — рука {npc}{:род} уже тянет у вас {item}{:вин}!"

msgid "你喝道：「干什麽！」"
msgstr "Вы кричите: «Ты что творишь?!»"

msgid "{npc}穿上一{unit}{item}。"
msgstr "{npc} надевает {item}{:вин}."

msgid "{npc}戴上一{unit}{item}。"
msgstr "{npc} надевает {item}{:вин}."

msgid "{npc}将一{unit}绑在腰间。"
msgstr "{npc} обвязывает что-то вокруг пояса."

msgid "{npc}装备{item}。"
msgstr "{npc} снаряжается: {item}{:им}."

msgid "{npc}装备{item}作武器。"
msgstr "{npc} вооружается: {item}{:им}."

msgid "{npc}收了刀，走了。"
msgstr "{npc} убирает клинок и уходит."

msgid "%s急急忙忙地离开了。"
msgstr "%s поспешно уходит."

msgid "（{npc}要把你押到县衙受审：被押着走不开；可以向他行贿，也可以拒捕跟他动手。）"
msgstr "({npc}{:им} ведёт вас в уездную управу на суд: под стражей не уйти; можно дать ему взятку или сопротивляться аресту.)"

msgid "木人是武馆拆招用的，只能切磋，打坏了还得赔。"
msgstr "Деревянный манекен стоит в школе для учебных боёв: с ним можно только упражняться, а сломаете — придётся платить."

msgid "你身上带着伤，先养好了再来拆招。"
msgstr "Вы ранены — сначала залечите раны, потом приходите на учебный бой."

msgid "你是别派的弟子，我不便指点。"
msgstr "Вы из другой школы — наставлять вас мне не пристало."

msgid "来，拆三回合，点到为止。"
msgstr "Что ж, три раунда — до первого касания."

msgid "{npc}已经倒了。{npc}还有用，留{npc}一条命。"
msgstr "{npc} уже лежит. Без {npc}{:род} пока не обойтись — пусть живёт."

msgid "这里禁止战斗。"
msgstr "Здесь запрещено сражаться."

msgid "你想攻击谁？"
msgstr "На кого вы хотите напасть?"

msgid "加油！加油！加油！"
msgstr "Давай! Давай! Давай!"

msgid "%s已经无法战斗了。"
msgstr "%s больше не может сражаться."

msgid "你对著{npc}说道：{self}{name}，领教{respect}的高招！"
msgstr "Вы говорите {npc}{:дат}: «Позвольте представиться: {self} — {name}. Прошу, {respect}, покажите ваше высокое искусство!»"

msgid "看起来%s并不想跟你较量。"
msgstr "Похоже, %s{:им} не хочет с вами меряться силами."

msgid "你向{npc}讨教{skill}，请{npc}拆几招给你看。"
msgstr "Вы просите {npc}{:вин} показать вам на деле, что такое {skill}, и разобрать с вами несколько приёмов."

msgid "{npc}给你{item}。"
msgstr "{npc} даёт вам {item}{:вин}."

msgid "你可以购买下列这些东西："
msgstr "Вы можете купить вот что:"

msgid "{item}：{price}"
msgstr "{item}: {price}"

msgid "两{unit}{item}"
msgstr "{item} × 2"

msgid "你说道：%s"
msgstr "Вы говорите: «%s»"

msgid "关闭%s"
msgstr "Закрыть %s{:вин}"

msgid "打开%s"
msgstr "Открыть %s{:вин}"

msgid "你咬破手指，用鲜血在{paper}上画了一道僵尸追魂符，写上了{name}的名字。"
msgstr "Вы прокусываете палец и своей кровью чертите на {paper}{:пред} талисман погони за душой для ходячего мертвеца, а затем пишете на нём имя: {name}{:им}."

msgid "这里没有{name}。"
msgstr "Здесь нет {name}{:род}."

msgid "等待机会对{npc}下手"
msgstr "Ждёте случая обокрасть {npc}{:вин}"

msgid "这里禁止行窃。"
msgstr "Здесь воровать запрещено."

msgid "你已经在找机会下手了！"
msgstr "Вы уже выжидаете удобного случая!"

msgid "你想行窃的对象不在这里。"
msgstr "Того, кого вы хотите обокрасть, здесь нет."

msgid "{npc}身上看起来没有什麽值钱的东西好偷。"
msgstr "У {npc}{:род}, похоже, нечем поживиться."

msgid "你不动声色地慢慢靠近{npc}，等待机会下手 ..."
msgstr "Вы как ни в чём не бывало потихоньку подбираетесь к {npc}{:дат}, выжидая случая..."

msgid "太可惜了，你下手的目标已经走了。"
msgstr "Какая досада — тот, кого вы хотели обокрасть, уже ушёл."

msgid "你摸到{item}，可是对你而言太重了，不得不放弃。"
msgstr "Вы нащупываете {item}{:вин}, но для вас это слишком тяжело — приходится отступиться."

msgid "得手了！"
msgstr "Удалось!"

msgid "你成功地偷到{item}！"
msgstr "Вы ловко крадёте {item}{:вин}!"

msgid "{npc}不经意地一转头，你急忙将手缩了回去！"
msgstr "{npc} невзначай оборачивается — вы поспешно отдёргиваете руку!"

msgid "还好，没有被发现。"
msgstr "Обошлось — вас не заметили."

msgid "糟糕！你失手了！"
msgstr "Проклятье! Вы попались!"

msgid "{npc}一回头，正好发现你的手正抓著{pronoun}身上的{item}！"
msgstr "{npc} оборачивается — и видит вашу руку на {item}{:пред}!"

msgid "{npc}喝道：「干什麽！」"
msgstr "{npc} кричит: «Ты что творишь?!»"

msgid "！"
msgstr "!"

msgid "{name}喝道：{text}"
msgstr "{name} кричит: «{text}»"

msgid "风停了。草直直地立着，雾也不动了，四下里一点声音都没有。"
msgstr "Ветер стих. Трава стоит прямо, туман недвижим, вокруг ни звука."

msgid "一阵乱风打着旋卷过去，辨不出是从哪边来的。"
msgstr "Налетает шальной ветер, кружит вихрем — не понять, откуда дует."

msgid "风从{quarter}边吹过来，草都朝一边倒。"
msgstr "Откуда ветер: {quarter} — трава вся клонится в одну сторону."

msgid "怀里的风铃轻轻响了一声，清清楚楚。"
msgstr "Ветряной колокольчик за пазухой тихо звякает — ясно и чисто."

msgid "怀里的风铃叮叮地响，声音清亮。"
msgstr "Ветряной колокольчик за пазухой звенит — звонко и чисто."

msgid "怀里的风铃闷闷地响了两下。"
msgstr "Ветряной колокольчик за пазухой глухо звякает дважды."

msgid "风：停了"
msgstr "Ветер: стих"

msgid "风：乱风"
msgstr "Ветер: шальной"

msgid "风：{quarter}风 {arrow}"
msgstr "Ветер: {quarter} {arrow}"

msgid "主手"
msgstr "Основная рука"

msgid "副手"
msgstr "Вторая рука"

msgid "已穿戴"
msgstr "Надето"

msgid "每次练习耗 {mana} 点法力、{sen} 点神。心神一乱会变出{npcs}，它会立刻攻击你，活着时不能再练。亲手杀了它，{skill}会有长进；被别人杀了，你会昏倒。"
msgstr "Каждое упражнение отнимает {mana} чародейской силы и {sen} Шэнь. Стоит духу смутиться — явится {npcs} и тут же нападёт на вас; пока он жив, упражняться дальше нельзя. Убьёте его своей рукой — продвинетесь в искусстве «{skill}»; убьёт его кто-то другой — вы лишитесь чувств."

msgid "或"
msgstr " или"

msgid "需要先学会基本咒文，法力才能增长。"
msgstr "Чародейская сила растёт, только если сначала выучить Основы заклинаний."

msgid "需要先学会基本法术，灵力才能增长。"
msgstr "Духовная энергия растёт, только если сначала выучить Основы чародейства."

msgid ""
"{verb}要耗去{cost}，你现在撑不住，会当场昏过去。\n"
"确定要{verb}吗？"
msgstr "{verb}: уйдёт{cost}, а сейчас вам это не по силам — вы тут же лишитесь чувств.\n{verb}?"

