msgid "雪亭镇的头几天"
msgstr ""

msgid "你在饮风客栈醒来，店小二笑着招呼了你。"
msgstr ""

msgid "跟店小二打听「楼上」。"
msgstr ""

msgid "店小二说楼上客房闹老鼠，请你上去收拾。"
msgstr ""

msgid "上楼收拾老鼠。"
msgstr ""

msgid "楼上的老鼠都收拾干净了。"
msgstr ""

msgid "下楼找店小二。"
msgstr ""

msgid "店小二谢了你一根烤鸡腿。"
msgstr ""

msgid "去淳风武馆拜柳淳风为师。"
msgstr ""

msgid "你拜入了封山剑派。"
msgstr ""

msgid "向柳淳风请教基本剑法。"
msgstr ""

msgid "你跟柳淳风学了基本剑法。"
msgstr ""

msgid "去武馆和弟子切磋一场，胜了算。"
msgstr ""

msgid "你第一次在切磋中胜过了武馆弟子。"
msgstr ""

msgid "到武学页打坐，把内力练到 10。"
msgstr ""

msgid "你的内力练到了 10。"
msgstr ""

msgid "再切磋，再打坐：内力练到 25。"
msgstr ""

msgid "你的内力练到了 25。"
msgstr ""

msgid "向李教头讨教一场，然后打坐到内力 50。"
msgstr ""

msgid "你的内力练到了 50，够学封山剑法了。"
msgstr ""

msgid "向柳淳风请教封山剑法；教练场的木人也等着你。"
msgstr ""

msgid "你学会了封山剑法。"
msgstr ""

msgid "去雪亭驿找杜宽，问问「送信」；门外的悬赏榜也看一眼。"
msgstr ""

msgid "你揭了雪亭驿门外的一张悬赏。"
msgstr ""

msgid "出镇南行，过卧龙岗，去绮云镇看看。"
msgstr ""

msgid "你第一次来到绮云镇。雪亭镇的头几天到此为止，往后的路自己走。"
msgstr ""

msgid "雪亭驿的信"
msgstr ""

msgid "杜宽托你把一封信送到绮云镇振远镖局陈剑秋手里，回来给一两脚钱。"
msgstr ""

msgid "出镇往南过卧龙岗，到绮云镇的振远镖局把信交给陈剑秋。"
msgstr ""

msgid "你把信交给了陈剑秋。"
msgstr ""

msgid "回雪亭驿找杜宽拿脚钱。"
msgstr ""

msgid "杜宽付了你一两脚钱，说往后有信还找你。"
msgstr ""

msgid "门房的来历"
msgstr ""

msgid "魏无极说淳风武馆的门房刘安禄是野羊山寨的二寨主，人称血手刘三。"
msgstr ""

msgid "去淳风武馆问问柳淳风「刘安禄」。"
msgstr ""

msgid "柳淳风只说刘兄弟在武馆管事五年了，过去之事不须再提。门房的来历，雪亭镇上只有他一个人清楚。"
msgstr ""

msgid "樵夫骂野羊山那群道士该千刀万剐，说他们施了妖法。"
msgstr ""

msgid "刘安禄动起手来说漏了嘴：「想我堂堂……呃……连我这个小小的门房都可以收拾你！」"
msgstr ""

msgid "刘安禄亮出了血手刘三的身份：野羊山寨的二寨主，一手快刀判若两人。"
msgstr ""

msgid "你向雪亭镇书院的魏无极打听学费。"
msgstr ""

msgid "你交给魏无极学费，他点头说从今天起你随时可以去问他读书识字的学问。"
msgstr ""

msgid "你在兵器储藏室底下的地下密室里拾到一面牛皮盾。"
msgstr ""

msgid "玉佩"
msgstr "Нефритовая подвеска"

msgid "你向青石村的村长打听玉佩。"
msgstr ""

msgid "你给雪亭镇的醉汉送酒，他悄声说：玉佩他卖给沈老板了，那东西不吉祥。"
msgstr ""

msgid "你又给醉汉送酒，他悄声说：听说沈记商行有在卖蒙汗药。"
msgstr ""

msgid "你向沈记商行的沈万年问起玉佩，得到了那块刻著行气口诀的玉佩。"
msgstr ""

msgid "你向沈万年打听蒙汗药，他悄声说一份只要十两银子，保证有效。"
msgstr ""

msgid "你付给沈万年十两银子，他塞给你一包蒙汗药。"
msgstr ""

msgid "你依着路牌穿过了山路尽头的迷阵。"
msgstr ""

msgid "你跳入溪水中仔细寻找，竟从水中找出一把追风剑。"
msgstr ""

msgid "山洞里的骸骨"
msgstr ""

msgid "你在瀑布旁的山洞里埋好了那具骸骨，洞顶石壁「喀喇」一响，坠下一本过招要旨。"
msgstr ""

msgid "树上的刀痕"
msgstr ""

msgid "你顺着松树上的刀痕，在崖上林径尽头的灌木后找到了一条小径，通往老松寨。"
msgstr ""

msgid "买路钱"
msgstr ""

msgid "你向卧龙岗的强盗问起买路钱。"
msgstr ""

msgid "你交给卧龙岗的强盗十两金子，他收下钱，说今天做个善人，放你一条生路。"
msgstr ""

msgid "你在怡红院二楼向李师师请教学艺。"
msgstr ""

msgid "你留给李师师一件信物，她说：能做相公的老师，真是三生有幸。"
msgstr ""

msgid "你在香茗坊二楼和弈者下了一盘棋。"
msgstr ""

msgid "你得到了弈者的棋子，一种较轻的暗器。"
msgstr ""

msgid "忘忧草"
msgstr "Трава забвения"

msgid "你向振远镖局的陈剑秋问起陈天星。"
msgstr ""

msgid "你向陈剑秋问起忘忧草。"
msgstr ""

msgid "你向乔阴县城的乾瘪老太婆打听忘忧草。"
msgstr ""

msgid "你向乔阴县城的游客打听忘忧草。"
msgstr ""

msgid "护草神兽倒下后，你在神秘洞穴里得到一棵发着晶莹光芒的忘忧草。"
msgstr ""

msgid "你把忘忧草交给陈剑秋，他大喜过望，提笔写好一封信交给你，嘱咐你路上小心，把信直接交给陈师叔。"
msgstr ""

msgid "你在京师振远总局向陈天星请教拜师。"
msgstr ""

msgid "你向傍厅的蓝雨梅问起芳绫。"
msgstr ""

msgid "你向蓝筱薇问起竹蜻蜓。"
msgstr ""

msgid "你把一根竹子交给蓝筱薇，她看了看说是根玉竹，便灵巧地削凿起来。"
msgstr ""

msgid "蓝筱薇把做好的竹蜻蜓递给了你。"
msgstr ""

msgid "你把竹蜻蜓送给禁闭房里的芳绫，她开心地把玩，在你耳边小声说：『庄内前厅某处藏有一宝物手镯哦！』"
msgstr ""

msgid "你从内厅的碧纱橱里取出一串玛瑙手镯。"
msgstr ""

msgid "晚月庄的舞步"
msgstr ""

msgid "你记下了一曲舞步『西出阳关』。"
msgstr ""

msgid "你记下了一曲舞步『有凤来仪』。"
msgstr ""

msgid "你在一间密室里拾到一卷丝罗巾，上面绣着一幅幅翩然起舞的美女图。"
msgstr ""

msgid "你在翠湘阁向莫欣芳问起舞曲谱。"
msgstr ""

msgid "你在密室的石床后面找到了一本舞曲谱。"
msgstr ""

msgid "无名老妇"
msgstr "Безымянная старуха"

msgid "你向内书房的无名老妇问起她的心事：那个蒙面的杀手，是她的私生女。"
msgstr ""

msgid "你向无名老妇问起令牌：令牌在她女儿身上。"
msgstr ""

msgid "你得到了一个黑木做的杀手令牌，上面刻著火焰的图腾标志。"
msgstr ""

msgid "你把杀手令牌交给无名老妇，她叹了口气，给了你一本寒雪鞭法密笈作为感谢。"
msgstr ""

msgid "密函"
msgstr "Тайное письмо"

msgid "你得到了芙云身上的一封密函，信用蜡封著，上面有一个奇怪的图案。"
msgstr ""

msgid "山药蛋"
msgstr "Картофелина"

msgid "你在青石峪遇见一位采药老者，他心疼你饿得面黄肌瘦，从小布包里拿出个山药蛋塞到你手里。"
msgstr ""

msgid "草堂的书"
msgstr ""

msgid "你在隐士的草堂里趁人不备，从矮几上抓起一本书藏入怀中。"
msgstr ""

msgid "桃木箱"
msgstr "Сундук из персикового дерева"

msgid "你向福林酒楼里的武官打听传闻。"
msgstr ""

msgid "你在树王坟内部找到一个刻工精细的桃木箱。"
msgstr ""

msgid "你把桃木箱还给武官，他说出门在外没带太多银两，送你一本古书「白杨经」作为报答。"
msgstr ""

msgid "荷包"
msgstr ""

msgid "你在福林酒楼二楼向贵公子问起他的心事。"
msgstr ""

msgid "你向曲桥上的官家小姐提起游晋，她吞吞吐吐地托你把一个紫罗鸳鸯荷包交给游公子。"
msgstr ""

msgid "骆云舟死后，风泉之剑掉落在地，又飘了起来，一个人形忽然浮现，手中正握著风泉之剑。"
msgstr ""

msgid "你得到了步玄派历代相传的掌门信物——风泉之剑。"
msgstr ""

msgid "你向骆云舟拜师，他说：你还是先走一趟东边的桃林吧。"
msgstr ""

msgid "你读着树上的字条找路，走出了曼雩台东边的桃林。"
msgstr ""

msgid "你在绝壁上的山洞里得到一条金丝编成、刻满咒文的缚仙绳。"
msgstr ""

msgid "你在云台向紫衣童子问起仙人。"
msgstr ""

msgid "你在丹炉里得到了仙丹。"
msgstr ""

msgid "你在寒谷尽头采到一株寒谷幽兰，淡淡的香气似乎在哪里闻到过。"
msgstr ""

msgid "军营"
msgstr ""

msgid "你向大队长打听黄石隘口，他讲起二十多年前先帝调大将军们驻守隘口的往事。"
msgstr ""

msgid "你向大队长问起允许。"
msgstr ""

msgid "你前后交给大队长三十两银子，他把你列入名册，说从今天起你可以自由出入营区。"
msgstr ""

msgid "印鉴"
msgstr "Печать"

msgid "你在将军营帐向严廷殷打听印鉴。"
msgstr ""

msgid "你向大队长打听兵器库。"
msgstr ""

msgid "你向军师赫造基打听兵器库。"
msgstr ""

msgid "你交给军师赫造基八两银子，他告诉你一项秘密：在那片光滑的山壁前发誓「我爱……」，或许可以发现奇特的事。"
msgstr ""

msgid "你在光滑的山壁前发了誓，一阵强光轰隆过后，来到一处兵器库，见到一名后备兵。"
msgstr ""

msgid "你交给后备兵三两黄金，他说你不愧是武林中人，一眼就看出端倪，用一方印鉴和你交换。"
msgstr ""

msgid "你把那方印鉴交给严廷殷，他喝道别想拿这种东西来骗他，把你赶到了营火区。"
msgstr ""

msgid "后备兵见被你识破，只好认栽，换给你一方泛著黄光的印鉴。"
msgstr ""

msgid "你把印鉴交给严廷殷，他连声道谢，送你一把古剑作为报酬。"
msgstr ""

msgid "你在洞内石室的书柜里找到一个铜制的书匣。"
msgstr ""

msgid "书匣里是一本《悟疾风劲竹书》，书末署名柳淳风。"
msgstr ""

msgid "你在瓜地里摘西瓜，被瓜农逮了个正着。"
msgstr ""

msgid "你在湖底的水下岩洞里撞见了浑身长满白鳞的冰龙。"
msgstr ""

msgid "小娟"
msgstr "Сяоцзюань"

msgid "你向玉螺湖村的采花妞打听小娟。"
msgstr ""

msgid "你向黑松堡的女佣人打听小娟。"
msgstr ""

msgid "你在黑松堡地牢的刑房里见到了刘老农的女儿小娟，她已被折磨得遍体鳞伤。"
msgstr ""

msgid "小娟从绳索里挣脱出来，跟着你走了。"
msgstr ""

msgid "你从刘老农那里得到了一柄銮鱼衡冰。"
msgstr ""

msgid "小娟死在了你的手里。"
msgstr ""

msgid "刘老农得知你杀了他的女儿，悲愤欲绝，要找你拼命。"
msgstr ""

msgid "你赏了太白酒楼的店小二十两银子，他笑着道谢。"
msgstr ""

msgid "你向京师的行人问起买官。"
msgstr ""

msgid "你塞给尚书府的门房三两黄金，他说：这位大人，里面请！"
msgstr ""

msgid "出城令牌"
msgstr "Пропуск на выезд"

msgid "你向京师守城兵问起出城。"
msgstr ""

msgid "你在废园的草丛里找到一块遗失多年的出城令牌。"
msgstr ""

msgid "你把令牌交给京师守城兵，他连忙说：原来是官府中人。"
msgstr ""

msgid "官府悬赏"
msgstr "Объявления о розыске"

msgid "你在雪亭驿门外揭下了一张官府悬赏告示，照告示上说的地方去找那个恶人。"
msgstr ""

msgid "你第一次领到了雪亭驿的悬赏。告示上隔些时候就会贴出新的。"
msgstr ""

msgid "入门"
msgstr "Основы"

msgid "初入江湖"
msgstr ""

msgid "走近一个人、一件东西，脚下会出现「交互」和该按的键（键盘、手柄各画各的）。按那个键或点它，能做的事都列在交互窗口里；只有一件事可做的，直接就做了。"
msgstr ""

msgid "不知道往哪里去，就找人「打听」。镇上的人知道这里的事和附近的传闻，有些话题问出来就是一条路。你见过、听过的事都记在菜单的「任务」页，状态卡上的「目标」一行写着眼下最要紧的那件。"
msgstr ""

msgid "菜单有八页：角色、武学、背包、任务、地图、声望、百科、系统。地图页是一张沙盘，走过的地方都立着模型；说明卡上列着师父、商店、悬赏榜，点一行就给你指路。"
msgstr ""

msgid "系统页里有三个存档位。换地图、打完一仗也会自动存一份，死了可以回到那里。"
msgstr ""

msgid "先做什么"
msgstr ""

msgid "先在镇上走一圈，和人说说话。饮风客栈的店小二卖吃喝；想学武，就去淳风武馆看看，那里的人肯指点新人。"
msgstr ""

msgid "打不过的人别硬碰：交互窗口和动手前的确认页都会写出对方比你强还是弱。"
msgstr ""

msgid "地理"
msgstr ""

msgid "雪亭镇在群山之中。镇北的山坳往北是野羊山，往东通青石村。出镇往西，顺着青石官道上山，是天邪派的水烟阁。镇东的大路通到茅山，茅山派的灵心观就在山上；这条路上有岔路往南进老松岭的松林，传说老松寨就在附近，过往的旅客都要格外小心。"
msgstr ""

msgid "镇南的大街通到绮云镇；往西南走是天驼关。"
msgstr ""

msgid "绮云镇往西是晚月庄，庄里多是女子。往南过了渡口是日照山，山烟寺就在山上；过渡口往东走，就到乔阴县城。"
msgstr ""

msgid "人身上最要紧的是「精」「气」「神」三样。"
msgstr ""

msgid "学东西的本钱。请教、自学、修行都耗精。"
msgstr ""

msgid "身体的力气。挨打掉的是气，练功、打坐也耗气。"
msgstr ""

msgid "心神。研读、冥思都耗神，迷药和蒙汗药伤的也是神。"
msgstr ""

msgid "当前、有效、最大"
msgstr ""

msgid "角色页上每样有三个数。「当前」是眼下还剩多少，歇一歇就回来；「有效」是受伤压低的上限，当前最多只回到这里；「最大」是你的本钱。"
msgstr ""

msgid "比如气写着当前 67、有效 82、最大 100：说明你受了些伤，歇着最多回到 82。那 18 点伤要等当前回满了才慢慢长回来，用药或疗伤更快。"
msgstr ""

msgid "三样里哪一样的当前打光了，人就昏倒；伤到连有效也撑不住，就会送命。"
msgstr ""

msgid "「最大」不是一成不变的：内力的上限越高，气的本钱越厚；法力、灵力的上限高了，神和精的本钱也跟着长。"
msgstr ""

msgid "受伤与歇息"
msgstr ""

msgid "不打架的时候，精气神会自己慢慢回来：先回当前，当前回满了，伤才慢慢好。战斗中不回。回复要时间走：菜单和交互窗口开着时时间停住，什么都不回。"
msgstr ""

msgid "想歇就歇：请教页和武学页上的「歇到回满」让你坐下来，时间照走（快得多），精气神回满就起身；连续修炼练到一半没了力气，也会自己这样歇一歇再接着练。世界不会等你：歇着时有人来找麻烦，你会被惊起，照常开打；口渴没水的时候歇着也回不来。"
msgstr ""

msgid "想快一点：金疮药敷上能治伤；学了内功的人可以运功恢复精、气、神，有的内功还能运功疗伤，耗的都是内力。战斗中不能疗伤。"
msgstr ""

msgid "昏倒以后过一会儿自己会醒。昏着的时候任人宰割，所以别在仇人眼前耗到最后一口气。"
msgstr ""

msgid "中了毒、喝醉了，身上会一阵阵发作。蛇药解蛇毒，酒要等它自己醒。"
msgstr ""

msgid "吃喝"
msgstr ""

msgid "食物和饮水随时间慢慢消耗，角色页上看得到还剩多少。一开始都是满的。"
msgstr ""

msgid "食物吃光了，内力、法力、灵力就不再恢复；水喝光了，什么都不再恢复。"
msgstr ""

msgid "客栈、饭馆和集市都卖吃喝。牛皮酒袋能灌清水，路上渴了拿出来喝。酒也能解渴，只是喝多了会醉。"
msgstr ""

msgid "肚子能装多少看你的体重。吃剩的肉骨头别扔，喂给狗，它会跟着你走。"
msgstr ""

msgid "人生来有八项天赋，新入江湖时都是 30。天赋很少变动，勤练武艺偶尔会长一点。"
msgstr ""

msgid "力气。打得更重，背得更多，拿得动沉重的兵器。"
msgstr ""

msgid "敢不敢抢攻。自动对打时，胆识高的人出手更勤；不少师父收徒也看它。"
msgstr ""

msgid "天资。学武功更快、耗精更少，打架时也更容易长进。"
msgstr ""

msgid "精神方面的体质。冥思、修行长得快，不少法门也看它。"
msgstr ""

msgid "临危不乱。对手想抢攻要先过你这一关；打空了也不容易露破绽，还压得住杀气。"
msgstr ""

msgid "长相。有人看脸说话，也有师父看长相收人。"
msgstr ""

msgid "体质。精气神恢复得快，打坐长内力快，昏倒后醒得早，酒量也大。"
msgstr ""

msgid "运气。容易遇上一般人碰不到的机缘，好事坏事都有。"
msgstr ""

msgid "药物、装备带来的变化只算眼下；学东西看的是天赋本身。天赋不好也不必灰心：它只在武功还浅的时候看得出来，功夫练深了，差别就小了。"
msgstr ""

msgid "学武"
msgstr ""

msgid "武功分两层。基本拳脚、基本剑法、基本内功这些「基本功夫」是根基；柳家拳、封山剑法这些「特殊武功」要在武学页「激发」到对应的基本功夫上才用得出来。真打起来，看的是两者合起来的等级。"
msgstr ""

msgid "向师父或肯教你的人请教，每次耗精和一点潜能，第一次学一门新功夫耗的精加倍。学到的不能超过教你的人，也受实战经验限制：等级越高，要的实战经验越多。请教页写着你能学到几级、卡在哪里。"
msgstr ""

msgid "激发好的特殊武功可以在武学页练习，耗气。它最多练到和底下的基本功夫一样高，再往上，得先把基本功夫学上去。"
msgstr ""

msgid "基本拳脚、基本剑法、基本刀法、基本杖法、基本招架、基本轻功、基本内功这七门，到了 40 级就能自己琢磨着往上练，耗精和潜能，不必找人。特殊武功不能自学。"
msgstr ""

msgid "得了拳谱、刀谱、经书，会读书识字就能研读。研读耗神、不花潜能；读书识字越高，每次读懂的越多。"
msgstr ""

msgid "实战经验与潜能"
msgstr ""

msgid "打架、办差事、走完一段经历，都能得到实战经验和潜能。实战经验决定武功能学多高；潜能是请教和自学的花销，没用掉的有上限，攒满了就该去学了。"
msgstr ""

msgid "打中比自己强的对手时，偶尔也能长一点功夫。"
msgstr ""

msgid "请教、练习、打坐、冥思、修行都能「连续」做下去：精、气、神不够了就自己歇一歇，回满了接着练，练到潜能用完、功夫长了一级或做不下去的一步才停，并告诉你为什么。"
msgstr ""

msgid "拜师与门派"
msgstr ""

msgid "门派是学武的正路。拜师大致有三种：有的师父看你的天赋和功夫够不够，有的要你立誓，有的要你先过一场考验。交互窗口里还够不上的「拜师」会灰掉，写着还差什么；拜师页列出条件和你自己的数。"
msgstr ""

msgid "一个人同时只能有一位师父。师父教本门功夫最用心；别的人肯教，多半要你先替他做点事，或者付些钱。"
msgstr ""

msgid "改投别派之前会先问你。背叛师门要扣综合评价，往后的师父也不那么信你，教到一定程度就不肯再教；杀了自己的师父，也算背叛。"
msgstr ""

msgid "门派、帮会与山寨"
msgstr ""

msgid "门派重师门伦理和辈分，以入门先后排序，大多不许弟子再投别家。帮会、教派不以传授武功为主，帮规偏重要你去做事，进出也比门派容易。山寨、镖局、庄院规模小，入伙不易，入了以后有活干、有报酬。"
msgstr ""

msgid "角色页名字前方括号里写的是你的身份。一开始都是普通百姓；入了门派、出了家，身份会跟着变，往后的作为也会改它。"
msgstr ""

msgid "见过门人的门派收在百科「门派」里；各家怎么看你，写在声望页。"
msgstr ""

msgid "内力是武者的第二条命，打人和挨打都看它。"
msgstr ""

msgid "学了基本内功，再把一门特殊内功激发上去，就能在武学页打坐：耗气，把气炼成内力存起来。存过了上限再坐下去，上限就慢慢往上长；能长多高，看基本内功的等级。连续打坐可以定一个数，练到就停。"
msgstr ""

msgid "每一击多灌进一些内力，打得更重，内力也耗得更快。战斗里取「攻」的姿态，会顺手把加力开到一半。"
msgstr ""

msgid "各门内功的本事不一样：有的能恢复精、气、神，有的能疗伤，有的能压下杀气、提升战斗力。百科「武学」里每门内功都写着它能运哪些。运功耗内力，战斗里也能用。"
msgstr ""

msgid "法力与灵力"
msgstr ""

msgid "法门在江湖上分两路。一路念咒施法，茅山道术、奇门遁甲都属这一路，耗的是法力；一路是出自修行者自身的神通，佛门的八识神通属这一路，耗的是灵力。"
msgstr ""

msgid "学了基本咒文才用得上。在武学页冥思，耗神，把法力一点点聚起来；上限看基本咒文。"
msgstr ""

msgid "学了基本法术才用得上。在武学页修行，耗精，把精炼成灵力；上限看基本法术。"
msgstr ""

msgid "两样都和内力一样：存过了上限再练，上限就长。灵性高的人长得快。还没学这一路的时候，角色页和武学页都不显示它们。"
msgstr ""

msgid "战斗"
msgstr ""

msgid "动手有两种。「切磋」点到为止，谁先实实在在打中对方一下就算赢，事后谁也不记仇；只是拿着兵刃切磋，一样会见血。「攻击」是死斗，打到一方送命为止；乱杀无辜，往后的日子就不好过了。"
msgstr ""

msgid "动手之前会先问你一句，写明对方比你强还是弱：稳赢、占优、五五开、吃亏、必败。"
msgstr ""

msgid "出招"
msgstr ""

msgid "战斗时世界停住，回合等你出招。一回合你有两手，对手看身手有一到两手；你点一招就结算一手，接着轮到对手。"
msgstr ""

msgid "招式分快、重、虚、守四种：快克重，重克守，守克虚，虚克快。重招占两手，打实了伤得重，还能打掉对手一手；落空了就露出空门。"
msgstr ""

msgid "姿态有三种：攻，伤得重、自己也好打；守，招架高、伤得轻；游走，闪躲高、命中低。点「改为自动」就让它自己打下去。"
msgstr ""

msgid "识招"
msgstr ""

msgid "一路招式看熟两回，就认得它是快是重、怕什么；自家门派的招一学就认得。见过的招都记在百科「武学」的见识录里。"
msgstr ""

msgid "有些门派的功夫能多挣一手：封山剑法等对手打空，柳家拳贴身打实。"
msgstr ""

msgid "一伙人"
msgstr ""

msgid "见人就打的一伙，只要有一个够得着你，就会一起上。人多的时候，先想好再进门。"
msgstr ""

msgid "认输、逃跑与生死"
msgstr ""

msgid "逃跑不耗什么，脱离战斗，人还留在原地。"
msgstr ""

msgid "认输：要你命的人还站着时，他不让你降；否则就此停手，扣一些综合评价。"
msgstr ""

msgid "对手被你打倒时，会停下来问你「了结」还是「放过」，放过的人不记仇。设置里可以改成直接了结。有些人往后还用得着，只能打倒，杀不死。"
msgstr ""

msgid "死了以后"
msgstr ""

msgid "人死了变成鬼魂，从鬼门关走一趟阴间，回到阳世。死一回只扣一点实战经验，武功和潜能都不动，杀气清零。"
msgstr ""

msgid "身上的东西都留在尸体上，尸体不会腐烂，等你回去取。不想走阴间，也可以回到上次的自动存档。"
msgstr ""

msgid "兵器与护具"
msgstr ""

msgid "伤人靠的首先是功夫，其次才是兵器。剑用剑法、刀用刀法，空手用拳脚；兵器的种类不同，伤法也不同，割伤、刺伤、砸伤各不一样。"
msgstr ""

msgid "越重的兵器伤得越重，但要称手：拿不拿得动看膂力。锤和杖砸下去，能把对手的兵器打飞，甚至砸断。另一只手也能拿兵器，它的分量一样算数。"
msgstr ""

msgid "护具有衣服、盔甲、帽子、项链、护腕、腰带、鞋、戒指，还有盾。一身衣服连裤子算一件。护得越好越重，重兵器和重盔甲都会拖慢你的轻功，物品说明上写着拖多少。"
msgstr ""

msgid "背包页选中一件，右边就是它的样子和说明。"
msgstr ""

msgid "杀气与名声"
msgstr ""

msgid "杀人会长杀气，胆气也跟着壮。杀气太重，学不了佛道两家的心法，还可能失手伤人。运功压制或到庙里捐香火，能把它压下去。"
msgstr ""

msgid "江湖上对你的总评。办成差事会涨，认输会掉，背叛师门扣得最狠。"
msgstr ""

msgid "打过交道的势力，在声望页各有一张卡，写着那一家对你的看法；哪一家都还不认得你时，那里是空的。"
msgstr ""

msgid "角色页还记着你亲手杀过多少人。"
msgstr ""

msgid "银两与行路"
msgstr ""

msgid "钱有黄金、白银、铜钱三种：一两银子是一百文，一两黄金是一百两银子。付钱先用大的；钱庄能兑换。"
msgstr ""

msgid "当铺按八折收你的东西，不做典当和赎回。不值钱的东西丢下就没了，丢之前会先问你一句；办事要用的东西丢不掉。"
msgstr ""

msgid "城里的悬赏榜上贴着差事，办成了有赏，也算一段历练。"
msgstr ""

msgid "七座城镇和五个门派的山门都停着车。在车旁「坐车」，在沙盘上挑一站；只去你走到过、路也走通了的地方。车钱十几到五十几文，路上要花些时辰。"
msgstr ""

msgid "传说"
msgstr "Предания"

msgid "主题故事"
msgstr ""

msgid "这个时代，东方世界已经有了相当高水准的文明。由于东方大陆实在太大，航海技术并不受重视。我们的故事，就从一个山中小镇——雪亭镇说起。"
msgstr ""

msgid "时间是天朝佑圣元年，岁次甲子，年仅十六岁的皇帝刚刚登基，雪亭镇上熙来攘往，一队身着白衣的朝廷武官和两名老者在镇前的广场中坐着，四面来来往往的人当中，有不少显然是武林中人，正探头探脑地向着广场张望。"
msgstr ""

msgid "正纷扰间，一匹快马冲进了广场，两名老者立即站了起来。"
msgstr "В разгар этой суеты на площадь ворвался всадник на быстром коне, и оба старика тотчас поднялись."

msgid "马上乘客一跃而下，快步走到老者身前，躬身说道：「禀将军，时辰已到，白道长命下官回禀，方位是在……」，说着压低了声音。"
msgstr ""

msgid "不料一名老者忽然说道：「大声点，让众位兄弟都听见了。」"
msgstr "Но один из стариков вдруг сказал: «Громче. Пусть все братья слышат.»"

msgid "那人一怔，随即大声说道：「方位是在西南二十四里，黄石隘口。」"
msgstr "Тот на миг опешил, но тут же громко объявил: «Место — в двадцати четырёх ли к юго-западу, Желтокаменный перевал.»"

msgid "只见坐着的白衣武官相互交头接耳，四周围观的人纷纷向外走去，看似杂乱无章，其实倒有一大半正往西南走去，两名老者不动声色，只静静地瞧着众人的动向。"
msgstr ""

msgid "过了约一盏茶的时间，其中一名老者做了个手势，所有白衣武官倏地站起，然后跟着两名老者身后缓缓地往西南方向离去。"
msgstr ""

msgid "广场西边一家小客栈里，一个年约十四岁的少年问店里的小二道：「这些人神秘得紧，却不知到底在玩什么把戏？」"
msgstr ""

msgid "小二抄起脖子上的毛巾，抹了抹脸，说道：「小哥您有所不知，这些个爷儿们可是大内来的高手，这次是奉了咱们皇上的命令，要去岚城找一把叫做什么『旋芒宝剑』的，那骑马的官爷所称的白道长，便是咱们这附近有名的太乙观观主……」"
msgstr ""

msgid "少年奇道：「岚城？那是什么地方？怎么我从小到大不曾听过有这个地方？」"
msgstr ""

msgid "小二「嘿」的一声，说道：「说起岚城这地方，那你可问对人啦，咱这儿的说书先生可是我的哥儿们，那岚城说穿了只不过是古书上的一处地方，据说这城是仙人住着，一般的凡夫俗眼可瞧不见这座城，只不过古时候一个樵夫不小心撞了进去，这才留下了记载，不过后来好像除了这位砍柴的老兄进去过之外，再也没有人到过这岚城，我说小哥哪，要找这个岚城是他们朝廷大官跟江湖好汉的事儿，您还是来小店听听说书先生的书儿比较轻松。」"
msgstr ""

msgid "少年听着出了神，怔怔地望着外面的天空，一朵朵的浮云飘来飘去，他的心思也不由自主地飞了起来。"
msgstr ""

msgid "历史"
msgstr ""

msgid "自古以来，人类由茹毛饮血逐渐进步，慢慢有了部落，大约在一千年前，强大的邬赤族领袖商句征服了烟车河流域的游牧民族，建立了一个以「金色乌鸦」为图腾的国家，这金色乌鸦代表的是太阳，商句将一面绣着金色乌鸦的大旗树立在图干山的山顶上，统治着山脚下绵延好几百里的土地。"
msgstr ""

msgid "第三年冬天，大雪一连下了五个月，牛羊冻死的不计其数，商句召集了所有的父老，对他们说道：「守护我们的金色乌鸦已经离开了这片土地，这场大雪便是告诉我们离开故乡的时间到了，我决定带着子民向南越过大漠，一直到看得到太阳的地方，年老和有病的人可以留下来，我会将一半的牛羊留给他们。」"
msgstr ""

msgid "于是他们收拾了帐棚，留下了一半的牛羊给不愿离开家乡的老人，踏上了寻找金色乌鸦的旅程，大漠十分辽阔，即使是商句自己也没有把握能安全地穿越，他在出发后的第四个月甚至亲手写下了遗书，交给自己的儿子。他们在大漠里整整走了一年，然后来到了一座大山之前，商句病倒了，他对他的儿子於兰攸说道：「越过这座大山，北风就吹不到了，在那里一定可以看得到太阳，现在我把这面大旗交给你，希望你记着我们离开故乡的目的，好好带领大家。」说完，商句就闭上眼睛死了。"
msgstr ""

msgid "於兰攸含泪埋葬了父亲，并且在他的墓旁守候了一年，才开始带着大家翻越那座大山，大山地势非常险峻，他们一共越过了六座高耸的山峰，才来到一片平原，只见绿草如茵，中间散布着几株大树，没有半点冰雪的踪迹，最令人惊异的是，他们的面前耸立着一株高耸入云的大树，树上正栖息着一只巨大的金色乌鸦。"
msgstr ""

msgid "虽然金色乌鸦在大家的心目中一直是太阳的象徵，但那也只是祖先们流传下来的神话，想不到在经过长途的跋涉之后，竟然真的见到了，那只金色乌鸦见到了於兰攸，忽然变成一个穿着金色长袍的少女缓缓地从树上降了下来，对着於兰攸说道：「你们终于来了，这片土地是我的父亲允诺要赐给你们的，我们是勇士『寒於』的后裔，掌管光明的太阳神族，如果你们能答应永远守护这株圣木，太阳将会永远照耀这片土地。」"
msgstr ""

msgid "金色乌鸦变成的少女名字叫做「君违」，后来嫁给了於兰攸做妻子，君违教导众人耕种、纺纱，并且为她的丈夫制定各种典章制度，从此以后於兰攸和他的族人们一直遵守和金色乌鸦的约定，守护着圣木。因为金色乌鸦的守护，过了七百年风调雨顺的时光，人口增加得很快，在向外拓垦的同时，又陆续和西方擅长狩猎与铸造的歧族人、东方擅长音乐与占卜的敖族、南方擅长经商与建筑的娄族互相融合，终于成为这个世界上最大的国家，所有远方的小国都称呼我们为「天朝」，由于於兰氏的帝王具有太阳神族的血统，因此也有「天子」的称号。"
msgstr ""

msgid "但是就在距今约三百年前，发生了一件可怕的事，当时的皇宫之中，一群武士意外地在一处地窖里发现了一张羊皮，这张羊皮就是当初率领大家穿越大漠的君主商句所写的遗书，这份遗书不但提到了金色乌鸦，而且还提到许多后来发生的大事，简直就是一张神奇预言，发现这张羊皮的武士首领恰好是当时皇帝的叔父於兰淳焉，於兰淳焉是一位伟大的武士，曾经数度打败企图夺取圣木的北方蛮族，他见到遗书上提到，金色乌鸦出现之后每七百年，就会有一个可怕的妖魔出现，大杀苍生，以应金色乌鸦神通所欠的劫数，这个妖魔只有上古的宝剑「穿灵」才能镇住，而这把宝剑所藏的位置正是圣木的核心。"
msgstr ""

msgid "於兰淳焉和皇帝商量的结果，决定劈开圣木取出宝剑，以防备妖魔出现，那圣木足足有一百个人合抱那么粗，一大群士兵用斧头砍了足足三天才将圣木砍倒，一阵天摇地动之后，穿灵宝剑终于出现在树洞中央，可是当於兰淳焉将宝剑拔起之后，一条黑影迅速地从地面窜了出来，原本明亮的天空一下子变暗了，百姓们都惊慌失措，只听到天空中传来阵阵低沉的吼声，过了足足一个时辰才又恢复光明。"
msgstr ""

msgid "当天晚上，一只金色乌鸦出现在皇宫之中，说道：「你们今天做了一件大大的错事，将勇士寒於用宝剑镇压了五千年的『侮天鬼』放了出来，我的妹妹『璃虹』正在天上巡行，已经被这侮天鬼捉去了，侮天鬼现在正在四处寻找他的头颅，一旦被他找到，即使是集我全部族人的力量也无法镇服他，现在唯一的办法是找到另一把宝剑『旋芒』以及『寒於宝衣』，唯有这三件神器才能制服得了侮天鬼，寒於宝衣现在归月神族保管，旋芒宝剑却下落不明，侮天鬼的头颅被我的族人用强力法术封住，谅那妖魔两三百年内找不到，但是日子一久只怕终究隐藏不住，因此若你们三百年之内不能出现一个勇士消灭这妖魔，就真的大祸临头了。」"
msgstr ""

msgid "金色乌鸦的名字叫做「杞庸」，他化身成一个金袍少年住在皇宫中教武士们各种剑术武功三十年，渐渐地这些武术慢慢流传到了民间，更有许多聪明才智之士加以变化出许多不同的武术，而演变出各种不同的门派，转眼间已过了将近三百年，这期间虽然偶尔有些旱灾水灾，但仍算风调雨顺，想是那侮天鬼只急着找回头颅，却并不多事杀戮，但是人们却渐渐将这件事忘了，不少人还将之斥为无稽之谈，荒谬之说，直到先帝即位，事情才又有了变化。"
msgstr ""

msgid "先帝秉性聪慧，自幼即博览群书，尤其对先人留下的史籍更是详加考据，先帝曾仔细推敲商句遗书中最后两句话，推断那可能是指引旋芒宝剑所在的关键，虽然对祖先所留下来有关金色乌鸦的传说也是半信半疑，但是仍然陆续派出了许多武士探查，结果意外地发现了古书中「烟霞霓岚」四座仙城中的烟城，根据武士所带回来的消息，旋芒宝剑目前乃是属于岚城中一位仙人所有，只是这岚城「寻风而至，寻风而逝」，烟城百姓也是只闻其名，不知其所，先帝直到病危之中仍念念不忘寻找岚城之事。"
msgstr ""

msgid "神话"
msgstr ""

msgid "早在我们的先人来到这片土地之前，这里曾经是集天地万物浊气所形成的妖魔们盘踞的炼狱，到处都是终年燃烧着的土地与深不见底的沼泽，直到我们的始祖——也就是勇士「寒於氏」来到这里，他有一件水火不侵的宝衣，和两把神异的利剑「穿灵」与「旋芒」，寒於氏和妖魔大战了一十七日，妖魔的鲜血浇熄了燃烧的土地，尸体填平了无底的沼泽，当寒於氏斩下最后一只妖魔「侮天鬼」的头颅之后，他也力尽而死。"
msgstr ""

msgid "寒於氏死后，元神却没有消失，他的魂魄化成了十三个精灵，每一个精灵各拥有寒於氏的一种神通，掌管着这个世界的万物，其中的第十三个精灵「区冥氏」就是我们人类最早的祖先。区冥氏不像她其他的十二个姊姊是不死的，但是她所拥有的神通是寒於氏最引以为傲的「再生」能力，区冥氏活到一百七十岁的时候，召集了她所有的姊妹，交代她们好好照顾自己的子女之后，便闭上眼睛死了。"
msgstr ""

msgid "区冥氏一共有一百个子女，后来分别成为世界上各个种族的祖先。"
msgstr ""

msgid "勇士寒於的魂魄所化成的十三个精灵，分别是太阳神「金乌」、月神「银蟾」、风神「大鹏」、雨神「天龙」、雷神「泽兽」、火神「凤凰」、山鬼「赤魈」、林鬼「青蛛」、川鬼「浊鱼」、原鬼「旱魃」、天灵「穹氤」、地灵「域摩」、人灵「区冥」，共有「六神」、「四鬼」、「三灵」。其中特别值得一提的是最后的三灵，她们所拥有的神通汇集了寒於氏的精、气、神，若是善加利用，威力将远远凌驾其他十位精灵之上。"
msgstr ""

msgid "许多人都相信，区冥氏死了之后会不断地经由「转世」而继续复活，但是她的能力却全部分给了所有子女，因此人类能够凌驾于其他的虫鱼鸟兽之上，造就出伟大的成就，人类死亡之后，也会像区冥一样地转世再生，但是只有区冥能够保持每一生每一世的记忆，虽然再生的区冥氏所具有的能力和一般人类没有两样，但是她所累积的智慧是无人可及的。"
msgstr ""

msgid "法门源流"
msgstr ""

msgid "所有的魔法依照能量来源的不同可分为两类：「法术」与「咒文」。"
msgstr ""

msgid "所谓「法术」是指来自施法者自身的修为，以及自身所操控的能量所造成的魔法效果，这类魔法通常被视为高深的学问，并且是可以研究出「为什么？」的，法术的效果通常显著、直接、而且难以抗拒，尤其是当施术者的能力十分强大的时候。法术最初的起源是来自对于「咒文」力量的怀疑，并且在企图找出其力量根源的过程中逐步经由实验所建立起来的理论系统。"
msgstr ""

msgid "所谓「咒文」是指根据某种咒语、动作、仪式而与存在于宇宙中某种超然存在的生物或意志沟通，而藉其力量引发的魔法效果，这类魔法的历史比法术更早，而且这些「超然存在」的实体通常被人称为「神」、「魔鬼」、「精灵」等等，咒文宗教上的意义大于学术上的意义，但是又似乎并不完全是宗教上的力量（即：不管你信不信，或多或少都能产生实际的效果，而非单纯心理现象），一般使用咒文者很难探究「为什么」这样的咒文会引发这样的效果，咒文的来源全部都是来自古老的记载或无意中的发现。"
msgstr ""

msgid "虽然有不少魔法到底是属于「法术」系或「咒文」系仍然存有争议，但是人们已经找到一种简单的方法来区分他们，那就是「法术」消耗的能量是「灵力」、「咒文」消耗能量是「法力」（由于咒文的历史远较法术来得更早，因此在当时普遍使用的「魔法」、「法力」等名词都是指咒文系魔法而言，沿用至今）。"
msgstr ""

msgid "「神通」，长期钻研佛法的高僧常常会因自己本身的修为，产生具有神奇力量的神通，如天眼通、大力神通等，愈是具有大智慧、大慈悲的高僧其神通愈强，这类的法术通常需要百分之百的精神集中，才能施展，但是所需耗费的灵力较少，而且大多是属于防御或辅助性质的功能。"
msgstr ""

msgid "「道法」，道家讲究清静无为，法天自然，因此道法修行到了某一个程度，就能够利用天地阴阳生化的道理，吸取天地之精华纳为己用，道法所涵盖的范围极广，但是受到天时、地利、与施法者本身的状态影响很大，但是只要这几个条件能够配合，道法的威力是无可抵御的。"
msgstr ""

msgid "「仙术」，这是一门相当古老的修行法门，讲究炼气与长生不死之术，修炼仙术的人并不膜拜任何神祇，只集中于修炼自己的肉身，使之达到不朽的境地，进而羽化成仙，仙术除了在炼气方面相当杰出之外，还有许多炼丹的法门，但是一般人想要学习仙术并不容易，因为除了要有慧根之外，要找到愿意传授仙术的仙人也是一项非常艰困的修炼。"
msgstr ""

msgid "「密法」，佛家的一门分支，以手印与咒文为主，详细情形并不清楚，但是密法是一门攻守兼备，系统精严的法术，使用密法的人通常也擅长使用法器战斗，他们的修行是以降妖伏魔为主，密法修行至高深处时，也能拥有某些类似「罗汉神通」的能力，和佛家是殊途同归的正道。"
msgstr ""

msgid "「奇门」，又称茅山术，由于偏重治鬼与符箓咒术，往往被道家斥为旁门左道，但是奇门法术入门较易，且于临敌之际有其实用性在，加之不若正统道家那般虚无缥缈，因此一直拥有为数众多的人修习，虽然威力不如道法，但是近世经一位高人整理发扬，已经隐然有与正统道家分庭抗礼之势。"
msgstr ""

msgid "「魔道」，这类法术的修炼者以精怪居多，人类亦有少数，分为天魔、地魔、人魔三种，由于修炼法门往往必须杀伤生命，被多数人强烈憎恨，但是魔道威力集道法与仙术之所长，又为求利己不择手段，不但进境迅速兼且危险，以致于各家法术之中均有克制魔道的研究与法术，可说是树敌最多的一门。"
msgstr ""

msgid "道士"
msgstr ""

msgid "道士是一群以修炼成仙，而达到「与天地同休，与日月同寿」之境界的修道人，和其他的宗教比较起来，道士对于「人」的地位看得相当崇高，认为天、地、人在宇宙中的地位是相等的，因此，道教的教主是一个「人」，而不是高高在上、和凡人之间有不可跨越之鸿沟的「神」。"
msgstr ""

msgid "道士的能力偏重于炼气，武术方面以内功、剑术见长，正统道家除炼气之外并不修习任何法术，但是许多道士往往会涉猎一些除妖降魔用的法术，以作为入山修炼时防身之用，有些支派的道士更发展成专研法术而舍弃修炼成仙的目的。"
msgstr ""

msgid "时间是天朝佑圣元年，岁次甲子，年仅十六岁的皇帝刚刚登基，雪亭镇上熙来攘往，一队身著白衣的朝廷武官和两名老者在镇前的广场中坐著，四面来来往往的人当中，有不少显然是武林中人，正探头探脑地向著广场张望。"
msgstr "Шёл первый год правления Юшэн Небесной династии, год цзя-цзы; шестнадцатилетний император только что взошёл на престол. В городке Сюэтин было людно и шумно. На площади перед городком сидели отряд придворных офицеров в белом и двое стариков, а среди сновавших вокруг прохожих немало было, судя по всему, людей из улиня — они вытягивали шеи и поглядывали на площадь."

msgid "马上乘客一跃而下，快步走到老者身前，躬身说道：「禀将军，时辰已到，白道长命下官回禀，方位是在....」，说著压低了声音。"
msgstr "Всадник соскочил с седла, быстро подошёл к старикам и, поклонившись, сказал: «Докладываю, господин генерал: час настал. Даос Бай велел мне передать, что место — в...» — и тут он понизил голос."

msgid "广场西边一家小客栈里，一个年约十四岁的少年问店里的小二道：「这些人神秘得紧，却不知到底在玩什麽把戏？」"
msgstr "В маленьком трактире на западной стороне площади юноша лет четырнадцати спросил трактирного слугу: «Уж больно таинственные эти люди. Что за игру они затеяли?»"

msgid "小二抄起脖子上的毛巾，抹了抹脸，说道：「小哥您有所不知，这些个爷儿们可是大内来的高手，这次是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的，那骑马的官爷所称的白道长，便是咱们这附近有名的太乙观观主....」"
msgstr "Слуга стянул с шеи полотенце, утёр лицо и сказал: «Вам, молодой господин, невдомёк: эти господа — мастера из самого дворца. Наш государь повелел им ехать в Ланьчэн и сыскать какой-то меч, \"Вихревой блеск\", что ли. А даос Бай, о котором говорил верховой офицер, — настоятель даосского монастыря Тайи, тут у нас неподалёку, человек известный...»"

msgid "少年奇道：「岚城？那是什麽地方？怎麽我从小到大不曾听过有这个地方？」"
msgstr "Юноша удивился: «Ланьчэн? Это где же? Отчего я сроду о таком месте не слыхал?»"

msgid "少年听著出了神，怔怔地望著外面的天空，一朵朵的浮云飘来飘去，他的心思也不由自主地飞了起来。"
msgstr "Юноша заслушался и замер, глядя на небо за окном. Одно за другим проплывали облака, и мысли его сами собой унеслись следом."

msgid "那少年，便是你。"
msgstr "Тем юношей были вы."

msgid "寻剑令"
msgstr "Указ о поисках меча"

msgid "大内高手在找一把剑。去西南二十四里的黄石隘口，看他们找什么。"
msgstr "Дворцовые мастера ищут меч. Отправиться на Желтокаменный перевал, в двадцати четырёх ли к юго-западу, и узнать, что они ищут."

msgid "在黄石隘口看着官队挖出石匣、又被黑衣道士抢走"
msgstr "Видели на Желтокаменном перевале, как офицеры выкопали каменный ларец, а даос в чёрном его похитил"

msgid "跟店小二打听广场上的「官爷」。"
msgstr "Узнать у трактирного слуги, что за «офицеры» на площади."

msgid "店小二说外头广场上来了大内的官爷，叫你去瞧瞧。"
msgstr "Трактирный слуга сказал, что на площади объявились офицеры из дворца, и посоветовал сходить посмотреть."

msgid "去镇前的广场，看看官爷们在做什么。"
msgstr "Пойти на площадь перед городком и посмотреть, что делают офицеры."

msgid "冯策叫信使大声报了方位：西南二十四里，黄石隘口。"
msgstr "Фэн Цэ велел гонцу громко объявить место: в двадцати четырёх ли к юго-западу, Желтокаменный перевал."

msgid "在广场上当面向大内的总教头问了寻剑的事"
msgstr "Прямо на площади расспросили главного мастера дворцовой стражи о поисках меча"

msgid "围观的江湖客悄悄告诉你：官爷们要去西南二十四里的黄石隘口。"
msgstr "Странник из толпы шепнул вам: офицеры направляются на Желтокаменный перевал, в двадцати четырёх ли к юго-западу."

msgid "在广场上向围观的江湖人打听了官队的去处"
msgstr "Расспросили людей цзянху на площади, куда направился отряд офицеров"

msgid "去西南二十四里的黄石隘口，看他们找什么。"
msgstr "Отправиться на Желтокаменный перевал, в двадцати четырёх ли к юго-западу, и узнать, что они ищут."

msgid "你到了黄石隘口。官队正在山壁下挖土，白道长守在坑边。"
msgstr "Вы пришли на Желтокаменный перевал. Офицеры копают землю под скалой, даос Бай стоит на страже у края ямы."

msgid "看官队在山壁下挖什么。"
msgstr "Посмотреть, что офицеры откапывают под скалой."

msgid "官队挖出一只刻着风纹的石匣；一个黑衣黑冠的道士从崖上掠下，抢了匣子就逃，掉下一块布条。白道长说匣里是岚城的风铃。"
msgstr "Офицеры выкопали каменный ларец с узором ветра; даос в чёрном одеянии и чёрной шапке слетел со скалы, схватил ларец и бежал, обронив лоскут. Даос Бай сказал, что в ларце были ветряные колокольчики Ланьчэна."

msgid "拾起黑衣道士掉下的布条。"
msgstr "Подобрать лоскут, оброненный даосом в чёрном."

msgid "布条上刻着老松寨的记号：黑衣道士往老松岭去了。"
msgstr "На лоскуте — знак Стана Старой сосны: даос в чёрном ушёл к Хребту Старых сосен."

msgid "伪墓"
msgstr ""

msgid "追到黑衣道士，弄清老松寨和那口墓。"
msgstr ""

msgid "查明了瀑布山洞里的墓是假的"
msgstr ""

msgid "顺着布条上的记号去老松岭，沿松树上的刀痕找老松寨。"
msgstr ""

msgid "松树上的刀痕指向灌木后的一条小径：老松寨藏在林子深处。"
msgstr ""

msgid "过老松寨的寨门：留下买路钱、叫阵，或者打进去。"
msgstr ""

msgid "你给了寨门的喽罗十两银子买路钱，寨里的人不再拦你。"
msgstr ""

msgid "给老松寨的喽罗付了买路钱"
msgstr ""

msgid "你在寨门外叫阵，喽罗放你进去：常老大在聚义厅等你。"
msgstr ""

msgid "在老松寨的寨门外叫阵"
msgstr ""

msgid "你打倒了寨门的喽罗，硬闯进了老松寨。"
msgstr ""

msgid "硬闯了老松寨的寨门"
msgstr ""

msgid "到聚义厅找常老大，问黑衣道士的去向。"
msgstr ""

msgid "常老大说那道士拿一块金牌买了路，往东边的瀑布去了。"
msgstr ""

msgid "你打倒了常老大。他跌坐在熊皮上骂道：那道士拿金牌买的路，往东边的瀑布去了，找他去！"
msgstr ""

msgid "打倒了老松寨的常老大"
msgstr ""

msgid "从瀑布后面进山洞，找黑衣道士。"
msgstr ""

msgid "瀑布后的山洞尽头有一具骸骨和一面刻字的石壁。"
msgstr ""

msgid "拦住黑衣道士。"
msgstr ""

msgid "黑衣道士落败，石匣还锁着，留在洞里。"
msgstr ""

msgid "看看洞里的石壁和那具骸骨。"
msgstr ""

msgid "石壁上的字自称「南危水」，说埋骨于此——可骸骨身量矮小、骨龄不过三十，身边没有剑；字迹深浅如一，是活人慢慢刻的。这不是南危水的墓。"
msgstr ""

msgid "处置那具骸骨：安葬他，或者带走他身边的腰牌。"
msgstr ""

msgid "你把无名人安葬了，腰牌随他入土。洞顶落下一本《过招要旨》。"
msgstr ""

msgid "安葬了瀑布山洞里的无名人"
msgstr ""

msgid "你拿走了骸骨身边的水烟阁腰牌：金乌徽，背面一个「岭」字。"
msgstr ""

msgid "拿走了瀑布山洞骸骨身边的腰牌"
msgstr ""

msgid "旧案"
msgstr ""

msgid "去水烟阁，问清五长老的死。"
msgstr ""

msgid "查清了二十年前水烟阁五长老的旧案"
msgstr ""

msgid "回雪亭镇淳风武馆，把山洞里的事告诉柳淳风。"
msgstr ""

msgid "柳淳风写了一封引荐信，让你去水烟阁找他的结拜义弟、执法使潘军禅；他说二十年前失在老松岭的那趟镖是振远镖局押的。"
msgstr ""

msgid "去绮云镇振远镖局，问陈剑秋二十年前的失镖。"
msgstr ""

msgid "陈剑秋拿出二十年前的镖单：押的是水烟阁盟主印一方、密件一匣，失镖于老松岭，无一人生还。振远至今不提这桩丢人事。"
msgstr ""

msgid "上水烟阁的山，看葬剑亭里的碑。"
msgstr ""

msgid "葬剑亭碑：第四代七长老以奸计害人，被众武者合力击杀，甲辰年立亭为后人殷鉴。"
msgstr ""

msgid "看虹谷石台的碑。"
msgstr ""

msgid "虹谷石台碑：乙丑年，第六代阁主关雨楼立——正是失镖那年。字是用手指在岩石上写的，和山洞石壁上的刻字是一个手法。"
msgstr ""

msgid "上楼找五长老南危水，拿证据问他山洞里的骸骨。"
msgstr ""

msgid "南危水承认了：山洞里死的是他的随从阿岭，伏击的是白衣武官，盟主卫沧澜被带走。他装死二十年，是怕哥哥槐阳王知道朝廷伏击了自己的弟弟会反。"
msgstr ""

msgid "拿着引荐信到前厅找执法使潘军禅，问「邪剑穿灵」。"
msgstr ""

msgid "潘军禅说那把邪剑穿灵是仿剑、是鱼饵：去年一个黑衣道士来试过它，往野羊山北麓去了。"
msgstr ""

msgid "替南危水保密（他欠你一个人情，到了关北替你引见他哥哥槐阳王），还是告诉七长老颜违（颜违借这件事坐稳代盟主，南危水不会再和你同路）？"
msgstr ""

msgid "你替南危水保了密。他说，到了关北，他替你引见槐阳王。"
msgstr ""

msgid "替水烟阁五长老南危水保住了二十年的秘密"
msgstr ""

msgid "你把南危水的事告诉了七长老颜违。颜违当日便以代盟主自居；南危水闭门不出，水烟阁来信告诉了关北。"
msgstr ""

msgid "把五长老南危水装死二十年的事告诉了七长老颜违"
msgstr ""

msgid "进野羊山北麓的黑道观，找到失踪的大寨主。"
msgstr ""

msgid "查清了逆灵宫纳供的真相"
msgstr ""

msgid "黑衣道士往野羊山北麓去了。去打听北麓的道观：野羊寨的黄霸在山路边的土地庙里；淳风武馆的门房刘安禄也知道——若他肯说。"
msgstr ""

msgid "刘安禄说了：野羊寨的大寨主霍铮是他拜过把子的大哥，半年前被北麓黑砖道观的道士带走，再没回来；那伙人自称逆灵宫。三寨主黄霸接了寨子，每年给道观纳供；他不肯伺候那群道士，才下山做了门房。纳供的车这几天上山，到山路转角，道士从北边山壁的裂口把东西吊上去——道观就在裂口上头。"
msgstr ""

msgid "黄霸说了：两年前北麓起了一座黑砖道观，自称逆灵宫，寨里折了一半弟兄；半年前大寨主霍铮、二寨主一前一后没了下落，寨子落到他手里。他打不过那些道士，每年纳供换野羊寨还在山上。今年的车已经上去了，这会儿该到了山路转角。"
msgstr ""

msgid "去野羊山的山路转角，看黄霸的纳供车。"
msgstr ""

msgid "两个黑衣道士守着一辆盖着油布的车。车上的箱子一只只吊进北边山壁的裂口里——他们不走山路。"
msgstr ""

msgid "逆灵宫就在裂口上头。找到失踪的大寨主霍铮。跟着纳供车上去、打倒押车道士攀绳，或者戴上黑衣道士的黑冠——黄霸那里有一顶。"
msgstr ""

msgid "你进了逆灵宫。"
msgstr ""

msgid "站稳脚跟，看看这是哪里。"
msgstr ""

msgid "你缩在供品箱子中间，和纳供一起被吊上了裂口。绞盘旁的道士只当你是箱子。"
msgstr ""

msgid "混在野羊寨的供品里进了逆灵宫"
msgstr ""

msgid "你打倒了押车道士，攀着他们的绳子上了裂口。"
msgstr ""

msgid "打倒押车道士闯进了逆灵宫"
msgstr ""

msgid "你戴上黑冠，押车道士只当你是宫里的人，让你自己攀了上去。"
msgstr ""

msgid "戴着黑冠走进了逆灵宫"
msgstr ""

msgid "顺着货道往北，进黑砖山门，看看这座道观。戴着黑冠的，道士当你是自己人。"
msgstr ""

msgid "黑砖的前院：黑幡垂地，香炉里烧的不是香。前殿的门关着，东边的矮房是货栈。"
msgstr ""

msgid "前殿的门关着。推开殿门进前殿，找到霍铮。"
msgstr ""

msgid "前殿里没有神像。五个黑冠道士面壁诵逆灵天书，领诵的敲着木鱼，谁进来都不抬头。殿西有门，殿北的门关着。"
msgstr ""

msgid "殿西是丹房和账房。账房的案上摊着纳供的账册，翻一翻。"
msgstr ""

msgid "纳供的不只是金帛，是人：野羊寨三名「入丹房」；关北民夫七名，三名入丹房、四名留用；傅家坡七岁的孩童一名，「留用，待子时」。"
msgstr ""

msgid "案上还有一叠盖着朱印的文书。"
msgstr ""

msgid "一叠盖着兵部大印的文书：「着逆灵宫代为收管」关北的河工、野羊山的「匪徒」。兵部的印，盖在一座黑道观的账上。"
msgstr ""

msgid "丹房西南角有石阶往下。下地牢，找霍铮。"
msgstr ""

msgid "霍铮锁在西边的牢房里，瘦得脱了形，骂声还在；北边那间是傅家坡的石头，七岁，头上两个小抓揪；东边两个关北来的民夫。三扇铁栅门的钥匙在大弟子玄冥子腰上。"
msgstr ""

msgid "牢门开不了，钥匙在大弟子玄冥子腰上。前殿北门后的后殿有诵经声——钥匙该在那里。"
msgstr ""

msgid "后殿没有神像，只有一座黑石坛。商玦行「唤首」：黑焰里现出一个无头的黑影，摸索着找什么。商玦把地牢钥匙丢给了玄冥子——「子时开坛，带祭品上来」——退进黑门，玄冥子跟着走了。坛底爬出两个鬼卒。"
msgstr ""

msgid "坛底爬出来的鬼卒拦在你面前。打退它们。"
msgstr ""

msgid "鬼卒散成黑烟。坛后的黑门开着；地牢的钥匙在狱卒手里了。"
msgstr ""

msgid "两件事只来得及做一件：回地牢，狱卒手里有钥匙了，救霍铮和石头；或者穿过黑门追商玦。"
msgstr ""

msgid "你打开了牢门。霍铮和石头跟你走了，关北的民夫自己逃回关北。商玦带着逆灵天书从后山下了崖，玄冥子跟着走了。"
msgstr ""

msgid "从逆灵宫的地牢里救出了霍铮和石头"
msgstr ""

msgid "你穿过黑门和宫主的居所，追到了后山的崖径。等你再下地牢，狱卒已经动了手。"
msgstr ""

msgid "穿过黑门追到了逆灵宫的后山"
msgstr ""

msgid "带霍铮回野羊山的土地庙。"
msgstr ""

msgid "黄霸跪下让位，霍铮派弟兄送石头回傅家坡。野羊寨欠你一条命。"
msgstr ""

msgid "追上商玦。"
msgstr ""

msgid "商玦割断绳索下了崖。玄冥子断后，和你一战，倒在崖径上；逆灵天书的残卷落在他身边。"
msgstr ""

msgid "寒於宝衣在晚月庄。守它的人不白给。"
msgstr ""

msgid "找到了寒於宝衣"
msgstr ""

msgid "寒於的宝衣在哪？水烟阁的潘军禅、南危水知道旧事。"
msgstr ""

msgid "潘军禅说了：当年三件东西各归一处，宝衣归月神族保管。月神族早没了，只剩晚月庄——她们自称人灵区冥的后人，庄里供着神像，池边立着凤凰护庄。守它的人不白给。"
msgstr ""

msgid "南危水说了：寒於的宝衣当年归月神族保管，月神族的后人在晚月庄，供着人灵区冥的神像。守衣的人几百年没换过。"
msgstr ""

msgid "去晚月庄。绮云镇西出镇的石板路尽头。"
msgstr ""

msgid "晚月庄的前厅。庄里来的都是找宝衣的人：逍遥派的芙云、天山派的梦玉楼、书房里的老妇和那个蒙面杀手，还有西厢的客人。"
msgstr ""

msgid "西厢的客人安妮儿也在等宝衣。去问她。"
msgstr ""

msgid "安妮儿——东方神教的一代教主——在西厢住了三年。她说她等一件东西，也等一个配得上它的人。"
msgstr ""

msgid "东厢的瑷伦是守衣人。问她宝衣。"
msgstr ""

msgid "瑷伦认了：衣在庄里，她守着，守了几百年——三十七岁的脸。宝衣不白给：接她三鞭，站着不倒，再谈。"
msgstr ""

msgid "接瑷伦三鞭。倒了可以歇好再来。"
msgstr ""

msgid "你接下了瑷伦的三鞭。她收起鞭子，问你一句：你拿它去做什么。"
msgstr ""

msgid "瑷伦问：你拿它去做什么？——为了斩鬼、交给安妮儿，还是不知道。"
msgstr ""

msgid "你说：为了斩鬼。瑷伦点头：寒於留它，本来就是为这个。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr ""

msgid "对守衣人说，要拿寒於宝衣去斩鬼"
msgstr ""

msgid "你说：交给安妮儿。瑷伦的脸冷了下来，却不拦：拿得走就拿。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr ""

msgid "对守衣人说，要把寒於宝衣交给安妮儿"
msgstr ""

msgid "你说：不知道。瑷伦说，不知道比胡说一个好。衣在第二密室的冰匣里，匣只认「有凤来仪」。"
msgstr ""

msgid "对守衣人说，还不知道拿寒於宝衣做什么"
msgstr ""

msgid "宝衣在第二密室的冰匣里，匣只认「有凤来仪」：女子自己跳，男子请内厅的筱薇或禁闭房的芳绫替跳。第二密室从内厅穿堂南边的花门进，或在第一密室跳「有凤来仪」。"
msgstr ""

msgid "冰匣开了。一件月白的衣落在地上，寒气扑面。"
msgstr ""

msgid "宝衣到手。交回瑷伦守到决战；交给安妮儿，或者带着它走出晚月庄的大门——宝衣一离开瑷伦，庄就没了护佑，当夜会出事：东方神教派来的杀手会摸进前厅，见人就动手——要打一场；打不过，退出前厅，她不追。"
msgstr ""

msgid "你把宝衣交给了安妮儿。她说：月神族守了几百年，守给我的。你配得上——东方神教记得你。"
msgstr ""

msgid "把寒於宝衣交给了东方神教的安妮儿"
msgstr ""

msgid "你把宝衣交回瑷伦。她披上它：我守到决战那日。到时候你来叫我，我跟你下湖底。"
msgstr ""

msgid "把寒於宝衣留给了守衣人瑷伦"
msgstr ""

msgid "你带着宝衣走出了晚月庄的大门。庄失去了护佑。"
msgstr ""

msgid "带走了寒於宝衣"
msgstr ""

msgid "人证"
msgstr ""

msgid "兵部的印是真的，令不是先帝的。要动兵部的人，须有人在堂上说。"
msgstr ""

msgid "把寻剑令的真相递到了乔阴县的公堂上"
msgstr ""

msgid "带着逆灵宫那叠盖兵部印的文书去乔阴县衙，击门口的大皮鼓。没带文书，侍卫不开门——文书还躺在逆灵宫的账房。"
msgstr ""

msgid "带刀侍卫从内院出来：是你击鼓申冤吗？——衙门的大门开了。"
msgstr ""

msgid "进大堂，把兵部文书给县官程不平看。"
msgstr ""

msgid "程不平看得出文书是真的，可要动兵部的人，须有人证——印是谁盖的，人去了哪，得有人在堂上说。他指了一个人：福林酒楼里日日发呆、丢了箱子的武官，姓陈。"
msgstr ""

msgid "福林酒楼里丢了箱子的武官姓陈。给他看兵部的印。"
msgstr ""

msgid "陈显祖见了兵部的印脸色就变：他是二十年前老松岭那队白衣武官里的逃兵。当年念给全队听的寻剑令抄本一直藏在他的桃木箱里——箱子丢在树王坟的树洞里。"
msgstr ""

msgid "寻剑令的抄本在陈显祖的桃木箱里。箱子在树王坟的树洞里——洞里不干净。箱子已经还了他的，问他要抄本。"
msgstr ""

msgid "寻剑令的抄本到手：「寻剑，不得扰民一户」，一句。底下是当年全队的名字。"
msgstr ""

msgid "县衙的带刀侍卫是槐阳王的人。问他兵部的令。"
msgstr ""

msgid "槐阳王也收到过兵部「征三千民夫修官道寻剑」的令。老王爷拒了。"
msgstr ""

msgid "护送陈显祖进衙门作证（问他「作证」），或放他带箱子走（「走吧」）。"
msgstr ""

msgid "你把陈显祖护送进了乔阴县衙。福林大街上庾家的人动了手——他活着站上了公堂。"
msgstr ""

msgid "护送陈显祖上了乔阴县的公堂"
msgstr ""

msgid "你放陈显祖带着箱子走了。抄本和文书留在你手里。"
msgstr ""

msgid "放陈显祖带着箱子走了"
msgstr ""

msgid "堂审。带着抄本和兵部文书回大堂见程不平。"
msgstr ""

msgid "程不平录了供，写信给叔父槐阳王：假印和失踪的人都往关北去了。兵部的海捕文书也到了县衙——说你是逆灵宫的同党。程不平压着，压不了几天；文书往雪亭去了，你住的那家客栈。"
msgstr ""

msgid "关北"
msgstr "Гуаньбэй"

msgid "假印和失踪的人都往关北去了。先在天驼关把印的事问清楚，再出关去槐阳城，把程不平的信递给槐阳王；然后借兵踏平工地，或者带郭承夜里潜进去。卢卡说他们那边也传说一个找头的鬼。"
msgstr ""

msgid "在关北救出了兵部工地上的民夫"
msgstr ""

msgid "带着程不平的信去天驼关军营，给镇国大将军严廷殷看（军营要大队长的名册）。"
msgstr ""

msgid "严廷殷看了信：兵部的印是真的，令不是先帝的——这话他不敢说。他的印丢过一回，找回来了；那三天的事，军师比他清楚。"
msgstr ""

msgid "程不平的信在你身上"
msgstr ""

msgid "信丢了的话，回乔阴县衙问程不平「兵部文书」，他会再写一封"
msgstr ""

msgid "军师赫造基知道印的事。他卖秘密——八两银子。"
msgstr ""

msgid "赫造基收了八两银子：真印丢的那几天他拓了模子，卖了一份给兵部来的人。留着的那一份印模，他给了你。"
msgstr ""

msgid "拿印模比一比兵部文书上的印（印模的「比印」）。真印泛黄光，假的没上朱。"
msgstr ""

msgid "印模上的朱砂正红、泛黄光；兵部文书上那方「镇国大将军」印暗红发黑。字口一笔不差，只差一个颜色：兵部的文书是真的，镇国大将军的印是照模子浇的，令是兵部添的。"
msgstr ""

msgid "出关：天驼关谷地东壁的关门。有信、名册上有你、留五两过路钱，或者打过去。"
msgstr ""

msgid "关门兵放了行。门后的军道绕过骆驼东峰往北折。"
msgstr ""

msgid "顺着军道往北，出了山就是关北。"
msgstr ""

msgid "黄土变成了草。路边一方青石界碑：「关北封国界」。往北，一座土黄的城墙横在草地尽头——槐阳城。"
msgstr ""

msgid "进槐阳城。城门旁有一张王府的告示，看看。"
msgstr ""

msgid "王府的告示：「兵部征夫令，本府不奉。有持兵部文书到关北拿人者，以盗论。」告示上的印色正红——和逆灵宫那叠文书上的不一样。"
msgstr ""

msgid "王府在大街北头。门军认程不平的信；把信递给槐阳王程朔。"
msgstr ""

msgid "程朔读了信：兵部的印是真的，令不是先帝的——他早说了。失踪的人在草原东边兵部的工地上挖一座古冢，挖不动的让道士的车接走。两条路：借他的兵踏平，或者让郭承带你夜里进去。"
msgstr ""

msgid "借槐阳王的兵踏平工地（问程朔「借兵」：救下所有人，但兵部会说关北反了），或带骁将郭承夜里潜入（在校场问郭承「潜入」：救一半，王府干净）。"
msgstr ""

msgid "你借了槐阳王的兵。程朔：「踏平了，兵部的文书第二天就到京师：槐阳王反了。」郭承领六骑听你的。"
msgstr ""

msgid "借了槐阳王的兵，要踏平兵部的工地"
msgstr ""

msgid "你和郭承约好了夜里潜入工地。「救得几个算几个，救不完的别回头。王府不知道这件事。」"
msgstr ""

msgid "和王府骁将郭承约好夜里潜入工地"
msgstr ""

msgid "去草原东边兵部的工地（出马市东门，过帐篷营地和草原）。借了兵的，郭承跟着你，白天就去；约好潜入的，先在营地的篝火边等到天黑。"
msgstr ""

msgid "草原东边的工地：一道木栅栏，三顶帐篷，两溜民夫棚，土堆得像小山。白衣的武官守着门，监工吕隼拿着名册。"
msgstr ""

msgid "踏平工地：打倒白衣武官、队长裴照和监工吕隼，打开民夫棚前的枷锁。"
msgstr ""

msgid "王府的六骑冲进了工地。白衣武官倒了，裴照倒了，吕隼趴在他的名册上。你打开了八副枷锁，八个民夫回营地去了；古冢口的道士丢下车跑了。兵部的文书明天就到京师：槐阳王反了。"
msgstr ""

msgid "夜里跟着郭承潜进工地，到民夫棚解枷。救得几个算几个，救不完的别回头。"
msgstr ""

msgid "夜里的工地只有两个守夜的。你和郭承解开了四副枷锁——王石头、刘拐子、巴图、胡阿大跑了；第四副铁销响了，守夜的武官扑上来。打完，郭承说：走。另外四个人的名字，你在名册上见过：老魏、周二牛、陈满仓、马三。"
msgstr ""

msgid "回马市问大秦剑手卢卡「会首」——他们那边也传说一个找自己脑袋的鬼。"
msgstr ""

msgid "卢卡说他的会首安敦在番坊，番坊的人知道那个鬼的事。番坊在海边：从玉螺湖村出忘情谷，走海崖道。"
msgstr ""

msgid "卢卡说他的会首安敦在番坊，会首的祖上三百年前见过那个鬼的头是怎么封的。番坊在海边：从玉螺湖村出忘情谷，顺着小路往南，走海崖道下去。"
msgstr ""

msgid "从拜火祠取回了三百年前老兵刻下封法的铜牒"
msgstr ""

msgid "去番坊找大秦人的会首安敦——卢卡说他们知道鬼的头在哪。出忘情谷，顺着小路往南，走海崖道。"
msgstr ""

msgid "林子到头，崖下第一次看见了海。海崖道顺着崖往南下去，崖脚是番坊的码头。"
msgstr ""

msgid "找大秦人的会首安敦——市集北头，门口立着两面大盾的铁盾会，院子北头会首的屋。"
msgstr ""

msgid "铁盾会的会首安敦见了你：他的祖上三百年前替皇叔於兰淳焉打过北方的蛮族，其中一个老兵见过那个鬼的头是怎么封的。"
msgstr ""

msgid "安敦的祖上把看见的刻在一片铜牒上，传到了他手里——问他「铜牒」。"
msgstr ""

msgid "铜牒存在拜火祠的火前，三十年了。祠规「火前不说谎」：取牒要过一场问话，三句。大秦人自己过不了——三十年前他们为了这块地在火前说过一句谎。"
msgstr ""

msgid "市舶司要清走大秦人，鬼笠馆的浪人想要他们的地。站大秦人（问安敦「站大秦人」：拜火祠过问话取牒，再替他们挡住冯禄），还是站浪人（去日陀罗寺南墙小门外的鬼笠馆，问早川「站浪人」，过他一刀，让浪人替你偷牒——浪人会作证，市舶司就把大秦人清出番坊）？"
msgstr ""

msgid "你站了大秦人。安敦：「三句真话，牒是你的。读了，再还我们一个人情：冯禄来的时候，站在门口。」"
msgstr ""

msgid "在番坊站到了大秦人一边"
msgstr ""

msgid "你站了浪人。早川只说了一句：「要铜牒？过我一刀。」"
msgstr ""

msgid "在番坊站到了浪人一边"
msgstr ""

msgid "拜火祠（市集东头的黑石房子）：站到火前，答穆护三句真话，取铜牒。问的是你自己做过的事——撒一句谎，火蹿起来，当天不再问。"
msgstr ""

msgid "火静了。穆护从火坛底下取出铜牒，放在你手里——还是温的。「火前拿的，谁也不能说你偷。」"
msgstr ""

msgid "回铁盾会：冯禄带着他雇的四个浪人到了院门口。站到门口去，对质那纸文书——有印模的，按在印旁边对一对印色；没有的，只能动手。"
msgstr ""

msgid "冯禄退走了。大秦人留下了，安敦说：「你欠我们的人情，我们记着；我们欠你的，也记着。」"
msgstr ""

msgid "鬼笠馆（日陀罗寺南墙的小门外，坡道底下）：找馆主早川直义，过他一刀——一击之内定生死。"
msgstr ""

msgid "早川收刀入鞘：「过了。今夜，拜火祠——火坛前站着，别出声。」"
msgstr ""

msgid "等到天黑（鬼笠馆的板地能歇到天黑），去拜火祠的火坛前站着，别出声。浪人替你偷牒。"
msgstr ""

msgid "黑影把铜牒塞进你手里，走了。祠里传出祭司的骂声。第二天，冯禄的文书有了浪人作证——铁盾会空了，安敦被押上了船，卢卡剩在码头上。"
msgstr ""

msgid "读铜牒——三百年前的老兵刻下的，那个鬼的头是怎么封的。"
msgstr ""

msgid "「头在湖底冰下，以穿灵为钉；钉在，鬼不得全；钉拔，鬼成形；要灭它，三器齐；要再封，须有人留下。」——三百年前的老兵刻的。那把剑是钉子。"
msgstr ""

msgid "湖底封物"
msgstr ""

msgid "铜牒说：头在湖底冰下，以穿灵为钉。那把剑钉着鬼的头——在玉螺湖底。渔夫说湖里不太平，别碰那把剑。"
msgstr ""

msgid "下到玉螺湖底，看清了三百年的封物"
msgstr ""

msgid "回玉螺湖村，下湖底，看清封物。别拔那把剑。"
msgstr ""

msgid "你到了湖底。从湖心潜下来的，身后的入口结上了冰；从忘情谷下冰阶来的，一下阶就是冰龙的厅。"
msgstr ""

msgid "玄冰上站不住人。顶住寒气，穿过冰龙的厅——它们是守者，不先动手就不打。"
msgstr ""

msgid "六条白鳞冰龙抬头看了你一眼，又盘了回去。"
msgstr ""

msgid "冰龙厅的水潭底下透着白光。潜下去。"
msgstr ""

msgid "潭底的黑石台阶下是一间冰室：黑石封坛，冰里的头，钉着它的剑，柱里的人。"
msgstr ""

msgid "看清封物：冰里的头、钉着它的剑、冰柱里的人。听她说——把铜牒念给冰柱里的人听。"
msgstr ""

msgid "璃虹：钉拔，它成形，先回这附近的村子；要灭它，三器齐——穿灵、旋芒、宝衣；要再封，须有人留下。"
msgstr ""

msgid "商玦劝你拔剑。拔，剑到手、鬼醒；不拔，带着封法去京师和岚城，终章再回来。"
msgstr ""

msgid "你拔出了穿灵。冰里的头睁开了眼，璃虹从冰里跌了出来，商玦笑着散成了黑烟。上岸——天黑之前。"
msgstr ""

msgid "在玉螺湖底拔出了穿灵"
msgstr ""

msgid "你没有动那把剑。璃虹给了你一片她的羽：再封的时候，放回坛上。"
msgstr ""

msgid "在玉螺湖底看清了封物，没有动它"
msgstr ""

msgid "天黑了。鬼卒从湖里上来——守住村子：湖畔、村口、稻田边。（湖畔的木船边能等到天黑。）"
msgstr ""

msgid "天亮了。村子烧了一半，渔夫死在岸边，璃虹在田老财家的东房里躺着。钉没了，它每一夜都在长。"
msgstr ""

msgid "原令"
msgstr ""

msgid "璃虹说三器齐才灭得了它：穿灵、旋芒、宝衣。旋芒在岚城，岚城寻风而至——先帝找了它一辈子，寻剑的档案和那道寻剑令的原本都在皇城。去京师。"
msgstr ""

msgid "拿到了寻剑令的原本"
msgstr ""

msgid "进皇城。三条路：校武场的武举、相国府的公文，或者尚书府里有人知道的一条暗路。"
msgstr ""

msgid "校武场三场全胜，殿试授了御前侍卫腰牌。退朝时福安凑过来：皇上说，今夜养心殿。"
msgstr ""

msgid "在京师校武场中了武状元"
msgstr ""

msgid "你随韦相国上了早朝。庾子建当殿驳了奏本，皇上「容朕想想」。退朝时福安追出来：皇上请相国的随员到养心殿说话。"
msgstr ""

msgid "随韦相国上了早朝"
msgstr ""

msgid "你从冷宫的井里爬了上来。"
msgstr ""

msgid "从冷宫的枯井潜进了皇城"
msgstr ""

msgid "见皇帝：福安说，养心殿。"
msgstr ""

msgid "养心殿里，十六岁的皇帝说：御书房里有父皇的匣子。"
msgstr ""

msgid "御书房：把先帝的原令和兵部的抄本放在一起。"
msgstr ""

msgid "原令只一句：寻剑，不得扰民一户。抄本上多出来的三句，是拿着假印的人加的。皇帝给了你一页樵夫的旧记载：风停处即是城。"
msgstr ""

msgid "怎么办：在养心殿朝上揭发（要原令加两样人证物证，关北踏平了工地的要三样）、去尚书府私了，或请皇上先解皇叔的通缉。"
msgstr ""

msgid "太和殿上，原令和抄本并排摊开。庾子建拔了刀，冯策站在你身边。他下了狱。"
msgstr ""

msgid "在太和殿上揭发了兵部尚书庾子建"
msgstr ""

msgid "原令进了庾子建的火盆。你换来了先帝推敲遗书的手稿。他留在朝上。"
msgstr ""

msgid "把先帝的原令交给了庾子建"
msgstr ""

msgid "皇帝亲笔写了手诏，东二门的布告撤了。手诏要送到水烟阁。"
msgstr ""

msgid "请皇帝撤了皇叔於兰天武的通缉"
msgstr ""

msgid "把手诏送到水烟阁，交给皇叔於兰天武。"
msgstr ""

msgid "於兰天武读了手诏，把传功使交给萧辟尘，回京了。"
msgstr ""

msgid "樵夫说：风停处即是城。岚城寻风而至，寻风而逝——天驼关石林里那面镜子后头，有一条原作没修完的路。"
msgstr ""

msgid "找到了岚城"
msgstr ""

msgid "读懂风，找到岚城。天驼关石林那面镜子里，上道通到哪里？"
msgstr ""

msgid "风停了。"
msgstr ""

msgid "白石街尽头的风铃阁。"
msgstr ""

msgid "风铃阁里，十口大铃，有的响，有的不响。"
msgstr ""

msgid "见岚翁，问他旋芒。"
msgstr ""

msgid "岚翁：剑在云台。他不卖，不赏，只问谁拔。"
msgstr ""

msgid "云台：谁拔旋芒——你自己（十铃里要响六口，先接岚翁的接风三刃）、皇叔（要他已经入朝）、萧辟尘（要带着他的风铃）。"
msgstr ""

msgid "风散了，剑落进你手里。岚翁说：十口铃里有人信你，剑就认你。"
msgstr ""

msgid "在岚城的云台上拔了旋芒"
msgstr ""

msgid "风把於兰天武送上云台。三百年前於兰家拔错了一把剑，这一把，他拔了。"
msgstr ""

msgid "在岚城的云台上，看着旋芒落进皇叔於兰天武手里"
msgstr ""

msgid "铃挂回了萧家的钩上，风把萧辟尘送回了家。剑落进他手里。"
msgstr ""

msgid "在岚城的云台上，看着旋芒落进萧辟尘手里"
msgstr ""

msgid "回到湖底"
msgstr ""

msgid "穿灵、旋芒、宝衣。三器凑没凑齐，湖底那颗头都在等。拔钉，斩鬼，或者再封它。"
msgstr ""

msgid "从玉螺湖底回到了雪亭镇，听了宣诏"
msgstr ""

msgid "回到湖底。拔钉，斩鬼，或者再封它。"
msgstr ""

msgid "湖面平得像一块铁，结着一层黑冰。冰底下的光一下一下地暗下去。"
msgstr ""

msgid "点将：三器在谁手里，来了几拨人。备好了，在湖畔「等到天黑」。"
msgstr ""

msgid "你在岸边等到了天黑。"
msgstr ""

msgid "穿灵在你手里"
msgstr ""

msgid "穿灵钉在封坛上"
msgstr ""

msgid "旋芒在你手里"
msgstr ""

msgid "交给了庾子建"
msgstr ""

msgid "旋芒在皇叔手里，他在岸边"
msgstr ""

msgid "旋芒在萧辟尘手里，他在岸边"
msgstr ""

msgid "宝衣在你身上"
msgstr ""

msgid "带上它，下湖前穿上"
msgstr ""

msgid "宝衣在瑷伦身上"
msgstr ""

msgid "她在晚月庄东厢等你去叫（问她「湖底」）"
msgstr ""

msgid "宝衣在安妮儿身上，她在岸边"
msgstr ""

msgid "帮手"
msgstr ""

msgid "野羊寨（霍铮）守村口"
msgstr ""

msgid "关北的骑兵（郭承）守湖畔"
msgstr ""

msgid "铁盾会的盾守稻田边"
msgstr ""

msgid "冰龙没有动过，在冰龙厅"
msgstr ""

msgid "大内侍卫营（冯策）随你下湖"
msgstr ""

msgid "东方神教（安妮儿）守潭口"
msgstr ""

msgid "水烟阁（南危水）守潭口"
msgstr ""

msgid "水烟阁（卫沧澜）守潭口"
msgstr ""

msgid "水烟阁（潘军禅）守潭口"
msgstr ""

msgid "封山（柳淳风）守渡口"
msgstr ""

msgid "北宗（柳绘心）守渡口"
msgstr ""

msgid "晚月庄（蓝止萍）守岸"
msgstr ""

msgid "晚月庄（老妇母女）守岸"
msgstr ""

msgid "铁卫营（严廷殷）守官道"
msgstr ""

msgid "茅山（林忌）截住了北麓下湖的路"
msgstr ""

msgid "岸上：庾子建来要剑"
msgstr ""

msgid "三器都在，帮手也够：能灭它"
msgstr ""

msgid "这一回只能再封"
msgstr ""

msgid "天黑了，鬼卒爬上了岸。没人守的地方你自己守；划到湖心，潜下去。"
msgstr ""

msgid "你潜下了湖。岸上的人替你守着。"
msgstr ""

msgid "冰龙厅：商玦在水潭边等你。"
msgstr ""

msgid "商玦倒在冰龙厅的水潭边。"
msgstr ""

msgid "水潭底下就是封坛。潜下去。"
msgstr ""

msgid "你回到了湖底。坛心的冰里，那颗头睁着眼。"
msgstr ""

msgid "封坛：侮天鬼。（钉还钉着的，先拔出穿灵；拔过了的，到坛心「迎上去」。）"
msgstr ""

msgid "侮天鬼散成一团黑焰，退回了那颗头底下。"
msgstr ""

msgid "最后一下：三器齐、人够，可以钉下去灭了它——宝衣会烧掉；也可以把穿灵交给一个肯留下的人，再封。"
msgstr ""

msgid "旋芒斩它，宝衣挡它的黑焰，穿灵钉它的头。侮天鬼灭了，宝衣烧成了灰。"
msgstr ""

msgid "在玉螺湖底灭了侮天鬼"
msgstr ""

msgid "瑷伦把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

msgid "在玉螺湖底再封了侮天鬼，瑷伦留在了冰里"
msgstr ""

msgid "璃虹把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

msgid "在玉螺湖底再封了侮天鬼，璃虹留在了冰里"
msgstr ""

msgid "南危水把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

msgid "在玉螺湖底再封了侮天鬼，南危水留在了冰里"
msgstr ""

msgid "萧辟尘把穿灵钉回那颗头上，留在了冰里。侮天鬼再封了。"
msgstr ""

msgid "在玉螺湖底再封了侮天鬼，萧辟尘留在了冰里"
msgstr ""

msgid "你把穿灵钉回那颗头上，自己留在了冰里。"
msgstr ""

msgid "在玉螺湖底再封了侮天鬼，自己留在了冰里"
msgstr ""

msgid "回雪亭镇。广场上，那队白衣武官又来了。"
msgstr ""

msgid "雪亭镇的广场上，宣了诏。"
msgstr ""

msgid "淳风武馆的门房换了个年轻人。刘安禄在野羊山上当他的二寨主，逢年过节下山喝一回酒。"
msgstr ""

msgid "淳风武馆的门房还是那张桌子。刘安禄的事，镇上没人再提。"
msgstr ""

msgid "淳风武馆的门房空了一冬。刘安禄走的那天没有人送，柳淳风在门里站了很久。"
msgstr ""

msgid "淳风武馆的门房还是那张桌子。刘安禄的来历，武馆里只有三个人知道。"
msgstr ""

msgid "淳风武馆照旧每天卯时开门，「剑不外传」四个字还挂在正厅。绮云镇口多了一块「北宗」的木牌，柳淳风从没去看过，也从没叫人摘。"
msgstr ""

msgid "淳风武馆的内院开了一道侧门，镇上的孩子从那里进出。柳淳风书房朝着内院的那扇窗，一冬天都没有关。"
msgstr ""

msgid "开春，你回了一趟山里，在老岑的坟前把信末那一行念给他听：风停处，替我再看一眼。——看过了。"
msgstr ""

msgid "广场上的人散了。卖馄饨的说，那天的官爷，跟三年前来的是同一拨。"
msgstr ""

msgid "振远的绮云分局照旧走镖。陈天星那本总账烧了，二十年前那笔抚恤银，振远没有人再提。"
msgstr ""

msgid "振远的绮云分局关了门。陈剑秋天天坐在柜台后面，不接镖，也不走。"
msgstr ""

msgid "瀑布后的山洞里，那座无名的坟前多了一块碑，碑上没有字。"
msgstr ""

msgid "瀑布后的山洞空了。那块腰牌后来回到了水烟阁，挂在葬剑亭里。"
msgstr ""

msgid "老松寨的寨门还在，买路钱一年比一年收得少。"
msgstr ""

msgid "五长老的椅子空着，说是等一个回不来的人。正月十七还没到，阁里没人提虹台。"
msgstr ""

msgid "卫沧澜回来了，坐在正厅侧的矮凳上，不肯坐那把太师椅。没有人再提「代盟主」三个字；正月十七的虹台，九派要上去推选。"
msgstr ""

msgid "南危水说，正月十七他要上虹台，只说一句：老松岭的那个人，替我死了。"
msgstr ""

msgid "七长老颜违以代盟主自居。他说正月十七一过，「代」字就该去掉了，二十年的旧案，到此为止。"
msgstr ""

msgid "传功使的位置空着。弟子们说，萧师父回城里去了。"
msgstr ""

msgid "东厢的门关着。庄里的人说，守衣人去守另一件东西了。"
msgstr ""

msgid "瑷伦回了东厢，宝衣挂在墙上。她说，几百年了，该歇一歇。"
msgstr ""

msgid "瑷伦回了东厢，墙上挂衣的钉子空着。她说，衣裳烧了，守衣人也该歇了。"
msgstr ""

msgid "安妮儿把宝衣带回了东方神教。神教的香案上，多了一盏长明灯。"
msgstr ""

msgid "安妮儿把宝衣带回了晚月庄的西厢。西厢的门一直关着——神教的事，她不再过问。"
msgstr ""

msgid "安妮儿回了东方神教，带回去的是一捧灰。神教的香案上，多了一只小瓷坛、一盏长明灯。"
msgstr ""

msgid "安妮儿带回西厢的是一捧灰。西厢的门一直关着，窗下多了一只小瓷坛。"
msgstr ""

msgid "安妮儿收回了教主令。西厢的灯从此夜夜亮着，神教的人进进出出；朱鸿雪派出去的差事，只剩该死的人。"
msgstr ""

msgid "庄里少了一件东西，多了一个故事。池边的人说，护庄的光，那年暗了一暗。"
msgstr ""

msgid "宝衣出过一回庄，又被人送了回来。池边的人说，护庄的光，那年暗了一暗，又亮了。"
msgstr ""

msgid "后院书房那幅湘绣图前，又有人在学沧海龙吟了。"
msgstr ""

msgid "内书房的老妇再没有开过口。蓝止萍说，庄规是庄规；那一年起，晚月庄的门关得比从前早。"
msgstr ""

msgid "内书房里多了一个人，不再蒙面。庄里的人说，每天傍晚，老妇擦她的鞭子，她女儿擦她的剑。"
msgstr ""

msgid "野羊寨的旗子又插回了山顶。霍铮说，逆灵宫的黑砖，拆下来正好砌寨墙。"
msgstr ""

msgid "黄霸还在土地庙里收他的供。北麓的黑砖道观，没人敢上去看一眼。"
msgstr ""

msgid "有人说在北边的雪里见过商玦：一身黑衣结着霜，说话还像念经。"
msgstr ""

msgid "灵心观藏经楼的二楼，镇教秘籍还是六函，第七函的位置空着。林忌说，茅山宁可没有那一函。"
msgstr ""

msgid "京师尚书府的花园里，那个老花匠又在浇他的花。庾清尘去哪里，他就跟到哪里。"
msgstr ""

msgid "藏经楼二楼的第七函回来了。花匠在书架边搭了一张竹床，夜里点着灯，教山上的小道士认北麓的字。"
msgstr ""

msgid "北麓下来的孩子在灵心观后山开了一片地。花匠一页一页念给他们听：烧了一辈子的香，坛上写的原来是这些。"
msgstr ""

msgid "日照山的流云轩里，多了一个独眼的头陀。被鬼卒抓伤的人抬上山来，他一掌按下去，寒气冒成一缕白烟。"
msgstr ""

msgid "头陀在流云轩教人婆萝蜜多心经。玄智说，西来的经和本寺的经放在一个经柜里，没有打架。"
msgstr ""

msgid "日照山金门外，那块地方空了。山烟寺还是三百年前的山烟寺：外人不进流云轩，外来的经，也不进。"
msgstr ""

msgid "被鬼卒抓伤的人抬上山来，玄智守着，三天三夜。有的救回来了，有的没有。"
msgstr ""

msgid "乔阴的老葛每年秋天挑一担柴上日照山，放在金门边上，说是还那一掌的情。"
msgstr ""

msgid "乔阴的老葛用左手砍柴，砍得慢。逢人就说：命是山烟寺的方丈守回来的。"
msgstr ""

msgid "青石村北边那个山洞，门上换了一条新铁链。阿牛背着小翠从门口走过，再也不往里钻了。"
msgstr ""

msgid "村长还是常叹那一句「国之将亡」。只是现在，他会把后半句说完。"
msgstr ""

msgid "洞口多了一圈不知谁摆的石头，阿牛钻进去转一圈，又从原路转出来；洞里那股寒气没了，村北的狗夜里也不叫了。后山的石室里，绝尘子还坐在佛像下，了尘守在他身后。"
msgstr ""

msgid "日照山的流云轩里多了一个拿金刚杖的和尚，抬上山的人，他扶着进门。青石村后山的石室里，只剩绝尘子一个人坐在佛像下。"
msgstr ""

msgid "黑衣人"
msgstr "Человек в чёрном"

msgid "那一夜，茅山的人截在北麓下湖的路上。黑砖道观里再没人提起那个新来的道士——只有门房记得，他戴冠的样子不太像。"
msgstr ""

msgid "冰龙厅里那第一剑，是从商玦背后来的。活着回到北麓的道士说，刺他的人戴着宫里的冠。"
msgstr ""

msgid "北麓的道士还在找一个戴过黑冠的人。他们说他是茅山的眼线；茅山说，没这回事。"
msgstr ""

msgid "程不平对着一本黑皮的名册，把上面的押印一个一个对了出来。槐阳城外有几户人家，收到了县衙的一封信。"
msgstr ""

msgid "程不平的卷宗送上了京城。陈显祖回了乡，桃木箱里只剩一件旧官服。"
msgstr ""

msgid "陈显祖带着他的箱子走了，没人知道去了哪里。福林酒楼的说书人，把这件事编成了一段新书。"
msgstr ""

msgid "县衙门口的大皮鼓，又有人敢去敲了。"
msgstr ""

msgid "福林大街的巷子口站着一个官差，叫花子从他跟前过，点个头。真龙头坐在街当中，数着酒囊上的结。"
msgstr ""

msgid "乔阴的巷子里还是没有官差。陆得财腰里那只皮酒囊，二十三个结。"
msgstr ""

msgid "乔阴县衙的公案上，又摊开了庾子建的卷宗：小屋那封信，天驼关那本账。京城没有回话，程不平也没有收卷。"
msgstr ""

msgid "乔阴县衙的卷宗里，压着骆建章的一张供状：兵部抄本上多出来的三句，是谁口述的。"
msgstr ""

msgid "曼雩台上多了一张书案。骆建章给弟弟抄谱，骆云舟在台边练剑；兄弟俩还是不怎么说话。"
msgstr ""

msgid "曼雩台上还是骆云舟一个人。他说，大哥的字比他的剑直。"
msgstr ""

msgid "天驼关的关门照旧，出关留五两。官道上再没有人卖路引；严廷殷换了一个不会茅山术的军师。"
msgstr ""

msgid "天驼关的关门抬着，过关不要钱。严廷殷回了京城，再没回来；将军营帐里坐着李信，案上压着一本账的抄本。"
msgstr ""

msgid "京城的诏书到了槐阳：槐阳王不反。城门上那张「槐阳反」的告示，郭承亲手撕了。"
msgstr ""

msgid "槐阳城门上那张告示还贴着：槐阳反。程朔说，随他们说。"
msgstr ""

msgid "槐阳王府照旧不问兵部的事。草原上没救出来的四个人，后来有两个自己走了回来。"
msgstr ""

msgid "铁盾会的院子里又练起了盾。卢卡说，等他攒够了钱，要回海那边去看一看。"
msgstr ""

msgid "铁盾会的院子空了。鬼笠馆的浪人占了那块地，早川直义从此不再出刀。"
msgstr ""

msgid "拜火祠的火，一年到头没有灭过。"
msgstr ""

msgid "傅家坡的草顶重新铺过了。渔夫的网挂在他家门口，没有人去收。"
msgstr ""

msgid "玉螺湖的渔夫照旧撒网。湖底那盏灯，再没有人见过。"
msgstr ""

msgid "石头长高了一截，天天往湖边跑。"
msgstr ""

msgid "庾子建在天牢里过了冬。少年皇帝第一次在早朝上，说了一整句话。"
msgstr ""

msgid "京城里都说，是兵部尚书带回了那把剑。皇帝在早朝上，一句话也没有说。"
msgstr ""

msgid "庾子建还在兵部。他派人去过一回玉螺湖，回来的人说，湖面上什么也没有。"
msgstr ""

msgid "於兰天武回了朝，把旋芒挂在养心殿的墙上，对少年皇帝说：剑是用来记事的。"
msgstr ""

msgid "於兰天武回了朝，站在少年皇帝身后。"
msgstr ""

msgid "骆建章流放关北。出城那天，他替押解的差人写了一封家书，最后一笔没有甩出格子。"
msgstr ""

msgid "朝上那天，骆建章的供状和原令摆在一处。西街骆家五代的门匾，后来是骆云舟自己摘的。"
msgstr ""

msgid "骆建章的供状进了刑部的案底，乔阴县衙也有一份；庾子建还在兵部。西街骆家的大门，从此没有官家的人来敲。"
msgstr ""

msgid "骆建章那张供状，韦相国一直收在袖子里；庾子建还在兵部。西街骆家的大门，从此没有官家的人来敲。"
msgstr ""

msgid "玉螺湖底"
msgstr ""

msgid "冰下封坛一片空。三百年的冰化了一半，水是清的。冰龙还在，只是不再抬头。"
msgstr ""

msgid "冰下封坛的冰柱里，瑷伦披着宝衣站着，眼睛睁着。三百年后，会有人来叫醒她。"
msgstr ""

msgid "冰下封坛的冰柱里，璃虹的光又亮了。她说过：第一个带着铜来的，是你。"
msgstr ""

msgid "冰下封坛的冰柱里，南危水手按剑柄，像还在等什么人。"
msgstr ""

msgid "冰下封坛的冰柱里，萧辟尘握着旋芒。岚城的风，每年会吹到湖面上一回。"
msgstr ""

msgid "冰下封坛的冰柱里，站着一个年轻人。没有人知道他的名字。"
msgstr ""

msgid "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖水清得能看见底。我说，那是人家的功劳，那碗茶不收钱。」"
msgstr ""

msgid "店小二擦着桌子：「小哥您有所不知——前几天有个人从湖那边回来，说湖底冰里站着一个人。我说，那是替咱们守着的，逢年过节，要给他留一碗酒。」"
msgstr ""

msgid "店小二擦着桌子：「前些日子有个客官从这儿走出去，就再没回来。楼上那间房，我一直给他留着。」"
msgstr ""

msgid "终"
msgstr ""

msgid "那少年，留在了冰里。"
msgstr ""

msgid "以《东方故事 2》（Eastern Stories 2）为底。"
msgstr ""

msgid "谢谢 ES2 的作者们，和 MUD 年代守着它的巫师们。"
msgstr ""

msgid "也谢谢你，走到了这里。"
msgstr ""

msgid "正月十七，九派过半，推你做了武林盟主。那天虹台上，你答了三件事。"
msgstr ""

msgid "正月十七，九派过半，颜违做了武林盟主。他说二十年的旧案，到此为止。"
msgstr ""

msgid "正月十七，颜违没能过半。卫沧澜走到石椅前，坐了回去。"
msgstr ""

msgid "正月十七，颜违没能过半，那把石椅还空着。"
msgstr ""

msgid "那天一早，你在山道上截住了神教的杀手，山烟寺的轿子上了山。"
msgstr ""

msgid "那天一早，你回葬剑亭扑灭了逆灵宫余孽放的火。"
msgstr ""

msgid "那天一早，你下山解了封山的围。"
msgstr ""

msgid "那天一早，你从山下的茶棚里请回了骆云舟。"
msgstr ""

msgid "山烟寺的轿子在山道上让神教截了，玄智和尚没能上山。"
msgstr ""

msgid "葬剑亭的火烧了半个时辰，林忌提着剑一路追下了北麓。"
msgstr ""

msgid "封山的人在官道上让人堵到了天黑。"
msgstr ""

msgid "骆云舟在山下的茶棚里，陪兵部的人喝了一整天的茶。"
msgstr ""

msgid "旋芒供在了葬剑亭，用黄绫裹着，九派来往的人都看得见。"
msgstr ""

msgid "你把旋芒还给了风。岚城云台的旋风里，它又转了起来。"
msgstr ""

msgid "旋芒还在你身上。九派的人说起它，都说那是斩过湖底那颗头的剑。"
msgstr ""

msgid "那天一早，山下出了事，你没有下石阶。"
msgstr ""

msgid "虹台上，陈剑秋当着九派说了一句「那本账烧了」，就再没有开口。"
msgstr ""

msgid "虹台上，陈剑秋坐在振远的旗下，没有提那本烧掉的账。"
msgstr ""

msgid "虹台上，陈剑秋替振远要了一个说法。他身后的绮云分局，门还关着。"
msgstr ""

msgid "虹台上，陈剑秋坐在振远的旗下，没有提那本账。他身后的绮云分局，门还关着。"
msgstr ""

msgid "虹台上，蓝止萍坐在晚月庄的旗下。神教的人在台下转了一圈，没有一个走近晚月庄那一席。"
msgstr ""

msgid "虹台上，晚月庄的旗后面站着一个老妇人和她的女儿。九派里有人认得那把细剑，没有人说破。"
msgstr ""

msgid "虹台上，花紫会的旗下坐着一个打二十三个结的老叫花子，一直看着台下官道上的官差。"
msgstr ""

msgid "虹台上，陆得财坐在花紫会的旗下抠着脚。腰里那只皮酒囊，多了一个结。"
msgstr ""

msgid "饮风客栈的店小二逢人便说：新盟主在小店住过，就住楼上那间。"
msgstr ""

msgid "柳淳风说，盟主回来了，封山总算等到了这一天。"
msgstr ""

msgid "北宗在虹台上有了一个座。柳淳风关了武馆的门，一天没有出来。"
msgstr ""

msgid "封山的人那天没能上山。柳淳风回来，只说了一句：明年再去。"
msgstr ""

msgid "北宗的人那天没能上山。柳淳风在武馆里听说了，一句话也没有说。"
msgstr ""

msgid "饮风客栈照旧开门。店小二说，正月十七那天，镇上的人都在等山上的消息。"
msgstr ""

msgid "正厅的太师椅上，坐着颜违。山门的告示上写着：老松岭旧案，到此为止。"
msgstr ""

msgid "正厅的太师椅上，坐着卫沧澜。二十年的空椅子，有了人。"
msgstr ""

msgid "正厅的太师椅空着。阁里的人说，那是盟主的椅子——盟主就是你，可你很少回来坐。"
msgstr ""

msgid "正厅的太师椅空着。颜违照旧代理，「代」字没能去掉。"
msgstr ""

msgid "正厅的太师椅空着，等一个回不来的人。"
msgstr ""

msgid "老松岭的旧案重新翻了出来，水烟阁的人往京城去了几回。"
msgstr ""

msgid "水烟阁同朝廷走近了。兵部来了人，在山门外喝了一回茶。"
msgstr ""

msgid "绮云镇 · 场院"
msgstr ""

msgid "九派逐了东方神教。棺材铺后面的场院关了门，朱鸿雪不知去向。"
msgstr ""

msgid "神教照旧在棺材铺后面的场院里派差事。九派说，只要不犯到他们头上。"
msgstr ""

msgid "虹台上没有人提神教的事。朱鸿雪照旧派她的差事。"
msgstr ""

msgid "安妮儿闭了西厢的门。神教的事，她不再同人说起。"
msgstr ""

msgid "朱鸿雪记住了，那天山道上截住她的人的，是你。"
msgstr ""

msgid "野羊山北麓"
msgstr "Северное подножие горы Еян"

msgid "北麓的道观空了，官兵封了山门。"
msgstr ""

msgid "下了山的道士在茅山的田里种地，坛上的火灭了。"
msgstr ""

msgid "九派的人上了北麓。道观里剩下的人，一个也没走脱。"
msgstr ""

msgid "茅山的人上了北麓，把肯下山的领了回去。"
msgstr ""

msgid "官兵上了北麓，把道观里剩下的人领下了山。卫沧澜说，这一回欠朝廷的。"
msgstr ""

msgid "北麓的道观里，续灯的火一直没灭。"
msgstr ""

msgid "林忌那天一路追到北麓，追回了两个放火的孩子。"
msgstr ""

msgid "乔阴 · 天驼关 · 京师"
msgstr "Уезд Цяоинь · застава Тяньто · столица"

msgid "你是封山剑派的弟子，师父是柳淳风。"
msgstr ""

msgid "你是封山剑派北宗的人，和柳绘心同辈。"
msgstr ""

msgid "柳淳风认得老岑的信：淳风武馆的门，你随时进。"
msgstr ""

msgid "柳淳风替你给水烟阁的潘军禅写过一封信。"
msgstr ""

msgid "雪亭镇上没人再敢借淳风武馆的名头收钱。是你清的。"
msgstr ""

msgid "逄义认了那块腰牌。他欠武馆一句交代。"
msgstr ""

msgid "武馆的人都知道，是你说破了门房的来历。"
msgstr ""

msgid "刘安禄的来历，你替他瞒着。他欠你一句话。"
msgstr ""

msgid "你和血手刘三动过刀，放了他一条路。"
msgstr ""

msgid "《悟疾风劲竹书》在柳淳风的匣里。是你从竹林里取回来给他的。"
msgstr ""

msgid "柳绘心读到了父亲年轻时写的书。是你给她的。"
msgstr ""

msgid "柳淳风认你是掌门传人，「点」字诀是他亲传的。北宗的牌子挂在绮云镇口。"
msgstr ""

msgid "你跟柳绘心立了北宗。柳淳风不再教你，武馆的门还开着。"
msgstr ""

msgid "正月十七，封山那一票听你的。"
msgstr ""

msgid "你是振远镖局的人。"
msgstr ""

msgid "陈剑秋把二十年前那张镖单交给了你。这件事，振远至今不提。"
msgstr ""

msgid "那张镖单，是你替陈天星带到京师的。他要查到底。"
msgstr ""

msgid "陈天星查清了二十年前那趟镖：是兵部点名改走的老松岭。"
msgstr ""

msgid "你替振远押过一趟镖，从绮云镇一路押到京师总局。"
msgstr ""

msgid "碎石小路上劫镖的后生，你交给了官府。"
msgstr ""

msgid "碎石小路上劫镖的后生，你放他走了。他爹是二十年前死在老松岭的趟子手。"
msgstr ""

msgid "陈天星给了你一张振远的名帖：持帖者，振远的朋友。"
msgstr ""

msgid "潘军禅把镖单锁进了刑堂，振远的脸面保住了。陈剑秋松了一口气。"
msgstr ""

msgid "陈剑秋说：查到底。正月十七，振远那一票投旧盟主。"
msgstr ""

msgid "陈天星翻了振远二十年的总账：绮云分局开张的本钱，是兵部给的抚恤银。"
msgstr ""

msgid "你劝住了陈天星：那本总账烧了，抚恤银的事，振远不再提。陈剑秋许你学春风快意刀。"
msgstr ""

msgid "你跟陈天星查到底：振远的总账押去了乔阴县衙。绮云分局关了门，陈剑秋还坐在柜台后面。"
msgstr ""

msgid "正月十七，振远那一票听你的。"
msgstr ""

msgid "你是天邪派的弟子。"
msgstr ""

msgid "潘军禅给你看过那柄「邪剑穿灵」：它是鱼饵。"
msgstr ""

msgid "南危水把二十年的事托给了你。你没有告诉别人。"
msgstr ""

msgid "颜违记得，五长老的事是你告诉他的。他从那天起代行盟主之职。"
msgstr ""

msgid "盟主卫沧澜是你从尚书府带出来的。"
msgstr ""

msgid "於兰天武的通缉是你解的。他回了京。"
msgstr ""

msgid "你在水烟阁的山门值过一班，拿下了一个打听盟主的探子。"
msgstr ""

msgid "你在水烟阁的山门拿错了人，真的探子趁乱下了山。"
msgstr ""

msgid "二十年前那张镖单锁在水烟阁的刑堂里。是你交给潘军禅的。"
msgstr ""

msgid "潘军禅告诉你：二十年前带走盟主的，是一队挂兵部刀的白衣武官。"
msgstr ""

msgid "你站在颜违一边。你是水烟阁的执事；潘军禅从此只同你谈公事。"
msgstr ""

msgid "正月十七，天邪派那一票投颜违。"
msgstr ""

msgid "正月十七，你站在潘军禅一边：等盟主回来。你是水烟阁的执事；颜违记下了你。"
msgstr ""

msgid "正月十七，天邪派那一票听你的。"
msgstr ""

msgid "你是绝尘派的弟子。"
msgstr ""

msgid "你是过阵的客：走得出绝尘子的八卦阵。"
msgstr ""

msgid "你把阿牛和小翠从青石村北边闹鬼的山洞里领了出来。村长终于把那句话说完了：国之将亡，必有妖孽。"
msgstr ""

msgid "绝尘子知道洞里有东西。阵守得住石室，他就不管——绝尘派不问世事。"
msgstr ""

msgid "首徒了尘不这么想。他说话的时候，一直看着佛像下的师父。"
msgstr ""

msgid "绝尘子答应了：正月十七下山走一趟。"
msgstr ""

msgid "了尘说起了三十年前：绝尘子就是走出山烟寺山门的玄尘。"
msgstr ""

msgid "绝尘派守了阵：八卦阵推到了青石村北边的洞口，了尘留在石室。"
msgstr ""

msgid "了尘下了山，回日照山的流云轩救人。"
msgstr ""

msgid "正月十七，绝尘派那一票听你的。"
msgstr ""

msgid "你是茅山派的弟子。"
msgstr ""

msgid "林忌认你做茅山的朋友，许你上了藏经楼。"
msgstr ""

msgid "林忌的师弟在京师兵部尚书府种了二十年花；你找到了他。"
msgstr ""

msgid "《上清符箓》在你手里：前半是茅山的符，后半是逆灵宫的字。"
msgstr ""

msgid "花匠上了灵心观，在殿门里叫了林忌一声师兄。"
msgstr ""

msgid "《上清符箓》投进了灵心观的香炉。茅山宁可没有那一函。"
msgstr ""

msgid "《上清符箓》锁回了藏经楼二楼，花匠守着它；他教茅山道术，谁都教。林忌对你冷了一分。"
msgstr ""

msgid "北麓剩下的人，花匠拿着符箓念下了山。"
msgstr ""

msgid "林忌托你戴着黑冠回了逆灵宫，替茅山看，替茅山听。"
msgstr ""

msgid "那卷残卷，林忌当着你的面烧了。"
msgstr ""

msgid "残卷你还给了玄冥子。林忌没再提它，看你的眼神冷了一分。"
msgstr ""

msgid "逆灵宫的祭品名单，是你抄出来递给茅山的。"
msgstr ""

msgid "地牢里新关的三个人，是你放出来的。"
msgstr ""

msgid "逆灵宫那本祭品名册的原本，你从铁匣里带了出来。"
msgstr ""

msgid "正月十七，茅山那一票听你的。"
msgstr ""

msgid "北麓那座道观，你交给了官府去剿。"
msgstr ""

msgid "逆灵宫剩下的人下了山，茅山看着。是你去劝的。"
msgstr ""

msgid "你是晚月庄的弟子。"
msgstr ""

msgid "你是晚月庄的护法：不是弟子，庄里的事算你一份。"
msgstr ""

msgid "失传的沧海龙吟，又在区冥的神位前跳了一回。"
msgstr ""

msgid "寒於宝衣留在晚月庄。瑷伦替你守到决战。"
msgstr ""

msgid "宝衣是你带出庄的。那一夜，庄里死了人。"
msgstr ""

msgid "宝衣又是你送回来的。瑷伦又是守衣人。"
msgstr ""

msgid "晚月庄守了几百年的宝衣，你交给了外人。"
msgstr ""

msgid "正月十七，晚月庄那一票改投颜违：逐神教。"
msgstr ""

msgid "正月十七，晚月庄那一票听你的。"
msgstr ""

msgid "无名老妇说：令牌在我这里。她还活着。"
msgstr ""

msgid "蓝止萍说：庄规是你陪我守下来的。"
msgstr ""

msgid "无名老妇说：你把我女儿带回来了。"
msgstr ""

msgid "蓝止萍说：庄规，你替她破了一回。"
msgstr ""

msgid "你是山烟寺的弟子。"
msgstr ""

msgid "你是流云轩的帮手：帮手不必落发。"
msgstr ""

msgid "你替流云轩采齐了玄智的三味药，喂了乔阴的樵夫老葛——寒气还是退不下去。"
msgstr ""

msgid "你领金门外的独眼头陀进了流云轩，老葛当场好了。玄智记下了：你不守寺规。"
msgstr ""

msgid "你照了寺规。玄智守了老葛三天三夜，命保住了，右手废了。"
msgstr ""

msgid "玄智和尚信了你的担保。正月十七，山烟寺那一票投旧盟主。"
msgstr ""

msgid "龙若法王说起了三十年前的事，给了你婆萝蜜多心经的一页贝叶：「收不收，是山烟寺的事。」"
msgstr ""

msgid "山烟寺收了西来的经：独眼头陀受戒入寺，流云轩从此治得了鬼卒的寒。"
msgstr ""

msgid "山烟寺守了本寺一脉：经交还了龙若法王，金门外空了。"
msgstr ""

msgid "正月十七，山烟寺那一票听你的。"
msgstr ""

msgid "你是步玄派的弟子。"
msgstr ""

msgid "你走出了桃林，骆云舟认你做桃林的客。"
msgstr ""

msgid "你在曼雩台上问过了剑：风泉剑灵在「剑神如意」之前收了剑。"
msgstr ""

msgid "骆云舟托你给他十年没说过话的大哥骆建章送一封家书。"
msgstr ""

msgid "骆建章读了弟弟的信，说他还是那么写字，最后一笔甩出格子。"
msgstr ""

msgid "兵部抄本上多出来的三句是骆建章落的笔；他认了。"
msgstr ""

msgid "骆云舟十年来第一次回京城，兄弟俩在相国府的厅上见了面。"
msgstr ""

msgid "骆建章写了供状：兵部抄本上那三句，是庾子建口述的。骆家和朝廷翻了脸。"
msgstr ""

msgid "骆建章在刑部照实供了，判了流放。骆家和朝廷翻了脸。"
msgstr ""

msgid "骆云舟带大哥回了乔阴，抄本的事不再提；骆家照旧是京城的世家。"
msgstr ""

msgid "骆云舟把骆家的名帖给了你。"
msgstr ""

msgid "正月十七，步玄派那一票听你的。"
msgstr ""

msgid "你是花紫会的人。"
msgstr ""

msgid "你替花紫会从兵部的胡管事身上摸回了槐阳八户的卖身契。"
msgstr ""

msgid "乔阴的陆得财是龙头的替身。你数着皮酒囊上的结，一个一个问了过去。"
msgstr ""

msgid "你在京师尚书府的后墙根下见到了真龙头：二十三个结。"
msgstr ""

msgid "尚书府小屋那封密信，你交给了真龙头。庾家不敢清乔阴的巷子。"
msgstr ""

msgid "密信你交给了官府。叫花子不再跟你说正事。"
msgstr ""

msgid "你照真龙头的话，夜里从尚书府的狗洞把卫沧澜领了出来。"
msgstr ""

msgid "你在福林大街认了二十三个结：真龙头坐回了乔阴，花紫会吃上了官饭，巡捕不再抓花紫会的人。陆得财出了北门。"
msgstr ""

msgid "你在福林大街认了这些年管事的陆得财：真龙头把皮酒囊系到他腰上，回了京师的墙根。乔阴的巷子里照旧没有官差。"
msgstr ""

msgid "正月十七，花紫会那一票听你的。"
msgstr ""

msgid "官府"
msgstr "Власти"

msgid "乔阴知县程不平替你写过一封信。"
msgstr ""

msgid "陈显祖是你护送进县衙作的证。"
msgstr ""

msgid "天驼关的严廷殷看过程不平的信。"
msgstr ""

msgid "你是今科的武状元。"
msgstr ""

msgid "兵部尚书庾子建是你在朝上揭发的。"
msgstr ""

msgid "你和庾子建私了了。兵部记着这份情，也记着这笔账。"
msgstr ""

msgid "大内侍卫营的冯策说过：算老夫一个。"
msgstr ""

msgid "逆灵宫的余孽，是你交给官府的。"
msgstr ""

msgid "振远的总账是陈天星押进乔阴县衙的。程不平收下了，兵部的抚恤银记在了案上。"
msgstr ""

msgid "尚书府小屋那封密信，是你交到程不平手上的。"
msgstr ""

msgid "你是乔阴县的捕快，腰里挂着程不平给的黑漆腰牌。"
msgstr ""

msgid "雪亭路口、绮云镇口那两个打着官府告示收过路费的，是你拿下的。"
msgstr ""

msgid "他们身上的路引盖着天驼关铁卫营的大印。程不平说：印在严将军手里。"
msgstr ""

msgid "武举的第一场，程不平的荐书替你免了。"
msgstr ""

msgid "尚书府小屋那封密信，你给了花紫会。程不平不再跟你说案子。"
msgstr ""

msgid "严廷殷认了路引上的印。印丢的那三天，副将李信记了一本账：盖印的是军师赫造基，兵部还拓了个模子去盖民夫令。"
msgstr ""

msgid "你跟严廷殷整肃了天驼关：军师是你在将军营帐里拿下的，那本账没有上京。铁卫营欠你一回。"
msgstr ""

msgid "你跟严廷殷整肃了天驼关：军师还在将军营帐里，等你去拿。"
msgstr ""

msgid "你跟李信揭发了天驼关：那本账上了京，严廷殷被召回，李信守关，过关不再收钱。"
msgstr ""

msgid "小屋那封信和天驼关那本账放在一起，程不平又开了一回庾子建的堂。"
msgstr ""

msgid "卫沧澜是皇叔拿着手诏从尚书府要回来的。"
msgstr ""

msgid "安妮儿说，她在等一个配得上宝衣的人。"
msgstr ""

msgid "安妮儿说你配得上。东方神教记得你。"
msgstr ""

msgid "晚月庄那块杀手令牌，是你还给神教的。朱鸿雪说：令回来了就好。"
msgstr ""

msgid "宝衣出了庄，没进安妮儿的门。她记下了你的名字。"
msgstr ""

msgid "你放过了神教的那个杀手。"
msgstr ""

msgid "你接了朱鸿雪的令。"
msgstr ""

msgid "你把西厢的话照实告诉了朱鸿雪：那件衣，安妮儿不打算交给神教。"
msgstr ""

msgid "你替安妮儿瞒下了西厢的话。她欠你一回。"
msgstr ""

msgid "朱鸿雪给过你一块黑木令。神教的杀手认得它。"
msgstr ""

msgid "你手上沾了神教教主的血。朱鸿雪的令，到此为止。"
msgstr ""

msgid "朱鸿雪给过你三个名字，都是靠近湖底封物的人。"
msgstr ""

msgid "你替朱鸿雪杀了玉螺湖凿冰的老冰匠。"
msgstr ""

msgid "你劝玉螺湖的老冰匠搬走了，拿他的冰凿去向朱鸿雪交了差。"
msgstr ""

msgid "你拿老冰匠的冰凿骗过朱鸿雪，她当面揭穿了你。"
msgstr ""

msgid "朱鸿雪换给你一块赤铜令。"
msgstr ""

msgid "你站到了安妮儿一边。一代教主收回了教主令，给了你一块黄金令牌。"
msgstr ""

msgid "你站到了朱鸿雪一边。她给了你一块黄金令牌；西厢的门，从此对你关着。"
msgstr ""

msgid "你进过那座黑砖道观。"
msgstr ""

msgid "你见过「唤首」。他们知道有生人进过后殿。"
msgstr ""

msgid "地牢里的人是你放走的。逆灵宫在找那天闯道观的孩子。"
msgstr ""

msgid "玄冥子欠你一条命。他说过：带着残卷来后山找他。"
msgstr ""

msgid "玄冥子说你是他的人。"
msgstr ""

msgid "管事道士许你在货栈的通铺上睡——他们当你是新来的道士。"
msgstr ""

msgid "子时在后殿外，巡殿的道士撞见过你。"
msgstr ""

msgid "宫里在找一本不见了的名册。"
msgstr ""

msgid "玄冥子托你从宫主的书案底下取出天书的下半部；他教你的，是六阴剑。"
msgstr ""

msgid "你把唤首前夜下湖的时辰和路交给了茅山。宫里迟早会知道是谁。"
msgstr ""

msgid "唤首那一夜你戴着冠下湖——冰龙厅里那第一剑，是你从背后刺的。"
msgstr ""

msgid "黑冠还戴在你头上：唤首那一夜，你跟他们下湖。"
msgstr ""

msgid "你被识破了。黑冠不再管用，北麓有人在找你。"
msgstr ""

msgid "北麓那座道观，官兵上去了。宫里剩下的人一个也没走脱。"
msgstr ""

msgid "宫里剩下的人跟你下了山。坛上的火灭了。"
msgstr ""

msgid "拜了柳淳风，淳风武馆的事就是你的事。"
msgstr ""

msgid "你已经不是封山的人了。淳风武馆的事，到此为止。"
msgstr ""

msgid "问柳淳风「武馆的事」。"
msgstr ""

msgid "柳淳风说，镇西的青石官道上有人打着淳风武馆的旗号，向来投师的人收十两「拜师钱」。"
msgstr ""

msgid "去镇西的青石官道，会一会那几个收「拜师钱」的「封山弟子」。"
msgstr ""

msgid "为首的罗七倒了，两个帮闲一哄而散。他胸前那块腰牌却是真的：背面刻着一个「逄」字，系绳上拴着绮云镇赌场的竹筹。"
msgstr ""

msgid "腰牌是从绮云镇的赌场流出来的。去赌场找那个姓逄的，问他「腰牌」。"
msgstr ""

msgid "逄义——柳淳风的同辈师弟——认了：牌是他赌输了押给罗七的。"
msgstr ""

msgid "把腰牌带回淳风武馆，交给柳淳风。"
msgstr ""

msgid "柳淳风收下了这件事。「门户的名头，不是谁都能借的。」"
msgstr ""

msgid "清了打着淳风武馆旗号收拜师钱的人"
msgstr ""

msgid "大弟子"
msgstr ""

msgid "罗七在镇上嚷过：武馆的门房是野羊山的血手刘三。李火狮在等一句话，问他「门房」——说破，武馆从此没有他的位置；替他瞒，这句话从此算在你头上。"
msgstr ""

msgid "你对李火狮说了实话：门房刘安禄就是野羊山的血手刘三。武馆不留匪。"
msgstr ""

msgid "说破了淳风武馆门房的来历"
msgstr ""

msgid "你对李火狮说：那伙骗子认错了人。武馆里没人再提这件事。"
msgstr ""

msgid "替淳风武馆的门房瞒下了来历"
msgstr ""

msgid "问柳淳风「竹书」。"
msgstr ""

msgid "柳淳风二十岁那年在天驼关的竹林里住过一冬，写了一卷《悟疾风劲竹书》，留在竹林尽头、大黄石后面的石室里。"
msgstr ""

msgid "去天驼关的竹林道，照柳淳风教的法子推开尽头的大黄石，从石室的书柜里取出那卷书。"
msgstr ""

msgid "《悟疾风劲竹书》到手了。薄薄一卷，末尾署着柳淳风的名字。"
msgstr ""

msgid "书只有一本：交给柳淳风，他会收进匣里；交给柳绘心，她头一回读到父亲年轻时写的字。给出去就读不到了——想读，先读。"
msgstr ""

msgid "《悟疾风劲竹书》在你身上"
msgstr ""

msgid "书不在你身上了——是被人摸走了，还是给了别人？找回来再交"
msgstr ""

msgid "你把书交给了柳淳风。他没有翻开，收进了案头的匣里：年轻时的糊涂话。"
msgstr ""

msgid "把《悟疾风劲竹书》带回来交给了柳淳风"
msgstr ""

msgid "你把书交给了柳绘心。她头一回读到父亲二十岁时写的字：直竹贵地生。"
msgstr ""

msgid "把《悟疾风劲竹书》带回来交给了柳绘心"
msgstr ""

msgid "柳绘心这些日子常往武馆的内院去。过些时候再回淳风武馆，到内院看看。"
msgstr ""

msgid "内院里，柳绘心在教外人学封山剑——镇上交不起拜师钱的孩子。柳淳风撞见了。"
msgstr ""

msgid "封山要分南北了。跟柳淳风守本宗（问他「本宗」）：剑不外传，他亲传「点」字诀，你是掌门传人，柳绘心离开武馆。跟柳绘心立北宗（问她「北宗」）：剑往外传，她教你「点」字诀，你转入北宗，柳淳风不再教你。"
msgstr ""

msgid "你跟了柳淳风：封山只有一宗，剑不外传。他把「点」字诀传给了你。柳绘心带着「北宗」两个字去了绮云镇。"
msgstr ""

msgid "在封山的南北之争里守了本宗"
msgstr ""

msgid "掌门传人"
msgstr ""

msgid "你跟了柳绘心：北宗的剑往外传。她把自己悟的「点」字诀教给了你。柳淳风不再教你。"
msgstr ""

msgid "和柳绘心立了封山剑派北宗"
msgstr ""

msgid "拜了天邪派，水烟阁的门就由你守一回。"
msgstr ""

msgid "你已经不是天邪派的人了。水烟阁的事，到此为止。"
msgstr ""

msgid "去水烟阁正厅，问执法使潘军禅「山门」。"
msgstr ""

msgid "潘军禅说，正月十七快到了，上山的人多；这一个月，有人在打听盟主的事。他要一个新面孔去山门值一班。"
msgstr ""

msgid "到水烟阁前值守：三个上山的人在门外候着。问清他们的「来意」，听他们怎么说「盟主」，看看「路引」——认出那个来打听盟主的探子，把他「拿下」。拿错了人，真的探子会趁乱走掉。"
msgstr ""

msgid "山门的一班值完了。"
msgstr ""

msgid "回正厅向潘军禅回话（问他「山门」；搜到了信，把信交给他）。"
msgstr ""

msgid "潘军禅听完了山门的事。「水烟阁的门，你守过一回了。」"
msgstr ""

msgid "替水烟阁在山门值过一班"
msgstr ""

msgid "问潘军禅「镖单」。二十年前那张镖单只有一张：交给潘军禅，锁进刑堂，振远的脸面水烟阁替他们留着，这件事到此为止；带去京师振远总局交给陈天星，他要查到底——查出来的，未必只是振远的丑事。镖单不在身上的，去绮云镇振远镖局问陈剑秋。"
msgstr ""

msgid "你把镖单交给了潘军禅。他锁进了刑堂：振远的脸面，水烟阁替他们留着。"
msgstr ""

msgid "把二十年前的镖单交给潘军禅锁进了刑堂"
msgstr ""

msgid "你把镖单带去京师，交给了陈天星。他要查到底。"
msgstr ""

msgid "把二十年前的镖单带去京师交给了陈天星"
msgstr ""

msgid "陈天星在翻振远总局二十年前的底账。出了振远总局再进去，听他查到了什么。"
msgstr ""

msgid "陈天星查清了：二十年前那趟镖本该走官道，是兵部来人点名改走老松岭的。"
msgstr ""

msgid "回正厅问潘军禅「盟主」。"
msgstr ""

msgid "潘军禅说，二十年前带走盟主的是一队白衣武官——腰里挂的是兵部的刀。"
msgstr ""

msgid "二十年前带走盟主的是白衣武官。线索在京师尚书府。"
msgstr ""

msgid "京师那边的事有了结果。"
msgstr ""

msgid "七长老颜违这些日子常下楼来，站在水烟阁正厅那把黝黑的太师椅跟前。去正厅；已经在厅里的，出去走一走再进来。"
msgstr ""

msgid "正厅里，颜违要在正月十七之前把那把椅子定下来；潘军禅说，等盟主。"
msgstr ""

msgid "天邪派在虹台上的那一票，看你。站颜违（问他「椅子」）：正月十七由他坐那把椅子，他许你水烟阁执事，二十年的旧案到此为止，潘军禅从此只同你谈公事。站潘军禅（问他「椅子」）：等盟主回来，他以执法使的名义升你执事，颜违会记下你。"
msgstr ""

msgid "你站到了颜违一边：正月十七，天邪派那一票投他。他许你做了水烟阁的执事。"
msgstr ""

msgid "在水烟阁正厅站到了颜违一边"
msgstr ""

msgid "执事"
msgstr ""

msgid "你站到了潘军禅一边：等盟主回来。他以执法使的名义升你做了执事。颜违记下了你。"
msgstr ""

msgid "在水烟阁正厅站到了潘军禅一边：等盟主回来"
msgstr ""

msgid "戴着黑冠回逆灵宫，替茅山的林忌做眼线。"
msgstr ""

msgid "疑点满了三条。宫里认出你，只是早晚的事——下回戴着冠进前院，就是那一天：那一仗你打不过，不必打，出了前院的门就算逃过了。黑冠不会再替你遮掩；递出去的名单、带走的名册，茅山照样用得上，剑谱也还在你手里。"
msgstr ""

msgid "疑点"
msgstr ""

msgid "残卷没回宫：宫里少了一卷书，迟早有人问起"
msgstr ""

msgid "那一夜丢了人：地牢空了，他们记得那天闯进来的人"
msgstr ""

msgid "子时在后殿外被撞见过"
msgstr ""

msgid "子时在后殿外又被撞见了一回"
msgstr ""

msgid "名册不见了：账房的铁匣里少了一本名册，管事迟早会发现"
msgstr ""

msgid "进门之前，先把第三章留下的事了结。身上带着逆灵天书残卷的：还给后山崖径上的玄冥子（他要是还活着），他当你是他的人，宫里没人会问起那卷书；交给林忌，他当面烧了，可宫里少了一卷书——那是一条疑点。救过人的，听林忌（或霍铮）把话说完。黑冠丢了的，问林忌「黑冠」。"
msgstr ""

msgid "你把残卷还给了玄冥子。他说：「你是我的人。」宫里不会有人问起那一夜。"
msgstr ""

msgid "把逆灵天书的残卷还给了玄冥子"
msgstr ""

msgid "你把残卷交给了林忌。他当面烧了：「这东西不该回那里去。」宫里少了一卷书。"
msgstr ""

msgid "把逆灵天书的残卷交给林忌烧了"
msgstr ""

msgid "茅山要一个进得去的人。你答应戴着黑冠，再进一回逆灵宫。"
msgstr ""

msgid "替茅山戴着黑冠回了逆灵宫"
msgstr ""

msgid "戴着黑冠回逆灵宫。白天到账房（前殿往西，丹房再往北）问管事道士「干活」。"
msgstr ""

msgid "管事道士派了三样活：丹房添炭、货栈点箱、前殿跟诵。"
msgstr ""

msgid "干完管事派的三样活，回账房问他「干活」。跟诵是领诵念上句、你接下句：前殿的道士诵的就是这几句，听熟了再去。"
msgstr ""

msgid "三样活干完了。管事许你在货栈的通铺上留宿。"
msgstr ""

msgid "在逆灵宫干了三样杂活，管事许你留宿"
msgstr ""

msgid "丹房添炭"
msgstr ""

msgid "货栈点箱"
msgstr ""

msgid "前殿跟诵"
msgstr ""

msgid "领诵念上句，你接下句"
msgstr ""

msgid "子时，前殿北门后的后殿有人说话。货栈的通铺可以睡到子时。前殿有巡殿的道士来回走——躲开他的眼睛（他看前面，不看身后；香炉和经案挡得住他），摸到北门边「听」。被他撞见了，会被押回前院站到天亮，那是一条疑点。"
msgstr ""

msgid "你在北门外听见了他们等的那一夜，和「名单在账房」。"
msgstr ""

msgid "名单在账房。夜里管事伏在案头睡觉，到账房的大案上「抄名单」，别吵醒他。"
msgstr ""

msgid "你在账房的大案上抄下了那张名单。"
msgstr ""

msgid "把抄来的名单递出去：交给灵心观的林忌（救过霍铮的，也可以交给土地庙的霍铮）。"
msgstr ""

msgid "名单递出去了。下回路过野羊山的山路转角，路边会多一辆翻倒的纳供车。"
msgstr ""

msgid "把逆灵宫的祭品名单递给了茅山"
msgstr ""

msgid "名单上的人，茅山会去找。宫里的事还没完——回灵心观问林忌「逆灵宫」。"
msgstr ""

msgid "林忌说了地牢里新关的三个人，和账房铁匣里那本名册的原本。"
msgstr ""

msgid "地牢里新关了三个人。牢门的钥匙在狱卒腰上：给他一袋酒（或者往石阶边他那只酒坛里下蒙汗药），他醉倒了，钥匙就是你的；子时他歪在长凳上打盹，钥匙挂在头顶的铁钉上；第三章那把钥匙还在身上的，也开得了。狱卒醒着的时候，谁也近不了牢门。开了门，他们自己从货栈的侧门走。"
msgstr ""

msgid "地牢里新关的三个人，从货栈的侧门走了。"
msgstr ""

msgid "放走了逆灵宫地牢里新关的三个人"
msgstr ""

msgid "西牢房：槐阳来的妇人"
msgstr ""

msgid "北牢房：货郎"
msgstr ""

msgid "东牢房：采药人"
msgstr ""

msgid "账房的铁匣里锁着祭品名册的原本，锁和牢门是一套。夜里管事伏在案头睡着的时候，用地牢的钥匙打开它。带走（先确认）：它是物证——朝上揭发兵部时算一样，京师的事已经定了的，乔阴的程不平对得出上面的押印；可宫里少了一本名册，那是一条疑点。不带：回灵心观问林忌「名册」，告诉他你没动它。"
msgstr ""

msgid "你带走了祭品名册的原本。宫里少了一本名册。"
msgstr ""

msgid "从逆灵宫的账房带走了祭品名册的原本"
msgstr ""

msgid "名册留在了铁匣里。宫里什么也没少。"
msgstr ""

msgid "把祭品名册的原本留在了逆灵宫的铁匣里"
msgstr ""

msgid "后山崖径上的玄冥子有一件事要托你——问他「天书」。（子时，前殿的北门从里面闩着；他知道怎么拨开。巡殿的道士看前不看后。）"
msgstr ""

msgid "你从宫主居所的暗格里取出《逆灵天书》的下半部，交给了玄冥子。他给了你一册六阴剑谱，说了他等的是哪一夜。"
msgstr ""

msgid "替玄冥子取来了《逆灵天书》的下半部"
msgstr ""

msgid "后山崖径上没有玄冥子——《逆灵天书》的下半部，没有人托你去取。"
msgstr ""

msgid "宫里等的那一夜，林忌要知道：他们哪一夜动、走哪条路。钉子拔了、湖上的事近了（第十章之后），回灵心观问林忌「逆灵宫」。湖底的事已经了了的，宫里剩下的人还在——也问他「逆灵宫」。"
msgstr ""

msgid "林忌问你宫里哪一夜动、走哪条路：唤首那一夜，逆灵宫倾巢下湖。"
msgstr ""

msgid "湖底的事了了，商玦没有回来。宫里剩下的人还在续灯——林忌要一个了断。"
msgstr ""

msgid "收网，看你。前夜倒戈（问林忌「倒戈」）：把下湖的时辰和路交给茅山——终章冰龙厅里商玦身边只剩两个道士，点将时多一拨茅山的人；可黑冠从此没用，逆灵宫的门不再为你开。潜伏到底（问林忌「潜伏」，疑点不到三条才行）：你戴着冠跟商玦的队伍下湖，冰龙厅里第一剑是你的，商玦带着重伤开打——可他的四个道士会先扑你，也没有人会多来帮你（没人知道你的消息）。终章在湖畔等到天黑之前要定下来。"
msgstr ""

msgid "前夜，你把下湖的时辰和路交给了林忌。黑冠从此没用了。"
msgstr ""

msgid "唤首前夜，把逆灵宫下湖的时辰和路交给了茅山"
msgstr ""

msgid "你没有把时辰交出去。黑冠还戴在你头上：唤首那一夜，你跟着他们下湖。"
msgstr ""

msgid "戴着黑冠潜伏到底，跟逆灵宫下了湖"
msgstr ""

msgid "唤首那一夜过去了。你什么也没有交出去，也没有跟他们下湖。"
msgstr ""

msgid "终章：茅山的人截在北麓下湖的路上，林忌在湖畔。冰龙厅里，商玦身边只剩两个道士。"
msgstr ""

msgid "冰龙厅里，商玦身边只剩两个道士——另外两个，茅山在北麓截下了。"
msgstr ""

msgid "终章：戴着黑冠下湖。冰龙厅里你站在商玦身后——第一剑是你的。他的四个道士会先扑你。"
msgstr ""

msgid "冰龙厅里，第一剑是你从背后刺的。商玦带着那一剑的伤，同你打完了这一场。"
msgstr ""

msgid "宫里剩下的人，林忌要一个了断。交官府去剿（问林忌「剿」，先确认）：官兵上北麓，一个也走不了——正月十七投颜违的那一边，说的就是这个。劝他们下山、交茅山看管（问林忌「招安」，再回北麓同宫里当家的说「下山」）：玄冥子还在，就是他；不在了，是领诵的道士。没有了断的，正月十七那一天他们会自己找上门来。"
msgstr ""

msgid "你把北麓那座道观交给了官府。官兵上了山，宫里剩下的人一个也没走脱。"
msgstr ""

msgid "把逆灵宫的余孽交给官府去剿"
msgstr ""

msgid "宫里剩下的人下了山，交茅山看管。坛上的火灭了。"
msgstr ""

msgid "劝逆灵宫的余孽下山，交茅山看管"
msgstr ""

msgid "接了朱鸿雪的令，替东方神教办事。"
msgstr ""

msgid "晚月庄的西厢住着一个人，住了三年——东方神教的一代教主安妮儿。朱鸿雪要知道她在等谁：去晚月庄西厢问安妮儿「等谁」。"
msgstr ""

msgid "安妮儿说了她在等什么。末了一句：「你可以照实说。」"
msgstr ""

msgid "回绮云镇棺材铺后的场院，把西厢的话告诉朱鸿雪。照实说（「照实说」）：那件衣，安妮儿不打算交给神教——朱鸿雪会记住这句话。或者替她瞒（「替她瞒」）：只说她在等一个故人——安妮儿欠你一回，朱鸿雪信你这一回。"
msgstr ""

msgid "你把安妮儿的话照实告诉了朱鸿雪：那件衣，她不打算交给神教。"
msgstr ""

msgid "把西厢的话照实告诉了朱鸿雪"
msgstr ""

msgid "你替安妮儿瞒了下来，只说她在等一个故人。朱鸿雪信了你这一回。"
msgstr ""

msgid "替安妮儿瞒下了西厢的话"
msgstr ""

msgid "神教的令不发新的，只从上一个持令人手里接。朱鸿雪派去玉螺湖的人上个月没回来，令在他身上：入夜之后去玉螺湖畔的芦苇丛找他（湖边夜里有鬼卒），拿回那块黑木令，再问朱鸿雪「令牌」。"
msgstr ""

msgid "朱鸿雪把黑木令放回你手里：「现在它是你的。」带着它，神教的杀手认你是自己人。"
msgstr ""

msgid "从玉螺湖畔的芦苇丛里接回了一块黑木令"
msgstr ""

msgid "黑木令在你身上了。朱鸿雪还有差事交给持令的人：回绮云镇的场院，问朱鸿雪「差事」。"
msgstr ""

msgid "朱鸿雪说了三个名字：湖边量水的黑冠道士、黄石隘口画图的兵部画吏、玉螺湖村凿冰的老冰匠——都是靠近湖底封物的人。"
msgstr ""

msgid "朱鸿雪的三个名字，都是靠近湖底封物的人。玉螺湖村稻田西头的湖岸上，白天有个黑冠道士在量水——逆灵宫的人，打倒他。天驼关黄石隘口的山壁下，兵部的画吏在画当年石匣出土的地方——打倒了，放他走就算。第三个是玉螺湖村年年凿冰的老冰匠，在柳树下的湖岸边：怎么办，看你。"
msgstr ""

msgid "湖边量水的道士、隘口画图的画吏，都了了。"
msgstr ""

msgid "湖边量水的黑冠道士"
msgstr ""

msgid "白天在玉螺湖村稻田西头的湖岸上"
msgstr ""

msgid "黄石隘口的兵部画吏"
msgstr ""

msgid "在天驼关黄石隘口的山壁下"
msgstr ""

msgid "凿冰的老冰匠"
msgstr ""

msgid "在玉螺湖村柳树下的湖岸边"
msgstr ""

msgid "第三个名字是玉螺湖村凿冰的老冰匠。他只是看见过冰下的光，讲给村里的孩子听。做（问他「动手」）：朱鸿雪升你赤铜令——村里少一个人，安妮儿会知道。不做（问他「搬走」）：劝他离开玉螺湖，带他的冰凿回去交差——朱鸿雪信不信，看你西厢那一桩有没有瞒过她。"
msgstr ""

msgid "老冰匠倒在了湖岸上。玉螺湖村少了一个人。"
msgstr ""

msgid "替朱鸿雪杀了玉螺湖凿冰的老冰匠"
msgstr ""

msgid "老冰匠背起包袱离开了玉螺湖。他的冰凿在你手里。"
msgstr ""

msgid "劝玉螺湖的老冰匠搬走，拿他的冰凿去交差"
msgstr ""

msgid "三个名字都了了。回绮云镇的场院，问朱鸿雪「交差」。"
msgstr ""

msgid "朱鸿雪收回了黑木令，换给你一块赤铜令。"
msgstr ""

msgid "从朱鸿雪手里换来了一块赤铜令"
msgstr ""

msgid "朱鸿雪说，名单上还有最后一个名字。出了场院走一走，再回场院去。"
msgstr ""

msgid "场院里，朱鸿雪念出了名单上最后一个名字。安妮儿就站在厅里。"
msgstr ""

msgid "神教只能有一个教主。站安妮儿（问她「教主」）：她收回教主令，给你黄金令牌，教你天山雪影剑和雪影心法；朱鸿雪认输，不走，往后只派该死的人的差事；终章她来湖畔守潭口，正月十七神教不去虹台搅局。站朱鸿雪（问她「教主」）：她给你黄金令牌，教同一套武功；安妮儿回西厢闭门，不再同你说神教的事；正月十七那天，神教的杀手会在山道上截一派的轿子。"
msgstr ""

msgid "你站到了安妮儿一边。她收回了教主令，把一块黄金令牌放进你手里：天山的剑，到西厢去学。"
msgstr ""

msgid "在绮云镇的场院里站到了安妮儿一边"
msgstr ""

msgid "你站到了朱鸿雪一边。她把一块黄金令牌放进你手里：神教只有一个教主。"
msgstr ""

msgid "在绮云镇的场院里站到了朱鸿雪一边"
msgstr ""

msgid "替振远镖局押一趟镖到京师；二十年前那趟镖的旧账，查到底还是到此为止。"
msgstr ""

msgid "你离了振远镖局。镖局的事，到此为止。"
msgstr ""

msgid "绮云镇的振远镖局有一趟镖要走京师总局，人手不够。去镖局见陈剑秋，问他「走镖」。"
msgstr ""

msgid "陈剑秋把一趟红货交给了你：两箱，京师振远总局收，交给总镖头陈天星。趟子手老周推车。"
msgstr ""

msgid "老周推着镖车跟你走（在镖局里问他「上路」）。出绮云镇往北到雪亭镇，沿青石官道往西南，过碎石小路，从铁索下到天驼关，再沿黄土大道往南到京师。车马行不拉镖车。镖车落在后头的，回去叫老周「上路」。"
msgstr ""

msgid "碎石小路上有人劫镖。领头的蒙面后生倒在路边，刀扔在一旁。"
msgstr ""

msgid "劫镖的后生坐在路边，不看你（问他「爹」）。交官府（「交官府」）：劫镖是大罪，过了铁索就是天驼关，守关的官兵押他去京师，官府的赏金振远转给你；放他走（「走吧」）：他留下他爹最后的一封家信，劫镖的人从此不见官。"
msgstr ""

msgid "你把劫镖的后生交给了天驼关的官兵。"
msgstr ""

msgid "把碎石小路上劫镖的后生交了官"
msgstr ""

msgid "你放劫镖的后生走了。他留下了他爹贺长庚最后的一封家信。"
msgstr ""

msgid "放走了碎石小路上劫镖的后生"
msgstr ""

msgid "镖车还要到京师：东街北头的振远总局，老周推车进门，镖就交到了总镖头陈天星手里。"
msgstr ""

msgid "镖交到了京师振远总局。陈天星写了一张振远的名帖给你：京师有些门，要帖子才敲得开。"
msgstr ""

msgid "替振远押了一趟镖到京师总局"
msgstr ""

msgid "镖头"
msgstr ""

msgid "贺长庚的家信在你身上。交给京师振远总局的陈天星。"
msgstr ""

msgid "陈天星看了家信：兵部的人在岭上等着，镖头说照走。"
msgstr ""

msgid "把贺长庚的家信交给了陈天星"
msgstr ""

msgid "二十年前那趟镖，振远的总账里还有一笔没对上。去京师东街北头的振远总局，问陈天星「旧账」。"
msgstr ""

msgid "陈天星翻完了振远二十年的总账：绮云分局开张的本钱，是那趟镖之后兵部送来的「抚恤银」。"
msgstr ""

msgid "绮云分局开张的本钱是兵部的抚恤银，陈剑秋知道。回绮云镇的振远镖局，问陈剑秋「旧账」。"
msgstr ""

msgid "陈剑秋认了：那年振远死了十一个人，兵部给钱，他拿了。"
msgstr ""

msgid "账本在陈天星手里，他要告；陈剑秋要瞒。到此为止（在绮云镇问陈剑秋「到此为止」）：账本烧了，抚恤银的事振远不再提，正月十七振远那一票投颜违；陈剑秋教你春风快意刀，陈天星往后见你只谈生意。查到底（在京师问陈天星「查到底」）：账本押去乔阴县衙，告兵部也告振远自己，陈剑秋关了绮云分局的门；振远那一票投旧盟主，京师的事还没定的，这本账算揭发的一样人证物证。"
msgstr ""

msgid "你站到了陈剑秋一边：那本总账烧了，二十年前的抚恤银，振远不再提。陈剑秋许你学春风快意刀。"
msgstr ""

msgid "劝陈剑秋把振远的旧账烧了：到此为止"
msgstr ""

msgid "你站到了陈天星一边：振远的总账押去了乔阴县衙。绮云分局关了门。"
msgstr ""

msgid "跟陈天星把振远的旧账送进了乔阴县衙：查到底"
msgstr ""

msgid "晚月庄失传的舞、带出庄的宝衣，和内书房那位老妇的女儿。"
msgstr ""

msgid "你离了晚月庄。庄里的事，到此为止。"
msgstr ""

msgid "庄主蓝止萍在晚月庄的前厅。问她「庄里的事」。"
msgstr ""

msgid "蓝止萍说：晚月庄失传过一支舞，叫沧海龙吟。步子绣在后院书房的湘绣舞曲图上，曲子在舞曲谱里；两样凑齐，到二楼佛堂，在区冥的神位前跳一回。"
msgstr ""

msgid "沧海龙吟的步子在后院书房墙上的湘绣舞曲图里（昭仪天天对着它看），曲子在舞曲谱里（翠湘阁的莫欣芳知道谱放在哪）。看过那幅图，把舞曲谱拿到手。"
msgstr ""

msgid "图上的姿势，谱上的曲子，你都记下了：沧海龙吟。"
msgstr ""

msgid "到二楼的佛堂，在区冥的神位前跳沧海龙吟。女子自己跳；男子请人替跳：禁闭房的芳绫（问她「替跳」，她跟你走），或翠湘阁的莫欣芳（在神位前「请人替跳」，她从回廊那头过来）。"
msgstr ""

msgid "沧海龙吟在区冥的神位前跳成了。神像的眉间亮了一下。"
msgstr ""

msgid "在区冥的神位前跳回了失传的沧海龙吟"
msgstr ""

msgid "宝衣的事，要等主线第四章「宝衣」有了着落。到那时，再回东厢见瑷伦。"
msgstr ""

msgid "宝衣挡完了湖底那一口黑焰，烧成了灰。"
msgstr ""

msgid "宝衣在瑷伦身上。庄里一切如旧。"
msgstr ""

msgid "宝衣在西厢的安妮儿手里。"
msgstr ""

msgid "宝衣还在你身上。东厢的瑷伦失了衣。"
msgstr ""

msgid "宝衣还在你身上。东厢的瑷伦失了衣，她问你一句：还回来吗？还回来（问她「还衣」）：她又是守衣人，凤凰回到小花池，决战那日她穿着它跟你下湖——宝衣就不在你身上了，下湖没有它挡寒气。留在身上（问她「留着」）：宝衣照旧跟着你，庄里照旧没有护佑。"
msgstr ""

msgid "你把寒於宝衣还给了瑷伦。她又是守衣人。"
msgstr ""

msgid "把带出庄的寒於宝衣送回了晚月庄"
msgstr ""

msgid "宝衣留在了你身上。瑷伦不再问。"
msgstr ""

msgid "对守衣人说，寒於宝衣留在自己身上"
msgstr ""

msgid "宝衣在湖底烧成了灰。还不还，都不必再说了。"
msgstr ""

msgid "内书房的无名老妇有一桩心事。去问她「心事」。"
msgstr ""

msgid "无名老妇说了她的女儿：那个蒙面的杀手。她要你去问问她，为什么走到了这一步。"
msgstr ""

msgid "老妇的女儿在哪，要看第四章有没有那一夜。"
msgstr ""

msgid "宝衣没有出庄，那一夜没有来。她还在内书房里，蒙着面。"
msgstr ""

msgid "那一夜之后，她再没有进过庄门。"
msgstr ""

msgid "老妇的女儿就是内书房里那个蒙面的杀手。问她「娘」。动手也行——这一步她只会倒下，不会死。"
msgstr ""

msgid "她说了来历：北麓的道观、六阴剑、东方神教，和朱鸿雪派她回晚月庄的缘故。"
msgstr ""

msgid "那一夜之后，她藏在庄后山路尽头的竹林里，入夜才在（白天去，竹林里没有人）。走进竹林找到她，问她「娘」。动手也行——这一步她只会倒下，不会死。"
msgstr ""

msgid "她说了来历：北麓的道观、六阴剑、东方神教，和朱鸿雪派她回晚月庄的缘故。她回了内书房，在她娘身边。"
msgstr ""

msgid "她的杀手令牌在你手上。两个人要它：内书房的老妇要它为证——递给她，她知道女儿还活着，给你一份谢礼（只给一次）；绮云镇的朱鸿雪要它回神教——问她「还令」，神教的令只从上一个持令人手里接。给了一边，另一边就没有了。"
msgstr ""

msgid "你把令牌递给了老妇。她攥着它，知道女儿还活着。"
msgstr ""

msgid "把蒙面杀手的令牌交给了她娘"
msgstr ""

msgid "你把令牌还给了朱鸿雪。神教的令，回了神教。"
msgstr ""

msgid "把晚月庄那块杀手令牌还给了东方神教"
msgstr ""

msgid "下回进晚月庄的大厅，蓝止萍有话要说——老妇和她女儿会从内书房出来。两条路：依庄规（问蓝止萍「庄规」）——人交给蓝止萍处置，晚月庄这一票投颜违，老妇从此不再开口；带她回来（问老妇「女儿」）——她留在内书房陪她娘，晚月庄这一票投旧盟主，蓝止萍从此对你冷一分。两边都先问你一声；选了不能改。"
msgstr ""

msgid "你依了庄规。她跟着蓝止萍的人走了，没有回头。"
msgstr ""

msgid "依晚月庄的庄规，把老妇的女儿交给了蓝止萍"
msgstr ""

msgid "你把她带了回来。内书房里多了一个人，不再蒙面。老妇替你向庄主讨了一个执事。"
msgstr ""

msgid "把老妇的女儿带回了晚月庄"
msgstr ""

msgid "替花紫会摸回槐阳八户的卖身契；数着皮酒囊上的结，找到真龙头；尚书府小屋那封密信，给花紫会还是给官府；夜里从狗洞偷出卫沧澜；认二十三个结，还是认这些年管事的人。"
msgstr ""

msgid "叫花子不再跟你说正事。花紫会的事，到此为止。"
msgstr ""

msgid "乔阴福林大街上的陆得财有一件差事。去问他「差事」。"
msgstr ""

msgid "陆得财托你一件差事：福林酒楼二楼那个兵部的胡管事，怀里揣着槐阳城外八户人家的卖身契。摸回来。"
msgstr ""

msgid "兵部收民夫的胡管事在福林酒楼二楼雅座喝酒，那叠卖身契揣在他怀里。选中他「偷窃」，挑「随手摸一样」——他身上只有那叠契。失了手，他喊着扑上来，乔阴的巡捕从此记你一笔（街上撞见就抓，罪名、行贿照旧）。不会偷的，先跟陆得财学两手「偷窃」。"
msgstr ""

msgid "那叠卖身契到了你手里。"
msgstr ""

msgid "卖身契在你身上。回福林大街，递给陆得财。"
msgstr ""

msgid "陆得财数完了八张契：明天她们就回家。他把皮酒囊递给你数——二十二个结。他是龙头的一个替身。"
msgstr ""

msgid "从兵部的管事身上摸回了槐阳八户的卖身契"
msgstr ""

msgid "五结弟子"
msgstr ""

msgid "真龙头的皮酒囊上二十三个结，替身的都少几个；替身一个只认得下一个。雪亭镇广场墙根下那个老乞丐也叫陆得财，结最少——问他「龙头」。"
msgstr ""

msgid "雪亭的陆得财，二十个结。他指了下一个：绮云镇的渡口。"
msgstr ""

msgid "下一个在绮云镇的渡口，坐在船帮上钓鱼，比雪亭那个多一个结。问他「龙头」。"
msgstr ""

msgid "绮云的陆得财，二十一个结。他说下一个就是龙头：京师东街，尚书府的后墙根底下。"
msgstr ""

msgid "京师东街，尚书府的后墙根底下，坐着一个打二十三个结的叫花子。问他「龙头」。"
msgstr ""

msgid "墙根下的陆得财，二十三个结。他是真龙头，在这堵墙底下看了庾家二十年；乔阴那个替他管着花紫会。"
msgstr ""

msgid "真龙头要尚书府后院小屋里那封庾子建亲笔的密信（问他「密信」）；乔阴的程不平也要它，拿去当物证。玉螺湖底那件事之后，逆灵宫的信使才坐进小屋，信在他身上：进了小屋就是一场仗，他见人就动手，打不过就退出屋外。交给花紫会（问真龙头「密信」）：真龙头拿它压着庾家，官府那条线就断了；京师的事还没定的，这封信也不能拿去朝上揭发了。交给官府（问乔阴县衙的程不平「密信」）：揭发时照样算一样，花紫会这条线就断了。"
msgstr ""

msgid "你把密信交给了真龙头。他把它塞进了皮酒囊的网绳里：这封信在一天，庾家就不敢清乔阴的巷子。"
msgstr ""

msgid "把尚书府小屋里的密信交给了花紫会的真龙头"
msgstr ""

msgid "你把密信交给了乔阴知县程不平。叫花子从此不跟你说正事。"
msgstr ""

msgid "把尚书府小屋里的密信交给了乔阴知县程不平"
msgstr ""

msgid "真龙头还有一件事要托你：尚书府客房里关着的那个老人。到京师东街尚书府的后墙根，问他「盟主」。他说了狗洞的：夜里（入夜到子时）拨开墙根东头那捆柴草，从狗洞钻进后院；护院挑着灯在院子里绕圈，别跟他们照面——撞见了就被推出大门，下回再来。进了客房，跟那老人说「走」。卫沧澜已经出了尚书府的，问真龙头一句「盟主」就是。"
msgstr ""

msgid "卫沧澜照叫花子指的路，从后院的狗洞出了尚书府。真龙头说：人出来了，他也该回乔阴了——福林大街见。"
msgstr ""

msgid "夜里从尚书府的狗洞偷出了卫沧澜"
msgstr ""

msgid "卫沧澜已经出了尚书府。真龙头说：人出来了，他也该回乔阴了——福林大街见。"
msgstr ""

msgid "真龙头回了乔阴，坐在福林大街当中。去福林大街——陆得财在街上的时候，两个人要碰面。真龙头要带花紫会吃官饭：给官府做眼线，换叫花子不再被巡捕抓；陆得财二十年没让一个官差进过乔阴的巷子。认二十三个结，问真龙头「龙头」：花紫会投颜违，巡捕不再抓花紫会的人，你的偷窃案底勾销，陆得财走了就不回来。认这些年管事的人，问陆得财「龙头」：真龙头回京师的墙根，乔阴照旧，花紫会投旧盟主。已经入了虹台的席的，票照入席时的算。"
msgstr ""

msgid "你认了二十三个结。陆得财把怀里的东西都放在真龙头脚边，出了北门。花紫会吃上了官饭。"
msgstr ""

msgid "在福林大街认了二十三个结：花紫会跟真龙头吃官饭"
msgstr ""

msgid "九结弟子"
msgstr ""

msgid "你认了这些年管事的陆得财。真龙头把皮酒囊系到他腰上，回了京师的墙根。乔阴的巷子里，照旧没有官差。"
msgstr ""

msgid "在福林大街认了这些年管事的陆得财"
msgstr ""

msgid "做乔阴县的捕快：拿下官道上挂着官府告示收过路费的人，路引上是天驼关的印；严廷殷的印丢过三天，李信记着那三天的账——跟严廷殷整肃，还是跟李信揭发。"
msgstr ""

msgid "程不平不再跟你说案子。官府的事，到此为止。"
msgstr ""

msgid "武举的荐书：带着捕快腰牌去京师校武场，问葛升「武举」，第一场免考"
msgstr ""

msgid "小屋的密信"
msgstr ""

msgid "在尚书府后院小屋里逆灵宫的信使身上；交给程不平（问他「密信」），给了花紫会，官府这条线就断了"
msgstr ""

msgid "乔阴知县程不平还缺一个捕快。去县衙大堂问他「捕快」。花紫会的人、惯窃，他不收。"
msgstr ""

msgid "程不平给了你一块乔阴捕快腰牌：不给俸禄，不教功夫，只给案子。"
msgstr ""

msgid "头一件案子：雪亭镇往西，青石官道的路口，有个汉子倚着一块「官府告示」收过路费，黄金一两。乔阴县衙没贴过那样的告示——拿下他（选中他「攻击」），他身上有东西。"
msgstr ""

msgid "雪亭路口收钱的钱贵挨了打，扔下一叠路引跑了。"
msgstr ""

msgid "还有一个：绮云镇口那块官府公告底下，有人照着公告收「入镇黄金一两」。拿下他（选中他「攻击」）。"
msgstr ""

msgid "绮云镇口收钱的牛四也挨了打，路引掉了一地。"
msgstr ""

msgid "两个收过路费的身上都搜出了路引。带着路引回乔阴县衙，问程不平「路引」。"
msgstr ""

msgid "程不平认出路引上的印：天驼关铁卫营的大印，严将军的印。"
msgstr ""

msgid "拿下了官道上挂着官府告示收过路费的人，搜出了盖着天驼关大印的路引"
msgstr ""

msgid "路引上是天驼关铁卫营的大印。带着路引去天驼关军营最里头的将军营帐（进营要大队长的名册），问镇国大将军严廷殷「路引」。程不平的信还没给他看的，先给他看信。"
msgstr ""

msgid "严廷殷认了路引上的印：是他的印，丢过三天的那一方。那三天的事，他叫你去问副将李信。"
msgstr ""

msgid "副将李信在副将营帐（将军营帐外头那一间）。问他「印鉴」：印丢的那三天，他记着。"
msgstr ""

msgid "李信拿出一本薄册子：印丢的那三天，盖出去的是私授的官职十二个、空白的路引四百张，还让兵部拓了个模子去——关北征民夫的令，盖的是照模子浇的印。盖印的是军师赫造基。"
msgstr ""

msgid "带着路引回将军营帐，问军师赫造基「路引」，当面对一对李信的账。第六章他那桩八两银子的秘密（拓模）还没买的，先买下——他认的是买过模子的人。"
msgstr ""

msgid "赫造基认了：印丢的那三天在后备兵手里，他借来替兵部盖了一夜官职的札子和路引。要告他，就连将军一起告——印是将军丢的。"
msgstr ""

msgid "跟李信揭发（在副将营帐问他「揭发」）：账本上京，严廷殷被召回，李信守关，天驼关从此不收过路费；第九章还没定的，这本账算揭发的一样物证。跟严廷殷整肃（在将军营帐问他「整肃」）：军师由你在营里拿下，路引停了，天驼关照旧是他的，关北的事不往朝上报——铁卫营欠你一回，终章替你守官道。"
msgstr ""

msgid "你跟严廷殷整肃：军师交给你在营里拿下，天驼关的事天驼关了。"
msgstr ""

msgid "在天驼关跟严廷殷整肃，那三天的账不上京"
msgstr ""

msgid "你跟李信揭发：李信的账抄一份上了京，严廷殷被召回京城，李信守关。天驼关从此不收过路费。"
msgstr ""

msgid "在天驼关跟李信揭发，那三天的账上了京"
msgstr ""

msgid "军师赫造基就在将军营帐里。问他「路引」，他知道瞒不住了；再选中他「攻击」，拿下他（他只会被击倒）。"
msgstr ""

msgid "赫造基倒在将军营帐里，两个铁卫营的兵把他捆了，关进后营。官道上的路引从此停了。严廷殷说：铁卫营欠你一回。"
msgstr ""

msgid "尚书府的客房里还关着卫沧澜。皇叔入了朝的，去皇城养心殿问於兰天武「卫沧澜」：他拿着手诏去尚书府要人。卫沧澜已经出了尚书府的，这一步就过了；第九章没有请皇叔回朝的，官府插不上手。"
msgstr ""

msgid "於兰天武拿着手诏去了尚书府，庾子建亲自开的门。卫沧澜回了水烟阁——他说，这条命欠朝廷一份。"
msgstr ""

msgid "请皇叔拿手诏从尚书府要回了卫沧澜"
msgstr ""

msgid "卫沧澜已经出了尚书府。"
msgstr ""

msgid "皇叔没有回朝。卫沧澜的事，官府插不上手。"
msgstr ""

msgid "藏经楼少了一函镇教秘籍；林忌的师弟，二十年前带着它下了山。书回了山，后半本是逆灵宫的字——烧，还是收回藏经楼。"
msgstr ""

msgid "你离了茅山。灵心观的事，到此为止。"
msgstr ""

msgid "灵心观藏经楼的二楼，红布桌上放着茅山的镇教秘籍。林忌在灵心观的大殿——问他「师弟」，再上二楼看看那张桌子。"
msgstr ""

msgid "镇教秘籍少了一函。红布上压着一张发黄的字条：书我带走。师兄守山，我守人。"
msgstr ""

msgid "回灵心观的大殿，再问林忌「师弟」。"
msgstr ""

msgid "林忌说：少的那一函叫《上清符箓》。二十年前兵部的庾大人求茅山镇宅，他不肯，他的师弟揣着书下了山，进了京城的兵部尚书府，再没回来。"
msgstr ""

msgid "数出藏经楼的镇教秘籍少了一函"
msgstr ""

msgid "侍者"
msgstr ""

msgid "林忌的师弟二十年前进了京师的兵部尚书府。尚书府的花园里有个花匠（进府要先打点大门的门房）——问他「师兄」。"
msgstr ""

msgid "尚书府的花匠就是林忌的师弟。他镇了二十年宅，教过庾清尘；这两年小屋里来了逆灵宫的人，他们烧掉的东西，他一页页抄在了《上清符箓》的空白处。"
msgstr ""

msgid "问尚书府的花匠「符箓」。"
msgstr ""

msgid "花匠把《上清符箓》交给了你：前半是茅山的符，后半是逆灵宫的字。"
msgstr ""

msgid "从尚书府的花匠手里接过了《上清符箓》"
msgstr ""

msgid "把《上清符箓》带回灵心观的大殿，交给林忌（「给」他）。"
msgstr ""

msgid "林忌一页一页翻过去，翻到后半本停住了：是逆灵宫的字。他说，师弟会来的。"
msgstr ""

msgid "林忌说师弟会来。花匠随后自己上了山——二十年没进过的大殿，下回你进殿，他就站在殿门里。"
msgstr ""

msgid "花匠站在殿门里，叫了林忌一声师兄。林忌说烧：连书带字投进香炉，茅山宁可没有它。花匠说留：锁回藏经楼，茅山才认得逆灵宫的字。"
msgstr ""

msgid "烧（问林忌「烧」）：书投进香炉，花匠回京城守着庾清尘；林忌教你谷衣心法，虹台上茅山投颜违（主剿）。留（问花匠「留」）：书锁回藏经楼二楼，花匠留在山上守书，教茅山道术，谁都教；林忌从此对你冷一分，虹台上茅山投旧盟主（北麓的人交茅山看着）。两边茅山的弟子都晋护法。"
msgstr ""

msgid "《上清符箓》投进了殿前的香炉。茅山宁可没有这本书；花匠下山回京城去了。"
msgstr ""

msgid "看着林忌把《上清符箓》投进了香炉"
msgstr ""

msgid "《上清符箓》锁回了藏经楼二楼，花匠留在山上守书。护法的名分，是花匠替你向林忌讨的。"
msgstr ""

msgid "把《上清符箓》收回了藏经楼"
msgstr ""

msgid "北麓那座道观里还剩着人。湖上的事了了（终章之后），问林忌「剿」：官兵上山，一个也走不了。北麓的人已经有了去处的，这一步就过了。"
msgstr ""

msgid "北麓那座道观里剩下的人，有了去处。"
msgstr ""

msgid "北麓那座道观里还剩着人。湖上的事了了（终章之后），问藏经楼二楼的花匠「北麓」：他拿着书上北麓去念他们自己的经——你上北麓，在绞盘边看他念完。北麓的人已经有了去处的，这一步就过了。"
msgstr ""

msgid "乔阴"
msgstr "Уезд Цяоинь"

msgid "风泉之剑里住着剑灵；见过它的人，才算步玄的人。骆云舟的大哥在兵部尚书府写了十年字，兵部抄本上多出来的三句是他落的笔——让他上堂作证，还是保住骆家。"
msgstr ""

msgid "你离了步玄派。曼雩台上的事，到此为止。"
msgstr ""

msgid "问乔阴曼雩台的骆云舟「风泉」，再问他「问剑」：他把风泉之剑插在台边的青石上。天黑以后（夜晚、午夜）剑灵站在石前——跟它切磋，在它念到第四句「剑神如意」之前打中它。"
msgstr ""

msgid "剑灵在「剑神如意」之前收了剑。骆云舟说：步玄认你。"
msgstr ""

msgid "在曼雩台上问过了剑，见过了风泉剑灵"
msgstr ""

msgid "今夜的四句念完了，剑灵回了剑——明晚天黑再来"
msgstr ""

msgid "问骆云舟「骆家」。他的家事在京城，要等主线第九章（进京）开了。"
msgstr ""

msgid "骆云舟是骆家的二小子。大哥骆建章没去练剑，写得一手好字，在兵部尚书庾子建的府上做了十年书启；兄弟俩十年没说过话。他写了一封家书，托你送进京。"
msgstr ""

msgid "等主线第九章：湖底的事了了，才进得了京"
msgstr ""

msgid "把家书送进京（「给」骆建章）：他在兵部尚书府的客厅里写字——进府先打点大门的门房；见过韦相国的，问相国「骆建章」，他写个条子给门房。庾子建下了狱，骆建章就在西街的相国府。"
msgstr ""

msgid "骆建章读完了信：「他还是那么写字，最后一笔甩出格子。」抄本的事，他一句没提。"
msgstr ""

msgid "第九章御书房樟木匣里的兵部抄本，比先帝的原令多出三句。带着它问骆建章「抄本」，或者问韦相国「抄本的字」。"
msgstr ""

msgid "骆建章认了：二十年前他在兵部做抄手，原令存档的底子是他抄的；兵部抄本是庾子建口述、他落的笔——多出来的是哪三句，他写的时候就知道。"
msgstr ""

msgid "认出了兵部抄本上骆家的字"
msgstr ""

msgid "带着兵部抄本"
msgstr ""

msgid "抄本在皇城御书房的樟木匣里：先走主线第九章"
msgstr ""

msgid "回乔阴的曼雩台，把大哥的话告诉骆云舟（问他「骆家」）。"
msgstr ""

msgid "骆云舟听完，扇子停在半空。十年没回京城，他说，进京一趟。"
msgstr ""

msgid "骆云舟进京了。去西街的相国府：兄弟俩在正厅上见面，韦相国坐在上首。（话听了一半就走开的：作证问骆云舟「作证」，保住骆家问骆建章「回家」。）"
msgstr ""

msgid "骆云舟要大哥上堂，把抄本上那三句是谁口述的说出来；大哥要跟他回乔阴，抄本的事不提。韦执中坐在上首，一句话也没说。"
msgstr ""

msgid "作证（问骆云舟「作证」）：大哥写供状，说出抄本那三句是庾子建口述——第九章还没定的，朝上揭发多一样人证；庾子建已经下狱的，大哥照实供，判流放；私了过或先解了皇叔通缉的，乔阴的案子重开。骆家和朝廷翻脸，虹台上步玄投旧盟主。保住骆家（问骆建章「回家」）：骆云舟带大哥回乔阴，抄本的事不提，大哥在曼雩台抄谱；骆家照旧是京城的世家，虹台上步玄投颜违。两边步玄的弟子都晋执事。"
msgstr ""

msgid "骆建章写了供状，按了手印：兵部抄本上多出来的三句，是庾子建口述、他落的笔。骆家和朝廷翻了脸。"
msgstr ""

msgid "陪骆建章写下了兵部抄本的供状"
msgstr ""

msgid "骆云舟带大哥回了乔阴。抄本的事，骆家不再提；曼雩台上多了一张书案。"
msgstr ""

msgid "让骆云舟带大哥回了乔阴"
msgstr ""

msgid "流云轩里躺着一个被鬼卒抓伤的乔阴樵夫，玄智的药赶不出那股寒；金门外站了十年的独眼头陀开口了：「我能。」他那部火性的经，三十年前从番坊来过一回，山烟寺没有收——这一回，收不收。"
msgstr ""

msgid "你离了山烟寺。流云轩的事，到此为止。"
msgstr ""

msgid "流云轩里躺着一个乔阴来的樵夫，伤口是冷的。去山烟寺大雄宝殿问玄智方丈「流云轩」，请他开方子。"
msgstr ""

msgid "玄智开了方子：附子回阳，麝香开窍，鬼臼以毒攻毒。三味齐了，交给流云轩的药僧煎。"
msgstr ""

msgid "等主线第五章：寒於宝衣的事了了，才有这个病人"
msgstr ""

msgid "第一味：附子。在山烟寺东边的药圃里「采」。"
msgstr ""

msgid "你在药圃东边那一畦挖出了一块附子。"
msgstr ""

msgid "第二味：麝香。雪亭镇桑邻药铺的杨掌柜年轻时跟玄智学过医，问他「山烟寺」。"
msgstr ""

msgid "杨掌柜看了方子，包了一小包麝香给你，没收钱。"
msgstr ""

msgid "第三味：鬼臼，长在乔阴树王坟边的石缝里。那里站着一个鬼卒——打发了它，在石缝边「采」。"
msgstr ""

msgid "你在树王坟边的石缝里采到了一株鬼臼。"
msgstr ""

msgid "三味齐了。回流云轩，问药僧「煎药」。"
msgstr ""

msgid "药僧把三味药煎成了一碗黑褐色的汤药。"
msgstr ""

msgid "把汤药喂给老葛（「给」流云轩里躺着的樵夫）。"
msgstr ""

msgid "药喂下去了，老葛肚子里是热的，可那条胳膊还是冷，冷到骨头缝里——寒气退不下去。"
msgstr ""

msgid "替流云轩采齐了玄智的三味药，喂了乔阴的樵夫"
msgstr ""

msgid "知客"
msgstr ""

msgid "玄智的药赶不出那股寒。金门外站了十年、从不说话的独眼头陀，问他「病人」。让他治（问头陀「领路」）：领他进流云轩，老葛当场就好——可寺规不许外人进流云轩，玄智会记你不守寺规。照寺规（问大雄宝殿的玄智「寺规」）：方丈自己守着老葛，命保得住，一只手保不住；头陀从此不理你。"
msgstr ""

msgid "你领独眼头陀进了流云轩。他一掌按在老葛的伤口上，寒气冒成一缕白烟——老葛当场坐了起来。玄智记下了：你不守寺规。"
msgstr ""

msgid "领金门外的独眼头陀进了流云轩，治好了乔阴的樵夫"
msgstr ""

msgid "你照了寺规。玄智在流云轩守了老葛三天三夜：命保住了，右手废了。头陀转身回了金门外。"
msgstr ""

msgid "照山烟寺的寺规，没让外人进流云轩"
msgstr ""

msgid "独眼头陀那门火性的内功，他练的那部经，不是山烟寺的东西。它从番坊来：去番坊日陀罗寺问龙若法王「头陀」。"
msgstr ""

msgid "龙若法王说起了三十年前：师父从天竺背来的两部经，当年不肯开经匣的住持，追出山门的玄尘，十年前派回去的头陀和他那只眼。他给了你一片贝叶：「收不收，是山烟寺的事。」"
msgstr ""

msgid "照了寺规的：先回流云轩，药僧有话要说"
msgstr ""

msgid "回日照山，把龙若法王的贝叶拿给金门外的独眼头陀看（问他「经」）。"
msgstr ""

msgid "独眼头陀认出了叶边师父的字。十年里第一次，他跨进了金门，往大雄宝殿去了。"
msgstr ""

msgid "头陀上了大雄宝殿。去大殿：玄智、头陀、你。（话听了一半就走开的：收经问玄智「收经」，守寺问玄智「守寺」。）"
msgstr ""

msgid "头陀把贝叶放在佛前，只问一句：收，还是不收。玄智说起三十年前走掉的玄尘师弟，回过头来问你。"
msgstr ""

msgid "收经（问玄智「收经」）：头陀受戒入寺，流云轩从此治得了鬼卒的寒，头陀在流云轩教婆萝蜜多心经，谁都能学；容得下西来的经，也容得下别人，虹台上山烟寺投旧盟主。守寺（问玄智「守寺」）：本寺一脉，经交还龙若，头陀回番坊，金门外空了；玄智肯教外人莲华心法；虹台上山烟寺投颜违。两边山烟寺的弟子都晋首座。"
msgstr ""

msgid "山烟寺收了西来的经。独眼头陀在佛前受了戒，去了流云轩；鬼卒的寒，往后山烟寺赶得出去了。"
msgstr ""

msgid "把番坊的婆萝蜜多心经带回日照山，山烟寺收了经"
msgstr ""

msgid "首座"
msgstr ""

msgid "山烟寺守了本寺一脉。玄智把贝叶交还头陀，头陀回了番坊，金门外那块地方空了。"
msgstr ""

msgid "陪山烟寺守住了本寺一脉，把西来的经送回了番坊"
msgstr ""

msgid "青石村北边那个拴着铁链的山洞，村长说「绝对不可以打开」。现在洞里真的有东西了。山洞后面是八卦阵，阵后面是不问世事的绝尘子——三十年前，他是山烟寺的玄尘。他的首徒了尘要下山。"
msgstr ""

msgid "你离了绝尘派。青石村的事，到此为止。"
msgstr ""

msgid "青石村北边那个山洞，门上拴着手臂粗的铁链，村里人说闹鬼。拴门的是村长：去他家（广场南边那间石屋）问他「山洞」。"
msgstr ""

msgid "村长说：那道门是他拴的。妇人家的阿牛背着妹妹，又钻进去了。"
msgstr ""

msgid "等主线第五章：寒於宝衣的事了了，鬼卒才出来"
msgstr ""

msgid "开了洞口那道拴着铁链的木门进洞，打发洞里的鬼卒，找到阿牛，问他「回家」，领他回村北路口找他娘。"
msgstr ""

msgid "你把阿牛和小翠领出了山洞，交给了他们的娘。"
msgstr ""

msgid "洞口那个鬼卒"
msgstr ""

msgid "洞底那个鬼卒"
msgstr ""

msgid "孩子回家了。去告诉村长，再问他「山洞」。"
msgstr ""

msgid "村长这回把那句话说完了：「国之将亡，必有妖孽。」"
msgstr ""

msgid "洞的北口就是去八卦阵的荒山路。回石室大厅，问绝尘子「青石村」。"
msgstr ""

msgid "绝尘子说，洞里有东西，他知道。阵守得住石室，他就不管——绝尘派不问世事。"
msgstr ""

msgid "把青石村的孩子从闹鬼的山洞里领了出来"
msgstr ""

msgid "不是绝尘派的弟子：进大厅要再走一回八卦阵（从东边的石室进去）"
msgstr ""

msgid "大厅里还有一个人：绝尘子的首徒了尘。他一直在看你。问他「山洞」。"
msgstr ""

msgid "了尘说：师父知道洞里有东西。阵守得住石室，他就不管。"
msgstr ""

msgid "了尘说起师父的时候，一直看着佛像下的绝尘子，话没有说完。问他「师父」。"
msgstr ""

msgid "了尘说起了三十年前：他是山烟寺的小沙弥，跟着玄尘师叔走出了山门。玄尘，就是师父。他要回山烟寺去。"
msgstr ""

msgid "问绝尘子「玄尘」。"
msgstr ""

msgid "绝尘子认了：「玄尘。……那个名字三十年没人叫了。」了尘走到佛像前，跪了下来。"
msgstr ""

msgid "了尘跪在佛像前，等师父一句话。（话听了一半就走开的：守阵问绝尘子「守阵」，下山问了尘「下山」。）"
msgstr ""

msgid "了尘说他想下山，回流云轩救人。绝尘子说可以把阵推到洞口。他回过头来问你。"
msgstr ""

msgid "守阵（问绝尘子「守阵」）：了尘留下，八卦阵推到青石村北边的洞口，那里从此不进鬼卒；绝尘子肯教外人奇门遁甲；虹台上绝尘子下山一回，投旧盟主。下山（问了尘「下山」）：了尘回山烟寺流云轩救人，肯教外人金刚杖法；虹台上了尘替绝尘派上台，投颜违。两边绝尘派的弟子都晋执事。"
msgstr ""

msgid "你劝了尘留下。绝尘子把八卦阵推到了青石村北边的洞口，山洞里的东西再也出不来了。"
msgstr ""

msgid "陪绝尘子把八卦阵推到了青石村的洞口"
msgstr ""

msgid "了尘拜别了师父，下山回了日照山的流云轩。「出了阵，就是世事。」"
msgstr ""

msgid "送了尘出了八卦阵，回山烟寺流云轩救人"
msgstr ""

msgid "正月十七 · 虹台大会"
msgstr ""

msgid "正月十七，九派在水烟阁外的虹台推选武林盟主。九派各一票，过半才换人；那天山下会出事，你只管得了一件。"
msgstr ""

msgid "已表态"
msgstr ""

msgid "投颜违"
msgstr ""

msgid "过半（五派）才换盟主"
msgstr ""

msgid "听你的"
msgstr ""

msgid "五派听你的，你才站得出来"
msgstr ""

msgid "那天山下：神教的杀手会截山烟寺的轿子（不管，山烟寺不来）"
msgstr ""

msgid "那天山下：逆灵宫的余孽会烧葬剑亭（不管，茅山不来）"
msgstr ""

msgid "那天山下：颜违的人会堵封山的路（不管，封山不来）"
msgstr ""

msgid "那天山下：兵部会「请」骆云舟喝茶（不管，步玄派不来）"
msgstr ""

msgid "那天山下：照现在的样子，太平"
msgstr ""

msgid "封山剑派：还没表态"
msgstr ""

msgid "封山剑派：等盟主回来"
msgstr ""

msgid "封山剑派：投颜违——颜违许了北宗一个座"
msgstr ""

msgid "封山剑派：听你的"
msgstr ""

msgid "天邪派：还没表态"
msgstr ""

msgid "天邪派：投颜违"
msgstr ""

msgid "天邪派：等盟主回来"
msgstr ""

msgid "天邪派：听你的"
msgstr ""

msgid "振远镖局：还没表态"
msgstr ""

msgid "振远镖局：投颜违——旧案到此为止"
msgstr ""

msgid "振远镖局：投旧盟主——旧案查到底"
msgstr ""

msgid "振远镖局：听你的"
msgstr ""

msgid "茅山派：还没表态"
msgstr ""

msgid "茅山派：投颜违——主剿"
msgstr ""

msgid "茅山派：投旧盟主——北麓的人交茅山看着"
msgstr ""

msgid "茅山派：听你的"
msgstr ""

msgid "晚月庄：还没表态"
msgstr ""

msgid "晚月庄：投旧盟主——封地照旧"
msgstr ""

msgid "晚月庄：投颜违——逐神教"
msgstr ""

msgid "晚月庄：听你的"
msgstr ""

msgid "山烟寺：还没表态"
msgstr ""

msgid "山烟寺：投颜违——逐神教"
msgstr ""

msgid "山烟寺：投旧盟主——容神教"
msgstr ""

msgid "山烟寺：投旧盟主——收了西来的经"
msgstr ""

msgid "山烟寺：听你的"
msgstr ""

msgid "步玄派：还没表态"
msgstr ""

msgid "步玄派：投颜违——京城随朝廷"
msgstr ""

msgid "步玄派：投旧盟主——兵部的旧案查到底"
msgstr ""

msgid "步玄派：听你的"
msgstr ""

msgid "花紫会：还没表态"
msgstr ""

msgid "花紫会：投颜违——吃官饭"
msgstr ""

msgid "花紫会：投旧盟主——怕官"
msgstr ""

msgid "花紫会：听你的"
msgstr ""

msgid "绝尘派：还没表态"
msgstr ""

msgid "绝尘派：不问世事，不来"
msgstr ""

msgid "绝尘派：下山来，投旧盟主"
msgstr ""

msgid "绝尘派：了尘替师父来，投颜违——鬼卒要剿"
msgstr ""

msgid "绝尘派：听你的"
msgstr ""

msgid "正月十七，九派在水烟阁外的虹台推选武林盟主：颜违、旧盟主（卫沧澜回来了就是他，没回来就是那把空椅子），或者你。湖底的事了了，才会开会。各派的票跟着你做过的事走——封山、天邪看那两条线走到哪一边。"
msgstr ""

msgid "湖底的事了了。正月十七的虹台大会，照旧要开。"
msgstr ""

msgid "回雪亭镇的饮风客栈。店小二那里有一封给你的帖子。"
msgstr ""

msgid "饮风客栈的店小二递来一张请柬：正月十七，水烟阁外虹台。"
msgstr ""

msgid "上虹台之前，九派可以各走一趟：问各派掌门「虹台」，听他们这一票投谁、为什么；话里留了余地的，还可以请他改一改（先确认）。封山剑派——雪亭镇淳风武馆的柳淳风（跟了北宗的，问内院的柳绘心）；天邪派——水烟阁正厅的潘军禅；振远镖局——绮云镇的陈剑秋；茅山派——灵心观的林忌；晚月庄——庄主蓝止萍；山烟寺——住持玄智和尚；步玄派——乔阴县城的骆云舟；花紫会——乔阴的陆得财；绝尘派——青石村的绝尘子（了尘下了山的，问日照山流云轩的了尘）。虹台在水烟阁葬剑亭往南的石阶上；人到了，在擎天柱前「入席」（先确认：入了席就不能再游说、改票）。"
msgstr ""

msgid "正月十七，你上了虹台。"
msgstr ""

msgid "正月十七，虹台上：山下出了事，你只来得及管一件——没管的那一派上不了虹台。九派到齐了唱票，过半（五票）才换盟主。灭了侮天鬼、又有五派听你的，你也可以站出来。人走开了，回擎天柱前「入席」接着开。"
msgstr ""

msgid "虹台上散了会。"
msgstr ""

msgid ""
"一把粗制滥造的长剑，把手部份用布缠绕了好几圈以防止武器脱手。\n"
msgstr ""

msgid "短剑"
msgstr "Короткий меч"

msgid ""
"一把粗制滥造的短剑，把手部份用布缠绕了好几圈以防止武器脱手。\n"
msgstr ""

msgid "皮衣"
msgstr "Кожаная куртка"

msgid "太阴八卦袍"
msgstr "Халат Великой Инь с триграммами"

msgid "一具已经腐朽的骸骨"
msgstr "Давно истлевший скелет"

msgid ""
"一具已经腐朽的骸骨，靠着石壁坐着，骨头上还挂着几片烂成灰褐色的衣料。身量矮小，牙齿齐全，骨龄不过三十；手边没有剑，也没有刀。石壁上的字自称南危水，说埋骨于此——可水烟阁的五长老南危水，是个高大的老人。\n"
msgstr ""

msgid "具"
msgstr "тело"

msgid "鬼头刀"
msgstr "Палаческий тесак"

msgid ""
"这是一把沈重的鬼头刀，刀柄上雕著 一个丑陋可怖的鬼头正裂开了嘴大笑。\n"
msgstr ""

msgid "狼皮披风"
msgstr "Плащ из волчьей шкуры"

msgid "竹管"
msgstr "Бамбуковая трубка"

msgid ""
"一根约两寸多长的竹管，上面戳了三个小孔，也许可以用来吹奏？\n"
msgstr ""

msgid "过招要旨"
msgstr "Наставление по поединкам"

msgid ""
"这是一本介绍过招时如何拆招卸力的书籍。\n"
"对练武人来说是本不可多得的珍宝。\n"
msgstr ""

msgid "夜行衣"
msgstr "Одежда ночного лазутчика"

msgid ""
"这是一件夜行人用来掩藏行踪的黑色紧身衣。\n"
msgstr ""

msgid "飞刀"
msgstr "Метательный нож"

msgid ""
"飞刀是一种十分轻、锐利的匕首，用来当作暗器使用。\n"
msgstr ""

msgid "土匪探哨"
msgstr "Разбойник-лазутчик"

msgid ""
"这人满脸匪气，一付百无聊赖的模样，令人望而生厌。\n"
msgstr ""

msgid "土匪"
msgstr "Разбойник"

msgid ""
"这家伙长得高高瘦瘦，脸色苍白，一付无精打采的样子。\n"
msgstr ""

msgid ""
"这家伙又矮又胖，圆滚滚的眼珠子在满脸肥肉中骨碌碌地转来转去。\n"
msgstr ""

msgid "黑冠巨蟒"
msgstr "Черноголовый питон"

msgid ""
"一只乌黑油亮的巨蟒，头上生著一个大肉瘤。\n"
msgstr ""

msgid "躯干"
msgstr "Туловище"

msgid ""
"这个老头子正对著你龇牙裂嘴，他看起来已经完全疯了。\n"
msgstr ""

msgid ""
"一只凶猛的狼狗，一只独眼正恶狠狠地瞪著你。\n"
msgstr ""

msgid "后脚"
msgstr "Задняя лапа"

msgid ""
"狼狗用一只独眼恶狠狠地瞪著你。\n"
msgstr ""

msgid ""
"一只翩翩起舞的小蝴蝶哦! \n"
msgstr ""

msgid "翅膀"
msgstr "Крылья"

msgid ""
"蝴蝶拍动著翅膀! \n"
msgstr ""

msgid ""
"蝴蝶停在花上吸花蜜。 \n"
msgstr ""

msgid "土匪喽罗"
msgstr "Подручный разбойников"

msgid ""
"这家伙满脸横肉，一付凶神恶煞的模样，令人望而生畏。\n"
msgstr ""

msgid ""
"土匪喽罗横刀拦住去路，喝道：站住！要过老松寨，留下十两银子买路钱！\n"
msgstr ""

msgid "十两银子，一个子儿不能少。拿来！"
msgstr ""

msgid "老松寨是常老大的寨子，泼风刀王常老大，听过没有？想进去，先留下买路钱。"
msgstr ""

msgid "前些天是来过一个黑衣黑冠的道士，拿一块金牌买了路，往里头去了。你要问，问寨主去——先留下买路钱。"
msgstr ""

msgid "叫阵"
msgstr ""

msgid "叫阵是跟常老大单打独斗——寨里的人不插手，但常老大的泼风刀下，没几个人站得住。要叫阵吗？"
msgstr ""

msgid "叫过了还叫？聚义厅在东头，常老大等着你。"
msgstr ""

msgid "好大的口气！"
msgstr ""

msgid "朝寨子里扯着嗓子喊：有人叫阵——！"
msgstr ""

msgid "进去吧，聚义厅在东头。常老大一个人等你，寨里的弟兄不插手。"
msgstr ""

msgid "钱已经交过了，进去吧。"
msgstr ""

msgid ""
"土匪喽罗掂了掂银子，咧嘴一笑：算你识相。进去吧，寨里的弟兄不会难为你。\n"
msgstr ""

msgid ""
"土匪喽罗往地上啐了一口：打发叫花子呢？十两银子，少一个子儿都不行！\n"
msgstr ""

msgid ""
"这家伙眼神凶恶，一双精光四射的眼珠正盯著你的脖子。\n"
msgstr ""

msgid ""
"\n"
"土匪首领阴恻恻地说道：这种三脚猫的功夫也敢上老松寨来撒野？！\n"
msgstr ""

msgid ""
"\n"
"土匪首领说道：去你的，老子今天要剁下你的头来练练毒爪！\n"
msgstr ""

msgid ""
"\n"
"土匪首领虎吼一声，欺身上前。\n"
msgstr ""

msgid "那道士的事，寨主自己会说。聚义厅在东头。"
msgstr ""

msgid "泼风刀王"
msgstr "Царь сабли бурного ветра"

msgid "老松寨寨主"
msgstr ""

msgid "黑衣黑冠的道士？来过。拿一块金牌子买的路——金子打的，比你那十两银子值钱多了。"
msgstr ""

msgid "他问我瀑布后头的山洞怎么走。老子这寨子什么钱都收，收了钱就指路：往东过石桥，瀑布旁边有藤蔓，荡过去就是。"
msgstr ""

msgid "他抱着个石匣子，宝贝得很。你要找他，也往瀑布去吧，老子不拦你。"
msgstr ""

msgid "你是什么东西，也敢问老子的事？"
msgstr ""

msgid "石匣"
msgstr ""

msgid "石匣？那道士抱着的那个？老子没兴趣，老子只收钱。"
msgstr ""

msgid "老松寨是老子的寨子。进寨的规矩只有一条：什么钱都收。"
msgstr ""

msgid ""
"这个男人看起来鬼鬼祟祟的，想必不是什么好东西。\n"
msgstr ""

msgid "哈哈哈哈哈哈。"
msgstr ""

msgid "金银花蛇"
msgstr "Жимолостная змея"

msgid ""
"一支昂首吐信的毒蛇正虎视眈眈地盯著你。\n"
msgstr ""

msgid "你觉得被咬中的地方一阵麻痒！"
msgstr ""

msgid "粗布衣"
msgstr "Рубаха из грубого холста"

msgid "蓑衣"
msgstr "Соломенный плащ"

msgid "草鞋"
msgstr "Соломенные сандалии"

msgid "铁斧"
msgstr "Железный топор"

msgid ""
"这是一把沈重的铁斧，用来砍柴。\n"
msgstr ""

msgid "铁锤"
msgstr "Железный молот"

msgid ""
"这是一把沈重的铁锤，打造的相当坚实。\n"
msgstr ""

msgid "功德箱"
msgstr "Ящик для пожертвований"

msgid ""
"这是寺庙接受善男信女捐献香油钱的功德箱，你可以把想捐的钱\n"
"放进去。\n"
msgstr ""

msgid "竹剑"
msgstr "Бамбуковый меч"

msgid ""
"这是一把练习剑法用的竹剑，剑尖处用布包了起来以免误伤同伴。\n"
msgstr ""

msgid "粉红绸衫"
msgstr "Розовая шёлковая кофта"

msgid ""
"这件粉红色的绸衫上面绣著几只黄鹊，闻起来还有一股淡香。\n"
msgstr ""

msgid "绣花小鞋"
msgstr "Расшитые туфельки"

msgid "残破刀谱"
msgstr "Истрёпанное руководство по сабле"

msgid ""
"这似乎是一本什么刀谱的前几页，虽然并没有关于招式的详细解说，可是\n"
"前面有关刀法的总纲与精义倒是不少。\n"
msgstr ""

msgid ""
"这是一位来雪亭镇的外地旅客.\n"
msgstr ""

msgid ""
"一只浑身脏兮兮的野狗。\n"
msgstr ""

msgid ""
"野狗用鼻子闻了闻你的脚。\n"
msgstr ""

msgid ""
"野狗在你的脚边挨挨擦擦的，想讨东西吃。\n"
msgstr ""

msgid ""
"野狗对著你摇了摇尾巴。\n"
msgstr ""

msgid ""
"野狗用后腿抓了抓自己的耳朵。\n"
msgstr ""

msgid "高兴地汪汪叫了起来。"
msgstr ""

msgid "庙祝"
msgstr "Храмовый служитель"

msgid ""
"这个老人看起来七十多岁了，看著他佝偻的身影，你忽然觉得心情沈重了下来。\n"
msgstr ""

msgid "这位$RESPECT，捐点香火钱积点阴德吧。"
msgstr ""

msgid "多谢这位$RESPECT，神明一定会保佑你的。"
msgstr ""

msgid "醉汉"
msgstr "Пьяница"

msgid ""
"一个喝得醉醺醺的年轻人.....\n"
msgstr ""

msgid "酒..... 给我酒...."
msgstr ""

msgid "去去去去去.. 我又不是收破烂的..."
msgstr ""

msgid "真没诚意, 剩么一点... "
msgstr ""

msgid "多谢, 不过我还有酒... "
msgstr ""

msgid ""
"听说沈记商行有在卖蒙汗药...\n"
msgstr ""

msgid ""
"嗯.. 你是想问我玉佩的事吧? 我卖给沈老板了, 那东西不吉祥...\n"
msgstr ""

msgid "多谢啦....."
msgstr ""

msgid ""
"这个人不但自己收破烂，身上也穿得破烂不堪。\n"
msgstr ""

msgid ""
"收破烂的吆喝道：收～破～烂～哪～\n"
msgstr ""

msgid ""
"收破烂的嘴里嘟哝著，不知道说些什么。\n"
msgstr ""

msgid ""
"收破烂的伸手捉住了身上的虱子，一脚踩得扁扁的。 \n"
msgstr ""

msgid "$RESPECT饶命！小的这就离开！"
msgstr ""

msgid "多谢这位$RESPECT！"
msgstr ""

msgid "门房"
msgstr "Привратник"

msgid ""
"刘安禄是淳风武馆的门房，除了馆主柳淳风没有人知道他的出身来历，只知\n"
"到他的武艺不弱，一手快刀在这一带罕有敌手。\n"
msgstr ""

msgid ""
"刘安禄说道：你当这里是什么地方，敢来这里撒野？\n"
msgstr ""

msgid ""
"刘安禄说道：想我堂堂....呃....连我这个淳风武馆的小小的门房都可以收拾你！\n"
msgstr ""

msgid ""
"刘安禄忽然挥出一刀，招数精奇，但是刀到中途忽然像是想起什么，急忙收招。\n"
msgstr ""

msgid ""
"刘安禄说道：你快走吧，就算我输了你啦....\n"
msgstr ""

msgid "看见你，放下了手里的扫帚。"
msgstr ""

msgid "李教头同我说了。……那句话是你替我挡的。"
msgstr ""

msgid "我欠你一句话。哪天你用得着野羊山的人，开口。"
msgstr ""

msgid "背着一个青布包袱，望着往野羊山去的那条路。"
msgstr ""

msgid "话是你说的。我不怨你——五年前我就该走。"
msgstr ""

msgid "馆主留我到今天，是他的情分；武馆的规矩，是老馆主的。两样都没错。"
msgstr ""

msgid "刘老三"
msgstr ""

msgid "刘安禄的来历不简单。当面问出这个名字，是把事情挑明——他未必肯善罢甘休。要问吗？"
msgstr ""

msgid "……老子认了，还问什么。你要问野羊寨的事，问大寨主。"
msgstr ""

msgid "老子就是血手刘三，血手刘三就是你老子！纳命来！"
msgstr ""

msgid "我...不知道！"
msgstr ""

msgid "刘安禄眼中突然放出异样的光芒，颤声说道：看来...你都知道了？"
msgstr ""

msgid "刘安禄大喝一声，叫道：既然如此，老子今天豁出去了，纳命来！"
msgstr ""

msgid "刘安禄使开单刀，招数精奇，沈猛狠辣，和刚才简直判若两人！"
msgstr ""

msgid "血手刘三"
msgstr ""

msgid "大寨主"
msgstr ""

msgid "刘安禄沉默了半晌，低声道：野羊寨的大寨主霍铮，是我拜过把子的大哥。"
msgstr ""

msgid "半年前，北麓那座黑砖道观的道士上山要人。大哥跟他们走了，再没回来。那伙人自称逆灵宫。"
msgstr ""

msgid "黄霸——老三——把寨子接了过去，每年给道观纳供，金帛、牲口，要什么送什么。我不肯伺候那群臭道士，就下了山。"
msgstr ""

msgid "纳供的车这几天就上山。到了山路转角，道士从北边山壁的裂口把东西吊上去——道观就在裂口上头。你要去，替我看一眼大哥。"
msgstr ""

msgid "……大哥的事，等你知道野羊山北麓是个什么地方再说。"
msgstr ""

msgid "大寨主？我是淳风武馆的门房，哪来的什么大寨主。"
msgstr ""

msgid "野羊山寨二寨主"
msgstr ""

msgid ""
"刘安禄望着北边，低声道：大哥……\n"
msgstr ""

msgid ""
"刘安禄叫道：老子已经认输了，你还要怎样！\n"
msgstr ""

msgid ""
"你看到一位身材高大的汉子，正在辛苦地操练著。\n"
msgstr ""

msgid "拳法教练"
msgstr ""

msgid ""
"李火狮是个孔武有力的大块头，他正在训练他的弟子们习练「柳家拳\n"
"法」。\n"
msgstr ""

msgid ""
"这里当然是淳风武馆，不然还是哪里？\n"
msgstr ""

msgid ""
"在下姓李，名字就叫火狮，人称李教头的便是我。\n"
msgstr ""

msgid "柳家拳法"
msgstr ""

msgid ""
"哦....说来惭愧，小弟这套拳法还没学得到家, 柳馆主就教我在这里传艺。\n"
msgstr ""

msgid "话是你说的，馆主也认了。老刘回了野羊山——这扇门，他不会再进了。"
msgstr ""

msgid "话是你说的，馆主也认了。武馆的规矩，谁也不能例外。……老刘走的时候，把门房的钥匙擦得干干净净。"
msgstr ""

msgid "你说认错了人，我就当是认错了人。弟子们那边，我去压。"
msgstr ""

msgid "老刘前些日子不辞而别，门房的桌子空着。偏偏那几个骗子又在镇上嚷，说他是野羊山的二寨主。"
msgstr ""

msgid "弟子们都在猜。有人说该报官，有人说该上野羊山问个明白。"
msgstr ""

msgid "馆主不开口。骗子是你打发的——老刘到底是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr ""

msgid "那天你和老刘在门口动了刀，弟子们都看见了——那套刀法，不是一个门房使得出来的。"
msgstr ""

msgid "偏偏那几个骗子又在镇上嚷，说他是野羊山的血手刘三。"
msgstr ""

msgid "馆主不开口。你和他交过手，你最清楚——他是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr ""

msgid "那几个骗子在镇上嚷，说咱们门房老刘是野羊山的二寨主，叫什么血手刘三。"
msgstr ""

msgid "老刘在武馆五年，扫地、守门、记账，没出过一回错。可弟子们听见了，就得有个说法：武馆不留匪，这是老馆主立的规矩。"
msgstr ""

msgid "馆主不开口。骗子是你打发的，话是你听见的——他是什么人，你给大伙一句话：说破，还是替他瞒下来。"
msgstr ""

msgid "门房老刘？在武馆五年了，话不多，人勤快。"
msgstr ""

msgid "说破门房的来历"
msgstr ""

msgid ""
"告诉李火狮：门房刘安禄就是野羊山的血手刘三。\n"
"武馆不留匪——这句话出口，武馆从此没有他的位置，弟子们会记得是你说的。\n"
"要说破吗？"
msgstr ""

msgid "你已经说过了。"
msgstr ""

msgid "你前头说的是认错了人。话出了口，就别改了。"
msgstr ""

msgid "的脸沉了下来。"
msgstr ""

msgid "……血手刘三。五年，我天天和他一张桌子吃饭。"
msgstr ""

msgid "规矩是老馆主立的，我去回馆主。你做得对——只是往后弟子们看你，眼神会不一样。"
msgstr ""

msgid "说破什么？"
msgstr ""

msgid "替门房瞒下来"
msgstr ""

msgid ""
"告诉李火狮：那伙骗子认错了人。\n"
"武馆里没人再提这件事，刘安禄欠你一句话；可这句话从此算在你头上，日后再有人认出他，弟子们先问的是你。\n"
"要替他瞒吗？"
msgstr ""

msgid "认错了人。我已经同弟子们说过了。"
msgstr ""

msgid "话已经出了口，瞒不回去了。"
msgstr ""

msgid "盯着你看了一会儿，慢慢点了点头。"
msgstr ""

msgid "认错了人。好，我就这么同弟子们说。"
msgstr ""

msgid "你担着这句话，就担到底。"
msgstr ""

msgid "瞒什么？"
msgstr ""

msgid "点了点头。"
msgstr ""

msgid "进招吧。"
msgstr ""

msgid "馆主吩咐过，不许和来这里的客人过招。"
msgstr ""

msgid "对不起，这位$RESPECT，您不是我们武馆的弟子。"
msgstr ""

msgid "李火狮不愿意教你拳法。"
msgstr ""

msgid ""
"你看到一位面色黝黑的农夫。\n"
msgstr ""

msgid ""
"农夫叫道：杀人哪！杀人哪！\n"
msgstr ""

msgid ""
"农夫叫道：有土匪哪！光天化日下打劫哪！\n"
msgstr ""

msgid ""
"一只浑身脏兮兮的野狗，一双眼睛正恶狠狠地瞪著你。\n"
msgstr ""

msgid "教书先生"
msgstr ""

msgid ""
"魏无极是个博学多闻的教书先生，他年轻时曾经中过举人，但是\n"
"因为生性喜爱自由而不愿做官，魏无极以教书为业，如果你付他\n"
"一笔学费，就可以成为他的弟子学习读书识字。\n"
msgstr ""

msgid "学费"
msgstr ""

msgid "嗯 ... 读书识字是做人的第一步。"
msgstr ""

msgid "学好了读书识字的本领，胜过于百万的家财。"
msgstr ""

msgid "所以说学问是金钱买不到的。"
msgstr ""

msgid "虽然学问是无价的，不过如果你有心的话 ..."
msgstr ""

msgid "只要五两银子。"
msgstr ""

msgid "手头紧？街东头的谷场正缺短工，干一回给一两。"
msgstr ""

msgid "对，读书识字。"
msgstr ""

msgid "哦 ... 你是说野羊山寨的二寨主，人称血手刘三的刘安禄吗？"
msgstr ""

msgid "他又出来做恶了？"
msgstr ""

msgid "你带我去见他，让我跟他说几句话。"
msgstr ""

msgid "点了点头，说道：哦，向你这么有心的学生还真是不多见，好好努力将来必定前途无量，谢了。"
msgstr ""

msgid "点了点头，说道：很好，从今天起你随时可以来问我有关读书识字的任何问题。"
msgstr ""

msgid "你的诚意不够，这钱还是拿回去吧。"
msgstr ""

msgid "咦？我不记得收过你这个学生啊...."
msgstr ""

msgid ""
"你看到一个粗壮的大汉，身上穿著普通樵夫的衣服。\n"
msgstr ""

msgid ""
"樵夫说道：野羊山那群臭道士真是该千刀万剐....\n"
msgstr ""

msgid ""
"樵夫说道：不知道那些牛鼻子施了什么妖法，前天回家差点迷了路。\n"
msgstr ""

msgid ""
"樵夫说道：唉....日子越来越不好过罗。\n"
msgstr ""

msgid "雪亭驿长"
msgstr ""

msgid ""
"杜宽担任雪亭驿的驿长已经有十几年了，虽然期间有几次升迁的\n"
"机会，但是他都因为舍不得离开这个小山村而放弃了，雪亭镇的\n"
"居民对杜宽的风评相当不错，常常会来到驿站跟他聊天。\n"
msgstr ""

msgid "驿站"
msgstr ""

msgid "是啊... 这里就是雪亭驿，你要寄信吗？"
msgstr ""

msgid "官府的信差都改走飞鸢栈道了，咱这儿如今只剩百姓的信。"
msgstr ""

msgid "送信"
msgstr ""

msgid "往后有信，还找你。"
msgstr ""

msgid "送到了？好，说好的脚钱。往后有信，还找你。"
msgstr ""

msgid "信丢了？……还好驿里留着底子，我再誊一封。这回别再弄丢了，陈镖头的镖局就在绮云镇街上。"
msgstr ""

msgid "信送到了么？陈镖头的镖局就在绮云镇街上。"
msgstr ""

msgid "正好有封信，要送到绮云镇振远镖局陈镖头手里。驿里就我一个走不开——你若肯跑这一趟，回来给你一两脚钱。出镇往南过卧龙岗，岗上有强人，别跟他们纠缠，走你的路就是。"
msgstr ""

msgid "悬赏"
msgstr ""

msgid "门外那张榜是乔阴府发的悬赏。榜上的恶人要是教你拿住了，赏银照榜发——拿不住也别逞强。"
msgstr ""

msgid "老鼠"
msgstr "Крыса"

msgid ""
"一只贼头贼脑的大老鼠。\n"
msgstr ""

msgid "店小二"
msgstr "Трактирный слуга"

msgid ""
"这位店小二正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n"
msgstr ""

msgid "小二哥"
msgstr "любезный"

msgid "笑咪咪地说道：这位$RESPECT，进来喝杯茶，歇歇腿吧。"
msgstr " расплывается в улыбке: «Заходите, $RESPECT, выпейте чайку, дайте ногам отдых!»"

msgid "用脖子上的毛巾抹了抹手，说道：这位$RESPECT，请进请进。"
msgstr " вытирает руки полотенцем, что висит у него на шее: «Милости просим, $RESPECT, милости просим!»"

msgid "这位$RESPECT，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。"
msgstr "Заходите, $RESPECT, пропустите пару чарок нашего красного — только на днях из погреба откупорили!"

msgid "鸡腿骨头别扔，东街那两条野狗见了骨头就跟人走，怪得很。"
msgstr "Куриные кости не выбрасывайте. Две бродячие собаки с Восточной улицы за костью за кем угодно увяжутся — чудно, право слово."

msgid "哟，可算清净了！来，刚烤好的鸡腿，小店的一点心意。"
msgstr "Ох, наконец-то тихо! Вот, извольте — куриная ножка, только с огня. Угощение от заведения."

msgid "唉，别提了。楼上几间客房闹老鼠，客人嫌吵，掌柜的又舍不得请人。这位$RESPECT要是肯上去收拾收拾，小店请您吃顿热的。"
msgstr "Эх, и не спрашивайте. Наверху в комнатах крысы завелись, гости жалуются — шумно, а хозяин скупится нанять кого. Если бы вы, $RESPECT, поднялись да навели там порядок, мы бы вас горячим накормили."

msgid "楼上"
msgstr ""

msgid "白衣人"
msgstr ""

msgid "多亏了您！……他们把您楼上那屋翻了个底朝天，问那只匣子问了三遍，小的说不知道。"
msgstr "Если бы не вы! ...Они вашу комнату наверху всю вверх дном перевернули, про тот ларец три раза допытывались, а я — знать не знаю."

msgid "掌柜的说了：楼上那间屋给您留着，往后不收钱。您是咱们雪亭的人。"
msgstr "Хозяин велел передать: та комната наверху остаётся за вами, и денег за неё больше не возьмём. Вы теперь свой человек в Сюэтине."

msgid "捂着青了半边的脸，压低了声音。"
msgstr " прикрывает ладонью наполовину посиневшее лицо и понижает голос."

msgid "两个白衣的官爷，拿着一张画像，说您是什么逆灵宫的同党……就在里头翻呢！掌柜的拦了一下，挨了一脚。"
msgstr "Двое господ офицеров в белом, с портретом, говорят, будто вы заодно с каким-то там дворцом Нилин... Там, внутри, всё перерывают! Хозяин было заступился — так ему пинка дали."

msgid "白衣人？前些日子广场上那队官爷，都是穿白的。"
msgstr "Люди в белом? Да тот отряд господ офицеров, что на днях стоял на площади, — все в белом ходили."

msgid "官爷"
msgstr ""

msgid "外头广场上来了官爷，一队白衣的武官，还有两位老者坐着，说是大内来的高手。这位$RESPECT要是闲，去瞧瞧热闹也好。"
msgstr "На площади господа офицеры объявились: целый отряд в белом да два старика с ними сидят — говорят, мастера из самого дворца. Будет у вас, $RESPECT, свободная минутка — сходите поглядите, любопытно."

msgid "小哥您有所不知，这些个爷儿们是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的。他们等的白道长，便是咱们这附近有名的太乙观观主。"
msgstr "Вам-то невдомёк: эти господа по приказу самого государя едут в Ланьчэн, искать какой-то там меч, \"Вихревой блеск\", что ли. А даос Бай, которого они ждут, — настоятель даосского монастыря Тайи, тут у нас неподалёку, человек известный."

msgid "$RESPECT，您来的那天傍晚说是来投淳风武馆的，饭没吃完就困得睁不开眼，是小的扶您上的楼。这封信落在桌上了，小的一直替您收着呢。"
msgstr "В тот вечер, как вы приехали, $RESPECT, вы сказали, что пришли проситься в ученики в школу Чуньфэн, а сами и ужин не доели — так глаза слипались; я вас наверх и отвёл. Вот это письмо на столе осталось, я его всё время для вас берёг."

msgid "从柜台底下摸出一封折了又折的信，递给你。"
msgstr " достаёт из-под прилавка письмо, сложенное в несколько раз, и протягивает вам."

msgid "对了，外头广场上来了官爷，一队白衣的武官，还有两位老者坐着，说是大内来的高手。$RESPECT要是闲，去瞧瞧热闹也好。"
msgstr "Да, кстати: на площади господа офицеры объявились — целый отряд в белом да два старика с ними сидят, говорят, мастера из самого дворца. Будет у вас, $RESPECT, свободная минутка — сходите поглядите, любопытно."

msgid "这些个爷儿们是奉了咱们皇上的命令，要去岚城找一把叫做什麽『旋芒宝剑』的。他们等的白道长，便是咱们这附近有名的太乙观观主。"
msgstr "Эти господа по приказу самого государя едут в Ланьчэн, искать какой-то там меч, \"Вихревой блеск\", что ли. А даос Бай, которого они ждут, — настоятель даосского монастыря Тайи, тут у нас неподалёку, человек известный."

msgid "请柬"
msgstr ""

msgid "请柬早给您了。正月十七，水烟阁外头的虹台——您可别忘了。"
msgstr "Приглашение я вам уже отдал. Семнадцатого числа первой луны, на Радужной террасе у павильона Шуйянь — смотрите не забудьте."

msgid "哟，您可回来了！前两天水烟阁差人送来一张帖子，指名道姓给您的。"
msgstr "Ох, наконец-то вы вернулись! На днях из павильона Шуйянь человека прислали с приглашением — на ваше имя, лично."

msgid "从柜台底下摸出一张大红帖子，在围裙上擦了擦手，双手递给你。"
msgstr " достаёт из-под прилавка большое приглашение на красной бумаге, вытирает руки о фартук и обеими руками протягивает вам."

msgid "请柬？没有您的信啊。"
msgstr "Приглашение? Нет, вам писем не было."

msgid "看见你进门，眼睛一亮，从柜台后头钻了出来。"
msgstr " завидев вас в дверях, весь сияет и выскакивает из-за прилавка."

msgid "$RESPECT，您可回来了！前两天水烟阁差人送来一张帖子，指名道姓给您的。"
msgstr "Наконец-то вы вернулись, $RESPECT! На днях из павильона Шуйянь человека прислали с приглашением — на ваше имя, лично."

msgid "正月十七，水烟阁外头的虹台，九派选盟主——小的长这么大，还没见过咱们雪亭的人拿这种帖子。"
msgstr "Семнадцатого числа первой луны, на Радужной террасе у павильона Шуйянь, девять школ выбирают главу союза. Я сколько живу, а не видал, чтобы кому из наших, сюэтинских, такое приглашение приносили."

msgid "钱庄老板"
msgstr ""

msgid ""
"安惜迩是个看起来相当斯文的年轻人，不过有时候会有些心不在焉的\n"
"样子，雪亭镇的居民对安惜迩都觉得有点神秘莫测的感觉，为什么他\n"
"年纪轻轻就身为一家大钱庄的老板，还有他一身稀奇古怪的武功，所\n"
"幸安惜迩似乎天性恬淡，甚至有些隐者的风骨，只要旁人不去惹他，\n"
"他也绝不会去招惹旁人。\n"
msgstr ""

msgid ""
"安惜迩似笑非笑地望著你，脸上的神气古理古怪，不知道在想些什么？\n"
msgstr ""

msgid ""
"安惜迩的身影晃了一下，似乎在你身上各处大穴摸了一下，不过也许是你的错觉。\n"
msgstr ""

msgid ""
"安惜迩神情忽然严肃了起来，不过好像是在想自己的事，与你无关。\n"
msgstr ""

msgid ""
"安惜迩忽然呵呵呵地笑了起来，却不知道在笑些什么....\n"
msgstr ""

msgid "咦... 要打就真打吧，光是较量多没意思？"
msgstr ""

msgid ""
"王铁匠正用铁钳夹住一块红热的铁块放进炉中。\n"
msgstr ""

msgid ""
"小人姓王，单名一个恒字，可是小人西瓜大的字识不到一担，只有王字会写。\n"
msgstr ""

msgid ""
"这里是小人糊口的铺子，小人一家五口都住在后边的屋子。\n"
msgstr ""

msgid "锄头"
msgstr ""

msgid ""
"锄头... 抱歉，锄头已经卖光了...\n"
msgstr ""

msgid "铲子"
msgstr ""

msgid ""
"对不起，小人店里的铲子都给人订走了。\n"
msgstr ""

msgid ""
"铁锤？小人做的铁锤坚固又耐用，一把只要三百文钱。\n"
msgstr ""

msgid "杨掌柜"
msgstr "Хозяин Ян"

msgid ""
"杨掌柜是这附近相当有名的大善人，常常施舍草药给付不起药钱的穷人\n"
"。此外他的医术也不错，年轻时曾经跟著山烟寺的玄智和尚学医，一般\n"
"的伤寒小病直接问他开药吃比医生还灵。\n"
msgstr ""

msgid "治伤"
msgstr ""

msgid "这位$RESPECT，您看起来气色很好啊，不像有受伤的样子。"
msgstr ""

msgid "哦....我看看....只是些皮肉小伤，您买包金创药回去敷敷就没事了。"
msgstr ""

msgid "开药"
msgstr ""

msgid "麝香给你了。替我问玄智师父好。"
msgstr ""

msgid "玄智师父开的方子？我看看——附子、麝香、鬼臼。"
msgstr ""

msgid "脸色沉了下来。"
msgstr ""

msgid "鬼臼以毒攻毒……这是阴寒入骨的方子。乔阴那边，又不太平了？"
msgstr ""

msgid "从药柜最上头一格取下一个小罐，用桑皮纸包了一小包，递给你。"
msgstr ""

msgid "师父要的东西，不收钱。我年轻时跟着他学医三年，他教的头一句：药是凉的，人心得是热的。"
msgstr ""

msgid "山烟寺？我年轻时曾经跟著山烟寺的玄智和尚学医。玄智师父的医术，天底下没几个人比得上。"
msgstr ""

msgid ""
"柳绘心是淳风武馆馆主柳淳风的独生女。\n"
msgstr ""

msgid ""
"柳绘心秀眉微蹙，说道：喂！我哪里得罪你了？干嘛这样跟我拼死拼活？\n"
msgstr ""

msgid ""
"柳绘心不住地望著窗外：你还是快走吧，我没空陪你练功夫！\n"
msgstr ""

msgid "我每天夜里读一页。爹爹年轻的时候，字写得比现在放得开。"
msgstr ""

msgid "爹爹把它锁起来了，是不是？……他什么都锁起来。"
msgstr ""

msgid "爹爹在天驼关写过一卷书，我只听李教头提过一句。他从来不让我看。"
msgstr ""

msgid "北宗"
msgstr ""

msgid ""
"跟柳绘心立北宗：封山的剑往外传。\n"
"你转入封山剑派北宗，和她同辈；她把自己悟出来的「点」字诀教给你。柳淳风不再教你武功，「掌门传人」的名分没有了。这不算叛师：评价不清零，也不记背叛。封山在虹台上的那一票，会被颜违拿「给北宗一个座」来换（已经入了虹台的席的，这一票不再跟着变）。\n"
"这是封山这条线的大分裂，选了不能改。要跟她吗？"
msgstr ""

msgid "北宗现在有两个人了。"
msgstr ""

msgid "你选了爹爹那一边。我不怪你。"
msgstr ""

msgid "的眼圈红了一下，很快又忍了回去。"
msgstr ""

msgid "那北宗就有两个人了。"
msgstr ""

msgid "「点」字诀爹爹没教过我，是我自己看他练剑悟的：劲不在手臂上，在剑尖上。你看——"
msgstr ""

msgid "的细剑平平递出，剑尖在廊柱上一点，柱子背面迸出一小块木屑。"
msgstr ""

msgid "内力不够的时候别使，剑会脱手。我脱过好几回。"
msgstr ""

msgid "爹爹不会再教你了。对不起。……可是阿桂他们，往后也算你的师弟师妹。"
msgstr ""

msgid "北宗？绮云镇口的公告上还这么写呢。爹爹说那是旧名。"
msgstr ""

msgid "劲不在手臂上，在剑尖上。内力不够别使，剑会脱手。"
msgstr ""

msgid "爹爹练剑的时候，我在窗后头看过。"
msgstr ""

msgid "正月十七的事过去了。北宗的剑，照旧教人。"
msgstr ""

msgid "北宗这一票，正月十七照你说的投。"
msgstr ""

msgid "颜违许了北宗一个座。北宗能在虹台上坐下来，是你陪我走出来的——这一票投颜违，是说好了的。"
msgstr ""

msgid "把剑在膝上横过来，想了想。"
msgstr ""

msgid "可你要是想自己站出来，这一票我给你。"
msgstr ""

msgid "虹台？那是爹爹的事。"
msgstr ""

msgid ""
"请柳绘心把北宗这一票交给你：正月十七虹台上，封山的座听你的——颜违许的那个座还是北宗的，这一票不再投他。\n"
"要这么说吗？"
msgstr ""

msgid "封山那一票在爹爹手里。你去问他。"
msgstr ""

msgid "说过了。北宗听你的。"
msgstr ""

msgid "笑了一下。"
msgstr ""

msgid "好。北宗的座，听你的。"
msgstr ""

msgid "这是爹爹收起来的那一卷……你从哪里拿来的？还回去吧。"
msgstr ""

msgid ""
"把《悟疾风劲竹书》交给柳绘心。\n"
"她会头一回读到父亲年轻时写的字。书只有这一本，给出去就读不到了；柳淳风不会再见到它。\n"
"要交给她吗？"
msgstr ""

msgid "接过书，翻开第一页，手停住了。"
msgstr ""

msgid "「直竹贵地生，风吹动不止」……这是爹爹的字。他从来没给我看过。"
msgstr ""

msgid "「起迄中空立，随风飘不定」——原来他年轻的时候，也想过剑可以是弯的。"
msgstr ""

msgid "把书抱在怀里。"
msgstr ""

msgid "你……过两日到内院来。我给你看一样东西。别告诉爹爹。"
msgstr ""

msgid "这上头是……爹爹的名字？你先去见过爹爹再说吧。"
msgstr ""

msgid "北宗就我们两个人，打坏了谁教阿桂他们？"
msgstr ""

msgid "师姐！别整天想著练功嘛，我们去花园摘花儿玩嘛？"
msgstr ""

msgid "我才不要，你们去找李教头练吧！"
msgstr ""

msgid "爹爹说过，不能跟你们这些江湖人物比武过招。"
msgstr ""

msgid ""
"一个满脸风霜之色的老乞丐。\n"
msgstr ""

msgid ""
"乞丐说道：好心的大爷哪～ 赏我要饭的几文钱吧～\n"
msgstr ""

msgid ""
"乞丐懒洋洋地打了个哈欠。\n"
msgstr ""

msgid ""
"乞丐伸手捉住了身上的虱子，骂道：老子身上没几两肉，全叫你们给咬糜了。 \n"
msgstr ""

msgid "多谢这位$RESPECT，您好心一定会有好报的！"
msgstr ""

msgid ""
"逄义是封山派中和柳淳风同辈的弟子，但是生性好赌的他并不受师父\n"
"及同门师兄弟的喜爱，因此辈分虽高，却未曾担任门中任何重要职务\n"
"。逄义经常外出，美其名曰：旅行，实则避债，碍于门规又不敢做那\n"
"打家劫舍的勾当，因此经常四处寻找赚钱发财的机会。\n"
msgstr ""

msgid "赚钱"
msgstr ""

msgid "真的？哪里有钱赚？"
msgstr ""

msgid "发财"
msgstr ""

msgid "发财我倒不敢想，只要有人肯雇用我，手边有几百两银子就好了。"
msgstr ""

msgid "是的，一天一百两银子，只要不违背侠义道，我可以做任何事。"
msgstr ""

msgid "柳淳风是在下同门师兄。"
msgstr ""

msgid "阁下如果也爱好此道，不如改天兄弟陪阁下玩几手？"
msgstr ""

msgid "牌你带回去交给师兄。我没脸拿。"
msgstr ""

msgid "手里的骰子掉在了桌上。"
msgstr ""

msgid "……是我的牌。"
msgstr ""

msgid "上个月手气背，欠了场子里一个姓罗的十二两。他不要银子，只要这块牌，说是拿去「挂两天」。我当他要个彩头。"
msgstr ""

msgid "他拿去雪亭收拜师钱？打的是师兄的旗号？"
msgstr ""

msgid "半天没说话，把面前剩的几个筹码推开了。"
msgstr ""

msgid "门规我没犯过——不偷不抢，不打家劫舍。可牌是我押出去的，这一条赖不掉。你带回去交给师兄，就说逄义认了。"
msgstr ""

msgid "什么腰牌？在下的腰牌好好地……"
msgstr ""

msgid "摸了摸腰间，没有说下去。"
msgstr ""

msgid ""
"你现在正站在雪亭镇南边的一家小客栈里，这家客栈虽小，却是方圆\n"
"五百里内最负盛名的一家，客栈的主人据说是一位云游四海的仙人，如果\n"
"你的福缘深厚的话，也许可以在这里遇到他。除此之外，来自各地的旅人\n"
"都喜欢聚集在这里交换旅途上的见闻，你也可以在这里打听到许多有趣的\n"
"消息。靠近门口的地方有一块乌木雕成的招牌。\n"
"西北边有一个红木门，门上泛著一层白色的光晕，一种令人感觉\n"
"很有力量，又很柔和的光芒。\n"
msgstr "Вы стоите в небольшом трактире на южной стороне городка Сюэтин. Трактир невелик, но на пятьсот ли в округе нет знаменитее. Говорят, хозяин его — бессмертный, что странствует по всем четырём морям, и если ваша Удача велика, вы, быть может, встретите его здесь. А ещё путники со всех концов любят собираться тут и делиться дорожными историями, так что и вы можете услышать немало любопытного. У самого входа висит вывеска чёрного дерева с названием «Иньфэн» — «Пьющий ветер». На северо-западе — дверь красного дерева; по ней разливается белое сияние, свет, в котором чувствуется и великая сила, и мягкость."

msgid ""
"这里是雪亭镇镇前广场的空地，地上整齐地铺著大石板。广场中央有\n"
"一个木头搭的架子，经过多年的风吹日晒雨淋，看来非常破旧。四周建筑\n"
"林立。往西你可以看到一间客栈，看来生意似乎很好。\n"
msgstr "Это площадь перед городком Сюэтин, ровно вымощенная большими каменными плитами. Посреди площади стоит деревянная стойка; за долгие годы ветров, солнца и дождей она совсем обветшала. Вокруг теснятся дома. На западе виден трактир — похоже, дела у него идут бойко."

msgid ""
"这里是雪亭镇的街道，往北是一个热闹的广场，南边是条小路通往\n"
"一座林子，东边则有一条小径沿著山腰通往山上，往西是一条比较窄的\n"
"街道，参差不齐的瓦屋之间传来几声犬吠。\n"
msgstr ""

msgid ""
"这是一条普通的黄土小径，弯弯曲曲往东一路盘旋上山，北边有\n"
"一间城隍庙，往西则是雪亭镇的街道。\n"
msgstr ""

msgid ""
"这是一条普通的黄土小径，小径往西南通往一处山间的平地，从这\n"
"里可以望见不少房屋错落在平地上，往北则一路上山。\n"
msgstr ""

msgid ""
"这是一条说宽不宽，说窄倒也不窄的山路，路面用几块生满青苔的\n"
"大石铺成，西面是一段坡地，从这里可以望见西边有几间房屋错落在林\n"
"木间，东面则是山壁，山路往西衔接一条黄土小径，往北则是通往山\n"
"上的石阶。\n"
msgstr ""

msgid ""
"这是一间十分老旧的城隍庙，在你面前的神桌上供奉著一尊红脸的城\n"
"隍，庙虽老旧，但是神案四周已被香火薰成乌黑的颜色，显示这里必定相\n"
"当受到信徒的敬仰。\n"
msgstr ""

msgid ""
"你现在正走在雪亭镇的街道上，东边不远处有一间高大的院子，门\n"
"口立著一根粗大的旗杆，旗子上写著「淳风武馆」，往南只听得人声鼎\n"
"沸，是个五十尺见方的广场，人来人往相当热闹。往北可望见一座牌坊\n"
"，年代久远，上面的字迹早已看不出是什么字，出了牌坊就是镇外。\n"
msgstr "Вы идёте по улице городка Сюэтин. Неподалёку на востоке — высокая усадьба; у её ворот стоит толстый флагшток, и на флаге написано «Школа Чуньфэн». С юга доносится гул голосов: там квадратная площадь шагов в двадцать, где снуёт народ и всегда шумно. На севере видна арка, такая старая, что надписи на ней давно не разобрать; за аркой начинается дорога из городка."

msgid ""
"你现在正走在雪亭镇的大街，往南直走不远处是镇上的广场，在你\n"
"的东边是一间大宅院，不过正门不在这个方向，往西是一家打铁铺子，\n"
"叮叮当当的声音大老远可以听得到，街道往北边一直通往镇外。\n"
msgstr ""

msgid ""
"这里是雪亭镇的大街，东边有一栋陈旧的建筑，看起来像是什么店\n"
"铺，但是并没有任何招牌，只有一扇门上面写著一个大大的「当\n"
"」字，往西是一间药铺，大街往南北两个方向延伸。\n"
msgstr ""

msgid ""
"这里是雪亭镇的大街，一条小巷子通往东边，西边则是一间驿站，\n"
"由于雪亭镇来往的商旅、官员并不很多，因此虽然是官府的驿站，也接\n"
"受百姓的信件，大街往北是一处山坳，从这里远远地可以望见北方的野\n"
"羊山，出了山坳就是一条碎石路通往山上。\n"
msgstr ""

msgid ""
"这里是一处山坳，往南就是雪亭镇，一条蜿蜒的小径往东通往另一\n"
"个邻近的小山村，一块官府立的告示牌立在路旁，上面写著有关野羊山\n"
"土匪出没的警告标志。\n"
msgstr ""

msgid ""
"这是一间谷物加工厂，这里是谷子脱壳成米的地方。米厂老板是一个一\n"
"看就知道是十分精明的干瘦的中年人，老是带着一脸奸笑。你可以看到\n"
"许多人正在忙忙碌碌的工作着，门口挂著一块牌子，往西是通往\n"
"雪亭镇大街的大门。\n"
msgstr ""

msgid ""
"这是一间素来以公平信用著称的钱庄，钱庄的老板还是个曾经中过\n"
"举人的读书人，你可以看到钱庄里里外外都打扫得乾乾净净，一个胖胖\n"
"的中年人坐在柜台后面，柜台上放著一块牌子，往东是通往雪亭\n"
"镇大街的大门。\n"
msgstr ""

msgid ""
"这是一家中等规模的当铺，老旧的柜台上放著一张木牌，屋\n"
"里的光线不是很亮，往东的出口被一块蓝色布帘遮著，上面有「非请莫\n"
"入」的字样，西边有一扇木雕门通往大街。\n"
msgstr ""

msgid ""
"你现在正站在一间大宅院的入口，两只巨大的石狮镇守在大门的两\n"
"侧，一阵阵吆喝与刀剑碰撞的声音从院子中传来。通过红漆大门\n"
"往东可以望见许多身穿灰衣的汉子正在操练。\n"
msgstr "Вы стоите у входа в большую усадьбу. По обе стороны ворот несут стражу два огромных каменных льва; со двора то и дело доносятся выкрики и звон клинков. Сквозь красные лакированные ворота на востоке видно, как упражняется множество крепких мужчин в серой одежде."

msgid ""
"你现在正站在一个宽敞的教练场中，地上铺著黄色的细砂，许多人\n"
"正在这里努力地操练著，北边是一间高大的兵器厅，往东则是武馆师父\n"
"们休息的大厅。\n"
msgstr "Вы стоите на просторном учебном дворе, посыпанном мелким жёлтым песком; здесь усердно упражняется множество людей. На севере — высокий оружейный зал, на востоке — зал, где отдыхают наставники школы."

msgid ""
"这里是淳风武馆的正厅，五张太师椅一字排开面对著门口，这是武\n"
"馆中四位大师傅与馆主柳淳风的座位，和一般武馆不同的是，墙上竟然\n"
"挂著几幅风骨颇为不俗的书画，显示这里的主人并非大字不识的粗汉，\n"
"而是文武双全的高人。\n"
msgstr "Это главный зал школы Чуньфэн. Лицом к дверям в ряд стоят пять резных кресел — места четырёх старших мастеров школы и её главы Лю Чуньфэна. Не в пример другим школам боевых искусств, на стенах здесь висят картины и каллиграфия весьма недурного вкуса: видно, что хозяин здешний не неграмотный грубиян, а человек, равно искусный и в науках, и в боевом деле."

msgid ""
"这里是雪亭镇的街道，你的北边有一家客栈，从这里就可以听到客\n"
"栈里人们饮酒谈笑的声音，街道往东不远处有个转角往北，如果你往东\n"
"直走就是上山的小径了，往西则可以走到车马来往络绎不绝的官道。\n"
msgstr ""

msgid ""
"这是一条宽敞坚实的青石板铺成的大道，路上车马的痕迹已经在路\n"
"面上留下一条条明显的凹痕，往东是一条较小的街道通往雪亭镇，大路\n"
"从这里往北可达水烟阁，往西南穿过黄石隘口则通往戍守京畿重地的天\n"
"驼关。\n"
msgstr ""

msgid ""
"这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从这\n"
"里往北通往水烟阁，往东则是衔接雪亭镇街道的路口。\n"
msgstr ""

msgid ""
"这是一条宽敞坚实的青石板大道，大道两旁种著整齐的花木，从这\n"
"里往西通往水烟阁，往南则是衔接雪亭镇街道的路口。\n"
msgstr ""

msgid ""
"这里是一间宽敞的书院，虽然房子看起来很老旧了，但是打扫得很\n"
"整洁。墙壁上挂著一幅山水画，意境颇为不俗。书院的大门开在北边，\n"
"西边有一扇木门通往边厢。\n"
msgstr ""

msgid ""
"这里是一间打铁铺子，从火炉中冒出的火光将墙壁映得通红，屋子\n"
"的角落里堆满了各式铁器的完成品或未完成品，像是锄头、铁锤、铲子\n"
"等，叮叮当当的声音敲得满屋子响。\n"
msgstr ""

msgid ""
"这里是一间规模不小的药铺，奇怪的是，在这里你闻不到一丝药铺\n"
"应有的药味，有的只是一股淡淡的檀香，令人觉得心旷神怡，药铺的柜\n"
"台就在店铺靠北的一面，柜台后是一个巨大的药柜， 上面的\n"
"小抽屉只怕有七、八百个之多，但是全部没有贴标签，药铺的出口在东\n"
"边，柜台上贴著一张发黄的纸片。\n"
msgstr ""

msgid ""
"这里是负责雪亭镇官府文书跟军令往来的雪亭驿，但是因为出了雪\n"
"亭镇往北的野羊山近年来有盗匪盘据，官府的信差最近都改走东边的飞\n"
"鸢栈道，所以雪亭驿来往的人就少了，驿站的官员索性就开始接一些百\n"
"姓的信件，一方面打发时间，一方面也有点事做以免被上级裁撤。驿站\n"
"大门口上悬著一块木牌，上面写了些字。\n"
msgstr ""

msgid ""
"这里是丰登当铺的储藏室，有时候当铺里的大朝奉会把铺里存不下\n"
"的死当货物拿出来拍卖，不过你现在只能看见一个个锁著的箱子。往西\n"
"边穿过一道布帘可以回到当铺店面。\n"
msgstr ""

msgid "饮风客栈二楼"
msgstr "Второй этаж трактира «Иньфэн»"

msgid ""
"你现在来到了饮风客栈的二楼，这家客栈有个很奇怪的规矩，就是只留宿\n"
"名头够大的客人，如果你只是一个无名小卒，不论出再多银两都租不到一间空\n"
"房，墙边有一道楼梯通往一楼的茶座。\n"
msgstr "Вы поднялись на второй этаж трактира «Иньфэн». В этом трактире странный обычай: на ночлег здесь пускают только гостей с громким именем. Если вы безвестный новичок, то сколько серебра ни предлагайте — свободной комнаты не получите. У стены лестница ведёт вниз, в чайный зал на первом этаже."

msgid ""
"这是一间打扫得相当乾净的客房，虽然所有的家俱看起来都相当朴\n"
"素，比不上县城里几家著名的大酒馆，但是自有一种敦厚亲切的感觉，\n"
"你在这里相信可以安心的休息。\n"
msgstr "Это гостевая комната, прибранная весьма чисто. Мебель здесь вся простая, куда ей до знаменитых больших трактиров уездного города, но есть в ней какая-то основательная, приветливая теплота; здесь, верно, можно спокойно отдохнуть."

msgid ""
"这里是淳风武馆中的天井，往西走可以回到正厅，往北边是书房，\n"
"南边是招待客人的厢房，往东一条长廊通往武馆内院，天井中种满了许\n"
"多奇花异草，中央立著一根石柱，上面似乎刻著字。\n"
msgstr "Это внутренний дворик школы Чуньфэн. На западе — проход обратно в главный зал, на севере — кабинет, на юге — флигель для гостей, а на восток длинная галерея ведёт во внутренние покои школы. Дворик засажен диковинными цветами и травами, а посередине стоит каменная колонна — на ней, кажется, что-то вырезано."

msgid ""
"这里是淳风武馆的内院，平常武馆弟子没有馆主的允许是不敢到这\n"
"里来的，往东是柳家的祠堂，馆主和家眷的卧房分别位于往北一条走道\n"
"的两旁，厨房以及柴房、仆役的卧房都在往南的走道两旁，往西则是天\n"
"井。\n"
msgstr "Это внутренние покои школы Чуньфэн. Без позволения главы ученики школы обычно не смеют сюда заходить. На востоке — храм предков семьи Лю; спальни главы школы и его домочадцев — по обе стороны прохода на север, кухня, дровяной сарай и комнаты слуг — по обе стороны прохода на юг, а на западе — внутренний дворик."

msgid ""
"这里是一间布置得相当雅致的厢房，从窗子可以看到北边的天井跟\n"
"南边的庭园中各式各样的奇花异草，以及他们所带来的淡淡香气，厢房\n"
"的东面墙上还挂著一幅仕女图，画中是一位宫装美妇，往西\n"
"是通往天井的出口。\n"
msgstr ""

msgid ""
"这里是一间整理得相当乾净的书房，红木桌椅上铺著蓝绸巾，显得\n"
"十分考究，西面的立著一个书架，上面放著一排排的古书，往南走出房\n"
"门可以看到天井。\n"
msgstr ""

msgid ""
"这是一间堆满各式兵器、刀械的储藏室，各式武器都依照种类、长\n"
"短、依次放在一起，并且擦拭得一尘不染，储藏室的出口在你的南边，\n"
"面对出口的左手边有一个架子。\n"
msgstr ""

msgid ""
"这里是一间窄小的密室，你的面前只有一个破旧的小床跟一\n"
"些乾草。\n"
msgstr ""

msgid "短工"
msgstr "Подённая работа"

msgid "钱庄"
msgstr "Меняльная лавка"

msgid "红漆大门"
msgstr "Красные лакированные ворота"

msgid "木雕门"
msgstr "Резная деревянная дверь"

msgid "房门"
msgstr "Дверь комнаты"

msgid "往左推"
msgstr ""

msgid ""
"这个架子上空荡荡的，什么都没有。\n"
msgstr ""

msgid "你将架子往左推...，忽然「喀」一声架子又移回原位。"
msgstr ""

msgid "地板忽然发出轧轧的声音，一块地面缓缓移动著，露出一个向下的阶梯。"
msgstr ""

msgid "地板忽然发出轧轧的声音，一块地面缓缓移动著，将向下的通道盖住了。"
msgstr ""

msgid ""
"你现在正走在一条林间的小路，往北不远处走出这座林子就是雪亭\n"
"镇，小路两旁长满了许多高耸的松树，雪亭镇的居民都把这里叫做「老\n"
"松林」，据说林子里有株树龄上千的老松树，颇有灵验。\n"
msgstr ""

msgid ""
"你现在正走在一条林间的小路上，小路两旁长满了高耸的松树，从\n"
"林间传来阵阵鸟叫声，小路往南北两个方向延伸出去。\n"
msgstr ""

msgid ""
"你现在正走在一条林间的小路上，小路往东似乎通往一处空地，林\n"
"子到了这里变得静悄悄的，小路两旁的松树也比西边的矮小，看起来有\n"
"点营养不良的样子。\n"
msgstr ""

msgid ""
"这是一块林间空地，四周的树木花草像是被人修剪过一般，环绕著\n"
"空地围成一个整齐的圆形，空地中央一株巨大的松树像平地上撑\n"
"起一把大伞，树上针叶茂密得遮去了大半的阳光，空地四周有三条小路\n"
"分别通往东、西、南三个方向，往南的小路旁竖著一个牌子。\n"
msgstr ""

msgid ""
"你现在正走在一片松树林中的小路上，小路往北通往一处空地，一\n"
"株巨大无朋的松树矗立在空地中央，小路往南是一条长长的下坡道，这\n"
"条路上足迹很多，显然常有人经过。\n"
msgstr ""

msgid "下坡道"
msgstr "Спуск"

msgid ""
"这是一条笔直的坡道，北高南低，道路两旁长满了许多松树，从松\n"
"林间隐约可以听到东边传来流水的声音。\n"
msgstr ""

msgid ""
"你现在正走在一条松树林中的小路，这里的松树树干上都有著一些\n"
"奇怪的记号，像是被人用刀子划过，小路的西边是一块空地，往东不远\n"
"可以看到一条山涧，上面横跨著一座小石桥。\n"
msgstr ""

msgid ""
"你现在正站在一座长满青苔的古桥上，桥下是一条山涧，几股清泉\n"
"在乱石之中向山下奔流，桥北边不远处有一个瀑布 ，从山\n"
"壁上犹如一条白练般垂了下来，瀑布两旁的石壁十分陡峭，高度和山涧\n"
"旁的松林相差了近三、四十丈。\n"
msgstr ""

msgid ""
"你现在正走在一条松树林间的小路，西边有一座小石桥横跨在一条\n"
"山涧上，往东不远处似乎是林子的出口，一条破旧的栈道沿著山壁通往\n"
"山上，你发现地上有一些湿漉漉的脚印，但是因为脚印太\n"
"多，分不出是往哪里去。\n"
msgstr ""

msgid ""
"你现在正站在瀑布前的一个小水潭里，水潭大约深可及胸，淹不死\n"
"人，一条白练般的瀑布从数百丈高的悬崖上冲激而下，溅\n"
"得你全身湿透，水潭三面都被高耸的山壁所包围，只有南面沿\n"
"著一条山涧可以出去。\n"
msgstr ""

msgid ""
"你现在正站在一个深不见底的水潭边上，从潭底不时有气泡冒上来\n"
"，散发著一股诡异的香味，水潭边长满了黄色叶子的怪草，四周陡峭的\n"
"山壁近乎直立，抬头只见一个半圆形的天空，唯一的出路大概只有往北\n"
"山泉流入水潭的缺口。\n"
msgstr ""

msgid ""
"你现在正站在一条山涧中的岩石上，几股泉水正从你脚边流过，水\n"
"花溅得四处飞散，南边是一个深不见底的水潭，两边的山壁看起\n"
"来又高又陡，看来要爬上岸边实在很不容易，你的北方有一座小石桥高\n"
"高地跨过两边的山壁，可是桥的高度太高，即使是轻功绝顶的高手也跃\n"
"不上去。\n"
msgstr ""

msgid ""
"你现在正站在一条山涧中的岩石上，一座小石桥正高高地从你的头\n"
"顶横跨过山涧两边的石壁，一个瀑布就在你的北方不远处，从一\n"
"处更高的悬崖上垂了下来。\n"
msgstr ""

msgid ""
"你现在正站在一个松树林里，嗯....这是一个松树林....你所知就\n"
"这么多，茂密的松树遮蔽了整个天空，使你连方向都弄不清楚，最好在\n"
"天黑之前赶紧找道路径出去吧。\n"
msgstr ""

msgid ""
"你现在正站在一个松树林间的小空地上，你的北边、东边、南边都\n"
"是茂密的松树，唯独西边是个悬崖，当你探头一看，立刻不由\n"
"自主地倒抽一口凉气，在这里可得千万小心，一不小心跌了下去肯定是\n"
"粉身碎骨。\n"
msgstr ""

msgid ""
"你现在正栖身在一个山壁上勉强足以容纳一个人休息的岩穴中，从\n"
"这里无论是要往上爬或往下爬都有一段不算短的距离，最好先歇一歇，\n"
"喘口气再走。\n"
msgstr ""

msgid ""
"你现在正攀附在一株大松树的树干上，从这里可以很清楚地望见树\n"
"下的一切动静，而不被人发觉，似乎是个干偷鸡摸狗勾当的好地方。\n"
msgstr ""

msgid ""
"你现在正攀附在一株大松树的树干上，这里离地面已经有七、八丈\n"
"高，如果不小心跌了下去，不断条腿也得去半条命，松树上结了许多球\n"
"果，不过大部分都离树干很远，你构不到。\n"
msgstr ""

msgid "大松树顶"
msgstr "Вершина большой сосны"

msgid ""
"哇....你终于爬上这株松树的树顶了，一阵阵凉风从四面八方吹来\n"
"，使你觉得心旷神怡，虽然你的经验告诉你在这种地方往下看是十分不\n"
"智的，但是你还是忍不住看了一眼，这里离地面至少也有十五、六丈高\n"
"，一阵晕眩警告你最好在跌下去以前离开这个地方。\n"
msgstr ""

msgid ""
"你现在正站在一个岩石的通道之中，在你南边有一片亮晶晶的帘幕\n"
"，从帘幕后面传来阵阵轰隆隆的水声，通道两边的石壁上安置\n"
"著许多铜铸的烛台，照亮了这个岩穴，往北似乎有亮光。\n"
msgstr ""

msgid ""
"    你现在正站在一个阴森森的山洞之中, 一条昂首吐信的金银花蛇,\n"
"爬伏在一块突出的大青石上, 令人望而生畏, 也许你该回头逃跑了。\n"
msgstr ""

msgid ""
"你现在正站在一块突出的大青石上, 虽然有点滑, 你还是能站稳,\n"
"往四周看, 除了长满了青苔的石壁, 好象无路可走了。\n"
msgstr ""

msgid ""
"你现在正站在一个岩石通道之中，从南边隐隐传来哗哗的水声，岩\n"
"壁上生著厚厚的青苔，一股恶臭从北边传来，像是什么野兽，也许你该\n"
"回头出去了。\n"
msgstr ""

msgid ""
"你现在已经到达山洞的深处了, 四面八方都是些黑漆漆的小石洞,\n"
"简直不知道该往那里走, 要不是北面还有一点光线, 你都要彻底绝望了。\n"
msgstr ""

msgid ""
"你现在已经到达山洞的深处了, 耶...东面就是洞口了, 还可以听\n"
"见外面瀑布的水声, 仔细的观察石壁, 可以发现上面有一些用利\n"
"剑雕刻的字....\n"
msgstr ""

msgid ""
"这里只见一个木头搭成的大门，门框上挂著四、五的不知道是什么\n"
"动物的头骨跟一些铁链，外面再铺上一层乾枯的松枝，在这样一个森林\n"
"里还真不容易发觉。\n"
msgstr ""

msgid ""
"这里应该是老松寨了，虽然围绕著你的墙都是木头搭成的，但是仔\n"
"细一看，在许多险要的位置都放了不少沙包石堆，后面显然是埋伏人手\n"
"的好地方，如果有人贸然从大门口攻进来，肯定会吃大亏的，大寨的门\n"
"在你的西边，东边越过一排木桩之后就是大厅。\n"
msgstr ""

msgid ""
"这里就是老松寨的大厅了，靠北边的地面上铺了一张巨大的熊皮，\n"
"上面摆了三张椅子，大厅四周散落著几个取暖用的火盆，几个上了锁的\n"
"木箱子，比较奇特的是中央掘了一个大坑，坑里是许多头骨浸在\n"
"一种发著恶臭的黄水之中。\n"
msgstr ""

msgid "瀑布清水"
msgstr "Чистая вода водопада"

msgid "湖水"
msgstr "Озёрная вода"

msgid "泉水"
msgstr "Родниковая вода"

msgid "大门"
msgstr "Ворота"

msgid "灌木丛"
msgstr "Кустарник"

msgid "你听到你身后有几个声音大叫：把门关上！把门关上！一个也不许让他们溜走！"
msgstr ""

msgid "接著「轰」地一声，通往外面的大门已经被一块大石堵死了。"
msgstr ""

msgid "你听到一阵轧轧的轮盘绞动声，堵住门口的大石慢慢地被移开了。"
msgstr ""

msgid "爬树"
msgstr ""

msgid ""
"一株又高又大的松树，当你抬头往上看的时候似乎有个人影\n"
"在树梢之间移动，不过也许是风吹动所造成的错觉。\n"
msgstr ""

msgid "你手脚并用，敏捷地爬上了空地中央的大松树。"
msgstr ""

msgid "往下爬"
msgstr ""

msgid "你顺著粗大的树干，慢慢地爬了下来。"
msgstr ""

msgid "抓住藤蔓"
msgstr ""

msgid ""
"其中有一根藤蔓距离你比较近，你可以试著抓住藤蔓，看看\n"
"能不能像泰山一样荡过去，看看瀑布后面有什么？\n"
"对了，提醒你一点，这座石桥下面是高约百丈的山涧深谷....。\n"
msgstr ""

msgid "你爬上石桥的护栏，伸手往不远处的一根藤蔓抓去...."
msgstr ""

msgid "只听见一声杀猪般的惨叫，你已经往山涧中坠了下去。"
msgstr ""

msgid "你听到有人高声惊叫，一条人影从上方掉了下来，「扑通」一声跌进潭中。"
msgstr ""

msgid "你手脚俐落地攀附著藤蔓，慢慢地爬下山涧....。"
msgstr ""

msgid "忽然一条人影从南边的帘幕穿了出来。"
msgstr ""

msgid "山涧石壁"
msgstr "Каменная стена ущелья"

msgid "攀爬石壁"
msgstr ""

msgid ""
"两边的山壁看起来又高又陡，看来要爬上岸边实在很不容易。\n"
msgstr ""

msgid "你一付不信邪的表情，开始小心翼翼地攀著石壁爬了上去。"
msgstr ""

msgid "向下的山壁"
msgstr "Скала вниз"

msgid ""
"从这个勉强容身的岩穴往下爬，还有一段不算短的距离。\n"
msgstr ""

msgid "你试了试脚边的岩石稳不稳，开始小心翼翼地往山涧中攀了下去。"
msgstr ""

msgid "向上的山壁"
msgstr "Скала вверх"

msgid "往上爬"
msgstr ""

msgid ""
"从这个勉强容身的岩穴往上爬，还有一段不算短的距离。\n"
msgstr ""

msgid "你试了试脚边的岩石稳不稳，开始小心翼翼地往上攀爬。"
msgstr ""

msgid "大青石"
msgstr "Большой синеватый камень"

msgid ""
"一块比人还高的钟乳石, 虽然长满了青苔, 但爬上去\n"
"应该不会太困难。\n"
msgstr ""

msgid "你慢慢地攀上大青石。"
msgstr ""

msgid "你迅速地爬下大青石。"
msgstr ""

msgid "石壁"
msgstr "Скальная стена"

msgid "埋葬骸骨"
msgstr ""

msgid ""
"老夫南危水, 乃是昔年水烟阁五长老中第一高手,\n"
"一生醉心武学, 集天邪、封山两派之所长, 为营救盟主遭小人暗算,\n"
"埋骨于此。男子汉大丈夫死不足惜, 只可恨一身武学尚无传人!\n"
"葬我遗骨者老夫将赠以过招要旨, 唉......\n"
msgstr ""

msgid "你小心翼翼地埋好了那具骸骨。"
msgstr ""

msgid "你听见山洞顶部的石壁「喀喇」地一声响，一本书坠落下来。"
msgstr ""

msgid "你只看见山洞顶部纷纷扬扬飘下几张纸片来。"
msgstr ""

msgid "你听得「轰」的一声响，已经从这摔了下去"
msgstr ""

msgid ""
"你定下心神一看，其实这个悬崖没有想像中那么恐怖，也许还\n"
"可以从这里爬下山涧，只是这世界上大概没有这种白痴愿意干\n"
"这种傻事吧。\n"
msgstr ""

msgid "你一付认真的表情，开始小心翼翼地攀著石壁爬了上去。"
msgstr ""

msgid ""
"「官府告示：此处常有歹人出没。」\n"
msgstr ""

msgid "路牌"
msgstr "Указатель"

msgid ""
"一块旧木牌，刻着三行字：\n"
"「往西，雪亭镇。」\n"
"「往东，小石桥。」\n"
"「往南，下坡道。」\n"
msgstr ""

msgid "刀痕"
msgstr "Следы клинка"

msgid "顺着刀痕找"
msgstr ""

msgid ""
"这几株松树的树干上都有刀划的记号，一道一道，深浅不一，像是有人怕走错了路，沿途留下的。记号一路往东，到那丛灌木跟前就断了。\n"
msgstr ""

msgid "你顺着树上的刀痕往东找去，拨开那丛灌木，后面果然有一条踩得结实的小径，通往林子深处。"
msgstr ""

msgid "刀痕指的就是灌木后面那条小径。"
msgstr ""

msgid "脚印"
msgstr "Следы ног"

msgid ""
"一些杂乱的脚印，不但有人的脚印，看起来还有不少马蹄印。\n"
msgstr ""

msgid "瀑布"
msgstr "Водопад"

msgid ""
"这个瀑布从数百丈高的山壁上冲激而下，流入一个山涧底的小水潭\n"
"，水潭两边的石壁垂下许多的藤蔓，你注意到瀑布后面似乎\n"
"有什么东西在发著光。\n"
msgstr ""

msgid ""
"这个瀑布水势并不是很大，但是高度却极高，水珠溅在你的脸上\n"
"打得隐隐生疼。你注意到瀑布后面似乎有什么东西在发著光。\n"
msgstr ""

msgid "山壁"
msgstr "Скала"

msgid ""
"水潭四周的山壁都有数百丈高，想要爬上去「肯定」是休想。\n"
msgstr ""

msgid ""
"这里的山壁比北边高度稍低了点，但是对凡人而言想要爬上去仍然\n"
"还有一段差距。\n"
msgstr ""

msgid "帘幕"
msgstr "Занавес"

msgid ""
"这片帘幕似乎是用一种极薄的丝绸织成的，后面还传来阵阵水声。\n"
msgstr ""

msgid "大金槌"
msgstr "Большая золотая кувалда"

msgid ""
"一把极其沈重的大槌，要挥动这样的武器非得有过人的膂力不可。\n"
msgstr ""

msgid "熊皮短靴"
msgstr "Короткие сапоги из медвежьей шкуры"

msgid "钢刀"
msgstr "Стальная сабля"

msgid ""
"一把沈重的钢刀，磨得又利又快，看起来相当具杀伤力。\n"
msgstr ""

msgid "短斧"
msgstr "Короткий топор"

msgid ""
"这种斧头的刃长柄短，是专门用来做兵器的斧头，近战具有相当强的\n"
"杀伤力。\n"
msgstr ""

msgid "黄霸"
msgstr "Хуан Ба"

msgid "日月槌"
msgstr "Молоты солнца и луны"

msgid "野羊山三寨主（代寨主）"
msgstr ""

msgid ""
"黄霸原是关外一个山寨的寨主，后来因为逃避官府追捕而到也羊山\n"
"避祸，他的成名武器是一对各重四十斤的大金槌，内功跟横练功夫\n"
"也都有不错的造诣。\n"
"大寨主、二寨主先后没了下落，如今野羊寨的事都是他说了算——只是每年得往北麓的道观纳供。\n"
msgstr ""

msgid "纳供"
msgstr ""

msgid "说过的话老子不说第二遍。车在山路转角，去不去随你。"
msgstr ""

msgid "哼了一声。"
msgstr ""

msgid "你倒打听得清楚。两年前北麓来了那群黑衣黑冠的道士，一座黑砖道观说起就起，自称逆灵宫。寨里折了一半弟兄。"
msgstr ""

msgid "半年前大寨主霍铮、二寨主一前一后没了下落，寨子就落到老子手里。老子打不过他们——每年纳供，金帛、牲口，他们要什么给什么，换这山上还有野羊寨。"
msgstr ""

msgid "把酒碗往桌上一顿。"
msgstr ""

msgid "今年的车今天就上去了，这会儿该到了山路转角。你要去，别说是老子说的。"
msgstr ""

msgid "寨里的事，外人少打听。"
msgstr ""

msgid "前些日子茅山灵心观来了个小道士，说是替他们的林忌真人打听北麓那座道观——问寨里有没有人进去过，还出得来。"
msgstr ""

msgid "老子说有一个。……你要是不想再跟那群牛鼻子打交道，就当老子没说。"
msgstr ""

msgid "茅山？牛鼻子道士，老子不认得。"
msgstr ""

msgid "黄霸脸色一沉：北麓那座黑砖道观？少打听。要问，问纳供。"
msgstr ""

msgid "大哥在里屋。要见他，自己进去。"
msgstr ""

msgid "没了。野羊山现在姓黄。"
msgstr ""

msgid "霍铮？半年前让道观的人带走了。你问这个做什么。"
msgstr ""

msgid "霍铮"
msgstr "Хо Чжэн"

msgid "黑衣"
msgstr ""

msgid "就那一顶，老子又不开成衣铺。"
msgstr ""

msgid "从墙角的箱子里翻出一顶黑冠，往你怀里一扔。"
msgstr ""

msgid "去年抓过一个落单的道士，衣冠都在这儿，人早喂了岩蛭。黑衣你自己有，戴上这顶冠，那群牛鼻子分不出你是谁。"
msgstr ""

msgid "见了霍铮——要是他还活着——说一声，黄霸没忘了他。"
msgstr ""

msgid "眯眼看了你一会儿，从墙角的箱子里翻出一顶黑冠，往你怀里一扔。"
msgstr ""

msgid "刘老三让你来的？去年抓过一个落单的道士，衣冠都在这儿。黑衣你自己有，戴上这顶冠，那群牛鼻子分不出你是谁。"
msgstr ""

msgid "黑衣？老子穿的是布衣。少打听。"
msgstr ""

msgid "野羊山寨主"
msgstr ""

msgid ""
"黄霸把酒碗往桌上一顿：野羊山，老子说了算。\n"
msgstr ""

msgid ""
"黄霸嘟囔道：大寨主没了。没了就没了。\n"
msgstr ""

msgid "野羊山三寨主"
msgstr ""

msgid ""
"黄霸给里屋送了一碗酒进去，出来时抹了把脸。\n"
msgstr ""

msgid ""
"黄霸嘟囔道：大哥回来了。好，好。\n"
msgstr ""

msgid "看了你一眼，又低头喝酒。"
msgstr ""

msgid "逆灵宫的事老子听说了。大寨主没了，寨子是老子的——你也别想拿这个压老子。"
msgstr ""

msgid "手里的酒碗啪地掉在地上。"
msgstr ""

msgid "大哥……大哥你还活着！"
msgstr ""

msgid "活着。老三，寨子你管得不错——供也纳得不错。"
msgstr ""

msgid "扑通一声跪下了。"
msgstr ""

msgid "大哥，寨子是你的。老子从今天起还是三寨主，你要打要杀，老子不还手。"
msgstr ""

msgid "起来。杀你不如杀道士。"
msgstr ""

msgid "这娃娃是傅家坡的，派两个弟兄送他回家，少一根头发老子找你。"
msgstr ""

msgid "两个寨兵领着石头出了庙门。石头回头看了你一眼，没有说话。"
msgstr ""

msgid "兄弟，野羊寨欠你一条命。以后野羊山的路，你横着走。"
msgstr ""

msgid "霍铮骂骂咧咧地进了土地庙的里屋，叫黄霸拿酒来。"
msgstr ""

msgid ""
"一个眼神凶恶的土匪，脸上好几条长长的刀疤，看起来就知道不好惹。\n"
msgstr ""

msgid ""
"这个土匪看起来相当强悍，至少你从他的动作就可以看得出来他显然\n"
"是练过武功的硬手，并不是泛泛之辈。\n"
msgstr ""

msgid ""
"一条色作浅灰，带著白色斑点的水蛭模样怪虫，口中露出六对白森森\n"
"的牙齿，看起来恶心极了。\n"
msgstr ""

msgid ""
"你现在正走在一条崎岖的山路上，凹凹凸凸的山石刺得你的脚底隐\n"
"隐生疼，山路往南不远处通往一个山腰的台地，这一带最大的镇甸就位\n"
"在台地上，东边跟西边都是陡峭的山壁，山路往北通往层层叠叠的群山\n"
"之中。\n"
msgstr ""

msgid ""
"你现在正走在一条崎岖的山路上，路面到处生满了及膝的杂草丛，\n"
"显示这里已经有一段时间没有车马经过了，从这里往北就是野羊山的地\n"
"界，野羊山有一座山寨，住著许多凶恶的盗匪，你最好绕道而行。\n"
msgstr ""

msgid ""
"你现在正走在一条崎岖的山路上，东边的路旁一个山壁的裂缝里有\n"
"一间小庙，从这里看过去黑漆漆的似乎没有人照顾，山路往北是一段陡\n"
"峭的上坡，往西南的山路就平缓得多。\n"
msgstr ""

msgid ""
"你现在正站在一间小土地庙中，这座庙的南北两面都是利用了山壁\n"
"而建的，只有东面一面土墙，墙上嵌著一个小小的神龛，里面供著一尊\n"
"残破不堪的土地爷爷，庙门在你的西边。\n"
msgstr ""

msgid ""
"你现在正走在一条崎岖山路的转角处，山路望东通往野羊山上，从\n"
"这里可以望见东边不远处有一个石屋立在岩壁边上，看起来像是冈哨或\n"
"什么的，北边的山壁有一个裂口，不过离地约有三到四丈， 往\n"
"南的山路是段陡峭的下坡，如果你要下山，大概就是这条路了。\n"
msgstr ""

msgid ""
"这里是一段狭窄的山路，往东不远处的岩壁边上有一座石屋，路旁\n"
"生满了及腰的长草，山风吹过一起一伏的有如波浪一般，南北两边有许\n"
"多大石，看起来倒是个埋伏的好地点，往西是一个山路的转角。\n"
msgstr ""

msgid ""
"这里是一处岩石斜坡，斜坡上到处布满乱石及杂草，东边的岩壁边\n"
"有一间石屋，往西跟往北则可以回到铺满碎石的山路。\n"
msgstr ""

msgid ""
"你现在正走在一条崎岖的山路上，往北是一个峡谷，通过「飞火崖\n"
"」的正下方，从这里可以看到一条五、六丈宽的石梁魏颤颤地跨过峡谷\n"
"，山路往西南转过，南边则是一片岩石斜坡。\n"
msgstr ""

msgid ""
"你现在正走在一条狭长的峡谷之中，东西两边都是高不可攀的峭壁\n"
"，一根五、六丈宽的石梁正横跨在你头顶的谷口，看起来摇摇欲坠，万\n"
"一掉下来只怕当场就会被压成一个肉饼，往南就是峡谷的出口，峡谷谷\n"
"底的地面看起来像是乾涸的山涧，弯弯曲曲往北通入峡谷深处。\n"
msgstr ""

msgid ""
"你现在正走在一条狭长的深谷之中，东西两面都是高不可攀的峭壁\n"
"，往南沿著谷底一条乾涸的山涧可以通往峡谷的出口，北边的峭壁从这\n"
"里斜斜向上宛如从天上掉下来倒插进地面，形势更是危峻，连天空都被\n"
"北边的峭壁遮去了七、八分。\n"
msgstr ""

msgid ""
"你现在正走在一条峡谷的谷底，这里的峭壁斜度之大让你胆颤心惊\n"
"，只消有人在这里一声大喝将上面的土石震了下来，只怕立刻就得被活\n"
"埋，东边的峭壁上有一个黑漆漆的洞穴，里面似乎有什么东西蠕蠕而动\n"
"，峡谷往西南和西北两边各有狭窄的出口。\n"
msgstr ""

msgid ""
"这个岩洞的内部似乎远比你想像得大，岩壁上有一条条的深沟彷佛\n"
"是被什么蛀虫给蛀出来的，可是有什么虫会去啃咬这又硬又厚的岩壁呢\n"
"？洞穴的出口在你的西边透著微光，东北边跟西北边各有一个洞穴，黑\n"
"暗中似乎有什么东西在蠕蠕而动。\n"
msgstr ""

msgid ""
"你现在正在一个黑漆漆的岩洞中摸索前进，西南边隐隐有些光亮，\n"
"想必是洞穴的出口，东边似乎有些滴水的声音，不过你得走过去才能听\n"
"得仔细，你感觉脚边有一些东西在蠕蠕而动，举脚又有些黏黏的，一阵\n"
"恶心的感觉压迫著你的胃。\n"
msgstr ""

msgid ""
"这里一片黑漆漆，你必须全靠摸索才能不至于撞到岩壁，你听到东\n"
"边传来阵阵滴水的声音，可是伸手一摸却仍是冷冰冰、又乾又硬的岩石\n"
"，地上布满了许多又黏又稠的不知名东西，使你每一步都走得异常艰辛\n"
"。\n"
msgstr ""

msgid ""
"这里是一处阴暗的岩洞，等你走近这个岩洞才发现原来是死路，东\n"
"北边隐隐透出几道微光，想必是洞穴的出口，地上一滩滩暗黄色的黏稠\n"
"物不知道士什么东西，闻起来竟一点味道也没有。\n"
msgstr ""

msgid "裂口"
msgstr "Расселина"

msgid ""
"北边的山壁上一道黑黝黝的裂口，离地约有三四丈，站在路上够不着。裂口边缘的岩石磨得发亮，像是常有东西从那里吊上吊下。\n"
msgstr ""

msgid "油布"
msgstr "Промасленный холст"

msgid "钻进车里"
msgstr ""

msgid "油布底下是供品的箱子。钻进去，就只能跟着箱子一起被吊上裂口，中途下不来。"
msgstr ""

msgid "钻进去"
msgstr ""

msgid ""
"你掀开油布一角，缩进两只箱子中间。油布落下来，眼前一黑。\n"
msgstr ""

msgid ""
"过了一会儿，车板一震，绳子绷紧了——你和箱子一起离了地，在半空里晃了半天，咚的一声落在硬地上。\n"
msgstr ""

msgid ""
"车停在那里，油布底下空空的，绳子松着——没人拉绳，钻进去也上不去。\n"
msgstr ""

msgid "绳索"
msgstr "Верёвка"

msgid "攀绳上去"
msgstr ""

msgid ""
"你抓住垂下的麻绳，手脚并用地攀上裂口。岩壁磨得发亮，上头有绞盘吱吱的响声。\n"
msgstr ""

msgid ""
"你戴着黑冠，押车的道士只当你是宫里的人，没人拦你。你抓住麻绳，手脚并用地攀上裂口。\n"
msgstr ""

msgid ""
"押车道士盯着你，手按在剑柄上：「此处无路，施主请回。」\n"
msgstr ""

msgid ""
"裂口离地三四丈，壁上光溜溜的，没有绳子上不去。\n"
msgstr ""

msgid "鹿皮小靴"
msgstr "Сапожки из оленьей кожи"

msgid "紫玉宝剑"
msgstr "Драгоценный меч из пурпурного нефрита"

msgid ""
"这是一把宝剑，隐含神秘力量。\n"
msgstr ""

msgid "布裙"
msgstr "Холщовая юбка"

msgid ""
"只有女生才可穿哦!你变态呀! \n"
msgstr ""

msgid "绿罗裙"
msgstr "Зелёная газовая юбка"

msgid "长鞭"
msgstr "Длинный кнут"

msgid "绵裙"
msgstr "Мягкая шёлковая юбка"

msgid "柳玉刀"
msgstr "Сабля из ивового нефрита"

msgid ""
"这是一柄纤细的柳玉刀，轻薄短小。\n"
msgstr ""

msgid "绣花鞋"
msgstr "Расшитые туфли"

msgid "银翅金簪"
msgstr "Золотая шпилька с серебряными крылышками"

msgid "支"
msgstr "шт."

msgid "青绫绸裙"
msgstr "Синяя юбка из узорчатого шёлка"

msgid "玉竹剑"
msgstr "Меч из нефритового бамбука"

msgid ""
"这是一把用竹子作成的玉竹剑，手工细腻别致。\n"
msgstr ""

msgid ""
"这是一封用蜡密封起来的信件，上面有一奇怪的图案。\n"
msgstr ""

msgid "封"
msgstr "шт."

msgid "用火烧"
msgstr ""

msgid ""
"你看见密函上出现几行字 : \n"
msgstr ""

msgid ""
"师父: \n"
"      展信愉悦 \n"
"    徒儿在晚月庄作客已有一阵子了!\n"
"在这徒儿无意中发现晚月庄的秘密。\n"
"一、原来晚月庄主是同性恋，她似乎在对男人失望之馀，\n"
"    对比自己年轻的姑娘由恨转而成一种变相畸型的爱。\n"
"二、在密室之中藏有一秘笈。以及庄内有一处有神奇宝物\n"
"    玛瑙手镯。在另一神秘的地方有通往庄主秘密情人的\n"
"    密室入口。\n"
"三、在庄内小花池中有火神族的神像。小花池似乎有神奇\n"
"    的力量在里头。\n"
msgstr ""

msgid ""
"你身上没有火没法烧。\n"
msgstr ""

msgid "杀手令牌"
msgstr "Жетон убийцы"

msgid ""
"一个黑木作的杀手令牌，上面刻著火焰的图腾标志。\n"
msgstr ""

msgid "宫保鸡丁"
msgstr "Курица гунбао"

msgid ""
"这是一道香辣可口的佳肴。\n"
msgstr ""

msgid "只"
msgstr "шт."

msgid "水饺"
msgstr "Пельмень"

msgid ""
"这是一个手工细腻的水饺，看起来很好吃。\n"
msgstr ""

msgid "女儿红"
msgstr "Дочернее вино"

msgid ""
"这是一坛香味浓郁的陈年老酒，是存给待嫁女儿喝的酒。\n"
"你闻了闻，好香好香哦!你有点想喝它\n"
msgstr ""

msgid "坛"
msgstr "кувшин"

msgid "脆皮烤鸭"
msgstr "Утка с хрустящей корочкой"

msgid ""
"这是一只看了都会流口水的、香喷喷的烤鸭。\n"
msgstr ""

msgid "火摺"
msgstr "Огниво"

msgid "这是一个可以生火的火摺"
msgstr ""

msgid "腰带"
msgstr "Пояс"

msgid "耳环"
msgstr "Серьги с самоцветами"

msgid ""
"这是一串用宝石镶串成的闪亮耳环。\n"
msgstr ""

msgid "串"
msgstr "связка"

msgid "钻石胸针"
msgstr "Брошь с алмазом"

msgid ""
"这是一个用钻石镶成的美丽胸饰。\n"
msgstr ""

msgid "宝蓝缎衫"
msgstr "Ярко-синяя атласная кофта"

msgid "碧玉红裎带"
msgstr "Нефритово-красный кушак"

msgid ""
"这是一条丝绸制的彩带，质感佳，上绣有彩霞江水纹。\n"
msgstr ""

msgid "珍珠项链"
msgstr "Жемчужное ожерелье"

msgid "丝罗巾"
msgstr "Шёлковый платок"

msgid ""
"这卷罗巾由上等丝绸编成，绣了一幅幅美女图。个个体态轻盈，翩然\n"
"起舞。每一曲舞步姿态美妙迷人，旁题著舞曲名称与步法。\n"
msgstr ""

msgid "卷"
msgstr "свиток"

msgid "冰玉戒指"
msgstr "Перстень из ледяного нефрита"

msgid "青纱裙"
msgstr "Синяя кисейная юбка"

msgid "护身符"
msgstr "Оберег"

msgid "雪花糕"
msgstr "Снежное пирожное"

msgid ""
"这是一块精致可口的小点心，似雪花般柔软。\n"
msgstr ""

msgid "块"
msgstr "шт."

msgid "竹子"
msgstr "Бамбуковый стебель"

msgid ""
"这是一根玉竹，还有一些竹叶在上面。\n"
msgstr ""

msgid "绣花针"
msgstr "Вышивальная игла"

msgid ""
"一种上等铁做成的绣花针\n"
msgstr ""

msgid "花针"
msgstr "Цветочная игла"

msgid ""
"一种铁做成的绣花针\n"
msgstr ""

msgid "红桂花"
msgstr "Красный османтус"

msgid ""
"才摘的桂花，发出阵阵淡淡的幽香。\n"
msgstr ""

msgid "粒"
msgstr "шт."

msgid "小花蕊"
msgstr "Цветочная тычинка"

msgid ""
"这是一朵金黄色的奇特花蕊，有一种淡淡香气。\n"
msgstr ""

msgid "朵"
msgstr "шт."

msgid "株"
msgstr "шт."

msgid "玉瓷茶杯"
msgstr "Чашка из нефритового фарфора"

msgid ""
"这是一杯香味浓郁上等好茶。是招待贵宾品茗的。\n"
"你闻了闻，好香好香哦!\n"
msgstr ""

msgid "杯"
msgstr "чашка"

msgid "金轩茶"
msgstr ""

msgid "竹蜻蜓"
msgstr "Бамбуковая вертушка"

msgid ""
"这是一个竹蜻蜓，手工相当细腻。\n"
msgstr ""

msgid "玛瑙手镯"
msgstr "Агатовый браслет"

msgid ""
"一个由玛瑙作成的美丽手镯。\n"
"再仔细玩看，似乎有其它作用。\n"
msgstr ""

msgid "祈祷"
msgstr ""

msgid ""
"你双手合掌，虔诚的祈祷。\n"
"手上的镯子嗡嗡作响。 突然一阵烟雾.... \n"
msgstr ""

msgid "舞曲谱"
msgstr "Свиток танцев"

msgid ""
"这是一卷由上等丝绸编成，以湘绣作成的舞曲图。上有记载一些舞曲 \n"
"每一曲都有它独特的风格与内涵。一幅幅玄天玉女翩然起舞，十分壮观。\n"
"\n"
"  曲目： \n"
" \n"
"  广陵散 \n"
"  春宫怨 \n"
" \n"
"对你而言基本舞步你可以参悟，至于较高深步法似乎需人指导了。 \n"
msgstr ""

msgid "跳「春宫怨」"
msgstr ""

msgid ""
"你双手合掌，脚步轻盈。一曲『 春宫怨 』......\n"
msgstr ""

msgid ""
"这似乎是一本寒雪鞭法的前几页，虽然并没有关於招式的详细解说，可是\n"
"前面有关鞭法的总纲与精义倒是不少。\n"
msgstr ""

msgid "黄金令牌"
msgstr "Золотой жетон"

msgid ""
"一个闪闪发亮的黄金令牌，上有一些图腾标志。\n"
msgstr ""

msgid "戒刀"
msgstr "Монашеская сабля"

msgid ""
"这是一把僧人练武用的戒刀，份量大约四、五斤重。\n"
msgstr ""

msgid "灰布僧衣"
msgstr "Серая монашеская ряса"

msgid "黑眼罩"
msgstr "Чёрная повязка на глаз"

msgid "副"
msgstr "шт."

msgid "僧鞋"
msgstr "Монашеские туфли"

msgid "青布僧衣"
msgstr "Синяя монашеская ряса"

msgid "菜刀"
msgstr "Кухонный нож"

msgid ""
"一把不很利的菜刀, 不过拿来切菜砍肉还是绰绰有馀的。\n"
msgstr ""

msgid "竹扫把"
msgstr "Бамбуковая метла"

msgid ""
"一把快秃了头的竹扫把。\n"
msgstr ""

msgid "馒头"
msgstr "Паровая булочка"

msgid ""
"一个香喷喷、热腾腾的大馒头。\n"
msgstr ""

msgid ""
"一棵翠绿色的小草，发着晶莹的光芒和醉人的香味。\n"
msgstr ""

msgid "棵"
msgstr "шт."

msgid "乌檀木刀"
msgstr "Сабля из чёрного дерева"

msgid ""
"这是一把黑黝黝的乌檀木刀，闻起来有一股淡淡的香气。\n"
msgstr ""

msgid ""
"这是时下读书人常看的书籍。\n"
msgstr ""

msgid "「嘉德文选」"
msgstr "«Избранные сочинения Цзядэ»"

msgid "「九韬」"
msgstr "«Девять стратегий»"

msgid "「太公辩」"
msgstr "«Рассуждения Тайгуна»"

msgid "「梁父文集」"
msgstr "«Собрание сочинений Лянфу»"

msgid "「说律」"
msgstr "«О законах»"

msgid "「古文志」"
msgstr "«Записки о древней прозе»"

msgid "「乡书」"
msgstr "«Письма из дома»"

msgid "「佾风斋诗集」"
msgstr "«Стихи из кабинета Ифэн»"

msgid "「寒士列传」"
msgstr "«Жизнеописания бедных учёных»"

msgid "「水龙图注」"
msgstr "«Карты водяного дракона с толкованиями»"

msgid "轻罗绸衫"
msgstr "Лёгкая шёлковая кофта"

msgid ""
"这是一件有钱人家的小姐穿著的衣物，手工相当细致。\n"
msgstr ""

msgid "银簪"
msgstr "Серебряная шпилька"

msgid "平安符"
msgstr "Талисман благополучия"

msgid ""
"一个用红线绑著的平安符，据说可以避邪。\n"
msgstr ""

msgid "玉带冠"
msgstr "Шапка с нефритом"

msgid ""
"这是一顶镶著美玉的帽冠。\n"
msgstr ""

msgid "大饼"
msgstr "Лепёшка"

msgid ""
"一个香喷喷、热腾腾的大烧饼。\n"
msgstr ""

msgid "糖葫芦"
