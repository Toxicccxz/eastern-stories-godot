msgstr "Вы завершили историю «{name}»"

msgid "你读通了{name}"
msgstr "Вы прочли до конца {name}{:вин}"

msgid "你完成了官府悬赏「{name}」"
msgstr "Вы выполнили казённое поручение «{name}»"

msgid "你的内力练到了 {name}"
