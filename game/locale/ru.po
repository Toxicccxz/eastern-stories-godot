msgid "$N注视著$n的行动，企图寻找机会出手。"
msgstr "$N {N:следите|следит} за $n{:твор}, выжидая случая ударить."

msgid "$N正盯著$n的一举一动，随时准备发动攻势。"
msgstr "$N не {N:сводите|сводит} глаз с $n{:род}, готовясь в любой миг напасть."

msgid "$N缓缓地移动脚步，想要找出$n的破绽。"
msgstr "$N медленно {N:переступаете|переступает}, ища у $n{:род} брешь в защите."

msgid "$N目不转睛地盯著$n的动作，寻找进攻的最佳时机。"
msgstr "$N, не мигая, {N:следите|следит} за $n{:твор}, выбирая лучший миг для удара."

msgid "$N慢慢地移动著脚步，伺机出手。"
msgstr "$N медленно {N:кружите|кружит}, выжидая удобного случая."

msgid "$N哈哈大笑，说道：承让了！"
msgstr "$N громко {N:смеётесь|смеётся}: «Благодарю, что уступили!»"

msgid "$N双手一拱，笑著说道：承让！"
msgstr "$N с улыбкой {N:кланяетесь|кланяется}, сложив руки: «Благодарю, что уступили!»"

msgid "$N胜了这招，向後跃开三尺，笑道：承让！"
msgstr "$N, взяв верх в этой схватке, {N:отскакиваете|отскакивает} на три шага назад и с улыбкой {N:говорите|говорит}: «Благодарю, что уступили!»"

msgid "$n脸色微变，说道：佩服，佩服！"
msgstr "$n слегка {n:меняетесь|меняется} в лице: «Отдаю должное, отдаю должное!»"

msgid "$n向後退了几步，说道：这场比试算我输了，佩服，佩服！"
msgstr "$n {n:отступаете|отступает} на несколько шагов: «Этот поединок за вами. Отдаю должное, отдаю должное!»"

msgid "$n向後一纵，躬身做揖说道：阁下武艺不凡，果然高明！"
msgstr "$n {n:отскакиваете|отскакивает} назад и с поклоном {n:складываете|складывает} руки: «Ваше искусство незаурядно — истинное мастерство!»"

msgid "$N受到$n的内力反震，闷哼一声。"
msgstr "$n {n:отражаете|отражает} удар внутренней силой, и $N глухо {N:охаете|охает}."

msgid "$N被$n以内力反震，「嘿」地一声退了两步。"
msgstr "$n {n:отталкиваете|отталкивает} $N{:вин} внутренней силой, и $N с выдохом «Хэ!» {N:отступаете|отступает} на два шага."

msgid "$N被$n以内力一震，胸口有如受到一记重击，连退了五六步！"
msgstr "$n {n:бьёте|бьёт} $N{:вин} внутренней силой, будто молотом в грудь, — $N {N:пятитесь|пятится} шагов на пять-шесть!"

msgid "$N被$n的内力一震，眼前一黑，身子向後飞出丈许！！"
msgstr "$n {n:обрушиваете|обрушивает} на $N{:вин} внутреннюю силу: у $N{:род} темнеет в глазах, и $N {N:отлетаете|отлетает} назад на добрую сажень!!"

msgid "$N一击不中，露出了破绽！"
msgstr "$N {N:промахиваетесь|промахивается} и {N:раскрываетесь|раскрывается}!"

msgid "$N见$n攻击失误，趁机发动攻击！"
msgstr "$n {n:промахиваетесь|промахивается}, и $N тут же {N:переходите|переходит} в атаку!"

msgid "结果没有造成任何伤害。"
msgstr "Но удар не причиняет никакого вреда."

msgid "擦伤"
msgstr "ссадина"

msgid "割伤"
msgstr "порез"

msgid "结果只是轻轻地划破$p的皮肉。"
msgstr "Удар лишь слегка царапает $n{:дат} кожу."

msgid "结果在$p$l划出一道细长的血痕。"
msgstr "Удар оставляет у $n{:род} на $l{:пред} длинную тонкую кровавую полосу."

