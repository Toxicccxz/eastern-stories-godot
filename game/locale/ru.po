msgid "( 你上一个动作还没有完成，不能念咒文。)"
msgstr "( Вы ещё не закончили предыдущее действие и не можете читать заклинание. )"

msgid "这里不准念咒文。"
msgstr "Здесь читать заклинания нельзя."

msgid "你请先用 enable 指令选择你要使用的咒文系。"
msgstr "Сначала выберите школу заклинаний."

msgid "你所选用的咒文系中没有这种咒文。"
msgstr "В выбранной школе заклинаний такого заклинания нет."

msgid "( 你上一个动作还没有完成，不能施展神通。)"
msgstr "( Вы ещё не закончили предыдущее действие и не можете применить чудесную силу. )"

msgid "这里无法使用神通。"
msgstr "Здесь чудесные силы не действуют."

msgid "你请先用 enable 指令选择你要使用的神通系。"
msgstr "Сначала выберите школу чудесных сил."

msgid "你所选用的法术系中没有这种法术。"
msgstr "В выбранной школе чародейства такого нет."

msgid "「封」字诀"
msgstr "Приём «Печать»"

msgid "牵制攻击只能对战斗中的对手使用。"
msgstr "Сковывающую атаку можно применить только к противнику в бою."

msgid "$n目前正自顾不暇，放胆攻击吧！"
msgstr "$n сейчас едва {n:успеваете|успевает} защищаться — смело нападайте!"

msgid "$N使出封山剑法「封」字诀，连递数个虚招企图扰乱$n的攻势，结果$p被$P攻了个措手不及！"
msgstr "$N {N:применяете|применяет} приём «Печать» меча Фэншань и {N:осыпаете|осыпает} $n{:вин} обманными выпадами, сбивая натиск, — и $n{:им} не {n:успеваете|успевает} опомниться!"

msgid "$N使出封山剑法「封」字诀，连递数个虚招企图扰乱$n的攻势，可是$p看破了$P的企图，并没有上当。"
msgstr "$N {N:применяете|применяет} приём «Печать» меча Фэншань и {N:осыпаете|осыпает} $n{:вин} обманными выпадами, сбивая натиск, но $n{:им} {n:разгадываете|разгадывает} замысел и не {n:поддаётесь|поддаётся} на обман."

msgid "游识神通"
msgstr "Блуждающее сознание"

msgid "你要移动到哪一个人身边？"
msgstr "К кому вы хотите перенестись?"

msgid "你无法感受到这个人的灵力 ...."
msgstr "Вы не чувствуете духовной энергии этого человека..."

msgid "中止施法。"
msgstr "Вы прерываете чары."

msgid "$N低头闭目，开始施展游识神通 ...."
msgstr "$N {N:опускаете|опускает} голову, {N:закрываете|закрывает} глаза и {N:начинаете|начинает} «Блуждающее сознание»..."

msgid "战斗中无法使用游识神通！"
msgstr "В бою «Блуждающее сознание» не применить!"

msgid "你的灵力不够！"
msgstr "Не хватает духовной энергии!"

msgid "游识神通只能对自己使用！"
msgstr "«Блуждающее сознание» можно применить только к себе!"

msgid "你感受到对方的灵力，但是不够强烈。"
msgstr "Вы чувствуете духовную энергию этого человека, но она слишком слаба."

msgid "你因为不够熟练而失败了。"
msgstr "Вам не хватило сноровки, и ничего не вышло."

msgid "$N口中喃喃地念著咒文，忽然大喝一声“疾！”"
msgstr "$N {N:бормочете|бормочет} заклинание и вдруг {N:выкрикиваете|выкрикивает}: «Скорее!»"

msgid "只见一道黑气罩在$n身上！"
msgstr "Чёрный пар окутывает $n{:вин}!"

msgid "只见一道金光罩在$n身上！"
msgstr "Золотое сияние окутывает $n{:вин}!"

msgid "只见一团火焰罩在$n身上！"
msgstr "Клубок пламени окутывает $n{:вин}!"

msgid "只听在一声海啸，海水将$n团团围住！"
msgstr "С рёвом прилива морские волны смыкаются вокруг $n{:род}!"

msgid "只见空中落下无数大木，正把$n困在中央！"
msgstr "С неба падают огромные брёвна и запирают $n{:вин} посередине!"

msgid "只见$N化作一道黑气，然后消失得无影无踪！"
msgstr "$N {N:обращаетесь|обращается} чёрным паром и бесследно {N:исчезаете|исчезает}!"

msgid "只见$N化作一道金光，然后消失得无影无踪！"
msgstr "$N {N:обращаетесь|обращается} золотым лучом и бесследно {N:исчезаете|исчезает}!"

msgid "只见$N化作一团火焰，然后消失得无影无踪！"
msgstr "$N {N:обращаетесь|обращается} клубком пламени и бесследно {N:исчезаете|исчезает}!"

msgid "只见$N化作一道长虹，然后消失得无影无踪！"
msgstr "$N {N:обращаетесь|обращается} длинной радугой и бесследно {N:исчезаете|исчезает}!"

msgid "只见$N化作一团大雾，然后消失得无影无踪！"
msgstr "$N {N:обращаетесь|обращается} густым туманом и бесследно {N:исчезаете|исчезает}!"

msgid "但是$n纵身一跃，脱离了围困。"
msgstr "Но $n{:им} {n:прыгаете|прыгает} и {n:вырываетесь|вырывается} на волю."

msgid "困"
msgstr "Ловушка"

msgid "遁"
msgstr "Исчезнуть"

msgid "这个法术只能在战斗中使用！"
msgstr "Это заклинание можно применить только в бою!"

msgid "$n正自顾不暇，放胆进攻吧。"
msgstr "$n сейчас едва {n:успеваете|успевает} защищаться — смело нападайте."

msgid "「缺」字诀"
msgstr "Приём «Изъян»"

msgid "'缺'字诀只能在战斗中使用。"
msgstr "Приём «Изъян» можно применять только в бою."

msgid "你要对谁使用'缺'字诀？"
msgstr "На кого вы хотите применить приём «Изъян»?"

msgid "你已经在运用中了。"
msgstr "Вы уже его применяете."

msgid "$N剑招陡变，空门大开，诱使$n进招，"
msgstr "$N вдруг {N:меняете|меняет} приём и нарочно {N:раскрываетесь|раскрывается}, заманивая $n{:вин},"

msgid "可是$n看破了$N的企图，并没有上当。"
msgstr "но $n{:им} {n:разгадываете|разгадывает} уловку, и у $N{:род} ничего не выходит."

msgid "$N突然对$n发出奋力一击！"
msgstr "$N вдруг {N:обрушиваете|обрушивает} на $n{:вин} удар изо всех сил!"

msgid "「玄羽乱舞」"
msgstr "«Буйный танец тёмного пера»"

msgid "「玄羽乱舞」只能在战斗中使用。"
msgstr "«Буйный танец тёмного пера» можно применять только в бою."

msgid "你的气不够！"
msgstr "Не хватает Ци!"

msgid "你的真气不够！"
msgstr "Не хватает истинной ци!"

msgid "$N使出步玄七诀第一式「玄羽乱舞」，身法陡然加快！"
msgstr "$N {N:применяете|применяет} первый приём Семи секретов Бусюань — «Буйный танец тёмного пера» — и вдруг {N:двигаетесь|движется} куда быстрее!"

msgid "$N的身形转了几转，倏地停住了脚步。"
msgstr "$N несколько раз {N:поворачиваетесь|поворачивается} на месте и вдруг {N:замираете|замирает}."

msgid "$N迅捷无伦地在$n身旁绕了一圈 ..."
msgstr "$N стремительно {N:описываете|описывает} круг возле $n{:род}..."

msgid "但是$N找不到机会出手！"
msgstr "Но $N не {N:находите|находит} случая ударить!"

msgid "$N眼睛忽然睁开，喃喃地说道：杀....死....$n...."
msgstr "$N вдруг {N:открываете|открывает} глаза и {N:бормочете|бормочет}: «Убить... убить... $n{:вин}...»"

msgid "你要在这张符上写谁的名字？"
msgstr "Чьё имя вы напишете на этом талисмане?"

msgid "心识神通"
msgstr "Сознание сердца"

msgid "$N一手放在$n的天灵盖上，一手贴在$n的後心，闭上眼睛缓缓低吟 ..."
msgstr "$N {N:кладёте|кладёт} одну руку $n{:дат} на темя, другую — на спину, {N:закрываете|закрывает} глаза и медленно {N:бормочете|бормочет} нараспев..."

msgid "你要对谁使用心识神通？"
msgstr "На кого вы хотите направить «Сознание сердца»?"

msgid "召护法"
msgstr "Призвать стража"

msgid "只有战斗中才能召唤天将！"
msgstr "Призвать небесного воина можно только в бою!"

msgid "你的精神无法集中！"
msgstr "Вам не сосредоточиться!"

msgid "$N喃喃地念了几句咒语。"
msgstr "$N {N:бормочете|бормочет} несколько слов заклинания."

msgid "但是什麽也没有发生。"
msgstr "Но ничего не происходит."

msgid "( 你上一个动作还没有完成，不能施用外功。)"
msgstr "( Вы ещё не закончили предыдущее действие и не можете применить внешнее искусство. )"

msgid "你请先用 enable 指令选择你要使用的外功。"
msgstr "Сначала выберите внешнее искусство."

msgid "你所使用的外功中没有这种功能。"
msgstr "В вашем внешнем искусстве такого приёма нет."

msgid "「点」字诀"
msgstr "Приём «Точка»"

msgid "「点」字诀只能对战斗中的对手使用。"
msgstr "Приём «Точка» можно применить только к противнику в бою."

msgid "$N使出封山剑法「点」字诀，可是内力不继，剑尖一颤，手中的剑险些脱手飞出！"
msgstr "$N {N:применяете|применяет} приём «Точка» меча Фэншань, но внутренней силы не хватает: остриё дрожит, и меч едва не вылетает из руки!"

msgid "$N使出封山剑法「点」字诀，劲力尽数聚在剑尖，一剑直刺$n！"
msgstr "$N {N:применяете|применяет} приём «Точка» меча Фэншань: вся сила собрана в острие — и меч бьёт прямо в $n{:вин}!"

msgid "用 {force} 点内力把劲力聚在剑尖，这一剑伤得更重；内力不够，剑会险些脱手，白白耽误几手"
msgstr "Вложить в острие {force} ед. внутренней силы — удар выйдет тяжелее; если силы не хватит, меч едва не выскользнет из руки, и вы потеряете несколько ходов"

msgid "召天将"
msgstr "Призвать небесного воина"

msgid "战斗时不能画符！"
msgstr "В бою рисовать талисманы нельзя!"

msgid "你的精神太差了，无法画符。"
msgstr "У вас слишком мало Шэнь, чтобы рисовать талисман."

msgid "你所学的法术没有这种符。"
msgstr "Среди изученных вами чар нет такого талисмана."

msgid "紫光"
msgstr "Фиолетовый свет"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团紫光射向$n！"
msgstr "$N {N:бормочете|бормочет} заклинание и {N:взмахиваете|взмахивает} левой рукой: в ладони собирается сгусток фиолетового света и летит в $n{:вин}!"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，拖出一条长长的七彩光气，光气绕了回转过来又从$N顶门注入$P的体内！"
msgstr "Со свистом фиолетовый свет пронзает $n{:вин} насквозь и тянет за собой длинный семицветный шлейф; шлейф заворачивает назад и через темя вливается в $N{:вин}!"

msgid "结果「嗤」地一声，紫光从$p身上透体而过，无声无息地钻入地下！"
msgstr "Со свистом фиолетовый свет пронзает $n{:вин} насквозь и беззвучно уходит в землю!"

msgid "白光"
msgstr "Белый свет"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团白光射向$n！"
msgstr "$N {N:бормочете|бормочет} заклинание и {N:взмахиваете|взмахивает} левой рукой: в ладони собирается сгусток белого света и летит в $n{:вин}!"

msgid "结果「嗤」地一声，白光从$p身上透体而过，拖出一条长长的黑气直射到两三丈外的地下！"
msgstr "Со свистом белый свет пронзает $n{:вин} насквозь и тянет за собой длинный хвост чёрного пара, который вонзается в землю в двух-трёх саженях!"

msgid "结果「嗤」地一声，白光从$p身上透体而过，无声无息地钻入地下！"
msgstr "Со свистом белый свет пронзает $n{:вин} насквозь и беззвучно уходит в землю!"

msgid "青光"
msgstr "Лазурный свет"

msgid "你失败了！"
msgstr "Не вышло!"

msgid "$N口中喃喃地念著咒文，左手一挥，手中聚起一团青光射向$n！"
msgstr "$N {N:бормочете|бормочет} заклинание и {N:взмахиваете|взмахивает} левой рукой: в ладони собирается сгусток лазурного света и летит в $n{:вин}!"

msgid "结果「嗤」地一声，青光从$p身上透体而过，拖出一条长长的血箭直射到两三丈外的地下！"
msgstr "Со свистом лазурный свет пронзает $n{:вин} насквозь и тянет за собой длинную струю крови, которая бьёт в землю в двух-трёх саженях!"

msgid "结果「嗤」地一声，青光从$p身上透体而过，无声无息地钻入地下！"
msgstr "Со свистом лазурный свет пронзает $n{:вин} насквозь и беззвучно уходит в землю!"

msgid "投降？现在没有人在打你啊....？"
msgstr "Сдаться? Да с вами сейчас никто не дерётся...?"

msgid "$n向$N求饶，但是$N大声说道：{rude}废话少说，纳命来！"
msgstr "$n {n:молите|молит} $N{:вин} о пощаде, но $N {N:кричите|кричит}: «Хватит болтать, {rude}! Прощайся с жизнью!»"

msgid "$N说道：「不打了，不打了，我投降....。」"
msgstr "$N {N:говорите|говорит}: «Хватит, хватит, я сдаюсь...»"

msgid "「逐」字诀"
msgstr "Приём «Погоня»"

msgid "「逐」字诀只能对战斗中的对手使用。"
msgstr "Приём «Погоня» можно применить только к противнику в бою."

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p已显吃力。"
msgstr "$N {N:применяете|применяет} приём «Погоня» меча Фэншань: меч смыкается теснее, сияние клинка накрывает $n{:вин} — и $n{:им} уже с трудом {n:держитесь|держится}."

msgid "$N使出封山剑法「逐」字诀，剑法一紧，剑光罩向$n，$p从容化解"
msgstr "$N {N:применяете|применяет} приём «Погоня» меча Фэншань: меч смыкается теснее, сияние клинка накрывает $n{:вин} — но $n{:им} спокойно {n:отводите|отводит} удар"

msgid "空识神通"
msgstr "Сознание пустоты"

msgid "$N盘膝而座，开始运用空识神通静思入定 ..."
msgstr "$N {N:садитесь|садится}, скрестив ноги, и с помощью «Сознания пустоты» {N:погружаетесь|погружается} в созерцание..."

msgid "空识神通只能对自己使用。"
msgstr "«Сознание пустоты» можно применить только к себе."

msgid "你觉得脑中一片混乱，你的潜能降低了！"
msgstr "В голове у вас всё смешалось — ваш потенциал снизился!"

msgid "你的潜能提高了！"
msgstr "Ваш потенциал вырос!"

msgid "可是你只觉得一无所获。"
msgstr "Но вы так ничего и не обрели."

msgid "零"
msgstr "ноль"

msgid "十"
msgstr "десять"

msgid "百"
msgstr "сто"

msgid "千"
msgstr "тысяча"

msgid "万"
msgstr "десять тысяч"

msgid "亿"
msgstr "сто миллионов"

msgid "兆"
msgstr "триллион"

msgid "一"
msgstr "один"

msgid "二"
msgstr "два"

msgid "三"
msgstr "три"

msgid "四"
msgstr "четыре"

msgid "五"
msgstr "пять"

msgid "六"
msgstr "шесть"

msgid "七"
msgstr "семь"

msgid "八"
msgstr "восемь"

msgid "九"
msgstr "девять"

msgid "负"
msgstr "минус"

msgid "你的「%s」进步了！"
msgstr "Ваше умение «%s» выросло!"

msgid "没有这个技能种类，用 enable ? 可以查看有哪些种类。"
msgstr "Такого вида умений нет. Наберите «enable ?», чтобы увидеть, какие есть."

msgid "「{skill}」是所有{kind}的基础，不需要 enable。"
msgstr "«{skill}» лежит в основе всего раздела «{kind}» и в enable не нуждается."

msgid "你不会这种技能。"
msgstr "Вы не владеете этим умением."

msgid "你连「{basic}」都没学会，更别提{skill}了。"
msgstr "Вы не освоили даже «{basic}», что уж говорить о «{skill}»."

msgid "这个技能不能当成这种用途。"
msgstr "Это умение нельзя использовать так."

msgid "你改用另一种法术系，灵力必须重新锻炼。"
msgstr "Вы перешли на другую школу чародейства — духовную энергию придётся накапливать заново."

msgid "你改用另一种内功，内力必须重新锻炼。"
msgstr "Вы перешли на другое внутреннее искусство — внутреннюю силу придётся накапливать заново."

msgid "你改用另一种咒文系，法力必须重新修炼。"
msgstr "Вы перешли на другую школу заклинаний — чародейскую силу придётся накапливать заново."

msgid "你已经在战斗中了，学一点实战经验吧。"
msgstr "Вы и так в бою — вот и набирайтесь боевого опыта."

msgid "你只能练习用 enable 指定的特殊技能。"
msgstr "Упражняться можно только в особых умениях, выбранных через enable."

msgid "你好像还没「学会」这项技能吧？最好先去请教别人。"
msgstr "Вы, кажется, ещё не «выучили» это умение? Лучше сначала попросите кого-нибудь научить."

msgid "你对这方面的技能还是一窍不通，最好从先从基本学起。"
msgstr "В этом роде умений вы пока ничего не смыслите — лучше начните с основ."

msgid "你现在不能练习这项技能。"
msgstr "Сейчас упражняться в этом умении нельзя."

msgid "你试著练习%s，但是并没有任何进步。"
msgstr "Вы упражняетесь в умении «%s», но без всякого толку."

msgid "你的%s进步了！"
msgstr "Ваше умение «%s» выросло!"

msgid "战斗中不能练内功，会走火入魔。"
msgstr "В бою упражнять внутреннее искусство нельзя — ци выйдет из-под власти."

msgid "你必须先用 enable 选择你要用的内功心法。"
msgstr "Сначала выберите через enable внутренний метод, которым будете пользоваться."

msgid "你最少要花 10 点「气」才能练功。"
msgstr "Чтобы упражняться, нужно потратить не меньше 10 ед. Ци."

msgid "你现在的气太少了，无法产生内息运行全身经脉。"
msgstr "Ци сейчас слишком мало, чтобы прогнать внутреннее дыхание по всем меридианам."

msgid "你现在精神状况太差了，无法凝神专一！"
msgstr "Шэнь сейчас слишком мало — не сосредоточиться!"

msgid "你现在精力不够，无法控制内息的流动！"
msgstr "Цзин сейчас слишком мало, чтобы управлять током внутреннего дыхания!"

msgid "你现在无法练功。"
msgstr "Сейчас упражняться нельзя."

msgid "你坐下来运气用功，一股内息开始在体内流动。"
msgstr "Вы садитесь и направляете ци; по телу начинает течь поток внутреннего дыхания."

msgid "但是当你行功完毕，只觉得全身酸麻。"
msgstr "Но, закончив, вы чувствуете лишь ломоту и онемение во всём теле."

msgid "当你的内息遍布全身经脉时却没有功力提升的迹象，似乎内力修为已经遇到了瓶颈。"
msgstr "Внутреннее дыхание наполняет все меридианы, но сила не прибывает — похоже, ваша внутренняя сила упёрлась в предел."

msgid "你的内力增强了！"
msgstr "Ваша внутренняя сила выросла!"

msgid "战斗中冥思——找死吗？"
msgstr "Созерцать посреди боя — жить надоело?"

msgid "你最少要花 10 点「神」才能冥思。"
msgstr "Чтобы созерцать, нужно потратить не меньше 10 ед. Шэнь."

msgid "你现在精神太差了，进行冥思将会迷失，永远醒不过来！"
msgstr "Шэнь сейчас слишком мало: начнёте созерцать — заблудитесь в себе и уже не очнётесь!"

msgid "你现在身体状况太差了，无法集中精神！"
msgstr "Вы сейчас в слишком плохом состоянии, чтобы сосредоточиться!"

msgid "你现在身体状况太虚弱了，无法进入冥思的状态！"
msgstr "Тело сейчас слишком слабо, чтобы погрузиться в созерцание!"

msgid "你现在无法冥思。"
msgstr "Сейчас созерцать нельзя."

msgid "你盘膝而坐，静坐冥思了一会儿。"
msgstr "Вы садитесь, скрестив ноги, и некоторое время безмолвно созерцаете."

msgid "但是当你睁开眼睛，只觉得脑中一片空白。"
msgstr "Но, открыв глаза, вы чувствуете в голове лишь пустоту."

msgid "当你的法力增加的瞬间你忽然觉得脑中一片混乱，似乎魔力的提升已经到了瓶颈。"
msgstr "В тот самый миг, когда чародейская сила прибывает, в голове у вас всё мутится — похоже, ваше чародейство упёрлось в предел."

msgid "你的魔力提高了！"
msgstr "Ваша чародейская сила выросла!"

msgid "战斗也是一种修行，但不能和灵力的修行同时进行。"
msgstr "Бой — тоже совершенствование, но его нельзя совмещать с совершенствованием духовной энергии."

msgid "你最少要花 10 点精力才能进行修行。"
msgstr "Чтобы совершенствоваться, нужно потратить не меньше 10 ед. Цзин."

msgid "你现在精力不足，无法修行灵力！"
msgstr "Цзин сейчас слишком мало, чтобы совершенствовать духовную энергию!"

msgid "你现在精神状况太差了，无法控制自己的心灵！"
msgstr "Шэнь сейчас слишком мало — вам не совладать с собственным разумом!"

msgid "你现在无法修行。"
msgstr "Сейчас совершенствоваться нельзя."

msgid "你闭上眼睛开始打坐。"
msgstr "Вы закрываете глаза и погружаетесь в медитацию."

msgid "但是你一不小心却睡著了。"
msgstr "Но незаметно для себя засыпаете."

msgid "你忽然觉得一阵天旋地转，头涨得像要裂开一样，似乎灵力的修行已经遇到了瓶颈。"
msgstr "Мир вдруг идёт кругом, голова раскалывается — похоже, совершенствование духовной энергии упёрлось в предел."

msgid "你的道行提高了！"
msgstr "Ваше постижение Пути возросло!"

msgid "这项技能不能通过自学取得进步！"
msgstr "Это умение нельзя развить самостоятельными занятиями!"

msgid "你得有「%s」的入门知识才行。"
msgstr "Сначала нужны хотя бы начальные знания: «%s»."

msgid "你现在无法自学。"
msgstr "Сейчас заниматься самостоятельно нельзя."

msgid "你开始钻研有关「%s」的问题。"
msgstr "Вы принимаетесь разбирать вопросы, касающиеся «%s»."

msgid "也许是缺乏实战经验，结果是一无所获。"
msgstr "Может быть, не хватает боевого опыта, — так или иначе, толку никакого."

msgid "你苦思冥想，似乎有些心得。"
msgstr "Вы долго и упорно размышляете и, кажется, кое-что постигаете."

msgid "你无法在战斗中专心下来研读新知！"
msgstr "Посреди боя не сосредоточиться на учении!"

msgid "你无法从这样东西学到任何东西。"
msgstr "Из этой вещи ничему не научиться."

msgid "你是个文盲，先学学读书识字吧。"
msgstr "Вы неграмотны — сперва выучитесь читать и писать."

msgid "你的实战经验不足，再怎麽读也没用。"
msgstr "Боевого опыта у вас мало — сколько ни читай, толку не будет."

msgid "以你目前的能力，还没有办法学这个技能。"
msgstr "С вашими нынешними способностями этому умению пока не научиться."

msgid "你现在过於疲倦，无法专心下来研读新知。"
msgstr "Вы слишком утомлены, чтобы сосредоточиться на учении."

msgid "你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。"
msgstr "Вы немного читаете, но всё написанное для вас слишком просто — ничего нового."

msgid "你研读有关%s的技巧，似乎有点心得。"
msgstr "Вы читаете о тонкостях «%s» и, кажется, кое-что постигаете."

msgid "你现在无法研读。"
msgstr "Сейчас читать нельзя."

msgid "你向{npc}请教「{skill}」{count} 次"
msgstr "Вы {count} {#:раз|раза|раз} брали у {npc}{:род} урок «{skill}»"

msgid "你练习{skill} {count} 次"
msgstr "Вы {count} {#:раз|раза|раз} упражнялись в умении «{skill}»"

msgid "你打坐 {count} 次"
msgstr "Вы {count} {#:раз|раза|раз} медитировали"

msgid "你冥思 {count} 次"
msgstr "Вы {count} {#:раз|раза|раз} предавались созерцанию"

msgid "你修行 {count} 次"
msgstr "Вы {count} {#:раз|раза|раз} совершенствовались"

msgid "（其间歇了 {rests} 回，共{time}）"
msgstr "(отдых по пути: {rests}, всего {time})"

